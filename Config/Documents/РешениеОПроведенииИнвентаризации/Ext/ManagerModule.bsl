	|	Дата ВОЗР
	|;";
	
	ТаблицаШапки = ЗапросПоиск.Выполнить().Выгрузить();
	
	ТаблицаСотрудников = ОбщегоНазначенияБГУ.РезультатыОзнакомленияСотрудниковПоДокументам(МассивДокументов, "ЛистОзнакомления");
	
	ДанныеЛистовОзнакомления = Новый Структура();
	ДанныеЛистовОзнакомления.Вставить("Шапки", ТаблицаШапки);
	ДанныеЛистовОзнакомления.Вставить("ТаблицаСотрудников", ТаблицаСотрудников);
	
	Возврат ДанныеЛистовОзнакомления;
	
КонецФункции

Процедура ПроверитьНачалоИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения)

	ТекстШаблон = НСтр("ru='Решение датировано после начала инвентаризации (строка %1 списка ""Объекты инвентаризации"")'");
	
	ДатаРешения = НачалоДня(ДокументОбъект.Дата);
	
	Если Не ЗначениеЗаполнено(ДатаРешения) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Объекты Цикл
		ДатаНачала = СтрокаТаблицы.ДатаНачала;
		
		Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДатаРешения > ДатаНачала Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			НомерСтроки = СтрокаТаблицы.НомерСтроки;
			
			ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон, НомерСтроки),
				ДокументОбъект.Ссылка,
				"Объект.Объекты[" + ИндексСтрокиТекст + "].ДатаНачала");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ПроверитьЛистОзнакомления(ДокументОбъект, ЕстьОшибкиЗаполнения)
	
	ТекстСообщения = НСтр("ru='В листе ознакомления не указаны некоторые сотрудники из разделов 1 и 2. Рекомендуется выполнить автозаполнение листа ознакомления.'");
	
	Данные = ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект);
	
	ТаблицаОбязательныхСотрудников = ИнвентаризацияСервер.СоставитьТаблицуСотрудниковДляЗаполненияТабличнойЧастиЛистОзнакомления(Данные);
	
	Поиск = Новый Структура("Сотрудник");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбязательныхСотрудников Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = ДокументОбъект.ЛистОзнакомления.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				"Объект.ЛистОзнакомления");
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//---
// Печать
//---

// Форма 0510439

Функция ПечатьФормы0510439(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510439();
	
	КлючПараметровПечати = "ПечатьФормы0510439";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаДокументаРешения(Макет);
	
	Данные = ПолучитьДанныеДокументовДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиДокументРешения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиДокументРешения(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати)
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// УТВЕРЖДАЮ
	
	ЗначенияПараметров = Новый Структура();
	
	ФИОУтверждаю = Справочники.Сотрудники.ФамилияИО(СтрокаШапки.Руководитель, Ложь, СтрокаШапки.Дата);
	
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", СтрокаШапки.Руководитель, СтрокаШапки.Дата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	ДолжностьУтверждаю = ДанныеПодписанта.Должность;
	
	ЗначенияПараметров.Вставить("Должность",	ДолжностьУтверждаю);
	ЗначенияПараметров.Вставить("ФИО",			ФИОУтверждаю);
	
	Область = ОбластиМакета["Утверждаю"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиРуководитель, Истина));
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ФормаПоОКУД", "0510439");
	
	УправлениеПечатьюБГУ.ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, СтрокаШапки.Ссылка, Данные.СведенияУчреждений);
	
	ЗначенияПараметров.Вставить("ОснованиеПроведения", СтрокаШапки.ОснованиеПроведения);
	ЗначенияПараметров.Вставить("Дата",	СтрокаШапки.Дата);
	ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер));
	
	Область = ОбластиМакета["ЗаголовокНачало"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокумент.Вывести(Область);
	
	Область = ОбластиМакета["ЗаголовокКонец"];
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// АКТЫ, ОПРЕДЕЛЯЮЩИЕ ПОРЯДОК ПРОВЕДЕНИЯ ИНВЕНТАРИЗАЦИИ
	
	ВывестиАктыОбИнвентаризации(ТабДокумент, Данные["АктыОбИнвентаризации"], СтрокаШапки.Ссылка, ОбластиМакета);
	
	// РАЗДЕЛ 1
	
	ВывестиРаздел1(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	// РАЗДЕЛ 2
	
	ВывестиРаздел2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета);
	
	// ПОДВАЛ
	
	ДанныеОтветственногоИсполнителя = ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки);
	
	Область = ОбластиМакета["Подвал"];
	Область.Параметры.Заполнить(ДанныеОтветственногоИсполнителя);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.ДатаПодписиОтветственный, Истина));
	ТабДокумент.Вывести(Область);
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры	

Процедура ВывестиРаздел1(ТабДок, Данные, СтрокаШапки, ОбластиМакета)
	
	ДокументСсылка	= СтрокаШапки.Ссылка;
	ДокументДата	= СтрокаШапки.Дата;
	
	ТабДок.Вывести(ОбластиМакета["Раздел1Заголовок"]);
	
	ТабДок.Вывести(ОбластиМакета["Раздел1ШапкаТаблицы"]);
	
	Область = ОбластиМакета["Раздел1СтрокаТаблицы"];
	
	ЗначенияПараметров = Новый Структура();
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = Данные["Объекты"].НайтиСтроки(Поиск);
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если НомерСтроки <= 999 Тогда
			КодСтроки = Формат(НомерСтроки, "ЧЦ=3;ЧВН=;ЧГ=");
		Иначе
			// Код строки состоит из более чем 3 разрядов.
			КодСтроки = Формат(НомерСтроки, "ЧГ=");
		КонецЕсли;
		
		ЗначенияПараметров.Вставить("КодСтроки",		КодСтроки);
		ЗначенияПараметров.Вставить("НомерКомиссии",	ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(СтрокаТаблицы.НомерКомиссии, СтрокаТаблицы.НомерРабочейКомиссии, Истина));
		
		ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(СтрокаТаблицы);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) Тогда
			ДанныеСотрудника = ПолучитьДанныеСотрудника(
				Данные["ДанныеСотрудников"],
				СтрокаТаблицы.Сотрудник,
				СтрокаШапки.Дата,
				Истина); // ПолучитьДолжность
		Иначе
			ДанныеСотрудника = Новый Структура("ФИО,Должность", "Х", "Х");
		КонецЕсли;
		
		Область.Параметры.Заполнить(СтрокаТаблицы);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ПредставлениеСчета);
		Область.Параметры.Заполнить(ДанныеСотрудника);
		
		ТабДок.Вывести(Область);
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластиМакета["Раздел1Подвал"]);
	
КонецПроцедуры

Процедура ВывестиРаздел2(ТабДок, Данные, СтрокаШапки, ОбластиМакета)
	
	ДокументСсылка = СтрокаШапки.Ссылка;
	
	ТабДок.Вывести(ОбластиМакета["Раздел2Заголовок"]);
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрокКомиссии = Данные["Комиссии"].НайтиСтроки(Поиск);
	
	НомерКомиссии = 0;
	
	Для Каждого СтрокаТабличнойЧасти Из МассивСтрокКомиссии Цикл
		
		НомерКомиссии = НомерКомиссии + 1;
		
		КомиссияСсылка = СтрокаТабличнойЧасти.Комиссия;
		
		// НОМЕР КОМИССИИ
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("НомерКомиссии", ИнвентаризацияКлиентСервер.ФорматироватьНомерКомиссии(НомерКомиссии, Истина));
		
		Область = ОбластиМакета["Раздел2НомерКомиссии"];
		Область.Параметры.Заполнить(ЗначенияПараметров);
		ТабДок.Вывести(Область);
		
		// АКТЫ, ОПРЕДЕЛЯЮЩИЕ СОСТАВ КОМИССИИ
		
		ВывестиАктыОСоставеКомиссии(ТабДок, Данные["ДанныеКомиссий"], КомиссияСсылка, ОбластиМакета);
		
		// ТАБЛИЦА
		
		ТабДок.Вывести(ОбластиМакета["Раздел2ШапкаТаблицы"]);
		
		Поиск = Новый Структура("Ссылка", КомиссияСсылка);
		
		МассивСтрокШапокКомиссии = Данные["ДанныеКомиссий"]["Шапки"].НайтиСтроки(Поиск);
		
		Если МассивСтрокШапокКомиссии.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаШапкиКомиссии = МассивСтрокШапокКомиссии[0];
		
		МассивСтрокСоставаКомиссии = Данные["ДанныеКомиссий"]["СоставыКомиссий"].НайтиСтроки(Поиск);
		
		Область = ОбластиМакета["Раздел2СтрокаТаблицы"];
		
		ЗначенияПараметров = Новый Структура();
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаСоставаКомиссии Из МассивСтрокСоставаКомиссии Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ДанныеСотрудника = ПолучитьДанныеСотрудника(
				Данные["ДанныеСотрудников"],
				СтрокаСоставаКомиссии.Сотрудник,
				СтрокаШапки.Дата,
				Истина); // ПолучитьДолжность);
			
			Область.Параметры.Заполнить(ДанныеСотрудника);
			
			ЗначенияПараметров.Вставить("КодСтроки", Формат(НомерСтроки, "ЧЦ=3;ЧВН=;ЧГ="));
			ЗначенияПараметров.Вставить("ВидКомиссии",	?(СтрокаШапкиКомиссии.Временная,
															НСтр("ru='временная'"),
															НСтр("ru='постоянно действующая'")));
			ЗначенияПараметров.Вставить("Статус",		ИнвентаризацияСервер.ПолучитьПредставлениеСтатусЧленаКомиссии(СтрокаСоставаКомиссии));
			ЗначенияПараметров.Вставить("НомерРабочейКомиссии",	ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(СтрокаСоставаКомиссии.НомерРабочейКомиссии));
			
			Область.Параметры.Заполнить(ЗначенияПараметров);
			
			ТабДок.Вывести(Область);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластиМакета["Раздел2Подвал"]);
	
КонецПроцедуры

Процедура ВывестиАктыОбИнвентаризации(ТабДок, ТаблицаАктыОбИнвентаризации, ДокументСсылка, ОбластиМакета, МинимальноеКоличествоСтрок = 2)
	
	Область = ОбластиМакета["СтрокаАкта"];
	
	ОчищающаяСтруктура = Новый Структура("Наименование,Номер,Дата");
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = ТаблицаАктыОбИнвентаризации.НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДок, МассивСтрок, Область, ОчищающаяСтруктура, 2, 2);
	
КонецПроцедуры

Процедура ВывестиАктыОСоставеКомиссии(ТабДок, ДанныеКомиссий, КомиссияСсылка, ОбластиМакета, МинимальноеКоличествоСтрок = 2)
	
	Область = ОбластиМакета["Раздел2СтрокаАкта"];
	
	ОчищающаяСтруктура = Новый Структура("Наименование,Номер,Дата");
	
	Поиск = Новый Структура("Ссылка", КомиссияСсылка);
	
	МассивСтрок = ДанныеКомиссий["АктыОСоставеКомиссий"].НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДок, МассивСтрок, Область, ОчищающаяСтруктура, 2, 2);
	
КонецПроцедуры

Функция ПолучитьДанныеДокументовДляПечати(МассивОбъектов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка													КАК Ссылка,
	|	Номер													КАК Номер,
	|	Дата													КАК Дата,
	|	Организация												КАК Организация,
	|	Организация.НаименованиеПолное							КАК НаименованиеОрганизации,
	|	Подразделение											КАК Подразделение,
	|	Подразделение.Наименование								КАК НаименованиеПодразделения,
	|	ОснованиеПроведенияИнвентаризации.НаименованиеПолное	КАК ОснованиеПроведения,
	|	Комментарий												КАК Комментарий,
	|	Ответственный											КАК Ответственный,
	|	ОтветственныйИсполнитель								КАК ОтветственныйИсполнитель,
	|	ДатаПодписиРуководитель									КАК ДатаПодписиРуководитель,
	|	ДатаПодписиОтветственный								КАК ДатаПодписиОтветственный,
	|	Руководитель											КАК Руководитель
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица объектов инвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка								КАК Ссылка,
	|	КФО									КАК КФО,
	|	ПРЕДСТАВЛЕНИЕ(КФО)					КАК КФОНаименование,
	|	Счет								КАК Счет,
	|	ЕСТЬNULL(Счет.Код, """")				КАК СчетКод,
	|	ЕСТЬNULL(Счет.Наименование, """")		КАК СчетНаименование,
	|	ЕСТЬNULL(Счет.УчетПоКЭК, ЛОЖЬ)		КАК СчетУчетПоКЭК,
	|	ЕСТЬNULL(Счет.Забалансовый, ЛОЖЬ)	КАК СчетЗабалансовый,
	|	Сотрудник							КАК Сотрудник,
	|	ДатаИнвентаризации					КАК ДатаИнвентаризации,
	|	ДатаНачала							КАК ДатаНачала,
	|	ДатаОкончания						КАК ДатаОкончания,
	|	НомерКомиссии						КАК НомерКомиссии,
	|	НомерРабочейКомиссии				КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации					КАК МестоИнвентаризации,
	|	Примечание							КАК Примечание
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (подготовка) Таблица комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	НомерСтроки	КАК НомерСтроки,
	|	Комиссия	КАК Комиссия
	|ПОМЕСТИТЬ
	|	КомиссииДокументов
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Таблица комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	Комиссия	КАК Комиссия
	|ИЗ
	|	КомиссииДокументов
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Полный список всех комиссий
	|//		(для дальнейшей обработки)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Комиссия	КАК Комиссия
	|ИЗ
	|	КомиссииДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Таблица актов о проведении инвентаризации
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	Наименование	КАК Наименование,
	|	Дата			КАК Дата,
	|	Номер			КАК Номер
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.АктыОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	ДанныеДокументов = Новый Структура();
	
	// [0]. Шапки документов
	ДанныеДокументов.Вставить("Шапки", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Таблица объектов инвентаризации
	ДанныеДокументов.Вставить("Объекты", РезультатыЗапроса[1].Выгрузить());
	
	// [3]. Таблица комиссий
	ДанныеДокументов.Вставить("Комиссии", РезультатыЗапроса[3].Выгрузить());
	
	// [4]. Полный список всех комиссий
	СписокКомиссий = РезультатыЗапроса[4].Выгрузить().ВыгрузитьКолонку("Комиссия");
	ДанныеДокументов.Вставить("ДанныеКомиссий", ИнвентаризацияСервер.ПолучитьДанныеКомиссийДляПечатиРешения(СписокКомиссий));
	
	// [5]. Таблица актов о проведении инвентаризации
	ДанныеДокументов.Вставить("АктыОбИнвентаризации", РезультатыЗапроса[5].Выгрузить());
	
	ДанныеДокументов.Вставить("ДанныеСотрудников", ПолучитьДанныеСотрудников(МассивОбъектов, "Объекты,Комиссии"));
	
	ДанныеДокументов.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат ДанныеДокументов;
	
КонецФункции

Функция ПолучитьСписокСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	МассивИмен = СтрРазделить(ИменаТабличныхЧастей, ", ", Ложь);
	
	ВыбиратьИзТЧОбъекты				= (МассивИмен.Найти("Объекты") <> Неопределено);
	ВыбиратьИзТЧКомиссии			= (МассивИмен.Найти("Комиссии") <> Неопределено);
	ВыбиратьИзТЧЛистОзнакомления	= (МассивИмен.Найти("ЛистОзнакомления") <> Неопределено);
	ВыбиратьИзТЧЛистСогласования	= (МассивИмен.Найти("ЛистСогласования") <> Неопределено);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",					МассивДокументов);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧКомиссии",			ВыбиратьИзТЧКомиссии);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧОбъекты",			ВыбиратьИзТЧОбъекты);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧЛистОзнакомления",	ВыбиратьИзТЧЛистОзнакомления);
	ЗапросПоиск.УстановитьПараметр("ВыбиратьИзТЧЛистСогласования",	ВыбиратьИзТЧЛистСогласования);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Полный список всех сотрудников
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧСоставКомиссии.Сотрудник	КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО	&ВыбиратьИзТЧКомиссии
	|		И	Док.Ссылка = ТЧКомиссии.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО	ТЧКомиссии.Комиссия = ТЧСоставКомиссии.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.Сотрудник				КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Объекты КАК ТЧ
	|		ПО	&ВыбиратьИзТЧОбъекты
	|		И	Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	Сотрудник					КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.ЛистОзнакомления КАК ТЧ
	|		ПО	&ВыбиратьИзТЧЛистОзнакомления
	|		И	Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	Сотрудник					КАК Сотрудник
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.ЛистСогласования КАК ТЧ
	|		ПО	&ВыбиратьИзТЧЛистСогласования
	|		И	Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)";
	
	ТаблицаСотрудников = ЗапросПоиск.Выполнить().Выгрузить();
	
	ВремТаблица = ТаблицаСотрудников.Скопировать(, "ДатаОпределенияСведений");
	ВремТаблица.Свернуть("ДатаОпределенияСведений");
	
	ДатыОпределенияСведений = ВремТаблица.ВыгрузитьКолонку("ДатаОпределенияСведений");
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаСотрудников",		ТаблицаСотрудников);
	Результат.Вставить("ДатыОпределенияСведений",	ДатыОпределенияСведений);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	СписокСотрудников = ПолучитьСписокСотрудников(МассивДокументов, ИменаТабличныхЧастей);
	
	Результат = Новый Соответствие();
	
	Поиск = Новый Структура();
	
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование,Подразделение";
	
	Для Каждого Дата Из СписокСотрудников["ДатыОпределенияСведений"] Цикл
		ПорцияСведений = ИнвентаризацияСервер.ПолучитьПорциюСведенийСотрудниковНаДату(СписокСотрудников["ТаблицаСотрудников"], Дата);
		
		Результат.Вставить(Дата, ПорцияСведений);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСотрудника(ДанныеСотрудников, Сотрудник, Дата, ПолучитьДолжность = Ложь, ПолучитьПодразделение = Ложь)
	
	Перем Должность, ФИО, Подразделение;
	
	ТаблицаДанныеСотрудников = ДанныеСотрудников.Получить(Дата);
	
	Если ЗначениеЗаполнено(Сотрудник) И ТаблицаДанныеСотрудников <> Неопределено Тогда
		
		Поиск = Новый Структура("Ссылка", Сотрудник);
		
		МассивСтрок = ТаблицаДанныеСотрудников.НайтиСтроки(Поиск);
		
		СтрокаДанных = МассивСтрок[0];
		
		ФИО = СтрокаДанных.Фамилия + " " + СтрокаДанных.Имя + " " + СтрокаДанных.Отчество;
		
		Если ПолучитьДолжность Тогда
			Должность = СтрокаДанных.ДолжностьНаименование;
		КонецЕсли;
		
		Если ПолучитьПодразделение Тогда
			Подразделение = СтрокаДанных.Подразделение;
		КонецЕсли;
		
		Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
			ДолжностьПодразделение = Должность + ?(ЗначениеЗаполнено(Подразделение), ", " + Подразделение,	"");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ФИО", ФИО);
	
	Если ПолучитьДолжность Тогда
		Результат.Вставить("Должность", Должность);
	КонецЕсли;
	
	Если ПолучитьПодразделение Тогда
		Результат.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
		Результат.Вставить("ДолжностьПодразделение", ДолжностьПодразделение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеОтветственногоИсполнителя(СтрокаШапки)
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	СтрокаШапки.ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			СтрокаШапки.Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	Результат = Новый Структура();
	Результат.Вставить("Должность",	ДанныеСотрудника.ДолжностьНаименование);
	Результат.Вставить("ФИО",		КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника));
	Результат.Вставить("Телефон",	ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	Результат.Вставить("Адрес",		ДанныеСотрудника.EmailФизическиеЛица);
	
	Возврат Результат;

КонецФункции

// Лист согласования

Функция ПечатьЛистСогласования(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510439();
	
	КлючПараметровПечати = "ЛистСогласованияФ0510439";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаЛистаСогласования(Макет);
	
	Данные = ПолучитьДанныеЛистовСогласованияДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиЛистСогласования(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЛистСогласования(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати)
	
	Поиск = Новый Структура();
	Поиск.Вставить("ВидДействия", Перечисления.ВидыДействийСотрудникаСДокументом.Согласование);
	
	ЗначенияПараметров = Новый Структура();
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// ЗАГОЛОВОК
	
	Область = ОбластиМакета["ЛистСогласованияЗаголовок"];
	
	ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер));

	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ТАБЛИЦА
	
	Область = ОбластиМакета["ЛистСогласованияСтрока"];
	
	КомпонентыПустойДаты = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи('00010101', Истина);
	
	ОчищающаяСтруктура = Новый Структура("Должность,Подразделение,ДолжностьПодразделение,ФИО,Дня,Месяца,Года");
	
	ЗаполнитьЗначенияСвойств(ОчищающаяСтруктура, КомпонентыПустойДаты);
	
	Поиск.Вставить("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = Данные["ТаблицаСотрудников"].НайтиСтроки(Поиск);
	
	ИнвентаризацияСервер.ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДокумент, МассивСтрок, Область, ОчищающаяСтруктура, 3);
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры

Функция ПолучитьДанныеЛистовСогласованияДляПечати(МассивДокументов)
	
	ДанныеЛистовСогласования = ПолучитьДанныеЛистовСогласования(МассивДокументов);
	
	ДополнитьДанныеЛистовСогласованияДляПечати(ДанныеЛистовСогласования, МассивДокументов);
	
	Возврат ДанныеЛистовСогласования;
	
КонецФункции

Процедура ДополнитьДанныеЛистовСогласованияДляПечати(ДанныеЛистовСогласования, МассивОбъектов)
	
	ТаблицаСотрудников = ДанныеЛистовСогласования["ТаблицаСотрудников"];
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаСотрудников.Колонки.Добавить("ДолжностьПодразделение",	ТипСтрока);
	ТаблицаСотрудников.Колонки.Добавить("ФИО",						ТипСтрока);
	ТаблицаСотрудников.Колонки.Добавить("Дня",						ТипСтрока);
	ТаблицаСотрудников.Колонки.Добавить("Месяца",					ТипСтрока);
	ТаблицаСотрудников.Колонки.Добавить("Года",						ТипСтрока);
	
	ДанныеСотрудников = ПолучитьДанныеСотрудников(МассивОбъектов, "ЛистСогласования");

	Для Каждого СтрокаТаблицы Из ТаблицаСотрудников Цикл
		
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДанныеСотрудников,
			СтрокаТаблицы.Сотрудник,
			СтрокаТаблицы.ДокументДата,
			Истина,		// ПолучитьДолжность
			Истина);	// ПолучитьПодразделение
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСотрудника);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаТаблицы.Дата, Истина), "Дня,Месяца,Года");
		
	КонецЦикла;
	
КонецПроцедуры

// Лист ознакомления

Функция ПечатьЛистОзнакомления(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510439();
	
	КлючПараметровПечати = "ЛистОзнакомленияФ0510439";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакета = ПолучитьОбластиМакетаЛистаОзнакомления(Макет);
	
	Данные = ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из Данные["Шапки"] Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиЛистОзнакомления(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиЛистОзнакомления(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, ОбъектыПечати)
	
	Поиск = Новый Структура();
	Поиск.Вставить("ВидДействия", Перечисления.ВидыДействийСотрудникаСДокументом.Ознакомление);
	
	ЗначенияПараметров = Новый Структура();
	
	НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
	
	// ЗАГОЛОВОК
	
	Область = ОбластиМакета["ЛистОзнакомленияЗаголовок"];
	
	ЗначенияПараметров.Вставить("Номер", РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		СтрокаШапки.Номер));

	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ТАБЛИЦА
	
	Область = ОбластиМакета["ЛистОзнакомленияСтрока"];
	
	Поиск.Вставить("Документ", СтрокаШапки.Ссылка);
	
	МассивСтрок = Данные["ТаблицаСотрудников"].НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Область.Параметры.Заполнить(СтрокаТаблицы);
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	// В табличном документе зададим имя области, в которую был 
	// выведен объект. Нужно для возможности печати покомплектно.
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
		ТабДокумент, 
		НомерСтрокиНачало,
		ОбъектыПечати,
		СтрокаШапки.Ссылка);
	
КонецПроцедуры

Функция ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивДокументов)
	
	ДанныеЛистовОзнакомления = ПолучитьДанныеЛистовОзнакомления(МассивДокументов);
	
	ДополнитьДанныеЛистовОзнакомленияДляПечати(ДанныеЛистовОзнакомления, МассивДокументов);
	
	Возврат ДанныеЛистовОзнакомления;
	
КонецФункции

Процедура ДополнитьДанныеЛистовОзнакомленияДляПечати(ДанныеЛистовОзнакомления, МассивОбъектов)
	
	ТаблицаСотрудников = ДанныеЛистовОзнакомления["ТаблицаСотрудников"];
	
	ТаблицаСотрудников.Колонки.Добавить("ФИО", Новый ОписаниеТипов("Строка"));
	
	ДанныеСотрудников = ПолучитьДанныеСотрудников(МассивОбъектов, "ЛистОзнакомления");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСотрудников Цикл
		
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДанныеСотрудников,
			СтрокаТаблицы.Сотрудник,
			СтрокаТаблицы.ДокументДата,
			Ложь,	// ПолучитьДолжность
			Ложь);	// ПолучитьПодразделение
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеСотрудника);
		
	КонецЦикла;
	
КонецПроцедуры

// Настройки печати

Функция ПолучитьМакетФормы0510439()
	
	Возврат УправлениеПечатью.МакетПечатнойФормы("Документ.РешениеОПроведенииИнвентаризации.ПФ_MXL_Ф0510439");
	
КонецФункции

Функция ПолучитьОбластиМакетаДокументаРешения(Макет)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Утверждаю",					Макет.ПолучитьОбласть("Утверждаю"));
	ОбластиМакета.Вставить("ЗаголовокНачало",			Макет.ПолучитьОбласть("ЗаголовокНачало"));
	ОбластиМакета.Вставить("ЗаголовокКонец",			Макет.ПолучитьОбласть("ЗаголовокКонец"));
	ОбластиМакета.Вставить("СтрокаАкта",				Макет.ПолучитьОбласть("СтрокаАкта"));
	ОбластиМакета.Вставить("Раздел1Заголовок",			Макет.ПолучитьОбласть("Раздел1Заголовок"));
	ОбластиМакета.Вставить("Раздел1ШапкаТаблицы",		Макет.ПолучитьОбласть("Раздел1ШапкаТаблицы"));
	ОбластиМакета.Вставить("Раздел1СтрокаТаблицы",		Макет.ПолучитьОбласть("Раздел1СтрокаТаблицы"));
	ОбластиМакета.Вставить("Раздел1Подвал",				Макет.ПолучитьОбласть("Раздел1Подвал"));
	ОбластиМакета.Вставить("Раздел2Заголовок",			Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2НомерКомиссии",		Макет.ПолучитьОбласть("Раздел2НомерКомиссии"));
	ОбластиМакета.Вставить("Раздел2СтрокаАкта",			Макет.ПолучитьОбласть("Раздел2СтрокаАкта"));
	ОбластиМакета.Вставить("Раздел2ШапкаТаблицы",		Макет.ПолучитьОбласть("Раздел2ШапкаТаблицы"));
	ОбластиМакета.Вставить("Раздел2СтрокаТаблицы",		Макет.ПолучитьОбласть("Раздел2СтрокаТаблицы"));
	ОбластиМакета.Вставить("Раздел2Подвал",				Макет.ПолучитьОбласть("Раздел2Подвал"));
	ОбластиМакета.Вставить("Подвал",					Макет.ПолучитьОбласть("Подвал"));
	
	Возврат ОбластиМакета;
	
КонецФункции

Функция ПолучитьОбластиМакетаЛистаСогласования(Макет)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("ЛистСогласованияЗаголовок",	Макет.ПолучитьОбласть("ЛистСогласованияЗаголовок"));
	ОбластиМакета.Вставить("ЛистСогласованияСтрока",	Макет.ПолучитьОбласть("ЛистСогласованияСтрока"));
	
	Возврат ОбластиМакета;
	
КонецФункции

Функция ПолучитьОбластиМакетаЛистаОзнакомления(Макет)
	
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("ЛистОзнакомленияЗаголовок",	Макет.ПолучитьОбласть("ЛистОзнакомленияЗаголовок"));
	ОбластиМакета.Вставить("ЛистОзнакомленияСтрока",	Макет.ПолучитьОбласть("ЛистОзнакомленияСтрока"));
	
	Возврат ОбластиМакета;
	
КонецФункции

// Форма 0510439 с листами согласования, ознакомления

Функция ПечатьФормы0510439СЛистами(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	Макет = ПолучитьМакетФормы0510439();
	
	КлючПараметровПечати = "ПечатьФормы0510439СЛистами";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ОбластиМакетаДокумента			= ПолучитьОбластиМакетаДокументаРешения(Макет);
	ОбластиМакетаЛистаСогласования	= ПолучитьОбластиМакетаЛистаСогласования(Макет);
	ОбластиМакетаЛистаОзнакомления	= ПолучитьОбластиМакетаЛистаОзнакомления(Макет);
	
	ДанныеСЛистами = ПолучитьДанныеДокументовДляПечатиСЛистами(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого СтрокаШапки Из ДанныеСЛистами.ДанныеДокументов.Шапки Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		ВывестиДокументРешения(ТабДокумент, ДанныеСЛистами.ДанныеДокументов, СтрокаШапки, ОбластиМакетаДокумента, ОбъектыПечати);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтрокаШапкиЛиста = ПолучитьСтрокуШапкиЛиста(ДанныеСЛистами.ДанныеЛистовСогласования.Шапки, СтрокаШапки);
		
		ВывестиЛистСогласования(ТабДокумент, ДанныеСЛистами.ДанныеЛистовСогласования, СтрокаШапкиЛиста, ОбластиМакетаЛистаСогласования, ОбъектыПечати);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		СтрокаШапкиЛиста = ПолучитьСтрокуШапкиЛиста(ДанныеСЛистами.ДанныеЛистовОзнакомления.Шапки, СтрокаШапки);
		
		ВывестиЛистОзнакомления(ТабДокумент, ДанныеСЛистами.ДанныеЛистовОзнакомления, СтрокаШапкиЛиста, ОбластиМакетаЛистаОзнакомления, ОбъектыПечати);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДокументовДляПечатиСЛистами(МассивОбъектов)
	
	ДанныеДляПечати = Новый Структура();
	
	ДанныеДляПечати.Вставить("ДанныеДокументов",			ПолучитьДанныеДокументовДляПечати(МассивОбъектов));
	ДанныеДляПечати.Вставить("ДанныеЛистовСогласования",	ПолучитьДанныеЛистовСогласованияДляПечати(МассивОбъектов));
	ДанныеДляПечати.Вставить("ДанныеЛистовОзнакомления",	ПолучитьДанныеЛистовОзнакомленияДляПечати(МассивОбъектов));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ПолучитьСтрокуШапкиЛиста(Данные, СтрокаШапкиДокумента)
	
	Поиск = Новый Структура("Ссылка", СтрокаШапкиДокумента.Ссылка);
	
	МассивСтрок = Данные.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Поиск документов для первоначальной инициализации таб.части ЛистОзнакомления
	|//
	|ВЫБРАТЬ
	|	Документ									КАК Документ,
	|	СУММА(КоличествоСтрокТЧОбъекты)				КАК КоличествоСтрокТЧОбъекты,
	|	СУММА(КоличествоСтрокТЧКомиссии)			КАК КоличествоСтрокТЧКомиссии,
	|	СУММА(КоличествоСтрокТЧЛистОзнакомления)	КАК КоличествоСтрокТЧЛистОзнакомления
	|ПОМЕСТИТЬ
	|	ДокументыИнициализацияЛистОзнакомления
	|ИЗ
	|	(ВЫБРАТЬ
	|		Объекты.Ссылка	КАК Документ,
	|		КОЛИЧЕСТВО(*)	КАК КоличествоСтрокТЧОбъекты,
	|		0				КАК КоличествоСтрокТЧКомиссии,
	|		0				КАК КоличествоСтрокТЧЛистОзнакомления
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации.Объекты КАК Объекты
	|	ГДЕ
	|		Сотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	СГРУППИРОВАТЬ ПО
	|		Объекты.Ссылка,
	|		0,
	|		0
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Комиссии.Ссылка	КАК Документ,
	|		0				КАК КоличествоСтрокТЧОбъекты,
	|		КОЛИЧЕСТВО(*)	КАК КоличествоСтрокТЧКомиссии,
	|		0				КАК КоличествоСтрокТЧЛистОзнакомления
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК Комиссии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|			ПО	Комиссии.Комиссия = СоставКомиссии.Ссылка
	|	СГРУППИРОВАТЬ ПО
	|		Комиссии.Ссылка,
	|		0,
	|		0
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ЛистОзнакомления.Ссылка	КАК Документ,
	|		0						КАК КоличествоСтрокТЧОбъекты,
	|		0						КАК КоличествоСтрокТЧКомиссии,
	|		КОЛИЧЕСТВО(*)			КАК КоличествоСтрокТЧЛистОзнакомления
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации.ЛистОзнакомления КАК ЛистОзнакомления
	|	СГРУППИРОВАТЬ ПО
	|		ЛистОзнакомления.Ссылка,
	|		0,
	|		0
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Документ
	|ИМЕЮЩИЕ
	|	(СУММА(КоличествоСтрокТЧОбъекты) > 0 ИЛИ СУММА(КоличествоСтрокТЧКомиссии) > 0)
	|	И СУММА(КоличествоСтрокТЧЛистОзнакомления) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Поиск документов для первоначальной инициализации дат согласования
	|// 
	|ВЫБРАТЬ
	|	Ссылка					КАК Документ,
	|	МАКСИМУМ(УдалитьДата)	КАК УдалитьДата
	|ПОМЕСТИТЬ
	|	ДокументыИнициализацияДатаСогласования
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.ЛистСогласования КАК ЛистСогласования
	|ГДЕ
	|	НЕ Ссылка В(
	|		ВЫБРАТЬ
	|			ДокументОснование
	|		ИЗ
	|			РегистрСведений.РезультатыОзнакомленияСотрудников
	|		ГДЕ
	|			ВидДействия = ЗНАЧЕНИЕ(Перечисление.ВидыДействийСотрудникаСДокументом.Согласование))
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(УдалитьДата) <> &ПустаяДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Общий список документов для обработчика обновления
	|//
	|ВЫБРАТЬ
	|	Документ	КАК Ссылка
	|ИЗ
	|	ДокументыИнициализацияЛистОзнакомления
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Документ	КАК Ссылка
	|ИЗ
	|	ДокументыИнициализацияДатаСогласования
	|;";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления
	// Заполнение документов (табличной части ЛистОзнакомления) и дат согласования сотрудников (#МеханизмОзнакомленияСорудников)
	
	ПолноеИмяОбъекта = "Документ.РешениеОПроведенииИнвентаризации";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	ПустойСотрудник = Новый Массив();
	ПустойСотрудник.Добавить(Справочники.Сотрудники.ПустаяСсылка());
	ПустойСотрудник.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	ПустойСотрудник.Добавить(Неопределено);
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ПустаяДата",			'00010101');
	Запрос.УстановитьПараметр("ПустойСотрудник",	ПустойСотрудник);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Сведения для первоначальной инициализации табличных частей ЛистОзнакомления
	|//
	|ВЫБРАТЬ
	|	ВТ.Документ		КАК Документ,
	|	ВТ.Сотрудник	КАК Сотрудник
	|ИЗ
	|	(ВЫБРАТЬ
	|		Объекты.Ссылка		КАК Документ,
	|		Объекты.Сотрудник	КАК Сотрудник
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации.Объекты КАК Объекты
	|	ГДЕ
	|		Объекты.Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|		И НЕ Объекты.Сотрудник В(&ПустойСотрудник)
	|		
	|	ОБЪЕДИНИТЬ
	|
	|	ВЫБРАТЬ
	|		Комиссии.Ссылка				КАК Документ,
	|		СоставКомиссии.Сотрудник	КАК Сотрудник
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК Комиссии
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|			ПО	Комиссии.Комиссия = СоставКомиссии.Ссылка
	|	ГДЕ
	|		Комиссии.Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|		И НЕ СоставКомиссии.Сотрудник В(&ПустойСотрудник)
	|	) КАК ВТ
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО	ВТ.Сотрудник = Сотрудники.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование
	|ИТОГИ
	|ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Сведения для первоначальной инициализации дат согласования
	|// 
	|ВЫБРАТЬ
	|	Ссылка					КАК Документ,
	|	Ссылка.Организация		КАК Организация,
	|	Сотрудник				КАК Сотрудник,
	|	МАКСИМУМ(УдалитьДата)	КАК УдалитьДата
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.ЛистСогласования КАК ЛистСогласования
	|ГДЕ
	|	ЛистСогласования.Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Сотрудник
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(УдалитьДата)<> &ПустаяДата
	|ИТОГИ
	|ПО
	|	Документ
	|;";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	// [0]. Сведения для первоначальной инициализации табличных частей ЛистОзнакомления
	Результат0 = РезультатыЗапроса[0];
	
	// [1]. Сведения для первоначальной инициализации дат согласования
	Результат1 = РезультатыЗапроса[1];
	
	Если Результат0.Пустой() И Результат1.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	СтатистикаДокументов = Новый Структура();
	СтатистикаДокументов.Вставить("КоличествоОшибок",	0);
	СтатистикаДокументов.Вставить("Обработано",			0);
	
	СтатистикаСогласования = Новый Структура();
	СтатистикаСогласования.Вставить("КоличествоОшибок",	0);
	СтатистикаСогласования.Вставить("Обработано",		0);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта",		ПолноеИмяОбъекта);
	ДополнительныеПараметры.Вставить("СтатистикаДокументов",	СтатистикаДокументов);
	ДополнительныеПараметры.Вставить("СтатистикаСогласования",	СтатистикаСогласования);
	
	Если Не Результат0.Пустой() Тогда
		ВыборкаДокумент = Результат0.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ОбработатьДокументыДляПереходаНаНовуюВерсию(ВыборкаДокумент, ДополнительныеПараметры);
	КонецЕсли;
	
	Если Не Результат1.Пустой() Тогда
		ВыборкаДокумент = Результат1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ИнициализироватьРезультатыСогласованияПоДокументам(ВыборкаДокумент, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 И ДополнительныеПараметры.СтатистикаСогласования.Обработано = 0 Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно завершено первоначальное заполнение табличной части ЛистОзнакомления в очередной порции объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.Обработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаСогласования.Обработано = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно завершено первоначальное заполнение результатов согласования в очередной порции объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаСогласования.Обработано);
		
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию(ВыборкаДокумент, ДополнительныеПараметры)
	
	СтатистикаДокументов = ДополнительныеПараметры.СтатистикаДокументов;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		ДокументСсылка = ВыборкаДокумент.Документ;
		
		Выборка = ВыборкаДокумент.Выбрать();
		
		Попытка
			
			ОбработатьДокументДляПереходаНаНовуюВерсию(ДокументСсылка, Выборка, ДополнительныеПараметры);
			
			СтатистикаДокументов.Обработано = СтатистикаДокументов.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось заполнить табличную часть ЛистОзнакомления документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаДокументов.КоличествоОшибок = СтатистикаДокументов.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;


КонецПроцедуры

Процедура ОбработатьДокументДляПереходаНаНовуюВерсию(ДокументСсылка, Выборка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ДокОбъект.ЛистОзнакомления.Количество() > 0 Тогда
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		ДокОбъект.ЛистОзнакомления.Очистить();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ДокОбъект.ЛистОзнакомления.Добавить();
			
			НоваяСтрока.Сотрудник = Выборка.Сотрудник;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ИнициализироватьРезультатыСогласованияПоДокументам(ВыборкаДокумент, ДополнительныеПараметры)
	
	СтатистикаСогласования = ДополнительныеПараметры.СтатистикаСогласования;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		ДокументСсылка = ВыборкаДокумент.Документ;
		
		Выборка = ВыборкаДокумент.Выбрать();
		
		Попытка
			
			ИнициализироватьРезультатыСогласованияПоДокументу(ДокументСсылка, Выборка, ДополнительныеПараметры);
			
			СтатистикаСогласования.Обработано = СтатистикаСогласования.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось добавить результат согласования для документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаСогласования.КоличествоОшибок = СтатистикаСогласования.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;

КонецПроцедуры

Процедура ИнициализироватьРезультатыСогласованияПоДокументу(ДокументСсылка, Выборка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	ВидДействияСогласование = Перечисления.ВидыДействийСотрудникаСДокументом.Согласование;
	
	Попытка
		
		НачатьТранзакцию();
		
		Пока Выборка.Следующий() Цикл
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить("РегистрСведений.РезультатыОзнакомленияСотрудников");
			Элемент.УстановитьЗначение("Организация",		Выборка.Организация);
			Элемент.УстановитьЗначение("ДокументОснование",	ДокументСсылка);
			Элемент.УстановитьЗначение("Сотрудник",			Выборка.Сотрудник);
			Элемент.УстановитьЗначение("ВидДействия",		ВидДействияСогласование);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			НаборЗаписей = РегистрыСведений.РезультатыОзнакомленияСотрудников.СоздатьНаборЗаписей();
			
			НаборЗаписей.Отбор.Организация.Установить(Выборка.Организация);
			НаборЗаписей.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
			НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументСсылка);
			НаборЗаписей.Отбор.ВидДействия.Установить(ВидДействияСогласование);
			
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей.Очистить();
			КонецЕсли;
			
			НаборЗаписей.Записывать = Истина;
			
			НоваяЗапись = НаборЗаписей.Добавить();
			
			НоваяЗапись.Организация			= Выборка.Организация;
			НоваяЗапись.ДокументОснование	= ДокументСсылка;
			НоваяЗапись.Сотрудник			= Выборка.Сотрудник;
			НоваяЗапись.ВидДействия			= ВидДействияСогласование;
			НоваяЗапись.Дата				= Выборка.УдалитьДата;
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#Область ОбработчикОбновления_2_0_87_24_РеквизитРуководитель

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_87_24(Параметры) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Руководитель = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И НЕ Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_87_24(Параметры) Экспорт
	
	ПолноеИмяОбъекта = "Документ.РешениеОПроведенииИнвентаризации";
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(
		Параметры.Очередь,
		ПолноеИмяОбъекта,
		МенеджерВременныхТаблиц,
		ДополнительныеПараметры);
	
	Запрос = Новый Запрос();
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(ВЫБРАТЬ Ссылка ИЗ ВТДляОбработки)";
	
	Результат = Запрос.Выполнить();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Результат.Пустой() Тогда
		Параметры.ОбработкаЗавершена = Истина;
		Возврат;
	КонецЕсли;
	
	СтатистикаДокументов = Новый Структура();
	СтатистикаДокументов.Вставить("КоличествоОшибок",	0);
	СтатистикаДокументов.Вставить("Обработано",			0);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПолноеИмяОбъекта",		ПолноеИмяОбъекта);
	ДополнительныеПараметры.Вставить("СтатистикаДокументов",	СтатистикаДокументов);
	
	Выборка = Результат.Выбрать();
	
	ОбработатьДокументыДляПереходаНаНовуюВерсию_2_0_87_24(Выборка, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано = 0 Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок);
			
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.Обработано > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Успешно установлен реквизит Руководитель в очередной порции документов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ДополнительныеПараметры.СтатистикаДокументов.Обработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Если ДополнительныеПараметры.СтатистикаДокументов.КоличествоОшибок > 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось установить реквизит Руководитель в очередной порции документов %1: %2 шт.'"),
