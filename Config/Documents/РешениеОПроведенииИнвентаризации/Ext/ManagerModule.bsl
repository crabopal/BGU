Процедура ОбработатьДокументыДляПереходаНаНовуюВерсию_2_0_87_24(Выборка, ДополнительныеПараметры)
	
	СтатистикаДокументов = ДополнительныеПараметры.СтатистикаДокументов;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументСсылка = Выборка.Ссылка;
		
		Попытка
			
			ОбработатьДокументДляПереходаНаНовуюВерсию_2_0_87_24(ДокументСсылка, ДополнительныеПараметры);
			
			СтатистикаДокументов.Обработано = СтатистикаДокументов.Обработано + 1;
			
		Исключение
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить реквизит Руководитель документа %1 по причине %2'"), 
				ДокументСсылка,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				ДокументСсылка.Метаданные(),
				ДокументСсылка,
				ТекстСообщения);
				
			СтатистикаДокументов.КоличествоОшибок = СтатистикаДокументов.КоличествоОшибок + 1;
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьДокументДляПереходаНаНовуюВерсию_2_0_87_24(ДокументСсылка, ДополнительныеПараметры)
	
	ПолноеИмяОбъекта = ДополнительныеПараметры["ПолноеИмяОбъекта"];
	
	Попытка
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
		Элемент.УстановитьЗначение("Ссылка", ДокументСсылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Блокировка.Заблокировать();
		
		ДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
			ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
			ДокОбъект.Организация, ДокОбъект.Дата, ДокОбъект.Подразделение);
			
		РуководительСсылка = Руководитель.ОтветственноеЛицоСсылка;
		
		Если ЗначениеЗаполнено(ДокОбъект.Руководитель) Или Не ЗначениеЗаполнено(РуководительСсылка) Тогда
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ДокументСсылка);
			Возврат;
		КонецЕсли;
		
		ДокОбъект.Руководитель = РуководительСсылка;
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

