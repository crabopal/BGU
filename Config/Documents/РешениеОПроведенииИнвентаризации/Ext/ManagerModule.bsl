#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	Если ИнвентаризацияСервер.ЕстьДублиСтрокТабличнаяЧастьКомиссии(ДокументОбъект) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПараметрыПроверкиЗаполненияРешения = ИнвентаризацияСервер.ПолучитьПараметрыПроверкиЗаполненияРешения(ДокументОбъект);
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	Если ИнвентаризацияСервер.ЕстьНедопустимыеНомераКомиссий(ДокументОбъект) Тогда
		ЕстьОшибкиЗаполнения = Истина;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьНаличиеРабочихКомиссийБезУполномоченногоЛицаПоОбъекту(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьДатыИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьНеобходимостьУказанияМОЛВТабличнойЧастиОбъекты(ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ИнвентаризацияСервер.ПроверитьДублиСотрудников(
		ДокументОбъект.ЛистСогласования,
		ДокументОбъект.Ссылка,
		"ЛистСогласования",
		НСтр("ru='Лист согласования'"),
		ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьДублиСотрудников(
		ДокументОбъект.ЛистОзнакомления,
		ДокументОбъект.Ссылка,
		"ЛистОзнакомления",
		НСтр("ru='Лист ознакомления'"),
		ЕстьОшибкиЗаполнения);
		
	ИнвентаризацияСервер.ПроверитьОтсутствиеМОЛвСоставеКомиссииРешения(ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ПроверитьНачалоИнвентаризации(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаРешения(
		ДокументОбъект, ЕстьОшибкиЗаполнения, ПараметрыПроверкиЗаполненияРешения);
	
	ПроверитьЛистОзнакомления(ДокументОбъект, ЕстьОшибкиЗаполнения);
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ЗаполнитьЛистОзнакомления(ДокументОбъект) Экспорт
	
	Данные = ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект);
	
	ТаблицаСотрудников = ИнвентаризацияСервер.СоставитьТаблицуСотрудниковДляЗаполненияТабличнойЧастиЛистОзнакомления(Данные);
	
	ДокументОбъект.ЛистОзнакомления.Загрузить(ТаблицаСотрудников);
	
КонецПроцедуры

Процедура ЗаполнитьЛистСогласования(ДокументОбъект) Экспорт
	
	СогласующиеЛица = ДокументОбъект.СогласующиеЛица;
	
	ТаблицаСотрудников = ИнвентаризацияСервер.ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистСогласования(СогласующиеЛица);
	
	ДокументОбъект.ЛистСогласования.Загрузить(ТаблицаСотрудников);
	
КонецПроцедуры

Функция ПолучитьРасположениеСотрудниковВРазделахДокумента(МассивДокументов) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Расчет колонок признаков принадлежности сотрудника различным разделам документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК Ссылка,
	|	Сотрудник					КАК Сотрудник,
	|	МАКСИМУМ(УказанВРазделе1)	КАК УказанВРазделе1,
	|	МАКСИМУМ(УказанВРазделе2)	КАК УказанВРазделе2
	|ИЗ
	|	(ВЫБРАТЬ
	|		Док.Ссылка			КАК Ссылка,
	|		ТЧОбъекты.Сотрудник	КАК Сотрудник,
	|		Истина				КАК УказанВРазделе1,
	|		Ложь				КАК УказанВРазделе2
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|			ПО	Док.Ссылка = ТЧОбъекты.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Док.Ссылка					КАК Ссылка,
	|		ТЧСоставКомиссии.Сотрудник	КАК Сотрудник,
	|		Ложь						КАК УказанВРазделе1,
	|		Истина						КАК УказанВРазделе2
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|			ПО	Док.Ссылка = ТЧКомиссии.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|			ПО	ТЧКомиссии.Комиссия = ТЧСоставКомиссии.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	Сотрудник
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

#Область МеханизмОзнакомленияСотрудников

// ТаблицаНастроекДокумента - см. ОбщегоНазначенияБГУ.МеханизмОзнакомленияСотрудников_ПустаяТаблицаНастроекДокумента()
Функция МеханизмОзнакомленияСотрудников_НастройкиДокумента(ТаблицаНастроекДокумента) Экспорт
	
	НоваяСтрока = ТаблицаНастроекДокумента.Добавить();
	НоваяСтрока.ИмяТабличнойЧасти								= "ЛистОзнакомления";
	НоваяСтрока.ВидДействияСотрудникаСДокументом				= Перечисления.ВидыДействийСотрудникаСДокументом.Ознакомление;
	НоваяСтрока.ДопустимоЕдиновременноеДействиеВсехСотрудников	= Истина;
	
	НоваяСтрока = ТаблицаНастроекДокумента.Добавить();
	НоваяСтрока.ИмяТабличнойЧасти								= "ЛистСогласования";
	НоваяСтрока.ВидДействияСотрудникаСДокументом				= Перечисления.ВидыДействийСотрудникаСДокументом.Согласование;
	НоваяСтрока.ДопустимоЕдиновременноеДействиеВсехСотрудников	= Истина;
	
КонецФункции

