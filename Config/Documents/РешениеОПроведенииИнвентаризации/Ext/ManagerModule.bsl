Функция ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистОзнакомления(ДокументОбъект)
	
	// Сотрудники из табличной части Объекты
	
	ТаблицаСотрудниковТЧОбъекты = ДокументОбъект.Объекты.Выгрузить(, "Сотрудник");
	ТаблицаСотрудниковТЧОбъекты.Свернуть("Сотрудник");
	
	// Сотрудники из табличной части Комиссии
	
	ВремТаблица = ДокументОбъект.Комиссии.Выгрузить(, "Комиссия");
	ВремТаблица.Свернуть("Комиссия");
	МассивСсылокКомиссии = ВремТаблица.ВыгрузитьКолонку("Комиссия");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылокКомиссии", МассивСсылокКомиссии);
	ЗапросПоиск.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                    |	ПостоянноДействующиеКомиссииСоставКомиссии.Сотрудник КАК Сотрудник
	                    |ИЗ
	                    |	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ПостоянноДействующиеКомиссииСоставКомиссии
	                    |ГДЕ
	                    |	ПостоянноДействующиеКомиссииСоставКомиссии.Ссылка В(&МассивСсылокКомиссии)";
	
	ТаблицаСотрудниковТЧКомиссии = ЗапросПоиск.Выполнить().Выгрузить();
	ТаблицаСотрудниковТЧКомиссии.Свернуть("Сотрудник");
	
	Данные = Новый Структура();
	
	Данные.Вставить("ТаблицаСотрудниковРаздел1",	ТаблицаСотрудниковТЧОбъекты);
	Данные.Вставить("ТаблицаСотрудниковРаздел2",	ТаблицаСотрудниковТЧКомиссии);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДанныеЛистовСогласования(МассивДокументов)

	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка,
	|	Номер	КАК Номер,
	|	Дата	КАК Дата
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата ВОЗР";
	
	ТаблицаШапки = ЗапросПоиск.Выполнить().Выгрузить();
	
	ТаблицаСотрудников = ОбщегоНазначенияБГУ.РезультатыОзнакомленияСотрудниковПоДокументам(МассивДокументов, "ЛистСогласования");
	
	ДанныеЛистовСогласования = Новый Структура();
	ДанныеЛистовСогласования.Вставить("Шапки", ТаблицаШапки);
	ДанныеЛистовСогласования.Вставить("ТаблицаСотрудников", ТаблицаСотрудников);
	
	Возврат ДанныеЛистовСогласования;
	
КонецФункции

