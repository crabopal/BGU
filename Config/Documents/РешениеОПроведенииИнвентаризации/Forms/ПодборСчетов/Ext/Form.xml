				<QueryText>ВЫБРАТЬ
	Ссылка								КАК Ссылка,
	НомерСтроки							КАК НомерСтроки,
	ВидСубконто.Наименование
	+ ВЫБОР
		КОГДА ТолькоОбороты ТОГДА
			" (об)"
		ИНАЧЕ
			""
	КОНЕЦ								КАК Наименование
ПОМЕСТИТЬ
	ВТВидыСубконто
ИЗ
	ПланСчетов.ЕПСБУ.ВидыСубконто
ГДЕ
	Ссылка В(&amp;СписокСчетов)
ИНДЕКСИРОВАТЬ ПО
	Ссылка,
	НомерСтроки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕПСБУ.Код КАК Код,
	ЕПСБУ.Наименование,
	ВЫБОР
		КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА "А"
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
					ТОГДА "П"
				ИНАЧЕ "АП"
			КОНЕЦ
	КОНЕЦ КАК Вид,
	ЕПСБУ.Забалансовый КАК Забалансовый,
	ЕПСБУ.Валютный,
	ЕПСБУ.Количественный,
	ЕПСБУ.Родитель,
	ЕПСБУ.Порядок КАК ПорядокСчетов,
	ЕПСБУ.ЗапретитьИспользоватьВПроводках,
	ЕПСБУ.НомерЖурнала,
	ЕПСБУ.ЭлементГруппа,
	ЕПСБУ.ДляКазенных,
	ЕПСБУ.ДляБюджетных,
	ЕПСБУ.ДляАвтономных,
	Субконто1.Наименование КАК Субконто1,
	Субконто2.Наименование КАК Субконто2,
	Субконто3.Наименование КАК Субконто3,
	ЕПСБУ.Ссылка,
	ЕПСБУ.ТипСчета,
	ЕПСБУ.УчетПоКПС,
	ЕПСБУ.УчетПоПодразделениям,
	ЕПСБУ.ДатаНачалаДействия,
	ЕПСБУ.ДатаОкончанияДействия
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	ЛЕВОЕ СОЕДИНЕНИЕ ВТВидыСубконто КАК Субконто1
		ПО ЕПСБУ.Ссылка = Субконто1.Ссылка
		И Субконто1.НомерСтроки = 1
	ЛЕВОЕ СОЕДИНЕНИЕ ВТВидыСубконто КАК Субконто2
		ПО ЕПСБУ.Ссылка = Субконто2.Ссылка
		И Субконто2.НомерСтроки = 2
	ЛЕВОЕ СОЕДИНЕНИЕ ВТВидыСубконто КАК Субконто3
		ПО ЕПСБУ.Ссылка = Субконто3.Ссылка
		И Субконто3.НомерСтроки = 3
ГДЕ
	ЕПСБУ.Ссылка В(&amp;СписокСчетов)</QueryText>
