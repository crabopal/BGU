			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументРешения.Ссылка КАК Решение,
	МАКСИМУМ(ДокументИзмененияРешения.НомерИзменения) КАК МаксимальныйНомерИзменения,
	МАКСИМУМ(ДокументИзмененияРешения.Аннулирующее) КАК Аннулирующее
ПОМЕСТИТЬ
	ДокументыИзмененияРешения
ИЗ
	Документ.РешениеОПроведенииИнвентаризации КАК ДокументРешения
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК ДокументИзмененияРешения
		ПО ДокументРешения.Ссылка = ДокументИзмененияРешения.Решение
		И НЕ ДокументРешения.ПометкаУдаления
		И НЕ ДокументИзмененияРешения.ПометкаУдаления
СГРУППИРОВАТЬ ПО
	ДокументРешения.Ссылка
;

ВЫБРАТЬ
	ДокументРешениеОПроведенииИнвентаризации.Ссылка,
	ДокументРешениеОПроведенииИнвентаризации.ПометкаУдаления,
	ДокументРешениеОПроведенииИнвентаризации.Номер,
	ДокументРешениеОПроведенииИнвентаризации.Дата,
	ДокументРешениеОПроведенииИнвентаризации.Проведен,
	ДокументРешениеОПроведенииИнвентаризации.Организация,
	ДокументРешениеОПроведенииИнвентаризации.Подразделение,
	ДокументРешениеОПроведенииИнвентаризации.ОснованиеПроведенияИнвентаризации,
	ДокументРешениеОПроведенииИнвентаризации.Комментарий,
	ДокументРешениеОПроведенииИнвентаризации.Ответственный,
	ДокументРешениеОПроведенииИнвентаризации.ДатаПодписиРуководитель,
	ДокументРешениеОПроведенииИнвентаризации.ДатаПодписиОтветственный,
	ДокументРешениеОПроведенииИнвентаризации.Объекты,
	ДокументРешениеОПроведенииИнвентаризации.Комиссии,
	ДокументРешениеОПроведенииИнвентаризации.АктыОПроведенииИнвентаризации,
	ДокументРешениеОПроведенииИнвентаризации.ЛистСогласования,
	ДокументРешениеОПроведенииИнвентаризации.МоментВремени,
	
	ДокументыИзмененияРешения.МаксимальныйНомерИзменения,
	ДокументыИзмененияРешения.Аннулирующее,
	NULL КАК ПредставлениеСпискаСчетов,
	ВЫБОР
		КОГДА ОтражениеЭДВУчетеОбороты.СуммаОборот &gt; 0
			ТОГДА "Отражение ЭД в учете"
		ИНАЧЕ СостоянияЭД.ПредставлениеСостояния
	КОНЕЦ КАК СостояниеЭДО,
	
	ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, Ложь) КАК ЕстьФайлы,
	
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен	
ИЗ
	Документ.РешениеОПроведенииИнвентаризации КАК ДокументРешениеОПроведенииИнвентаризации
		
		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыИзмененияРешения
		ПО ДокументРешениеОПроведенииИнвентаризации.Ссылка = ДокументыИзмененияРешения.Решение
	
	
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументРешениеОПроведенииИнвентаризации.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументРешениеОПроведенииИнвентаризации.Ссылка = НаличиеФайлов.ОбъектСФайлами}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОтражениеЭДВУчете.Обороты КАК ОтражениеЭДВУчетеОбороты
		ПО ДокументРешениеОПроведенииИнвентаризации.Ссылка = ОтражениеЭДВУчетеОбороты.ДокументОтраженияВУчете}</QueryText>
