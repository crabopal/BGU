&НаСервере
Процедура НастроитьФормуСервер(ИмяСобытия = Неопределено)
	
	Если Не ВыполненаИнициализация Тогда
		ИнициализироватьФормуСервер();
	КонецЕсли;
	
	Если ИмяСобытия = "ПриЧтении" Тогда
		ВыполненаНастройкаПриЧтении = Истина;
		
	ИначеЕсли ИмяСобытия = "ПриСоздании" И ВыполненаНастройкаПриЧтении Тогда
		Возврат;
	КонецЕсли;
	
	КэшироватьДанныеКомиссийДокумента();
	
	НастроитьФормуСерверПроверитьЦепочкуДокументов();
	
	ЗаполнитьСлужебныеКолонкиТаблицыОбъекты();
	
	ИнвентаризацияСервер.ЗаполнитьКолонкиРасположенияСотрудниковВРазделахДокумента(Объект);
	
	РазрешитьВыборГруппСчетов();
	
	ИнвентаризацияСервер.НастроитьОтборПоПодразделениюНаФормеРешения(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ПравоДоступаИзменение = ПравоДоступа("Изменение", Метаданные.Документы.РешениеОПроведенииИнвентаризации);
	
	УстановитьУсловноеОформление();
	
	ВыполненаИнициализация = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСерверПроверитьЦепочкуДокументов()
	
	ИнвентаризацияСервер.ИнициализироватьСостояниеЦепочкиДокументов(ЭтаФорма);
	
	ИнвентаризацияСервер.НастроитьФормуИндикаторыОшибокЦепочкиДокументов(ЭтаФорма);
	
	ИнвентаризацияСервер.НастроитьФормуИндикаторОкружающиеДокументы(ЭтаФорма);
	
	НастроитьФормуОграничениеРаботы();
	
КонецПроцедуры

&НаСервере
Процедура РазрешитьВыборГруппСчетов()
	
	НовыйПараметр = Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	
	НовыеПараметрыВыбора = Новый Массив();
	НовыеПараметрыВыбора.Добавить(НовыйПараметр);

	Элементы.ОбъектыСчет.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиТаблицыОбъекты()
	
	ИнвентаризацияСервер.КэшироватьТаблицуНастроекЗаполненияОписейПоРешению(ЭтаФорма);
	
	ИнвентаризацияСервер.ЗаполнитьСлужебныеКолонкиТаблицыОбъекты(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуОграничениеРаботы()
	
	РаботаФормыОграничена = ЕстьОшибкиЦепочки
		Или Объект.ПометкаУдаления
		Или ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка)
		Или ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Аннулирующий.ДокументСсылка)
		Или Не ПравоДоступаИзменение;
		
	РаботаЛистовОзнакомленияСогласованияОграничена = ЕстьОшибкиЦепочки
		Или Объект.ПометкаУдаления
		Или (ЗначениеЗаполнено(ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка)
			И Не ИнвентаризацияКлиентСервер.РазрешатьМодификациюЛистовОзнакомленияСогласованияЕслиВыполненыПоследующиеИзмененияРешения());
		
	Элементы.ГруппаШапка.ТолькоПросмотр = РаботаФормыОграничена;
	
	Элементы.ГруппаОбъекты.ТолькоПросмотр						= РаботаФормыОграничена;
	Элементы.ГруппаКомиссии.ТолькоПросмотр						= РаботаФормыОграничена;
	Элементы.ГруппаАктыОПроведенииИнвентаризации.ТолькоПросмотр	= РаботаФормыОграничена;
	
	Элементы.ГрупповоеЗаполнениеСтрок.Доступность = Не РаботаФормыОграничена;
	Элементы.ОбъектыЗаполнитьПоОстаткамНФА.Доступность = Не РаботаФормыОграничена;
	
	Элементы.ГруппаЛистСогласования.ТолькоПросмотр	= РаботаЛистовОзнакомленияСогласованияОграничена;
	Элементы.ГруппаЛистОзнакомления.ТолькоПросмотр	= РаботаЛистовОзнакомленияСогласованияОграничена;
	
	Элементы.ЛистОзнакомленияГруппаЗаполнить.Доступность = Не РаботаЛистовОзнакомленияСогласованияОграничена;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// Вывод 0 в пустой колонке КФО
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Вывод 0 в пустой колонке КФО'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.КФО");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "0");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОбъектыКФО");
	
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформление_ТаблицаОбъекты_МОЛ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИОткрытьФормуВыбораКомиссии()
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Новый Структура("НомерКомиссии,НомерРабочейКомиссии");
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекДанные);
	
	Если ЕстьДублиСтрокТабличнаяЧастьКомиссии() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресХранилища", Этаформа.АдресХранилища);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ТекущаяСтрока);
	
	ОписаниеОповещенияЗакрытие = Новый ОписаниеОповещения("ВыбранаСтрокаКомиссии", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ДеревоРабочихКомиссийДокумента", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияЗакрытие, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаСервере
Функция ЕстьДублиСтрокТабличнаяЧастьКомиссии()
	
	Возврат ИнвентаризацияСервер.ЕстьДублиСтрокТабличнаяЧастьКомиссии(Объект);
	
КонецФункции

&НаСервере
Процедура КэшироватьДанныеКомиссийДокумента(ОбновитьТабличныеДокументы = Истина)
	
	ИнвентаризацияСервер.КэшироватьДанныеКомиссийДокумента(ЭтаФорма, ОбновитьТабличныеДокументы, "ГруппаТабличныеДокументы");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранаСтрокаКомиссии(ВыбранноеЗначение, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ВыбранноеЗначение, "НомерКомиссии,НомерРабочейКомиссии");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиТабличныйДокументПодразделаРаздела2()
	
	ЗаголовокТабличногоДокумента = "";
	
	ТекДанные = Элементы.Комиссии.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерСтроки = ТекДанные.НомерСтроки;
	
	ЗаголовокТабличногоДокумента = Строка(НомерСтроки);
	
	ИмяЭлемента = СтрШаблон("СтраницаТабличныйДокументПодраздела%1", Формат(НомерСтроки, "ЧГ=0"));
	
	ЭлементСтраницы = Элементы.Найти(ИмяЭлемента);
	
	Если ЭлементСтраницы = Неопределено Тогда
		ЭлементСтраницы = Элементы["ГруппаПустойТабличныйДокумент"];
	КонецЕсли;
	
	Элементы.ГруппаТабличныеДокументы.ТекущаяСтраница = ЭлементСтраницы;
	
КонецПроцедуры

