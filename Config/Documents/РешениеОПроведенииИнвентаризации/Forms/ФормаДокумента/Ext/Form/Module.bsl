&НаКлиенте
Процедура ОткрытьФормуГрупповоеЗаполнениеСтрок()
	
	ЗначенияЗаполнения = Новый Структура("
		|КФО,
		|Счет,
		|Сотрудник,
		|ДатаИнвентаризации,
		|ДатаНачала,
		|ДатаОкончания,
		|НомерКомиссии,
		|НомерРабочейКомиссии,
		|МестоИнвентаризации,
		|Примечание");

	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ТекДанные);
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",	ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",		Элементы.Объекты.ВыделенныеСтроки.Количество());
	ПараметрыФормы.Вставить("АдресХранилища",		ЭтаФорма.АдресХранилища);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтаФорма);
	
	ОткрытьФорму("Документ.РешениеОПроведенииИнвентаризации.Форма.ФормаГрупповогоЗаполненияСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Объекты.ВыделенныеСтроки;
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = Объект.Объекты.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
	КонецЦикла;
		
	Модифицированность = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ОткрытьФормуЗаполнитьПоОстаткамНФА()
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		НаДату = ТекДанные.ДатаИнвентаризации;
	Иначе
		НаДату = Объект.Дата;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ПолучитьТекущуюДату();
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Организация",		Объект.Организация);
	ПараметрыФормы.Вставить("НаДату",			НаДату);
	ПараметрыФормы.Вставить("АдресХранилища",	ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаПодбораОстатковНФА", ЭтаФорма);
	
	ОткрытьФорму("Документ.РешениеОПроведенииИнвентаризации.Форма.ПодборОстатковНФА", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущуюДату()
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаПодбораОстатковНФА(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если Не ЭтоАдресВременногоХранилища(РезультатВыбора) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСведенияИзОстатков(РезультатВыбора);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСведенияИзОстатков(АдресХранилища)
	
	ВозвращенноеЗначение = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	ДатаИнвентаризации	= ВозвращенноеЗначение.НаДату;
	ТаблицаОстатков		= ВозвращенноеЗначение.ТаблицаОстатков;
	
	Для Каждого СтрокаТаблицыОстатков Из ТаблицаОстатков Цикл
		НоваяСтрока = Объект.Объекты.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОстатков, "КФО,Счет,Сотрудник,МестоИнвентаризации");
		
		НоваяСтрока.ДатаИнвентаризации = ДатаИнвентаризации;
	КонецЦикла;
	
	ИнвентаризацияСервер.ЗаполнитьСлужебныеКолонкиТаблицыОбъекты(ЭтаФорма);
	
КонецПроцедуры

