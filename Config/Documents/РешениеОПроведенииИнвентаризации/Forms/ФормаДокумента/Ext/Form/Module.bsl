&НаКлиенте
Процедура НастроитьЗаголовокСогласующиеЛица()
	
	Если ЗначениеЗаполнено(Объект.СогласующиеЛица) Тогда
		НовыйЗаголовок = Строка(Объект.СогласующиеЛица);
	Иначе
		НовыйЗаголовок = НСтр("ru='выбрать...'");
	КонецЕсли;
	
	Элементы.СогласующиеЛицаНадпись.Заголовок = НовыйЗаголовок;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКолонкиРасположенияСотрудниковВРазделахДокумента()
	
	ТекДанные = Элементы.ЛистОзнакомления.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("УказанВРазделе1,УказанВРазделе2");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДатуОтбораСчетов()
	
	ТекДанные = Элементы.Объекты.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.ДатаИнвентаризации) Тогда
		ДатаОтбораСчетов = ТекДанные.ДатаИнвентаризации;
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаОтбораСчетов = Объект.Дата;
		
	Иначе
		ДатаОтбораСчетов = ОбщегоНазначенияКлиент.ДатаСеанса();
	КонецЕсли;
	
КонецПроцедуры


