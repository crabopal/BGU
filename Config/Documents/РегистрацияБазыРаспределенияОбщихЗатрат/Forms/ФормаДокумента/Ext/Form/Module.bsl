&НаСервере
Процедура ПодготовитьФормуНаСервере()

	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	ЗаполнитьТаблицуИтоговНаФормеПоТабличнойЧасти();
	
	БазаРаспределенияЗаполнитьДобавленныеКолонки();
	ИтогиБазаРаспределенияЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма, Объект)

	ВидимостьЭлементовНалоговогоУчета =
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО);
	
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("ИтогиБазаРаспределенияНУ");
	РеквизитыНУ.Добавить("ИтогиБазаРаспределенияКоэффициентыНУ");
	РеквизитыНУ.Добавить("БазаРаспределенияНУ");
	РеквизитыНУ.Добавить("БазаРаспределенияКоэффициентыНУ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета);
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьТаблицуИтоговНаФормеПоТабличнойЧасти()
	
	ИтогиБазаРаспределения.Очистить();
	
	ТаблицаИтогиБазаРаспределения = Объект.БазаРаспределения.Выгрузить();
	ТаблицаИтогиБазаРаспределения.Свернуть(
		"СчетСебестоимости,Подразделение,НаправлениеДеятельности",
		"Показатель,ПоказательНУ,ПоказательЕНВД,ПоказательНеУчитываетсяНУ");
	
	Для Каждого СтрокаТаблицы Из ТаблицаИтогиБазаРаспределения Цикл
		
		ИдСтроки = Новый УникальныйИдентификатор;
		СтрокаИтоги = ИтогиБазаРаспределения.Добавить();
		СтрокаИтоги.ИдСтроки = ИдСтроки;
		ЗаполнитьЗначенияСвойств(СтрокаИтоги, СтрокаТаблицы,
			"СчетСебестоимости, Подразделение, НаправлениеДеятельности");
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетСебестоимости);
		СтрокаИтоги.ЕстьПодразделение = (ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям);
		СтрокаИтоги.ЕстьНаправлениеДеятельности = БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
			СтрокаТаблицы.СчетСебестоимости, ПланыВидовХарактеристик.ВидыСубконто.НаправленияДеятельности);
		
		Отбор = Новый Структура("СчетСебестоимости");
		Если СтрокаИтоги.ЕстьПодразделение Тогда
			Отбор.Вставить("Подразделение");
		КонецЕсли;
		Если СтрокаИтоги.ЕстьНаправлениеДеятельности Тогда
			Отбор.Вставить("НаправлениеДеятельности");
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаИтоги);
		
		НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
		Для каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
			
			СтрокаБазаРаспределения.ИдСтроки = ИдСтроки;
			
			// Рассчитываем итоговые суммы по детельным строкам.
			СтрокаИтоги.Показатель = СтрокаИтоги.Показатель +
				СтрокаБазаРаспределения.Показатель;
			СтрокаИтоги.ПоказательНУ = СтрокаИтоги.ПоказательНУ +
				СтрокаБазаРаспределения.ПоказательНУ;
			СтрокаИтоги.ПоказательЕНВД = СтрокаИтоги.ПоказательЕНВД +
				СтрокаБазаРаспределения.ПоказательЕНВД;
			СтрокаИтоги.ПоказательНеУчитываетсяНУ = СтрокаИтоги.ПоказательНеУчитываетсяНУ +
				СтрокаБазаРаспределения.ПоказательНеУчитываетсяНУ;
			
			БазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаБазаРаспределения, СтрокаТаблицы);
			
		КонецЦикла;
		
		ИтогиБазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаИтоги, ТаблицаИтогиБазаРаспределения);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьБазуРаспределения(БазаРаспределения)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидОбщихЗатрат) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид общих затрат'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.ВидОбщихЗатрат");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'КФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.КФО");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.БазаРаспределения.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		ДополнительныеПараметры = Новый Структура("БазаРаспределения", БазаРаспределения);
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьБазуРаспределенияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьБазуРаспределенияНаСервере(БазаРаспределения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьБазуРаспределенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьБазуРаспределенияНаСервере(ДополнительныеПараметры.БазаРаспределения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБазуРаспределенияНаСервере(БазаРаспределения)
	
	Объект.БазаРаспределения.Очистить();
	ТабЧастьБазаРаспределения = Объект.БазаРаспределения.Выгрузить();
	
	// Бухгалтерский учет.
	ПараметрыУчетаЗатратБУ = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ПараметрыУчетаЗатрат(
		Объект.Дата, Объект.Организация, Объект.ИФО, Объект.КФО, "БУ");
	
	Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты
	 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда
	 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ПрямыеЗатраты Тогда
	 
	 	ПараметрыРаспределения = УчетПроизводства.ПараметрыРаспределенияОбщихЗатрат(Объект.Организация, Объект.Дата);
		СтрокаМетодаРаспределения = УчетПроизводстваКлиентСервер.СтрокаБазыРаспределенияОбщихЗатрат(
			ПараметрыРаспределения.МетодыРаспределенияКосвенныхЗатрат,
			Объект.ВидОбщихЗатрат,
			Объект.ИФО,
			Объект.КФО,
			БазаРаспределения);
		Если СтрокаМетодаРаспределения = Неопределено Тогда
			СтрокаМетодаРаспределения = ПараметрыРаспределения.МетодыРаспределенияКосвенныхЗатрат.Добавить();
			СтрокаМетодаРаспределения.ВидОбщихЗатрат = Объект.ВидОбщихЗатрат;
			СтрокаМетодаРаспределения.КФО = Объект.КФО;
			СтрокаМетодаРаспределения.БазаРаспределения = БазаРаспределения;
		КонецЕсли;
		
		ТаблицаБазаРаспределения = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.СформироватьБазуРаспределенияПоЗатратам(
			Объект.ВидОбщихЗатрат, СтрокаМетодаРаспределения, ПараметрыУчетаЗатратБУ, "БУ");
		
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.Выручка Тогда
		
		ТаблицаБазаРаспределения = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.СформироватьБазуРаспределенияПоВыручке(
			Объект.ВидОбщихЗатрат, БазаРаспределения, ПараметрыУчетаЗатратБУ, "БУ");
		
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаБазаРаспределения Цикл
		
		НоваяСтрока = ТабЧастьБазаРаспределения.Добавить();
		НоваяСтрока.СчетСебестоимости       = СтрокаТаблицы.Счет;
		НоваяСтрока.Подразделение           = СтрокаТаблицы.Подразделение;
		НоваяСтрока.НаправлениеДеятельности = СтрокаТаблицы.НаправлениеДеятельности;
		НоваяСтрока.НоменклатурнаяГруппа    = СтрокаТаблицы.НоменклатурнаяГруппа;
		НоваяСтрока.Показатель              = СтрокаТаблицы.Сумма;
		
	КонецЦикла;
	
	// Налоговый учет.
	Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Объект.Организация, Объект.Дата, Объект.КФО) Тогда
		
		ПараметрыУчетаЗатратНУ = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.ПараметрыУчетаЗатрат(
			Объект.Дата, Объект.Организация, Объект.ИФО, Объект.КФО, "НУ");
		
		Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты
		 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда
		 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ПрямыеЗатраты Тогда
			
			ТаблицаБазаРаспределения = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.СформироватьБазуРаспределенияПоЗатратам(
				Объект.ВидОбщихЗатрат, СтрокаМетодаРаспределения, ПараметрыУчетаЗатратНУ, "НУ");
			
		ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.Выручка Тогда
			
			ТаблицаБазаРаспределения = Документы.ЗакрытиеСчетовПроизводственныхЗатрат.СформироватьБазуРаспределенияПоВыручке(
				Объект.ВидОбщихЗатрат, БазаРаспределения, ПараметрыУчетаЗатратНУ, "НУ");
			
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ТаблицаБазаРаспределения Цикл
			
			НоваяСтрока = ТабЧастьБазаРаспределения.Добавить();
			НоваяСтрока.СчетСебестоимости         = ПараметрыУчетаЗатратБУ.СчетСебестоимость;
			НоваяСтрока.Подразделение             = СтрокаТаблицы.Подразделение;
			НоваяСтрока.НаправлениеДеятельности   = СтрокаТаблицы.НаправлениеДеятельности;
			НоваяСтрока.НоменклатурнаяГруппа      = СтрокаТаблицы.НоменклатурнаяГруппа;
			НоваяСтрока.ПоказательНУ              = СтрокаТаблицы.Сумма;
			НоваяСтрока.ПоказательЕНВД            = СтрокаТаблицы.СуммаЕНВД;
			НоваяСтрока.ПоказательНеУчитываетсяНУ = СтрокаТаблицы.СуммаНеУчитываетсяНУ;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТабЧастьБазаРаспределения.Свернуть("СчетСебестоимости, Подразделение, НаправлениеДеятельности, НоменклатурнаяГруппа",
		"Показатель, ПоказательНУ, ПоказательЕНВД, ПоказательНеУчитываетсяНУ");
	Объект.БазаРаспределения.Загрузить(ТабЧастьБазаРаспределения);
	
	ЗаполнитьТаблицуИтоговНаФормеПоТабличнойЧасти();
	БазаРаспределенияЗаполнитьДобавленныеКолонки();
	ИтогиБазаРаспределенияЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

