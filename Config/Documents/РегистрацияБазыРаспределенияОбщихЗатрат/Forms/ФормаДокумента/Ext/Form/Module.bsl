
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПредставлениеПериодаРегистрации = ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
		ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"),
		НачалоМесяца(Объект.Дата), КонецМесяца(Объект.Дата));
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьТаблицуИтоговНаФормеПоТабличнойЧасти();
	
	БазаРаспределенияЗаполнитьДобавленныеКолонки();
	ИтогиБазаРаспределенияЗаполнитьДобавленныеКолонки();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииНаСервере();
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение", ЭтотОбъект);
	ВыборПериодаКлиент.ПериодНачалоВыбора(
		ЭтотОбъект, 
		Элемент, 
		СтандартнаяОбработка, 
		ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"), 
		НачалоМесяца(Объект.Дата), 
		ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииНачалоВыбораЗавершение(СтруктураПериода, ДополнительныеПараметры) Экспорт
	
	Если СтруктураПериода <> Неопределено Тогда // Установим выбранный период.
		
		Объект.Дата = КонецМесяца(СтруктураПериода.КонецПериода);
		
		// Представление выбранного периода запомним в кэше в локальных параметрах.
		ЭтотОбъект.КэшПараметров.Локальные.Вставить("ПредставлениеПериода", СтруктураПериода.Период);
		
		ОбщегоНазначенияБГУКлиент.ПриИзмененииДатыДокумента(ЭтотОбъект, Объект, "ДатаПриИзмененииНаКлиенте");
		// Дальнейшая обработка изменения даты выполняется в процедурах ДатаПриИзмененииНаКлиенте и ДатаПриИзмененииНаСервере.
		// Код, размещенный здесь, может работать неправильно, т.к. пользователь мог отказаться от изменения даты.
		
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПериодаРегистрацииОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзмененииНаКлиенте(Результат, ДополнительныеПараметры) Экспорт
	
	// Структура КэшПараметров инициализируется в ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы().
	Если ЭтотОбъект.КэшПараметров.ИзмениласьДатаНаМесяцИБолее Тогда
		
		ДатаПриИзмененииНаСервере();
		
	КонецЕсли;
	
	// Установим представление выбранного периода в реквизите формы документа.
	ПредставлениеПериодаРегистрации = ЭтотОбъект.КэшПараметров.Локальные.ПредставлениеПериода;
	
	ОбщегоНазначенияБГУКлиент.ПослеИзмененияКлючевыхРеквизитовДокумента(ЭтотОбъект, Объект)
	
КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИтогиБазаРаспределения

&НаКлиенте
Процедура ИтогиБазаРаспределенияПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтборВТаблицеБазаРаспределения", 0.4, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	Отбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
	Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
		Объект.БазаРаспределения.Удалить(СтрокаБазаРаспределения);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки = Новый УникальныйИдентификатор;
		ИтогиБазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияПослеУдаления(Элемент)
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияСчетСебестоимостиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетСебестоимости) Тогда
		
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.СчетСебестоимости);
		ТекущиеДанные.ЕстьПодразделение = (ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям);
		ТекущиеДанные.ЕстьНаправлениеДеятельности = БухгалтерскийУчетВызовСервераПовтИсп.ЕстьСубконтоСчета(ТекущиеДанные.СчетСебестоимости,
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности"));
		
		Отбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
		НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
		Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
			СтрокаБазаРаспределения.СчетСебестоимости = ТекущиеДанные.СчетСебестоимости;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияПодразделениеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	
	Если ТекущиеДанные.ЕстьПодразделение Тогда
		Отбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
		НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
		Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
			СтрокаБазаРаспределения.Подразделение = ТекущиеДанные.Подразделение;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияНаправлениеДеятельностиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	
	Если ТекущиеДанные.ЕстьНаправлениеДеятельности Тогда
		Отбор = Новый Структура("ИдСтроки", ТекущиеДанные.ИдСтроки);
		НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
		Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
			СтрокаБазаРаспределения.НаправлениеДеятельности = ТекущиеДанные.НаправлениеДеятельности;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборВТаблицеБазаРаспределения()

	ТекущиеДанные = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки",
			Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки",
			ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.БазаРаспределения.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.ИдСтроки <> НовОтборСтрок.ИдСтроки Тогда
		Элементы.БазаРаспределения.ОтборСтрок = НовОтборСтрок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияПересчитатьБазуРаспределения(СтрокаИтогиБазаРаспределения = Неопределено)
	
	Если СтрокаИтогиБазаРаспределения <> Неопределено Тогда
		ИтогиБазаРаспределенияРассчитатьПоказателиРаспределения(СтрокаИтогиБазаРаспределения);
	КонецЕсли;
	
	Для Каждого СтрокаИтогов Из ИтогиБазаРаспределения Цикл
		ИтогиБазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаИтогов, ИтогиБазаРаспределения);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогиБазаРаспределенияРассчитатьПоказателиРаспределения(СтрокаИтогиБазаРаспределения)
	
	СтрокаИтогиБазаРаспределения.Показатель                = 0;
	СтрокаИтогиБазаРаспределения.ПоказательНУ              = 0;
	СтрокаИтогиБазаРаспределения.ПоказательЕНВД            = 0;
	СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ = 0;
	
	Отбор = Новый Структура("ИдСтроки", СтрокаИтогиБазаРаспределения.ИдСтроки);
	НайденныеСтроки = Объект.БазаРаспределения.НайтиСтроки(Отбор);
	Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
		
		СтрокаИтогиБазаРаспределения.Показатель = СтрокаИтогиБазаРаспределения.Показатель
			+ СтрокаБазаРаспределения.Показатель;
		СтрокаИтогиБазаРаспределения.ПоказательНУ = СтрокаИтогиБазаРаспределения.ПоказательНУ
			+ СтрокаБазаРаспределения.ПоказательНУ;
		СтрокаИтогиБазаРаспределения.ПоказательЕНВД = СтрокаИтогиБазаРаспределения.ПоказательЕНВД
			+ СтрокаБазаРаспределения.ПоказательЕНВД;
		СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ = СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ
			+ СтрокаБазаРаспределения.ПоказательНеУчитываетсяНУ;
		
	КонецЦикла;
	
	// В итоговой строке изменились итоговые показатели - пересчитаем коэффициенты распределения.
	Для Каждого СтрокаБазаРаспределения Из НайденныеСтроки Цикл
		БазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаБазаРаспределения, СтрокаИтогиБазаРаспределения);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИтогиБазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаИтогиБазаРаспределения, ИтогиБазаРаспределения)
	
	ИтогоПоказатель                = ИтогиБазаРаспределения.Итог("Показатель");
	ИтогоПоказательНУ              = ИтогиБазаРаспределения.Итог("ПоказательНУ");
	ИтогоПоказательЕНВД            = ИтогиБазаРаспределения.Итог("ПоказательЕНВД");
	ИтогоПоказательНеУчитываетсяНУ = ИтогиБазаРаспределения.Итог("ПоказательНеУчитываетсяНУ");
	
	Коэффициент = ?(ИтогоПоказатель = 0, 0,
		СтрокаИтогиБазаРаспределения.Показатель / ИтогоПоказатель);
	КоэффициентНУ = ?(ИтогоПоказательНУ = 0, 0,
		СтрокаИтогиБазаРаспределения.ПоказательНУ / ИтогоПоказательНУ);
	КоэффициентЕНВД = ?(ИтогоПоказательЕНВД = 0, 0,
		СтрокаИтогиБазаРаспределения.ПоказательЕНВД / ИтогоПоказательЕНВД);
	КоэффициентНеУчитываетсяНУ = ?(ИтогоПоказательНеУчитываетсяНУ = 0, 0,
		СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ / ИтогоПоказательНеУчитываетсяНУ);
	
	СтрокаИтогиБазаРаспределения.Коэффициент                = Формат(Коэффициент*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаИтогиБазаРаспределения.КоэффициентНУ              = Формат(КоэффициентНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаИтогиБазаРаспределения.КоэффициентЕНВД            = Формат(КоэффициентЕНВД*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаИтогиБазаРаспределения.КоэффициентНеУчитываетсяНУ = Формат(КоэффициентНеУчитываетсяНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	
КонецПроцедуры

&НаСервере
Процедура ИтогиБазаРаспределенияЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из ИтогиБазаРаспределения Цикл
		
		//БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		//	СтрокаТаблицы, СтрокаТаблицы.СчетДт, БазаРаспределенияПоляАналитикиСчетаСписания());
		//БазаРаспределенияУстановитьДоступностьПодразделенияДт(СтрокаТаблицы);
		ИтогиБазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИтогиБазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокНУ              = НСтр("ru = 'Сумма (НУ):'");
	СтрокаТаблицы.ЗаголовокНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_БазаРаспределения

&НаКлиенте
Процедура БазаРаспределенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекущиеИтогиБазаРаспределения = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
	Если ТекущиеИтогиБазаРаспределения = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Не выбрана строка базы распределения по счетам, подразделениям, направлениям деятельности!'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.БазаРаспределения.ТекущиеДанные;
		БазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(ТекущиеДанные);
		
		ТекущиеИтогиБазаРаспределения = Элементы.ИтогиБазаРаспределения.ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ТекущиеИтогиБазаРаспределения, "ИдСтроки, СчетСебестоимости");
		Если ТекущиеИтогиБазаРаспределения.ЕстьПодразделение Тогда
			ТекущиеДанные.Подразделение = ТекущиеИтогиБазаРаспределения.Подразделение;
		КонецЕсли;
		Если ТекущиеИтогиБазаРаспределения.ЕстьНаправлениеДеятельности Тогда
			ТекущиеДанные.НаправлениеДеятельности = ТекущиеИтогиБазаРаспределения.НаправлениеДеятельности;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если НоваяСтрока Тогда
		ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПослеУдаления(Элемент)
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПоказательПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.БазаРаспределения.ТекущиеДанные;
	ТекущиеДанные.ПоказательНУ = ТекущиеДанные.Показатель;
	ТекущиеДанные.ПоказательЕНВД = 0;
	ТекущиеДанные.ПоказательНеУчитываетсяНУ = 0;
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПоказательНУПриИзменении(Элемент)
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПоказательЕНВДПриИзменении(Элемент)
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура БазаРаспределенияПоказательНеУчитываетсяНУПриИзменении(Элемент)
	
	ИтогиБазаРаспределенияПересчитатьБазуРаспределения(Элементы.ИтогиБазаРаспределения.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура БазаРаспределенияРассчитатьКоэффициентыВСтрокеТаблицы(СтрокаБазаРаспределения, СтрокаИтогиБазаРаспределения)
	
	Коэффициент = ?(СтрокаИтогиБазаРаспределения.Показатель = 0, 0,
		СтрокаБазаРаспределения.Показатель / СтрокаИтогиБазаРаспределения.Показатель);
	КоэффициентНУ = ?(СтрокаИтогиБазаРаспределения.ПоказательНУ = 0, 0,
		СтрокаБазаРаспределения.ПоказательНУ / СтрокаИтогиБазаРаспределения.ПоказательНУ);
	КоэффициентЕНВД = ?(СтрокаИтогиБазаРаспределения.ПоказательЕНВД = 0, 0,
		СтрокаБазаРаспределения.ПоказательЕНВД / СтрокаИтогиБазаРаспределения.ПоказательЕНВД);
	КоэффициентНеУчитываетсяНУ = ?(СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ = 0, 0,
		СтрокаБазаРаспределения.ПоказательНеУчитываетсяНУ / СтрокаИтогиБазаРаспределения.ПоказательНеУчитываетсяНУ);
	
	СтрокаБазаРаспределения.Коэффициент                = Формат(Коэффициент*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаБазаРаспределения.КоэффициентНУ              = Формат(КоэффициентНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаБазаРаспределения.КоэффициентЕНВД            = Формат(КоэффициентЕНВД*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	СтрокаБазаРаспределения.КоэффициентНеУчитываетсяНУ = Формат(КоэффициентНеУчитываетсяНУ*100, "ЧЦ=5; ЧДЦ=2; ЧН=0") + "%";
	
КонецПроцедуры

&НаСервере
Процедура БазаРаспределенияЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.БазаРаспределения Цикл
		
		//БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		//	СтрокаТаблицы, СтрокаТаблицы.СчетДт, БазаРаспределенияПоляАналитикиСчетаСписания());
		//БазаРаспределенияУстановитьДоступностьПодразделенияДт(СтрокаТаблицы);
		БазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура БазаРаспределенияОбновитьТекстЗаголовковВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокНУ              = НСтр("ru = 'Сумма (НУ):'");
	СтрокаТаблицы.ЗаголовокНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	
КонецПроцедуры

