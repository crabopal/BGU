КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Дата, КФО");
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Реквизиты.Организация, Реквизиты.Дата, Реквизиты.КФО));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияБазыРаспределения.Ссылка.Дата КАК Период,
	|	РегистрацияБазыРаспределения.Ссылка.Организация КАК Организация,
	|	РегистрацияБазыРаспределения.Ссылка.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	РегистрацияБазыРаспределения.Ссылка.ИФО КАК ИФО,
	|	РегистрацияБазыРаспределения.Ссылка.КФО КАК КФО,
	|	РегистрацияБазыРаспределения.СчетСебестоимости КАК СчетСебестоимости,
	|	РегистрацияБазыРаспределения.Подразделение КАК Подразделение,
	|	РегистрацияБазыРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	РегистрацияБазыРаспределения.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	РегистрацияБазыРаспределения.Показатель КАК Коэффициент,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА РегистрацияБазыРаспределения.ПоказательНУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоэффициентНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА РегистрацияБазыРаспределения.ПоказательЕНВД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоэффициентЕНВД,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА РегистрацияБазыРаспределения.ПоказательНеУчитываетсяНУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоэффициентНеУчитываетсяНУ
	|ИЗ
	|	Документ.РегистрацияБазыРаспределенияОбщихЗатрат.БазаРаспределения КАК РегистрацияБазыРаспределения
	|ГДЕ
	|	РегистрацияБазыРаспределения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрацияБазыРаспределения.НомерСтроки";
	
	Результат = Запрос.Выполнить();
	
	ТаблицыДляДвижений.Вставить("ФиксированнаяБазаРаспределенияОбщихЗатрат", Результат.Выгрузить());
	
КонецПроцедуры

