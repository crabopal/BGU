Процедура ИнициализироватьНовуюКолонку_2_0_32() Экспорт
	
	// Сведения для вывода в журнал регистрации
	ИмяСобытия					= НСтр("ru='Данные. Изменение'");
	КомментарийОК 				= НСтр("ru='Успешно обработано документов: %1 - Инициализация новой колонки ОбъектНалогообложения в документах Регистрация строки книги покупок'");
	КомментарийОшибка			= НСтр("ru='Ошибок при обработке документов: %1 - Инициализация новой колонки ОбъектНалогообложения в документах Регистрация строки книги покупок'");
	КомментарийПропуск			= НСтр("ru='Документов, подлежащих обработке, не обнаружено - Инициализация новой колонки ОбъектНалогообложения в документах Регистрация строки книги покупок'");
	КомментарийБлокировка		= НСтр("ru='Не удалось заблокировать документы для модификации - Инициализация новой колонки ОбъектНалогообложения в документах Регистрация строки книги покупок'");
	КомментарийОшибкаДокумент	= НСтр("ru='Ошибка при обработке документа (%1) - Инициализация новой колонки ОбъектНалогообложения в документах Регистрация строки книги покупок'");
	
	// Настраиваем запрос
	ЗапросЗаполнение = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка						КАК Ссылка,
	|	Ссылка.ДокументОснование	КАК ДокументОснование
	|ИЗ
	|	Документ.РегистрацияСтрокиКнигиПокупок.СоставНФА	КАК СоставНФА
	|ГДЕ
	|	ОбъектНалогообложения = НЕОПРЕДЕЛЕНО
	|;");
	
	Выборка = ЗапросЗаполнение.Выполнить().Выбрать();
	
	СчетчикДокументовВсего	= Выборка.Количество();
	СчетчикДокументовОК		= 0;
	СчетчикДокументовОшибка	= 0;
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокументОбъект = Выборка["Ссылка"].ПолучитьОбъект();
			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ТЧСоставНФА = ДокументОбъект["СоставНФА"];
			
			Для Каждого СтрокаТЧ Из ТЧСоставНФА Цикл
				СтрокаТЧ["ОбъектНалогообложения"] = Выборка["ДокументОснование"];
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
			
			СчетчикДокументовОК = СчетчикДокументовОК + 1;
			
		Исключение
			СчетчикДокументовОшибка = СчетчикДокументовОшибка + 1;
			ПоследняяОшибка = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			
			Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибкаДокумент,
				Строка(Выборка["Ссылка"])) + ". " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
			
			// Выходим:
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	// Сообщения в журнале регистрации
	
	Если СчетчикДокументовВсего = 0 Тогда
		Комментарий = КомментарийПропуск;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОК > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОК, Строка(СчетчикДокументовОК));
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
	Если СчетчикДокументовОшибка > 0 Тогда
		Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийОшибка, Строка(СчетчикДокументовОшибка))
			+ ". Последняя ошибка: " + ПоследняяОшибка;
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Ошибка,		// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
	КонецЕсли;
	
КонецПроцедуры

