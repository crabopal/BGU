// Применяемая инструкция
//---

Процедура ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(ШапкаДокумента, ЗаполняемаяТаблица, ИдентификаторИнструкции = Неопределено, СтрокаТаблицы = Неопределено) Экспорт
	
	СтруктураСвойств = Новый Структура("
		|СчетВычетКт,
		|СчетВычетКтЕдинственный,
		|СчетВычетКтКРаспределениюПоУмолчанию,
		|СчетВычетКтБезРаспределенияПоУмолчанию,
		|ВидыПоказателяКПСВычетКт,
		|Счет30304,
		|Счет30304Единственный,
		|ВидыПоказателяКПС30304,
			|ИзменилсяСчетВычетКт,
			|ИзменилсяСчет30304");
		
	// Структура для определения применяемой инструкции
	// (эти реквизиты берем из шапки)
	ОбъектСтруктура = Новый Структура("
		|Организация,
		|ПричинаНалогообложения,
		|Дата,
		|ИФО,
		|Действие");
	ЗаполнитьЗначенияСвойств(ОбъектСтруктура, ШапкаДокумента);
	
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		МассивСтрок = ЗаполняемаяТаблица;
		Если ТипЗнч(ЗаполняемаяТаблица) = Тип("ТаблицаЗначений") Тогда
			МассивСчетВычетКт = ЗаполняемаяТаблица.ВыгрузитьКолонку("СчетВычетКт");
		Иначе
			МассивСчетВычетКт = ЗаполняемаяТаблица.Выгрузить(, "СчетВычетКт").ВыгрузитьКолонку("СчетВычетКт");
		КонецЕсли;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(СтрокаТаблицы);
		МассивСчетВычетКт = Новый Массив();
		МассивСчетВычетКт.Добавить(СтрокаТаблицы["СчетВычетКт"]);
	КонецЕсли;
	
	// Определим счета-родители и запомним их
	// (нужно для дальнейшего очищения счетов, если они не соответствуют инструкции)
	РезультатЗапросаРодители = ПолучитьРодителейСчетов(МассивСчетВычетКт);
	ВыборкаСчет = РезультатЗапросаРодители.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		// Эти реквизиты берем из таблицы
		ОбъектСтруктура.Вставить("КФО", СтрокаТЧ["КФО"]);
		
		// Одноименные свойства инструкции
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура, , ИдентификаторИнструкции);
		ЗаполнитьЗначенияСвойств(СтруктураСвойств, ПрименяемаяИнструкцияСтруктура);
		
		// Дополнительные рассчитанные свойства
		ТекущаяСтруктураСвойств = СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"];
		ТекущиеЗначенияСчетов = Новый Структура("СчетВычетКт, Счет30304");
		Если ЗначениеЗаполнено(ТекущаяСтруктураСвойств) Тогда
			ЗаполнитьЗначенияСвойств(ТекущиеЗначенияСчетов, ТекущаяСтруктураСвойств);
		КонецЕсли;
		ИзменилсяСчетВычетКт	= НЕ (ТекущиеЗначенияСчетов["СчетВычетКт"] = СтруктураСвойств["СчетВычетКт"]);
		ИзменилсяСчет30304			= НЕ (ТекущиеЗначенияСчетов["Счет30304"] = СтруктураСвойств["Счет30304"]);
		СтруктураСвойств.Вставить("Счет30304Единственный",		Истина);
		СтруктураСвойств.Вставить("ИзменилсяСчетВычетКт",	ИзменилсяСчетВычетКт);
		СтруктураСвойств.Вставить("ИзменилсяСчет30304",			ИзменилсяСчет30304);
		
		// Родители счета из текущей строки
		СчетВычетКтРодители = Новый Массив();
		// Продвигаемся в выборке до текущего счета
		ПоискТекущегоСчета = Новый Структура("Счет", СтрокаТЧ["СчетВычетКт"]);
		ВыборкаСчет.Сбросить();
		ВыборкаСчет.НайтиСледующий(ПоискТекущегоСчета);
		ВыборкаСчетРодители = ВыборкаСчет.Выбрать();
		Пока ВыборкаСчетРодители.Следующий() Цикл
			СчетВычетКтРодители.Добавить(ВыборкаСчетРодители["Родитель"]);
		КонецЦикла;
		СтруктураСвойств.Вставить("СчетВычетКтРодители",	СчетВычетКтРодители);
		
		СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"] = СтруктураСвойств; //Новый ФиксированнаяСтруктура(СтруктураСвойств);
	КонецЦикла;
	
КонецПроцедуры

// В таблице должна быть заранее заполнена колонка ПрименяемаяИнструкция_СтруктураСвойств.
Процедура ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(ЗаполняемаяТаблица, ПараметрыПодбораКПС, ПараметрыЗаполнения = Неопределено) Экспорт
	
	// Параметры заполнения
	Перем	ЗаполнитьСчетВычетКт,
			ЗаполнитьСчет30304,
			СтрокаТаблицы;
	
	Если ТипЗнч(ПараметрыЗаполнения) = Тип("Структура") Тогда
		ПараметрыЗаполнения.Свойство("ЗаполнитьСчетВычетКт",	ЗаполнитьСчетВычетКт);
		ПараметрыЗаполнения.Свойство("ЗаполнитьСчет30304",		ЗаполнитьСчет30304);
		ПараметрыЗаполнения.Свойство("СтрокаТаблицы",			СтрокаТаблицы);
	КонецЕсли;
	Если НЕ ЗаполнитьСчетВычетКт = Ложь Тогда
		ЗаполнитьСчетВычетКт = Истина; // Значение по умолчанию
	КонецЕсли;
	Если НЕ ЗаполнитьСчет30304 = Ложь Тогда
		ЗаполнитьСчет30304 = Истина; // Значение по умолчанию
	КонецЕсли;
	
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		МассивСтрок	= ЗаполняемаяТаблица;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(СтрокаТаблицы);
	КонецЕсли;
	
	// Устанавливаем счета
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		СтруктураСвойств = СтрокаТЧ["ПрименяемаяИнструкция_СтруктураСвойств"];
		
		ЗаполняющаяСтруктура = Новый Структура();
		
		//
		// СчетВычетКт
		//
		Если ЗаполнитьСчетВычетКт Тогда
			Если СтруктураСвойств["СчетВычетКтЕдинственный"] = Истина Тогда
				СчетВычетКт = СтруктураСвойств["СчетВычетКт"];
				ИзменилсяСчетВычетКт = СтруктураСвойств["ИзменилсяСчетВычетКт"];
				
			ИначеЕсли ПрименяемаяИнструкция_СчетСоответствуетИнструкции(СтрокаТЧ) Тогда
				СчетВычетКт = СтрокаТЧ["СчетВычетКт"];
				ИзменилсяСчетВычетКт = Ложь;
				
			Иначе
				СчетВычетКт = Неопределено;
				ИзменилсяСчетВычетКт = Истина;
				
			КонецЕсли;
			
			Если ИзменилсяСчетВычетКт Тогда
				ЗаполняющаяСтруктура.Вставить("СчетВычетКт",	СчетВычетКт);
				ЗаполняющаяСтруктура.Вставить("КПСВычетКт",		Неопределено);
			КонецЕсли;
			
			// Обновляем при необходимости
			Если НЕ ИзменилсяСчетВычетКт = СтруктураСвойств["ИзменилсяСчетВычетКт"] Тогда
				СтруктураСвойств["ИзменилсяСчетВычетКт"] = ИзменилсяСчетВычетКт;
			КонецЕсли;
		КонецЕсли;
		
		//
		// Счет30304
		//
		Если ЗаполнитьСчет30304 Тогда
			Если СтруктураСвойств["Счет30304Единственный"] = Истина Тогда
				Счет30304 = СтруктураСвойств["Счет30304"];
				ИзменилсяСчет30304 = СтруктураСвойств["ИзменилсяСчет30304"];
				
			Иначе
				Счет30304 = Неопределено;
				ИзменилсяСчет30304 = Истина;
				
			КонецЕсли;
			
			Если ИзменилсяСчет30304 Тогда
				ЗаполняющаяСтруктура.Вставить("Счет30304",				Счет30304);
				ЗаполняющаяСтруктура.Вставить("КПС30304",				Неопределено);
			КонецЕсли;
			
			// Обновляем при необходимости
			Если НЕ ИзменилсяСчет30304 = СтруктураСвойств["ИзменилсяСчет30304"] Тогда
				СтруктураСвойств["ИзменилсяСчет30304"] = ИзменилсяСчет30304;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, ЗаполняющаяСтруктура);
	КонецЦикла;
	
	// Устанавливаем КПС из рабочих счетов
	Если СтрокаТаблицы = Неопределено Тогда
		// Обрабатываем все строки таблицы
		ТаблицаДляЗаполнениеКПС = ЗаполняемаяТаблица;
	Иначе
		// Обрабатываем только одну указанную строку таблицы
		ТаблицаДляЗаполнениеКПС = ЗаполняемаяТаблица.Выгрузить(Новый Массив());
		НоваяСтрока = ТаблицаДляЗаполнениеКПС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЕсли;
	Если ТаблицаДляЗаполнениеКПС.Количество() > 0 Тогда
		// Фактически виды показателя КПС являются одинаковыми для всех строк таблицы
		// (для любого КФО), поэтому определяем их из любой строки, например, самой первой
		СтруктураСвойств = ТаблицаДляЗаполнениеКПС[0]["ПрименяемаяИнструкция_СтруктураСвойств"];
		
		Если ЗаполнитьСчетВычетКт Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетВычетКт");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПСВычетКт");
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",							ПараметрыПодбораКПС["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",								ПараметрыПодбораКПС["Дата"]);
			ПараметрыЗаполнения.Вставить("ИФО",									ПараметрыПодбораКПС["ИФО"]);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Ложь);
			ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",					СтруктураСвойств["ВидыПоказателяКПСВычетКт"]);
			ПараметрыЗаполнения.Вставить("СторонаПроводки",						"Кт");
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаДляЗаполнениеКПС, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
		
		Если ЗаполнитьСчет30304 Тогда
			ОписаниеТаблицы = Новый Структура();
			ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"Счет30304");
			ОписаниеТаблицы.Вставить("ИмяКолонкиКПС",		"КПС30304");
			ПараметрыЗаполнения = Новый Структура();
			ПараметрыЗаполнения.Вставить("Организация",							ПараметрыПодбораКПС["Организация"]);
			ПараметрыЗаполнения.Вставить("Дата",								ПараметрыПодбораКПС["Дата"]);
			ПараметрыЗаполнения.Вставить("ИФО",									ПараметрыПодбораКПС["ИФО"]);
			ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКПС",					Истина);
			ПараметрыЗаполнения.Вставить("ЗаполнитьТолькоПустыеПоля",			Ложь);
			ПараметрыЗаполнения.Вставить("ВидыПоказателяКПС",					СтруктураСвойств["ВидыПоказателяКПС30304"]);
			УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТаблицаДляЗаполнениеКПС, ОписаниеТаблицы, ПараметрыЗаполнения);
		КонецЕсли;
		
		Если НЕ СтрокаТаблицы = Неопределено Тогда
			// Обрабатываем только одну указанную строку таблицы
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ТаблицаДляЗаполнениеКПС[0]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПрименяемаяИнструкция_СчетСоответствуетИнструкции(СтрокаТаблицы)
	
	СтруктураСвойств		= СтрокаТаблицы["ПрименяемаяИнструкция_СтруктураСвойств"];
	СчетВИнструкции			= СтруктураСвойств["СчетВычетКт"];
	СчетВСтроке				= СтрокаТаблицы["СчетВычетКт"];
	РодителиСчетаВСтроке	= СтруктураСвойств["СчетВычетКтРодители"];
	
	Если ТипЗнч(СчетВИнструкции) = Тип("Массив") Тогда
		// Несколько значений счетов
		Для Каждого Счет Из СчетВИнструкции Цикл
			Если (СчетВСтроке = Счет) ИЛИ НЕ (РодителиСчетаВСтроке.Найти(Счет) = Неопределено) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Иначе
		// Одно значение счета
		Если (СчетВСтроке = СчетВИнструкции) ИЛИ НЕ (РодителиСчетаВСтроке.Найти(СчетВИнструкции) = Неопределено) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

