Функция ЗаполнитьПоТипуДокументаОснования(ОснованиеСсылка, Объект, ОписаниеОшибки, ВозвратТиповаяОперация = Неопределено)
	
	Перем НовыеДанные;
	
	ЗаполнениеВыполнено = Неопределено;
	
	ТипДанныхЗаполнения = ТипЗнч(ОснованиеСсылка);
	
	Если ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураПолученный(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураВыданный(ОснованиеСсылка, Объект, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ГТДИмпорт") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_ГТДИмпорт(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураВыданный(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураПолученный(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_КорректировочныйСчетФактураВыданный(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_КорректировочныйСчетФактураПолученный(ОснованиеСсылка, НовыеДанные);
		
	ИначеЕсли ТипДанныхЗаполнения = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПродаж") Тогда
		ЗаполнениеВыполнено = ПолучитьДанныеДляЗаполненияНаОсновании_РегистрацияСтрокиКнигиПродаж(ОснованиеСсылка, НовыеДанные);
	КонецЕсли;
	
	Если ЗаполнениеВыполнено = Неопределено Тогда
		ОписаниеОшибки = НСтр("ru='Неподдерживаемый тип документа-основания'");
		Возврат Ложь;
		
	ИначеЕсли Не ЗаполнениеВыполнено Тогда
		ОписаниеОшибки = НовыеДанные.ОписаниеОшибки;
		Возврат Ложь;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, НовыеДанные.Шапка);
	
	УстанавливатьВместоЗагрузки = (ТипЗнч(Объект.СоставНФА) = Тип("ТаблицаЗначений"));
	
	ТабличныеЧасти = НовыеДанные.ТабличныеЧасти;
	
	Если УстанавливатьВместоЗагрузки Тогда
		Объект.СоставНФА = ТабличныеЧасти.СоставНФА;
	Иначе
		Объект.СоставНФА.Загрузить(ТабличныеЧасти.СоставНФА);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "СчетаФактурыНаОтгрузку")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабличныеЧасти, "СчетаФактурыНаОтгрузку") Тогда
		Если УстанавливатьВместоЗагрузки Тогда
			Объект.СчетаФактурыНаОтгрузку = ТабличныеЧасти.СчетаФактурыНаОтгрузку;
		Иначе
			Объект.СчетаФактурыНаОтгрузку.Загрузить(ТабличныеЧасти.СчетаФактурыНаОтгрузку);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЗаполнениеВыполнено;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата()
	
	Возврат Новый Структура("
		|Шапка,
		|ТабличныеЧасти,
		|ТиповаяОперация,
		|ОписаниеОшибки");
	
КонецФункции

Функция ПолучитьРодителейСчетов(МассивСчетов)
	
	ЗапросРодители = Новый Запрос();
	ЗапросРодители.УстановитьПараметр("Счета", МассивСчетов);
	ЗапросРодители.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Родители первого уровня
	|//
	|ВЫБРАТЬ
	|	Ссылка		КАК Счет,
	|	Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	РодителиПервогоУровня
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В (&Счета)
	|	И	НЕ Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Родители второго уровня
	|//
	|ВЫБРАТЬ
	|	Счет				КАК Счет,
	|	Родитель.Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	РодителиВторогоУровня
	|ИЗ
	|	РодителиПервогоУровня
	|ГДЕ
	|	НЕ Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Родители первого и второго уровней
	|//
	|ВЫБРАТЬ
	|	Счет		КАК Счет,
	|	Родитель	КАК Родитель
	|ИЗ
	|	РодителиПервогоУровня
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Счет		КАК Счет,
	|	Родитель	КАК Родитель
	|ИЗ
	|	РодителиВторогоУровня
	|	
	|ИТОГИ
	|ПО
	|	Счет
	|;";
	
	Возврат ЗапросРодители.Выполнить();
	
КонецФункции


Функция ПолучитьВалютыНДСГТДИмпорт(ДокументОснованиеСсылка)
	
	// Часть 1 из 2
	// Проверка возможности заполнения на основании
	// Для заполнения на основании необходимы одинаковые настройки валюты НДС во всех строках табличной части Разделы
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументОснованиеСсылка);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",					Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Указанные валюты НДС
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки	КАК НомерРаздела,
	|	ВЫБОР
	|		КОГДА НДСВВалюте ТОГДА
	|			Ссылка.ВалютаДокумента
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ		КАК ВалютаНДС
	|ПОМЕСТИТЬ
	|	ВалютыНДС
	|ИЗ
	|	Документ.ГТДИмпорт.Разделы
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Различные валюты НДС
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВалютаНДС	КАК ВалютаНДС
	|ИЗ
	|	ВалютыНДС
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("ВалютаНДС");
	
КонецФункции

Функция ПрочитатьДокументГТДИмпорт(ДокументСсылка, НДСВВалюте)
	
	// Часть 2 из 2
	// Заполнение на основании
	// Выбираем только строки табличной части Разделы
	// с одинаковой настройкой валюты НДС
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснованиеСсылка",	ДокументСсылка);
	ЗапросПоиск.УстановитьПараметр("НДСВВалюте",				НДСВВалюте);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка											КАК ДокументОснование,
	|	Организация															КАК Организация,
	|	ИФО																	КАК ИФО,
	|	Подразделение														КАК Подразделение,
	|	Контрагент															КАК Контрагент,
	|	Договор																КАК Договор,
	|	ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.ТаможенныеПлатежи)	КАК ПричинаНалогообложения,
	|	ЛОЖЬ																КАК ДопЛист,
	|	
	|	// Валюта таможенной стоимости
	|	ВалютаТаможеннойСтоимости											КАК ВалютаТаможеннойСтоимости,
	|	КурсВалютыТаможеннойСтоимости										КАК КурсВалютыТаможеннойСтоимости,
	|	КратностьВалютыТаможеннойСтоимости									КАК КратностьВалютыТаможеннойСтоимости,
	|	
	|	// Валюта пошлины и НДС
	|	ВалютаДокумента														КАК ВалютаПошлиныИНДС,
	|	Курс																КАК КурсПошлиныИНДС,
	|	Кратность															КАК КратностьПошлиныИНДС
	|ИЗ
	|	Документ.ГТДИмпорт	КАК ГТДИмпорт
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//		
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектНалогообложения	КАК ОбъектНалогообложения,
	|	ВидЦенности				КАК ВидЦенности,
	|	КФО						КАК КФО,
	|	СчетВычетКт				КАК СчетВычетКт,
	|	ФактурнаяСтоимость		КАК ФактурнаяСтоимость,
	|	СуммаПошлины			КАК СуммаПошлины,
	|	СуммаНДС				КАК СуммаНДС,
	|		
	|	СтавкаНДС				КАК СтавкаНДС,
	|	ПошлинаВВалюте			КАК ПошлинаВВалюте,
	|	НДСВВалюте				КАК НДСВВалюте
	|ИЗ
	|	(
	|	// Материалы
	|	ВЫБРАТЬ
	|		Материалы.НомерРаздела														КАК НомерРаздела,
	|		1																			КАК НомерТабличнойЧасти,
	|		Материалы.НомерСтроки														КАК НомерВТабличнойЧасти,
	|		Материалы.ДокументПартии													КАК ОбъектНалогообложения,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.Материалы)							КАК ВидЦенности,
	|		Материалы.Ссылка.КФО														КАК КФО,
	|		Материалы.СчетНДС															КАК СчетВычетКт,
	|		Материалы.ФактурнаяСтоимость						 						КАК ФактурнаяСтоимость,
	|		Материалы.СуммаПошлины														КАК СуммаПошлины,
	|		Материалы.СуммаНДС															КАК СуммаНДС,
	|		
	|		ЕСТЬNULL(Разделы.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка))	КАК СтавкаНДС,
	|		ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)										КАК ПошлинаВВалюте,
	|		ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)											КАК НДСВВалюте
	|
	|	ИЗ
	|		Документ.ГТДИмпорт.Материалы	КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ	Документ.ГТДИмпорт.Разделы	КАК Разделы
	|			ПО	Материалы.НомерРаздела = Разделы.НомерСтроки
	|	ГДЕ 
	|		Материалы.Ссылка = &ДокументОснованиеСсылка
	|		И Разделы.Ссылка = &ДокументОснованиеСсылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	// Основные средства
	|	ВЫБРАТЬ
	|		ОсновныеСредства.НомерРаздела												КАК НомерРаздела,
	|		2																			КАК НомерТабличнойЧасти,
	|		ОсновныеСредства.НомерСтроки												КАК НомерВТабличнойЧасти,
	|		ОсновныеСредства.ДокументПартии												КАК ОбъектНалогообложения,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ОС)									КАК ВидЦенности,
	|		ОсновныеСредства.Ссылка.КФО													КАК КФО,
	|		ОсновныеСредства.СчетНДС													КАК СчетВычетКт,
	|		ОсновныеСредства.ФактурнаяСтоимость						 					КАК ФактурнаяСтоимость,
	|		ОсновныеСредства.СуммаПошлины												КАК СуммаПошлины,
	|		ОсновныеСредства.СуммаНДС													КАК СуммаНДС,
	|		
	|		ЕСТЬNULL(Разделы.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка))	КАК СтавкаНДС,
	|		ЕСТЬNULL(Разделы.ПошлинаВВалюте, ЛОЖЬ)										КАК ПошлинаВВалюте,
	|		ЕСТЬNULL(Разделы.НДСВВалюте, ЛОЖЬ)											КАК НДСВВалюте
	|	ИЗ
	|		Документ.ГТДИмпорт.ОсновныеСредства	КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ	Документ.ГТДИмпорт.Разделы	КАК Разделы
	|			ПО	ОсновныеСредства.НомерРаздела = Разделы.НомерСтроки
	|	ГДЕ 
	|		ОсновныеСредства.Ссылка = &ДокументОснованиеСсылка
	|		И Разделы.Ссылка = &ДокументОснованиеСсылка
	|    )	КАК ОбщаяТабличнаяЧасть
	|УПОРЯДОЧИТЬ ПО
	|	НомерРаздела,
	|	НомерТабличнойЧасти,
	|	НомерВТабличнойЧасти
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	
	// [0]. Данные для реквизитов шапки
	Данные.Вставить("Шапка", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Данные для табличной части СоставНФА
	Данные.Вставить("СоставНФА", РезультатыЗапроса[1].Выгрузить());
	
	Возврат Данные;
	
КонецФункции

Процедура ПривестиСуммыКОднойВалютеГТДИмпорт(Данные, ПрименяемаяВалютаНДССсылка)
	
	// Сумма = БазаНДС = ФактурнаяСтоимость + СуммаПошлины
	//					(привести к			(привести к
	//					применяемой			применяемой
	//					валюте НДС)			валюте НДС)
	//
	// СуммаНДС = СуммаНДС
	//			(привести к
	//			применяемой
	//			валюте НДС)
	//
	// Всего = Сумма + СуммаНДС
	
	Шапка				= Данные["Шапка"];
	ТаблицаСоставНФА	= Данные["ТабличныеЧасти"]["СоставНФА"];
	
	ВалютаРУ = Новый Структура();
	ВалютаРУ.Вставить("Валюта",		Константы.ВалютаРегламентированногоУчета.Получить());
	ВалютаРУ.Вставить("Курс",		1);
	ВалютаРУ.Вставить("Кратность",	1);
	
	// Валюта таможенной стоимости
	Если ЗначениеЗаполнено(Шапка.ВалютаТаможеннойСтоимости) Тогда
		ВалютаТС = Новый Структура();
		ВалютаТС.Вставить("Валюта",		Шапка.ВалютаТаможеннойСтоимости);
		ВалютаТС.Вставить("Курс",		Шапка.КурсВалютыТаможеннойСтоимости);
		ВалютаТС.Вставить("Кратность",	Шапка.КратностьВалютыТаможеннойСтоимости);
	Иначе
		ВалютаТС = ВалютаРУ;
	КонецЕсли;
	
	// Валюта пошлины и НДС
	Если ЗначениеЗаполнено(Шапка.ВалютаПошлиныИНДС) Тогда
		ВалютаПошлины = Новый Структура();
		ВалютаПошлины.Вставить("Валюта",	Шапка.ВалютаПошлиныИНДС);
		ВалютаПошлины.Вставить("Курс",		Шапка.КурсПошлиныИНДС);
		ВалютаПошлины.Вставить("Кратность",	Шапка.КратностьПошлиныИНДС);
	Иначе
		ВалютаПошлины = ВалютаРУ;
	КонецЕсли;
	
	СовпадаютВалютыПошлиныНДС = (ВалютаПошлины.Валюта = ПрименяемаяВалютаНДССсылка);
	
	// Применяемая валюта НДС
	Если СовпадаютВалютыПошлиныНДС Тогда
		ПрименяемаяВалютаНДС = ВалютаПошлины;
	Иначе
		ПрименяемаяВалютаНДС = ВалютаРУ;
	КонецЕсли;
	
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
		
		ТаможеннаяСтоимость = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			СтрокаТаблицы.ФактурнаяСтоимость,
			ВалютаТС,
			ПрименяемаяВалютаНДС);
			
		ВалютаПошлиныВТекущейСтроке = ?(СтрокаТаблицы.ПошлинаВВалюте, ВалютаПошлины, ВалютаРУ);
		
		Пошлина = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			СтрокаТаблицы.СуммаПошлины,
			ВалютаПошлиныВТекущейСтроке,
			ПрименяемаяВалютаНДС);
			
		ВалютаНДСВТекущейСтроке = ?(СтрокаТаблицы.НДСВВалюте, ВалютаПошлины, ВалютаРУ);
		
		СуммаНДС = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			СтрокаТаблицы.СуммаНДС,
			ВалютаНДСВТекущейСтроке,
			ПрименяемаяВалютаНДС);
			
		БазаНДС = ТаможеннаяСтоимость + Пошлина;
		
		СтрокаТаблицы["Сумма"] = БазаНДС;
		СтрокаТаблицы["Всего"] = БазаНДС + СуммаНДС;
		СтрокаТаблицы["СуммаНДС"] = СуммаНДС;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьЛишниеСвойстваИКолонкиГТДИмпорт(Данные)
	
	УдаляемыеРеквизитыШапки = Новый Структура("
		|ВалютаТаможеннойСтоимости,
		|КурсВалютыТаможеннойСтоимости,
		|КратностьВалютыТаможеннойСтоимости,
		|ВалютаПошлиныИНДС,
		|КурсПошлиныИНДС,
		|КратностьПошлиныИНДС");
	
	УдаляемыеКолонкиТаблицы = Новый Структура("
		|ФактурнаяСтоимость,
		|СуммаПошлины,
		|ПошлинаВВалюте,
		|НДСВВалюте");
	
	Для Каждого Элемент Из УдаляемыеРеквизитыШапки Цикл
		
		ИмяРеквизита = Элемент.Ключ;
		
		Данные["Шапка"].Удалить(ИмяРеквизита);
		
	КонецЦикла;
	
	Для Каждого Элемент Из УдаляемыеКолонкиТаблицы Цикл
		
		ИмяКолонки = Элемент.Ключ;
		
		Данные["ТабличныеЧасти"]["СоставНФА"].Колонки.Удалить(ИмяКолонки);
		
	КонецЦикла;
	
КонецПроцедуры


Процедура ПривестиПоказателиКНеотрицательнымЗначениям(Таблица, ИменаКолонокПоказателей)
	
	МассивИмен = СтрРазделить(ИменаКолонокПоказателей, ", ", Ложь);
	
	Для Каждого СтрокаТаблица Из Таблица Цикл
		
		Для Каждого ИмяКолонки Из МассивИмен Цикл
			
			Если СтрокаТаблица[ИмяКолонки] >= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблица[ИмяКолонки] = -СтрокаТаблица[ИмяКолонки];
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДвиженияСчетаФактурыНаОтгрузкуДляКнигиПокупок(ТаблицыДляДвижений, ШапкаДокумента)
	
	ТаблицаДвижений	= РегистрыНакопления.СчетаФактурыНаОтгрузкуДляКнигиПокупок.СоздатьНаборЗаписей().Выгрузить();
	
	СчетФактураНаАванс = ШапкаДокумента.ДокументОснование;
	
	Если ЗначениеЗаполнено(СчетФактураНаАванс) Тогда
		Запрос = Новый Запрос();
		Запрос.УстановитьПараметр("Ссылка", ШапкаДокумента.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	РегистрацияСтрокиКнигиПокупокСчетаФактурыНаОтгрузку.СчетФактура КАК СчетФактура,
		               |	РегистрацияСтрокиКнигиПокупокСчетаФактурыНаОтгрузку.Дата КАК Дата,
		               |	РегистрацияСтрокиКнигиПокупокСчетаФактурыНаОтгрузку.Номер КАК Номер
		               |ИЗ
		               |	Документ.РегистрацияСтрокиКнигиПокупок.СчетаФактурыНаОтгрузку КАК РегистрацияСтрокиКнигиПокупокСчетаФактурыНаОтгрузку
		               |ГДЕ
		               |	Ссылка = &Ссылка";
		Выборка = Запрос.Выполнить().Выбрать();
		
		ДатаЗачета = ?(ЗначениеЗаполнено(ШапкаДокумента.ДатаПринятияКУчету), ШапкаДокумента.ДатаПринятияКУчету, ШапкаДокумента.Дата);
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаДвижений.Добавить();
			
			НоваяСтрока.Период					= ШапкаДокумента.Дата;
			НоваяСтрока.Активность				= Истина;
			НоваяСтрока.Организация				= ШапкаДокумента.Организация;
			НоваяСтрока.СчетФактураНаАванс		= СчетФактураНаАванс;
			НоваяСтрока.ДатаЗачета				= ДатаЗачета;
			Если ШапкаДокумента.ДопЛист Тогда
				НоваяСтрока.КорректируемыйПериод = ШапкаДокумента.КорректируемыйПериод;
			КонецЕсли;
			
			НоваяСтрока.СчетФактураНаОтгрузку	= Выборка.СчетФактура;
			НоваяСтрока.НомерСчетаФактуры		= Выборка.Номер;
			НоваяСтрока.ДатаСчетаФактуры		= Выборка.Дата;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицыДляДвижений.Вставить("СчетаФактурыНаОтгрузкуДляКнигиПокупок", ТаблицаДвижений);
	
КонецПроцедуры

