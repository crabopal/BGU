#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЗаполнитьНаОсновании(ОснованиеСсылка, Объект, ОписаниеОшибки = "", ВозвратТиповаяОперация = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен документ основания'");
		Возврат Ложь;
	КонецЕсли;	
	
	Если НЕ ЗаполнитьПоТипуДокументаОснования(ОснованиеСсылка, Объект, ОписаниеОшибки, ВозвратТиповаяОперация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ГТДИмпорт(ОснованиеСсылка, ВозвратДанные) Экспорт
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВалютыНДС = ПолучитьВалютыНДСГТДИмпорт(ОснованиеСсылка);
	
	Если ВалютыНДС.Количество() = 1 Тогда
		// Одинаковая валюта НДС во всех строках табличной части.
		// Применяем указанную валюту.
		
		ВалютаНДС = ВалютыНДС[0];
	Иначе
		// Две различные валюты НДС в различных строках табличной части.
		// Применяем рубли. Валютные суммы переводим в рубли.
		
		ВалютаНДС = ВалютаРУ;
	КонецЕсли;
	
	НДСВВалюте = (ВалютаНДС <> ВалютаРУ);
	
	Данные = ПрочитатьДокументГТДИмпорт(ОснованиеСсылка, НДСВВалюте);
	
	ТаблицаШапка		= Данные["Шапка"];
	ТаблицаСоставНФА	= Данные["СоставНФА"];
	
	// Шапка
	
	СтруктураШапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	
	СтруктураШапка.Вставить("ВалютаДокумента", ВалютаНДС);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"РегистрацияСтрокиКнигиПокупок");
	ДополнительныеПараметры.Вставить("Дата",						ТекущаяДатаСеанса());
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(СтруктураШапка, ДополнительныеПараметры);
	
	СтруктураШапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	СтруктураШапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	// Табличная часть
	
	ТипСчет	= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипКПС	= Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипЧисло= Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2));
	
	ТаблицаСоставНФА.Колонки.Добавить("Счет30304",	ТипСчет);
	ТаблицаСоставНФА.Колонки.Добавить("КПС30304",	ТипКПС);
	ТаблицаСоставНФА.Колонки.Добавить("КПСВычетКт",	ТипКПС);
	ТаблицаСоставНФА.Колонки.Добавить("Сумма",		ТипЧисло);
	ТаблицаСоставНФА.Колонки.Добавить("Всего",		ТипЧисло);
	
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка,
		"КПСОперации");
	
	КПСВычетКт = Основание_ТиповаяОперация["КПСОперации"];
	
	СтруктураШапкиДокументаДляАвтозаполнения = УчетНДС.ПолучитьСтруктуруШапкиДокументаДляАвтозаполнения();
	
	ЗаполнитьЗначенияСвойств(СтруктураШапкиДокументаДляАвтозаполнения, СтруктураШапка);
	
	ЗначенияДляАвтозаполнения = УчетНДС.ПолучитьЗначенияДляАвтозаполнения(СтруктураШапкиДокументаДляАвтозаполнения);
	
	Счет30304	= ЗначенияДляАвтозаполнения["КэшНДС_Счет30304"];
	КПС30304	= ЗначенияДляАвтозаполнения["КэшНДС_КПС30304"];
	
	ТаблицаСоставНФА.ЗаполнитьЗначения(КПСВычетКт,	"КПСВычетКт");
	ТаблицаСоставНФА.ЗаполнитьЗначения(Счет30304,	"Счет30304");
	ТаблицаСоставНФА.ЗаполнитьЗначения(КПС30304,	"КПС30304");
	
	ТабличныеЧасти = Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	ВозвратДанные = Новый Структура();
	ВозвратДанные.Вставить("Шапка",				СтруктураШапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	// Приводим все суммы табличной части к одной валюте
	
	ПривестиСуммыКОднойВалютеГТДИмпорт(ВозвратДанные, ВалютаНДС);
	
	// Удаление лишних свойств - обязательно последним действием
	
	УдалитьЛишниеСвойстваИКолонкиГТДИмпорт(ВозвратДанные);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураВыданный(ОснованиеСсылка, Объект, ВозвратДанные) Экспорт
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка	КАК ДокументОснование,
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВалютаДокумента				КАК ВалютаДокумента,
	|	РегистрацияВДопЛисте		КАК ДопЛист,
	|	КорректируемыйПериод		КАК КорректируемыйПериод,
	|	ДатаДокументаОплаты			КАК ДатаОплаты
	|ИЗ
	|	Документ.СчетФактураВыданный	КАК СчетФактураВыданный
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НФА					КАК НФА,
	|	ВЫБОР
	|		КОГДА НЕ Ссылка.ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|			Ссылка.ДокументОснование
	|		ИНАЧЕ
	|			Ссылка
	|	КОНЕЦ				КАК ОбъектНалогообложения,
	|	Ссылка.КФО			КАК КФО,
	|	СчетВычетКт			КАК СчетВычетКт,
	|	КПСВычетКт			КАК КПСВычетКт,
	|	Счет30304			КАК Счет30304,
	|	КПС30304			КАК КПС30304,
	|	СтавкаНДС			КАК СтавкаНДС,
	|	Сумма				КАК Сумма,
	|	СуммаНДС			КАК СуммаНДС,
	|	Всего				КАК Всего
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА	КАК СоставНФА
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	УчетНДС.ЗаполнитьВидЦенности(ТаблицаСоставНФА, Шапка["ПричинаНалогообложения"]);
	
	КолонкиГруппировок = "
		|ВидЦенности,
		|ОбъектНалогообложения,
		|КФО,
		|СчетВычетКт,
		|КПСВычетКт,
		|Счет30304,
		|КПС30304,
		|СтавкаНДС";
		
	КолонкиСуммирования = "
		|Сумма,
		|СуммаНДС,
		|Всего";
	
	ТаблицаСоставНФА.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ДатаСоВременем = ТекущаяДатаСеанса();
	ДатаБезВремени = НачалоДня(ДатаСоВременем);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"РегистрацияСтрокиКнигиПокупок");
	ДополнительныеПараметры.Вставить("Дата",						ДатаСоВременем);
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	
	Шапка.Вставить("КодВидаОперации",		КодВидаОперации);
	Шапка.Вставить("Дата",					ДатаСоВременем);
	Шапка.Вставить("ДатаПринятияКУчету",	ДатаБезВремени);
	
	ТабличныеЧасти = Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	ЭтоОбработкаПроверкиЗаполнения = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ЭтоОбработкаПроверкиЗаполнения");
	
	Если УчетНДСКлиентСервер.ДоступноУказаниеСчетовФактурНаОтгрузку(Шапка.ПричинаНалогообложения)
		И Не ЭтоОбработкаПроверкиЗаполнения Тогда
		Отбор = ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Шапка, ТаблицаСоставНФА, Объект.Ссылка);
		
		ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаОтгрузку(Отбор, Объект.Ссылка);
		
		ТаблицаДокументов.Свернуть("СчетФактура,Дата,Номер");
		
		ТабличныеЧасти.Вставить("СчетаФактурыНаОтгрузку", ТаблицаДокументов);
	КонецЕсли;
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_СчетФактураПолученный(ОснованиеСсылка, ВозвратДанные) Экспорт
	
	// Возвращаемое значение:
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ОснованиеСсылка);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка, Основание_РеквизитыТиповойОперации);
	
	// Каноническая типовая операция документа-основания:
	Основание_ТиповаяОперация = Новый Структура();
	Основание_ТиповаяОперация.Вставить("КПС30304");
	СинонимыРеквизитов = Новый Структура();
	СинонимыРеквизитов.Вставить("КПС30304", "КПС_30304");
	УчетНДС.ЗаполнитьЗначенияСвойствТиповойОперации(Основание_ТиповаяОперация, Основание_РеквизитыТиповойОперации, СинонимыРеквизитов);
	
	// Получаем данные:
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КПС30304",					Основание_ТиповаяОперация["КПС30304"]);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&ДокументОснованиеСсылка	КАК ДокументОснование,
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВалютаДокумента				КАК ВалютаДокумента,
	|	РегистрацияВДопЛисте		КАК ДопЛист,
	|	КорректируемыйПериод		КАК КорректируемыйПериод,
	|	ДатаДокументаОплаты			КАК ДатаОплаты
	|ИЗ
	|	Документ.СчетФактураПолученный	КАК СчетФактураПолученный
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НФА					КАК НФА,
	|	ВЫБОР
	|		КОГДА НЕ ДокументОснование = НЕОПРЕДЕЛЕНО ТОГДА
	|			ДокументОснование
	|		ИНАЧЕ
	|			Ссылка
	|	КОНЕЦ				КАК ОбъектНалогообложения,
	|	КФО					КАК КФО,
	|	СчетВычетКт			КАК СчетВычетКт,
	|	КПСВычетКт			КАК КПСВычетКт,
	|	Счет30304			КАК Счет30304,
	|	&КПС30304			КАК КПС30304,
	|	СтавкаНДС			КАК СтавкаНДС,
	|	Сумма				КАК Сумма,
	|	СуммаНДС			КАК СуммаНДС,
	|	Всего				КАК Всего
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА	КАК СоставНФА
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|	И НДСКВычету
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ТаблицаШапка		= РезультатыЗаполнения[0].Выгрузить();
	ТаблицаСоставНФА	= РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	УчетНДС.ЗаполнитьВидЦенности(ТаблицаСоставНФА, Шапка["ПричинаНалогообложения"]);
	
	КолонкиГруппировок = "
		|ВидЦенности,
		|ОбъектНалогообложения,
		|КФО,
		|СчетВычетКт,
		|КПСВычетКт,
		|Счет30304,
		|КПС30304,
		|СтавкаНДС";
		
	КолонкиСуммирования = "
		|Сумма,
		|СуммаНДС,
		|Всего";
	
	ТаблицаСоставНФА.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"РегистрацияСтрокиКнигиПокупок");
	ДополнительныеПараметры.Вставить("Дата",						ТекущаяДатаСеанса());
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	ТабличныеЧасти = Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	// Искомые данные:
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_ИсправительныйСчетФактураВыданный(ОснованиеСсылка, ВозвратДанные) Экспорт
	
	Основание_ТиповаяОперация = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ОснованиеСсылка,
		"КФО,КПС,КПС_30304");
	
	НаДату = Неопределено;
	Счет30304 = БухгалтерскийУчетКлиентСервер.СчетПоКоду("303.04", НаДату);
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка",	ОснованиеСсылка);
	ЗапросЗаполнение.УстановитьПараметр("КФО",						Основание_ТиповаяОперация["КФО"]);
	ЗапросЗаполнение.УстановитьПараметр("КПС",						Основание_ТиповаяОперация["КПС"]);
	ЗапросЗаполнение.УстановитьПараметр("Счет30304",				Счет30304);
