		Шапка = Новый Структура();
	КонецЕсли;
	
	УчетНДС.ЗаполнитьВидЦенности(ТаблицаСоставНФА, Шапка["ПричинаНалогообложения"]);
	
	КолонкиГруппировок = "
		|ВидЦенности,
		|ОбъектНалогообложения,
		|КФО,
		|СчетВычетКт,
		|КПСВычетКт,
		|Счет30304,
		|КПС30304,
		|СтавкаНДС";
		
	КолонкиСуммирования = "
		|Сумма,
		|СуммаНДС,
		|Всего";
	
	ТаблицаСоставНФА.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"РегистрацияСтрокиКнигиПокупок");
	ДополнительныеПараметры.Вставить("Дата",						ТекущаяДатаСеанса());
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	ТабличныеЧасти = Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	// Искомые данные
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияНаОсновании_РегистрацияСтрокиКнигиПродаж(ОснованиеСсылка, ВозвратДанные) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументОснованиеСсылка", ОснованиеСсылка);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для реквизитов шапки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	Подразделение				КАК Подразделение,
	|	ДопЛист						КАК ДопЛист,
	|	КорректируемыйПериод		КАК КорректируемыйПериод,
	|	ДатаОплаты					КАК ДатаОплаты,
	|	Комментарий					КАК Комментарий,
	|	&ДокументОснованиеСсылка	КАК ДокументОснование,
	|	Контрагент					КАК Контрагент,
	|	Договор						КАК Договор,
	|	ПричинаНалогообложения		КАК ПричинаНалогообложения,
	|	ВалютаДокумента				КАК ВалютаДокумента,
	|	КодВидаОперации				КАК КодВидаОперации,
	|	Ответственный				КАК Ответственный
	|ИЗ
	|	Документ.РегистрацияСтрокиКнигиПродаж	КАК РегистрацияСтрокиКнигиПродаж
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Данные для табличной части СоставНФА
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сумма													КАК Сумма,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	СуммаНДС												КАК СуммаНДС,
	|	Всего													КАК Всего,
	|	КФО														КАК КФО,
	|	Счет30304												КАК Счет30304,
	|	КПС30304												КАК КПС30304,
	|	ОбъектНалогообложения									КАК ОбъектНалогообложения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыЦенностейНДС.ПустаяСсылка)	КАК ВидЦенности
	|ИЗ
	|	Документ.РегистрацияСтрокиКнигиПродаж.СуммыНДС	КАК СуммыНДС
	|ГДЕ 
	|	Ссылка = &ДокументОснованиеСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [0]. Данные для реквизитов шапки
	ТаблицаШапка = РезультатыЗаполнения[0].Выгрузить();
	
	// [1]. Данные для табличной части СоставНФА
	ТаблицаСоставНФА = РезультатыЗаполнения[1].Выгрузить();
	
	Если ТаблицаШапка.Количество() > 0 Тогда
		Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаШапка[0]);
	Иначе
		Шапка = Новый Структура();
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ВидЗаполняемогоДокумента",	"РегистрацияСтрокиКнигиПокупок");
	ДополнительныеПараметры.Вставить("Дата",						ТекущаяДатаСеанса());
	КодВидаОперации = УчетНДС.ПолучитьКодВидаОперации(Шапка, ДополнительныеПараметры);
	
	Шапка.Вставить("КодВидаОперации", КодВидаОперации);
	
	Шапка.Вставить("Дата", ТекущаяДатаСеанса());
	
	ТабличныеЧасти = Новый Структура("СоставНФА", ТаблицаСоставНФА);
	
	// Искомые данные
	ВозвратДанные = ПолучитьДанныеДляЗаполненияНаОсновании_ПустаяСтруктураРезультата();
	ВозвратДанные.Вставить("Шапка",				Шапка);
	ВозвратДанные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Шапка, СоставНФА, ОбъектСсылка) Экспорт
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	УчетНДС.УстановитьДатуОтбораОстатковВходящийНДСАвансыПолученныеДляТаблицыСФНаОтгрузку(Отбор,
			Шапка.ДатаПринятияКУчету, Шапка.Дата, ОбъектСсылка);
			
	Отбор.Организация	= Шапка.Организация;
	
	Отбор.СписокКонтрагентов.Добавить(Шапка.Контрагент);
	Отбор.СписокДоговоров.Добавить(Шапка.Договор);
	
	Если ТипЗнч(СоставНФА) = Тип("ТаблицаЗначений") Тогда
		ВремТаблица = СоставНФА.Скопировать(, "КФО");
	ИначеЕсли ТипЗнч(СоставНФА) = Тип("ДанныеФормыКоллекция") Тогда
		ВремТаблица = СоставНФА.Выгрузить(, "КФО");
	КонецЕсли;
	ВремТаблица.Свернуть("КФО");
	СписокКФО = ВремТаблица.ВыгрузитьКолонку("КФО");
	Отбор.СписокКФО = СписокКФО;
	
	Если ЗначениеЗаполнено(Шапка.ДокументОснование) Тогда
		Отбор.СписокСчетовФактурНаАванс.Добавить(Шапка.ДокументОснование);
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	Перем ОписаниеОшибки;
	
	Если НЕ ЗначениеЗаполнено(ДокументОбъект["ДокументОснование"]) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Проверяемые реквизиты шапки документа:
	СравниваемыеРеквизитыШапки = Новый Структура("
		|Организация,
		|Контрагент,
		|Договор,
		|ПричинаНалогообложения,
		|ВалютаДокумента");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СравниваемыеРеквизитыШапки.Вставить("ИФО");
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		СравниваемыеРеквизитыШапки.Вставить("Подразделение");
	КонецЕсли;
	
	// Сравниваем реквизиты документа и счета-фактуры:
	ДанныеЗаполненияНаОсновании = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СравниваемыеРеквизитыШапки);
	ДанныеЗаполненияНаОсновании.Вставить("СоставНФА", ДокументОбъект["СоставНФА"].ВыгрузитьКолонки());
	ДанныеЗаполненияНаОсновании.Вставить("ЭтоОбработкаПроверкиЗаполнения", Истина);
	
	Если ЗаполнитьНаОсновании(ДокументОбъект["ДокументОснование"], ДанныеЗаполненияНаОсновании, ОписаниеОшибки) Тогда
		// 1) Реквизиты шапки:
		ЗапрашиваемыеСведения = "РазличныеЗначения, ЗначенияСовпадаютПолностью";
		РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьЭлементыКоллекций(ДокументОбъект, ДанныеЗаполненияНаОсновании, СравниваемыеРеквизитыШапки, ЗапрашиваемыеСведения);
		Если НЕ РезультатСравнения["ЗначенияСовпадаютПолностью"] Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			Для Каждого ИмяРеквизита Из РезультатСравнения["РазличныеЗначения"] Цикл
				ИмяПоляДляВыводаСообщений = ИмяРеквизита;
				ТекстШаблон = НСтр("ru='Значение поля %1 отличается от значения в счете-фактуре'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, ИмяРеквизита);
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяПоляДляВыводаСообщений);
			КонецЦикла;
		КонецЕсли;
		
		// 2) Таблица СоставНФА:
		ИмяТаблЧастиДляВыводаСообщений		= "СоставНФА";
		КоллекцияИменКолонокСвязи			= "ВидЦенности, СтавкаНДС, КФО";
		ЭтоАванс = УчетНДСПовтИсп.Аванс(ДокументОбъект["ПричинаНалогообложения"]);
		Если ЭтоАванс Тогда
			КоллекцияИменКолонокПоказателей	= "СуммаНДС, Всего";
		Иначе
			КоллекцияИменКолонокПоказателей	= "Сумма, СуммаНДС";
		КонецЕсли;
		
		Если ДокументОбъект["Аннулирование"] Тогда
			// Аннулирование.
			// Требуем равенства сумм в табличных частях документа и основания.
			
			Таблица1 = ДокументОбъект["СоставНФА"].Выгрузить();
			Таблица2 = ДанныеЗаполненияНаОсновании["СоставНФА"];
			ЗапрашиваемыеСведения = "ПолноеВзаимноеСписаниеПоказателей";
			РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
				Таблица1,
				Таблица2,
				КоллекцияИменКолонокСвязи,
				КоллекцияИменКолонокПоказателей,
				ЗапрашиваемыеСведения);
			
			Если НЕ РезультатСравнения["ПолноеВзаимноеСписаниеПоказателей"] Тогда
				//ЕстьОшибкиЗаполнения = Истина;
				
				ТекстСообщения = НСтр("ru='Таблица ""Состав НФА"" отличается от таблицы счета-фактуры.
					|При аннулировании счета-фактуры таблицы должны совпадать.
					|
					|Чтобы заполнить таблицу актуальными данными, можно нажать кнопку ""Заполнить по счету-фактуре""'");
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений);
			КонецЕсли;
			
		Иначе
			// Регистрация.
			// Информируем о превышении сумм из табличной части документа
			// показателей из основания.
			
			ПредставленияПолей = Новый Соответствие();
			ПредставленияПолей.Вставить("Сумма",	"Сумма без НДС");
			ПредставленияПолей.Вставить("СуммаНДС",	"НДС");
			ПредставленияПолей.Вставить("Всего",	"Всего");
			
			Таблица1 = ДокументОбъект["СоставНФА"].Выгрузить();
			
			ПривестиПоказателиКНеотрицательнымЗначениям(Таблица1, КоллекцияИменКолонокПоказателей);
			
			Таблица2 = ДанныеЗаполненияНаОсновании["СоставНФА"];
			ЗапрашиваемыеСведения = "ПревышенияТаблицы1НадТаблицей2";
			РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
				Таблица1,
				Таблица2,
				КоллекцияИменКолонокСвязи,
				КоллекцияИменКолонокПоказателей,
				ЗапрашиваемыеСведения);
			
			ТаблицаПревышения = РезультатСравнения["ПревышенияТаблицы1НадТаблицей2"];
			ТекстШаблон = НСтр("ru='Справочно: поле ""%1"" превышает значение из счета-фактуры на %2 (строка %3)'");
			Для Каждого СтрокаТаблицы Из ТаблицаПревышения Цикл
				//ЕстьОшибкиЗаполнения = Истина;
				
				НомерСтроки	= СтрокаТаблицы["НомерСтроки"];
				Превышения	= СтрокаТаблицы["Превышения"];
				ИндексСтроки = НомерСтроки - 1;
				
				ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
				
				Для Каждого ДетальнаяСтрока Из Превышения Цикл
					ИмяПоляДляВыводаСообщений = ДетальнаяСтрока["ИмяКолонки"];
					ВеличинаПревышения = ДетальнаяСтрока["Превышение"];
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон,
						ПредставленияПолей.Получить(ИмяПоляДляВыводаСообщений),
						Формат(ВеличинаПревышения, "ЧДЦ=2"),
						НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						ДокументОбъект["Ссылка"],
						"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		// Не удалось получить данные для сравнения.
		ЕстьОшибкиЗаполнения = Истина;
		
		ИмяПоляДляВыводаСообщений = "ДокументОснование";
		ОбщегоНазначения.СообщитьПользователю(
			ОписаниеОшибки,
			ДокументОбъект["Ссылка"],
			"Объект." + ИмяПоляДляВыводаСообщений);
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	Перем Курс, Кратность;
	
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	ТаблицаВходящийНДС						= РегистрыНакопления.ВходящийНДС.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаВходящийНДСКРаспределению		= РегистрыНакопления.ВходящийНДСКРаспределению.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаКнигаПокупок						= РегистрыНакопления.КнигаПокупок.СоздатьНаборЗаписей().Выгрузить();
	ТаблицаДополнительныеЛистыКнигиПокупок	= РегистрыНакопления.ДополнительныеЛистыКнигиПокупок.СоздатьНаборЗаписей().Выгрузить();
	
	// Подготовка:
	ШапкаДокумента			= ОбщегоНазначенияБГУ.СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументСсылка);
	Период					= ШапкаДокумента["Дата"];
	ДокументОснование		= ШапкаДокумента["ДокументОснование"];
	Аннулирование			= ШапкаДокумента["Аннулирование"];
	Событие					= Перечисления.СобытияНДС.ПустаяСсылка();
	Если ШапкаДокумента["ПричинаНалогообложения"] = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный
		И ШапкаДокумента["ВозвратАвансаПолученного"] Тогда
		Событие				= Перечисления.СобытияНДС.ВозвратАвансаПолученного;
	КонецЕсли;	
	ЗаполнитьВалютныеСуммы	= УчетНДС.СледуетЗаполнитьВалютныеСуммы();
	// Значения реквизитов типовой операции документа-основания:
	Основание_ТиповаяОперацияСсылка		= БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументОснование);
	Основание_РеквизитыТиповойОперации	= Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Основание_ТиповаяОперацияСсылка);
	Основание_РеквизитыТиповойОперации	= БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументОснование, Основание_РеквизитыТиповойОперации);
	Если ЗаполнитьВалютныеСуммы Тогда
		Основание_РеквизитыТиповойОперации.Свойство("Курс",			Курс);
		Основание_РеквизитыТиповойОперации.Свойство("Кратность",	Кратность);
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			Курс = 1;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Кратность) Тогда
			Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаСоставНФА = ДокументСсылка["СоставНФА"].Выгрузить();
	
	ОбъектыНалогообложения = ТаблицаСоставНФА.ВыгрузитьКолонку("ОбъектНалогообложения");
	
	// Оставляем только заполненные ссылки
	КоличествоДокументов = ОбъектыНалогообложения.Количество();
	Для Счетчик = 1 По КоличествоДокументов Цикл
		Индекс = КоличествоДокументов - Счетчик;
		Если НЕ ЗначениеЗаполнено(ОбъектыНалогообложения[Индекс]) Тогда
			ОбъектыНалогообложения.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	ОстаткиПоОбъектуНалогообложения	= УчетНДС.ПолучитьОстаткиПоОбъектуНалогообложения(
		ОбъектыНалогообложения,
		"ВходящийНДС, ВходящийНДСКРаспределению",
		ШапкаДокумента["Дата"],
		ДокументСсылка,
		ШапкаДокумента.ДокументОснование);
	
	// Настраиваем колонки для дальнейшей совместной обработки:
	ТаблицаСоставНФА.Колонки.Найти("Сумма").Имя = "СуммаБезНДС";
	ТипСумма = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ТаблицаСоставНФА.Колонки.Добавить("СуммаБезНДСВалютная", ТипСумма);
	ТаблицаСоставНФА.Колонки.Добавить("СуммаНДСВалютная", ТипСумма);
	Если ЗаполнитьВалютныеСуммы Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаСоставНФА Цикл
			СтрокаТаблицы["СуммаБезНДСВалютная"] = СтрокаТаблицы["СуммаБезНДС"];
			СтрокаТаблицы["СуммаБезНДС"] = СтрокаТаблицы["СуммаБезНДСВалютная"] * Курс / Кратность;
			СтрокаТаблицы["СуммаНДСВалютная"] = СтрокаТаблицы["СуммаНДС"];
			СтрокаТаблицы["СуммаНДС"] = СтрокаТаблицы["СуммаНДСВалютная"] * Курс / Кратность;
		КонецЦикла;
	КонецЕсли;
	
	//---
	// КнигаПокупок, ДополнительныеЛистыКнигиПокупок
	//---
	Если ШапкаДокумента["ДопЛист"] Тогда
		ЗаполняемаяТаблица	= ТаблицаДополнительныеЛистыКнигиПокупок;
		УчетНДС.ДобавитьВТаблицу(ЗаполняемаяТаблица, ТаблицаСоставНФА);
		ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["КорректируемыйПериод"], "КорректируемыйПериод");
	Иначе
		ЗаполняемаяТаблица	= ТаблицаКнигаПокупок;
		УчетНДС.ДобавитьВТаблицу(ЗаполняемаяТаблица, ТаблицаСоставНФА);
	КонецЕсли;
	ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["Организация"],				"Организация");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["ПричинаНалогообложения"],	"ПричинаНалогообложения");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["ДатаОплаты"],				"ДатаОплаты");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["ДатаПринятияКУчету"],		"ДатаСобытия");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(Истина,									"Активность");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(Период,									"Период");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(ШапкаДокумента["КодВидаОперации"],			"КодВидаОперации");
	ЗаполняемаяТаблица.ЗаполнитьЗначения(Событие,									"Событие");
	Если Аннулирование Тогда
		Для Каждого СтрокаТаблицы Из ЗаполняемаяТаблица Цикл
			СтрокаТаблицы["СуммаБезНДС"]			= -СтрокаТаблицы["СуммаБезНДС"];
			СтрокаТаблицы["СуммаНДС"]				= -СтрокаТаблицы["СуммаНДС"];
			СтрокаТаблицы["СуммаБезНДСВалютная"]	= -СтрокаТаблицы["СуммаБезНДСВалютная"];
			СтрокаТаблицы["СуммаНДСВалютная"]		= -СтрокаТаблицы["СуммаНДСВалютная"];
		КонецЦикла;
	КонецЕсли;
	
	СчетФактура = ?(ЗначениеЗаполнено(ДокументОснование), ДокументОснование, ДокументСсылка);
	ЗаполняемаяТаблица.ЗаполнитьЗначения(СчетФактура, "СчетФактура");
	
	КолонкиСвязи = "ОбъектНалогообложения, ВидЦенности, КФО, СтавкаНДС";
	
	Если ЗаполнитьВалютныеСуммы Тогда
		КолонкиПоказателей = "СуммаБезНДС, СуммаНДС, СуммаБезНДСВалютная, СуммаНДСВалютная";
	Иначе
		КолонкиПоказателей = "СуммаБезНДС, СуммаНДС";
	КонецЕсли;
	
	//---
	// ВходящийНДС
	//---
	РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаСоставНФА,
		ОстаткиПоОбъектуНалогообложения["ВходящийНДС"],
		КолонкиСвязи,
		КолонкиПоказателей,
		"ОстаткиВТаблице1, СписанияВТаблице2ВРазмереСоответствия");
		
	ТаблицаСоставНФА = РезультатСравнения["ОстаткиВТаблице1"];
	ТаблицаВходящийНДС = РезультатСравнения["СписанияВТаблице2ВРазмереСоответствия"];
	
	УчетНДС.УдалитьСтрокиСНулевымиСуммами(ТаблицаВходящийНДС);
	
	ТаблицаВходящийНДС.Колонки.Добавить("ВидДвижения",	Новый ОписаниеТипов("ВидДвиженияНакопления"));
	ТаблицаВходящийНДС.Колонки.Добавить("Период",		Новый ОписаниеТипов("Дата"));
	
	ТаблицаВходящийНДС.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
	ТаблицаВходящийНДС.ЗаполнитьЗначения(Период,						"Период");
	
	//---
	// ВходящийНДСКРаспределению
	//---
	РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаСоставНФА,
		ОстаткиПоОбъектуНалогообложения["ВходящийНДСКРаспределению"],
		КолонкиСвязи,
		КолонкиПоказателей,
		"СписанияВТаблице2ВРазмереСоответствия");
		
	ТаблицаВходящийНДСКРаспределению = РезультатСравнения["СписанияВТаблице2ВРазмереСоответствия"];
	
	УчетНДС.УдалитьСтрокиСНулевымиСуммами(ТаблицаВходящийНДСКРаспределению);
	
	ТаблицаВходящийНДСКРаспределению.Колонки.Добавить("ВидДвижения",	Новый ОписаниеТипов("ВидДвиженияНакопления"));
	ТаблицаВходящийНДСКРаспределению.Колонки.Добавить("Период",			Новый ОписаниеТипов("Дата"));
	
	ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход,	"ВидДвижения");
	ТаблицаВходящийНДСКРаспределению.ЗаполнитьЗначения(Период,							"Период");
	
	// Финальные таблицы движений:
	ТаблицыДляДвижений.Вставить("ВходящийНДС",						ТаблицаВходящийНДС);
	ТаблицыДляДвижений.Вставить("ВходящийНДСКРаспределению",		ТаблицаВходящийНДСКРаспределению);
	ТаблицыДляДвижений.Вставить("КнигаПокупок",						ТаблицаКнигаПокупок);
	ТаблицыДляДвижений.Вставить("ДополнительныеЛистыКнигиПокупок",	ТаблицаДополнительныеЛистыКнигиПокупок);
	
	ДобавитьДвиженияСчетаФактурыНаОтгрузкуДляКнигиПокупок(ТаблицыДляДвижений, ШапкаДокумента);
	
КонецПроцедуры

