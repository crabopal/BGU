#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если НЕ ДанныеЗаполнения = Неопределено И НЕ ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ТекстСообщения = "";
		Если НЕ Документы.РегистрацияСтрокиКнигиПокупок.ЗаполнитьНаОсновании(ДанныеЗаполнения, ЭтотОбъект, Ложь, ТекстСообщения) Тогда
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Всего		= СоставНФА.Итог("Всего");
	СуммаНДС 	= СоставНФА.Итог("СуммаНДС");
	
	Если Не УчетНДСКлиентСервер.ДоступноУказаниеСчетовФактурНаОтгрузку(ПричинаНалогообложения) Тогда
		СчетаФактурыНаОтгрузку.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.РегистрацияСтрокиКнигиПокупок.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Запись движений
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ВходящийНДСКРаспределению");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "КнигаПокупок");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ДополнительныеЛистыКнигиПокупок");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СчетаФактурыНаОтгрузкуДляКнигиПокупок");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ ЭтотОбъект["Аннулирование"] Тогда
		ПроверяемыеРеквизиты.Добавить("СоставНФА.СчетВычетКт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПСВычетКт");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.Счет30304");
		ПроверяемыеРеквизиты.Добавить("СоставНФА.КПС30304");
	КонецЕсли;
	
	Если ЭтотОбъект["ДопЛист"] Тогда
		ПроверяемыеРеквизиты.Добавить("КорректируемыйПериод");
	КонецЕсли;
	
	ПричиныБезКонтрагента = Новый Массив();
	ПричиныБезКонтрагента.Добавить(Перечисления.ПричиныНалогообложенияНДС.ВнутреннееПотребление);
	ПричиныБезКонтрагента.Добавить(Перечисления.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом);
	
	КонтрагентИспользуется = (ПричиныБезКонтрагента.Найти(ЭтотОбъект["ПричинаНалогообложения"]) = Неопределено);
	
	Если КонтрагентИспользуется Тогда
		ПроверяемыеРеквизиты.Добавить("Контрагент");
	КонецЕсли;
	
	Если Документы.РегистрацияСтрокиКнигиПокупок.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
