Процедура ПрименяемаяИнструкция_Выбор(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		НовоеЗначение = ВыбранныйЭлемент.Значение;
		
		ЗначениеИзменилось = НЕ (НовоеЗначение = ПрименяемаяИнструкция_СтруктураСвойств["Идентификатор"]);
		Если ЗначениеИзменилось Тогда
			ПрименяемаяИнструкция_НастроитьФормуСервер(Истина, НовоеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

