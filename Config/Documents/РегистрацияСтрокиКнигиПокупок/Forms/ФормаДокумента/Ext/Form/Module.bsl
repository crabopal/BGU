//---
// Применяемая инструкция
//---

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура ПрименяемаяИнструкция_НастроитьФормуСервер(ЗаполнитьКолонкиСчетов, ИдентификаторИнструкции = Неопределено)
	
	ШапкаДокумента = Объект;
	
	УчетНДС.НастроитьФорму_ВидимостьКолонок(ЭтаФорма);
	
	// Определяем инструкцию
	Если ИдентификаторИнструкции = Неопределено Тогда
		// Определяем применяемую инструкцию из данных документа
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ШапкаДокумента);
	Иначе
		// Применяемая инструкция указана явно
		ПрименяемаяИнструкцияСтруктура = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ШапкаДокумента, , ИдентификаторИнструкции);
	КонецЕсли;
	ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"] = Новый ФиксированнаяСтруктура(ПрименяемаяИнструкцияСтруктура);
	
	// Элементы формы, связанные с инструкцией
	ЗаголовокКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Применяемая инструкция (%1)'"),
		ПрименяемаяИнструкцияСтруктура["Идентификатор"]);
	Элементы["ФормаПрименяемаяИнструкция"].Заголовок = ЗаголовокКоманды;
	
	// Определяем свойства инструкции для каждой строки
	Документы.РегистрацияСтрокиКнигиПокупок.ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(
		ШапкаДокумента,
		Объект["СоставНФА"],
		ИдентификаторИнструкции);
	
	Если ЗаполнитьКолонкиСчетов Тогда
		// Заполняем полные счета
		Документы.РегистрацияСтрокиКнигиПокупок.ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(
			Объект["СоставНФА"],
			Объект);
	КонецЕсли;
	
	ВидимостьВозвратАвансаПолученного = (Объект["ПричинаНалогообложения"] = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	Элементы["ВозвратАвансаПолученного"].Видимость = ВидимостьВозвратАвансаПолученного;
	
	ЭтоНалоговыйАгент = УчетНДСПовтИсп.НалоговыйАгент(Объект.ПричинаНалогообложения);
	
КонецПроцедуры

// ПрименяемаяИнструкция=f(ПричинаНалогообложения,КФО,Дата)
&НаСервере
Процедура ПрименяемаяИнструкция_НастроитьТекущуюСтрокуСервер(ТекущаяСтрока)
	
	ТекДанные = Объект["СоставНФА"].НайтиПоИдентификатору(ТекущаяСтрока);
	
	// Определяем свойства инструкции для одной текущей строки
	ИдентификаторИнструкции	= ЭтаФорма["ПрименяемаяИнструкция_СтруктураСвойств"]["Идентификатор"];
	Документы.РегистрацияСтрокиКнигиПокупок.ПрименяемаяИнструкция_ОбновитьСтруктурыСвойств(
		Объект,
		Объект["СоставНФА"],
		ИдентификаторИнструкции,
		ТекДанные);
	
	// Заполняем полные счета
	ПараметрыЗаполнения = Новый Структура("СтрокаТаблицы", ТекДанные);
	Документы.РегистрацияСтрокиКнигиПокупок.ПрименяемаяИнструкция_ЗаполнитьКолонкиСчетов(
		Объект["СоставНФА"],
		Объект,
		ПараметрыЗаполнения);
	
КонецПроцедуры

