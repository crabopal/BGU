&НаСервере
Процедура ИнициализироватьФормуСервер()
	
	ИнициализироватьНастройкиЭлементовКолонок();
	
	// Заполняем по возможности новый документ:
	Если Объект.Ссылка.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			// Этот документ создан копированием.
		ИначеЕсли ЗначениеЗаполнено(Параметры.Основание) Тогда
			// Этот документ создан на основании.
		Иначе
			// Это совсем новый документ.
		КонецЕсли;
		
	КонецЕсли;
	
	УчетНДСКлиентСервер.ЗаполнитьСписокКодовВидовОпераций(
		Элементы["КодВидаОперации"].СписокВыбора,
		"ПолученныеСчетаФактуры",
		Объект["Дата"]);
		
	ПрименяемаяИнструкция_НастроитьФормуСервер(Ложь);
	
	УстановитьНадписьСчетаФактурыНаОтгрузку();
	УстановитьВидимостьНадписиСчетаФактурыНаОтгрузку();
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьНастройкиЭлементовКолонок()
	
	КоллекцияСкрываемых = Новый Соответствие();
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАВсего");
	СкрываемыеЭлементы.Добавить("СоставНФАСумма");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогСумма");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогВсего");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный, СкрываемыеЭлементы);
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансВыданный, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАСуммаНДС");
	СкрываемыеЭлементы.Добавить("СоставНФАВсего");
	СкрываемыеЭлементы.Добавить("СоставНФАВсегоАванс");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогСуммаНДС");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогВсего");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогВсегоАванс");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом, СкрываемыеЭлементы);
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом, СкрываемыеЭлементы);
	
	СкрываемыеЭлементы = Новый Массив();
	СкрываемыеЭлементы.Добавить("СоставНФАВсегоАванс");
	СкрываемыеЭлементы.Добавить("СоставНФАИтогВсегоАванс");
	КоллекцияСкрываемых.Вставить(Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка(), СкрываемыеЭлементы);
	
	УчетНДС.ИнициализироватьНастройкиЭлементовКолонок(ЭтаФорма, КоллекцияСкрываемых);
	
КонецПроцедуры
	

&НаКлиенте
Процедура ТрансформироватьРеквизитыОбъектаВРеквизитыФормы()
	
	Если Объект["Аннулирование"] Тогда
		Действие = 1;
	Иначе
		Действие = 0;
	КонецЕсли;
	
	Если Объект["ДопЛист"] Тогда
		МестоЗаписи	= 1;
	Иначе
		МестоЗаписи = 0;
	КонецЕсли;
	
	ДатаКопия = Объект["Дата"];
	
КонецПроцедуры
&НаКлиенте
Процедура ТрансформироватьРеквизитыФормыВРеквизитыОбъекта()
	
	Если Действие = 1 Тогда
		Объект["Аннулирование"] = Истина;
	Иначе
		Объект["Аннулирование"] = Ложь;
	КонецЕсли;
	
	Если МестоЗаписи = 1 Тогда
		Объект["ДопЛист"] = Истина;
	Иначе
		Объект["ДопЛист"] = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	ТрансформироватьРеквизитыОбъектаВРеквизитыФормы();
	
	МестоЗаписиПриИзмененииКлиент();
	РазрешитьРедактированиеРеквизитовДокументаОснования = Истина;
	РазрешитьРедактированиеРеквизитовДокументаОснования_НастроитьФорму();
	
	НастроитьФормуКлиент_АннулированиеПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_АннулированиеПриИзменении()
	
	Если Объект["Аннулирование"] Тогда
		НовЦветТекстаСоставНФА	= Новый Цвет(96, 96, 96);
	Иначе
		НовЦветТекстаСоставНФА	= Новый Цвет();
	КонецЕсли;
	
	Элементы["СоставНФА"].ТолькоПросмотр							= Объект["Аннулирование"];
	Элементы["СоставНФА"].ЦветТекста								= НовЦветТекстаСоставНФА;
	Элементы["СоставНФАКомандаНадписьАннулирование"].Доступность	= Объект["Аннулирование"];
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНалоговыйПериодПредставление()
	
	Если Объект["ДопЛист"] Тогда
		ПроверяемаяДата = Объект["КорректируемыйПериод"];
	Иначе
		ПроверяемаяДата = Объект["Дата"];
	КонецЕсли;
	
	НалоговыйПериодПредставление = ПолучитьНалоговыйПериодПредставление(Объект["Организация"], ПроверяемаяДата);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьНалоговыйПериодПредставление(Организация, Дата)
	
	СвойстваНалоговогоПериода = УчетНДС.ПолучитьСвойстваНалоговогоПериода(Организация, Дата);
	
	Возврат СвойстваНалоговогоПериода["ПериодПредставление"];
	
КонецФункции

&НаКлиенте
Процедура МестоЗаписиПриИзмененииКлиент()
	
	ТрансформироватьРеквизитыФормыВРеквизитыОбъекта();
	
	НастроитьФормуКлиент_КорректируемыйПериод();
	
	ОбновитьНалоговыйПериодПредставление();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_КорректируемыйПериод()
	
	НовТолькоПросмотр = НЕ Объект["ДопЛист"];
	
	Элементы["КорректируемыйПериод"].ТолькоПросмотр = НовТолькоПросмотр;
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактированиеРеквизитовДокументаОснования_НастроитьФорму()
	
	Элементы["ФормаРазрешитьРедактированиеРеквизитов"].Пометка = РазрешитьРедактированиеРеквизитовДокументаОснования;
	
	ИменаНастраиваемыхЭлементов = Новый Структура("
		|Контрагент,
		|Договор,
		|ПричинаНалогообложения,
		|ВалютаДокумента");
	
	Для Каждого КлючИЗнач Из ИменаНастраиваемыхЭлементов Цикл
		Элементы[КлючИЗнач.Ключ].ТолькоПросмотр = НЕ РазрешитьРедактированиеРеквизитовДокументаОснования;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДатаКопия(Форма)
	
	Форма["ДатаКопия"] = Форма.Объект["Дата"];
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПроверитьИЗаполнитьНаОснованииКлиент(ВыводитьПредупреждение = Истина)
	
	Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
		ТекстСообщения = НСтр("ru='Заполнить документ на основании счета-фактуры?'");
		
		ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ПроверитьИЗаполнитьНаОснованииКлиент_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОВыборе, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		Если ВыводитьПредупреждение Тогда
			ТекстСообщения = НСтр("ru='Не заполнено поле Счет-фактура'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				ТекстСообщения,
				Объект.Ссылка,
				"Объект.ДокументОснование");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьНаОснованииКлиент_Выбор(Результат, ПараметрыОповещения) Экспорт
	
	Перем ОписаниеОшибки;
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если ЗаполнитьНаОснованииСервер(ОписаниеОшибки) Тогда
			
			НастроитьФормуКлиент();
			
		Иначе
			ПоказатьПредупреждение(, НСтр("ru='Не удалось заполнить документ на основании:
				|" + ОписаниеОшибки + "'"), 20, ТекстЗаголовкаСообщений);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьНаОснованииСервер(ОписаниеОшибки)
	
	ЗаполнениеВыполнено = Документы.РегистрацияСтрокиКнигиПокупок.ЗаполнитьНаОсновании(Объект["ДокументОснование"], Объект, ОписаниеОшибки);
	
	Если ЗаполнениеВыполнено Тогда
		Модифицированность = Истина;
		ОбновитьДатаКопия(ЭтаФорма);
		
		ПрименяемаяИнструкция_НастроитьФормуСервер(Ложь);
		
		УстановитьНадписьСчетаФактурыНаОтгрузку();
		УстановитьВидимостьНадписиСчетаФактурыНаОтгрузку();
	КонецЕсли;
	
	Возврат ЗаполнениеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммыВСтроке(Элемент)
	
	ТекДанные = Элементы["СоставНФА"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяЭлемента = Элемент.Имя;
	
	Если ИмяЭлемента = "СоставНФАСумма" Тогда
		ИмяИзмененногоПоля = "Сумма";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСуммаНДС" Тогда
		ИмяИзмененногоПоля = "СуммаНДС";
		
	ИначеЕсли	ИмяЭлемента = "СоставНФАВсего"
		ИЛИ		ИмяЭлемента = "СоставНФАВсегоАванс"	Тогда
		ИмяИзмененногоПоля = "Всего";
		
	ИначеЕсли ИмяЭлемента = "СоставНФАСтавкаНДС" Тогда
		ИмяИзмененногоПоля = "СтавкаНДС";
		
	Иначе
		// Выходим:
		Возврат;
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("Сумма",			"Сумма");
	СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",			"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, ЭтоАванс, ЭтоНалоговыйАгент);
	
КонецПроцедуры

#Область ДокументыСчетовФактурНаОтгрузкуГрафа7аКнигиПокупок

&НаКлиенте
Процедура ПроверитьИОткрытьФормуДокументовСчетовФактурНаОтгрузку(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекстПояснения = НСтр("ru='Необходимо заполнить это поле перед редактированием списка документов счетов-фактур на отгрузку.'");
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", НСтр("ru='Контрагент'"),,, ТекстПояснения),
			Объект.Ссылка, "Контрагент", "Объект", Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Договор) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность", НСтр("ru='Договор'"),,, ТекстПояснения),
			Объект.Ссылка, "Договор", "Объект", Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФормуДокументовСчетовФактурНаОтгрузку();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДокументовСчетовФактурНаОтгрузку()
	
	АдресДанных = ПоместитьДанныеВХранилище_ДокументыСчетовФактурНаОтгрузку();
	
	ПараметрыФормы = УчетНДСКлиент.НовыйПараметрыОткрытияОбщейФормыДокументыСчетовФактурНаОтгрузку();
	ПараметрыФормы.АдресДанных = АдресДанных;
	ПараметрыФормы.СчетФактура = Объект.ДокументОснование;
	ПараметрыФормы.ИсключитьРегистратор = Объект.Ссылка;
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ЗакрытаФормаДокументыСчетовФактурНаОтгрузку", ЭтотОбъект);
	
	ОткрытьФорму("ОбщаяФорма.ДокументыСчетовФактурНаОтгрузку", ПараметрыФормы, ЭтотОбъект,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗагрузитьДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеВХранилище_ДокументыСчетовФактурНаОтгрузку()
	
	Отбор = Документы.РегистрацияСтрокиКнигиПокупок.ПолучитьОтборОстаткиВходящийНДСАвансыПолученные(Объект, Объект.СоставНФА, Объект.Ссылка);
	
	Данные = УчетНДС.НовыйДанныеДляОбщейФормыДокументыСчетовФактурНаОтгрузку();
	Данные.СчетаФактурыНаОтгрузку = Объект.СчетаФактурыНаОтгрузку.Выгрузить();
	Данные.Отбор = Отбор;
	
	АдресДанных = ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
	Возврат АдресДанных;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДокументыСчетовФактурНаОтгрузку(ВыбранноеЗначение)
	
	Объект.СчетаФактурыНаОтгрузку.Очистить();
	
	Если Не ЭтоАдресВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаОтгрузку) Тогда
		УстановитьНадписьСчетаФактурыНаОтгрузку();
		
		Возврат;
	КонецЕсли;
	
	ТаблицаСчетаФактурыНаОтгрузку = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресТаблицыСчетаФактурыНаОтгрузку);
	
	Объект.СчетаФактурыНаОтгрузку.Загрузить(ТаблицаСчетаФактурыНаОтгрузку);
	
	УстановитьНадписьСчетаФактурыНаОтгрузку();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьСчетаФактурыНаОтгрузку()
	
	НадписьСчетаФактурыНаОтгрузку = УчетНДС.ПолучитьНадписьСчетаФактурыНаОтгрузку(Объект.СчетаФактурыНаОтгрузку,, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНадписиСчетаФактурыНаОтгрузку()
	
	Элементы.НадписьСчетаФактурыНаОтгрузку.Видимость =
		УчетНДСКлиентСервер.ДоступноУказаниеСчетовФактурНаОтгрузку(Объект.ПричинаНалогообложения);
	
КонецПроцедуры

