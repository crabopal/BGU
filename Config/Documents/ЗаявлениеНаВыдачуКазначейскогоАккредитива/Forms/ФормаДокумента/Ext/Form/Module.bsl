КонецФункции

&НаСервере
Процедура Договор01ПриИзмененииНаСервере()
	
	Объект.Наименование01 	= "";
	Объект.Номер01 			= "";
	Объект.Дата01 			= "";
	Объект.Идентификатор01 	= "";
	Объект.КПС01 			= "";
	Объект.КодФАИП01 		= "";
	Объект.НомерБО01 		= "";
	Объект.СтавкаНДС01 		= "";
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Данные.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ДействующийДокумент
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Договор) КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА Бюджет.ОбъектФАИП ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА Бюджет.ОбъектФАИП.КодФАИП
	|          КОГДА Бюджет.ОбъектФАИП ССЫЛКА Справочник.МероприятияПоИнформатизации
	|			ТОГДА Бюджет.ОбъектФАИП.Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодФАИП01,
	|	Бюджет.ОбъектФАИП КАК ОбъектФАИП,
	|	Бюджет.КПС КАК КПС01,
	|	Бюджет.Ссылка.Договор КАК Договор
	|ПОМЕСТИТЬ Бюджет
	|ИЗ
	|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.РасшифровкаОбязательстваБюджет КАК Бюджет
	|ГДЕ
	|	Бюджет.Ссылка В
	|			(ВЫБРАТЬ
	|				ДействующийДокумент.Регистратор
	|			ИЗ
	|				ДействующийДокумент КАК ДействующийДокумент)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Договор01.ВидОбязательства КАК Наименование01,
	|	Договор01.НомерДоговора КАК Номер01,
	|	Договор01.ДатаДоговора КАК Дата01,
	|	Договор01.КраткоеСодержание КАК ПредметКонтракта,
	|	УчетныеНомераОбязательств.УчетныйНомерОбязательства КАК НомерБО01,
	|	ЕСТЬNULL(ХарактеристикиОбязательств.ЗначениеХарактеристики, """") КАК Идентификатор01,
	|	ЕСТЬNULL(Бюджет.КодФАИП01, """") КАК КодФАИП01,
	|	ЕСТЬNULL(Бюджет.ОбъектФАИП, ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ОбъектФАИП,
	|	ЕСТЬNULL(Бюджет.КПС01, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС01,
	|	Договор01.Контрагент КАК Контрагент,
	|	Договор01.СчетКонтрагента КАК СчетКонтрагента
	|ИЗ
	|	Справочник.Договоры КАК Договор01
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	|		ПО Договор01.Ссылка = УчетныеНомераОбязательств.Обязательство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательств
	|		ПО Договор01.Ссылка = ХарактеристикиОбязательств.Договор
	|			И (ХарактеристикиОбязательств.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторКонтракта))
	|		ЛЕВОЕ СОЕДИНЕНИЕ Бюджет КАК Бюджет
	|		ПО Договор01.Ссылка = Бюджет.Договор
	|ГДЕ
	|	Договор01.Ссылка = &Договор");
	 
	 Запрос.УстановитьПараметр("Договор", Объект.Договор01);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Если Выборка.Следующий() Тогда
		 Если ЗначениеЗаполнено(Объект.Договор02) Тогда
			 Исключить = "Контрагент, СчетКонтрагента";
		 Иначе
			 Исключить = "";
		 КонецЕсли;		 
		 ЗаполнитьЗначенияСвойств(Объект, Выборка,, Исключить);
		 Если Исключить = "" Тогда
			 ПолучательПриИзмененииНаСервере();
		 КонецЕсли;	 
	 КонецЕсли;	 
	 
	 Строка01Подробности = СформироватьПодробностиДоговора01(Объект);
	
КонецПроцедуры

&НаСервере
Процедура Договор02ПриИзмененииНаСервере()
	
	Объект.Наименование02 	= "";
	Объект.Номер02 			= "";
	Объект.Дата02			= "";
	Объект.Идентификатор02 	= "";
	Объект.КПС02 			= "";
	Объект.КодФАИП02 		= "";
	Объект.НомерБО02 		= "";
	Объект.СтавкаНДС02 		= "";
		
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Договор02.ВидОбязательства КАК Наименование02,
	|	Договор02.НомерДоговора КАК Номер02,
	|	Договор02.ДатаДоговора КАК Дата02,
	|	Договор02.КраткоеСодержание КАК ПредметКонтракта,
	|	Договор02.Контрагент КАК Контрагент,
	|	Договор02.СчетКонтрагента КАК СчетКонтрагента
	|ИЗ
	|	Справочник.Договоры КАК Договор02
	|ГДЕ
	|	Договор02.Ссылка = &Договор");
	 
	 Запрос.УстановитьПараметр("Договор", Объект.Договор02);
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 
	 Если Выборка.Следующий() Тогда
		 Если ЗначениеЗаполнено(Объект.ПредметКонтракта) Тогда
			 Исключить = "ПредметКонтракта";
		 Иначе
			 Исключить = "";
		 КонецЕсли;		 
		 
		 ЗаполнитьЗначенияСвойств(Объект, Выборка,, Исключить);
		 
		 ПолучательПриИзмененииНаСервере();
		 
	 КонецЕсли;	 
	 
	 Строка02Подробности = СформироватьПодробностиДоговора02(Объект);

КонецПроцедуры

