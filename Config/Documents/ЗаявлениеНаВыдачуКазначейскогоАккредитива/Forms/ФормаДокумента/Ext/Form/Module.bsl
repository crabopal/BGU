
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
			
			ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
			
		КонецЕсли;	

	КонецЕсли;
	
	ПлательщикПодробности = СформироватьПодробностиПлательщика(Объект);
	
	ПолучательПодробности = СформироватьПодробностиПолучателя(Объект);
	
	Строка01Подробности = СформироватьПодробностиДоговора01(Объект);
	
	Строка02Подробности = СформироватьПодробностиДоговора02(Объект);
	
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	
	ПлатежноРасчетныеДокументы.ПриСозданииНаСервереФормыДокумента(ЭтаФорма);
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтаФорма, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("ОбщаяФорма.РедактированиеПлатежныхРеквизитов") Тогда
		
		Если ВыбранноеЗначение.КлючДанных =	"Плательщик" Тогда
			
			Объект.ПлательщикБанковскийСчет   = ВыбранноеЗначение.БанковскийСчет;
			Объект.ПлательщикБИКБанка		  = ВыбранноеЗначение.БИКБанка;
			Объект.ПлательщикИНН 			  = ВыбранноеЗначение.ИНН ;
			Объект.ПлательщикКодРПБС 		  = ВыбранноеЗначение.КодРПБС;
			Объект.ПлательщикКПП 			  = ВыбранноеЗначение.КПП;
			Объект.ПлательщикНомерЛС 		  = ВыбранноеЗначение.ЛицевойСчет;
			Объект.ПлательщикНаименование 	  = ВыбранноеЗначение.Наименование;
			Объект.ПлательщикБюджет     	  = ВыбранноеЗначение.Бюджет;  
			Объект.ПлательщикОКПО        	  = ВыбранноеЗначение.ОКПО;
			Объект.ПлательщикАналитическийКод = ВыбранноеЗначение.АналитическийКод;
			Объект.ПлательщикАналитическийКод1= ВыбранноеЗначение.АналитическийКод1;
			
			ПлательщикПодробности = СформироватьПодробностиПлательщика(Объект);
			
			Модифицированность = Истина;
			
		ИначеЕсли ВыбранноеЗначение.КлючДанных =	"Получатель" Тогда
			
			Объект.ПолучательБанковскийСчет   = ВыбранноеЗначение.БанковскийСчет;
			Объект.ПолучательБИКБанка		  = ВыбранноеЗначение.БИКБанка;
			Объект.ПолучательИНН 			  = ВыбранноеЗначение.ИНН ;
			Объект.ПолучательКодРПБС 		  = ВыбранноеЗначение.КодРПБС;
			Объект.ПолучательКПП 			  = ВыбранноеЗначение.КПП;
			Объект.ПолучательНомерЛС 		  = ВыбранноеЗначение.ЛицевойСчет;
			Объект.ПолучательНаименование 	  = ВыбранноеЗначение.Наименование;
			Объект.ПолучательБюджет     	  = ВыбранноеЗначение.Бюджет;  
			Объект.ПолучательОКПО       	  = ВыбранноеЗначение.ОКПО;
			Объект.ПолучательАналитическийКод = ВыбранноеЗначение.АналитическийКод;
			Объект.ПолучательАналитическийКод1= ВыбранноеЗначение.АналитическийКод1;
			
			ПолучательПодробности = СформироватьПодробностиПолучателя(Объект);
			
			Модифицированность = Истина;
			
		КонецЕсли;	
		
	ИначеЕсли ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива.Форма.РедактированиеРеквизитовДоговора") Тогда
		
		Если ВыбранноеЗначение.КлючДанных =	"Строка01" Тогда
			
			Объект.Наименование01	= ВыбранноеЗначение.Наименование;
			Объект.Номер01			= ВыбранноеЗначение.Номер;
			Объект.Дата01			= ВыбранноеЗначение.Дата;
			Объект.Идентификатор01	= ВыбранноеЗначение.Идентификатор;
			Объект.КПС01			= ВыбранноеЗначение.КПС;
			Объект.КодФАИП01		= ВыбранноеЗначение.КодФАИП;
			Объект.ОбъектФАИП		= ВыбранноеЗначение.ОбъектФАИП;
			Объект.НомерБО01		= ВыбранноеЗначение.НомерБО;
			Объект.СтавкаНДС01		= ВыбранноеЗначение.СтавкаНДС;
			
			Строка01Подробности = СформироватьПодробностиДоговора01(Объект);
			
			Модифицированность = Истина;
			
		ИначеЕсли ВыбранноеЗначение.КлючДанных =	"Строка02" Тогда
			
			Объект.Наименование02	= ВыбранноеЗначение.Наименование;
			Объект.Номер02			= ВыбранноеЗначение.Номер;
			Объект.Дата02			= ВыбранноеЗначение.Дата;
			Объект.Идентификатор02	= ВыбранноеЗначение.Идентификатор;
			Объект.КПС02			= ВыбранноеЗначение.КПС;
			Объект.КодФАИП02		= ВыбранноеЗначение.КодФАИП;
			Объект.НомерБО02		= ВыбранноеЗначение.НомерБО;
			Объект.СтавкаНДС02		= ВыбранноеЗначение.СтавкаНДС;
			
			Строка02Подробности = СформироватьПодробностиДоговора02(Объект);
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ПлатежноРасчетныеДокументыКлиент.ОбработатьОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ПолучитьРеквизитыПлательщика();

КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Организация, ТекущаяСтрока, ТипЛицевогоСчета, НаДату, РазрешитьВыборЛСсСопровождениемНаРазделах",
		Объект.Организация, Объект.РеквизитыЛицевогоСчета, ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Казначейский"), Объект.Дата, Истина);
	ОткрытьФорму("Справочник.РеквизитыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
	ПолучитьЛицевойСчетОрганКазначейства();

КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ВидОперации = "выдать" Тогда
		
		 Объект.КодОперации 		= "01";
		 Объект.Договор02			= "";
		 Объект.Наименование02		= "";
		 Объект.Номер02				= "";
		 Объект.Дата02				= "";

	 ИначеЕсли Объект.ВидОперации = "перевести" Тогда  
		 
		 Объект.КодОперации = "02";
		 //Строка 02 Раздел 1 заполняется в случае представления Заявления на перевод.
		 
	 ИначеЕсли Объект.ВидОперации = "изменить" Тогда
		 
		 Объект.КодОперации = "03";
		 Объект.Договор02			= "";
		 Объект.Наименование02		= "";
		 Объект.Номер02				= "";
		 Объект.Дата02				= "";
		 
 
		 //В случае представления Заявления на изменение и Заявления на отзыв Раздел 2 не заполняется.

	 ИначеЕсли Объект.ВидОперации = "отозвать" Тогда
		 
		 Объект.КодОперации = "04";
		 
		 Объект.Договор02			= "";
		 Объект.Наименование02		= "";
		 Объект.Номер02				= "";
		 Объект.Дата02				= "";
		 Объект.Идентификатор02		= "";
		 Объект.КПС02				= "";
		 Объект.КодФАИП02			= "";
		 Объект.НомерБО02			= "";
		 Объект.СтавкаНДС02         = "";
		 
		 //Объект.Договор01			= "";  Договор01 должен быть всегда
		 //Объект.Наименование01	= "";
		 //Объект.Номер01			= "";
		 //Объект.Дата01			= "";
		 //Объект.Идентификатор01	= "";
		 //Объект.КПС01				= "";
		 //Объект.КодФАИП01			= "";
		 //Объект.НомерБО01			= "";
		 //Объект.СтавкаНДС01       = "";
		 Объект.ПредметКонтракта	= "";
		 
		 //В случае представления Заявления на отзыв Раздел 1 не заполняется.
		 //В случае представления Заявления на изменение и Заявления на отзыв Раздел 2 не заполняется.

