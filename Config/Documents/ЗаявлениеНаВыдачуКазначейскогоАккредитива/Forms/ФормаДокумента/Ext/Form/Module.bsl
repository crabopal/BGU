	МассивСтрок.Добавить("Наименование: " + ?(ЗначениеЗаполнено(Объект.Наименование02),  Объект.Наименование02,  "<не указано>"));
	МассивСтрок.Добавить("№: "            + ?(ЗначениеЗаполнено(Объект.Номер02),         Объект.Номер02,         "<не указан>"));
