&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Форма)
	
	ЭлементыФормы 	= Форма.Элементы;
	ОбъектФормы 	= Форма.Объект;
	
	ЭлементыФормы.ВидСредств.Доступность = НЕ (ОбъектФормы.КодВидаСредств = "01" ИЛИ ОбъектФормы.КодВидаСредств = "03" ИЛИ ОбъектФормы.КодВидаСредств = "04");
	
	ЭлементыФормы.Договор02.Доступность = ОбъектФормы.ВидОперации = "перевести";
	
	ЭлементыФормы.ПредметКонтракта.Доступность = НЕ ОбъектФормы.ВидОперации = "отозвать";

	ЭлементыФормы.Строка02Подробности.Доступность = ОбъектФормы.ВидОперации = "перевести";
	
	ЭлементыФормы.ПлательщикПодробности.Доступность = НЕ(ОбъектФормы.ВидОперации = "отозвать" ИЛИ ОбъектФормы.ВидОперации = "изменить");
	
	ЭлементыФормы.ПолучательПодробности.Доступность = НЕ(ОбъектФормы.ВидОперации = "отозвать" ИЛИ ОбъектФормы.ВидОперации = "изменить");
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива", Объект.Дата, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	
	Объект.ЛицевойСчет 				= Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета 	= Умолчания.РеквизитыЛицевогоСчета;
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
	ПолучитьРеквизитыПлательщика();
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьЛицевойСчетОрганКазначейства()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	Объект.ОрганКазначейства		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "КассовыйОрган");
	
   	ПолучитьРеквизитыПлательщика();

КонецПроцедуры

&НаСервере
Процедура ПолучитьРеквизитыПлательщика()
	
	Объект.ПлательщикНаименование	  = "";
	Объект.ПлательщикИНН			  = "";
	Объект.ПлательщикКПП			  = "";
	Объект.ПлательщикКодРПБС		  = "";
	Объект.ПлательщикНомерЛС		  = "";
	Объект.ПлательщикБанковскийСчет	  = "";
	Объект.ПлательщикБИКБанка		  = "";
	Объект.ПлательщикБюджет           = ""; 
	Объект.ПлательщикОКПО             = "";
	Объект.ПлательщикАналитическийКод = "";
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ПерваяПодпись", "Руководитель");
	СтруктураРеквизитов.Вставить("ВтораяПодпись", "ГлавныйБухгалтер");
	СтруктураРеквизитов.Вставить("ПерваяПодписьПечататьДолжность", "РуководительПечататьДолжность");
	СтруктураРеквизитов.Вставить("ВтораяПодписьПечататьДолжность", "ГлавныйБухгалтерПечататьДолжность");
	
	СвойстваЛицевогоСчета = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьСвойстваЛицевогоСчета(Объект.ЛицевойСчет, Объект.Дата, СтруктураРеквизитов); 

	ЗаполнитьЗначенияСвойств(Объект, СвойстваЛицевогоСчета);
	
	Если НЕ ЗначениеЗаполнено(Объект.ОтветственныйИсполнитель) Тогда
		Объект.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(Объект.Ответственный, Объект.Организация, "Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива");
	КонецЕсли;	

	Если Объект.ВидОперации = "изменить" ИЛИ Объект.ВидОперации = "отозвать" ИЛИ НЕ ЗначениеЗаполнено(Объект.РеквизитыЛицевогоСчета) Тогда
		Возврат;
	КонецЕсли;	
	
	РеквизитыПлательщика = Новый Структура("ПлательщикИНН, ПлательщикКПП, ПлательщикНаименование, ПлательщикБанковскийСчет, ПлательщикБИКБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "БИК");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(Объект.ЛицевойСчет, Объект.РеквизитыЛицевогоСчета, РеквизитыПлательщика);

	ЗаполнитьЗначенияСвойств(Объект, РеквизитыПлательщика);
	
	Объект.ПлательщикНаименование	= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,        "НаименованиеПолное"));
	Объект.ПлательщикИНН			= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,        "ИНН"));
	Объект.ПлательщикКПП			= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,        "КПП"));
	
	Объект.ПлательщикКодРПБС        = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,        "КодПоРПБС")); 	
	Объект.ПлательщикНомерЛС        = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ЛицевойСчет,        "Код")); 
	
	Объект.ПлательщикБюджет         = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация.Бюджет, "Наименование")); 
	
	Объект.ПлательщикОКПО           = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация,         "КодОКПО")); 
	
	ПлательщикПодробности           = СформироватьПодробностиПлательщика(Объект);
	
		
КонецПроцедуры	                                

&НаСервере
Процедура ПолучательПриИзмененииНаСервере()
	
	Объект.ПолучательНаименование	= "";
	Объект.ПолучательИНН			= "";
	Объект.ПолучательКПП			= "";
	Объект.ПолучательКодРПБС		= "";
	Объект.ПолучательНомерЛС		= "";
	Объект.ПолучательБанковскийСчет = "";
	Объект.ПолучательБИКБанка		= "";
	
	Если Объект.ВидОперации = "изменить"  ИЛИ Объект.ВидОперации = "отозвать" ИЛИ НЕ ЗначениеЗаполнено(Объект.СчетКонтрагента) Тогда
		ПолучательПодробности = СформироватьПодробностиПолучателя(Объект);
		Возврат;
	КонецЕсли;	
	
	РеквизитыПолучателя = Новый Структура("ПолучательИНН, ПолучательКПП, ПолучательНаименование, ПолучательБанковскийСчет, ПолучательБИКБанка", "ИНН", "КПП", "Корреспондент", "СчетНомер", "БИК");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(Объект.СчетКонтрагента, Объект.СчетКонтрагента, РеквизитыПолучателя);
		
	СтруктураРеквизитов = Новый Структура("ТипЛицевогоСчета, Код"); 
    СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СчетКонтрагента, СтруктураРеквизитов);
	
	Если СтруктураРеквизитов.ТипЛицевогоСчета = ПредопределенноеЗначение("Перечисление.ТипыЛицевыхСчетов.Казначейский") Тогда
		РеквизитыПолучателя.Вставить("ПолучательНомерЛС", СтруктураРеквизитов.Код);
	КонецЕсли;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.КодПоРПБС
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодРПБС,
	|   ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		ИНАЧЕ Контрагенты.ЮридическоеФизическоеЛицо.Наименование
	|	КОНЕЦ КАК Наименование, 
	|   Контрагенты.ЮридическоеФизическоеЛицо.КодОКПО КАК КодОКПО,
	|   ВЫБОР
	|		КОГДА Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА Контрагенты.ЮридическоеФизическоеЛицо.Бюджет
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Бюджет
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		РеквизитыПолучателя.Вставить("ПолучательКодРПБС",      Выборка.КодРПБС);
		РеквизитыПолучателя.Вставить("ПолучательНаименование", Выборка.Наименование);
		РеквизитыПолучателя.Вставить("ПолучательБюджет",       Выборка.Бюджет); 
		РеквизитыПолучателя.Вставить("ПолучательОКПО",         Выборка.КодОКПО);
	КонецЕсли;	
    
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыПолучателя);
	
	Объект.ПолучательИНН			= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "ИНН"));
	Объект.ПолучательКПП			= СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Контрагент, "КПП"));
	
	ПолучательПодробности = СформироватьПодробностиПолучателя(Объект);
 	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПодробностиПлательщика(Объект)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Наименование: "      + ?(ЗначениеЗаполнено(Объект.ПлательщикНаименование),     Объект.ПлательщикНаименование,     "<не указано>"));
	МассивСтрок.Добавить("ИНН: "               + ?(ЗначениеЗаполнено(Объект.ПлательщикИНН),              Объект.ПлательщикИНН,              "<не указан>"));
	МассивСтрок.Добавить("КПП: "               + ?(ЗначениеЗаполнено(Объект.ПлательщикКПП),              Объект.ПлательщикКПП,              "<не указан>"));
	МассивСтрок.Добавить("Код по РПБС: "       + ?(ЗначениеЗаполнено(Объект.ПлательщикКодРПБС),          Объект.ПлательщикКодРПБС,          "<не указан>"));
	МассивСтрок.Добавить("Л/С: "               + ?(ЗначениеЗаполнено(Объект.ПлательщикНомерЛС),          Объект.ПлательщикНомерЛС,          "<не указан>"));
	МассивСтрок.Добавить("Номер счета: "       + ?(ЗначениеЗаполнено(Объект.ПлательщикБанковскийСчет),   Объект.ПлательщикБанковскийСчет,   "<не указан>"));
	МассивСтрок.Добавить("БИК: "               + ?(ЗначениеЗаполнено(Объект.ПлательщикБИКБанка),         Объект.ПлательщикБИКБанка,         "<не указан>"));   
	МассивСтрок.Добавить("Бюджет: "            + ?(ЗначениеЗаполнено(Объект.ПлательщикБюджет),           Объект.ПлательщикБюджет,           "<не указан>")); 
	МассивСтрок.Добавить("ОКПО: "              + ?(ЗначениеЗаполнено(Объект.ПлательщикОКПО),             Объект.ПлательщикОКПО,             "<не указан>")); 
	МассивСтрок.Добавить("Аналитический код: " + ?(ЗначениеЗаполнено(Объект.ПлательщикАналитическийКод), Объект.ПлательщикАналитическийКод, "<не указан>")); 
	
	Возврат СокрЛП(СтрСоединить(МассивСтрок, "; "));  
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПодробностиПолучателя(Объект)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Наименование: "      + ?(ЗначениеЗаполнено(Объект.ПолучательНаименование),     Объект.ПолучательНаименование,     "<не указано>"));
	МассивСтрок.Добавить("ИНН: "               + ?(ЗначениеЗаполнено(Объект.ПолучательИНН),              Объект.ПолучательИНН,              "<не указан>"));
	МассивСтрок.Добавить("КПП: "               + ?(ЗначениеЗаполнено(Объект.ПолучательКПП),              Объект.ПолучательКПП,              "<не указан>"));
	МассивСтрок.Добавить("Код по РПБС: "       + ?(ЗначениеЗаполнено(Объект.ПолучательКодРПБС),          Объект.ПолучательКодРПБС,          "<не указан>"));
	МассивСтрок.Добавить("Л/С: "               + ?(ЗначениеЗаполнено(Объект.ПолучательНомерЛС),          Объект.ПолучательНомерЛС,          "<не указан>"));
	МассивСтрок.Добавить("Номер счета: "       + ?(ЗначениеЗаполнено(Объект.ПолучательБанковскийСчет),   Объект.ПолучательБанковскийСчет,   "<не указан>"));
	МассивСтрок.Добавить("БИК: "               + ?(ЗначениеЗаполнено(Объект.ПолучательБИКБанка),         Объект.ПолучательБИКБанка,         "<не указан>"));  
	МассивСтрок.Добавить("Бюджет: "            + ?(ЗначениеЗаполнено(Объект.ПолучательБюджет),           Объект.ПолучательБюджет,           "<не указан>")); 
	МассивСтрок.Добавить("ОКПО: "              + ?(ЗначениеЗаполнено(Объект.ПолучательОКПО),             Объект.ПолучательОКПО,             "<не указан>"));
	МассивСтрок.Добавить("Аналитический код: " + ?(ЗначениеЗаполнено(Объект.ПолучательАналитическийКод), Объект.ПолучательАналитическийКод, "<не указан>")); 

	
	Возврат СокрЛП(СтрСоединить(МассивСтрок, "; "));  
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьПодробностиДоговора01(Объект)
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить("Наименование: " + ?(ЗначениеЗаполнено(Объект.Наименование01),  Объект.Наименование01,  "<не указано>"));
