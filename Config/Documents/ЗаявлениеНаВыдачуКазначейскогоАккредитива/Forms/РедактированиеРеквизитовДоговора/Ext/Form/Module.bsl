
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗаголовокФормы") Тогда
		АвтоЗаголовок = Ложь;
		Заголовок     = Параметры.ЗаголовокФормы;
	КонецЕсли;
	
	Параметры.Свойство("КлючДанных", КлючДанных);
	
	РеквизитыДоговора = Параметры.РеквизитыДоговора;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыДоговора);
	
	Элементы.Наименование.Видимость 	= РеквизитыДоговора.Свойство("Наименование");
	Элементы.Номер.Видимость			= РеквизитыДоговора.Свойство("Номер");	
	Элементы.Дата.Видимость				= РеквизитыДоговора.Свойство("Дата");	
	Элементы.Идентификатор.Видимость	= РеквизитыДоговора.Свойство("Идентификатор");	
	Элементы.КПС.Видимость				= РеквизитыДоговора.Свойство("КПС");
	Элементы.НомерБО.Видимость 			= РеквизитыДоговора.Свойство("НомерБО");
	Элементы.СтавкаНДС.Видимость 		= РеквизитыДоговора.Свойство("СтавкаНДС");
	
	Если КлючДанных = "Строка01" Тогда
		
		Элементы.ОбъектФАИП.Видимость 	= РеквизитыДоговора.Свойство("ОбъектФАИП");
		Элементы.КодФАИП.Видимость 		= Ложь;
		
		Параметры.Свойство("Договор", 		Договор);
		Параметры.Свойство("Организация", 	Организация);
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	Данные.Регистратор КАК Регистратор
		|ПОМЕСТИТЬ ДействующийДокумент
		|ИЗ
		|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Договор) КАК Данные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Бюджет.ОбъектФАИП КАК ОбъектФАИП
		|ИЗ
		|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.РасшифровкаОбязательстваБюджет КАК Бюджет
		|ГДЕ
		|	Бюджет.Ссылка В
		|			(ВЫБРАТЬ
		|				ДействующийДокумент.Регистратор
		|			ИЗ
		|				ДействующийДокумент КАК ДействующийДокумент)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Бюджет.КПС КАК КПС
		|ИЗ
		|	Документ.РегистрацияОбязательствИСведенийПоДоговорам.РасшифровкаОбязательстваБюджет КАК Бюджет
		|ГДЕ
		|	Бюджет.Ссылка В
		|			(ВЫБРАТЬ
		|				ДействующийДокумент.Регистратор
		|			ИЗ
		|				ДействующийДокумент КАК ДействующийДокумент)");
		
		Запрос.УстановитьПараметр("Договор", Договор);

		ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
		
		СписокФАИП =  ПакетРезультатовЗапроса[1].Выгрузить().ВыгрузитьКолонку("ОбъектФАИП");

		СписокКПС =  ПакетРезультатовЗапроса[2].Выгрузить().ВыгрузитьКолонку("КПС");
		
		Элементы.ОбъектФАИП.СписокВыбора.ЗагрузитьЗначения(СписокФАИП);
		Элементы.ОбъектФАИП.РежимВыбораИзСписка = Истина;

		Элементы.КПС.СписокВыбора.ЗагрузитьЗначения(СписокКПС);
		Элементы.КПС.РежимВыбораИзСписка = Истина;
		
	Иначе	
		Элементы.КодФАИП.Видимость 		= РеквизитыДоговора.Свойство("КодФАИП");
		Элементы.ОбъектФАИП.Видимость 	= Ложь;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОбъектФАИППриИзменении(Элемент)
	ОбъектФАИППриИзмененииНаСервере(ОбъектФАИП, КодФАИП);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = Новый Структура("Наименование, Номер, Дата, Идентификатор, КПС, КодФАИП, ОбъектФАИП, НомерБО, СтавкаНДС, КлючДанных");
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтотОбъект);
	
	ОповеститьОВыборе(Результат);

КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ОбъектФАИППриИзмененииНаСервере(ОбъектФАИП, КодФАИП)
	
	Если ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		
		КодФАИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектФАИП, "КодФАИП");
		
	ИначеЕсли ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.МероприятияПоИнформатизации") Тогда
		
		КодФАИП = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектФАИП, "Код");
		
	Иначе
		КодФАИП = "";
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

