// Функция формирует табличный документ Заявление на выдачу казначейского аккредитива
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьЗаявления0506108(МассивОбъектов, ОбъектыПечати, Постфикс = "")
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы 					= ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб 						= Истина; 
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявлениеНаВыдачуКазначейскогоАккредитива_ЗаявлениеНаВыдачуКазначейскогоАккредитива";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива.ПФ_MXL_Форма0506108" + Постфикс);
	
	ДанныеДляПечатиМассив = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявлениеНаВыдачуКазначейскогоАккредитива(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	Для Каждого ДанныеДляПечати Из ДанныеДляПечатиМассив Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		// вывод в табличный документ
		ОбластьВывода = Макет.ПолучитьОбласть("Заголовок");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		ТабДокумент.Вывести(ОбластьВывода);
		
		// Раздел 1
		Если НЕ ДанныеДляПечати.ВидОперации = "отозвать" Тогда	
					
			ОбластьВывода = Макет.ПолучитьОбласть("Раздел1");
			ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЕсли;

		// Раздел 2
		Если ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикНаименование) ИЛИ								
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикИНН) ИЛИ		
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикКПП) ИЛИ		
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикКодРПБС) ИЛИ	
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикНомерЛС) ИЛИ			
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикБанковскийСчет) ИЛИ			
			ЗначениеЗаполнено(ДанныеДляПечати.ПлательщикБИКБанка) Тогда	
			
			ОбластьВывода = Макет.ПолучитьОбласть("Раздел2");
			ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЕсли;
		
		// Раздел 2
		Если ЗначениеЗаполнено(ДанныеДляПечати.ПолучательНаименование) ИЛИ								
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательИНН) ИЛИ		
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательКПП) ИЛИ		
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательКодРПБС) ИЛИ	
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательНомерЛС) ИЛИ			
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательБанковскийСчет) ИЛИ			
			ЗначениеЗаполнено(ДанныеДляПечати.ПолучательБИКБанка) Тогда	
			
			ОбластьВывода = Макет.ПолучитьОбласть("Раздел3");
			ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
			ТабДокумент.Вывести(ОбластьВывода);
			
		КонецЕсли;   
		
		Если Постфикс = "_36н" Тогда 
			
			Если ЗначениеЗаполнено(ДанныеДляПечати.БанковскоеСопровождение) Тогда 
				
				ОбластьВывода = Макет.ПолучитьОбласть("Раздел4");
				ТабДокумент.Вывести(ОбластьВывода);    
				
				Для каждого ПодтверждающийДокумент Из ДанныеДляПечати.БанковскоеСопровождение Цикл   
					
					ОбластьВывода = Макет.ПолучитьОбласть("Стр_4");  
					ОбластьВывода.Параметры.Заполнить(ПодтверждающийДокумент);
					ТабДокумент.Вывести(ОбластьВывода);  
					
				КонецЦикла; 
				
				ОбластьВывода = Макет.ПолучитьОбласть("Раздел4_");
				ТабДокумент.Вывести(ОбластьВывода);    
	
			КонецЕсли;	
			
			// Раздел 5
			Если ЗначениеЗаполнено(ДанныеДляПечати.ДополнительныеСведения) Тогда	
				
				ОбластьВывода = Макет.ПолучитьОбласть("Раздел5");
				ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
				ТабДокумент.Вывести(ОбластьВывода);
				
			КонецЕсли;  
			
        Иначе
			// Раздел 4
			Если ЗначениеЗаполнено(ДанныеДляПечати.ДополнительныеСведения) Тогда	
				
				ОбластьВывода = Макет.ПолучитьОбласть("Раздел4");
				ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
				ТабДокумент.Вывести(ОбластьВывода);
				
			КонецЕсли;  
		КонецЕсли;	
				
		// подписи ответственных лиц 
		ОбластьВывода = Макет.ПолучитьОбласть("Подвал");
		ОбластьВывода.Параметры.Заполнить(ДанныеДляПечати);
		
		ТабДокумент.Вывести(ОбластьВывода);
		
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОтметкаФК"));
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеДляПечати.Ссылка);
		
	КонецЦикла;	
	
	Возврат ТабДокумент;
	
КонецФункции


Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт
	
	Перем Запрос, ТекстЗапроса;
	Перем ТаблицыДвижений;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	СрокиИСуммы.Дата КАК Период,
	|	СрокиИСуммы.Договор01 КАК Обязательство,
	|	СрокиИСуммы.ОбъектФАИП КАК ОбъектФАИП,
	|	СрокиИСуммы.КПС01 КАК КПС,
	|	СрокиИСуммы.НомерАккредитива КАК НомерКОО,
	|	СрокиИСуммы.ДатаАккредитива КАК ДатаКОО,
	|	ВЫБОР
	|		КОГДА СрокиИСуммы.ВидОперации = ""отозвать""
	|			ТОГДА 0
	|		ИНАЧЕ СрокиИСуммы.СуммаАккредитива
	|	КОНЕЦ КАК Сумма
	|ИЗ
	|	Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива КАК СрокиИСуммы
	|ГДЕ
	|	СрокиИСуммы.Ссылка = &Ссылка";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	Результат = Запрос.ВыполнитьПакет();
	ТаблицыДляДвижений = ДополнительныеСвойства.ТаблицыДляДвижений;
	ТаблицыДляДвижений.Вставить("КазначейскоеОбеспечение", Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
