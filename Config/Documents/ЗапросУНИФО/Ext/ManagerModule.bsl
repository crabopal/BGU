#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаВыбора" Тогда
		//чтобы при программном открытии формы выбора установился режим выбора
		Параметры.Вставить("РежимВыбора", Истина);
		ВыбраннаяФорма = "ФормаСписка";
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий_1

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если Данные.ТипЗапрашиваемыхДанных = "PAYMENT" Тогда
		ВидЗапроса = "Запрос активных платежей (PAYMENT), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "PAYMENTCANCELLED" Тогда
		ВидЗапроса = "Запрос аннулированных платежей (PAYMENTCANCELLED), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "CHARGE" Тогда
		ВидЗапроса = "Запрос начисления (CHARGE), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");	
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "CHARGESTATUS" Тогда
		ВидЗапроса = "Запрос начислений и статусов их квитирования (CHARGESTATUS), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "CHARGE-PRIOR-STATUS" Тогда
		ВидЗапроса = "Запрос предв. начислений и статусов их квитирования (CHARGE-PRIOR-STATUS), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");	
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "CHARGE-PRIOR" Тогда
		ВидЗапроса = "Запрос неоплаченных предв. начислений (CHARGE-PRIOR), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");		
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "QUITTANCE" Тогда
		ВидЗапроса = "Запрос результата квитирования (QUITTANCE), стр." + ?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST" Тогда		
		Если Данные.КвитированиеБезПлатежа Тогда
			ВидЗапроса = "Квитирование начисления без платежа";	
		Иначе
			ВидЗапроса = "Квитирование начисления с платежами";
		КонецЕсли;
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE" Тогда
		Если Данные.КвитированиеБезПлатежа Тогда
			ВидЗапроса = "Аннулирование квитирования начисления без платежа";	
		Иначе
			ВидЗапроса = "Аннулирование квитирования начисления с платежами";
		КонецЕсли;
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "CATALOG" Тогда
		ВидЗапроса = "Запрос каталога гос. услуг (CATALOG)";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "REFUND" Тогда
		ВидЗапроса = "Запрос возвратов (REFUND)";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "APPEND" Тогда
		ВидЗапроса = "Загрузка нового сертификата ключа проверки ЭП";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "REPLACE" Тогда
		ВидЗапроса = "Обновление хранящегося в системе сертификата ключа проверки ЭП";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE" Тогда
		ВидЗапроса = "Исключение из автоматического квитирования начисления с платежами (EXCLUDEQUITTANCE)";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
		ВидЗапроса = "Включение автоматического квитирования начисления с платежами (ANNULMENTEXCLUDEQUITTANCE)";
	ИначеЕсли Данные.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
		ВидЗапроса = "Запрос к эмулятору для ВС Прием информации о погашении начисления";	
	ИначеЕсли ЗначениеЗаполнено(Данные.ТипЗапрашиваемыхДанных) Тогда
		ВидЗапроса = "Запрос к сервису "+Данные.ТипЗапрашиваемыхДанных+", стр."+?(ЗначениеЗаполнено(Данные.СтраницаРезультата),Данные.СтраницаРезультата,"1");
	Иначе
		ВидЗапроса = "Запрос к сервису <вид операции не указан>";
	КонецЕсли;
	
	//Запрос к ГИС ГМП, ИС РНИП, ИС УНП
	Представление = "" + ВидЗапроса + " №"+СокрЛП(Данные.Номер)+" от "+Данные.Дата;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("ТипЗапрашиваемыхДанных");
	Поля.Добавить("КвитированиеБезПлатежа");
	Поля.Добавить("СтраницаРезультата");
	Поля.Добавить("Дата");
	Поля.Добавить("Номер");
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти
