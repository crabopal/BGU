&НаСервере
Процедура ОпеределитьВидимостьПоТипуУчастника()
	
	ТекВидимость = (Объект.ТипУчастника = Перечисления.ТипыУчастниковГИСГМП.АН);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеИсточник","Видимость",ТекВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеСумма","Видимость",ТекВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаУчастники","Видимость",ТекВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"Участник","Видимость",ТекВидимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеГруппаПодобрать","Видимость",ТекВидимость);
		
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборДокумента(ИдентификаторСтр)
	
	ТекСтр = Объект.ЗапрашиваемыеДанные.НайтиПоИдентификатору(ИдентификаторСтр);	
	
	Если Объект.ТипЗапрашиваемыхДанных = "REFUND" Тогда
		РеквизитыВыбранногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтр.Источник,"УИВ,СуммаДокумента");
        ТекСтр.Сумма = РеквизитыВыбранногоДокумента.СуммаДокумента;
		ТекСтр.УИД = РеквизитыВыбранногоДокумента.УИВ;
		
	ИначеЕсли Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" 
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
		
		РеквизитыВыбранногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтр.Источник,"БанковскийИдентификаторПлатежа,СуммаДокумента");
		ТекСтр.УИД = РеквизитыВыбранногоДокумента.БанковскийИдентификаторПлатежа;
		ТекСтр.Сумма = РеквизитыВыбранногоДокумента.СуммаДокумента;
		ОбновитьСуммуВыбранныхПлатежей();
		
	Иначе
		
		РеквизитыВыбранногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтр.Источник,"УникальныйИдентификаторНачисления,ЕдиныйИдентификаторПлательщика,АльтернативныйИдентификаторПлательщика,УникальныйИдентификаторЗаявки,СуммаДокумента");
        ТекСтр.Сумма = РеквизитыВыбранногоДокумента.СуммаДокумента;
		Если Объект.ТипИдентификатораДанных = "УИН" Тогда
			ТекСтр.УИД = РеквизитыВыбранногоДокумента.УникальныйИдентификаторНачисления;
		ИначеЕсли Объект.ТипИдентификатораДанных = "УИП" Тогда
			Если ЗначениеЗаполнено(РеквизитыВыбранногоДокумента.ЕдиныйИдентификаторПлательщика) Тогда
				ТекСтр.УИД = РеквизитыВыбранногоДокумента.ЕдиныйИдентификаторПлательщика;
			Иначе
				ТекСтр.УИД = РеквизитыВыбранногоДокумента.АльтернативныйИдентификаторПлательщика;
			КонецЕсли;
		ИначеЕсли Объект.ТипИдентификатораДанных = "УИЗ" Тогда
			ТекСтр.УИД = РеквизитыВыбранногоДокумента.УникальныйИдентификаторЗаявки;
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура ОбработатьВыборМассиваДокументов(МассивСсылок)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежВОплатуГосуслуг.Ссылка КАК Источник,
		|	ПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа КАК УИД,
		|	ПлатежВОплатуГосуслуг.СуммаДокумента,
		|	NULL КАК ЕдиныйИдентификаторПлательщика,
		|	NULL КАК АльтернативныйИдентификаторПлательщика,
		|	NULL КАК УникальныйИдентификаторЗаявки
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|ГДЕ
		|	ПлатежВОплатуГосуслуг.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления,
		|	КвитанцияНаОплатуГосуслуг.СуммаДокумента,
		|	КвитанцияНаОплатуГосуслуг.ЕдиныйИдентификаторПлательщика,
		|	КвитанцияНаОплатуГосуслуг.АльтернативныйИдентификаторПлательщика,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторЗаявки
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПлатежПодведомственному.Ссылка,
		|	ПлатежПодведомственному.БанковскийИдентификаторПлатежа,
		|	ПлатежПодведомственному.СуммаДокумента,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|ГДЕ
		|	ПлатежПодведомственному.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления,
		|	НачислениеОтПодведомственного.СуммаДокумента,
		|	НачислениеОтПодведомственного.ЕдиныйИдентификаторПлательщика,
		|	НачислениеОтПодведомственного.АльтернативныйИдентификаторПлательщика,
		|	НачислениеОтПодведомственного.УникальныйИдентификаторЗаявки
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивСсылок)";
		
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	СтруктураПоиска = Новый Структура;
	Пока Выборка.Следующий() Цикл
		СтруктураПоиска.Вставить("Источник",Выборка.Источник);
		Если Объект.ЗапрашиваемыеДанные.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
			НоваяСтрокаТЧ = Объект.ЗапрашиваемыеДанные.Добавить();
			НоваяСтрокаТЧ.Источник = Выборка.Источник;
			
			Если Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
				ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
				ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" 
				ИЛИ Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
				ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE"	Тогда
				
				НоваяСтрокаТЧ.УИД = Выборка.УИД;
				НоваяСтрокаТЧ.Сумма = Выборка.СуммаДокумента;
				СуммаПлатежей = СуммаПлатежей + Выборка.СуммаДокумента;
				
			Иначе	
                НоваяСтрокаТЧ.Сумма = Выборка.СуммаДокумента;
				Если Объект.ТипИдентификатораДанных = "УИН" Тогда
					НоваяСтрокаТЧ.УИД = Выборка.УИД;
				ИначеЕсли Объект.ТипИдентификатораДанных = "УИП" Тогда
					Если ЗначениеЗаполнено(Выборка.ЕдиныйИдентификаторПлательщика) Тогда
						НоваяСтрокаТЧ.УИД = Выборка.ЕдиныйИдентификаторПлательщика;
					Иначе
						НоваяСтрокаТЧ.УИД = Выборка.АльтернативныйИдентификаторПлательщика;
					КонецЕсли;
				ИначеЕсли Объект.ТипИдентификатораДанных = "УИЗ" Тогда
					НоваяСтрокаТЧ.УИД = Выборка.УникальныйИдентификаторЗаявки;
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммуВыбранныхПлатежей()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ВложенныйЗапрос.СуммаДокументов) КАК СуммаДокументов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПлатежВОплатуГосуслуг.СуммаДокумента КАК СуммаДокументов
		|	ИЗ
		|		Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|	ГДЕ
		|		ПлатежВОплатуГосуслуг.Ссылка В(&Ссылки)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ПлатежПодведомственному.СуммаДокумента
		|	ИЗ
		|		Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|	ГДЕ
		|		ПлатежПодведомственному.Ссылка В(&Ссылки)) КАК ВложенныйЗапрос";

	Запрос.УстановитьПараметр("Ссылки", Объект.ЗапрашиваемыеДанные.Выгрузить().ВыгрузитьКолонку("Источник"));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    СуммаПлатежей = 0;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СуммаПлатежей = ВыборкаДетальныеЗаписи.СуммаДокументов;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НачислениеПриИзменении(Элемент)
	НачислениеСумма = ПолучитьСуммуНачисления(Объект.Начисление);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуНачисления(Знач Начисление)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Начисление,"СуммаДокумента");	
КонецФункции

&НаКлиенте
Процедура СертификатЭППриИзменении(Элемент)
	
	Объект.СерийныйНомерСертификата = "";
	Объект.ДанныеСертификата = "";
	
	Если ЗначениеЗаполнено(Объект.СертификатЭП) Тогда
		СертификатЭППриИзмененииНаСервере();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СертификатЭППриИзмененииНаСервере()
	ДвоичныеДанныеСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		Объект.СертификатЭП, "ДанныеСертификата").Получить();
	
	Если ТипЗнч(ДвоичныеДанныеСертификата) = Тип("ДвоичныеДанные") Тогда
		Сертификат = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
		Объект.ДанныеСертификата = Base64Строка(ДвоичныеДанныеСертификата);
		
		СерийныйНомер = Строка(Сертификат.СерийныйНомер);
		СерийныйНомер = СтрЗаменить(СерийныйНомер," ","");
		Объект.СерийныйНомерСертификата = XMLСтрока(БиблиотекаФункцийОбменаПовтИсп.ПеревестиИз16В10(СерийныйНомер));
		
	КонецЕсли;
КонецПроцедуры

