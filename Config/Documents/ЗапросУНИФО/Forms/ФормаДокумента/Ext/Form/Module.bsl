&НаКлиенте
Процедура Подбор(Команда)
	Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
		И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "EXCLUDEQUITTANCE"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTEXCLUDEQUITTANCE"
		И НЕ ЗначениеЗаполнено(Объект.ТипИдентификатораДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны данные для запроса!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	Если Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST"  
	    ИЛИ Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
		
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
		ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
		ПараметрыФормы.Вставить("Начисление",Объект.Начисление);
		ОткрытьФорму("Документ.ПлатежВОплатуГосуслуг.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
		
	Иначе 
		
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
		ПараметрыФормы.Вставить("ИдентификаторОбъекта",Объект.ТипИдентификатораДанных);
		ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
		//ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",Истина);
		ОткрытьФорму("Документ.КвитанцияНаОплатуГосуслуг.ФормаВыбора",ПараметрыФормы,ЭтаФорма);

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьАН(Команда)
	Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
		И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "EXCLUDEQUITTANCE"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTEXCLUDEQUITTANCE"
		И НЕ ЗначениеЗаполнено(Объект.ТипИдентификатораДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны данные для запроса!");
		Возврат;
	КонецЕсли;
	
	Если Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST"  
	    ИЛИ Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
		ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
		ПараметрыФормы.Вставить("Начисление",Объект.Начисление);
		ОткрытьФорму("Документ.ПлатежПодведомственному.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
		ПараметрыФормы.Вставить("ИдентификаторОбъекта",Объект.ТипИдентификатораДанных);
		ПараметрыФормы.Вставить("МножественныйВыбор",Истина);
		//ПараметрыФормы.Вставить("ЗакрыватьПриВыборе",Истина);
		ОткрытьФорму("Документ.НачислениеОтПодведомственного.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
				
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРезультаты(Команда)
	ОчиститьСообщения();
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыФормы = Новый Структура("ЗапросСМЭВ",Объект.Ссылка);
		ОткрытьФорму("РегистрСведений.ЗагруженныеДанныеСМЭВ3.Форма.ФормаОтображенияЗагруженныхДанных",ПараметрыФормы,ЭтотОбъект,Объект.Ссылка);	
	КонецЕсли;
КонецПроцедуры

