
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	Элементы.ОткрытьРезультаты.Заголовок = "Загруженные документы ("+Объект.ЗагруженоДанных+")";
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда //Новый документ
			
		//Объект.ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
		//Объект.ДатаОкончания = КонецДня(ТекущаяДатаСеанса());
		Объект.СтраницаРезультата = 1;
		Объект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен;
		Объект.РезультатЗагрузки = "";
		Объект.ЗагруженоДанных = 0;
		
		Если НЕ ЗначениеЗаполнено(Объект.ТипУчастника) Тогда
			Объект.ТипУчастника = Перечисления.ТипыУчастниковГИСГМП.АН;
		КонецЕсли;
		
	КонецЕсли;
	
	СпособКвитирования = ?(ЗначениеЗаполнено(Объект.СуммаЧастичногоКвитирования),"ЧАСТЬСУММЫ","ВСЯСУММА");
	Если ЗначениеЗаполнено(Объект.Начисление) Тогда
		НачислениеСумма = ПолучитьСуммуНачисления(Объект.Начисление);
	КонецЕсли;
	
    // ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ЭтоБазаГАН = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеПодобратьАН","Видимость",ЭтоБазаГАН);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанные","ТолькоПросмотр",Объект.ТипИдентификатораДанных = "НЕТ");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеПодбор","Доступность",НЕ Объект.ТипИдентификатораДанных = "НЕТ");
				
	ПриИзмененииВидаОперации();
	
	ОпеределитьВидимостьПоТипуУчастника();
	
	ПлатежноРасчетныеДокументы.ПриСозданииНаСервереФормыДокумента(ЭтаФорма);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
    ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		ОбработатьВыборМассиваДокументов(ВыбранноеЗначение);
	Иначе
		НовСтр = Объект.ЗапрашиваемыеДанные.Добавить();
		НовСтр.Источник = ВыбранноеЗначение;
		ОбработатьВыборДокумента(НовСтр.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	ПлатежноРасчетныеДокументыКлиент.ОбработатьОповещения(ЭтаФорма, ИмяСобытия, Параметр, Источник);

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.КвитированиеБезПлатежа = Ложь
		И ЗначениеЗаполнено(Объект.СуммаЧастичногоКвитирования) Тогда
		Объект.СуммаЧастичногоКвитирования = 0; // очистка не корректных данных
	КонецЕсли;
	
	Если Объект.КвитированиеБезПлатежа
		И СпособКвитирования = "ЧАСТЬСУММЫ"
		И Объект.СуммаЧастичногоКвитирования = 0 Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Укажите сумму частичного квитирования'"),,"СуммаЧастичногоКвитирования","Объект.СуммаЧастичногоКвитирования");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
    ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипИдентификатораДанныхПриИзменении(Элемент)
	Если Объект.ЗапрашиваемыеДанные.Количество()>0 Тогда
		Объект.ЗапрашиваемыеДанные.Очистить();
	КонецЕсли;
	Элементы.ЗапрашиваемыеДанные.ТолькоПросмотр = Объект.ТипИдентификатораДанных = "НЕТ";
	Элементы.ЗапрашиваемыеДанныеПодбор.Доступность = НЕ Объект.ТипИдентификатораДанных = "НЕТ";
	
	Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
		И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
		
		Если Объект.ТипИдентификатораДанных = "УИН" Тогда
			ТекЗаголовок = "Уникальный идентификатор начисления";
		ИначеЕсли Объект.ТипИдентификатораДанных = "УИП" Тогда
			ТекЗаголовок = "Идентификатор плательщика";
		ИначеЕсли Объект.ТипИдентификатораДанных = "УИЗ" Тогда
			ТекЗаголовок = "Идентификатор заявки";
		Иначе
			ТекЗаголовок = "Запрашиваемые идентификаторы";
		КонецЕсли;
       	
	Иначе
		ТекЗаголовок = "Идентификатор платежа";
	КонецЕсли;
	
	Элементы.ЗапрашиваемыеДанныеУИД.Заголовок = ТекЗаголовок;

КонецПроцедуры

&НаКлиенте
Процедура ТипЗапрашиваемыхДанныхПриИзменении(Элемент)
		
	Если Объект.ТипЗапрашиваемыхДанных = "APPEND"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "REPLACE" Тогда
		
		Объект.КвитированиеБезПлатежа = Ложь;
		
	Иначе
		Элементы.СтраницыОпераций.ТекущаяСтраница = Элементы.СтраницаЗапросов;
		
		Если Объект.ТипЗапрашиваемыхДанных = "REFUND" Тогда
			//запрос возвратов
			//Ничего не нужно	
			
		ИначеЕсли Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
			//квитирование
			
			Объект.ЗапрашиваемыеДанные.Очистить();
			
		ИначеЕсли Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
			//включение или отключение автоматического квитирования
			
			Объект.КвитированиеБезПлатежа = Ложь;
			Объект.ЗапрашиваемыеДанные.Очистить();	
			
		Иначе
			//Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
			//И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
			//И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST"
			//И Объект.ТипЗапрашиваемыхДанных <> "EXCLUDEQUITTANCE"
			//И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTEXCLUDEQUITTANCE" Тогда
			
			//запрос начислений и платежей
			
			Если Элементы.ДанныеСтраницы.ТекущаяСтраница <> Элементы.СтраницаДанныеДляЗапроса Тогда
				Объект.ЗапрашиваемыеДанные.Очистить();
			КонецЕсли;
			
	       	Объект.КвитированиеБезПлатежа = Ложь;
		
		КонецЕсли;
		
	КонецЕсли;
	
	ПриИзмененииВидаОперации();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВидаОперации()
	
	МассивТипов = Новый Массив;
	
	Если Объект.ТипЗапрашиваемыхДанных = "APPEND"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "REPLACE" Тогда
		Элементы.СтраницыОпераций.ТекущаяСтраница = Элементы.СтраницаСертификатаЭП;
	Иначе
		Элементы.СтраницыОпераций.ТекущаяСтраница = Элементы.СтраницаЗапросов;
		
		Если Объект.ТипЗапрашиваемыхДанных = "REFUND" Тогда
			МассивТипов.Добавить(Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМП"));
			Если ЭтоБазаГАН Тогда
				МассивТипов.Добавить(Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМПОтПодведомственного"));
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеИсточник","Заголовок","Возвраты");
			
			Элементы.ДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаДанныеДляЗапроса;
			
			ТекЗаголовок = "Уникальный идентификатор возврата";
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаУчастники","Видимость",Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКБК","Видимость",Истина);
			
		ИначеЕсли Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
			//это квитирование
			
			МассивТиповНачислений = Новый Массив;
			МассивТиповНачислений.Добавить(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
			Если ЭтоБазаГАН Тогда
				МассивТиповНачислений.Добавить(Тип("ДокументСсылка.НачислениеОтПодведомственного"));
			КонецЕсли;
			
			ОписаниеТипаНачисления = Новый ОписаниеТипов(МассивТиповНачислений);
			Элементы.Начисление.ОграничениеТипа = ОписаниеТипаНачисления;
			Элементы.Начисление.ДоступныеТипы = ОписаниеТипаНачисления;
			
			МассивТипов.Добавить(Тип("ДокументСсылка.ПлатежВОплатуГосуслуг"));
			Если ЭтоБазаГАН Тогда
				МассивТипов.Добавить(Тип("ДокументСсылка.ПлатежПодведомственному"));
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеИсточник","Заголовок","Платеж");
			
			Элементы.ДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаНачисление;
			ТекЗаголовок = "Идентификатор платежа";
			
			Если Объект.КвитированиеБезПлатежа Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"СуммаЧастичногоКвитирования","ТолькоПросмотр",(СпособКвитирования = "ВСЯСУММА"));
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаУчастники","Видимость",Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКБК","Видимость",Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКвитирование","Видимость",Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"СпособКвитирования","Видимость",Объект.КвитированиеБезПлатежа);
            ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"СуммаЧастичногоКвитирования","Видимость",Объект.КвитированиеБезПлатежа);
			
			ОбновитьСуммуВыбранныхПлатежей();				
			
		ИначеЕсли Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
			ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
			
			МассивТиповНачислений = Новый Массив;
			МассивТиповНачислений.Добавить(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
			Если ЭтоБазаГАН Тогда
				МассивТиповНачислений.Добавить(Тип("ДокументСсылка.НачислениеОтПодведомственного"));
			КонецЕсли;
			
			ОписаниеТипаНачисления = Новый ОписаниеТипов(МассивТиповНачислений);
			Элементы.Начисление.ОграничениеТипа = ОписаниеТипаНачисления;
			Элементы.Начисление.ДоступныеТипы = ОписаниеТипаНачисления;
			
			МассивТипов.Добавить(Тип("ДокументСсылка.ПлатежВОплатуГосуслуг"));
			Если ЭтоБазаГАН Тогда
				МассивТипов.Добавить(Тип("ДокументСсылка.ПлатежПодведомственному"));
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеИсточник","Заголовок","Платеж");
			Элементы.ДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаНачисление;
			ТекЗаголовок = "Идентификатор платежа";
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаУчастники","Видимость",Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКБК","Видимость",Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКвитирование","Видимость",Ложь);
			
			ОбновитьСуммуВыбранныхПлатежей();
			
		ИначеЕсли Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
			И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
			И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
			
			МассивТипов.Добавить(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
			Если ЭтоБазаГАН Тогда
				МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеОтПодведомственного"));
			КонецЕсли;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеИсточник","Заголовок","Начисление");
			Элементы.ДанныеСтраницы.ТекущаяСтраница = Элементы.СтраницаДанныеДляЗапроса;
			
			Если Объект.ТипИдентификатораДанных = "УИН" Тогда
				ТекЗаголовок = "Уникальный идентификатор начисления";
			ИначеЕсли Объект.ТипИдентификатораДанных = "УИП" Тогда
				ТекЗаголовок = "Идентификатор плательщика";
			ИначеЕсли Объект.ТипИдентификатораДанных = "БИП" Тогда
				ТекЗаголовок = "Идентификатор платежа";
			ИначеЕсли Объект.ТипИдентификатораДанных = "ИНН" Тогда
				ТекЗаголовок = "ИНН юр. лица";
			ИначеЕсли Объект.ТипИдентификатораДанных = "УИЗ" Тогда
				ТекЗаголовок = "Идентификатор заявки";
			Иначе
				ТекЗаголовок = "Запрашиваемые идентификаторы";
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаУчастники","Видимость",Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ГруппаКБК","Видимость",Истина);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗапрашиваемыеДанныеУИД","Заголовок",ТекЗаголовок);
				 
		ОписаниеТипа = Новый ОписаниеТипов(МассивТипов);
		Элементы.ЗапрашиваемыеДанныеИсточник.ОграничениеТипа = ОписаниеТипа;
		Элементы.ЗапрашиваемыеДанныеИсточник.ДоступныеТипы = ОписаниеТипа;
	КонецЕсли;
	
