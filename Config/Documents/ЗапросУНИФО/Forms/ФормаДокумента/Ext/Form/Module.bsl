&НаКлиенте
Процедура ЗапрашиваемыеДанныеИсточникНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	Если Объект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTRECONCILE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EMU_DOACKNOWLEDGMENTREQUEST"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "EXCLUDEQUITTANCE"
		ИЛИ Объект.ТипЗапрашиваемыхДанных = "ANNULMENTEXCLUDEQUITTANCE" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
		ПараметрыФормы.Вставить("Начисление",Объект.Начисление);
		Если ТипЗнч(Объект.Начисление) = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
		   	ИмяДок = "ПлатежВОплатуГосуслуг";
		Иначе
			ИмяДок = "ПлатежПодведомственному";
		КонецЕсли;
		ОткрытьФорму("Документ."+ИмяДок+".ФормаВыбора",ПараметрыФормы,Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапрашиваемыеДанныеИсточникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
		Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
			И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
			И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
		    СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
			ПараметрыФормы.Вставить("ИдентификаторОбъекта",Объект.ТипИдентификатораДанных);
			ОткрытьФорму("Документ.КвитанцияНаОплатуГосуслуг.ФормаВыбора",ПараметрыФормы,Элемент);			
		КонецЕсли;
	ИначеЕсли ВыбранноеЗначение = Тип("ДокументСсылка.НачислениеОтПодведомственного") Тогда
		Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
			И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
			И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST" Тогда
		    СтандартнаяОбработка = Ложь;
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Отбор",Новый Структура("Организация",Объект.Организация));
			ПараметрыФормы.Вставить("ИдентификаторОбъекта",Объект.ТипИдентификатораДанных);
			ОткрытьФорму("Документ.НачислениеОтПодведомственного.ФормаВыбора",ПараметрыФормы,Элемент);			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапрашиваемыеДанныеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Объект.ТипЗапрашиваемыхДанных <> "DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTRECONCILE"
		И Объект.ТипЗапрашиваемыхДанных <> "EMU_DOACKNOWLEDGMENTREQUEST"
		И Объект.ТипЗапрашиваемыхДанных <> "EXCLUDEQUITTANCE"
		И Объект.ТипЗапрашиваемыхДанных <> "ANNULMENTEXCLUDEQUITTANCE"
		И НЕ ЗначениеЗаполнено(Объект.ТипИдентификатораДанных) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указаны данные для запроса!");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

