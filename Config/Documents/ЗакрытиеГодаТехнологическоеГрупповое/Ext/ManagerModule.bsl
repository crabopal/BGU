#Область ПрограммныйИнтерфейс

Процедура ОчиститьДвиженияВТЧ(ОбъектСсылка, ПометкаУдаления = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗакрытиеГодаТехнологическоеГрупповоеДокументы.ДокСсылка КАК ДокСсылка
	|ИЗ
	|	Документ.ЗакрытиеГодаТехнологическоеГрупповое.СписокДокументов КАК ЗакрытиеГодаТехнологическоеГрупповоеДокументы
	|ГДЕ
	|	ЗакрытиеГодаТехнологическоеГрупповоеДокументы.Ссылка = &Ссылка
	|	И ЗакрытиеГодаТехнологическоеГрупповоеДокументы.ДокСсылка.Проведен";
	
	Запрос.УстановитьПараметр("Ссылка",ОбъектСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.ДокСсылка.ПолучитьОбъект();
		ДокОбъект.ПометкаУдаления = ПометкаУдаления;
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗапросПоОборотнымКЭК(ДокументОбъект, НеУчитываемыеСчета) Экспорт
	
	КЭК000 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВсеСчета", 		ПланыСчетов.ЕПСБУ.СчетаСОборотнымКЭК());
	Запрос.УстановитьПараметр("БезСчетов", 		НеУчитываемыеСчета);
	Запрос.УстановитьПараметр("Период", 		Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(ДокументОбъект.ФинансовыйГод), 5), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация",	ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("КЭК000",			КЭК000);
	//Запрос.УстановитьПараметр("Счет000",		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.Вспомогательный"));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.КОСГУДт,
	|	ЕПСБУ.КОСГУКт,
	|	ЕПСБУ.Вид,
	|	ЕПСБУВидыСубконто1.ВидСубконто КАК ВидСубконто1,
	|	ЕПСБУВидыСубконто2.ВидСубконто КАК ВидСубконто2,
	|	ЕПСБУВидыСубконто3.ВидСубконто КАК ВидСубконто3
	|ПОМЕСТИТЬ ВсеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто1.Ссылка
	|			И (ЕПСБУВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто2.Ссылка
	|			И (ЕПСБУВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто3.Ссылка
	|			И (ЕПСБУВидыСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&ВсеСчета) 
	|	И НЕ ЕПСБУ.Ссылка В(&БезСчетов) 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0) <> 0
	|				ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт, 0) <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВсеСчета.Ссылка
	|				ИЗ
	|					ВсеСчета),
	|			,
	|			Организация = &Организация
	|				И (НЕ КЭК = &КЭК000) ) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Счет.Код КАК СчетКод,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.Валюта,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА -Остатки.СуммаОстатокКт
	|			ИНАЧЕ Остатки.СуммаОстатокДт
	|		КОНЕЦ) КАК СуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.СуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.СуммаОстатокДт < 0
	|				ТОГДА -Остатки.СуммаОстатокДт
	|			ИНАЧЕ Остатки.СуммаОстатокКт
	|		КОНЕЦ) КАК СуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.ВалютнаяСуммаОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.ВалютнаяСуммаОстатокДт < 0
	|				ТОГДА -Остатки.ВалютнаяСуммаОстатокДт
	|			ИНАЧЕ Остатки.ВалютнаяСуммаОстатокКт
	|		КОНЕЦ) КАК ВалютнаяСуммаОстатокКт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА -Остатки.КоличествоОстатокКт
	|			ИНАЧЕ Остатки.КоличествоОстатокДт
	|		КОНЕЦ) КАК КоличествоОстатокДт,
	|	СУММА(ВЫБОР
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|					И Остатки.КоличествоОстатокКт < 0
	|				ТОГДА 0
	|			КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|					И Остатки.КоличествоОстатокДт < 0
	|				ТОГДА -Остатки.КоличествоОстатокДт
	|			ИНАЧЕ Остатки.КоличествоОстатокКт
	|		КОНЕЦ) КАК КоличествоОстатокКт,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.СуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.СуммаОстатокКт < 0
	|						ТОГДА -Остатки.СуммаОстатокКт
	|					ИНАЧЕ Остатки.СуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.ВалютнаяСуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.ВалютнаяСуммаОстатокКт < 0
	|						ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|					ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.КоличествоОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.КоличествоОстатокКт < 0
	|						ТОГДА -Остатки.КоличествоОстатокКт
	|					ИНАЧЕ Остатки.КоличествоОстатокДт
	|				КОНЕЦ <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ДтКт,
	|	Остатки.ИФО,
	|	Остатки.Подразделение
	|ИЗ
	|	Остатки КАК Остатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВсеСчета КАК ВсеСчета
	|		ПО Остатки.Счет = ВсеСчета.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.Счет.Код,
	|	Остатки.КФО,
	|	Остатки.КПС,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.КЭК,
	|	Остатки.Валюта,
	|	Остатки.ИФО,
	|	Остатки.Подразделение,
	|	ВЫБОР
	|		КОГДА ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.СуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.СуммаОстатокКт < 0
	|						ТОГДА -Остатки.СуммаОстатокКт
	|					ИНАЧЕ Остатки.СуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.ВалютнаяСуммаОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.ВалютнаяСуммаОстатокКт < 0
	|						ТОГДА -Остатки.ВалютнаяСуммаОстатокКт
	|					ИНАЧЕ Остатки.ВалютнаяСуммаОстатокДт
	|				КОНЕЦ <> 0
	|				ИЛИ ВЫБОР
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|							И Остатки.КоличествоОстатокДт < 0
	|						ТОГДА 0
	|					КОГДА ВсеСчета.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|							И Остатки.КоличествоОстатокКт < 0
	|						ТОГДА -Остатки.КоличествоОстатокКт
	|					ИНАЧЕ Остатки.КоличествоОстатокДт
	|				КОНЕЦ <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетКод,
	|	КЭК";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ВыполнитьПроведениеВФоне(Знач СтруктураПараметров) Экспорт
	ДокументОбъект = ОбщегоНазначенияБГУ.ДесериализоватьОбъектИзДвоичныхДанных(СтруктураПараметров.ДанныеДокумента); 
	Если ТипЗнч(СтруктураПараметров.ДополнительныеСвойства) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из СтруктураПараметров.ДополнительныеСвойства Цикл
			ДокументОбъект.ДополнительныеСвойства.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);  
		КонецЦикла; 
	КонецЕсли;	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение); 
	Возврат ОбщегоНазначенияБГУ.СериализоватьОбъектВДвоичныеДанные(ДокументОбъект);
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьПроведениеВФоне", Истина);
КонецПроцедуры

#КонецОбласти

#КонецОбласти

