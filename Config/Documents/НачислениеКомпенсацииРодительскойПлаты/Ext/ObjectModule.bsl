#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = Начисления.Итог("СуммаКомпенсации");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.КомпенсацияРодительскойПлаты") Тогда
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоКомпенсацииРодительскойПлаты(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка);
	Иначе
		ЗаполнитьИзДанныхЗаполнения(Новый Структура, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.НачислениеКомпенсацииРодительскойПлаты.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Движения по регистрам сведений
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "УчетКомпенсацииРодительскойПлаты");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Для Каждого Строка Из Начисления Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ПроцентКомпенсации)
			И Не Строка.НастройкаКомпенсации.РасчетКомпенсацииНеЗависитОтБазы Тогда
				
			ОбщегоНазначения.СообщитьПользователю(
				ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , НСтр("ru = 'Процент компенсации'"), Строка.НомерСтроки, НСтр("ru = 'Начисления'")),
				 , 
				 ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Начисления", Строка.НомерСтроки, "ПроцентКомпенсации"), "Объект", Отказ);
				
		КонецЕсли;
		
	КонецЦикла;
	
	НеПроверяемыеРеквизиты = Новый Массив;
	НеПроверяемыеРеквизиты.Добавить("Начисления.ПроцентКомпенсации");
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоКомпенсацииРодительскойПлаты(Документ)
	
	ДанныеЗаполнения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Дата, Организация, НачалоПериода,"
		+ "КонецПериода, ИФО, Подразделение, ГруппаДетскогоУчреждения, РасчетЗаНесколькоМесяцев, НаправлениеДеятельности");
	
	// Реквизиты шапки
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	ДетскоеУчреждение = Организация;
	ДокументОснование = Документ;
	
	ОрганизацияДляНачисленияРП = Константы.ОрганизацияДляУчетаКомпенсацииРодительскойПлаты.Получить();
	Если ЗначениеЗаполнено(ОрганизацияДляНачисленияРП) Тогда
	
		Организация = ОрганизацияДляНачисленияРП;
	
	КонецЕсли;
	
	// Табличная часть
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыОтраженияКомпенсацииРодительскойПлатыСрезПоследних.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	ПараметрыОтраженияКомпенсацииРодительскойПлатыСрезПоследних.КПС КАК КПС,
	|	ПараметрыОтраженияКомпенсацииРодительскойПлатыСрезПоследних.КФО КАК КФО
	|ПОМЕСТИТЬ НастройкиОтраженияВУчетеКомпенсации
	|ИЗ
	|	РегистрСведений.ПараметрыОтраженияКомпенсацииРодительскойПлаты.СрезПоследних(&КонецПериода, ) КАК ПараметрыОтраженияКомпенсацииРодительскойПлатыСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НастройкиРасчетовПоРодительскойПлате.Ссылка КАК Ссылка,
	|	НастройкиОтраженияВУчетеКомпенсации.КПС КАК КПС,
	|	НастройкиОтраженияВУчетеКомпенсации.КФО КАК КФО
	|ПОМЕСТИТЬ НастройкиКомпенсации
	|ИЗ
	|	Справочник.НастройкиРасчетовПоРодительскойПлате КАК НастройкиРасчетовПоРодительскойПлате
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиОтраженияВУчетеКомпенсации КАК НастройкиОтраженияВУчетеКомпенсации
	|		ПО НастройкиРасчетовПоРодительскойПлате.Ссылка = НастройкиОтраженияВУчетеКомпенсации.НастройкаКомпенсации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДДУ.Ребенок КАК Ребенок,
	|	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУ.Договор КАК Договор,
	|	СоставГруппДДУ.Период КАК Период
	|ПОМЕСТИТЬ СоставГруппЗаПериодВсеДоговоры
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
	|ГДЕ
	|	СоставГруппДДУ.Период >= &НачалоПериода
	|	И СоставГруппДДУ.Период <= &КонецПериода
	|	И СоставГруппДДУ.Актуальность = ИСТИНА
	|	И СоставГруппДДУ.Ребенок В
	|			(ВЫБРАТЬ
	|				КомпенсацияРодительскойПлатыДети.Ребенок КАК Ребенок
	|			ИЗ
	|				Документ.КомпенсацияРодительскойПлаты.Дети КАК КомпенсацияРодительскойПлатыДети
	|			ГДЕ
	|				КомпенсацияРодительскойПлатыДети.Ссылка = &ДокументОснование)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.Ребенок,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Договор,
	|	СоставГруппДДУСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(
	|			&НачалоПериода,
	|			Ребенок В
	|				(ВЫБРАТЬ
	|					КомпенсацияРодительскойПлатыДети.Ребенок КАК Ребенок
	|				ИЗ
	|					Документ.КомпенсацияРодительскойПлаты.Дети КАК КомпенсацияРодительскойПлатыДети
	|				ГДЕ
	|					КомпенсацияРодительскойПлатыДети.Ссылка = &ДокументОснование)) КАК СоставГруппДДУСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоставГруппЗаПериодВсеДоговоры.Ребенок КАК Ребенок,
	|	СоставГруппЗаПериодВсеДоговоры.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппЗаПериодВсеДоговоры.Договор КАК Договор
	|ПОМЕСТИТЬ СоставГрупп
	|ИЗ
	|	СоставГруппЗаПериодВсеДоговоры КАК СоставГруппЗаПериодВсеДоговоры
	|ГДЕ
	|	ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				(ВЫБРАТЬ
	|					СоставГруппВложенный.Ребенок КАК Ребенок,
	|					СоставГруппВложенный.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|					МАКСИМУМ(СоставГруппВложенный.Период) КАК Период
	|				ИЗ
	|					СоставГруппЗаПериодВсеДоговоры КАК СоставГруппВложенный
	|				СГРУППИРОВАТЬ ПО
	|					СоставГруппВложенный.Ребенок,
	|					СоставГруппВложенный.ГруппаДетскогоУчреждения) КАК ПоследнееИзменениеПоГруппе
	|			ГДЕ
	|				СоставГруппЗаПериодВсеДоговоры.Ребенок = ПоследнееИзменениеПоГруппе.Ребенок
	|				И СоставГруппЗаПериодВсеДоговоры.ГруппаДетскогоУчреждения = ПоследнееИзменениеПоГруппе.ГруппаДетскогоУчреждения
	|				И СоставГруппЗаПериодВсеДоговоры.Период = ПоследнееИзменениеПоГруппе.Период)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетКомпенсации.Организация КАК ДетскоеУчреждение,
	|	РасчетКомпенсации.Ребенок КАК Ребенок,
	|	РасчетКомпенсации.Ребенок.Контрагент КАК Контрагент,
	|	РасчетКомпенсации.СуммаКомпенсации КАК СуммаКомпенсации,
	|	РасчетКомпенсации.Плательщик КАК Плательщик,
	|	РасчетКомпенсации.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	РасчетКомпенсации.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	СоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГрупп.Договор КАК Договор,
	|	НастройкиКомпенсации.КПС КАК КПС,
	|	НастройкиКомпенсации.КФО КАК КФО
	|ИЗ
	|	РегистрСведений.ЖурналУчетаКомпенсацииРодительскойПлаты КАК РасчетКомпенсации
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоставГрупп КАК СоставГрупп
	|		ПО РасчетКомпенсации.Ребенок = СоставГрупп.Ребенок
	|			И РасчетКомпенсации.ГруппаДетскогоУчреждения = СоставГрупп.ГруппаДетскогоУчреждения
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиКомпенсации КАК НастройкиКомпенсации
	|		ПО РасчетКомпенсации.НастройкаКомпенсации = НастройкиКомпенсации.Ссылка
	|ГДЕ
	|	РасчетКомпенсации.Регистратор = &ДокументОснование";
	
	Запрос.УстановитьПараметр("ДокументОснование",    Документ);
	Запрос.УстановитьПараметр("НачалоПериода",        НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",         КонецПериода);
	Запрос.УстановитьПараметр("НастройкаПоУмолчанию", РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Начисления.Загрузить(Результат);
	
КонецПроцедуры

Процедура ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Дата", ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	НачалоПериода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "НачалоПериода", НачалоМесяца(Дата));
	КонецПериода  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "КонецПериода",  КонецМесяца(Дата));
	
	РасчетЗаНесколькоМесяцев = НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода);

КонецПроцедуры

#КонецОбласти

#КонецЕсли
