&НаКлиенте
Процедура НачисленияПриИзменении(Элемент)
	Если Элементы.Начисления.ТекущиеДанные = Неопределено Тогда
		УстановитьПредупреждение(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияРебенокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ?(ЗначениеЗаполнено(Объект.ДетскоеУчреждение), Объект.ДетскоеУчреждение, Объект.Организация));
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения", Объект.ГруппаДетскогоУчреждения);
	ПараметрыФормы.Вставить("НаДату", НачалоДня(Объект.НачалоПериода));
	
	ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура НачисленияРебенокПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Начисления.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущиеДанные.Ребенок) Тогда
		ЗаполнитьДанныеСтроки(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачисленияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	
	Если Копирование Тогда
		ТекущаяСтрока.Ребенок = Неопределено;
		ТекущаяСтрока.Договор = Неопределено;
		ТекущаяСтрока.Контрагент = Неопределено;
		ТекущаяСтрока.Плательщик = Неопределено;
		ТекущаяСтрока.ПроцентКомпенсации = 0;
		ТекущаяСтрока.СуммаКомпенсации = 0;
	КонецЕсли;
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущаяСтрока.ДетскоеУчреждение = Объект.ДетскоеУчреждение;
		ТекущаяСтрока.ГруппаДетскогоУчреждения = Объект.ГруппаДетскогоУчреждения;
	КонецЕсли;
КонецПроцедуры

