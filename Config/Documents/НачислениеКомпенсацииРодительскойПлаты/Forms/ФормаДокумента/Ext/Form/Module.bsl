&НаСервере
Процедура ЗаполнитьНаСервере()

	ПараметрыРасчета = Документы.НачислениеКомпенсацииРодительскойПлаты.ПараметрыРасчета(Объект);
	ПараметрыРасчета.ДетскоеУчреждение        = Объект.ДетскоеУчреждение;
	ПараметрыРасчета.ГруппаДетскогоУчреждения = Объект.ГруппаДетскогоУчреждения;
	ПараметрыРасчета.НаправлениеДеятельности  = Объект.НаправлениеДеятельности;
	
	ТаблицаКомпенсации = Документы.НачислениеКомпенсацииРодительскойПлаты.РассчитатьНачислениеКомпенсации(ПараметрыРасчета);
	Объект.Начисления.Загрузить(ТаблицаКомпенсации);
	УстановитьПредупреждение(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтроки(ИдентификаторСтроки)
	ТекущиеДанные = Объект.Начисления.НайтиПоИдентификатору(ИдентификаторСтроки);

	ПараметрыРасчета = Документы.НачислениеКомпенсацииРодительскойПлаты.ПараметрыРасчета(Объект);
	ПараметрыРасчета.ДетскоеУчреждение        = ТекущиеДанные.ДетскоеУчреждение;
	ПараметрыРасчета.ГруппаДетскогоУчреждения = ТекущиеДанные.ГруппаДетскогоУчреждения;
	ПараметрыРасчета.Ребенок                  = ТекущиеДанные.Ребенок;
	ПараметрыРасчета.НаправлениеДеятельности  = Объект.НаправлениеДеятельности;
	ПараметрыРасчета.НастройкаРасчета         = ТекущиеДанные.НастройкаКомпенсации;

	ДанныеЗаполнения = Документы.НачислениеКомпенсацииРодительскойПлаты.РассчитатьНачислениеКомпенсации(ПараметрыРасчета);
	Если ДанныеЗаполнения.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеЗаполнения[0]);
	Иначе
		ТекущиеДанные.КПС = Неопределено;
		ТекущиеДанные.КФО = Неопределено;
		ТекущиеДанные.ПроцентКомпенсации = 0;
		ТекущиеДанные.СуммаКомпенсации = 0;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСвязи()
	Если ЗначениеЗаполнено(Объект.ДетскоеУчреждение) Тогда
		Связь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.ДетскоеУчреждение");
	Иначе
		Связь = Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Организация");
	КонецЕсли;
	МассивСвязей = Новый Массив;
	МассивСвязей.Добавить(Связь);
	
	Элементы.ГруппаДетскогоУчреждения.СвязиПараметровВыбора = Новый ФиксированныйМассив(МассивСвязей);
КонецПроцедуры

