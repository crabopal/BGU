		Оповещение = Новый ОписаниеОповещения("ВопросОбОчисткеТабличнойЧасти", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='При заполнении таблица расчета начислений будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьНаСервере();
	КонецЕсли;
