КонецПроцедуры
#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ВыбратьИЗаполнитьПоДокументуИнвентаризацииКассы(Команда)
	
	ТекстСообщения = НСтр("ru='Редактируемый документ будет перезаполнен по документу-основанию ""Инвентаризация кассы"".
		|
		|Продолжить и выбрать документ-основание?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВыбратьИЗаполнитьПоДокументуИнвентаризацииКассы_Выбор", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ВыбратьИЗаполнитьПоДокументуИнвентаризацииКассы_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Открываем форму выбора документа-основания:
		Отбор = Новый Структура("МОЛ, Организация",
			Объект["МОЛ"],
			Объект["Организация"]);
		ПараметрыФормы = Новый Структура("Отбор, ТекущаяСтрока",
			Отбор,
			Объект["ДокументОснование"]);
		ОткрытьФорму("Документ.ИнвентаризацияКассы.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДокументуИнвентаризацииКассы(Команда)
	
	Если ЗначениеЗаполнено(Объект["ДокументОснование"]) Тогда
		
		ПроверитьИЗаполнитьПоДокументуИнвентаризацииКассы();
		
	Иначе
		ТекстСообщения = НСтр("ru='Укажите документ-основание ""Инвентаризация кассы""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.ДокументОснование");
	КонецЕсли;
	
КонецПроцедуры

// Страница "Комиссия":
	
&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["ДатаНачала"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["ДатаОкончания"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
	
КонецПроцедуры
&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["ДатаНачала"]	= РезультатВыбора["НачалоПериода"];
		Объект["ДатаОкончания"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКомиссию(Команда)
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", Объект.Организация));
		ОткрытьФорму("Справочник.ПостоянноДействующиеКомиссии.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ТекстСообщения = НСтр("ru='Сначала необходимо выбрать организацию'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ВыбратьПредседателяКомиссии(Команда)
	
	УправлениеОсновнымиСредствамиКлиент.ОткрытьВыборПредседателяКомиссии(ЭтаФорма, Объект.Организация, Объект.Дата);
	
КонецПроцедуры
&НаКлиенте
