&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
    // СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
    УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
    //Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

&НаСервере
Процедура ОбновитьКэшФормы()
	
	МОЛ_Контрагент = ПолучитьКонтрагента(Объект["МОЛ"]);
	ПоследнийПКО_Номер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект["ПоследнийПКО"], "Номер");
	ПоследнийРКО_Номер = ?(ЗначениеЗаполнено(Объект["ПоследнийРКО"]),	// доп.проверка для реквизита составного типа.
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект["ПоследнийРКО"], "Номер"),
		"");
	ПоследнийПОФ_Номер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект["ПоследнийПОФ"], "Номер");
	ПоследнийРОФ_Номер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект["ПоследнийРОФ"], "Номер");
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	НовДоступностьКомиссия			= ЗначениеЗаполнено(Объект.Организация);
	
	// Инвентаризационная комиссия:
	Элементы["СтраницаИнвентаризация"].ТолькоПросмотр			= НЕ НовДоступностьКомиссия;
	Элементы["УстановитьПериод"].Доступность					= НовДоступностьКомиссия;
	Элементы["КомандаВыбратьКомиссию"].Доступность				= НовДоступностьКомиссия;
	Элементы["ВыбратьПредседателяКомиссии"].Доступность			= НовДоступностьКомиссия;
	Элементы["СоставКомиссииПодобратьСотрудников"].Доступность	= НовДоступностьКомиссия;
	
	НастроитьФормуКлиент_ПриИзмененииУчитыватьФК();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_ПриИзмененииУчитыватьФК()
	
	НовДоступность = Объект["УчитыватьФК"];
	
	Элементы["ГруппаНомераДокументовДД"].Доступность = НовДоступность;
	
	ДополнительныйЗаголовокПоследнихДенежныхДокументов = ?(НовДоступность,
		"",
		НСтр("ru='фондовая касса не учитывается'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ТекстСообщения = НСтр("ru='Изменение организации вызовет полную очистку
		|табличной части документа и некоторых полей шапки.
		|
		|Продолжить и сменить организацию?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОчиститьРеквизитыНесоответствующиеОрганизацииКлиент();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОчиститьРеквизитыНесоответствующиеОрганизацииКлиент()
	
	// Сначала очищаем все, кроме комиссии:
	ОчиститьРеквизитыКромеКомиссии();
	
	// Дополнительно очищаем сведения об инв.комиссии и о проводимой инв.:
	Объект["СоставКомиссии"].Очистить();
	ОчищающаяСтруктура = Новый Структура("
		|ДолжностьПредседателяКомиссии,
		|ФамилияПредседателяКомиссии,
		|ИмяПредседателяКомиссии,
		|ОтчествоПредседателяКомиссии,
		|НомерПриказаИнвентаризации,
		|ДатаПриказаИнвентаризации,
		|НомерПриказаКомиссии,
		|ДатаПриказаКомиссии,
		|МестоИнвентаризации,
		|ПричинаИнвентаризации");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
КонецПроцедуры
&НаКлиенте
Процедура ОчиститьРеквизитыКромеКомиссии()
	
	// Очищаем данные:
	Объект["ЦенностиФакт"].Очистить();
	Объект["ИтогоУчет"] = Неопределено;
		
	// Реквизиты документа:
	ОчищающаяСтруктура = Новый Структура("
		|ПоследнийРКО,
		|ПоследнийРКОНомер,
		|ПоследнийПКО,
		|ПоследнийПКОНомер,
		|ПоследнийРОФ,
		|ПоследнийРОФНомер,
		|ПоследнийПОФ,
		|ПоследнийПОФНомер");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
		
	// Реквизиты формы:
	ОчищающаяСтруктура = Новый Структура("
		|ПоследнийПКО_Номер,
		|ПоследнийПОФ_Номер,
		|ПоследнийРКО_Номер,
		|ПоследнийРОФ_Номер,
		|СуммаИзлишек,
		|СуммаНедостача");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти(ТекстЧтоИзменилось)
	
	Если Объект["ЦенностиФакт"].Количество() > 0 Тогда
		ТекстСообщения = ТекстЧтоИзменилось
			+ НСтр("ru='рекомендуется очистить табличную часть ""Фактическое наличие ценностей"".
				|
				|Если эта табличная часть заполнялась по данным учета, то сведения в ней могут уже не соответствовать данным учета.
				|
				|Продолжить и очистить?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 40, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Очищаем все сведения, кроме инв.комиссии и сведений о проводимой инв.:
		ОчиститьРеквизитыКромеКомиссии();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВычислитьНедостачуИИзлишек(ИтогоФакт, ИтогоУчет)
	
	Разница = ИтогоФакт - ИтогоУчет;
	
	Недостача	= ?(Разница < 0, -Разница, 0);
	Излишек		= ?(Разница > 0, Разница, 0);
	
	Возврат Новый Структура("СуммаНедостача, СуммаИзлишек",
		Недостача,
		Излишек);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКонтрагента(МОЛСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МОЛСсылка, "Контрагент");
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерДокумента(ДокСсылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокСсылка, "Номер");
		
КонецФункции

//---
// Редактирование номеров последних кассовых документов

&НаКлиенте
Функция НомерКассовогоДокумента_ПолучитьИменаСвязанныхЭлементов(ИмяЭлемента)
	
	ИмяРеквизитаДокСсылка	= СтрЗаменить(ИмяЭлемента, "Номер", "");
	ИмяРеквизитаКэшНомер	= СтрЗаменить(ИмяЭлемента, "Номер", "_Номер");
	ИмяРеквизитаНомер		= ИмяЭлемента;
	
	Возврат Новый Структура("ДокСсылка, КэшНомер, Номер",
		ИмяРеквизитаДокСсылка,
		ИмяРеквизитаКэшНомер,
		ИмяРеквизитаНомер);
	
КонецФункции
&НаКлиенте
Процедура НомерКассовогоДокумента_ПриИзменении(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	// Имена связанных реквизитов:
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаСвязанныхЭлементов(ИмяЭлемента);
	ИмяРеквизитаДокСсылка	= ИменаРеквизитов["ДокСсылка"];
	ИмяРеквизитаКэшНомер	= ИменаРеквизитов["КэшНомер"];
	ИмяРеквизитаНомер		= ИменаРеквизитов["Номер"];
	
	// Очищаем ссылку на документ:
	ОчиститьСсылку = ПустаяСтрока(Объект[ИмяРеквизитаНомер])
		ИЛИ НЕ НомерКассовогоДокумента_НомераОдинаковые(ЭтаФорма[ИмяРеквизитаКэшНомер], Объект[ИмяРеквизитаНомер]);
	Если ОчиститьСсылку Тогда
		Объект[ИмяРеквизитаДокСсылка]	= Неопределено;
		ЭтаФорма[ИмяРеквизитаКэшНомер]	= Неопределено;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НомерКассовогоДокумента_ПриНачалеВыбора(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	// Имена связанных реквизитов:
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаСвязанныхЭлементов(ИмяЭлемента);
	ИмяРеквизитаДокСсылка	= ИменаРеквизитов["ДокСсылка"];
	ИмяРеквизитаКэшНомер	= ИменаРеквизитов["КэшНомер"];
	КассовыйДокументСсылка	= Объект[ИмяРеквизитаДокСсылка];
	
	ИмяОткрываемойФормы = ИменаФормДокументов.Получить(ИмяЭлемента);
	
	Если ТипЗнч(ИмяОткрываемойФормы) = Тип("СписокЗначений") Тогда
		ЗаголовокДиалога = НСтр("ru='Выбор типа данных'");
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("КассовыйДокументСсылка",	КассовыйДокументСсылка);
		ПараметрыОповещения.Вставить("Элемент",					Элемент);
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НомерКассовогоДокумента_ПриНачалеВыбора_Выбор", ЭтотОбъект, ПараметрыОповещения);
		ИмяОткрываемойФормы.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗавершении, ЗаголовокДиалога);
	Иначе
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НомерКассовогоДокумента_ПриНачалеВыбора_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда
		ИмяОткрываемойФормы = РезультатВыбора.Значение;
		
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, ПараметрыОповещения["КассовыйДокументСсылка"], ПараметрыОповещения["Элемент"]);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент)
	
	ПериодДляСписка = Новый СтандартныйПериод();
	ПериодДляСписка.ДатаОкончания = Объект["Дата"];
	
	Отбор = Новый Структура("Организация, Контрагент",
		Объект["Организация"],
		МОЛ_Контрагент);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор",			Отбор);
	ПараметрыФормы.Вставить("ТекущаяСтрока",	КассовыйДокументСсылка);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент);
	
КонецПроцедуры
&НаКлиенте
Процедура НомерКассовогоДокумента_ОбработкаВыбора(Элемент, ВыбранноеЗначение)
	
	ИмяЭлемента = Элемент.Имя;
	
	// Имена связанных реквизитов:
	ИменаРеквизитов			= НомерКассовогоДокумента_ПолучитьИменаСвязанныхЭлементов(ИмяЭлемента);
	ИмяРеквизитаДокСсылка	= ИменаРеквизитов["ДокСсылка"];
	ИмяРеквизитаКэшНомер	= ИменаРеквизитов["КэшНомер"];
	
	// Запоминаем выбранный документ:
	Объект[ИмяРеквизитаДокСсылка] = ВыбранноеЗначение;
	
	// Получаем номер документа для печати:
	НомерДокумента = ПолучитьНомерДокумента(ВыбранноеЗначение);
	ВыбранноеЗначение = ПолучитьНомерНаПечать(НомерДокумента);
	
	// Кэшируем номер выбранного документа:
	ЭтаФорма[ИмяРеквизитаКэшНомер] = НомерДокумента;
	
КонецПроцедуры
&НаКлиентеНаСервереБезКонтекста
Функция НомерКассовогоДокумента_НомераОдинаковые(Знач НомерДокумента, Знач НомерУказанныйВручную)
	
	Результат = Ложь;
	
	НомерДокумента = СокрЛП(НомерДокумента);
	НомерУказанныйВручную = СокрЛП(НомерУказанныйВручную);
	
	Если НомерДокумента = НомерУказанныйВручную Тогда
		Результат = Истина;
		
	Иначе
		// Почти одинаковые, если <НомерУказанныйВручную>=[0\s]*<НомерНаПечать(НомерДокумента)>
		
		НомерНаПечать = ПолучитьНомерНаПечать(НомерДокумента);
		
		ПозицияОкончания = Найти(НомерУказанныйВручную, НомерНаПечать);
		ОкончаниеСовпадает = (ПозицияОкончания > 0
			И ПозицияОкончания = СтрДлина(НомерУказанныйВручную) - СтрДлина(НомерНаПечать) + 1);
		
		Если ОкончаниеСовпадает Тогда
			ЛеваяЧасть = Лев(НомерУказанныйВручную, ПозицияОкончания - 1);
			ЛеваяЧасть = СтрЗаменить(ЛеваяЧасть, "0", "");
			ЛеваяЧасть = СтрЗаменить(ЛеваяЧасть, " ", "");
			Если ЛеваяЧасть = "" Тогда
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНомерНаПечать(НомерДокумента)
	Возврат ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерДокумента)
КонецФункции

