// Заполнение документа

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДокументуИнвентаризацииКассы()
	
	ТекстСообщения = НСтр("ru='Редактируемый документ будет перезаполнен по выбранному документу-основанию.
		|
		|Продолжить и перезаполнить?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДокументуИнвентаризацииКассы_Экспорт", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДокументуИнвентаризацииКассы_Экспорт(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДокументуИнвентаризацииКассыСервер();
	КонецЕсли;
	
КонецПроцедуры


// Заполнение по документу "Инвентаризация кассы".
&НаСервере
Процедура ЗаполнитьПоДокументуИнвентаризацииКассыСервер()
	
	Документы.ИнвентаризацияКассы.ЗаполнитьДокумент_АктИнвентаризацияНаличныхДС(
		Объект,
		Объект["ДокументОснование"]);
		
	// Результаты инвентаризации:
	Расхождения = ВычислитьНедостачуИИзлишек(
		Объект["ЦенностиФакт"].Итог("Сумма"),
		Объект["ИтогоУчет"]);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Расхождения);
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

