&НаКлиенте
Процедура ЦенностиФактПриИзменении(Элемент)
	
	// Результаты инвентаризации:
	Расхождения = ВычислитьНедостачуИИзлишек(
		Объект["ЦенностиФакт"].Итог("Сумма"),
		Объект["ИтогоУчет"]);
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Расхождения);

КонецПроцедуры
&НаКлиенте
Процедура ЦенностиФактПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Объект["ЦенностиФакт"].Количество() >= МаксимальноеКоличествоСтрокТаблицыЦенностей Тогда
		Отказ = Истина;
		
		// Категории для русского языка:
		//	Ноль	(-);
		//	Один	(1 шт);
		//	Два		(-);
		//	Немного	(2 шт);
		//	Много	(5 шт);
		//	Другое	(-)
		НадписьКоличество = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 показателя;;%1 показателей;%1 показателей;'"),
			МаксимальноеКоличествоСтрокТаблицыЦенностей);
		
		Текст = НСтр("ru='Печатной формой предусмотрено не более %1.
			|Добавление новой строки отменено (в таблице ""Фактическое наличие ценностей"").'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НадписьКоличество);
		
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставКомиссии
