#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ЗаявлениеОбОтказеОтАкцепта";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ЗаявлениеОбОтказеОтАкцепта";
	КомандаПечати.Представление		= НСтр("ru = 'Заявление об акцепте, отказе от акцепта'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Устанавливаем признак доступности печати покомплектно.
	//ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

	// Проверяем, нужно ли для макета ЗаявкаНаКассовыйРасход0531801 формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ЗаявлениеОбОтказеОтАкцепта") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ЗаявлениеОбОтказеОтАкцепта",
			"Заявление об акцепте, отказе от акцепта",
			Печать0401004(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначенияРеквизитовЗаявлениеОбОтказеОтАкцепта(Ссылка)
	
	СтруктураДанных = Новый Структура;

	// Значения реквизитов Платежного поручения 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Поручение.Номер 												КАК НомерДок,
	               |	Поручение.Дата 													КАК ДатаДок,
	               |	Поручение.ИННПлательщика 										КАК ИноеИННПолучателя,
	               |	Поручение.КПППлательщика 										КАК ИноеКПППолучателя,
	               |	""ИНН "" + Поручение.ИННПлательщика 							КАК ИННПлательщика,
	               |	""КПП "" + Поручение.КПППлательщика								КАК КПППлательщика,
	               |	Поручение.СуммаДокумента 										КАК СуммаДокумента,
	               |	Поручение.ПлательщикНаименование 								КАК ТекстПлательщика,
	               |	Поручение.ПлательщикБанковскийСчет 								КАК НомерСчетаПлательщика,
	               |	Поручение.ПлательщикНаименованиеБанка 							КАК НаименованиеБанкаПлательщика,
	               |	Поручение.ПлательщикБИКБанка 									КАК БИКБанкаПлательщика,
	               |	Поручение.ПлательщикКорСчетБанка 								КАК СчетБанкаПлательщика,
	               |	Поручение.КонтрагентНаименованиеБанка 							КАК НаименованиеБанкаПолучателя,
	               |	Поручение.КонтрагентБИКБанка 									КАК БИКБанкаПолучателя,
	               |	Поручение.КонтрагентКорСчетБанка 								КАК СчетБанкаПолучателя,
	               |	Поручение.КонтрагентИНН 										КАК КонтрагентИНН,
	               |	Поручение.КонтрагентКПП 										КАК КонтрагентКПП,
	               |	""ИНН "" + Поручение.КонтрагентИНН 								КАК ИННПолучателя,
	               |	""КПП "" + Поручение.КонтрагентКПП 								КАК КПППолучателя,
	               |	Поручение.КонтрагентНаименование 								КАК ТекстПолучателя,
	               |	Поручение.КонтрагентБанковскийСчет 								КАК НомерСчетаПолучателя,
	               |	Поручение.Содержание		 									КАК Содержание,
	               |	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.МесяцПрописью, ЛОЖЬ)	КАК МесяцПрописью,
	               |	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.СуммаБезКопеек, ЛОЖЬ) КАК СуммаБезКопеек,
	               |	Поручение.ЛицевойСчет 											КАК ЛицевойСчет,
	               |	Поручение.РеквизитыЛицевогоСчета 								КАК РеквизитыЛицевогоСчета,
	               |	Поручение.Организация 											КАК Организация,
	               |	Поручение.СчетКонтрагента 										КАК СчетКонтрагента,
				   |	Поручение.ВидАкцепта 											КАК ВидАкцепта,
				   |	Поручение.НомерТребования										КАК НомерТребования,
				   |	Поручение.ДатаТребования										КАК ДатаТребования,
				   |	Поручение.СрокПлатежа											КАК СрокПлатежа,
				   |	Поручение.СуммаАкцепта											КАК СуммаАкцепта,
				   |	Поручение.СуммаОтказа											КАК СуммаОтказа
	               |ИЗ
	               |	Документ.ЗаявлениеОбОтказеОтАкцепта КАК Поручение
	               |ГДЕ
	               |	Поручение.Ссылка = &Ссылка";

	МассивРезультатов = Запрос.Выполнить();
	
	Выборка = МассивРезультатов.Выбрать();			   
	Выборка.Следующий();
	
	Для Каждого Колонка ИЗ МассивРезультатов.Колонки Цикл
		СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
	КонецЦикла;
	
	ДополнительныеРеквизиты = УправлениеСвойствами.ЗначенияСвойств(Ссылка, истина, Ложь);
	
	СтруктураДопРеквизитов = Новый Структура;
	Для каждого ДопРеквизит из ДополнительныеРеквизиты цикл
		ИмяРеквизита = СтрЗаменить(ДопРеквизит.Свойство," ","_");
		Попытка 
			СтруктураДопРеквизитов.Вставить(ИмяРеквизита,ДопРеквизит.Значение);
		Исключение
			ЗаписьЖурналаРегистрации("Документ.ЗаявлениеОбОтказеОтАкцепта", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаявлениеОбОтказеОтАкцепта, Ссылка, "Недопустимые символы идентификатора дополнительного реквизита документа. Печать значения дополнительного реквизита <"+ИмяРеквизита+"> невозможна.");
		КонецПопытки;	
	КонецЦикла;	
	
	Если ДополнительныеРеквизиты.Количество() <> СтруктураДопРеквизитов.Количество() тогда
		ОбщегоНазначения.СообщитьПользователю("Описание ошибки в журнале регистрации.");
	КонецЕсли;	
	
	
	Для каждого ДопРеквизит из СтруктураДопРеквизитов Цикл
		СтруктураДанных.Вставить(ДопРеквизит.Ключ,ДопРеквизит.Значение);
	КонецЦикла;
	
	
		
//	СтруктураДанных.Вставить("ДатаДокумента", 	Формат(СтруктураДанных.ДатаДок, "ДФ=" + ?(СтруктураДанных.МесяцПрописью, "'дд ММММ гггг'", "'дд.ММ.гггг'")));
	СтруктураДанных.Вставить("ДатаДокумента", 	СтруктураДанных.ДатаДок);
	СтруктураДанных.Вставить("СуммаЧислом",		ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаДокумента, СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.Вставить("СуммаПрописью",	ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаДокумента, , СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.Вставить("ДатаТребования", 	Формат(СтруктураДанных.ДатаТребования, "ДФ=" + ?(СтруктураДанных.МесяцПрописью, "'дд ММММ гггг'", "'дд.ММ.гггг'")));
    СтруктураДанных.Вставить("СрокПлатежа", 	Формат(СтруктураДанных.СрокПлатежа, "ДФ=" + ?(СтруктураДанных.МесяцПрописью, "'дд ММММ гггг'", "'дд.ММ.гггг'")));
	
	Если СтруктураДанных.СуммаАкцепта <> 0 тогда
		СтруктураДанных.Вставить("СуммаАкцептаЧислом",		ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаАкцепта, СтруктураДанных.СуммаБезКопеек));
		СтруктураДанных.Вставить("СуммаАкцептаПрописью",ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаАкцепта, , СтруктураДанных.СуммаБезКопеек));
	КонецЕсли;
	Если СтруктураДанных.СуммаОтказа <> 0 Тогда
		СтруктураДанных.Вставить("СуммаОтказаЧислом",		ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаОтказа, СтруктураДанных.СуммаБезКопеек));
		СтруктураДанных.Вставить("СуммаОтказаПрописью",	ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаОтказа, , СтруктураДанных.СуммаБезКопеек));
    КонецЕсли;
	Возврат СтруктураДанных;
		
КонецФункции	

// Функция формирует табличный документ аккредитив (ф 0401063)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0401004(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент 					= Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаявлениеОбОтказеОтАкцепта_ЗаявлениеОбОтказеОтАкцепта";
	Макет 							= УправлениеПечатью.МакетПечатнойФормы("Документ.ЗаявлениеОбОтказеОтАкцепта.ПФ_MXL_ЗаявлениеОбОтказеОтАкцепта");
	Обл   							= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	
	Для НомерДокумента = 0 по МассивОбъектов.Количество()-1 цикл
		ЗначениеРеквизитовПечати = ЗначенияРеквизитовЗаявлениеОбОтказеОтАкцепта(МассивОбъектов[НомерДокумента]);
		
		Обл.Параметры.Заполнить(ЗначениеРеквизитовПечати);
		
		Обл.Области.Акцепт.ГраницаСнизу = ?(ЗначениеРеквизитовПечати.ВидАкцепта <> "2",Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1),Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии,1));
		Обл.Области.Отказ.ГраницаСнизу  = ?(ЗначениеРеквизитовПечати.ВидАкцепта  = "2",Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1),Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии,1));
		
		ТабДокумент.Вывести(Обл);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			                                               НомерДокумента+1, ОбъектыПечати, МассивОбъектов[НомерДокумента]);
	КонецЦикла;	
	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
