	Элементы.ЛицевойСчет.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

	Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

&НаКлиенте
ПРоцедура УправлениеФормой()
	Элементы.СуммаОтказа.Доступность = Объект.ВидАкцепта <> "0";
	Элементы.СуммаАкцепта.Доступность = Объект.ВидАкцепта <> "2";
