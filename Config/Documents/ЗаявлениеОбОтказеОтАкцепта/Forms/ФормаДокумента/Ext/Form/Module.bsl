КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию();
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Организация, ТекущаяСтрока, НаДату", Объект.Организация, Объект.РеквизитыЛицевогоСчета, Объект.Дата);
	ОткрытьФорму("Справочник.РеквизитыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Объект.РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
	Объект.ЛицевойСчет 				= ПолучитьЛицевойСчет(ВыбранноеЗначение);
    ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	
	ПриИзмененииКонтрагента();
	
	УстановитьДоступностьСвязанныхРеквизитовКонтрагента()
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКонтрагентаПриИзменении(Элемент)
	
	ПриИзмененииСчетаКонтрагента();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаДокументаПриИзменении(Элемент)
	Объект.СуммаАкцепта = 0;
	Объект.СуммаОтказа  = 0;
	
	Если Объект.ВидАкцепта = "0" тогда
		Объект.СуммаАкцепта = Объект.СуммаДокумента;
	ИначеЕсли Объект.ВидАкцепта = "2" тогда
		Объект.СуммаОтказа = Объект.СуммаДокумента;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВидАкцептаПриИзменении(Элемент)
	Объект.СуммаАкцепта = 0;
	Объект.СуммаОтказа  = 0;
	Если Объект.ВидАкцепта = "0" тогда
		Объект.СуммаАкцепта = Объект.СуммаДокумента;
	ИначеЕсли Объект.ВидАкцепта = "2" тогда
		Объект.СуммаОтказа = Объект.СуммаДокумента;
	КонецЕсли;	
	УправлениеФормой();
КонецПроцедуры

