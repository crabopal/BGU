&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчет(РеквизитыЛС)
	
	Возврат РеквизитыЛС.Владелец;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыКонтрагента(Знач СчетКонтрагента)
	
	РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СчетКонтрагента, СчетКонтрагента, РеквизитыПолучателя);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыКонтрагента(Знач Контрагент)
	
	РеквизитыПолучателя = Новый Структура("СсылкаНаОбъект, ИНН, КПП, НаименованиеПолное, Наименование", Контрагент);
	
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(РеквизитыПолучателя);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыОрганизации(Знач ПараметрыОбъекта)

	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ТекстПлательщика, НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
	
	Возврат РеквизитыПлательщика;

КонецФункции

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;
	
	ПараметрыОбъекта = Новый Структура("ЛицевойСчет,РеквизитыЛицевогоСчета,Дата");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта,Объект);
	
	РеквизитыПлательщика = ПолучитьПлатежныеРеквизитыОрганизации(ПараметрыОбъекта);
	
	Объект.ПлательщикНаименование 		=  РеквизитыПлательщика.ТекстПлательщика;
	Объект.ПлательщикБанковскийСчет 	=  РеквизитыПлательщика.НомерСчетаПлательщика;
	Объект.ПлательщикНаименованиеБанка 	=  РеквизитыПлательщика.НаименованиеБанкаПлательщика;
	Объект.ПлательщикБИКБанка 			=  РеквизитыПлательщика.БикБанкаПлательщика;
	Объект.ПлательщикКорСчетБанка 		=  РеквизитыПлательщика.СчетБанкаПлательщика;
	Объект.ИННПлательщика 				=  РеквизитыПлательщика.ИННПлательщика;
	Объект.КПППлательщика 				=  РеквизитыПлательщика.КПППлательщика;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчетаКонтрагента()
	
	Объект.КонтрагентБанковскийСчет	= ""; 
	Объект.КонтрагентНаименованиеБанка	= ""; 
	Объект.КонтрагентБИКБанка			= ""; 
	Объект.КонтрагентКорСчетБанка		= ""; 

	Если НЕ ЗначениеЗаполнено(Объект.Счетконтрагента) Тогда
		
		РеквизитыПолучателя = ПолучитьРеквизитыКонтрагента(Объект.Контрагент);
		
		Объект.КонтрагентНаименование 		= РеквизитыПолучателя.НаименованиеПолное;
		Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИНН; 
		Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПП; 

		Возврат;
	КонецЕСли;	
	
	РеквизитыПолучателя = ПолучитьПлатежныеРеквизитыКонтрагента(Объект.СчетКонтрагента);
	
	Объект.КонтрагентНаименование 		= РеквизитыПолучателя.ТекстПолучателя;
	Объект.КонтрагентБанковскийСчет		= РеквизитыПолучателя.НомерСчетаПолучателя; 
	Объект.КонтрагентНаименованиеБанка	= РеквизитыПолучателя.НаименованиеБанкаПолучателя; 
	Объект.КонтрагентБИКБанка			= РеквизитыПолучателя.БикБанкаПолучателя; 
	Объект.КонтрагентКорСчетБанка		= РеквизитыПолучателя.СчетБанкаПолучателя; 
	Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИННПолучателя; 
	Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПППолучателя; 

КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	Объект.КонтрагентНаименование		= ""; 
	Объект.КонтрагентИНН				= ""; 
	Объект.КонтрагентКПП				= ""; 

	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) тогда
		
		Объект.КонтрагентБанковскийСчет	= ""; 
		Объект.КонтрагентНаименованиеБанка	= ""; 
		Объект.КонтрагентБИКБанка			= ""; 
		Объект.КонтрагентКорСчетБанка		= ""; 
		
		Возврат;	
	КонецЕсли;
	
	Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.ЗаявлениеОбОтказеОтАкцепта");
	
	ПриИзмененииСчетаКонтрагента();


КонецПроцедуры	

