&НаСервере
Процедура ЗаполнитьДанныеСчетов()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	               |	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	               |			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ЕПСБУ.Ссылка
	               |			ИЗ
	               |				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ГДЕ
	               |				ЕПСБУ.Код = ""109.60"")
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	               |	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	               |			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ЕПСБУ.Ссылка
	               |			ИЗ
	               |				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ГДЕ
	               |				ЕПСБУ.Код = ""109.70"")
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL 
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	               |	ЕПСБУ.УчетПоПодразделениям КАК ЕстьПодразделение
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	               |			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности))
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ЕПСБУ.Ссылка
	               |			ИЗ
	               |				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ГДЕ
	               |				ЕПСБУ.Код = ""109.80"")
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
	Результат = Запрос.ВыполнитьПакет();
	ДанныеИспользуемыхСчетов = Новый Соответствие;
	
	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10960.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10970.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	Выборка = Результат[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Счета10980.Добавить(Выборка.Ссылка);
		ДанныеСчета = Новый Структура("ЕстьПодразделение, ЕстьНаправлениеДеятельности",
									  Выборка.ЕстьПодразделение,
									  Выборка.ЕстьНаправлениеДеятельности);
		ДанныеИспользуемыхСчетов.Вставить(Выборка.Ссылка, ДанныеСчета);
	КонецЦикла;
	
	ДанныеСчетов = Новый ФиксированноеСоответствие(ДанныеИспользуемыхСчетов);

КонецПроцедуры // ЗаполнитьДанныеСчетов()

&НаСервере
Процедура УстановитьВидимостьНаправленияДеятельностиПодразделения()

	ВидимостьНаправленияДеятельности	= Ложь;
	ВидимостьПодразделения				= Ложь;
	Для каждого ТекСчет Из Счета10960 Цикл
	
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
			ВидимостьНаправленияДеятельности = Истина;
		КонецЕсли;
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
			ВидимостьПодразделения = Истина;
		КонецЕсли;
		
		Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла; 
	
	Элементы.ПрямыеРасходыНаправлениеДеятельности.Видимость	= ВидимостьНаправленияДеятельности;
	Элементы.ПрямыеРасходыПодразделение.Видимость			= ВидимостьПодразделения;
	
	ВидимостьНаправленияДеятельности	= Ложь;
	ВидимостьПодразделения				= Ложь;
	Для каждого ТекСчет Из Счета10970 Цикл
	
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
			ВидимостьНаправленияДеятельности = Истина;
		КонецЕсли;
		Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
			ВидимостьПодразделения = Истина;
		КонецЕсли;
		
		Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	Если Не (ВидимостьНаправленияДеятельности И ВидимостьПодразделения) Тогда
		Для каждого ТекСчет Из Счета10980 Цикл
		
			Если ДанныеСчетов[ТекСчет.Значение].ЕстьНаправлениеДеятельности Тогда
				ВидимостьНаправленияДеятельности = Истина;
			КонецЕсли;
			Если ДанныеСчетов[ТекСчет.Значение].ЕстьПодразделение Тогда
				ВидимостьПодразделения = Истина;
			КонецЕсли;
			
			Если ВидимостьНаправленияДеятельности И ВидимостьПодразделения Тогда
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	Элементы.ОбщиеРасходыНаправлениеДеятельности.Видимость	= ВидимостьНаправленияДеятельности;
	Элементы.ОбщиеРасходыПодразделение.Видимость			= ВидимостьПодразделения;

КонецПроцедуры // УстановитьВидимостьНаправленияДеятельности()

&НаСервере
Процедура УстановитьПризнакНаправленияДеятельностиПодразделения()

	Для каждого ТекСтрока Из ОбщиеРасходы Цикл
		
		УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекСтрока, ДанныеСчетов);
		
	КонецЦикла; 	

	Для каждого ТекСтрока Из Объект.ПрямыеРасходы Цикл
		
		УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекСтрока, ДанныеСчетов);
		
	КонецЦикла; 	

КонецПроцедуры // УстановитьПризнакНаправленияДеятельности()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекСтрока, ДанныеСчетов)

	ДанныеСчета = ДанныеСчетов.Получить(ТекСтрока.Счет);
	Если ДанныеСчета = Неопределено Тогда
		ТекСтрока.ЕстьНаправлениеДеятельности	= Ложь;
		ТекСтрока.ЕстьПодразделение				= Ложь;
	Иначе
		ТекСтрока.ЕстьНаправлениеДеятельности	= ДанныеСчета.ЕстьНаправлениеДеятельности;
		ТекСтрока.ЕстьПодразделение				= ДанныеСчета.ЕстьПодразделение;
	КонецЕсли;

КонецПроцедуры // УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке()

&НаКлиенте
Функция НеЗаполненВидОбщихЗатрат()

	Если ЗначениеЗаполнено(Объект.ВидОбщихЗатрат) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен вид общих затрат'"),,"Объект.ВидОбщихЗатрат");
	
	Возврат Истина;

КонецФункции // НеЗаполненВидОбщихЗатрат()

&НаКлиенте
Процедура УстановитьПредставлениеПериода()

	ТекстПериод = Формат(Объект.Дата, "ДФ='MMMM yyyy'");	

КонецПроцедуры // УстановитьПредставлениеПериода()

&НаКлиенте
Процедура УстановитьОтборПрямыхРасходов()

	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Иначе
		НовОтборСтрок = Новый ФиксированнаяСтруктура("ИдСтроки", ТекущиеДанные.ИдСтроки);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.ПрямыеРасходы.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено ИЛИ ТекущийОтборСтрок.ИдСтроки <> НовОтборСтрок.ИдСтроки Тогда
		Элементы.ПрямыеРасходы.ОтборСтрок = НовОтборСтрок;
	КонецЕсли;

КонецПроцедуры // УстановитьОтборПрямыхРасходов()

&НаКлиенте
Функция СписокСчетовОбщихЗатрат()

	Список = Новый СписокЗначений;
	Если Объект.ВидОбщихЗатрат = ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты") Тогда
		Список.ЗагрузитьЗначения(Счета10970.ВыгрузитьЗначения());
	ИначеЕсли Объект.ВидОбщихЗатрат = ПредопределенноеЗначение("Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты") Тогда
		Список.ЗагрузитьЗначения(Счета10980.ВыгрузитьЗначения());
	КонецЕсли;
	Возврат Список;

КонецФункции // СписокСчетовОбщихЗатрат()

&НаСервере
Процедура ЗаполнитьДокументНаСервере()

	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ОбщиеРасходы.Очистить();
	Объект.ПрямыеРасходы.Очистить();
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ПараметрыУчетаЗатрат = Документы.РаспределениеОбщихЗатрат.ПараметрыУчетаЗатрат(Объект.Дата, Объект.Организация, Объект.ИФО, Объект.КФО);
	Если Объект.ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда
		ПараметрыУчетаЗатрат.РаспределятьОХЗ = Ложь;
	ИНаче	
		ПараметрыУчетаЗатрат.РаспределятьОПЗ = Ложь;
	КонецЕсли;
	
	ТаблицаРаспределенияЗатрат = Документы.РаспределениеОбщихЗатрат.РаспределитьОбщиеЗатраты(ПараметрыУчетаЗатрат);
	
	ЗаполнитьПоТаблице(ТаблицаРаспределенияЗатрат);
	ЗаполнитьТаблицуОбщихРасходов();
	УстановитьПризнакНаправленияДеятельностиПодразделения();

КонецПроцедуры // ЗаполнитьДокументНаСервере()

&НаСервере
Процедура ЗаполнитьПоТаблице(ТаблицаДляЗаполнения)

	ТаблицаОбщихРасходов = ТаблицаДляЗаполнения.Скопировать(,"КПССчетОЗ, СчетОЗ, КЭКСчетОЗ, ВидЗатратОЗ, НаправлениеДеятельностиОЗ, ПодразделениеОЗ, Сумма");
	ТаблицаОбщихРасходов.Свернуть("КПССчетОЗ, СчетОЗ, КЭКСчетОЗ, ВидЗатратОЗ, НаправлениеДеятельностиОЗ, ПодразделениеОЗ", "Сумма");
	
	Для каждого ТекОбщийРасход Из ТаблицаОбщихРасходов Цикл
	
		ИдСтроки = Новый УникальныйИдентификатор;
		СтрокаОбщихРасходов = ОбщиеРасходы.Добавить();
		СтрокаОбщихРасходов.КПС							= ТекОбщийРасход.КПССчетОЗ;
		СтрокаОбщихРасходов.Счет						= ТекОбщийРасход.СчетОЗ;
		СтрокаОбщихРасходов.КЭК							= ТекОбщийРасход.КЭКСчетОЗ;
		СтрокаОбщихРасходов.ВидЗатрат					= ТекОбщийРасход.ВидЗатратОЗ;
		СтрокаОбщихРасходов.НаправлениеДеятельности		= ТекОбщийРасход.НаправлениеДеятельностиОЗ;
		СтрокаОбщихРасходов.ИдСтроки					= ИдСтроки;
		СтрокаОбщихРасходов.Сумма						= ТекОбщийРасход.Сумма;
		СтрокаОбщихРасходов.ЕстьНаправлениеДеятельности = ДанныеСчетов.Получить(СтрокаОбщихРасходов.Счет) = Истина;
		СтрокаОбщихРасходов.Подразделение				= ТекОбщийРасход.ПодразделениеОЗ;
		
		Отбор = Новый Структура("КПССчетОЗ, СчетОЗ, КЭКСчетОЗ, ВидЗатратОЗ, НаправлениеДеятельностиОЗ, ПодразделениеОЗ");
		ЗаполнитьЗначенияСвойств(Отбор, ТекОбщийРасход);
		СтрокиПрямыхРасходов = ТаблицаДляЗаполнения.НайтиСтроки(Отбор);
		Для каждого ТекПрямойРасход Из СтрокиПрямыхРасходов Цикл
		
			СтрокаПрямыхРасходов = Объект.ПрямыеРасходы.Добавить();
			СтрокаПрямыхРасходов.КПСОЗ						= ТекОбщийРасход.КПССчетОЗ;
			СтрокаПрямыхРасходов.СчетОЗ						= ТекОбщийРасход.СчетОЗ;
			СтрокаПрямыхРасходов.КЭК						= ТекОбщийРасход.КЭКСчетОЗ;
			СтрокаПрямыхРасходов.ВидЗатрат					= ТекОбщийРасход.ВидЗатратОЗ;
			СтрокаПрямыхРасходов.КПС						= ТекПрямойРасход.КПССчетПЗ;
			СтрокаПрямыхРасходов.Счет						= ТекПрямойРасход.СчетПЗ;
			СтрокаПрямыхРасходов.НаправлениеДеятельности	= ТекПрямойРасход.НаправлениеДеятельностиПЗ;
			СтрокаПрямыхРасходов.Подразделение				= ТекПрямойРасход.ПодразделениеПЗ;
			СтрокаПрямыхРасходов.ПодразделениеОЗ			= ТекПрямойРасход.ПодразделениеОЗ;
			СтрокаПрямыхРасходов.Номенклатура				= ТекПрямойРасход.Номенклатура;
			СтрокаПрямыхРасходов.Сумма						= ТекПрямойРасход.Сумма;
			СтрокаПрямыхРасходов.СуммаОЗ					= ТекОбщийРасход.Сумма;
			СтрокаПрямыхРасходов.ИдСтроки					= ИдСтроки;
			СтрокаПрямыхРасходов.ЕстьНаправлениеДеятельности = ДанныеСчетов.Получить(СтрокаПрямыхРасходов.Счет) = Истина;
			
			СтрокаОбщихРасходов.Сумма = СтрокаОбщихРасходов.Сумма + СтрокаПрямыхРасходов.Сумма;
		
		КонецЦикла; 
	
	КонецЦикла; 

КонецПроцедуры // ЗаполнитьПоТаблице()
 
&НаСервере
Процедура ЗаполнитьТаблицуОбщихРасходов()

	ОбщиеРасходы.Очистить();
	ТаблицаОбщихРасходов = Объект.ПрямыеРасходы.Выгрузить();
	ТаблицаОбщихРасходов.Свернуть("КПСОЗ, СчетОЗ, КЭК, ВидЗатрат, НаправлениеДеятельности, ПодразделениеОЗ, СуммаОЗ");
	ТаблицаОбщихРасходов.Колонки.Добавить("Обработано", Новый ОписаниеТипов("Булево"));
	
	Для каждого ТекОбщийРасход Из ТаблицаОбщихРасходов Цикл
		
		Если ТекОбщийРасход.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСчетаТекущейСтроки = ДанныеСчетов.Получить(ТекОбщийРасход.СчетОЗ);
		Если ДанныеСчетаТекущейСтроки = Неопределено Тогда
			ЕстьНД				= Ложь;
			ЕстьПодразделение	= Ложь;
		Иначе
			ЕстьНД 				= ДанныеСчетаТекущейСтроки.ЕстьНаправлениеДеятельности = Истина;
			ЕстьПодразделение	= ДанныеСчетаТекущейСтроки.ЕстьПодразделение = Истина;
		КонецЕсли;
		Отбор = Новый Структура("КПСОЗ, СчетОЗ, КЭК, ВидЗатрат");
		Если ЕстьНД Тогда
			Отбор.Вставить("НаправлениеДеятельности");
		КонецЕсли;
		Если ЕстьПодразделение Тогда
			Отбор.Вставить("ПодразделениеОЗ");
		КонецЕсли;
		
		ИдСтроки = Новый УникальныйИдентификатор;
		СтрокаОбщихРасходов = ОбщиеРасходы.Добавить();
		СтрокаОбщихРасходов.Подразделение			= ТекОбщийРасход.ПодразделениеОЗ;
		СтрокаОбщихРасходов.КПС						= ТекОбщийРасход.КПСОЗ;
		СтрокаОбщихРасходов.Счет					= ТекОбщийРасход.СчетОЗ;
		СтрокаОбщихРасходов.КЭК						= ТекОбщийРасход.КЭК;
		СтрокаОбщихРасходов.ВидЗатрат				= ТекОбщийРасход.ВидЗатрат;
		СтрокаОбщихРасходов.НаправлениеДеятельности	= ТекОбщийРасход.НаправлениеДеятельности;
		СтрокаОбщихРасходов.Сумма					= ТекОбщийРасход.СуммаОЗ;
		СтрокаОбщихРасходов.ИдСтроки				= ИдСтроки;
		СтрокаОбщихРасходов.СуммаПЗ					= 0;
		
		ЗаполнитьЗначенияСвойств(Отбор, ТекОбщийРасход);
		
		СтрокиПрямыхРасходов = Объект.ПрямыеРасходы.НайтиСтроки(Отбор);
		Для каждого ТекПрямойРасход Из СтрокиПрямыхРасходов Цикл
		
			ТекПрямойРасход.ИдСтроки = ИдСтроки;
			СтрокаОбщихРасходов.СуммаПЗ = СтрокаОбщихРасходов.СуммаПЗ + ТекПрямойРасход.Сумма;
		
		КонецЦикла; 
		
		ОбработанныеСтроки = ТаблицаОбщихРасходов.НайтиСтроки(Отбор);
		Для каждого ТекОбработаннаяСтрока Из ОбработанныеСтроки Цикл
		
			ТекОбработаннаяСтрока.Обработано = Истина;
		
		КонецЦикла; 
	
	КонецЦикла; 

КонецПроцедуры // ЗаполнитьТаблицуОбщихРасходов()
 
&НаСервере
Функция СуммаПрямыхЗатрат()

	Результат = 0;
	Отбор = Новый Структура("ИдСтроки", Элементы.ПрямыеРасходы.ОтборСтрок.ИдСтроки);
	СтрокиПрямыхЗатрат = Объект.ПрямыеРасходы.НайтиСтроки(Отбор);
	Для каждого ТекСтрокаПрямыхЗатрат Из СтрокиПрямыхЗатрат Цикл
	
		Результат = Результат + ТекСтрокаПрямыхЗатрат.Сумма;
	
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции // СуммаПрямыхЗатрат()

&НаСервере
Процедура ЗаписатьОбщиеЗатратыВДокумент(ТекущийОбъект)

	ЕстьИзменения = Ложь;
	ОбработанныеСтроки = Новый Массив;
	Для каждого ТекОбщийРасход Из ОбщиеРасходы Цикл
	
		Отбор = Новый Структура("ИдСтроки", ТекОбщийРасход.ИдСтроки);
		СтрокиПрямыхРасходов = Объект.ПрямыеРасходы.НайтиСтроки(Отбор);
		Если СтрокиПрямыхРасходов.Количество() = 0 Тогда
			НоваяСтрока = Объект.ПрямыеРасходы.Добавить();	
			УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.КПС,	 					НоваяСтрока.КПСОЗ, 						ЕстьИзменения);
			УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.ВидЗатрат, 					НоваяСтрока.ВидЗатрат, 					ЕстьИзменения);
			Если ТекОбщийРасход.ЕстьНаправлениеДеятельности = Истина Тогда
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.НаправлениеДеятельности,НоваяСтрока.НаправлениеДеятельности,	ЕстьИзменения);
			КонецЕсли;
			УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.КЭК, 						НоваяСтрока.КЭК, 						ЕстьИзменения);
			УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.Сумма, 						НоваяСтрока.СуммаОЗ, 					ЕстьИзменения);
			ОбработанныеСтроки.Добавить(НоваяСтрока);
		Иначе
			Для каждого ТекПрямойРасход Из СтрокиПрямыхРасходов Цикл
			
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.Подразделение,				ТекПрямойРасход.ПодразделениеОЗ, 			ЕстьИзменения);
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.КПС,	 					ТекПрямойРасход.КПСОЗ, 						ЕстьИзменения);
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.ВидЗатрат, 					ТекПрямойРасход.ВидЗатрат, 					ЕстьИзменения);
				Если ТекОбщийРасход.ЕстьНаправлениеДеятельности = Истина Тогда
					УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.НаправлениеДеятельности,ТекПрямойРасход.НаправлениеДеятельности,	ЕстьИзменения);
				КонецЕсли;
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.КЭК, 						ТекПрямойРасход.КЭК, 						ЕстьИзменения);
				УстановитьНовоеЗначениеРеквизита(ТекОбщийРасход.Сумма, 						ТекПрямойРасход.СуммаОЗ, 					ЕстьИзменения);
				ОбработанныеСтроки.Добавить(ТекПрямойРасход);
			
			КонецЦикла; 
		КонецЕсли;
	
	КонецЦикла;
	
	СтрокиКУдалению = Новый Массив;
	Для каждого ТекСтрока Из Объект.ПрямыеРасходы Цикл
	
		Если ОбработанныеСтроки.Найти(ТекСтрока) = Неопределено Тогда
			СтрокиКУдалению.Добавить(ТекСтрока);
		КонецЕсли;
	
	КонецЦикла; 
	Если СтрокиКУдалению.Количество() > 0 Тогда
		ЕстьИзменения = Истина;
		Для каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		
			Объект.ПрямыеРасходы.Удалить(СтрокаКУдалению);
		
		КонецЦикла; 
	КонецЕсли;
	
	Если ЕстьИзменения Тогда
		ТекущийОбъект.ПрямыеРасходы.Загрузить(Объект.ПрямыеРасходы.Выгрузить());
	КонецЕсли;

КонецПроцедуры // ЗаписатьОбщиеЗатратыВДокумент()
 
&НаСервере
Процедура УстановитьНовоеЗначениеРеквизита(Источник, Приемник, ЕстьИзменения)

	Если Источник <> Приемник Тогда
		Приемник = Источник;
		ЕстьИзменения = Истина;
	КонецЕсли;

КонецПроцедуры // УстановитьНовоеЗначениеРеквизита()

&НаКлиенте
Процедура ВопросПерейтиКЗакрытиюСчетовПроизводственныхЗатратЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ЭтаФорма.Закрыть();
		ОткрытьФорму("Документ.ЗакрытиеСчетовПроизводственныхЗатрат.ФормаОбъекта");
		
	КонецЕсли;
	
КонецПроцедуры

