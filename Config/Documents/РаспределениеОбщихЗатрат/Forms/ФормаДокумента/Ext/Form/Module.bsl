////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ОБЩИЕРАСХОДЫ

&НаКлиенте
Процедура ОбщиеРасходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки = Новый УникальныйИдентификатор;
		ТекущийСписок = СписокСчетовОбщихЗатрат();
		Если ТекущийСписок.Количество() = 1 Тогда
			ТекущиеДанные.Счет = ТекущийСписок[0].Значение;
			УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если НеЗаполненВидОбщихЗатрат() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыСчетПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.Счет, 
																			ТекущиеДанные.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															СписокСчетовОбщихЗатрат(),
															Объект.КФО,
															,
															Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекущиеДанные.КПС,
															,
															ТекущиеДанные.КЭК,);
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыСчетАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Отбор = Новый Структура("Ссылка, ЭлементГруппа", СписокСчетовОбщихЗатрат(), Ложь);
		ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска, Отбор", Текст, Отбор);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыВыбораЗначения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыСчетОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	Если СтрДлина(Текст) > 0 Тогда
		СтандартнаяОбработка = Ложь;
		Отбор = Новый Структура("Ссылка, ЭлементГруппа", СписокСчетовОбщихЗатрат(), Ложь);
		ПараметрыВыбораЗначения = Новый Структура("СтрокаПоиска, Отбор", Текст, Отбор);
		ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыВыбораЗначения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыКЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
    	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭК,
								Объект.Организация, 
								Объект.ИФО,
								Объект.КФО, 
                                ТекущиеДанные.Счет,
								Объект.Дата,
								"Дт");
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеРасходыПриАктивизацииСтроки(Элемент)
	УстановитьОтборПрямыхРасходов();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ПРЯМЫЕРАСХОДЫ

&НаКлиенте
Процедура ПрямыеРасходыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если НеЗаполненВидОбщихЗатрат() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	СтрокаОбщихРасходов = Элементы.ОбщиеРасходы.ТекущиеДанные;
	Если СтрокаОбщихРасходов = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбрана строка общих расходов'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрямыеРасходыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элементы.ПрямыеРасходы.ТекущиеДанные;
		Если Счета10960.Количество() = 1 Тогда
			ТекущиеДанные.Счет = Счета10960[0].Значение;
			УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
		КонецЕсли;
		СтрокаОбщихРасходов = Элементы.ОбщиеРасходы.ТекущиеДанные;
		ТекущиеДанные.ИдСтроки 					= СтрокаОбщихРасходов.ИдСтроки;
		ТекущиеДанные.КПСОЗ 					= СтрокаОбщихРасходов.КПС;
		ТекущиеДанные.КПС	 					= СтрокаОбщихРасходов.КПС;
		ТекущиеДанные.СчетОЗ 					= СтрокаОбщихРасходов.Счет;
		ТекущиеДанные.КЭК	 					= СтрокаОбщихРасходов.КЭК;
		ТекущиеДанные.ВидЗатрат 				= СтрокаОбщихРасходов.ВидЗатрат;
		ТекущиеДанные.НаправлениеДеятельности	= СтрокаОбщихРасходов.НаправлениеДеятельности;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПрямыеРасходыСчетПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПрямыеРасходы.ТекущиеДанные;
	УстановитьПризнакНаправленияДеятельностиПодразделенияВСтроке(ТекущиеДанные, ДанныеСчетов);
КонецПроцедуры

&НаКлиенте
Процедура ПрямыеРасходыСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.Счет, 
																			ТекущиеДанные.КПС, 
																			Объект.КФО), 
															Объект.Организация,
															Объект.ИФО,
															Счета10960,
															Объект.КФО,
															,
															Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ПрямыеРасходыСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ОбщиеРасходы.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
															ТекущиеДанные.КПС);
