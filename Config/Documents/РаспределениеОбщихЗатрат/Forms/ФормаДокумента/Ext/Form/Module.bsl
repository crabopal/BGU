// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	ТекстВопроса = "";
	Кнопки = Неопределено;
	
	Если Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'При заполнении будет выполнена отмена проведения и документ будет перезаполнен.
		|Отменить проведение и перезаполнить?'");		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отменить проведение и перезаполнить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	ИначеЕсли ОбщиеРасходы.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Документ будет перезаполнен.
		|Перезаполнить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Перезаполнить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	КонецЕсли;
	
	Если НЕ Кнопки = Неопределено Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьДокументЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);
        Возврат;
	КонецЕсли;	
	
	ЗаполнитьДокументНаСервере();
	Модифицированность = Истина;
	УстановитьОтборПрямыхРасходов();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДокументЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДокументНаСервере();
	Модифицированность = Истина;
	УстановитьОтборПрямыхРасходов();

КонецПроцедуры

