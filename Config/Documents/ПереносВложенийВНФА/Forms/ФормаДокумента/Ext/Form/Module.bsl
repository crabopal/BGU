	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",						Объект.СчетВложений);
	ПараметрыПодбора.Вставить("КФО",							Объект.КФОСписания);
	ПараметрыПодбора.Вставить("КПС",							Объект.КПССписания);
	ПараметрыПодбора.Вставить("Подразделение",					Объект.Подразделение);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",				Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",			Истина);
	ПараметрыПодбора.Вставить("ИмяТаблицы",						"Материалы");
	ПараметрыПодбора.Вставить("ЭтоПодборСчета106",				Истина);
	ПараметрыПодбора.Вставить("ЕстьТолькоСуммовыеОстатки",		Истина);
	ПараметрыПодбора.Вставить("НеИспользоватьРезервирование",	Истина);
	
