Функция СтруктураПроверяемыхРеквизитов() Экспорт
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("СчетВложений", "Счет вложений");
	СтруктураРеквизитов.Вставить("КФОСписания", "КФО (списания)");
	СтруктураРеквизитов.Вставить("КПССписания", "КПС (списания)");

    Возврат СтруктураРеквизитов;
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПараметрыПодбора.Отбор.Вставить("Организация"	, Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО"			, Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО"			, Объект.КФОСписания);
	ПараметрыПодбора.Отбор.Вставить("КПС"			, Объект.КПССписания);
	ПараметрыПодбора.Отбор.Вставить("Счет"			, Объект.СчетВложений);	
	ПараметрыПодбора.Отбор.Вставить("Подразделение"	, Объект.Подразделение);
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения"	, "Вложения");
	ПараметрыПодбора.Вставить("СкрытьКолонки"	, "СчетУчета,ВидНФА");
	//ПараметрыПодбора.Вставить("КолонкиКорзины"	, Новый Структура("ОсновноеСредство", "ВнеоборотныйАктив"));

	Если Объект.КапитальныеВложения.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

