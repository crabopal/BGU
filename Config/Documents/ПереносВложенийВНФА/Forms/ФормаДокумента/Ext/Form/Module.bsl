Процедура РассчитатьСуммыНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект);
	ПараметрыПолученияОстатков.Подразделение	= Объект.Подразделение;
	ПараметрыПолученияОстатков.ИспользоватьУчетПоПодразделениям = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям
		И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект.СчетВложений).УчетПоПодразделениям;
	ПараметрыПолученияОстатков.КПС = Объект.КПССписания;
	ПараметрыПолученияОстатков.КФО = Объект.КФОСписания;

	Для Каждого ТекСтрокаОС Из Объект.КапитальныеВложения Цикл
		
		НоваяСтрока = ПараметрыПолученияОстатков.ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаОС);
		НоваяСтрока.ОсновноеСредство = ТекСтрокаОС.ВнеоборотныйАктив;
	
	КонецЦикла;
	
	ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков); 
		
	Для Каждого ТекСтрокаОС Из Объект.КапитальныеВложения Цикл
		СтруктураПоиска = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ВнеоборотныйАктив);
		СтрокиОстатков = ТаблицаОстатков.НайтиСтроки(СтруктураПоиска);
		Если СтрокиОстатков.Количество() > 0 Тогда
			ТекСтрокаОС.Количество	= СтрокиОстатков[0].КоличествоОстаток;
			ТекСтрокаОС.Сумма		= СтрокиОстатков[0].БалансоваяСтоимость;
			ТекСтрокаОС.Цена		= СтрокиОстатков[0].БалансоваяСтоимость / ?(ТекСтрокаОС.Количество = 0, 1, ТекСтрокаОС.Количество);
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммыМЗнаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет = &Счет,
	|			&Субконто,
	|			Организация = &Организация
	|				И КПС = &КПС
	|				И КФО = &КФО) КАК ЖурналПроводокЕПСБУОстатки";
	
	Если Параметры.Ключ.Пустая() Тогда
		Запрос.УстановитьПараметр("Период", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("Период", Новый Граница(Параметры.Ключ.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счет", Объект.СчетВложений);
	Запрос.УстановитьПараметр("Субконто", ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("КПС", Объект.КПССписания);
	Запрос.УстановитьПараметр("КФО", Объект.КФОСписания);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("МассивНФА", Объект.Материалы.Выгрузить(,"Номенклатура").ВыгрузитьКолонку("Номенклатура"));
	
	Остатки = Запрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаНоменклатуры Из Объект.Материалы Цикл
	
		СтрокаОстатков = Остатки.Найти(СтрокаНоменклатуры.Номенклатура, "Номенклатура");
		Если СтрокаОстатков = Неопределено Тогда
			СтрокаНоменклатуры.Цена = 0;
			СтрокаНоменклатуры.Сумма = 0;
		Иначе
			Если СтрокаНоменклатуры.Количество = 0 Тогда
				СтрокаНоменклатуры.Количество = СтрокаОстатков.Количество;
			КонецЕсли;
			
			Если СтрокаНоменклатуры.Количество = 0 Или СтрокаНоменклатуры.Количество = СтрокаОстатков.Количество Тогда
				
				СтрокаНоменклатуры.Сумма = СтрокаОстатков.Сумма;
				СтрокаНоменклатуры.Цена = ?(СтрокаОстатков.Количество = 0, СтрокаОстатков.Сумма, СтрокаОстатков.Сумма / СтрокаОстатков.Количество);
				
			Иначе
				
				СтрокаНоменклатуры.Цена = ?(СтрокаОстатков.Количество = 0, СтрокаОстатков.Сумма, СтрокаОстатков.Сумма / СтрокаОстатков.Количество);
				СтрокаНоменклатуры.Сумма = СтрокаНоменклатуры.Цена * СтрокаНоменклатуры.Количество;
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла; 
	

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВозможностьИРассчитатьСтоимость(РасчетОС = Истина)

	Если Не УправлениеОсновнымиСредствамиКлиент.ПроверитьЗаполнениеОбязательныхРеквизитов(ЭтаФорма, Объект, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Если РасчетОС Тогда
		РассчитатьСуммыНаСервере();
	Иначе
		РассчитатьСуммыМЗнаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЗакладок(Форма, Объект)

	Элементы = Форма.Элементы;
	
	ДоступностьОС = Ложь;
	ДоступностьМЗ = Ложь;
	
	Если ЗначениеЗаполнено(Объект.СчетВложений) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Объект.СчетВложений);
		
		Для Индекс = 1 По 3 Цикл
		
			Если СвойстваСчета["ВидСубконто" + Индекс] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства") Тогда
				ДоступностьОС = Истина;
			ИначеЕсли СвойстваСчета["ВидСубконто" + Индекс] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Номенклатура") Тогда
				ДоступностьМЗ = Истина;
			КонецЕсли;
		
		КонецЦикла; 
		
	КонецЕсли;
	
	Элементы.КапитальныеВложения.Доступность = ДоступностьОС;
	Если Элементы.СтраницаКапВложения.ПодчиненныеЭлементы.Количество() = 1 Тогда
		Элементы.СтраницаКапВложения.Доступность = Элементы.СтраницаКапВложения.ПодчиненныеЭлементы[0].Доступность;
	КонецЕсли;
	Элементы.Материалы.Доступность = ДоступностьМЗ;
	Если Элементы.СтраницаМатериалы.ПодчиненныеЭлементы.Количество() = 1 Тогда
		Элементы.СтраницаМатериалы.Доступность = Элементы.СтраницаМатериалы.ПодчиненныеЭлементы[0].Доступность;
	КонецЕсли;
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Доступность <> Истина Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаРеквизитыСписанияОприходования;
	КонецЕсли;

КонецПроцедуры // УстановитьДоступностьЗакладок()

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		
		НоваяСтрока = Объект.Материалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		НоваяСтрока.Цена = ?(НоваяСтрока.Количество = 0, НоваяСтрока.Сумма, НоваяСтрока.Сумма / НоваяСтрока.Количество);
		
		Если НоваяСтрока.Сумма = 0 Тогда
			ЕстьНулеваяСуммаВПодборе = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьНулеваяСуммаВПодборе Тогда
		РассчитатьСуммыМЗнаСервере();
	КонецЕсли;
	
КонецПроцедуры

