// Формирует и выполняет запросы для формирования таблицы-источника данных для типовой операции формирования проводок 
// по переносу капвложений.
// 
// Параметры:
//  - РеквизитыДокумента - Структура - параметры для формирования таблицы. Имеет ключи:
//	  * "Ссылка" - ДокументСсылка.ПереносВложенийВНФА - документ, по которому формируются проводки. Параметр передается,
//	  				если передается ссылка на документ
//	  * "Объект" - ДокументОбъект.ПереносВложенийВНФА - документ, по которому формируются проводки. Параметр передается,
//	  				если передается документ-объект
//	  * "Дата" - Дата
//	  * "Организация" - СправочникСсылка.Организации
//	  * "ИФО" - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	  * "Подразделение" - СправочникСсылка.Подразделения
//	  * "СчетВложений" - ПланСчетовСсылка.ЕПСБУ
//	  * "КФОСписания" - ПеречислениеСсылка.КВД
//	  * "КПССписания" - СправочникСсылка.КлассификационныеПризнакиСчетов
//	- Нс - Число - номер субконто, соответствующего типу НФА (основные средства, номенклатура). Выходное значение
//
// Возвращаемое значение:
//   - Структура - Ключи:
//     * ОстаткиБУ - ТаблицаЗначений - таблица остатков по бух. учету
//     * ТабЧасть - ТаблицаЗначений - таблица из табличных частей документа 
Функция ПолучитьТаблицы(РеквизитыДокумента, Нс) Экспорт
	Запрос = Новый Запрос();
	Если РеквизитыДокумента.Свойство("Объект") Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КапитальныеВложения.ВнеоборотныйАктив КАК НФА,
		|	КапитальныеВложения.Количество КАК Количество,
		|	КапитальныеВложения.Сумма КАК Сумма
		|ПОМЕСТИТЬ КапитальныеВложения
		|ИЗ
		|	&КапитальныеВложения КАК КапитальныеВложения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Материалы.Номенклатура КАК НФА,
		|	Материалы.Количество КАК Количество,
		|	Материалы.Сумма КАК Сумма
		|ПОМЕСТИТЬ Материалы
		|ИЗ
		|	&Материалы КАК Материалы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КапитальныеВложения.НФА КАК НФА,
		|	КапитальныеВложения.Количество КАК Количество,
		|	КапитальныеВложения.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	КапитальныеВложения КАК КапитальныеВложения
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Материалы.НФА,
		|	Материалы.Количество,
		|	Материалы.Сумма
		|ИЗ
		|	Материалы КАК Материалы";

		Запрос.УстановитьПараметр("КапитальныеВложения", РеквизитыДокумента.Объект.КапитальныеВложения);
		Запрос.УстановитьПараметр("Материалы", РеквизитыДокумента.Объект.Материалы);
		НачальныйИндексЗапроса = 3;
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	КапитальныеВложения.ВнеоборотныйАктив КАК НФА,
		|	КапитальныеВложения.Количество КАК Количество,
		|	КапитальныеВложения.Сумма КАК Сумма
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.ПереносВложенийВНФА.КапитальныеВложения КАК КапитальныеВложения
		|ГДЕ
		|	КапитальныеВложения.Ссылка = &Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Материалы.Номенклатура,
		|	Материалы.Количество,
		|	Материалы.Сумма
		|ИЗ
		|	Документ.ПереносВложенийВНФА.Материалы КАК Материалы
		|ГДЕ
		|	Материалы.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("Ссылка", РеквизитыДокумента.Ссылка);
		НачальныйИндексЗапроса = 1;
	КонецЕсли;
			
	Запрос.УстановитьПараметр("Период"       , РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация"  , РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("ИФО"          , РеквизитыДокумента.ИФО);
	Запрос.УстановитьПараметр("Подразделение", РеквизитыДокумента.Подразделение);
	Запрос.УстановитьПараметр("Счет"         , РеквизитыДокумента.СчетВложений);
	Запрос.УстановитьПараметр("КФО"          , РеквизитыДокумента.КФОСписания);
	Запрос.УстановитьПараметр("КПС"          , РеквизитыДокумента.КПССписания);
	
	Запрос.Текст = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ
	|	ОстаткиБУ.Субконто1 КАК Субконто1,
	|	ОстаткиБУ.Субконто2 КАК Субконто2,
	|	ОстаткиБУ.Субконто3 КАК Субконто3,
	|	ОстаткиБУ.СуммаОстаток КАК Сумма,
	|	ОстаткиБУ.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет = &Счет,, Организация = &Организация
	|	И ИФО = &ИФО
	|	И КФО = &КФО
	|	И КПС = &КПС
	|	И Подразделение = &Подразделение
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			ВТ.НФА
	|		ИЗ
	|			ВТ КАК ВТ)) КАК ОстаткиБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НФА,
	|	ВТ.Количество,
	|	ВТ.Сумма
	|ИЗ
	|	ВТ КАК ВТ";
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.СчетВложений) Тогда
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РеквизитыДокумента.СчетВложений);
		
		Нс = 1;
		Для Сч = 1 По СвойстваСчета.КоличествоСубконто Цикл
			Если СвойстваСчета["ВидСубконто" + Сч] = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства
				Или СвойстваСчета["ВидСубконто" + Сч] = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
				Нс = Сч;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Субконто1 В", "Субконто" + Нс + " В");
		
		Если Не СвойстваСчета.УчетПоПодразделениям Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение = &Подразделение", "");
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИФО = &ИФО", "");
	КонецЕсли;

	Результат = Запрос.ВыполнитьПакет();
	ОстаткиБУ = Результат[НачальныйИндексЗапроса].Выгрузить();
	ТабЧасть  = Результат[НачальныйИндексЗапроса + 1].Выгрузить();
	
	
	Таблицы = Новый Структура("ОстаткиБУ, ТабЧасть", ОстаткиБУ, ТабЧасть);
	Возврат Таблицы;
КонецФункции	

// Собирает таблицу-источник данных для типовой операции формирования проводок по переносу капвложений
// Таблица формируется путем распределения данных списания из документа по существующим по объекту НФА остаткам
// 
// Параметры:
//  - РеквизитыДокумента - см. ПолучитьТаблицы(РеквизитыДокумента, Нс) 
//
// Возвращаемое значение:
//   - ТаблицаЗначений - колонки:
//     * Субконто1 - ОписаниеТипов - тип субконто счета "Счет" из параметров 
//     * Субконто2 - ОписаниеТипов - тип субконто счета "Счет" из параметров 
//     * Субконто3 - ОписаниеТипов - тип субконто счета "Счет" из параметров 
//     * Сумма - Число - сумма к списанию 
//     * Количество - Число - количество к списанию 
Функция ТаблицаОстатки(РеквизитыДокумента = Неопределено) Экспорт
	
	ОписаниеТипаСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	
	ТаблицаНФА.Колонки.Добавить("Субконто1"	, ОписаниеТипаСубконто);
	ТаблицаНФА.Колонки.Добавить("Субконто2"	, ОписаниеТипаСубконто);
	ТаблицаНФА.Колонки.Добавить("Субконто3"	, ОписаниеТипаСубконто);
	ТаблицаНФА.Колонки.Добавить("Сумма"		, ОписаниеТипаСуммы);
	ТаблицаНФА.Колонки.Добавить("Количество"	, ОписаниеТипаКоличества);

	Если РеквизитыДокумента = Неопределено Тогда
		Возврат ТаблицаНФА;
	КонецЕсли;
	
	Нс = 1;
	Таблицы = ПолучитьТаблицы(РеквизитыДокумента, Нс);
	ОстаткиБУ = Таблицы.ОстаткиБУ;
	ТабЧасть  = Таблицы.ТабЧасть;

	ИмяСубконтоНФА = "Субконто" + Нс;
	СтруктураПоиска = Новый Структура();
	Для каждого СтрокаТЧ из ТабЧасть Цикл
		СтруктураПоиска.Вставить(ИмяСубконтоНФА, СтрокаТЧ.НФА);
		СтрокиОстатки = ОстаткиБУ.НайтиСтроки(СтруктураПоиска);
		Если СтрокиОстатки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Для каждого СтрокаОстатка из СтрокиОстатки Цикл
			СтрокаНФА = ТаблицаНФА.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНФА, СтрокаОстатка, "Субконто1, Субконто2, Субконто3");
			КоличествоКСписанию = Мин(СтрокаТЧ.Количество, СтрокаОстатка.Количество);
			СуммаКСписанию = Мин(СтрокаТЧ.Сумма, СтрокаОстатка.Сумма);

			Если КоличествоКСписанию = 0 И СуммаКСписанию = 0 Тогда
				Прервать;
			КонецЕсли;	  
			
			СтрокаНФА.Количество = КоличествоКСписанию;
			СтрокаНФА.Сумма = СуммаКСписанию;
			
			СтрокаТЧ.Количество = СтрокаТЧ.Количество - СтрокаНФА.Количество;  
			СтрокаТЧ.Сумма = СтрокаТЧ.Сумма - СтрокаНФА.Сумма;  
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ТаблицаНФА;
	
КонецФункции

#КонецОбласти

#КонецЕсли
