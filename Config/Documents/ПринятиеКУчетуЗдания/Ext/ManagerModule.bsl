#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация,Дата,КФО,
		|ВидПоступления,СчетУчетаЗатрат,ПорядокВключенияСтоимостиВСоставРасходовНУ,СтатьяПрочихРасходов,СчетУчета.Забалансовый");
	
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ЗначенияРеквизитов.ВидПоступления);
	ЭтоПоступлениеНаБаланс = Не ЭтоПоступлениеИзПользования И Не ЗначенияРеквизитов.СчетУчетаЗабалансовый; 
	
	// Параметры налогового учета
	ОтражатьВНалоговомУчете = УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ЗначенияРеквизитов);	
	СубконтоНУ = Справочники.ПрочиеДоходыИРасходы.ПустаяСсылка();
	Если ОтражатьВНалоговомУчете Тогда
		Если НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ЗначенияРеквизитов.СчетУчетаЗатрат)
			И ЗначенияРеквизитов.ПорядокВключенияСтоимостиВСоставРасходовНУ <> Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы Тогда
			СубконтоНУ = ЗначенияРеквизитов.СтатьяПрочихРасходов;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"						, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"				, "Принятие к учету здания (сооружения) (ОС-1а)");
	Запрос.УстановитьПараметр("ЭтоПоступлениеИзПользования"	, ЭтоПоступлениеИзПользования);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"		, УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям());
	Запрос.УстановитьПараметр("СубконтоНУ"					, СубконтоНУ);
	Запрос.УстановитьПараметр("ЭтоПоступлениеНаБаланс"		, ЭтоПоступлениеНаБаланс);
	Запрос.УстановитьПараметр("Счет01"						, БухгалтерскийУчет.СписокСчетов("01"));
	Запрос.УстановитьПараметр("Счет02"						, БухгалтерскийУчет.СписокСчетов("02"));
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("МестонахождениеОС", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗдания.Организация КАК Организация,
	|	ПринятиеКУчетуЗдания.ИнвентарныйНомер КАК ИнвНомер,
	|	ПринятиеКУчетуЗдания.ЦМО КАК ЦМО,
	|	ПринятиеКУчетуЗдания.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеИзПользования
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ПринятиеКУчетуЗдания.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
	|						ИЛИ ПринятиеКУчетуЗдания.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|				ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|			КОНЕЦ
	|	КОНЕЦ КАК Состояние,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ПринятиеКУчетуЗдания.Номер КАК НомерДокумента,
	|	ПринятиеКУчетуЗдания.Дата КАК ДатаДокумента,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗдания.Дата КАК Период
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	ПринятиеКУчетуЗдания.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.Организация,
	|	СобытияОС.ИнвНомер,
	|	СобытияОС.Событие,
	|	СобытияОС.ДатаСобытия,
	|	СобытияОС.ДатаДокумента,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	СобытияОС.Номер КАК НомерДокумента,
	|	СобытияОС.Период,
	|	&Ссылка КАК Регистратор
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПринятиеКУчетуЗдания.Номер КАК Номер,
	|		ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|		ПринятиеКУчетуЗдания.Организация КАК Организация,
	|		ПринятиеКУчетуЗдания.ИнвентарныйНомер КАК ИнвНомер,
	|		ВЫБОР
	|			КОГДА ПринятиеКУчетуЗдания.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзАренды)
	|			КОГДА ПринятиеКУчетуЗдания.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|		КОНЕЦ КАК Событие,
	|		ПринятиеКУчетуЗдания.Дата КАК ДатаСобытия,
	|		ПринятиеКУчетуЗдания.Номер КАК НомерДокумента,
	|		ПринятиеКУчетуЗдания.Дата КАК ДатаДокумента,
	|		1 КАК Порядок,
	|		ИСТИНА КАК Включать,
	|		ПринятиеКУчетуЗдания.Дата КАК Период
	|	ИЗ
	|		Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|	ГДЕ
	|		ПринятиеКУчетуЗдания.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПринятиеКУчетуЗдания.Номер,
	|		ПринятиеКУчетуЗдания.ОсновноеСредство,
	|		ПринятиеКУчетуЗдания.Организация,
	|		ПринятиеКУчетуЗдания.ИнвентарныйНомер,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|					ИЛИ ПринятиеКУчетуЗдания.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ПринятиеКУчетуЗдания.Дата
	|			ИНАЧЕ ПринятиеКУчетуЗдания.ДатаВводаВЭксплуатацию
	|		КОНЕЦ,
	|		ПринятиеКУчетуЗдания.Номер,
	|		ПринятиеКУчетуЗдания.Дата,
	|		2,
	|		ВЫБОР
	|			КОГДА &ЭтоПоступлениеИзПользования
	|					ИЛИ ПринятиеКУчетуЗдания.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
	|					ИЛИ ПринятиеКУчетуЗдания.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ,
	|		ПринятиеКУчетуЗдания.Дата
	|	ИЗ
	|		Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|	ГДЕ
	|		ПринятиеКУчетуЗдания.Ссылка = &Ссылка) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.Включать
	|
	|УПОРЯДОЧИТЬ ПО
	|	СобытияОС.Порядок";
	
	НомераТаблиц.Вставить("НачислениеАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗдания.Организация КАК Организация,
	|	ПринятиеКУчетуЗдания.НачислятьАмортизацию,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗдания.Дата КАК Период
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуЗдания.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗдания.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|	И ПринятиеКУчетуЗдания.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииОСБухгалтерскийУчет", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗдания.Организация КАК Организация,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗдания.Дата КАК Период,
	|	ПринятиеКУчетуЗдания.СпособНачисленияАмортизации,
	|	ПринятиеКУчетуЗдания.ПорядокПогашенияСтоимости
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуЗдания.Ссылка = &Ссылка";
	
	НомераТаблиц.Вставить("АмортизацияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗдания.Дата КАК Период,
	|	ПринятиеКУчетуЗдания.СчетУчетаЗатрат,
	|	ПринятиеКУчетуЗдания.КЭКЗатрат КАК КЭК,
	|	ПринятиеКУчетуЗдания.СубконтоЗатрат1 КАК Субконто1,
	|	ПринятиеКУчетуЗдания.СубконтоЗатрат2 КАК Субконто2,
	|	ПринятиеКУчетуЗдания.СубконтоЗатрат3 КАК Субконто3,
	|	&СубконтоНУ КАК СубконтоНУ,
	|	ПринятиеКУчетуЗдания.КПСЗатрат КАК КПС,
	|	ПринятиеКУчетуЗдания.ПодразделениеЗатрат КАК Подразделение,
	|	ПринятиеКУчетуЗдания.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуЗдания.Ссылка = &Ссылка
	|	И (ПринятиеКУчетуЗдания.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ИЛИ ПринятиеКУчетуЗдания.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))";
	
	НомераТаблиц.Вставить("РасчетАмортизацииОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗдания.Дата КАК Период,
	|	ПринятиеКУчетуЗдания.СрокПолезногоИспользования,
	|	ПринятиеКУчетуЗдания.ОставшийсяСрокПолезногоИспользования КАК СрокИспользованияДляВычисленияАмортизации,
	|	ПринятиеКУчетуЗдания.ПервоначальнаяСтоимость - ПринятиеКУчетуЗдания.СуммаАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	ПринятиеКУчетуЗдания.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	НЕ &ЭтоПоступлениеИзПользования
	|	И ПринятиеКУчетуЗдания.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗдания.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|	И ПринятиеКУчетуЗдания.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)";
	
	НомераТаблиц.Вставить("ВТ_Стоимость", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("СтоимостьОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗдания.Дата КАК Период,
	|	ПринятиеКУчетуЗдания.Организация КАК Организация,
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗдания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ПринятиеКУчетуЗдания.ЦМО КАК ЦМО,
	|	ПринятиеКУчетуЗдания.ЦМООтправитель КАК ЦМООтправитель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ПринятиеКУчетуЗдания.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ПринятиеКУчетуЗдания.ПодразделениеОтправитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеОтправитель,
	|	ПринятиеКУчетуЗдания.ПервоначальнаяСтоимость КАК Стоимость,
	|	1 КАК Количество,
	|	&ИмяДокумента КАК НазваниеДокумента,
