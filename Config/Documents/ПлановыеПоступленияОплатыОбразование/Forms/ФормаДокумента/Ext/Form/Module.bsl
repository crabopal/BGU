&НаКлиенте
Процедура УчащиесяПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.Учащиеся.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		
		Если НЕ Копирование Тогда
			
			ТекущаяСтрока.НачалоПериода = Объект.НачалоПериода;
			ТекущаяСтрока.НачалоПериодаСтрокой = РаботаСоСтудентамиКлиентСервер.ПолучитьПредставлениеМесяца(Объект.НачалоПериода);
			ТекущаяСтрока.КонецПериода = Объект.КонецПериода;
			ТекущаяСтрока.КонецПериодаСтрокой = РаботаСоСтудентамиКлиентСервер.ПолучитьПредставлениеМесяца(Объект.КонецПериода);
			
			ТекущаяСтрока.ДатаОплаты = Объект.ДатаОплаты;
			
		Иначе	
			ТекущаяСтрока.ИДСтроки = "";
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УчащиесяУчащийсяПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Учащиеся.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату", Объект.Дата);
	Если ЗначениеЗаполнено(Объект.Факультет) Тогда
		Отбор.Вставить("Факультет", Объект.Факультет);
	КонецЕсли;
	
	ПараметрыАвтоподстановки = ПараметрыАвтоподстановкиДанныхПоСтуденту(ТекущиеДанные.Учащийся, Отбор);
	
	Если ПараметрыАвтоподстановки.Договоры.Количество() = 1 Тогда
		ТекущиеДанные.ДоговорКонтрагента = ПараметрыАвтоподстановки.Договоры[0]; // Единственный доступный вариант.
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.ДоговорКонтрагента) И ПараметрыАвтоподстановки.Договоры.Найти(ТекущиеДанные.ДоговорКонтрагента) = Неопределено Тогда
		ТекущиеДанные.ДоговорКонтрагента = Неопределено; // Выбранный договор отсутствует среди доступных.
	КонецЕсли;
	Если ПараметрыАвтоподстановки.Плательщики.Количество() = 1 Тогда
		ТекущиеДанные.Контрагент = ПараметрыАвтоподстановки.Плательщики[0]; // Единственный доступный вариант.
	ИначеЕсли ЗначениеЗаполнено(ТекущиеДанные.Контрагент) И ПараметрыАвтоподстановки.Плательщики.Найти(ТекущиеДанные.Контрагент) = Неопределено Тогда
		ТекущиеДанные.Контрагент = Неопределено; // Выбранный контрагент отсутствует среди доступных.
	КонецЕсли;
	
	ТекущиеДанные.АвтоРасчет = Ложь;
	ТекущиеДанные.Сумма = 0;
	
КонецПроцедуры

