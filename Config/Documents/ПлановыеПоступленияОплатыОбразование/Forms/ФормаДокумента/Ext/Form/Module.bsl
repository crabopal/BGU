#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьУчащимися(Команда)
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Объект.Организация.Пустая() Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Организация"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Организация", "Объект", Отказ);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Факультет"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда 
		
		Если Объект.Учащиеся.Количество() > 0 Тогда
			ДопПараметры = Новый Структура("ИмяМакета", "ПодборСПлательщиком");
			
			ТекстВопроса = НСтр("ru='Документ уже заполнен, выберите необходимое действие:'"); 
			СписокКнопок = Новый СписокЗначений;
			СписокКнопок.Добавить("Перезаполнить", "Перезаполнить документ");
			СписокКнопок.Добавить("Добавить", "Добавить по отбору");
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
			
			Оповещение = Новый ОписаниеОповещения("ОбработкаВопросаПередЗаполнением", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, ТекстВопроса, СписокКнопок, , КодВозвратаДиалога.Отмена);
		Иначе
			ВызватьОкноОтбора("ПодборСПлательщиком");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуОплаты(Команда)
	
	Отказ = Ложь; 
	
	Если НЕ ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Факультет"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Валюта"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "ВалютаДокумента", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если Объект.ИспользоватьОдинПериод Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
			ТекстОшибки = НСтр("ru='Поле ""Начало периода"" не заполнено!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "НачалоПериодаСтрокой",, Отказ);		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
			ТекстОшибки = НСтр("ru='Поле ""Конец периода"" не заполнено!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "КонецПериодаСтрокой",, Отказ);		
		КонецЕсли;
		
	Иначе
		
		Для каждого СтрокаТЧ Из Объект.Учащиеся Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НачалоПериода) Тогда
				
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Начало периода"" в строке " + СтрокаТЧ.НомерСтроки + " списка ""Учащиеся""'");
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", СтрокаТЧ.НомерСтроки, "НачалоПериодаСтрокой");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект", Отказ);
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КонецПериода) Тогда
				
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Конец периода"" в строке " + СтрокаТЧ.НомерСтроки + " списка ""Учащиеся""'");
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", СтрокаТЧ.НомерСтроки, "КонецПериодаСтрокой");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		РассчитатьСуммуОплатыСервер(Истина);
		
		ТекстОповещения = НСтр("ru = 'Расчет сумм оплат'");
		ТекстПояснение = НСтр("ru = 'Суммы оплат заполнены'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснение);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуОплатыВыделенныхСтрок(Команда)
	
	Отказ = Ложь; 
	
	Если НЕ ЗначениеЗаполнено(Объект.Факультет) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Факультет"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "Факультет", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		
		ТекстОшибки = НСтр("ru='Поле ""Валюта"" не заполнено!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "ВалютаДокумента", "Объект", Отказ);		
		
	КонецЕсли;
	
	Если Объект.ИспользоватьОдинПериод Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.НачалоПериода) Тогда
			ТекстОшибки = НСтр("ru='Поле ""Начало периода"" не заполнено!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "НачалоПериодаСтрокой",, Отказ);		
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.КонецПериода) Тогда
			ТекстОшибки = НСтр("ru='Поле ""Конец периода"" не заполнено!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, "КонецПериодаСтрокой",, Отказ);		
		КонецЕсли;
		
	Иначе
		
		Для каждого ИдентификаторВыделеннойСтроки Из Элементы.Учащиеся.ВыделенныеСтроки Цикл
			
			СтрокаТЧ = Объект.Учащиеся.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.НачалоПериода) Тогда
				
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Начало периода"" в строке " + СтрокаТЧ.НомерСтроки + " списка ""Учащиеся""'");
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", СтрокаТЧ.НомерСтроки, "НачалоПериодаСтрокой");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект", Отказ);
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.КонецПериода) Тогда
				
				ТекстОшибки = НСтр("ru='Не заполнена колонка ""Конец периода"" в строке " + СтрокаТЧ.НомерСтроки + " списка ""Учащиеся""'");
				Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", СтрокаТЧ.НомерСтроки, "КонецПериодаСтрокой");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,, Поле, "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		РассчитатьСуммуОплатыСервер();
		
		ТекстОповещения = НСтр("ru = 'Расчет сумм оплат'");
		ТекстПояснение = НСтр("ru = 'Суммы оплат заполнены'");
		ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснение);
		
	КонецЕсли; 
	
КонецПроцедуры

