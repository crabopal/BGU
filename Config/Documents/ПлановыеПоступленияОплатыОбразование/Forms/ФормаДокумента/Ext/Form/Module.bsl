КонецФункции

&НаСервере
Процедура УстановитьПредупреждение()
	
	Если Объект.Учащиеся.Количество() > 0 Тогда
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;	
		
	Иначе
		
		Элементы.Организация.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
		Элементы.Факультет.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.НеОтображать;	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчащимисяСервер(Адреса)
	
   ДанныеОтчета = РаботаСоСтудентами.ПолучитьДанныеПодбораУчащихся(Адреса, Объект.Организация, Объект.Факультет, Объект.Дата);
   ДополненныеДанные = РаботаСоСтудентами.ОтобратьКраткосрочныеДоговоры(ДанныеОтчета, Объект.Организация, Объект.Факультет, Объект.КонецПериода);
   
	Для каждого СтрокаДанных Из ДополненныеДанные Цикл
		
		НоваяСтрока = Объект.Учащиеся.Добавить();
		НоваяСтрока.Учащийся = СтрокаДанных.Студент;
		НоваяСтрока.Контрагент = СтрокаДанных.Контрагент;
		НоваяСтрока.ДоговорКонтрагента = СтрокаДанных.ДоговорКонтрагента;
		
		Если Объект.ИспользоватьОдинПериод Тогда
			
			НоваяСтрока.НачалоПериода = Объект.НачалоПериода;
			НоваяСтрока.КонецПериода = Объект.КонецПериода;
			
		КонецЕсли; 
		
		Если Объект.ИспользоватьОднуДатуОплаты Тогда
			
			НоваяСтрока.ДатаОплаты = Объект.ДатаОплаты;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	УстановитьПредупреждение();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоПериодуРасчета()
	
	Элементы.УчащиесяГруппаПериодОплаты.Видимость = НЕ Объект.ИспользоватьОдинПериод;
	Элементы.НачалоПериодаСтрокой.Доступность = Объект.ИспользоватьОдинПериод;
	Элементы.КонецПериодаСтрокой.Доступность = Объект.ИспользоватьОдинПериод;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПоПериодуОплаты()
	
	Элементы.УчащиесяДатаОплаты.Видимость = НЕ Объект.ИспользоватьОднуДатуОплаты;
	Элементы.УчащиесяЗаполнитьДатуОплаты.Видимость = НЕ Объект.ИспользоватьОднуДатуОплаты;
	Элементы.ДатаОплаты.Доступность = Объект.ИспользоватьОднуДатуОплаты

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитТЧ(ИмяРеквизита, Значение)
	
	Для каждого Строка Из Объект.Учащиеся Цикл
			
		Строка[ИмяРеквизита] = Значение;
		Строка.АвтоРасчет = Ложь;
			
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуДляРасчета(ПоВсемСтрокам)
	
	ТаблицаДляРасчета = Новый ТаблицаЗначений;
	ТаблицаДляРасчета.Колонки.Добавить("Факультет", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Подразделения"));
	ТаблицаДляРасчета.Колонки.Добавить("Студент", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Студенты"));
	ТаблицаДляРасчета.Колонки.Добавить("Период", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаДляРасчета.Колонки.Добавить("ПериодОкончания", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	
	Если ПоВсемСтрокам Тогда
		
		Для каждого СтрокаТЧ Из Объект.Учащиеся Цикл
			
			НоваяСтрока = ТаблицаДляРасчета.Добавить();
			НоваяСтрока.Факультет = Объект.Факультет;
			НоваяСтрока.Студент = СтрокаТЧ.Учащийся;
			НоваяСтрока.Период = СтрокаТЧ.НачалоПериода;
			НоваяСтрока.ПериодОкончания = СтрокаТЧ.КонецПериода;
			
		КонецЦикла; 
		
	Иначе
		
		Для каждого ИдентификаторВыделеннойСтроки Из Элементы.Учащиеся.ВыделенныеСтроки Цикл
			
			СтрокаТЧ = Объект.Учащиеся.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
			НоваяСтрока = ТаблицаДляРасчета.Добавить();
			НоваяСтрока.Факультет = Объект.Факультет;
			НоваяСтрока.Студент = СтрокаТЧ.Учащийся;
			НоваяСтрока.Период = СтрокаТЧ.НачалоПериода;
			НоваяСтрока.ПериодОкончания = СтрокаТЧ.КонецПериода;
			
		КонецЦикла; 
				
	КонецЕсли; 

	Возврат ТаблицаДляРасчета;

КонецФункции 

&НаСервере
Процедура РассчитатьСуммуОплатыСервер(ПоВсемСтрокам = Ложь)
	
	ПараметрыРасчета = РаботаСоСтудентами.ПолучитьСтруктуруПараметровРасчета();
	ТаблицаДляРасчета = ПолучитьТаблицуДляРасчета(ПоВсемСтрокам);
	ДеревоПериодов = РаботаСоСтудентами.СформироватьДеревоПериодов(ТаблицаДляРасчета);
	
	ТаблицаРасчетовПоПериодам = Новый ТаблицаЗначений;
	ТаблицаРасчетовПоПериодам.Колонки.Добавить("Период", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаРасчетовПоПериодам.Колонки.Добавить("Студент", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Студенты"));
	ТаблицаРасчетовПоПериодам.Колонки.Добавить("Контрагент", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Контрагенты"));
	ТаблицаРасчетовПоПериодам.Колонки.Добавить("ДоговорКонтрагента", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Договоры"));
	ТаблицаРасчетовПоПериодам.Колонки.Добавить("Сумма", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	
	Для каждого СтрокаПериода Из ДеревоПериодов.Строки Цикл
		
		Период = СтрокаПериода.Период;
		
		Для каждого СтрокаФакультета Из СтрокаПериода.Строки Цикл

			Факультет = СтрокаФакультета.Факультет;
			МассивУчащихся = Новый Массив;
			
			Для каждого СтрокаСтудента Из СтрокаФакультета.Строки Цикл			
				МассивУчащихся.Добавить(СтрокаСтудента.Студент);					
			КонецЦикла; 
			
			ПараметрыРасчета.Период = Период;
			ПараметрыРасчета.Факультет = Факультет;
			ПараметрыРасчета.Учащиеся = МассивУчащихся;
			ПараметрыРасчета.Валюта = Объект.ВалютаДокумента;
			ПараметрыРасчета.ВидНачисления = "НачислениеЗаУслугиОбразования";
			
			ПараметрыРасчета.Вставить("ИмяМакета", "СборДанныхНачислений");
			ПараметрыРасчета.Вставить("Организация", Объект.Организация);
			
			ДанныеРасчета = РаботаСоСтудентами.РассчитатьНачисления(ПараметрыРасчета);
			
			Для каждого СтрокаДанных Из ДанныеРасчета Цикл
				
				НоваяСтрока = ТаблицаРасчетовПоПериодам.Добавить();
				НоваяСтрока.Период = Период;
				НоваяСтрока.Студент = СтрокаДанных.Студент;
				НоваяСтрока.Контрагент = СтрокаДанных.Контрагент;
				НоваяСтрока.ДоговорКонтрагента = СтрокаДанных.ДоговорКонтрагента;
				НоваяСтрока.Сумма = СтрокаДанных.Сумма;
				
			КонецЦикла; 
			
		КонецЦикла; 
	КонецЦикла;
	
	Если ПоВсемСтрокам Тогда
		
		ЗаполнитьСуммыОплатыПоВсемСтрокам(ТаблицаРасчетовПоПериодам);
		
	Иначе
		
		ЗаполнитьСуммыОплатыПоВыделеннымСтрокам(ТаблицаРасчетовПоПериодам);
		
	КонецЕсли; 
	
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставлениеВТабличнойЧасти(Объект.Учащиеся, "НачалоПериода", "НачалоПериодаСтрокой");
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставлениеВТабличнойЧасти(Объект.Учащиеся, "КонецПериода", "КонецПериодаСтрокой");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммыОплатыПоВсемСтрокам(ТаблицаРасчетовПоПериодам)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаРасчета.Студент,
				   |	ТаблицаРасчета.Контрагент,
				   |	ТаблицаРасчета.ДоговорКонтрагента,
	               |	ТаблицаРасчета.Сумма,
	               |	ТаблицаРасчета.Период
	               |ПОМЕСТИТЬ ТаблицаСумм
	               |ИЗ
	               |	&ТаблицаРасчета КАК ТаблицаРасчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Учащиеся.НомерСтроки,
	               |	Учащиеся.Учащийся,
	               |	Учащиеся.Контрагент,
	               |	Учащиеся.ДоговорКонтрагента,
	               |	Учащиеся.НачалоПериода,
	               |	Учащиеся.КонецПериода,
	               |	Учащиеся.ДатаОплаты
	               |ПОМЕСТИТЬ ТаблицаУчащихся
	               |ИЗ
	               |	&Учащиеся КАК Учащиеся
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаУчащихся.НомерСтроки КАК НомерСтроки,
	               |	ТаблицаУчащихся.Учащийся,
	               |	ТаблицаУчащихся.Контрагент,
	               |	ТаблицаУчащихся.ДоговорКонтрагента,
	               |	ТаблицаУчащихся.НачалоПериода,
	               |	ТаблицаУчащихся.КонецПериода,
	               |	ТаблицаУчащихся.ДатаОплаты,
	               |	СУММА(ЕСТЬNULL(ТаблицаСумм.Сумма, 0)) КАК Сумма,
	               |	ИСТИНА КАК АвтоРасчет
	               |ИЗ
	               |	ТаблицаУчащихся КАК ТаблицаУчащихся
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСумм КАК ТаблицаСумм
				   |		ПО ТаблицаУчащихся.Учащийся = ТаблицаСумм.Студент
	               |			И ТаблицаУчащихся.Контрагент = ТаблицаСумм.Контрагент
				   |			И ТаблицаУчащихся.ДоговорКонтрагента = ТаблицаСумм.ДоговорКонтрагента
				   |			И ТаблицаУчащихся.НачалоПериода <= ТаблицаСумм.Период
	               |			И ТаблицаУчащихся.НачалоПериода <= ТаблицаСумм.Период
	               |			И ТаблицаУчащихся.КонецПериода >= ТаблицаСумм.Период
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаУчащихся.ДатаОплаты,
	               |	ТаблицаУчащихся.НомерСтроки,
	               |	ТаблицаУчащихся.Учащийся,
	               |	ТаблицаУчащихся.Контрагент,
	               |	ТаблицаУчащихся.ДоговорКонтрагента,
	               |	ТаблицаУчащихся.КонецПериода,
	               |	ТаблицаУчащихся.НачалоПериода
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("ТаблицаРасчета", ТаблицаРасчетовПоПериодам);
	Запрос.УстановитьПараметр("Учащиеся", Объект.Учащиеся.Выгрузить());
	
	Объект.Учащиеся.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСуммыОплатыПоВыделеннымСтрокам(ТаблицаРасчетовПоПериодам)
	
	ТаблицаВыделенныхСтрок = Новый ТаблицаЗначений;
	ТаблицаВыделенныхСтрок.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ТаблицаВыделенныхСтрок.Колонки.Добавить("Учащийся", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Студенты"));
	ТаблицаВыделенныхСтрок.Колонки.Добавить("Контрагент", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Контрагенты"));
	ТаблицаВыделенныхСтрок.Колонки.Добавить("ДоговорКонтрагента", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСсылка("СправочникСсылка.Договоры"));
	ТаблицаВыделенныхСтрок.Колонки.Добавить("НачалоПериода", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	ТаблицаВыделенныхСтрок.Колонки.Добавить("КонецПериода", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.Дата));
	
	Для каждого ИдентификаторВыделеннойСтроки Из Элементы.Учащиеся.ВыделенныеСтроки Цикл
			
		СтрокаТЧ = Объект.Учащиеся.НайтиПоИдентификатору(ИдентификаторВыделеннойСтроки);
		НоваяСтрока = ТаблицаВыделенныхСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
	КонецЦикла;

	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаРасчета.Студент,
				   |	ТаблицаРасчета.Контрагент,
				   |	ТаблицаРасчета.ДоговорКонтрагента,
	               |	ТаблицаРасчета.Сумма,
	               |	ТаблицаРасчета.Период
	               |ПОМЕСТИТЬ ТаблицаСумм
	               |ИЗ
	               |	&ТаблицаРасчета КАК ТаблицаРасчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаВыделенныхСтрок.НомерСтроки,
	               |	ТаблицаВыделенныхСтрок.Учащийся,
				   |	ТаблицаВыделенныхСтрок.Контрагент,
	               |	ТаблицаВыделенныхСтрок.ДоговорКонтрагента,
	               |	ТаблицаВыделенныхСтрок.НачалоПериода,
	               |	ТаблицаВыделенныхСтрок.КонецПериода
	               |ПОМЕСТИТЬ ТаблицаУчащихся
	               |ИЗ
	               |	&ТаблицаВыделенныхСтрок КАК ТаблицаВыделенныхСтрок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаУчащихся.НомерСтроки,
	               |	СУММА(ЕСТЬNULL(ТаблицаСумм.Сумма, 0)) КАК Сумма
	               |ИЗ
	               |	ТаблицаУчащихся КАК ТаблицаУчащихся
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСумм КАК ТаблицаСумм
	               |		ПО ТаблицаУчащихся.Учащийся = ТаблицаСумм.Студент
				   |			И ТаблицаУчащихся.Контрагент = ТаблицаСумм.Контрагент
				   |			И ТаблицаУчащихся.ДоговорКонтрагента = ТаблицаСумм.ДоговорКонтрагента
	               |			И ТаблицаУчащихся.НачалоПериода <= ТаблицаСумм.Период
	               |			И ТаблицаУчащихся.КонецПериода >= ТаблицаСумм.Период
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаУчащихся.НомерСтроки";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаРасчета", ТаблицаРасчетовПоПериодам);
	Запрос.УстановитьПараметр("ТаблицаВыделенныхСтрок", ТаблицаВыделенныхСтрок);
	
   Выборка = Запрос.Выполнить().Выбрать();
   Пока Выборка.Следующий() Цикл
	   
	   Объект.Учащиеся[Выборка.НомерСтроки - 1].Сумма = Выборка.Сумма;
	   Объект.Учащиеся[Выборка.НомерСтроки - 1].АвтоРасчет = Истина;
	   
   КонецЦикла; 
	
КонецПроцедуры

