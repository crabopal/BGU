#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда
		
		ВалютаДокумента = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если НЕ ИспользоватьОдинПериод Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("НачалоПериода");
		МассивНепроверяемыхРеквизитов.Добавить("КонецПериода");
		
	КонецЕсли; 
	
	Если НЕ ИспользоватьОднуДатуОплаты Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("ДатаОплаты");
		
	КонецЕсли; 
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	Для каждого СтрокаТЧ Из Учащиеся Цикл
		
		ПроверитьРеквизитТЧ(СтрокаТЧ, "Контрагент", "Контрагент",, Отказ);
		ПроверитьРеквизитТЧ(СтрокаТЧ, "ДоговорКонтрагента", "Договор контрагента",, Отказ);
		
		Если НЕ СтрокаТЧ.Аннуляция Тогда
			
			ПроверитьРеквизитТЧ(СтрокаТЧ, "Сумма", "Сумма",, Отказ);
		 
		 	Если НЕ ИспользоватьОдинПериод Тогда
				
				ПроверитьРеквизитТЧ(СтрокаТЧ, "НачалоПериода", "Начало периода", "НачалоПериодаСтрокой", Отказ);
				ПроверитьРеквизитТЧ(СтрокаТЧ, "КонецПериода", "Конец периода", "КонецПериодаСтрокой", Отказ);
							
			КонецЕсли;
			
		КонецЕсли; 
				
		Если НЕ ИспользоватьОднуДатуОплаты Тогда
			
			ПроверитьРеквизитТЧ(СтрокаТЧ, "ДатаОплаты", "Дата оплаты",, Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПроверитьДублиСтрок(Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	МассивИдентификаторовСтрок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		//Если ссылка пустая, значит документ новый, устанавливаем новые идентификаторы всем строкам
		Для Каждого СтрТЧ Из Учащиеся Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);			
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	Иначе
		//Если ссылка не пустая, нужен анализ идентификаторов строк.
		//Т.к. возможна ситуация, когда строку скопировали, а исходную - удалили.
		//В этом случае нужно ранее присвоенные идентификаторы назначить новым строкам.
		Запрос = Новый Запрос("ВЫБРАТЬ
          |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
          |	НачислениеРодительскойПлатыНачисления.Учащийся КАК Учащийся,
          |	НачислениеРодительскойПлатыНачисления.Контрагент,
          |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
          |	НачислениеРодительскойПлатыНачисления.ИДСтроки
          |ПОМЕСТИТЬ ТекущиеНачисления
          |ИЗ
          |	&Начисления КАК НачислениеРодительскойПлатыНачисления
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
          |	НачислениеРодительскойПлатыНачисления.Учащийся КАК Учащийся,
          |	НачислениеРодительскойПлатыНачисления.Контрагент,
          |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
          |	НачислениеРодительскойПлатыНачисления.ИДСтроки
          |ПОМЕСТИТЬ ДанныеДокумента
          |ИЗ
          |	Документ.ПлановыеПоступленияОплатыОбразование.Учащиеся КАК НачислениеРодительскойПлатыНачисления
          |ГДЕ
          |	НачислениеРодительскойПлатыНачисления.Ссылка = &Ссылка
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	ТекущиеНачисления.НомерСтроки,
          |	ТекущиеНачисления.Учащийся,
          |	ТекущиеНачисления.Контрагент,
          |	ТекущиеНачисления.ДоговорКонтрагента,
          |	ТекущиеНачисления.ИДСтроки,
          |	ДанныеДокумента.НомерСтроки КАК НомерСтрокиИсх,
          |	ДанныеДокумента.ИДСтроки КАК ИДСтрокиИсх,
          |	ДанныеДокумента.Учащийся КАК УчащийсяИсх,
          |	ДанныеДокумента.Контрагент КАК КонтрагентИсх,
          |	ДанныеДокумента.ДоговорКонтрагента КАК ДоговорКонтрагентаИсх
          |ПОМЕСТИТЬ СвязанныеТаблицы
          |ИЗ
          |	ТекущиеНачисления КАК ТекущиеНачисления
          |		ПОЛНОЕ СОЕДИНЕНИЕ ДанныеДокумента КАК ДанныеДокумента
          |		ПО ТекущиеНачисления.Учащийся = ДанныеДокумента.Учащийся
          |			И ТекущиеНачисления.Контрагент = ДанныеДокумента.Контрагент
          |			И ТекущиеНачисления.ДоговорКонтрагента = ДанныеДокумента.ДоговорКонтрагента
          |			И ТекущиеНачисления.ИДСтроки = ДанныеДокумента.ИДСтроки
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	СвязанныеТаблицы.НомерСтрокиИсх,
          |	СвязанныеТаблицы.ИДСтрокиИсх,
          |	СвязанныеТаблицы.УчащийсяИсх,
          |	СвязанныеТаблицы.КонтрагентИсх,
          |	СвязанныеТаблицы.ДоговорКонтрагентаИсх
          |ПОМЕСТИТЬ СвободныеИдентификаторы
          |ИЗ
          |	СвязанныеТаблицы КАК СвязанныеТаблицы
          |ГДЕ
          |	СвязанныеТаблицы.НомерСтроки ЕСТЬ NULL 
          |;
          |
          |////////////////////////////////////////////////////////////////////////////////
          |ВЫБРАТЬ
          |	СвязанныеТаблицы.НомерСтроки КАК НомерСтроки,
          |	СвободныеИдентификаторы.ИДСтрокиИсх
          |ИЗ
          |	СвязанныеТаблицы КАК СвязанныеТаблицы
          |		ЛЕВОЕ СОЕДИНЕНИЕ СвободныеИдентификаторы КАК СвободныеИдентификаторы
          |		ПО СвязанныеТаблицы.Учащийся = СвободныеИдентификаторы.УчащийсяИсх
          |			И СвязанныеТаблицы.Контрагент = СвободныеИдентификаторы.КонтрагентИсх
          |			И СвязанныеТаблицы.ДоговорКонтрагента = СвободныеИдентификаторы.ДоговорКонтрагентаИсх
          |ГДЕ
          |	СвязанныеТаблицы.НомерСтрокиИсх ЕСТЬ NULL
		  |	И НЕ СвободныеИдентификаторы.ИДСтрокиИсх ЕСТЬ NULL
          |
          |УПОРЯДОЧИТЬ ПО
          |	НомерСтроки
          |ИТОГИ ПО
          |	НомерСтроки");
							  
		Запрос.УстановитьПараметр("Начисления",Учащиеся.Выгрузить());
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Для Каждого СтрТЧ Из Учащиеся Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда
				Если Выборка.НайтиСледующий(Новый Структура("НомерСтроки",СтрТЧ.НомерСтроки)) Тогда
					ВыборкаДетальная = Выборка.Выбрать();
					Пока ВыборкаДетальная.Следующий() Цикл
						Если МассивИдентификаторовСтрок.Найти(ВыборкаДетальная.ИДСтрокиИсх) = Неопределено Тогда
							СтрТЧ.ИДСтроки = ВыборкаДетальная.ИДСтрокиИсх;						
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрТЧ.ИДСтроки) Тогда							
					СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			ИначеЕсли МассивИдентификаторовСтрок.Найти(СтрТЧ.ИДСтроки)<>Неопределено Тогда
				СтрТЧ.ИДСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			МассивИдентификаторовСтрок.Добавить(СтрТЧ.ИДСтроки);
		КонецЦикла;
	КонецЕсли;

		
	Для каждого СтрокаТЧ Из Учащиеся Цикл
		
		Если СтрокаТЧ.Аннуляция Тогда
			
			СтрокаТЧ.Сумма = 0;
			СтрокаТЧ.НачалоПериода = Неопределено;
			СтрокаТЧ.КонецПериода = Неопределено;
			СтрокаТЧ.АвтоРасчет = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	Документы.ПлановыеПоступленияОплатыОбразование.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "ПлановыеДатыОплатыОбразование");
	
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьДублиСтрок(Отказ)
	
	Если ИспользоватьОднуДатуОплаты Тогда
		ШаблонТекстДублей = НСтр("ru = 'Студент ""%1"" указан в списке более одного раза!'");
	Иначе
		ШаблонТекстДублей = НСтр("ru = 'Студент ""%1"" указан в списке более одного раза для даты оплаты %2!'");
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Учащиеся.НомерСтроки,
	               |	Учащиеся.Учащийся,
	               |	Учащиеся.ДатаОплаты
	               |ПОМЕСТИТЬ ТаблицаУчащихся
	               |ИЗ
	               |	&Учащиеся КАК Учащиеся
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МАКСИМУМ(ТаблицаУчащихся.НомерСтроки) КАК НомерСтроки,
	               |	ТаблицаУчащихся.Учащийся,
	               |	ТаблицаУчащихся.ДатаОплаты
	               |ИЗ
	               |	ТаблицаУчащихся КАК ТаблицаУчащихся
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаУчащихся.Учащийся,
	               |	ТаблицаУчащихся.ДатаОплаты
	               |
	               |ИМЕЮЩИЕ
	               |	КОЛИЧЕСТВО(*) > 1";
	Запрос.Текст = ТекстЗапроса; 
	Запрос.УстановитьПараметр("Учащиеся", Учащиеся.Выгрузить(, "НомерСтроки, Учащийся, ДатаОплаты")) ;
	
	ВыборкаДублей = Запрос.Выполнить().Выбрать();
	Пока ВыборкаДублей.Следующий() Цикл
		
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонТекстДублей,
			ВыборкаДублей.Учащийся,
			Формат(ВыборкаДублей.ДатаОплаты, "ДЛФ=DD")
		);
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", ВыборкаДублей.НомерСтроки, "Учащийся");
		ОбщегоНазначения.СообщитьПользователю(Текст, ЭтотОбъект, Поле,, Отказ);
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПроверитьРеквизитТЧ(СтрокаТЧ, ИмяРеквизита, Представление, ИмяРеквизитаПривязки = Неопределено, Отказ)
	
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяРеквизита]) Тогда
				
		ТекстОшибки = НСтр("ru='Не заполнена колонка """ + Представление + """ в строке " + СтрокаТЧ.НомерСтроки + " списка ""Учащиеся""'");
		Поле = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Учащиеся", СтрокаТЧ.НомерСтроки, ?(ИмяРеквизитаПривязки = Неопределено, ИмяРеквизита, ИмяРеквизитаПривязки));
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, Поле,, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли