&НаКлиенте
Процедура ОбновитьПоказателиВСтроке(ИмяТабличнойЧасти, Элемент)
	
	ТекДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяИзмененногоПоля = СтрЗаменить(Элемент.Имя, ИмяТабличнойЧасти, "");
	
	ИнвентаризацияКлиент.ОбновитьПоказателиВСтроке0510468СоСтатусамиЗадолженности(ТекДанные, ИмяИзмененногоПоля, ВалютаРУ);
	
	НастроитьФлажкиСуммаТребуетРеклассификации(ТекДанные, ИмяИзмененногоПоля, ИмяТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФлажкиСуммаТребуетРеклассификации(ТекДанные, ИмяИзмененногоПоля, ИмяТабличнойЧасти)
	
	ИменаПолейСуммСФлажкомАвторасчет = Новый Массив();
	ИменаПолейСуммСФлажкомАвторасчет.Добавить("СуммаВалПросроченная");
	ИменаПолейСуммСФлажкомАвторасчет.Добавить("СуммаРубПросроченная");
	
	СписокОписанийПолей = Новый Массив();
	
	ОписаниеПолей = НовыйОписаниеПолейУстановкиФлажковСуммаТребуетРеклассификации();
	ОписаниеПолей.ИмяПоляФлажка = "ПросроченнаяСуммаТребуетРеклассификации";
	ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаВалПросроченная");
	ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаРубПросроченная");
	СписокОписанийПолей.Добавить(ОписаниеПолей);
	
	Если ИмяТабличнойЧасти = "Раздел21" Тогда
		ОписаниеПолей = НовыйОписаниеПолейУстановкиФлажковСуммаТребуетРеклассификации();
		ОписаниеПолей.ИмяПоляФлажка = "СомнительнаяСуммаТребуетРеклассификации";
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаВалСомнительная");
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаРубСомнительная");
		СписокОписанийПолей.Добавить(ОписаниеПолей);
		
		ОписаниеПолей = НовыйОписаниеПолейУстановкиФлажковСуммаТребуетРеклассификации();
		ОписаниеПолей.ИмяПоляФлажка = "БезнадежнаяСуммаТребуетРеклассификации";
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаВалБезнадежная");
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаРубБезнадежная");
		СписокОписанийПолей.Добавить(ОписаниеПолей);
		
	ИначеЕсли ИмяТабличнойЧасти = "Раздел22" Тогда
		ОписаниеПолей = НовыйОписаниеПолейУстановкиФлажковСуммаТребуетРеклассификации();
		ОписаниеПолей.ИмяПоляФлажка = "СуммаСИстекшимСрокомДавностиТребуетРеклассификации";
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаВалСИстекшимСрокомДавности");
		ОписаниеПолей.ИменаПолейСумм.Добавить("СуммаРубСИстекшимСрокомДавности");
		СписокОписанийПолей.Добавить(ОписаниеПолей);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	Для Каждого ОписаниеПолей Из СписокОписанийПолей Цикл
		ИмяПоляВал = ОписаниеПолей.ИменаПолейСумм[0];
		ИмяПоляРуб = ОписаниеПолей.ИменаПолейСумм[1];
		
		ЭтоИзмененноеПоле = (ИмяИзмененногоПоля = ИмяПоляВал Или ИмяИзмененногоПоля = ИмяПоляРуб);
		
		ЭтоПолеСФлажкомАвторасчет = (ИменаПолейСуммСФлажкомАвторасчет.Найти(ИмяПоляВал) <> Неопределено
			Или ИменаПолейСуммСФлажкомАвторасчет.Найти(ИмяПоляРуб) <> Неопределено);
		
		ЕстьЗаполненнаяСумма = ЗначениеЗаполнено(ТекДанные[ИмяПоляВал])
			Или ЗначениеЗаполнено(ТекДанные[ИмяПоляРуб]);
		
		Если ЭтоИзмененноеПоле Тогда
			ЗначениеФлажка = ЕстьЗаполненнаяСумма;
			
		ИначеЕсли ЭтоПолеСФлажкомАвторасчет И Не ЕстьЗаполненнаяСумма Тогда
			// Если сумма чуть ранее была очищена автоматически из-за пересчета граф 14.01, 14.02, 14.03,
			// то нужно сбросить соответствующий флажок.
			ЗначениеФлажка = Ложь;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТекДанные[ОписаниеПолей.ИмяПоляФлажка] = ЗначениеФлажка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НовыйОписаниеПолейУстановкиФлажковСуммаТребуетРеклассификации()
	
	ОписаниеПолей = Новый Структура();
	ОписаниеПолей.Вставить("ИмяПоляФлажка", "");
	ОписаниеПолей.Вставить("ИменаПолейСумм", Новый Массив());
	
	Возврат ОписаниеПолей;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеСпискаСчетов(СписокСчетов, МаксимальнаяДлинаСтроки = 50)
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаТаблицы.КФО), Строка(СтрокаТаблицы.КФО), "0"),
			Строка(СтрокаТаблицы.Счет)));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Представление = НСтр("ru='<отсутствует>'");
	Иначе
		Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "), МаксимальнаяДлинаСтроки);
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти)
	
	КоличествоСтрок = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок);
	
	ОткрытьФорму("Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок)
	
	Если ИмяТабличнойЧасти = "Раздел11" Или ИмяТабличнойЧасти = "Раздел21" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская");
	Иначе
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская");
	КонецЕсли;
	
	СвязиПараметровВыбора = Новый Структура("Дата,ДатаИнвентаризации,Организация,ИФО,Подразделение,ВидЗадолженности");
	
	ЗаполнитьЗначенияСвойств(СвязиПараметровВыбора, Объект);
	
	СвязиПараметровВыбора.ВидЗадолженности = ВидЗадолженности;
	
	ЗначенияЗаполнения = Новый Структура();
	
	ТекДанные = Элементы[ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("ЗаключениеКомиссии",				ТекДанные.ЗаключениеКомиссии);
		ЗначенияЗаполнения.Вставить("ДатаВозникновения",				ТекДанные.ДатаВозникновения);
		ЗначенияЗаполнения.Вставить("ПричинаОбразованияКод",			ТекДанные.ПричинаОбразованияКод);
		ЗначенияЗаполнения.Вставить("ПричинаОбразованияПояснение",		ТекДанные.ПричинаОбразованияПояснение);
		ЗначенияЗаполнения.Вставить("ПричинаОбразованияДополнительно",	ТекДанные.ПричинаОбразованияДополнительно);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("ОписьСсылка",				Объект.Ссылка);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Перем ПодтверждениеАктомСверки, ОчиститьВсеСуммыПриОтсутствииАктаСверки;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение.Свойство("ПодтверждениеАктомСверки", ПодтверждениеАктомСверки) Тогда
		ВыбранноеЗначение.Удалить("ПодтверждениеАктомСверки");
	КонецЕсли;
	
	Если ВыбранноеЗначение.Свойство("ОчиститьВсеСуммыПриОтсутствииАктаСверки", ОчиститьВсеСуммыПриОтсутствииАктаСверки) Тогда
		ВыбранноеЗначение.Удалить("ОчиститьВсеСуммыПриОтсутствииАктаСверки");
	КонецЕсли;
	
	ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти;
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыбранноеЗначение);
		
		Если ПодтверждениеАктомСверки = 0 Тогда
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиРуб = 0;
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиВал = 0;
			
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
			
		ИначеЕсли ПодтверждениеАктомСверки = 1 Тогда
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиРуб = СтрокаТаблицы.СуммаРуб;
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиВал = СтрокаТаблицы.СуммаВал;
			
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = 0;
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = 0;
		КонецЕсли;
		
		Если ОчиститьВсеСуммыПриОтсутствииАктаСверки = Истина
			И Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаАктаСверки)
			И Не ЗначениеЗаполнено(СтрокаТаблицы.НомерАктаСверки) Тогда
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиРуб = 0;
			СтрокаТаблицы.СуммаПодтвержденаАктомСверкиВал = 0;
			
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиРуб = 0;
			СтрокаТаблицы.СуммаНеПодтвержденаАктомСверкиВал = 0;
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасшифровкуСтрокиРаздела(ИмяТЧ)
	
	Если ИмяТЧ = "Раздел11" Или ИмяТЧ = "Раздел21" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Дебиторская");
		
	ИначеЕсли ИмяТЧ = "Раздел12" Или ИмяТЧ = "Раздел22" Тогда
		ВидЗадолженности = ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская");
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекДанные.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	
	// В отчете дата задается не границей, а датой.
	ПараметрыФормы.Вставить("ДатаОтчета",						ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации));
	ПараметрыФормы.Вставить("Организация",						Объект.Организация);
	ПараметрыФормы.Вставить("ВидЗадолженности",					ВидЗадолженности);
	ПараметрыФормы.Вставить("ВидЗадолженностиИспользование",	Истина);
	ПараметрыФормы.Вставить("Контрагент",						ТекДанные.Контрагент);
	ПараметрыФормы.Вставить("Договор",							ТекДанные.Договор);
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки",	"ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов",			ТекДанные.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС",					ТекДанные.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО",					ТекДанные.КФО);
	ПараметрыФормы.Расшифровка.Вставить("ИФО",					ТекДанные.ИФО);
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, ТекДанные.ИсходныйНомерСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиВыбораКодаПричиныОбразования()
	
	ПричиныОбразованияДт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Дебиторская);
	ПричиныОбразованияКт = БухгалтерскийУчет.ПереченьПричинПросроченнойЗадолженности(Перечисления.ВидыЗадолженности.Кредиторская);
	
	Элементы.Раздел21ПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияДт);
	Элементы.Раздел22ПричинаОбразованияКод.СписокВыбора.ЗагрузитьЗначения(ПричиныОбразованияКт);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияТекстаОтраженияЗадолженности(Элемент, СтандартнаяОбработка)
	
	ИмяЭлемента = Элемент.Имя;
	
	Если СтрНачинаетсяС(ИмяЭлемента, "Раздел21") Тогда
		ИмяТЧ = "Раздел21";
	ИначеЕсли СтрНачинаетсяС(ИмяЭлемента, "Раздел22") Тогда
		ИмяТЧ = "Раздел22";
	Иначе
		Возврат;
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(ИмяЭлемента, ИмяТЧ, "");
	
	Если ИмяПоля = "ПричинаОбразованияПояснение" Тогда
		ЗаголовокПоля = НСтр("ru='Причина возникновения задолженности'");
	ИначеЕсли ИмяПоля = "ПричинаОбразованияДополнительно" Тогда
		ЗаголовокПоля = НСтр("ru='Дополнительное описание причины возникновения задолженности'");
	Иначе
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ЗначениеПоля = Элементы[ИмяТЧ].ТекущиеДанные[ИмяПоля];
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяТЧ",	ИмяТЧ);
	ДополнительныеПараметры.Вставить("ИмяПоля",	ИмяПоля);
	
	Оповещение = Новый ОписаниеОповещения("ВведенТекстОтраженияЗадолженности", ЭтотОбъект, ДополнительныеПараметры);
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, ЗначениеПоля, ЗаголовокПоля);
	
КонецПроцедуры

&НаКлиенте
Процедура ВведенТекстОтраженияЗадолженности(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТЧ	= ДополнительныеПараметры.ИмяТЧ;
	ИмяПоля	= ДополнительныеПараметры.ИмяПоля;
	
	ТекДанные = Элементы[ИмяТЧ].ТекущиеДанные;
	
	ТекДанные[ИмяПоля] = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

