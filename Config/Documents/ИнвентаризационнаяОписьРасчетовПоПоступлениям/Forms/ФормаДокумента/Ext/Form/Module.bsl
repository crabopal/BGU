#Область Раздел1

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1Клиент(Команда, РежимЗаполнения = 0)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("РежимЗаполнения", РежимЗаполнения);
	
	ИнвентаризацияКлиент.ПроверитьЗаписьДокумента(ЭтотОбъект,
		НСтр("ru = 'Заполнить по данным бух.учета'"),
		"ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента",
		ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1ПослеПроверкиЗаписиДокумента(Результат, ДополнительныеПараметры) Экспорт
	
	Если Объект.Раздел11.Количество() > 0 Или Объект.Раздел12.Количество() > 0 Тогда 
		ТекстВопроса = НСтр("ru='Перед заполнением табличные части документа будут очищены.
			|
			|Продолжить и заполнить разделы 1.1 и 1.2?'");
		Оповещение = Новый ОписаниеОповещения("ПроверитьИЗаполнитьРаздел1КлиентЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(ДополнительныеПараметры.РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(ОписаниеОповещения.РежимЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовКлиент(РежимЗаполнения)
	
	Перем Отказ;
	
	ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(РежимЗаполнения, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1Клиент(РежимЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗаполнитьРаздел1КорректностьЗаполненияПредыдущихРазделовСервер(Знач РежимЗаполнения, Отказ)
	
	Документы.ИнвентаризационнаяОписьРасчетовПоПоступлениям.ПроверитьПередЗаполнениемРаздела1(Объект, РежимЗаполнения, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент(РежимЗаполнения)
	
	Объект.Раздел11.Очистить();
	Объект.Раздел12.Очистить();
	Объект.Раздел21.Очистить();
	Объект.Раздел22.Очистить();
	
	Объект.СписокДокументовСерии.Очистить();
	
	Объект.ИтогиРаздела21ПоСчету.Очистить();
	Объект.ИтогиРаздела21ПоКонтрагенту.Очистить();
	Объект.ИтогиРаздела22ПоСчету.Очистить();
	Объект.ИтогиРаздела22ПоКонтрагенту.Очистить();
	
	РезультатЗадания = ЗаполнитьРаздел1Сервер(РежимЗаполнения);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияРаздел1Клиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьРаздел1Сервер(РежимЗаполнения)
	
	ПараметрыФункции = Новый Структура("
		|Ссылка,
		|ДатаИнвентаризации,
		|Организация,
		|ИФО,
		|Подразделение");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФункции, Объект);
	
	ПараметрыФункции.Вставить("СписокСчетов", Объект.СписокСчетов.Выгрузить());
	ПараметрыФункции.Вставить("РежимЗаполнения", РежимЗаполнения);
	
	// СерииДокументов
	ИнвентаризацияСервер.ДобавитьПараметрыРасчетаСерииДокументов(ПараметрыФункции, Объект);
	// Конец СерииДокументов
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение раздела 1 инвентаризационной описи 0510468'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Документы.ИнвентаризационнаяОписьРасчетовПоПоступлениям.ПолучитьДанныеДляРаздела1",
		ПараметрыФункции)
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияРаздел1Клиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияРаздел1Сервер(Результат.АдресРезультата);
		
		Если ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект) Тогда
			Если Объект.Раздел11.Количество() = 0 И Объект.Раздел12.Количество() = 0 Тогда
				ТекстСообщения = НСтр("ru='После заполнения разделы 1.1 и 1.2 оказались пустыми'");
				
				ПоказатьПредупреждение(, ТекстСообщения);
			КонецЕсли;
			
		ИначеЕсли ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект) Тогда
			ИнвентаризацияКлиент.СообщитьОСозданииСерииДокументов(Объект.СписокДокументовСерии.Количество(), "1, 2");
		КонецЕсли;
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении раздела 1 возникла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияРаздел1Сервер(АдресРезультата)
	
	Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	Если Результат.Свойство("Раздел11") И Результат.Свойство("Раздел12") Тогда
		Объект.Раздел11.Загрузить(Результат.Раздел11);
		Объект.Раздел12.Загрузить(Результат.Раздел12);
		
		Объект.ИдентификаторСерииДокументов = "";
		Объект.ЭтоЗаголовочныйДокумент = Ложь;
		
		Объект.ВыявленыОтклонения = Ложь;
		
		Модифицированность = Истина;
	Иначе
		ЭтотОбъект.Прочитать();
	КонецЕсли;
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

