&НаКлиенте
Процедура ДебиторскаяЗадолженностьСписатьНаКлиенте(ВидОперации)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание дебиторской задолженности'");
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Данные были изменены. Необходимо сначала сохранить изменения.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	ИначеЕсли НЕ Объект.Проведен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для ввода документов списания дебиторской задолженности необходимо сначала провести инвентаризационную опись.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Раздел21.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВидОперации", ВидОперации);
		ДопПараметры.Вставить("СтрокиИнвентаризации", ВыделенныеСтроки);
		
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьСписаниеДебиторскойЗадолженностиЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = НСтр("ru='Списать дебиторскую задолженность в выделенной строке или во всех строках таблицы?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Во всех строках'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='В выделенной строке'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Нет);
		
	Иначе
		СоздатьСписаниеДебиторскойЗадолженности(ВидОперации, ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ДебиторскаяЗадолженностьСписатьПоГрафеНаКлиенте(ВидОперации)
	
	СтрокиКСписанию = Новый Массив;
	
	ВидСуммы = "";
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности") Тогда
		ВидСуммы = "Сомнительная";
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеБезнадежнойКВзысканиюЗадолженности") Тогда
		ВидСуммы = "Безнадежная";
	КонецЕсли;
	
	Для Каждого СтрокаДЗ Из Объект.Раздел21 Цикл
		Если ВидСуммы = "Сомнительная" И (СтрокаДЗ.СуммаРубСомнительная > 0 ИЛИ СтрокаДЗ.СуммаВалСомнительная > 0) Тогда
			СтрокиКСписанию.Добавить(СтрокаДЗ);
		ИначеЕсли ВидСуммы = "Безнадежная" И (СтрокаДЗ.СуммаРубБезнадежная > 0 ИЛИ СтрокаДЗ.СуммаВалБезнадежная > 0) Тогда
			СтрокиКСписанию.Добавить(СтрокаДЗ);
		КонецЕсли;
	КонецЦикла;
	
	СоздатьСписаниеДебиторскойЗадолженности(ВидОперации, СтрокиКСписанию, ВидСуммы);
	
КонецПроцедуры
&НаКлиенте
Процедура ВопросСоздатьСписаниеДебиторскойЗадолженностиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда // Во всех строках.
		СоздатьСписаниеДебиторскойЗадолженности(ДополнительныеПараметры.ВидОперации);
	Иначе // В выделенной строке.
		СоздатьСписаниеДебиторскойЗадолженности(ДополнительныеПараметры.ВидОперации, ДополнительныеПараметры.СтрокиИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоздатьСписаниеДебиторскойЗадолженности(ВидОперации, СтрокиИнвентаризации = Неопределено, ВидСуммы = "")
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание дебиторской задолженности'");
	
	// Проверим, что выбраны строки с одинаковым ИФО.
	СтрокиДляПроверки = ?(СтрокиИнвентаризации = Неопределено, Объект.Раздел21, СтрокиИнвентаризации);
	ЭтоПерваяСтрока = Истина;
	НомераСтрокИнвентаризации = Новый Массив;
	Для Каждого СтрокаИнвентаризации Из СтрокиДляПроверки Цикл
		
		Если ТипЗнч(СтрокаИнвентаризации) = Тип("Число") Тогда
			ДанныеСтроки = Объект.Раздел21.НайтиПоИдентификатору(СтрокаИнвентаризации);
		Иначе
			ДанныеСтроки = СтрокаИнвентаризации;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			ПредыдущийИФО  = ДанныеСтроки.ИФО;
			ЭтоПерваяСтрока = Ложь;
		Иначе
			// Проверим, что выбраны строки с одинаковым ИФО.
			Если ИспользоватьУчетПоИФО И (ПредыдущийИФО <> ДанныеСтроки.ИФО) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями поля ИФО.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		// Проверим корректность выбранного вида операции.
		Если ЗначениеЗаполнено(ДанныеСтроки.Счет)
			И (Счета04.НайтиПоЗначению(ДанныеСтроки.Счет) <> Неопределено) // Это счет 04.
			И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.СписаниеСомнительнойЗадолженности") Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для задолженности на забалансовом счете 04 не применяется вид операции ""Списать сомнительную задолженность"".'"), 10, ТекстЗаголовкаПредупреждений);
			Возврат;
		ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Счет)
			И (Счета04.НайтиПоЗначению(ДанныеСтроки.Счет) = Неопределено) // Это не счет 04.
			И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияЗадолженностиПоДоходам.ВосстановлениеСомнительнойЗадолженности") Тогда
			ПоказатьПредупреждение(, НСтр("ru='Вид операции ""Восстановить сомнительную задолженность"" применяется только для задолженности на забалансовом счете 04.'"), 10, ТекстЗаголовкаПредупреждений);
			Возврат;
		КонецЕсли;
		
		НомераСтрокИнвентаризации.Добавить(ДанныеСтроки.НомерСтроки);
		
	КонецЦикла;
	
	// Создание документа списания дебиторской задолженности.
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
	ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
	ЗначенияЗаполнения.Вставить("ВидСуммы", ВидСуммы);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры
&НаСервере
Процедура ДебиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИнвОпись", Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДебиторскаяЗадолженность.Ссылка КАК ИнвОпись,
	|	ДебиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	ДебиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	ДебиторскаяЗадолженность.Договор КАК Договор,
	|	ДебиторскаяЗадолженность.Счет КАК Счет,
	|	ДебиторскаяЗадолженность.ИФО КАК ИФО,
	|	ДебиторскаяЗадолженность.КФО КАК КФО,
	|	ДебиторскаяЗадолженность.КПС КАК КПС,
	|	ДебиторскаяЗадолженность.Подразделение КАК Подразделение,
	|	ДебиторскаяЗадолженность.СуммаРуб КАК Всего
	|ПОМЕСТИТЬ СтрокиИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Раздел21 КАК ДебиторскаяЗадолженность
	|ГДЕ
	|	ДебиторскаяЗадолженность.Ссылка = &ИнвОпись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписаниеВосстановлениеЗадолженностиПоДоходам.Ссылка КАК ДокументСписанияЗадолженности
	|ПОМЕСТИТЬ ДокументыСписанияЗадолженности
	|ИЗ
	|	Документ.СписаниеВосстановлениеЗадолженностиПоДоходам КАК СписаниеВосстановлениеЗадолженностиПоДоходам
	|ГДЕ
	|	СписаниеВосстановлениеЗадолженностиПоДоходам.ДокументОснование = &ИнвОпись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Задолженность.Ссылка КАК Ссылка,
	|	Задолженность.Ссылка.Номер КАК Номер,
	|	Задолженность.Ссылка.Дата КАК Дата,
	|	Задолженность.НомерСтроки КАК НомерСтроки,
	|	Задолженность.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Задолженность.Контрагент КАК Контрагент,
	|	Задолженность.Договор КАК Договор,
	|	Задолженность.Счет КАК Счет,
	|	Задолженность.ИФО КАК ИФО,
	|	Задолженность.КФО КАК КФО,
	|	Задолженность.КПС КАК КПС,
	|	Задолженность.Подразделение КАК Подразделение,
	|	Задолженность.СписатьСумма КАК Сумма
	|ПОМЕСТИТЬ СтрокиДокументовСписанияЗадолженности
	|ИЗ
	|	Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.Задолженность КАК Задолженность
	|ГДЕ
	|	НЕ Задолженность.Ссылка.ПометкаУдаления
	|	И Задолженность.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ДокументыСписанияЗадолженности.ДокументСписанияЗадолженности
	|			ИЗ
	|				ДокументыСписанияЗадолженности КАК ДокументыСписанияЗадолженности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПС,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК Счет,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Договоры
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 ССЫЛКА Справочник.Договоры
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 ССЫЛКА Справочник.Договоры
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт.УчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма
	|ПОМЕСТИТЬ ОтражениеВУчете
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|ГДЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ДокументыСписанияЗадолженности.ДокументСписанияЗадолженности
	|			ИЗ
	|				ДокументыСписанияЗадолженности КАК ДокументыСписанияЗадолженности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиИнвентаризации.ИнвОпись КАК ИнвОпись,
	|	СтрокиИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент,
	|	СтрокиИнвентаризации.Договор КАК Договор,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.Подразделение КАК Подразделение,
	|	СтрокиИнвентаризации.КПС КАК КПС,
	|	СтрокиИнвентаризации.КФО КАК КФО,
	|	СтрокиИнвентаризации.ИФО КАК ИФО,
	|	СтрокиИнвентаризации.Всего КАК Всего,
	|	СтрокиДокументовСписанияЗадолженности.Ссылка КАК ДокументСписанияЗадолженности,
	|	СтрокиДокументовСписанияЗадолженности.Номер КАК НомерДокументаСписанияЗадолженности,
	|	СтрокиДокументовСписанияЗадолженности.Дата КАК ДатаДокументаСписанияЗадолженности,
	|	СтрокиДокументовСписанияЗадолженности.НомерСтроки КАК НомерСтрокиДокументаСписанияЗадолженности,
	|	ВЫБОР
	|		КОГДА СтрокиДокументовСписанияЗадолженности.Сумма <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьДокументСписания,
	|	ВЫБОР
	|		КОГДА ОтражениеВУчете.Сумма <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ОтраженоВУчете
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтражениеВУчете КАК ОтражениеВУчете
	|		ПО СтрокиИнвентаризации.Контрагент = ОтражениеВУчете.Контрагент
	|			И СтрокиИнвентаризации.Договор = ОтражениеВУчете.Договор
	|			И СтрокиИнвентаризации.Счет = ОтражениеВУчете.Счет
	|			И СтрокиИнвентаризации.ИФО = ОтражениеВУчете.ИФО
	|			И СтрокиИнвентаризации.КФО = ОтражениеВУчете.КФО
	|			И СтрокиИнвентаризации.КПС = ОтражениеВУчете.КПС
	|			И СтрокиИнвентаризации.Подразделение = ОтражениеВУчете.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтрокиДокументовСписанияЗадолженности КАК СтрокиДокументовСписанияЗадолженности
	|		ПО СтрокиИнвентаризации.Контрагент = СтрокиДокументовСписанияЗадолженности.Контрагент
	|			И СтрокиИнвентаризации.Договор = СтрокиДокументовСписанияЗадолженности.Договор
	|			И СтрокиИнвентаризации.Счет = СтрокиДокументовСписанияЗадолженности.Счет
	|			И СтрокиИнвентаризации.ИФО = СтрокиДокументовСписанияЗадолженности.ИФО
	|			И СтрокиИнвентаризации.КФО = СтрокиДокументовСписанияЗадолженности.КФО
	|			И СтрокиИнвентаризации.КПС = СтрокиДокументовСписанияЗадолженности.КПС
	|			И СтрокиИнвентаризации.Подразделение = СтрокиДокументовСписанияЗадолженности.Подразделение";
	
	ОтражениеВУчете = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДебиторскаяЗадолженность Из Объект.Раздел21 Цикл
		
		СтрокаИнвОписи = ОтражениеВУчете.Найти(СтрокаДебиторскаяЗадолженность.НомерСтроки, "НомерСтроки");
		Если СтрокаИнвОписи <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаДебиторскаяЗадолженность, СтрокаИнвОписи,
				"ОтраженоВУчете,ЕстьДокументСписания,ДокументСписанияЗадолженности,НомерСтрокиДокументаСписанияЗадолженности");
			Если ЗначениеЗаполнено(СтрокаИнвОписи.ДокументСписанияЗадолженности) Тогда
				СтрокаДебиторскаяЗадолженность.РеквизитыДокументаСписанияЗадолженности = СтрШаблон("№ %1 от %2",
					СокрЛП(СтрокаИнвОписи.НомерДокументаСписанияЗадолженности),
					Формат(СтрокаИнвОписи.ДатаДокументаСписанияЗадолженности, "ДЛФ=Д"));
			Иначе
				СтрокаДебиторскаяЗадолженность.РеквизитыДокументаСписанияЗадолженности = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
&НаКлиенте
Процедура ОткрытьФормуДокументаСписанияДебиторскойЗадолженности(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.Раздел21.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ДокументСписанияЗадолженности) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.ДокументСписанияЗадолженности); 
	ОткрытьФорму("Документ.СписаниеВосстановлениеЗадолженностиПоДоходам.Форма.ФормаДокумента", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КредиторскаяЗадолженностьСписатьНаКлиенте(ВидОперации)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание кредиторской задолженности'");
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Данные были изменены. Необходимо сначала сохранить изменения.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	ИначеЕсли НЕ Объект.Проведен Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для ввода документов списания кредиторской задолженности необходимо сначала провести инвентаризационную опись.'"), 10, ТекстЗаголовкаПредупреждений);
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.Раздел22.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВидОперации", ВидОперации);
		ДопПараметры.Вставить("СтрокиИнвентаризации", ВыделенныеСтроки);
		
		Оповещение = Новый ОписаниеОповещения("ВопросСоздатьСписаниеКредиторскойЗадолженностиЗавершение", ЭтотОбъект, ДопПараметры);
		ТекстВопроса = НСтр("ru='Списать кредиторскую задолженность в выделенной строке или во всех строках таблицы?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru='Во всех строках'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='В выделенной строке'"));
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, , КодВозвратаДиалога.Нет);
		
	Иначе
		СоздатьСписаниеКредиторскойЗадолженности(ВидОперации, ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура КредиторскаяЗадолженностьСписатьПоГрафеНаКлиенте()
	
	ДокументыСписанияБаланс = Новый Структура;
	ДокументыСписанияЗабаланс = Новый Структура;
	СписокИФО = Новый Массив;
	
	Для Каждого СтрокаКЗ Из Объект.Раздел22 Цикл
		
		Если Не (СтрокаКЗ.СуммаРубСИстекшимСрокомДавности > 0 ИЛИ СтрокаКЗ.СуммаВалСИстекшимСрокомДавности > 0) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоСчет205 = ( СтрНайти(Строка(СтрокаКЗ.Счет), "205") > 0 );
		ЭтоСчет209 = ( СтрНайти(Строка(СтрокаКЗ.Счет), "209") > 0 );
		ЭтоСчет20 = ЗначениеЗаполнено(СтрокаКЗ.Счет)
			И (Счета20.НайтиПоЗначению(СтрокаКЗ.Счет) <> Неопределено);
		
		КлючДокумента = Новый Массив;
		КлючДокумента.Добавить("Документ");
		Если ЭтоСчет205 Тогда
			КлючДокумента.Добавить("Счет20500");
		ИначеЕсли ЭтоСчет209 Тогда
			КлючДокумента.Добавить("Счет20900");
		ИначеЕсли ЭтоСчет20 Тогда
			КлючДокумента.Добавить("Счет20");
		КонецЕсли;
		Если ИспользоватьУчетПоИФО Тогда
			НомерИФО = СписокИФО.Найти(СтрокаКЗ.ИФО);
			Если НомерИФО = Неопределено Тогда
				СписокИФО.Добавить(СтрокаКЗ.ИФО);
				НомерИФО = 0; // Первый индекс массива.
			КонецЕсли;
			КлючДокумента.Добавить(Строка(НомерИФО));
		КонецЕсли;
		
		КлючТекущегоДокумента = СтрСоединить(КлючДокумента);
		
		Если ЭтоСчет20 Тогда
			Если Не ДокументыСписанияЗабаланс.Свойство(КлючТекущегоДокумента) Тогда
				ДокументыСписанияЗабаланс.Вставить(КлючТекущегоДокумента, Новый Массив);
			КонецЕсли;
			ДокументыСписанияЗабаланс[КлючТекущегоДокумента].Добавить(СтрокаКЗ);
		Иначе // Балансовые счета.
			Если Не ДокументыСписанияБаланс.Свойство(КлючТекущегоДокумента) Тогда
				ДокументыСписанияБаланс.Вставить(КлючТекущегоДокумента, Новый Массив);
			КонецЕсли;
			ДокументыСписанияБаланс[КлючТекущегоДокумента].Добавить(СтрокаКЗ);
		КонецЕсли;
		
	КонецЦикла;
	
	// Списание задолженности c балансовых счетов 205.00, 209.00.
	Для Каждого ДокументСписания Из ДокументыСписанияБаланс Цикл
		
		НомераСтрокИнвентаризации = Новый Массив;
		Для Каждого СтрокаИнвентаризации Из ДокументСписания.Значение Цикл
			НомераСтрокИнвентаризации.Добавить(СтрокаИнвентаризации.НомерСтроки);
		КонецЦикла;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
		ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
		ЗначенияЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения"));
		ЗначенияЗаполнения.Вставить("ВидСуммы", "СИстекшимСрокомДавности");
		
		ЭтоСчет205 = ( СтрНайти(ДокументСписания.Ключ, "205") > 0 );
		ЗначенияЗаполнения.Вставить("СчетУчета", ?(ЭтоСчет205, "205.00", "209.00"));
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.СписаниеКредиторскойЗадолженности.ФормаОбъекта", ПараметрыФормы,
			ЭтотОбъект, ДокументСписания.Ключ, , , , РежимОткрытияОкнаФормы.Независимый);
		
	КонецЦикла;
		
	// Списание задолженности с забалансового счета 20.
	Для Каждого ДокументСписания Из ДокументыСписанияЗабаланс Цикл
		
		НомераСтрокИнвентаризации = Новый Массив;
		Для Каждого СтрокаИнвентаризации Из ДокументСписания.Значение Цикл
			НомераСтрокИнвентаризации.Добавить(СтрокаИнвентаризации.НомерСтроки);
		КонецЦикла;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
		ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
		ЗначенияЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности"));
		ЗначенияЗаполнения.Вставить("ВидСуммы", "СИстекшимСрокомДавности");
		ЗначенияЗаполнения.Вставить("СчетУчета", "20");
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.СписаниеКредиторскойЗадолженности.ФормаОбъекта", ПараметрыФормы,
			ЭтотОбъект, ДокументСписания.Ключ, , , , РежимОткрытияОкнаФормы.Независимый);
		
	КонецЦикла;
	
КонецПроцедуры
&НаКлиенте
Процедура ВопросСоздатьСписаниеКредиторскойЗадолженностиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда // Во всех строках.
		СоздатьСписаниеКредиторскойЗадолженности(ДополнительныеПараметры.ВидОперации);
	Иначе // В выделенной строке.
		СоздатьСписаниеКредиторскойЗадолженности(ДополнительныеПараметры.ВидОперации, ДополнительныеПараметры.СтрокиИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоздатьСписаниеКредиторскойЗадолженности(ВидОперации, СтрокиИнвентаризации = Неопределено, ВидСуммы = "")
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Списание кредиторской задолженности'");
	
	// Проверим, что выбраны строки с одинаковым счетом и ИФО.
	СтрокиДляПроверки = ?(СтрокиИнвентаризации = Неопределено, Объект.Раздел22, СтрокиИнвентаризации);
	ЭтоПерваяСтрока = Истина;
	НомераСтрокИнвентаризации = Новый Массив;
	Для Каждого СтрокаИнвентаризации Из СтрокиДляПроверки Цикл
		
		Если ТипЗнч(СтрокаИнвентаризации) = Тип("Число") Тогда
			ДанныеСтроки = Объект.Раздел22.НайтиПоИдентификатору(СтрокаИнвентаризации);
		Иначе
			ДанныеСтроки = СтрокаИнвентаризации;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			
			// Проверим корректность выбранного вида операции.
			Если ЗначениеЗаполнено(ДанныеСтроки.Счет)
				И (Счета20.НайтиПоЗначению(ДанныеСтроки.Счет) <> Неопределено) // Это счет 20.
				И ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности") Тогда
				ПоказатьПредупреждение(, НСтр("ru='Для задолженности на забалансовом счете 20 применяется вид операции ""Прекратить наблюдение задолженности"".'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Счет)
				И (Счета20.НайтиПоЗначению(ДанныеСтроки.Счет) = Неопределено) // Это не счет 20.
				И ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности") Тогда
				ПоказатьПредупреждение(, НСтр("ru='Вид операции ""Прекратить наблюдение задолженности"" применяется только для задолженности на забалансовом счете 20.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
			
			ПредыдущийИФО  = ДанныеСтроки.ИФО;
			ПредыдущийСчет = ДанныеСтроки.Счет;
			ЭтоПерваяСтрока = Ложь;
			
		Иначе
			// Проверим, что выбраны строки с одинаковым счетом и ИФО.
			Если ИспользоватьУчетПоИФО И (ПредыдущийИФО <> ДанныеСтроки.ИФО ИЛИ ПредыдущийСчет <> ДанныеСтроки.Счет) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями полей Счет и ИФО.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			ИначеЕсли Не ИспользоватьУчетПоИФО И (ПредыдущийСчет <> ДанныеСтроки.Счет) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями поля Счет.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		НомераСтрокИнвентаризации.Добавить(ДанныеСтроки.НомерСтроки);
		
	КонецЦикла;
	
	// Создание документа списания кредиторской задолженности.
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
	ЗначенияЗаполнения.Вставить("ВидОперации", ВидОперации);
	ЗначенияЗаполнения.Вставить("ВидСуммы", ВидСуммы);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.СписаниеКредиторскойЗадолженности.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры
&НаСервере
Процедура КредиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИнвОпись", Объект.Ссылка);
	Запрос.УстановитьПараметр("Счета20", БухгалтерскийУчет.СписокСчетов("20"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КредиторскаяЗадолженность.Ссылка КАК ИнвОпись,
	|	КредиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	КредиторскаяЗадолженность.Договор КАК Договор,
	|	КредиторскаяЗадолженность.Счет КАК Счет,
	|	КредиторскаяЗадолженность.Счет.Забалансовый КАК СчетЗабалансовый,
	|	КредиторскаяЗадолженность.ИФО КАК ИФО,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.Подразделение КАК Подразделение,
	|	КредиторскаяЗадолженность.СуммаРуб КАК Всего
	|ПОМЕСТИТЬ СтрокиИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Раздел22 КАК КредиторскаяЗадолженность
	|ГДЕ
	|	КредиторскаяЗадолженность.Ссылка = &ИнвОпись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписаниеКредиторскойЗадолженности.Ссылка КАК ДокументСписанияЗадолженности
	|ПОМЕСТИТЬ ДокументыСписанияЗадолженности
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности КАК СписаниеКредиторскойЗадолженности
	|ГДЕ
	|	СписаниеКредиторскойЗадолженности.ДокументОснование = &ИнвОпись
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Задолженность.Ссылка КАК Ссылка,
	|	Задолженность.Ссылка.Номер КАК Номер,
	|	Задолженность.Ссылка.Дата КАК Дата,
	|	Задолженность.НомерСтроки КАК НомерСтроки,
	|	Задолженность.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Задолженность.Контрагент КАК Контрагент,
	|	Задолженность.Договор КАК Договор,
	|	Задолженность.Счет КАК Счет,
	|	Задолженность.ИФО КАК ИФО,
	|	Задолженность.КФО КАК КФО,
	|	Задолженность.КПС КАК КПС,
	|	Задолженность.Подразделение КАК Подразделение,
	|	Задолженность.СписатьСумма КАК Сумма
	|ПОМЕСТИТЬ СтрокиДокументовСписанияЗадолженности
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности.Задолженность КАК Задолженность
	|ГДЕ
	|	НЕ Задолженность.Ссылка.ПометкаУдаления
	|	И Задолженность.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ДокументыСписанияЗадолженности.ДокументСписанияЗадолженности
	|			ИЗ
	|				ДокументыСписанияЗадолженности КАК ДокументыСписанияЗадолженности)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК Счет,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 ССЫЛКА Справочник.Контрагенты
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 ССЫЛКА Справочник.Контрагенты
