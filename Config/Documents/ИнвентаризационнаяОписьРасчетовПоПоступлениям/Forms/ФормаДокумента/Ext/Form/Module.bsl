&НаСервере
Процедура ИнициализироватьФорму()
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ИнициализироватьФормуДокументаЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Счета04.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("04"));
	Счета20.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("20"));
	
	НастроитьНедоступностьИзмененияКолонок();
	
	ЗаполнитьСпискиВыбораКодаПричиныОбразования();
	
	УстановитьУсловноеОформление();
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	// ПанельРасписки
	НастроитьФормуПоРасписке();
	// Конец ПанельРасписки
	
	// СерииДокументов
	НастроитьФормуПоСерииДокументов();
	// Конец СерииДокументов
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	УстановитьПредставлениеНомераКомиссии();
	
	УстановитьПредставлениеМестаПроведения();
	
	ПредставлениеСпискаСчетов = ПолучитьПредставлениеСпискаСчетов(Объект.СписокСчетов);
	
	НастроитьОтборПоПодразделению();
	
	УстановитьВидимостьЭлементовСписанияЗадолженности();
	ДебиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	КредиторскаяЗадолженностьЗаполнитьКолонкуОтраженоВУчете();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовСписанияЗадолженности()
	
	ЭлементыСписатьЗадолженность = Новый Массив;
	ЭлементыСписатьЗадолженность.Добавить("ДебиторскаяЗадолженностьГруппаСписать");
	ЭлементыСписатьЗадолженность.Добавить("КредиторскаяЗадолженностьГруппаСписать");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыСписатьЗадолженность, "Видимость", Объект.Проведен);
	
КонецПроцедуры

