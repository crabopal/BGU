	|			И СтрокиИнвентаризации.Договор = ОтражениеВУчетеБаланс.Договор
	|			И СтрокиИнвентаризации.Счет = ОтражениеВУчетеБаланс.Счет
	|			И СтрокиИнвентаризации.ИФО = ОтражениеВУчетеБаланс.ИФО
	|			И СтрокиИнвентаризации.КФО = ОтражениеВУчетеБаланс.КФО
	|			И СтрокиИнвентаризации.КПС = ОтражениеВУчетеБаланс.КПС
	|			И СтрокиИнвентаризации.Подразделение = ОтражениеВУчетеБаланс.Подразделение
	|			И (НЕ СтрокиИнвентаризации.СчетЗабалансовый)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтражениеВУчетеЗабаланс КАК ОтражениеВУчетеЗабаланс
	|		ПО СтрокиИнвентаризации.Контрагент = ОтражениеВУчетеЗабаланс.Контрагент
	|			И СтрокиИнвентаризации.Договор = ОтражениеВУчетеЗабаланс.Договор
	|			И СтрокиИнвентаризации.Счет = ОтражениеВУчетеЗабаланс.Счет
	|			И СтрокиИнвентаризации.ИФО = ОтражениеВУчетеЗабаланс.ИФО
	|			И СтрокиИнвентаризации.КФО = ОтражениеВУчетеЗабаланс.КФО
	|			И СтрокиИнвентаризации.КПС = ОтражениеВУчетеЗабаланс.КПС
	|			И СтрокиИнвентаризации.Подразделение = ОтражениеВУчетеЗабаланс.Подразделение
	|			И (СтрокиИнвентаризации.СчетЗабалансовый)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтрокиДокументовСписанияЗадолженности КАК СтрокиДокументовСписанияЗадолженности
	|		ПО СтрокиИнвентаризации.Контрагент = СтрокиДокументовСписанияЗадолженности.Контрагент
	|			И СтрокиИнвентаризации.Договор = СтрокиДокументовСписанияЗадолженности.Договор
	|			И СтрокиИнвентаризации.Счет = СтрокиДокументовСписанияЗадолженности.Счет
	|			И СтрокиИнвентаризации.ИФО = СтрокиДокументовСписанияЗадолженности.ИФО
	|			И СтрокиИнвентаризации.КФО = СтрокиДокументовСписанияЗадолженности.КФО
	|			И СтрокиИнвентаризации.КПС = СтрокиДокументовСписанияЗадолженности.КПС
	|			И СтрокиИнвентаризации.Подразделение = СтрокиДокументовСписанияЗадолженности.Подразделение";
	
	ОтражениеВУчете = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаКредиторскаяЗадолженность Из Объект.Раздел22 Цикл
		
		СтрокаИнвОписи = ОтражениеВУчете.Найти(СтрокаКредиторскаяЗадолженность.НомерСтроки, "НомерСтроки");
		Если СтрокаИнвОписи <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаКредиторскаяЗадолженность, СтрокаИнвОписи,
				"ОтраженоВУчете,ЕстьДокументСписания,ДокументСписанияЗадолженности,НомерСтрокиДокументаСписанияЗадолженности");
			Если ЗначениеЗаполнено(СтрокаИнвОписи.ДокументСписанияЗадолженности) Тогда
				СтрокаКредиторскаяЗадолженность.РеквизитыДокументаСписанияЗадолженности = СтрШаблон("№ %1 от %2",
					СокрЛП(СтрокаИнвОписи.НомерДокументаСписанияЗадолженности),
					Формат(СтрокаИнвОписи.ДатаДокументаСписанияЗадолженности, "ДЛФ=Д"));
			Иначе
				СтрокаКредиторскаяЗадолженность.РеквизитыДокументаСписанияЗадолженности = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
&НаКлиенте
Процедура ОткрытьФормуДокументаСписанияКредиторскойЗадолженности(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.Раздел22.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если ДанныеСтроки = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ДанныеСтроки.ДокументСписанияЗадолженности) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ДанныеСтроки.ДокументСписанияЗадолженности); 
	ОткрытьФорму("Документ.СписаниеКредиторскойЗадолженности.Форма.ФормаДокумента", ПараметрыФормы);
	
КонецПроцедуры

#Область ПанельРасписки

&НаСервере
Процедура НастроитьФормуПоРасписке()
	
	НастроитьПанельРаспискиИнвентаризацииСервер();
	
	НастроитьДоступностьРазделов();
	
	Если НужноЗаблокироватьРеквизиты() Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастроитьПанельРаспискиИнвентаризацииСервер()
	
	ИнвентаризацияСервер.НастроитьПанельРаспискиНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьРазделов()
	
	ЭтоОбычныйДокумент			= ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(Объект);
	ЭтоЗаголовочныйДокумент		= ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(Объект);
	ЭтоСодержательныйДокумент	= ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(Объект);
	
	Если ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент Тогда
		РаспискаПроведена = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;
	Иначе
		РаспискаПроведена = Ложь;
	КонецЕсли;
	
	// Видимость закладок
	
	Элементы.ГруппаРаздел1.Видимость				= ЭтоОбычныйДокумент Или ЭтоСодержательныйДокумент;
	Элементы.ГруппаРаздел2.Видимость				= ЭтоОбычныйДокумент Или ЭтоСодержательныйДокумент;
	Элементы.ГруппаСписокДокументовСерии.Видимость	= ЭтоЗаголовочныйДокумент;
	Элементы.ГруппаКомиссия.Видимость				= ЭтоОбычныйДокумент Или ЭтоЗаголовочныйДокумент;
	
	// Команды заполнения
	
	Элементы.ГруппаЗаполнитьРаздел1.Доступность = РаспискаПроведена;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ЗаполнитьРаздел2");
	ИменаЭлементов.Добавить("Раздел11РасшифроватьРаздел11");
	ИменаЭлементов.Добавить("Раздел12РасшифроватьРаздел12");
	ИменаЭлементов.Добавить("Раздел21РасшифроватьРаздел21");
	ИменаЭлементов.Добавить("Раздел22РасшифроватьРаздел22");
	ИменаЭлементов.Добавить("Раздел21ГрупповоеЗаполнениеСтрокРаздел21");
	ИменаЭлементов.Добавить("Раздел22ГрупповоеЗаполнениеСтрокРаздел22");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементов,
		"Доступность",
		РаспискаПроведена Или ЭтоСодержательныйДокумент);
	
	// СерииДокументов
	Если ЭтоСодержательныйДокумент Тогда
		// Только просмотр реквизитов шапки для содержательных документов
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить("Организация");
		ИменаЭлементов.Добавить("Подразделение");
		ИменаЭлементов.Добавить("ИФО");
		ИменаЭлементов.Добавить("РешениеОПроведенииИнвентаризации");
		ИменаЭлементов.Добавить("ОтветственныйИсполнитель");
		ИменаЭлементов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов,
			"ТолькоПросмотр",
			Истина);
	КонецЕсли;
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

#Область ПанельСерииДокументов

&НаСервере
Процедура НастроитьФормуПоСерииДокументов()
	
	НастроитьПанельСерииДокументовСервер();
	
	Если Объект.СписокДокументовСерии.Количество() > 0 Тогда
		ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии();
	КонецЕсли;
	
	НастроитьДоступностьРазделов();

КонецПроцедуры

&НаСервере
Процедура НастроитьПанельСерииДокументовСервер()
	
	ИнвентаризацияСервер.НастроитьПанельСерииДокументовНаФормеОписи(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии()
	
