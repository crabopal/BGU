Функция ПолучитьДанныеДляПечати0510468(МассивОбъектов)
	
	Перем СерииДокументовДляПечати;
	
	// СерииДокументов
	ИнвентаризацияСервер.ПрочитатьСерииДокументовДляПечати(МассивОбъектов, СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", СерииДокументовДляПечати.ДополненныйМассивОбъектов);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПечать0510468();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Данные.Выборки.Вставить("Шапки",						РезультатыЗапроса[1].Выбрать());
	Данные.Выборки.Вставить("Раздел11",						РезультатыЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел12",						РезультатыЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел21",						РезультатыЗапроса[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("Раздел22",						РезультатыЗапроса[5].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела21ПоСчету",		РезультатыЗапроса[6].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела21ПоКонтрагенту",	РезультатыЗапроса[7].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела22ПоСчету",		РезультатыЗапроса[8].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Выборки.Вставить("ИтогиРаздела22ПоКонтрагенту",	РезультатыЗапроса[9].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(СерииДокументовДляПечати.ДополненныйМассивОбъектов));
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(СерииДокументовДляПечати.ДополненныйМассивОбъектов));
	
	Данные.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоСчету_НаборДанных1", ПолучитьСтруктуруЗаполненияПустыхИтоговПоСчету_НаборДанных1());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоСчету_НаборДанных2", ПолучитьСтруктуруЗаполненияПустыхИтоговПоСчету_НаборДанных2());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоКонтрагенту_НаборДанных1", ПолучитьСтруктуруЗаполненияПустыхИтоговПоКонтрагенту_НаборДанных1());
	Данные.Вставить("СтруктураЗаполненияПустыхИтоговПоКонтрагенту_НаборДанных2", ПолучитьСтруктуруЗаполненияПустыхИтоговПоКонтрагенту_НаборДанных2());
	
	// СерииДокументов
	Данные.Выборки.Вставить("ШапкиПоискаЗаголовочныхДокументов", РезультатыЗапроса[1].Выбрать());
	Данные.Вставить("СерииДокументовДляПечати", СерииДокументовДляПечати);
	// Конец СерииДокументов
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ИменаПолей = Новый Структура();
