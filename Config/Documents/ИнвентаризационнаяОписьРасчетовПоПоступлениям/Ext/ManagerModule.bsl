Процедура ДозаполнитьТаблицуЗадолженностиПоДаннымБухУчета(ТаблицаЗадолженности, ВидЗадолженности, ПараметрыПроцедуры, ПараметрыПоиска, СчетаРасчетовКИСЕ)
	
	СоответствиеСчетов = УчетРасчетов.СоответствиеСчетовАвансовСчетамРасчетов("302.00", ПараметрыПроцедуры.ДатаИнвентаризации, ПараметрыПроцедуры.Организация);
	
	// Соответствие счетов 206.00 - 302.00.
	СоответствующиеСчетаРасчетов = Новый Соответствие();
	
	Для Каждого Элемент Из СоответствиеСчетов Цикл
		СоответствующиеСчетаРасчетов.Вставить(Элемент.Значение, Элемент.Ключ);
	КонецЦикла;
	
	Если ПараметрыПроцедуры.ДатаИнвентаризации >= Дата(2020,12,31) Тогда
		ИнвентаризацияСервер.ЗаполнитьКЭКОстатков(ТаблицаЗадолженности, СчетаРасчетовКИСЕ);
	КонецЕсли;
	
	ПараметрыЗаполнения = ИнвентаризацияСервер.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации61н();
	ПараметрыЗаполнения.ВидЗадолженности				= ВидЗадолженности;
	ПараметрыЗаполнения.ПараметрыПоиска					= ПараметрыПоиска; 
	ПараметрыЗаполнения.СоответствующиеСчетаРасчетов	= СоответствующиеСчетаРасчетов;
	
	ИнвентаризацияСервер.ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации61н(ТаблицаЗадолженности, ПараметрыПроцедуры, ПараметрыЗаполнения);
	
	ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности);
	
КонецПроцедуры

Процедура ЗаполнитьИдентификаторыКонтрагентов(ТаблицаЗадолженности)
	
	Если ТаблицаЗадолженности.Колонки.Найти("ИдентификаторКонтрагента") = Неопределено Тогда
		ТаблицаЗадолженности.Колонки.Добавить("ИдентификаторКонтрагента", ОбщегоНазначения.ОписаниеТипаСтрока(22));
	КонецЕсли;
	
	ВремТЗ = ТаблицаЗадолженности.Скопировать(, "Контрагент");
	ВремТЗ.Свернуть("Контрагент");
	СписокКонтрагентов = ВремТЗ.ВыгрузитьКолонку("Контрагент");
	
	ИдентификаторыКонтрагентов = БухгалтерскийУчет.ИдентификаторыКонтрагентов(СписокКонтрагентов);
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		СтрокаТаблицы.ИдентификаторКонтрагента = ИдентификаторыКонтрагентов.Получить(СтрокаТаблицы.Контрагент);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеРаздела2

Процедура ДобавитьКолонкиДоПолногоСоставаРаздела(Таблица, ИмяТЧ)
	
	ТаблицаШаблон = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(Метаданные.Документы.ИнвентаризационнаяОписьРасчетовПоПоступлениям.ТабличныеЧасти[ИмяТЧ]);
	
	Для Каждого Колонка Из ТаблицаШаблон.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов(Колонка.ТипЗначения));
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТекущуюЗадолженностьВТаблице(Таблица, ВалютаРУ)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьТекущуюЗадолженностьВСтрокеТаблицы(
			СтрокаТаблицы.СуммаРуб,
			СтрокаТаблицы.СуммаРубТекущая,
			СтрокаТаблицы.СуммаРубПросроченная,
			СтрокаТаблицы.СуммаРубДолгосрочная);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Валюта) И СтрокаТаблицы.Валюта <> ВалютаРУ Тогда
			ЗаполнитьТекущуюЗадолженностьВСтрокеТаблицы(
				СтрокаТаблицы.СуммаВал,
				СтрокаТаблицы.СуммаВалТекущая,
				СтрокаТаблицы.СуммаВалПросроченная,
				СтрокаТаблицы.СуммаВалДолгосрочная);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьФлажкиСуммаТребуетРеклассификации(Таблица, НомерПодраздела)
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если НомерПодраздела = 1 Тогда
			СтрокаТаблицы.ПросроченнаяСуммаТребуетРеклассификации = ЗначениеЗаполнено(СтрокаТаблицы.СуммаВалПросроченная)
				Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаРубПросроченная);
			
			СтрокаТаблицы.СомнительнаяСуммаТребуетРеклассификации = ЗначениеЗаполнено(СтрокаТаблицы.СуммаВалСомнительная)
				Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаРубСомнительная);
			
			СтрокаТаблицы.БезнадежнаяСуммаТребуетРеклассификации = ЗначениеЗаполнено(СтрокаТаблицы.СуммаВалБезнадежная)
				Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаРубБезнадежная);
			
		ИначеЕсли НомерПодраздела = 2 Тогда
			СтрокаТаблицы.ПросроченнаяСуммаТребуетРеклассификации = ЗначениеЗаполнено(СтрокаТаблицы.СуммаВалПросроченная)
				Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаРубПросроченная);
				
			СтрокаТаблицы.СуммаСИстекшимСрокомДавностиТребуетРеклассификации = ЗначениеЗаполнено(СтрокаТаблицы.СуммаВалСИстекшимСрокомДавности)
				Или ЗначениеЗаполнено(СтрокаТаблицы.СуммаРубСИстекшимСрокомДавности);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТекущуюЗадолженностьВСтрокеТаблицы(Всего, Текущая, Просроченная, Долгосрочная)
	
	Текущая = Всего - (Просроченная + Долгосрочная);
	
	Если Текущая < 0 И Всего > 0 Или Текущая > 0 И Всего < 0 Тогда
		Текущая = 0;
	КонецЕсли;
	
КонецПроцедуры

