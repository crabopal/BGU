#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполнения(ДокументОбъект) Экспорт
	
	ЕстьОшибки = Ложь;
	
	// К содержательным документам расписка не оформляется.
	// В содержательных документах серии не указывается состав комиссии.
	Если Не ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, ЕстьОшибки);
		
		ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ДокументОбъект, ЕстьОшибки);
		
		ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, ЕстьОшибки, "ОтветственныйИсполнитель");
	КонецЕсли;
	
	// В заголовочных документах серии не заполняются разделы описи.
	Если Не ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		Если ДокументОбъект.Раздел11.Количество() > 0 Тогда
			ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел21", ЕстьОшибки);
		КонецЕсли;
		
		Если ДокументОбъект.Раздел12.Количество() > 0 Тогда
			ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "Раздел22", ЕстьОшибки);
		КонецЕсли;
	КонецЕсли;
	
	ПроверитьЗаполнениеРаздела2(ДокументОбъект, ЕстьОшибки);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, ЕстьОшибки);
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ЗаполнитьСписокСчетовПоУмолчанию(ДокументОбъект) Экспорт
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ДокументОбъект.ДатаИнвентаризации);
	
	СписокСчетов = ПолучитьСписокСчетовПоУмолчанию(НаДату);
	
	ДокументОбъект.СписокСчетов.Очистить();
	
	Для Каждого Счет Из СписокСчетов Цикл
		НоваяСтрока = ДокументОбъект.СписокСчетов.Добавить();
		НоваяСтрока.Счет = Счет;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеДляРаздела1(ПараметрыФункции) Экспорт
	
	Данные = ПолучитьДанныеБухУчета(ПараметрыФункции);
	
	РасчетСерииДокументов = ИнвентаризацияСервер.РассчитатьСериюДокументов(Данные, ПараметрыФункции);
	
	Если РасчетСерииДокументов = Неопределено Тогда
		Возврат Данные;
	Иначе
		ИнвентаризацияСервер.СоздатьСериюДокументов(РасчетСерииДокументов, Данные, ПараметрыФункции);
		
		Возврат РасчетСерииДокументов;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДляРаздела2(ПараметрыФункции) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ПараметрыФункции.Ссылка);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Раздел11,
	|	Раздел12
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям
	|ГДЕ
	|	Ссылка = &ДокументСсылка";
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Таблица.Количество() = 0 Тогда
		ТаблицаРаздела21 = Новый ТаблицаЗначений();
		ТаблицаРаздела22 = Новый ТаблицаЗначений();
		
		ВыявленыОтклонения = Ложь;
	Иначе
		ТаблицаРаздела21 = Таблица[0].Раздел11;
		ТаблицаРаздела22 = Таблица[0].Раздел12;
		
		ТаблицаРаздела21.Колонки.ДолгосрочнаяВал.Имя = "СуммаВалДолгосрочная";
		ТаблицаРаздела21.Колонки.ДолгосрочнаяРуб.Имя = "СуммаРубДолгосрочная";
		ТаблицаРаздела21.Колонки.ПросроченнаяВал.Имя = "СуммаВалПросроченная";
		ТаблицаРаздела21.Колонки.ПросроченнаяРуб.Имя = "СуммаРубПросроченная";
		
		ТаблицаРаздела22.Колонки.ДолгосрочнаяВал.Имя = "СуммаВалДолгосрочная";
		ТаблицаРаздела22.Колонки.ДолгосрочнаяРуб.Имя = "СуммаРубДолгосрочная";
		ТаблицаРаздела22.Колонки.ПросроченнаяВал.Имя = "СуммаВалПросроченная";
		ТаблицаРаздела22.Колонки.ПросроченнаяРуб.Имя = "СуммаРубПросроченная";
		
		ДобавитьКолонкиДоПолногоСоставаРаздела(ТаблицаРаздела21, "Раздел21");
		ДобавитьКолонкиДоПолногоСоставаРаздела(ТаблицаРаздела22, "Раздел22");
		
		// По умолчанию все суммы считаем не подтвержденными актом сверки.
		ТаблицаРаздела21.ЗагрузитьКолонку(ТаблицаРаздела21.ВыгрузитьКолонку("СуммаВал"), "СуммаНеПодтвержденаАктомСверкиВал");
		ТаблицаРаздела21.ЗагрузитьКолонку(ТаблицаРаздела21.ВыгрузитьКолонку("СуммаРуб"), "СуммаНеПодтвержденаАктомСверкиРуб");
		
		ТаблицаРаздела22.ЗагрузитьКолонку(ТаблицаРаздела22.ВыгрузитьКолонку("СуммаВал"), "СуммаНеПодтвержденаАктомСверкиВал");
		ТаблицаРаздела22.ЗагрузитьКолонку(ТаблицаРаздела22.ВыгрузитьКолонку("СуммаРуб"), "СуммаНеПодтвержденаАктомСверкиРуб");
		
		ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
		
		ЗаполнитьТекущуюЗадолженностьВТаблице(ТаблицаРаздела21, ВалютаРУ);
		ЗаполнитьТекущуюЗадолженностьВТаблице(ТаблицаРаздела22, ВалютаРУ);
		
		УстановитьФлажкиСуммаТребуетРеклассификации(ТаблицаРаздела21, 1);
		УстановитьФлажкиСуммаТребуетРеклассификации(ТаблицаРаздела22, 2);
		
		// Отклонения считаются выявленными при наличии суммы, не подтвержденной актом сверки.
		// По текущему алгоритму сумма задолженности при заполнении раздела 2 считается не подтвержденной актом сверки в полном объеме.
		// Строка с такой суммой обязательно есть в одной из таблиц, если таблица заполнена.
		ВыявленыОтклонения = ТаблицаРаздела21.Количество() > 0 Или ТаблицаРаздела22.Количество() > 0;
	КонецЕсли;
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаРаздела21", ТаблицаРаздела21);
	Данные.Вставить("ТаблицаРаздела22", ТаблицаРаздела22);
	Данные.Вставить("ВыявленыОтклонения", ВыявленыОтклонения);
	
	Возврат Данные;
	
КонецФункции

Процедура ПроверитьПередЗаполнениемРаздела1(Знач ДокументОбъект, Знач РежимЗаполнения, Отказ) Экспорт
	
	Отказ = Ложь;
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("РешениеОПроведенииИнвентаризации");
	ИменаРеквизитов.Добавить("Организация");
	ИменаРеквизитов.Добавить("ДатаНачала");
	ИменаРеквизитов.Добавить("ДатаОкончания");
	ИменаРеквизитов.Добавить("ДатаИнвентаризации");
	ИменаРеквизитов.Добавить("Комиссия");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ИменаРеквизитов.Добавить("ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьЗаполненностьРеквизитовШапки(ДокументОбъект, ИменаРеквизитов, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеСтрокВТабличнойЧасти(ДокументОбъект, "СписокСчетов", Отказ);
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ДокументОбъект, Отказ, "ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ДокументОбъект, Отказ);
	
КонецПроцедуры

Процедура УстановитьУсловноеОформления(ФормаДокумента) Экспорт
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ИнвентаризацияСервер.ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента);
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ДобавитьУсловноеОформлениеКФО0(УсловноеОформление);
	
	ДобавитьУсловноеОформление_НадписиСумм(УсловноеОформление, "Раздел21", ВалютаРУ);
	ДобавитьУсловноеОформление_НадписиСумм(УсловноеОформление, "Раздел22", ВалютаРУ);
	
	ДобавитьУсловноеОформление_СкрытьВалютныеСуммы(УсловноеОформление, "Раздел21", ВалютаРУ);
	ДобавитьУсловноеОформление_СкрытьВалютныеСуммы(УсловноеОформление, "Раздел22", ВалютаРУ);
	
	ДобавитьУсловноеОформление_НедоступныРублевыеСуммыИностраннойВалюты(УсловноеОформление, "Раздел21", ВалютаРУ);
	ДобавитьУсловноеОформление_НедоступныРублевыеСуммыИностраннойВалюты(УсловноеОформление, "Раздел22", ВалютаРУ);
	
	ДобавитьУсловноеОформление_НеТребуетсяАктСверки(УсловноеОформление, "Раздел21");
	ДобавитьУсловноеОформление_НеТребуетсяАктСверки(УсловноеОформление, "Раздел22");
	
	ДобавитьУсловноеОформление_НедоступенФлажокСуммаТребуетРеклассификации(УсловноеОформление, "Раздел21",
		"СуммаВалПросроченная", "СуммаРубПросроченная", "ПросроченнаяСуммаТребуетРеклассификации");
	ДобавитьУсловноеОформление_НедоступенФлажокСуммаТребуетРеклассификации(УсловноеОформление, "Раздел21",
		"СуммаВалСомнительная", "СуммаРубСомнительная", "СомнительнаяСуммаТребуетРеклассификации");
	ДобавитьУсловноеОформление_НедоступенФлажокСуммаТребуетРеклассификации(УсловноеОформление, "Раздел21",
		"СуммаВалБезнадежная", "СуммаРубБезнадежная", "БезнадежнаяСуммаТребуетРеклассификации");
	
	ДобавитьУсловноеОформление_НедоступенФлажокСуммаТребуетРеклассификации(УсловноеОформление, "Раздел22",
		"СуммаВалПросроченная", "СуммаРубПросроченная", "ПросроченнаяСуммаТребуетРеклассификации");
	ДобавитьУсловноеОформление_НедоступенФлажокСуммаТребуетРеклассификации(УсловноеОформление, "Раздел22",
		"СуммаВалСИстекшимСрокомДавности", "СуммаРубСИстекшимСрокомДавности", "СуммаСИстекшимСрокомДавностиТребуетРеклассификации");
	
КонецПроцедуры

Процедура УстановитьВыявленыОтклонения(ДокументОбъект) Экспорт
	
	ДокументОбъект.ВыявленыОтклонения = ВыявленыОтклоненияВТаблице(ДокументОбъект.Раздел21)
		Или ВыявленыОтклоненияВТаблице(ДокументОбъект.Раздел22);
	
КонецПроцедуры

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ДатаИнвентаризации");
	
	ФормироватьДвиженияДолгосрочнойПросроченной = Не (Месяц(ЗначенияРеквизитов.ДатаИнвентаризации) = 1
		И День(ЗначенияРеквизитов.ДатаИнвентаризации) = 2);
		
	Если Не ФормироватьДвиженияДолгосрочнойПросроченной Тогда
		Возврат;
	КонецЕсли;
	
	ДатаОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ЗначенияРеквизитов.ДатаИнвентаризации);
	
	ФормироватьДвиженияДолгосрочнойПросроченной = РегистрыСведений.ДолгосрочнаяПросроченнаяЗадолженность.РазрешеноФормированиеДвиженийСтороннимиДокументами(ДатаОстатков);
	
	Если Не ФормироватьДвиженияДолгосрочнойПросроченной Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("Период",				ДатаОстатков);
	ЗапросДвижения.УстановитьПараметр("ДатаИнвентаризации",	ДатаОстатков);
	ЗапросДвижения.УстановитьПараметр("Организация",		ЗначенияРеквизитов.Организация);
	ЗапросДвижения.УстановитьПараметр("Дебиторская",		Перечисления.ВидыЗадолженности.Дебиторская);
	ЗапросДвижения.УстановитьПараметр("Кредиторская",		Перечисления.ВидыЗадолженности.Кредиторская);
	ЗапросДвижения.УстановитьПараметр("Ссылка",				ДокументСсылка);
	ЗапросДвижения.Текст = "
	|ВЫБРАТЬ
	|	&Период								КАК Период,
	|	&ДатаИнвентаризации					КАК ДатаИнвентаризации,
	|	&Организация						КАК Организация,
	|	ТЧ.Счет								КАК СчетРасчетов,
	|	&Дебиторская						КАК ВидЗадолженности,
	|	ТЧ.ИФО								КАК ИФО,
	|	ТЧ.КФО								КАК КФО,
	|	ТЧ.КПС								КАК КПС,
	|	ТЧ.КЭК								КАК КЭК,
	|	ТЧ.Контрагент						КАК Контрагент,
	|	ТЧ.Договор							КАК Договор,
	|	ТЧ.ДатаВозникновения				КАК ДатаВозникновения,
	|	ТЧ.ДатаИсполнения					КАК ДатаИсполнения,
	|	ТЧ.ПричинаОбразованияКод			КАК ПричинаОбразованияКод,
	|	ТЧ.ПричинаОбразованияПояснение		КАК ПричинаОбразованияПояснение,
	|	ТЧ.ПричинаОбразованияДополнительно	КАК ПричинаОбразованияДополнительно,
	|	ТЧ.СуммаРубДолгосрочная				КАК Долгосрочная,
	|	ТЧ.СуммаРубПросроченная				КАК Просроченная
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Раздел21 КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|	И НЕ (ТЧ.СуммаРубДолгосрочная = 0 И ТЧ.СуммаРубПросроченная = 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&Период								КАК Период,
	|	&ДатаИнвентаризации					КАК ДатаИнвентаризации,
	|	&Организация						КАК Организация,
	|	ТЧ.Счет								КАК СчетРасчетов,
	|	&Кредиторская						КАК ВидЗадолженности,
	|	ТЧ.ИФО								КАК ИФО,
	|	ТЧ.КФО								КАК КФО,
	|	ТЧ.КПС								КАК КПС,
	|	ТЧ.КЭК								КАК КЭК,
	|	ТЧ.Контрагент						КАК Контрагент,
	|	ТЧ.Договор							КАК Договор,
	|	ТЧ.ДатаВозникновения				КАК ДатаВозникновения,
	|	ТЧ.ДатаИсполнения					КАК ДатаИсполнения,
	|	ТЧ.ПричинаОбразованияКод			КАК ПричинаОбразованияКод,
	|	ТЧ.ПричинаОбразованияПояснение		КАК ПричинаОбразованияПояснение,
	|	ТЧ.ПричинаОбразованияДополнительно	КАК ПричинаОбразованияДополнительно,
	|	ТЧ.СуммаРубДолгосрочная				КАК Долгосрочная,
	|	ТЧ.СуммаРубПросроченная				КАК Просроченная
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Раздел22 КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &Ссылка
	|	И НЕ (ТЧ.СуммаРубДолгосрочная = 0 И ТЧ.СуммаРубПросроченная = 0)";
	
	СтруктураДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ДолгосрочнаяПросроченнаяЗадолженность", ЗапросДвижения.Выполнить().Выгрузить());
	
КонецПроцедуры

#Область РеестрДокументовКПроводимойИнвентаризации

Функция ПрочитатьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(ДокументСсылка) Экспорт
	
	ДанныеОписи = Отчеты.РеестрДокументовКПроводимойИнвентаризации.НовыйОбщиеДанныеОписи();
	
	ДанныеОписи.Вставить("ОтветственныйИсполнительБухгалтерскойСлужбы");
	ДанныеОписи.Вставить("СписокСчетов");
	
	ДанныеОписи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ДанныеОписи);
	
	ДанныеОписи.СписокСчетов = ДанныеОписи.СписокСчетов.Выгрузить();
	
	Возврат ДанныеОписи;
	
КонецФункции

Процедура ПроверитьДанныеОписиДляРеестраДокументовКПроводимойИнвентаризации(Знач ДанныеОписи, Отказ) Экспорт
	
	Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПроверитьОбщиеДанныеОписи(ДанныеОписи, Отказ);
	
	ШаблонСообщения = Отчеты.РеестрДокументовКПроводимойИнвентаризации.ПолучитьШаблонСообщенияПроверкиПередФормированиемРеестра();
	
	Если Не ЗначениеЗаполнено(ДанныеОписи.ОтветственныйИсполнительБухгалтерскойСлужбы) Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru='Ответственный исполнитель бух. службы'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "ОтветственныйИсполнительБухгалтерскойСлужбы", "Объект", Отказ);
	КонецЕсли;
	
	Если ДанныеОписи.СписокСчетов.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(ШаблонСообщения,
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, НСтр("ru='Список счетов'")));
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДанныеОписи.Ссылка, "СписокСчетов", "Объект", Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументыДляРеестраДокументовКПроводимойИнвентаризации(ДанныеОписи, ПериодФормирования) Экспорт
	
	ПараметрыПоиска = ПолучитьПараметрыПоискаОстатков(ДанныеОписи);
	
	ЗапросДокументы = Новый Запрос();
	ЗапросДокументы.УстановитьПараметр("ДатаНачала",						НачалоДня(ПериодФормирования.Дата1));
	ЗапросДокументы.УстановитьПараметр("ДатаОкончания",						КонецДня(ПериодФормирования.Дата2));
	
	ЗапросДокументы.УстановитьПараметр("Организация",						ПараметрыПоиска.Организация);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПараметрыПоиска.ИспользоватьУчетПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоИФО",			ПараметрыПоиска.ИспользоватьОтборПоИФО);
	ЗапросДокументы.УстановитьПараметр("ИФО",								ПараметрыПоиска.ИФО);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПараметрыПоиска.ИспользоватьУчетПоПодразделениям);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоПодразделению",	ПараметрыПоиска.ИспользоватьОтборПоПодразделению);
	ЗапросДокументы.УстановитьПараметр("СписокПодразделений",				ПараметрыПоиска.Подразделение);
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКонтрагенту",	ПараметрыПоиска.ИспользоватьОтборПоКонтрагенту);
	ЗапросДокументы.УстановитьПараметр("СписокКонтрагентов",				ПараметрыПоиска.СписокКонтрагентов);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьОтборПоКФО",			ПараметрыПоиска.ИспользоватьОтборПоКФО);
	ЗапросДокументы.УстановитьПараметр("СписокКФО",							ПараметрыПоиска.СписокКФО);
	ЗапросДокументы.УстановитьПараметр("СписокСчетов",						ПараметрыПоиска.СписокСчетов);
	ЗапросДокументы.УстановитьПараметр("ТаблицаИсключаемыхСчетов",			ПараметрыПоиска.ТаблицаИсключаемыхСчетов);
	
	ЗапросДокументы.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПараметрыПоиска.ИспользоватьВалютныйУчет);
	ЗапросДокументы.УстановитьПараметр("ВалютаРУ",							ПараметрыПоиска.ВалютаРУ);
	ЗапросДокументы.УстановитьПараметр("ПустаяВалюта",						ПараметрыПоиска.ПустаяВалюта);
	
	ЗапросДокументы.Текст = ПолучитьТекстЗапросаДокументыИзмененияЗадолженности();
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДокументов = ЗапросДокументы.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ТаблицаДокументов;
	
КонецФункции

