Процедура ДобавитьУсловноеОформление_НадписиСумм(УсловноеОформление, ИмяТЧ, ВалютаРУ)
	
	//
	// Надпись для рублей
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Отсутствие надписи для рублей (%1)'"), ИмяТЧ);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Истина;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru=''"));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "НадписьРублевыеСуммы");
	
	
	//
	// Надписи для иностранной валюты
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Надпись для валютных сумм иностранной валюты (%1)'"), ИмяТЧ);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Истина;
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='в валюте'"));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + "НадписьВалютныеСуммы");
	
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Надпись для рублевых сумм иностранной валюты (%1)'"), ИмяТЧ);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".Валюта");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
