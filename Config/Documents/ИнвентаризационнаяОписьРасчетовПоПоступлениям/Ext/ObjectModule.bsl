#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ЭтотОбъект) Тогда
		Документы.ИнвентаризационнаяОписьРасчетовПоПоступлениям.УстановитьВыявленыОтклонения(ЭтотОбъект);
	КонецЕсли;
	
	ЗаполнитьИтогиРаздела2();
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбновитьРеквизитыСерииЗаголовочногоДокументаСерии(ЭтотОбъект);
	// Конец СерииДокументов
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// СерииДокументов
	ИнвентаризацияСервер.ОбновитьРеквизитыСерииСодержательныхДокументовСерии(ЭтотОбъект);
	// Конец СерииДокументов
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОчищающаяСтруктура = Новый Структура("ДокументРасписки,ЭтоЗаголовочныйДокумент,ИдентификаторСерииДокументов");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ОчищающаяСтруктура);
	
КонецПроцедуры

Процедура ПриУстановкеНовогоНомера(СтандартнаяОбработка, Префикс)
	
	// СерииДокументов
	ИнвентаризацияСервер.НастроитьПрефиксДокументаСерииДокументов(ЭтотОбъект, Префикс);
	// Конец СерииДокументов
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);	
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты);
	
	Если Документы.ИнвентаризационнаяОписьРасчетовПоПоступлениям.ЕстьОшибкиЗаполнения(ЭтотОбъект) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИтогиРаздела2()
	
	КолонкиГруппировкиСчет = "Счет,КПС,КФО,КЭК";
	
	КолонкиГруппировкиКонтрагент = "Контрагент,ИдентификаторКонтрагента";
	
	КолонкиСуммирования = "СуммаРуб,СуммаПодтвержденаАктомСверкиРуб,СуммаНеПодтвержденаАктомСверкиРуб,"
		+ "СуммаРубТекущая,СуммаРубПросроченная,СуммаРубДолгосрочная,"
		+ "СуммаРубСомнительная,СуммаРубСИстекшимСрокомДавности,СуммаРубБезнадежная,СуммаРубИная";
	
	ВремТаблица = Раздел21.Выгрузить(, КолонкиГруппировкиСчет + "," + КолонкиСуммирования);
	ВремТаблица.Свернуть(КолонкиГруппировкиСчет, КолонкиСуммирования);
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(ИтогиРаздела21ПоСчету, ВремТаблица,
		КолонкиГруппировкиСчет, КолонкиСуммирования);
	
	ВремТаблица = Раздел21.Выгрузить(, КолонкиГруппировкиКонтрагент + "," + КолонкиСуммирования);
	ВремТаблица.Свернуть(КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(ИтогиРаздела21ПоКонтрагенту, ВремТаблица,
		КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
	
	ВремТаблица = Раздел22.Выгрузить(, КолонкиГруппировкиСчет + "," + КолонкиСуммирования);
	ВремТаблица.Свернуть(КолонкиГруппировкиСчет, КолонкиСуммирования);
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(ИтогиРаздела22ПоСчету, ВремТаблица,
		КолонкиГруппировкиСчет, КолонкиСуммирования);
	
	ВремТаблица = Раздел22.Выгрузить(, КолонкиГруппировкиКонтрагент + "," + КолонкиСуммирования);
	ВремТаблица.Свернуть(КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
	ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(ИтогиРаздела22ПоКонтрагенту, ВремТаблица,
		КолонкиГруппировкиКонтрагент, КолонкиСуммирования);
	
КонецПроцедуры

Процедура УдалитьНепроверяемыеРеквизиты(ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	НепроверяемыеРеквизиты.Добавить("Раздел21");
	НепроверяемыеРеквизиты.Добавить("Раздел21.НомерАктаСверки");
	НепроверяемыеРеквизиты.Добавить("Раздел21.ДатаАктаСверки");
	НепроверяемыеРеквизиты.Добавить("Раздел21.ЗаключениеКомиссии");
	
	НепроверяемыеРеквизиты.Добавить("Раздел22");
	НепроверяемыеРеквизиты.Добавить("Раздел22.НомерАктаСверки");
	НепроверяемыеРеквизиты.Добавить("Раздел22.ДатаАктаСверки");
	НепроверяемыеРеквизиты.Добавить("Раздел22.ЗаключениеКомиссии");
	
	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
