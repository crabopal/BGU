#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокКонтрагентов

&НаКлиенте
Процедура СписокКонтрагентовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ТаблицаФормыВыбор(ЭтотОбъект, Элемент, Поле);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("УстановитьОтборСтрокВТаблицеЗадолженность", 0.2, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовПередУдалением(Элемент, Отказ)
	
	Если НЕ Отказ Тогда
		
		ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
		
		// Удаляем соответствующие строки из табличной части Задолженность.
		ОтборПоКонтрагенту = Новый Структура("Контрагент", ТекущиеДанные.Контрагент);
		СтрокиПоКонтрагенту = Объект.Задолженность.НайтиСтроки(ОтборПоКонтрагенту);
		Для Каждого СтрокаЗадолженность Из СтрокиПоКонтрагенту Цикл
			Объект.Задолженность.Удалить(Объект.Задолженность.Индекс(СтрокаЗадолженность));
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	ТекущиеДанные.ИдентификаторПлательщика = ИдентификаторКонтрагента(ТекущиеДанные.Контрагент, Объект.ВидДокументаФизЛиц);
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентовВДокументе(ЭтотОбъект, Элементы.СписокКонтрагентов);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентовКонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		отбор = Новый Структура("Контрагент", ВыбранноеЗначение);
		НайденныеСтроки = Объект.СписокКонтрагентов.НайтиСтроки(отбор);
		Если НайденныеСтроки.Количество() > 0 ТОгда
			ПоказатьПредупреждение(, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Контрагент ""%1"" уже присутствует в списке.
					|Выберите другое значение.'"), ВыбранноеЗначение));
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Задолженность

&НаКлиенте
Процедура ЗадолженностьПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина; // Интерактивный ввод строк пользователем не предусмотрен.
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.Счет, ЗадолженностьПоляАналитикиСчета());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
		
		Если Копирование Тогда
			
			ТекущиеДанные.ОстатокСумма = 0;
			ТекущиеДанные.ОстатокСуммаВал = 0;
			
		Иначе
			
			ТекущийКонтрагент = Элементы.СписокКонтрагентов.ТекущиеДанные;
			Если ТекущийКонтрагент = Неопределено Тогда
				Отказ = Истина;
			Иначе
				ТекущиеДанные.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
			КонецЕсли;
			
			ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.РешениеСотрудникаПоРезолюцииВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьДопСубконтоРасчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	
	Если ТекущиеДанные.ДопСубконтоРасчетовДоступность > 0 Тогда
		ПараметрыВыбораДопСубконто = Новый Структура;
		ПараметрыВыбораДопСубконто.Вставить("Организация",   Объект.Организация);
		ПараметрыВыбораДопСубконто.Вставить("Счет",          ТекущиеДанные.Счет);
		ПараметрыВыбораДопСубконто.Вставить("КПС",			 ТекущиеДанные.КПС);
		ПараметрыВыбораДопСубконто.Вставить("КЭК",			 ТекущиеДанные.КЭК);
		ПараметрыВыбораДопСубконто.Вставить("НомерСубконто", ТекущиеДанные.ДопСубконтоРасчетовНомер);
		ПараметрыВыбораДопСубконто.Вставить("Субконто" + ТекущиеДанные.ДопСубконтоРасчетовНомер, ТекущиеДанные.ДопСубконтоРасчетов);
		БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ПараметрыВыбораДопСубконто);
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьРешениеСотрудникаПоРезолюцииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	ТекущиеДанные.РешениеСотрудникаПоРезолюции = ВыбранноеЗначение;
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьОснованиеВозникновенияЗадолженностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОткрытьФорму("Справочник.ВидыПервичныхДокументов.ФормаВыбора",,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗадолженностьСписатьСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Задолженность.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = ТекущиеДанные.ВалютаРеглУчета Тогда
		ТекущиеДанные.СписатьСуммаВал = ТекущиеДанные.СписатьСумма;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗадолженностьПоляАналитикиСчета()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, КПС, Подразделение",
		"Объект.Задолженность.Счет",
		"Объект.Задолженность.КПС",
		"Объект.Задолженность.Подразделение");

КонецФункции

&НаСервере
Процедура ЗадолженностьЗаполнитьДобавленныеКолонки()
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.Счет);
		Если СвойстваСчетаУчета.Забалансовый Тогда // Счет 20 "Задолженность, невостребованная кредиторами".
			СтрокаТаблицы.КЭКУчета = Строка(СтрокаТаблицы.КЭК);
		ИначеЕсли СвойстваСчетаУчета.БезДетализацииКОСГУ Тогда
			СтрокаТаблицы.КЭКУчета = "000";
		Иначе
			СтрокаТаблицы.КЭКУчета = "00" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТаблицы.Контрагент, "ТипКонтрагента.Код");
		КонецЕсли;
		
		СтрокаТаблицы.ДоговорДоступность = 0;
		СтрокаТаблицы.ДопСубконтоРасчетовДоступность = 0;
		СтрокаТаблицы.НалогСборПлатежДоступность = 0;
		Для НомерСубконто = 1 По СвойстваСчетаУчета.КоличествоСубконто Цикл
			Если СвойстваСчетаУчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				СтрокаТаблицы.ДоговорДоступность = ?(СвойстваСчетаУчета["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
			ИначеЕсли СвойстваСчетаУчета["ВидСубконто" + НомерСубконто] <> ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
					И СвойстваСчетаУчета["ВидСубконто" + НомерСубконто] <> ПланыВидовХарактеристик.ВидыСубконто.Договоры
					И СтрНайти(СвойстваСчетаУчета["Код"], "303") = 0 Тогда // Кроме счетов 303.00.
				СтрокаТаблицы.ДопСубконтоРасчетовДоступность = ?(СвойстваСчетаУчета["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
				СтрокаТаблицы.ДопСубконтоРасчетовНомер = НомерСубконто;
			ИначеЕсли СвойстваСчетаУчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации Тогда
				СтрокаТаблицы.НалогСборПлатежДоступность = ?(СвойстваСчетаУчета["ВидСубконто" + НомерСубконто + "Обязательный"], 1, 2);
			КонецЕсли;
		КонецЦикла;
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.Счет, ЗадолженностьПоляАналитикиСчета());
		
		ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗадолженностьЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ВалютаРеглУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Комиссия

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	КомиссияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииПриИзменении(Элемент)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствияКлиентСервер.ОбновитьИндикатор(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииОтсутствуетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	Если Не ТекущиеДанные.Отсутствует Тогда
		ТекущиеДанные.ПричинаОтсутствия = "";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииПричинаОтсутствияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	ТекущиеДанные.Отсутствует = Не ПустаяСтрока(ТекущиеДанные.ПричинаОтсутствия);
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииПричинаОтсутствияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ОткрытьФорму("Справочник.ПричиныОтсутствияСотрудников.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.ИФО");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.Задолженность.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено, а данные будут очищены. Заполнить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Перед заполнением проведение документа будет отменено. Заполнить?'");
	ИначеЕсли ЕстьДанныеВДокументе > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Заполнить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьОтборСтрокВТаблицеЗадолженность();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросЗаполнитьДокументЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере();
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьОтборСтрокВТаблицеЗадолженность();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьКредиторскуюЗадолженностьВоВсехСтроках(Команда)
	
	ЭтоСписаниеСоСчета30300 = (Счета30300.НайтиПоЗначению(Объект.СчетУчета) <> Неопределено);
	Если ЭтоСписаниеСоСчета30300 Тогда
		
		СоздатьВосстановлениеКредиторскойЗадолженности(Объект.Задолженность);
		
	Иначе
		
		ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОтборПоКонтрагенту = Новый Структура("Контрагент", ТекущиеДанные.Контрагент);
		СтрокиСписанияПоКонтрагенту = Объект.Задолженность.НайтиСтроки(ОтборПоКонтрагенту);
		
