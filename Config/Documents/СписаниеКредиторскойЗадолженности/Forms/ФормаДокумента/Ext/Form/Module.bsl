	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьВалюта");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьОстатокСуммаВал");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьСписатьСуммаВал");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Валюта", ВидСравненияКомпоновкиДанных.Равно,
			ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Решение сотрудника.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.За);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.РешениеСотрудникаПоРезолюции", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.РезультатыГолосованияЧленовКомиссии.Против);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(
		УсловноеОформление, ЗадолженностьПоляАналитикиСчета());
	
КонецПроцедуры

&НаКлиенте
Функция ОчиститьДокументПараметрыВопроса()
	
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ЗадатьВопрос", Ложь);
	ПараметрыВопроса.Вставить("ТекстВопроса", "");
	
	ЕстьДанныеВДокументе = (Объект.Задолженность.Количество() > 0);
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены. Продолжить?'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено. Продолжить?'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены. Продолжить?'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат ПараметрыВопроса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Отказ = Документы.СписаниеКредиторскойЗадолженности.ЗаполнитьПоДаннымУчета(Объект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗадолженностьЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент, ВидДокументаФизЛиц);
	
КонецФункции

&НаСервере
Процедура УстановитьСрокНаблюденияВТаблицеЗадолженность()
	
	Для Каждого СтрокаЗадолженность Из Объект.Задолженность Цикл
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			СтрокаЗадолженность.СрокНаблюдения = Неопределено; // Дата окончания наблюдения (срока исковой давности). В текущей версии автоматически не заполняется.
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			СтрокаЗадолженность.СрокНаблюдения = Объект.Дата; // Дата в колонке (15) равнв дате формирования Решения (ф.0510437).
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			СтрокаЗадолженность.СрокНаблюдения = НачалоДня(Объект.Дата) - 1; // Дата в колонке (15) равна Дате Решения минус один день.
		Иначе
			СтрокаЗадолженность.СрокНаблюдения = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборСтрокВТаблицеЗадолженность()
	
	ЭтоСписаниеСоСчета30300 = (Счета30300.НайтиПоЗначению(Объект.СчетУчета) <> Неопределено);
	
	ТекущиеДанные = Элементы.СписокКонтрагентов.ТекущиеДанные;
	Если ЭтоСписаниеСоСчета30300 Тогда
		НовыйОтборСтрок = Неопределено;
	ИначеЕсли ТекущиеДанные = Неопределено Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("Контрагент", Неопределено);
	Иначе
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("Контрагент", ТекущиеДанные.Контрагент);
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.Задолженность.ОтборСтрок;
	Если ТекущийОтборСтрок = Неопределено
	 ИЛИ НовыйОтборСтрок = Неопределено
	 ИЛИ ТекущийОтборСтрок.Контрагент <> НовыйОтборСтрок.Контрагент Тогда
		Элементы.Задолженность.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаСервере
Процедура УстановитьРеквизитыЛокальногоАкта()
	
	// Реквизиты локального акта, которым установлен порядок принятия решения.
	РеквизитыЛокальногоАкта = ОбщегоНазначенияБГУ.РеквизитыЛокальногоАктаПоУмолчанию("СписаниеКредиторскойЗадолженности", Объект.Организация);
	
	Если Объект.ВидЛокальногоАкта <> РеквизитыЛокальногоАкта.ВидЛокальногоАкта
	 ИЛИ Объект.НомерЛокальногоАкта <> РеквизитыЛокальногоАкта.НомерЛокальногоАкта
	 ИЛИ Объект.ДатаЛокальногоАкта <> РеквизитыЛокальногоАкта.ДатаЛокальногоАкта Тогда
		СообщатьОбИзмененииРеквизитовЛокальногоАкта = Истина;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыЛокальногоАкта);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьВосстановлениеКредиторскойЗадолженности(СтрокиРешенияОСписании)
	
	ТекстЗаголовкаПредупреждений = НСтр("ru = 'Восстановление кредиторской задолженности'");
	ИспользоватьУчетПоИФО = ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО;
	
	// Проверим, что выбраны строки с одинаковым счетом и ИФО.
	ЭтоПерваяСтрока = Истина;
	НомераСтрокРешенияОСписании = Новый Массив;
	Для Каждого СтрокаРешенияОСписании Из СтрокиРешенияОСписании Цикл
		
		Если ТипЗнч(СтрокаРешенияОСписании) = Тип("Число") Тогда
			ДанныеСтроки = Объект.Задолженность.НайтиПоИдентификатору(СтрокаРешенияОСписании);
		Иначе
			ДанныеСтроки = СтрокаРешенияОСписании;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			ПредыдущийИФО = ДанныеСтроки.ИФО;
			ПредыдущийКонтрагент = ДанныеСтроки.Контрагент;
			ПредыдущаяВалюта = ДанныеСтроки.Валюта;
			ЭтоПерваяСтрока = Ложь;
		Иначе
			// Проверим, что выбраны строки с одинаковым контрагентом, валютой и ИФО.
			Если ИспользоватьУчетПоИФО И (ПредыдущийИФО <> ДанныеСтроки.ИФО ИЛИ ПредыдущийКонтрагент <> ДанныеСтроки.Контрагент ИЛИ ПредыдущаяВалюта <> ДанныеСтроки.Валюта) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями полей Контрагент, Валюта и ИФО.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			ИначеЕсли Не ИспользоватьУчетПоИФО И (ПредыдущийКонтрагент <> ДанныеСтроки.Контрагент ИЛИ ПредыдущаяВалюта <> ДанныеСтроки.Валюта) Тогда
				ПоказатьПредупреждение(, НСтр("ru='Выберите строки с одинаковыми значениями полей Контрагент и Валюта.'"), 10, ТекстЗаголовкаПредупреждений);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		НомераСтрокРешенияОСписании.Добавить(ДанныеСтроки.НомерСтроки);
		
	КонецЦикла;
	
	// Создание документа восстановления кредиторской задолженности.
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВводНаОсновании", Истина);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("НомераСтрокРешенияОСписании", НомераСтрокРешенияОСписании);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.ВосстановлениеКредиторскойЗадолженности.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
	
КонецПроцедуры

