&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоСписаниеСоСчета30300 = (Форма.Счета30300.НайтиПоЗначению(Объект.СчетУчета) <> Неопределено);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗадолженностьКЭК", "Видимость",
		Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности"));
	
	РасчетыСКонтрагентами = Новый Массив;
	РасчетыСКонтрагентами.Добавить("СписокКонтрагентов");
	РасчетыСКонтрагентами.Добавить("ЗадолженностьДоговор");
	РасчетыСКонтрагентами.Добавить("ЗадолженностьДопСубконтоРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РасчетыСКонтрагентами, "Видимость", Не ЭтоСписаниеСоСчета30300);
	
	РасчетыПоНалогам = Новый Массив;
	РасчетыПоНалогам.Добавить("ЗадолженностьВидНалогаИлиПлатежа");
	РасчетыПоНалогам.Добавить("ЗадолженностьНалогСборПлатеж");
	РасчетыПоНалогам.Добавить("ЗадолженностьКонтрагент");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РасчетыПоНалогам, "Видимость", ЭтоСписаниеСоСчета30300);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Обязательный договор.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЗадолженностьДоговор");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.ДоговорДоступность", ВидСравненияКомпоновкиДанных.Равно, 1);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.Задолженность.Договор", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
