#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Процедура СформироватьОписаниеДокументовСТабличнымиЧастями(Форма, Описание) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписаниеТабличныхЧастей(
	Форма, Описание, "СписокКонтрагентов", "СписокКонтрагентовКонтрагент", "");

КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.Задолженность Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ГруппаГолосование");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьИтогГолосования");
	ЭлементыГолосование.Добавить("ЗадолженностьРезолюцияКомиссииОдобрена");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования ИЛИ Объект.Проведен);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЕдиногласноЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЕдиногласноПротивВоВсехСтроках");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И Не ЗначениеЗаполнено(Форма.Сотрудник));
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЗаВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеПротивВоВсехСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеЗаВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьУстановитьРешениеПротивВВыделенныхСтроках");
	ЭлементыГолосование.Добавить("ЗадолженностьРешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник) И Форма.РешениеСотрудникаМодифицированность);
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Решение о списании задолженности, невостребованной кредиторами (ф.0510437).
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор       = "СписаниеКредиторскойЗадолженности_Форма0510437";
	КомандаПечати.Представление       = НСтр("ru = 'Решение о списании задолженности, невостребованной кредиторами (ф.0510437)'");
	КомандаПечати.МенеджерПечати      = "Документ.СписаниеКредиторскойЗадолженности";
	КомандаПечати.Порядок             = 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СписаниеКредиторскойЗадолженности_Форма0510437") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"СписаниеКредиторскойЗадолженности_Форма0510437",
			"Решение о списании задолженности, невостребованной кредиторами (ф.0510437)",
			ПечатьФормы0510437(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПечатьФормы0510437(МассивОбъектов, ОбъектыПечати)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СписаниеКредиторскойЗадолженности.ПФ_MXL_Ф0510437");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.АвтоМасштаб				= Истина;
	ТабДокумент.ОриентацияСтраницы		= ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_СписаниеКредиторскойЗадолженности_ф0510437";
	
	ДанныеДляПечати = ПолучитьДанныеДляПечати(МассивОбъектов);
	ВыборкаШапка = ДанныеДляПечати.Шапка.Выбрать();
	ВыборкаЗадолженность = ДанныеДляПечати.Задолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл // Цикл по документам.
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбщиеСведенияПоДокументу = ДанныеДляПечати.ОбщиеСведения.Получить(ВыборкаШапка.Ссылка);
		
		ВывестиШапку(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу);
		
		ВывестиРазделСведенияОЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность, "ПоВыплатамРасходов",
			ДанныеДляПечати.РезультатыГолосования);
		ВывестиРазделСведенияОЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность, "ПоВозвратамПереплатДоходов",
			ДанныеДляПечати.РезультатыГолосования);
		
		ВывестиПодвал(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведенияПоДокументу, ДанныеДляПечати.СоставКомиссий);
		
		// В табличном документе зададим имя области, в которую был выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
		
	КонецЦикла;
	
	ТабДокумент.ВерхнийКолонтитул.Выводить			= Истина;
	ТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ТабДокумент.ВерхнийКолонтитул.ТекстСправа		= НСтр("ru='Форма 0510437 с.[&НомерСтраницы]'");
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ТекстыЗапросов     = Новый Массив;
	ИндексыРезультатов = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	ИндексыРезультатов.Вставить("Шапка", ТекстыЗапросов.Количество());
	ТекстыЗапросов.Добавить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписаниеКредиторскойЗадолженности.Ссылка КАК Ссылка,
	|	СписаниеКредиторскойЗадолженности.Номер КАК пНомер,
	|	СписаниеКредиторскойЗадолженности.Дата КАК пДата,
	|	СписаниеКредиторскойЗадолженности.Организация КАК Организация,
	|	СписаниеКредиторскойЗадолженности.Руководитель КАК Руководитель,
	|	СписаниеКредиторскойЗадолженности.Ответственный КАК Ответственный,
	|	ПРЕДСТАВЛЕНИЕ(СписаниеКредиторскойЗадолженности.СчетУчета) КАК НомерСчета,
	|	СписаниеКредиторскойЗадолженности.Комиссия.НаименованиеПриказа КАК ДокументОСозданииКомиссии,
	|	СписаниеКредиторскойЗадолженности.Комиссия.НомерПриказа КАК ДокументОСозданииКомиссииНомер,
	|	СписаниеКредиторскойЗадолженности.Комиссия.ДатаПриказа КАК ДокументОСозданииКомиссииДата,
	|	СписаниеКредиторскойЗадолженности.ВидОперации КАК ВидОперации,
	|	СписаниеКредиторскойЗадолженности.ВидЛокальногоАкта КАК ВидЛокальногоАкта,
	|	СписаниеКредиторскойЗадолженности.НомерЛокальногоАкта КАК НомерЛокальногоАкта,
	|	СписаниеКредиторскойЗадолженности.ДатаЛокальногоАкта КАК ДатаЛокальногоАкта,
	|	ВЫБОР
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризацияРасчетовСКонтрагентами
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Номер
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Номер
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Номер
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИнвентаризационнаяОпись1,
	|	ВЫБОР
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризацияРасчетовСКонтрагентами
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Дата
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Дата
	|		КОГДА СписаниеКредиторскойЗадолженности.ДокументОснование ССЫЛКА Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами
	|			ТОГДА СписаниеКредиторскойЗадолженности.ДокументОснование.Дата
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИнвентаризационнаяОпись1Дата
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности КАК СписаниеКредиторскойЗадолженности
	|ГДЕ
	|	СписаниеКредиторскойЗадолженности.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер");
	
	ИндексыРезультатов.Вставить("Задолженность", ТекстыЗапросов.Количество());
	ТекстыЗапросов.Добавить(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Задолженность.Ссылка КАК Ссылка,
	|	Задолженность.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Задолженность.НомерСтроки КАК КодСтроки,
	|	СписокКонтрагентов.НомерСтроки КАК НомерСтрокиСпискаКонтрагентов,
	|	Задолженность.ИФО КАК ИФО,
	|	Задолженность.КФО КАК КФО,
	|	Задолженность.Подразделение КАК Подразделение,
	|	Задолженность.Счет КАК Счет,
	|	ЕСТЬNULL(Задолженность.Счет.Код, """") КАК СчетКод,
	|	ЕСТЬNULL(Задолженность.Счет.Забалансовый, ЛОЖЬ) КАК СчетЗабалансовый,
	|	ЕСТЬNULL(Задолженность.Счет.БезДетализацииКОСГУ, ЛОЖЬ) КАК СчетБезДетализацииКОСГУ,
	|	Задолженность.КПС КАК КПС,
	|	Задолженность.КЭК КАК КЭК,
	|	Задолженность.Контрагент КАК Контрагент,
	|	Задолженность.Контрагент.ТипКонтрагента.Код КАК ТипКонтрагентаКод,
	|	ВЫБОР
	|		КОГДА Задолженность.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|			ТОГДА Задолженность.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|		КОГДА Задолженность.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И Задолженность.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА Задолженность.Контрагент.ЮридическоеФизическоеЛицо.Наименование
	|		КОГДА Задолженность.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|				И НЕ Задолженность.Контрагент.ЮридическоеФизическоеЛицо.ОГРНИП = """"
	|			ТОГДА Задолженность.Контрагент.НаименованиеСокращенное
	|		ИНАЧЕ Задолженность.Контрагент.Наименование
	|	КОНЕЦ КАК НаименованиеКонтрагента,
	|	СписокКонтрагентов.ИдентификаторПлательщика КАК ИдентификаторКонтрагента,
	|	Задолженность.Договор КАК Договор,
	|	Задолженность.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	Задолженность.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	Задолженность.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	Задолженность.Договор.УИН КАК ДоговорУИН,
	|	УчетныеНомераОбязательств.УчетныйНомерОбязательства КАК УчетныйНомерОбязательства,
	|	Задолженность.ОснованиеВозникновенияЗадолженности КАК ОснованиеВозникновенияЗадолженности,
	|	Задолженность.ОснованиеВозникновенияЗадолженностиНомер КАК ОснованиеВозникновенияЗадолженностиНомер,
	|	Задолженность.ОснованиеВозникновенияЗадолженностиДата КАК ОснованиеВозникновенияЗадолженностиДата,
	|	Задолженность.ДопСубконтоРасчетов КАК ДопСубконтоРасчетов,
	|	Задолженность.Валюта КАК Валюта,
	|	Задолженность.Валюта.Код КАК КодВалюты,
	|	Задолженность.СписатьСумма КАК ЗадолженностьРуб,
	|	ВЫБОР
	|		КОГДА Задолженность.Валюта <> &ВалютаРегламентированногоУчета
	|			ТОГДА Задолженность.СписатьСуммаВал
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЗадолженностьВал,
	|	Задолженность.РезолюцияКомиссии КАК РезолюцияКомиссии,
	|	Задолженность.СрокНаблюдения КАК ДатаЗавершенияСрокаНаблюдения
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности.Задолженность КАК Задолженность
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеКредиторскойЗадолженности.СписокКонтрагентов КАК СписокКонтрагентов
	|		ПО Задолженность.Ссылка = СписокКонтрагентов.Ссылка
	|			И Задолженность.Контрагент = СписокКонтрагентов.Контрагент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
	|		ПО Задолженность.Договор = УчетныеНомераОбязательств.Обязательство
	|ГДЕ
	|	Задолженность.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтрокиСпискаКонтрагентов,
	|	КодСтроки
	|ИТОГИ
	|	МАКСИМУМ(ИдентификаторКонтрагента),
	|	СУММА(ЗадолженностьРуб)
	|ПО
	|	Ссылка,
	|	Контрагент");
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("Шапка",              Результаты[ИндексыРезультатов.Шапка]);
	ДанныеДляПечати.Вставить("Задолженность",      Результаты[ИндексыРезультатов.Задолженность]);
	
	// Добавим состав и результаты голосования комиссии по документам.
	ДанныеДляПечати.Вставить("РезультатыГолосования", 
		ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов));
	ДанныеДляПечати.Вставить("СоставКомиссий", 
		ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	
	// Добавим общие сведения для печати.
	ДанныеДляПечати.Вставить("ОбщиеСведения", 
		УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ВывестиШапку(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведения)
	
	ОбластьШапка         = Макет.ПолучитьОбласть("Шапка");
	ОбластьТитул1        = Макет.ПолучитьОбласть("Титул1");
	ОбластьТитулКомиссия = Макет.ПолучитьОбласть("ТитулКомиссия");
	
	ОбластьШапка.Параметры.ФИОРуководителя =
		Справочники.Сотрудники.ФамилияИО(ВыборкаШапка.Руководитель, Ложь, ВыборкаШапка.пДата);
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", ВыборкаШапка.Руководитель, ВыборкаШапка.пДата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	ОбластьШапка.Параметры.ДолжностьРуководителя = ДанныеПодписанта.Должность;
	
	ОбластьТитул1.Параметры.Заполнить(ВыборкаШапка);
	
	ЗаполнитьЗначенияСвойств(ОбластьТитул1.Параметры, ОбщиеСведения,
		"НаименованиеОрганизации, НаименованиеОбособленногоПодразделения, НаименованиеСтруктурногоПодразделения, СтруктурноеПодразделение,
		|Учредитель, БюджетНаименование, КодРПБС, КодРПБСОбособленногоПодразделения, ГлаваБК, ОКТМО");
	
	РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьТитул1,
		"пНомер",ВыборкаШапка.пНомер, ВыборкаШапка.Ссылка, Неопределено, Истина);
	
	ОбластьТитул1.Параметры.ДатаСтрокой = Формат(ВыборкаШапка.пДата, "ДЛФ=ДД");
	
	ОбластьТитулКомиссия.Параметры.Заполнить(ВыборкаШапка);
	
	ТабДокумент.Вывести(ОбластьШапка);
	ТабДокумент.Вывести(ОбластьТитул1);
	ТабДокумент.Вывести(ОбластьТитулКомиссия);
	
КонецФункции

Функция ВывестиРазделСведенияОЗадолженности(Макет, ТабДокумент, ВыборкаШапка, ВыборкаЗадолженность, ИмяРаздела, РезультатыГолосования)
	
	ОбластьЗаголовокСведенияОЗадолженности = Макет.ПолучитьОбласть("ЗаголовокСведенияОЗадолженности" + ИмяРаздела);
	ОбластьЗаголовокГруппаУчета            = Макет.ПолучитьОбласть("ЗаголовокГруппаУчета");
	ОбластьЗаголовокТаблицыЗадолженности   = Макет.ПолучитьОбласть("ЗаголовокТаблицыЗадолженности" + ИмяРаздела);
	ОбластьСтрокаТаблицыЗадолженности      = Макет.ПолучитьОбласть("СтрокаТаблицыЗадолженности" + ИмяРаздела);
	ОбластьИтогПоКонтрагенту               = Макет.ПолучитьОбласть("ИтогПоКонтрагентуТаблицыЗадолженности");
	ОбластьИтогПоГруппеУчета               = Макет.ПолучитьОбласть("ИтогПоГруппеУчетаТаблицыЗадолженности");
	ОбластьОбщийИтог                       = Макет.ПолучитьОбласть("ИтогТаблицыЗадолженности");
	
	ТабДокумент.Вывести(ОбластьЗаголовокСведенияОЗадолженности);
	
	Если ИмяРаздела = "ПоВыплатамРасходов" Тогда
		ОбластьЗаголовокГруппаУчета.Параметры.ГруппаУчетаЗаголовок = НСтр("ru = '1.1 Группа учета'");
	ИначеЕсли ИмяРаздела = "ПоВозвратамПереплатДоходов" Тогда
		ОбластьЗаголовокГруппаУчета.Параметры.ГруппаУчетаЗаголовок = НСтр("ru = '2.1 Группа учета'");
	КонецЕсли;
	ОбластьЗаголовокГруппаУчета.Параметры.ГруппаУчета = НСтр("ru = ''");
	ТабДокумент.Вывести(ОбластьЗаголовокГруппаУчета);
	
	ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
	
	ВыборкаЗадолженность.Сбросить();
	ОтборСтрок = Новый Структура("Ссылка", ВыборкаШапка.Ссылка);
	Если ВыборкаЗадолженность.НайтиСледующий(ОтборСтрок) Тогда
		ОбластьОбщийИтог.Параметры.Заполнить(ВыборкаЗадолженность);
		ВыборкаИтогиПоКонтрагентам = ВыборкаЗадолженность.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		КоличествоСтрок = ВыборкаИтогиПоКонтрагентам.Количество();
	Иначе
		КоличествоСтрок = 0;
	КонецЕсли;
	
	ОбщийИтог = 0;
	
	Если КоличествоСтрок > 0 Тогда
		
		Пока ВыборкаИтогиПоКонтрагентам.Следующий() Цикл
			
			ОбластьИтогПоКонтрагенту.Параметры.Заполнить(ВыборкаИтогиПоКонтрагентам);
			
			ВыводитьИтогПоКонтрагенту = Ложь;
			ИтогПоКонтрагенту = 0;
			
			ВыборкаСтрок = ВыборкаИтогиПоКонтрагентам.Выбрать();
			Пока ВыборкаСтрок.Следующий() Цикл
				
				// Распределение строк между разделами:
				// 1. Сведения о кредиторской задолженности по выплатам расходов (источников финансирования дефицита).
				// 2. Сведения о кредиторской задолженности по возвратам переплат доходов (источников финансирования дефицита).
				ЭтоСчетРасчетовПоДоходам = БухгалтерскийУчет.СчетВИерархии(ВыборкаСтрок.Счет, "205.00,207.00,209.00");
				ЭтоСчет20 = БухгалтерскийУчет.СчетВИерархии(ВыборкаСтрок.Счет, "20");
				Если ЭтоСчет20 Тогда
					ЭтоДоходныйКЭК = БухгалтерскийУчет.КЭКВИерархии(ВыборкаСтрок.КЭК, "100");
					Если ИмяРаздела = "ПоВозвратамПереплатДоходов" И НЕ ЭтоДоходныйКЭК Тогда
						Продолжить;
					ИначеЕсли ИмяРаздела = "ПоВыплатамРасходов" И ЭтоДоходныйКЭК Тогда
						Продолжить;
					КонецЕсли;
				Иначе
					Если ИмяРаздела = "ПоВозвратамПереплатДоходов" И НЕ ЭтоСчетРасчетовПоДоходам Тогда
						Продолжить;
					ИначеЕсли ИмяРаздела = "ПоВыплатамРасходов" И ЭтоСчетРасчетовПоДоходам Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Попытка 
					
					Если НЕ ТабДокумент.ПроверитьВывод(ОбластьСтрокаТаблицыЗадолженности) Тогда
						ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
						ТабДокумент.Вывести(ОбластьЗаголовокТаблицыЗадолженности);
					КонецЕсли;	
					
				Исключение
					//Сообщить("В системе не установлено ни одного принтера.");
				КонецПопытки;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.Заполнить(ВыборкаСтрок);
				
				Если Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженности)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер)
					И Не ЗначениеЗаполнено(ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата) Тогда // Из реквизитов договора.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ДоговорВидОбязательства;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ДоговорНомерДоговора;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ДоговорДатаДоговора;
				Иначе // Из реквизитов документа.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснование      = ВыборкаСтрок.ОснованиеВозникновенияЗадолженности;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеНомер = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиНомер;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ДокументОснованиеДата  = ВыборкаСтрок.ОснованиеВозникновенияЗадолженностиДата;
				КонецЕсли;
				
				Если ВыборкаСтрок.СчетЗабалансовый Тогда
					КЭКУчета = СокрЛП(ВыборкаСтрок.КЭК);
				ИначеЕсли ВыборкаСтрок.СчетБезДетализацииКОСГУ Тогда
					КЭКУчета = "000";
				Иначе
					КЭКУчета = "00" + ВыборкаСтрок.ТипКонтрагентаКод;
				КонецЕсли;
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.НомерСчета = СтрШаблон("%1 %2 %3 %4",
					СокрЛП(ВыборкаСтрок.КПС),
					СокрЛП(ВыборкаСтрок.КФО),
					СтрЗаменить(ВыборкаСтрок.СчетКод, ".", " "),
					КЭКУчета);
				
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КодВыплатыПоБК = ВыборкаСтрок.КПС;
				ОбластьСтрокаТаблицыЗадолженности.Параметры.КОСГУ = ВыборкаСтрок.КЭК;
				
				// Результаты голосования комиссии по строке документа.
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					ВыборкаШапка.Ссылка, ВыборкаСтрок.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0
					И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда // Результаты голосования выводим, только если голосование по документу завершено.
					
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					
					Если РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена Тогда
						ОбластьСтрокаТаблицыЗадолженности.Параметры.РезолюцияПоИтогуГолосования = "";
					Иначе
						ОбластьСтрокаТаблицыЗадолженности.Параметры.РезолюцияПоИтогуГолосования = НСтр("ru = 'снято с обсуждения'");
					КонецЕсли;
					
				Иначе // Результаты голосования по строке документа не найдены.
					ОбластьСтрокаТаблицыЗадолженности.Параметры.ИтогГолосования = 0;
					ОбластьСтрокаТаблицыЗадолженности.Параметры.РезолюцияПоИтогуГолосования = "";
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьСтрокаТаблицыЗадолженности);
				
				ВыводитьИтогПоКонтрагенту = Истина; // Если хотя бы одна строка была выведена в этом разделе.
				ИтогПоКонтрагенту = ИтогПоКонтрагенту + ВыборкаСтрок.ЗадолженностьРуб;
				ОбщийИтог = ОбщийИтог + ВыборкаСтрок.ЗадолженностьРуб;
				
			КонецЦикла;
			
			Если ВыводитьИтогПоКонтрагенту Тогда
				ТабДокумент.Вывести(ОбластьИтогПоКонтрагенту);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьИтогПоГруппеУчета);
	
	ОбластьОбщийИтог.Параметры.ЗадолженностьРуб = ОбщийИтог;
	ТабДокумент.Вывести(ОбластьОбщийИтог);
	
КонецФункции

Функция ВывестиПодвал(Макет, ТабДокумент, ВыборкаШапка, ОбщиеСведения, СоставКомиссий)
	
	// Приложение.
	Файлы = УправлениеПечатьюБГУ.ПолучитьСписокФайловДокумента(ВыборкаШапка.Ссылка);
	Для Каждого Приложение Из Файлы Цикл
		ОбластьМакетаПриложение = Макет.ПолучитьОбласть("Приложение");
		ОбластьМакетаПриложение.Параметры.Заполнить(Приложение);
		ТабДокумент.Вывести(ОбластьМакетаПриложение);
	КонецЦикла;
	
	// Состав комиссии.
	Если СоставКомиссий.Количество() > 0 Тогда
		
		ВыводимыеОбласти = Новый Массив;
		
		// Председатель.
		Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Истина);
		СтрокиПредседатель = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого Председатель Из СтрокиПредседатель Цикл
			ОбластьМакетаЧленКомиссии = Макет.ПолучитьОбласть("ЧленКомиссии");
			ОбластьМакетаЧленКомиссии.Параметры.Заполнить(Председатель);
			ОбластьМакетаЧленКомиссии.Параметры.Заголовок = НСтр("ru = 'Председатель комиссии'");
			ОбластьМакетаЧленКомиссии.Параметры.ДолжностьЧленаКомиссии = Председатель.Должность;
			ОбластьМакетаЧленКомиссии.Параметры.ФИОЧленаКомиссии = КорреспондентыКлиентСервер.ФИО(Председатель);
			ВыводимыеОбласти.Добавить(ОбластьМакетаЧленКомиссии);
		КонецЦикла;
		
		// Члены комиссии.
		Отбор = Новый Структура("Ссылка,Председатель", ВыборкаШапка.Ссылка, Ложь);
		СтрокиЧленыКомиссии = СоставКомиссий.НайтиСтроки(Отбор);
		ПерваяСтрока = Истина;
		Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
			ОбластьМакетаЧленКомиссии = Макет.ПолучитьОбласть("ЧленКомиссии");
			ОбластьМакетаЧленКомиссии.Параметры.Заполнить(ЧленКомиссии);
			ОбластьМакетаЧленКомиссии.Параметры.Заголовок = ?(ПерваяСтрока, НСтр("ru = 'Члены комиссии:'"), "");
			ОбластьМакетаЧленКомиссии.Параметры.ДолжностьЧленаКомиссии = ЧленКомиссии.Должность;
			ОбластьМакетаЧленКомиссии.Параметры.ФИОЧленаКомиссии = КорреспондентыКлиентСервер.ФИО(ЧленКомиссии);
			ВыводимыеОбласти.Добавить(ОбластьМакетаЧленКомиссии);
			ПерваяСтрока = Ложь;
		КонецЦикла;
		
		Попытка
			Если НЕ ТабДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
				ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		Исключение
		КонецПопытки;
		Для Каждого Область Из ВыводимыеОбласти Цикл
			ТабДокумент.Вывести(Область);
		КонецЦикла;
		
	КонецЕсли;
	
	// Подвал.
	ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
	ЗаполнитьЗначенияСвойств(ОбластьМакетаПодвал.Параметры, ОбщиеСведения,
		"ОтветственныйФИО, ОтветственныйДолжность, ОтветственныйТелефон, ОтветственныйЭлПочта");
	ОбластьМакетаПодвал.Параметры.ДатаСтрокой = Формат(ВыборкаШапка.пДата, "ДЛФ=ДД");
	ТабДокумент.Вывести(ОбластьМакетаПодвал);
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокумента

Функция ЗаполнитьПоДаннымУчета(Объект, Контрагент = Неопределено) Экспорт
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",  Объект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("СчетаОстатков", БухгалтерскийУчет.СписокСчетов(Объект.СчетУчета));
	
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	ЭтоСписаниеСоСчета20700 = БухгалтерскийУчет.СчетВИерархии(Объект.СчетУчета, "207.00");
	ЭтоСписаниеСоСчета30300 = БухгалтерскийУчет.СчетВИерархии(Объект.СчетУчета, "303.00");
	
	Если ЭтоСписаниеСоСчета30300 Тогда // Списание кредиторской задолженности по налогам (сборам).
		
		Объект.Задолженность.Очистить();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
		|	Остатки.КФО КАК КФО,
		|	Остатки.КПС КАК КПС,
		|	Остатки.КЭК КАК КЭК,
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Код КАК СчетКод,
		|	Остатки.Счет.УчетПоПодразделениям КАК СчетУчетПоПодразделениям,
		|	Остатки.Счет.Забалансовый КАК СчетЗабалансовый,
		|	Остатки.Подразделение КАК Подразделение,
		|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.ВидыНалоговИПлатежей) КАК ВидНалогаИлиПлатежа,
		|	ВЫБОР
		|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
		|			ТОГДА Остатки.Субконто2
		|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.НалогиИПлатежиОрганизации
		|			ТОГДА Остатки.Субконто3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НалогиИПлатежиОрганизации.ПустаяСсылка)
		|	КОНЕЦ КАК НалогСборПлатеж,
		|	ВЫБОР
		|		КОГДА Остатки.Валюта ЕСТЬ NULL
		|				ИЛИ Остатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРеглУчета
		|		ИНАЧЕ Остатки.Валюта
		|	КОНЕЦ КАК Валюта,
		|	Остатки.СуммаОстатокКт КАК ОстатокСумма,
		|	Остатки.ВалютнаяСуммаОстатокКт КАК ОстатокСуммаВал
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонецПериода,
		|			Счет В (&СчетаОстатков),
		|			,
		|			Организация = &Организация
		|				И &УсловиеПоИФО) КАК Остатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	СчетКод,
		|	ВидНалогаИлиПлатежа,
		|	НалогСборПлатеж,
		|	ИФО,
		|	КФО,
		|	КПС,
		|	КЭК";
		
	Иначе // Списание кредиторской задолженности по расчетам с контрагентами.
		
		Если Контрагент = Неопределено Тогда // По всем контрагентам в документе.
			
			Запрос.УстановитьПараметр("СписокКонтрагентов",
				Объект.СписокКонтрагентов.Выгрузить().ВыгрузитьКолонку("Контрагент"));
			
			// Удаляем строки по всем Контрагентам.
			Объект.Задолженность.Очистить();
			
		Иначе // По выбранному контрагенту (группе учета).
			
			Запрос.УстановитьПараметр("СписокКонтрагентов", Контрагент);
			
			// Удаляем строки по Контрагенту.
			Отбор = Новый Структура("Контрагент", Контрагент);
			СтрокиКУдалению = Объект.Задолженность.НайтиСтроки(Отбор);
			Для Каждого Строка Из СтрокиКУдалению Цикл
				Объект.Задолженность.Удалить(Строка);
			КонецЦикла;
			
		КонецЕсли;
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.Организация КАК Организация,
		|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
		|	Остатки.КФО КАК КФО,
		|	Остатки.КПС КАК КПС,
		|	Остатки.КЭК КАК КЭК,
		|	Остатки.Счет КАК Счет,
		|	Остатки.Счет.Код КАК СчетКод,
		|	Остатки.Счет.УчетПоПодразделениям КАК СчетУчетПоПодразделениям,
		|	Остатки.Счет.Забалансовый КАК СчетЗабалансовый,
		|	Остатки.Подразделение КАК Подразделение,
		|	ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
		|	ВЫБОР
		|		КОГДА Остатки.Субконто2 ССЫЛКА Справочник.Договоры
		|			ТОГДА Остатки.Субконто2
		|		КОГДА Остатки.Субконто3 ССЫЛКА Справочник.Договоры
		|			ТОГДА Остатки.Субконто3
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|	КОНЕЦ КАК Договор,
		|	ВЫБОР
		|		КОГДА НЕ Остатки.Субконто2 ССЫЛКА Справочник.Контрагенты
		|				И НЕ Остатки.Субконто2 ССЫЛКА Справочник.Договоры
		|			ТОГДА Остатки.Субконто2
		|		КОГДА НЕ Остатки.Субконто3 ССЫЛКА Справочник.Контрагенты
		|				И НЕ Остатки.Субконто3 ССЫЛКА Справочник.Договоры
		|			ТОГДА Остатки.Субконто3
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ДопСубконтоРасчетов,
		|	ВЫБОР
		|		КОГДА Остатки.Валюта ЕСТЬ NULL
		|				ИЛИ Остатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			ТОГДА &ВалютаРеглУчета
		|		ИНАЧЕ Остатки.Валюта
		|	КОНЕЦ КАК Валюта,
		|	Остатки.СуммаОстатокКт КАК ОстатокСумма,
		|	Остатки.ВалютнаяСуммаОстатокКт КАК ОстатокСуммаВал
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&КонецПериода,
		|			Счет В (&СчетаОстатков),
		|			,
		|			Организация = &Организация
		|				И &УсловиеПоИФО
		|				И Субконто1 В (&СписокКонтрагентов)) КАК Остатки
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагент,
		|	Договор,
		|	ИФО,
		|	КФО,
		|	СчетКод,
		|	КПС,
		|	КЭК";
		
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	
	Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
		// По счету 20 "Задолженность, невостребованная кредиторами" остатки дебетовые.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.СуммаОстатокКт", "Остатки.СуммаОстатокДт");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.ВалютнаяСуммаОстатокКт", "Остатки.ВалютнаяСуммаОстатокДт");
	ИначеЕсли ЭтоСписаниеСоСчета20700 Тогда
		// По счетам 207.00 "Расчеты по кредитам, займам (ссудам)" остатки дебетовые.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.СуммаОстатокКт", "-1 * Остатки.СуммаОстатокДт");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.ВалютнаяСуммаОстатокКт", "-1 * Остатки.ВалютнаяСуммаОстатокДт");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.КЭК", "ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)");
	Иначе // Остатки по КЭК ведутся только по счету 20 "Задолженность, невостребованная кредиторами".
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки.КЭК", "ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)");
	КонецЕсли;
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ОстаткиЗадолженности = Запрос.Выполнить().Выгрузить();
	
	Если Не ЭтоСписаниеСоСчета30300 Тогда
		РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
			ОстаткиЗадолженности.ВыгрузитьКолонку("Договор"), "ВидОбязательства,НомерДоговора,ДатаДоговора");
	КонецЕсли;
	
	Для Каждого СтрокаОстатков Из ОстаткиЗадолженности Цикл
		
		Если ИспользоватьУчетПоПодразделениям
			И СтрокаОстатков.СчетУчетПоПодразделениям
			И ЗначениеЗаполнено(Объект.Подразделение)
			И СтрокаОстатков.Подразделение <> Объект.Подразделение Тогда
			Продолжить; // Отбор остатков активен, только если заполнено Подразделение в шапке документа.
		КонецЕсли;
		
		Если ЭтоСписаниеСоСчета20700 И СтрокаОстатков.ОстатокСумма < 0 Тогда
			Продолжить; // Счет 207.00 активный, оставляем только кредиторскую задолженность.
		КонецЕсли;
		
		НоваяСтрока = Объект.Задолженность.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков,
			"Счет,ИФО,КФО,КПС,Подразделение,Валюта,
			|ОстатокСумма,ОстатокСуммаВал");
		
		Если ЭтоСписаниеСоСчета30300 Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков, "ВидНалогаИлиПлатежа,НалогСборПлатеж");
			Если ЗначениеЗаполнено(НоваяСтрока.НалогСборПлатеж) Тогда
				НоваяСтрока.Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.НалогСборПлатеж, "Контрагент");
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков, "Контрагент,Договор,ДопСубконтоРасчетов");
			Если ЗначениеЗаполнено(НоваяСтрока.Договор) Тогда
				НоваяСтрока.ОснованиеВозникновенияЗадолженности      = РеквизитыДоговоров[НоваяСтрока.Договор].ВидОбязательства;
				НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = РеквизитыДоговоров[НоваяСтрока.Договор].НомерДоговора;
				НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = РеквизитыДоговоров[НоваяСтрока.Договор].ДатаДоговора;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаОстатков.СчетЗабалансовый Тогда
			НоваяСтрока.КЭК = СтрокаОстатков.КЭК;
		Иначе
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаОстатков.Счет);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаОстатков.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		НоваяСтрока.СписатьСумма    = НоваяСтрока.ОстатокСумма;
		НоваяСтрока.СписатьСуммаВал = НоваяСтрока.ОстатокСуммаВал;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Неопределено; // Дата окончания наблюдения (срока исковой давности). Автоматически не заполняется.
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Объект.Дата; // Дата в колонке (15) равна дате формирования Решения (ф.0510437).
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = НачалоДня(Объект.Дата) - 1; // Дата в колонке (15) равна Дате Решения минус один день.
		Иначе
			НоваяСтрока.РезолюцияКомиссии = НСтр("ru = 'списать задолженность, невостребованную кредитором'");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Отказ;
	
КонецФункции

Функция ЗаполнитьНаОснованииИнвентаризацииРасчетовСКонтрагентами(Объект, ДокументОснование, ВидОперации, НомераСтрок = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",  ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КредиторскаяЗадолженность.Ссылка КАК ДокументОснование,
	|	КредиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	КредиторскаяЗадолженность.Договор КАК Договор,
	|	КредиторскаяЗадолженность.Счет КАК Счет,
	|	КредиторскаяЗадолженность.Счет.Забалансовый КАК СчетЗабалансовый,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.КЭК КАК КЭК,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.ИФО КАК ИФО,
	|	КредиторскаяЗадолженность.Всего КАК Всего,
	|	КредиторскаяЗадолженность.Подтверждено КАК Подтверждено,
	|	КредиторскаяЗадолженность.НеПодтверждено КАК НеПодтверждено,
	|	КредиторскаяЗадолженность.ИстекСрокДавности КАК ИстекСрокДавности,
	|	КредиторскаяЗадолженность.Долгосрочная КАК Долгосрочная,
	|	КредиторскаяЗадолженность.Просроченная КАК Просроченная,
	|	КредиторскаяЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
	|	КредиторскаяЗадолженность.ДатаИсполнения КАК ДатаИсполнения
	|ПОМЕСТИТЬ СтрокиИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияРасчетовСКонтрагентами.КредиторскаяЗадолженность КАК КредиторскаяЗадолженность
	|ГДЕ
	|	КредиторскаяЗадолженность.Ссылка = &Ссылка
	|	И &УсловиеПоНомерамСтрок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.ДокументОснование.Организация КАК Организация,
	|	СтрокиИнвентаризации.ДокументОснование.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.ИФО КАК ИФО
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиИнвентаризации.ДокументОснование КАК ДокументОснование,
	|	СтрокиИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент,
	|	СтрокиИнвентаризации.Договор КАК Договор,
	|	СтрокиИнвентаризации.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	СтрокиИнвентаризации.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	СтрокиИнвентаризации.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.СчетЗабалансовый КАК СчетЗабалансовый,
	|	СтрокиИнвентаризации.КПС КАК КПС,
	|	СтрокиИнвентаризации.КЭК КАК КЭК,
	|	СтрокиИнвентаризации.КФО КАК КФО,
	|	СтрокиИнвентаризации.ИФО КАК ИФО,
	|	СтрокиИнвентаризации.Всего КАК Всего,
	|	СтрокиИнвентаризации.Подтверждено КАК Подтверждено,
	|	СтрокиИнвентаризации.НеПодтверждено КАК НеПодтверждено,
	|	СтрокиИнвентаризации.ИстекСрокДавности КАК ИстекСрокДавности,
	|	СтрокиИнвентаризации.Долгосрочная КАК Долгосрочная,
	|	СтрокиИнвентаризации.Просроченная КАК Просроченная,
	|	СтрокиИнвентаризации.ДатаВозникновения КАК ДатаВозникновения,
	|	СтрокиИнвентаризации.ДатаИсполнения КАК ДатаИсполнения
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если НомераСтрок <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "КредиторскаяЗадолженность.НомерСтроки В(&НомераСтрок)");
		Запрос.УстановитьПараметр("НомераСтрок", НомераСтрок);
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("КредиторскаяЗадолженность", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Контрагенты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Задолженность", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Реквизиты шапки.
	Шапка = Результат[НомераТаблиц.Шапка].Выбрать();
	Если Шапка.Следующий() Тогда
		
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Шапка.Организация;
		Если ИспользоватьУчетПоИФО Тогда
			Объект.ИФО = Шапка.ИФО;
		КонецЕсли;
		
		Объект.СчетУчета = Шапка.Счет;
		Объект.ВидОперации = ВидОперации;
		
	КонецЕсли;
	
	// Список контрагентов.
	Контрагенты = Результат[НомераТаблиц.Контрагенты].Выбрать();
	Пока Контрагенты.Следующий() Цикл
		НоваяСтрока = Объект.СписокКонтрагентов.Добавить();
		НоваяСтрока.Контрагент = Контрагенты.Контрагент;
		НоваяСтрока.ИдентификаторПлательщика = БухгалтерскийУчет.ИдентификаторКонтрагента(НоваяСтрока.Контрагент, Объект.ВидДокументаФизЛиц);
	КонецЦикла;
	
	// Задолженность.
	Задолженность = Результат[НомераТаблиц.Задолженность].Выбрать();
	Пока Задолженность.Следующий() Цикл
		
		НоваяСтрока = Объект.Задолженность.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Задолженность, "Контрагент,Договор,Счет,ИФО,КФО,КПС");
		
		НоваяСтрока.ОснованиеВозникновенияЗадолженности      = Задолженность.ДоговорВидОбязательства;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = Задолженность.ДоговорНомерДоговора;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = Задолженность.ДоговорДатаДоговора;
		
		Если Задолженность.СчетЗабалансовый Тогда
			НоваяСтрока.КЭК = Задолженность.КЭК;
		Иначе
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Задолженность.Счет);
		КонецЕсли;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			
			НоваяСтрока.ОстатокСумма = Задолженность.Всего;
			НоваяСтрока.СписатьСумма = Задолженность.Всего;
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Неопределено; // Дата окончания наблюдения (срока исковой давности). Автоматически не заполняется.
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			
			НоваяСтрока.ОстатокСумма = Задолженность.Всего;
			НоваяСтрока.СписатьСумма = Задолженность.ИстекСрокДавности;
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Объект.Дата; // Дата в колонке (15) равна дате формирования Решения (ф.0510437).
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			
			НоваяСтрока.ОстатокСумма = Задолженность.Всего;
			НоваяСтрока.СписатьСумма = Задолженность.Всего;
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = НачалоДня(Объект.Дата) - 1; // Дата в колонке (15) равна Дате Решения минус один день.
			
		КонецЕсли;
		
		НоваяСтрока.Валюта = ВалютаРегламентированногоУчета; // Инвентаризация расчетов производится в рублях.
		НоваяСтрока.ОстатокСуммаВал = НоваяСтрока.ОстатокСумма;
		НоваяСтрока.СписатьСуммаВал = НоваяСтрока.СписатьСумма;
		
	КонецЦикла;
	
КонецФункции

Процедура ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовПоПоступлениям(Объект, ДокументОснование, ДанныеЗаполнения) Экспорт

	Если ДанныеЗаполнения.Свойство("ВидОперации") Тогда
		ВидОперации = ДанныеЗаполнения.ВидОперации;
	Иначе
		Возврат;
	КонецЕсли;
	
	НомераСтрокИнвентаризации = Неопределено;
	Если ДанныеЗаполнения.Свойство("НомераСтрокИнвентаризации") Тогда
		НомераСтрокИнвентаризации = ДанныеЗаполнения.НомераСтрокИнвентаризации;
	КонецЕсли;
	
	ВидСуммы = "";
	Если ДанныеЗаполнения.Свойство("ВидСуммы") Тогда
		ВидСуммы = ДанныеЗаполнения.ВидСуммы;
	КонецЕсли;
	
	СчетУчета = "";
	Если ДанныеЗаполнения.Свойство("СчетУчета") Тогда
		СчетУчета = ДанныеЗаполнения.СчетУчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",  ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КредиторскаяЗадолженность.Ссылка КАК ДокументОснование,
	|	КредиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	КредиторскаяЗадолженность.Договор КАК Договор,
	|	КредиторскаяЗадолженность.Счет КАК Счет,
	|	КредиторскаяЗадолженность.Счет.Забалансовый КАК СчетЗабалансовый,
	|	КредиторскаяЗадолженность.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	КредиторскаяЗадолженность.Подразделение КАК Подразделение,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.КЭК КАК КЭК,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.ИФО КАК ИФО,
	|	КредиторскаяЗадолженность.Валюта КАК Валюта,
	|	КредиторскаяЗадолженность.СуммаВал КАК СуммаВал,
	|	КредиторскаяЗадолженность.СуммаРуб КАК СуммаРуб,
	|	КредиторскаяЗадолженность.СуммаРубСИстекшимСрокомДавности КАК СуммаРубСИстекшимСрокомДавности,
	|	КредиторскаяЗадолженность.СуммаВалСИстекшимСрокомДавности КАК СуммаВалСИстекшимСрокомДавности,
	|	КредиторскаяЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
	|	КредиторскаяЗадолженность.ДатаИсполнения КАК ДатаИсполнения
	|ПОМЕСТИТЬ СтрокиИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовПоПоступлениям.Раздел22 КАК КредиторскаяЗадолженность
	|ГДЕ
	|	КредиторскаяЗадолженность.Ссылка = &Ссылка
	|	И &УсловиеПоНомерамСтрок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.ДокументОснование.Организация КАК Организация,
	|	СтрокиИнвентаризации.ДокументОснование.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.ИФО КАК ИФО
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиИнвентаризации.ДокументОснование КАК ДокументОснование,
	|	СтрокиИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент,
	|	СтрокиИнвентаризации.Договор КАК Договор,
	|	СтрокиИнвентаризации.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	СтрокиИнвентаризации.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	СтрокиИнвентаризации.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.СчетЗабалансовый КАК СчетЗабалансовый,
	|	СтрокиИнвентаризации.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	СтрокиИнвентаризации.Подразделение КАК Подразделение,
	|	СтрокиИнвентаризации.КПС КАК КПС,
	|	СтрокиИнвентаризации.КЭК КАК КЭК,
	|	СтрокиИнвентаризации.КФО КАК КФО,
	|	СтрокиИнвентаризации.ИФО КАК ИФО,
	|	СтрокиИнвентаризации.Валюта КАК Валюта,
	|	СтрокиИнвентаризации.СуммаВал КАК СуммаВал,
	|	СтрокиИнвентаризации.СуммаРуб КАК СуммаРуб,
	|	СтрокиИнвентаризации.СуммаВалСИстекшимСрокомДавности КАК СуммаВалСИстекшимСрокомДавности,
	|	СтрокиИнвентаризации.СуммаРубСИстекшимСрокомДавности КАК СуммаРубСИстекшимСрокомДавности,
	|	СтрокиИнвентаризации.ДатаВозникновения КАК ДатаВозникновения,
	|	СтрокиИнвентаризации.ДатаИсполнения КАК ДатаИсполнения
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если НомераСтрокИнвентаризации <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "КредиторскаяЗадолженность.НомерСтроки В(&НомераСтрокИнвентаризации)");
		Запрос.УстановитьПараметр("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "ИСТИНА");
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("КредиторскаяЗадолженность", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Контрагенты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Задолженность", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	// Реквизиты шапки.
	Шапка = Результат[НомераТаблиц.Шапка].Выбрать();
	Если Шапка.Следующий() Тогда
		
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Шапка.Организация;
		Объект.ВидОперации = ВидОперации;
		Если ИспользоватьУчетПоИФО Тогда
			Объект.ИФО = Шапка.ИФО;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетУчета) Тогда
			Объект.СчетУчета = БухгалтерскийУчет.СчетПоКоду(СчетУчета, Объект.Дата, Объект.Организация);
		Иначе
			Объект.СчетУчета = Шапка.Счет;
		КонецЕсли;
		
	КонецЕсли;
	
	// Список контрагентов.
	Контрагенты = Результат[НомераТаблиц.Контрагенты].Выбрать();
	Пока Контрагенты.Следующий() Цикл
		НоваяСтрока = Объект.СписокКонтрагентов.Добавить();
		НоваяСтрока.Контрагент = Контрагенты.Контрагент;
		НоваяСтрока.ИдентификаторПлательщика = БухгалтерскийУчет.ИдентификаторКонтрагента(НоваяСтрока.Контрагент, Объект.ВидДокументаФизЛиц);
	КонецЦикла;
	
	// Задолженность.
	Задолженность = Результат[НомераТаблиц.Задолженность].Выбрать();
	Пока Задолженность.Следующий() Цикл
		
		НоваяСтрока = Объект.Задолженность.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Задолженность, "Контрагент,Договор,Счет,ИФО,КФО,КПС");
		
		НоваяСтрока.ОснованиеВозникновенияЗадолженности      = Задолженность.ДоговорВидОбязательства;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = Задолженность.ДоговорНомерДоговора;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = Задолженность.ДоговорДатаДоговора;
		
		Если Задолженность.УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Задолженность.Подразделение;
		КонецЕсли;
		
		Если Задолженность.СчетЗабалансовый Тогда
			НоваяСтрока.КЭК = Задолженность.КЭК;
		Иначе
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Задолженность.Счет);
		КонецЕсли;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Неопределено; // Дата окончания наблюдения (срока исковой давности). Автоматически не заполняется.
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Объект.Дата; // Дата в колонке (15) равна дате формирования Решения (ф.0510437).
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = НачалоДня(Объект.Дата) - 1; // Дата в колонке (15) равна Дате Решения минус один день.
			
		КонецЕсли;
		
		НоваяСтрока.Валюта          = Задолженность.Валюта;
		НоваяСтрока.ОстатокСумма    = Задолженность.СуммаРуб;
		НоваяСтрока.ОстатокСуммаВал = Задолженность.СуммаВал;
		
		НоваяСтрока.СписатьСумма    = Задолженность["СуммаРуб" + ВидСуммы];
		НоваяСтрока.СписатьСуммаВал = Задолженность["СуммаВал" + ВидСуммы];
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовСКонтрагентами(Объект, ДокументОснование, ДанныеЗаполнения) Экспорт

	Если ДанныеЗаполнения.Свойство("ВидОперации") Тогда
		ВидОперации = ДанныеЗаполнения.ВидОперации;
	Иначе
		Возврат;
	КонецЕсли;
	
	НомераСтрокИнвентаризации = Неопределено;
	Если ДанныеЗаполнения.Свойство("НомераСтрокИнвентаризации") Тогда
		НомераСтрокИнвентаризации = ДанныеЗаполнения.НомераСтрокИнвентаризации;
	КонецЕсли;
	
	СчетУчета = "";
	Если ДанныеЗаполнения.Свойство("СчетУчета") Тогда
		СчетУчета = ДанныеЗаполнения.СчетУчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",  ДокументОснование);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КредиторскаяЗадолженность.Ссылка КАК ДокументОснование,
	|	КредиторскаяЗадолженность.НомерСтроки КАК НомерСтроки,
	|	КредиторскаяЗадолженность.Контрагент КАК Контрагент,
	|	КредиторскаяЗадолженность.Договор КАК Договор,
	|	КредиторскаяЗадолженность.ВидНалогаИПлатежа КАК ВидНалогаИПлатежа,
	|	КредиторскаяЗадолженность.НалогИПлатежОрганизации КАК НалогИПлатежОрганизации,
	|	КредиторскаяЗадолженность.Счет КАК Счет,
	|	КредиторскаяЗадолженность.Счет.Забалансовый КАК СчетЗабалансовый,
	|	КредиторскаяЗадолженность.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	КредиторскаяЗадолженность.Подразделение КАК Подразделение,
	|	КредиторскаяЗадолженность.КПС КАК КПС,
	|	КредиторскаяЗадолженность.КЭК КАК КЭК,
	|	КредиторскаяЗадолженность.КФО КАК КФО,
	|	КредиторскаяЗадолженность.ИФО КАК ИФО,
	|	КредиторскаяЗадолженность.Валюта КАК Валюта,
	|	КредиторскаяЗадолженность.СуммаВал КАК СуммаВал,
	|	КредиторскаяЗадолженность.СуммаРуб КАК СуммаРуб,
	|	КредиторскаяЗадолженность.ДатаВозникновения КАК ДатаВозникновения,
	|	КредиторскаяЗадолженность.ДатаИсполнения КАК ДатаИсполнения
	|ПОМЕСТИТЬ СтрокиИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризационнаяОписьРасчетовСКонтрагентами.Раздел22 КАК КредиторскаяЗадолженность
	|ГДЕ
	|	КредиторскаяЗадолженность.Ссылка = &Ссылка
	|	И &УсловиеПоНомерамСтрок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.ДокументОснование.Организация КАК Организация,
	|	СтрокиИнвентаризации.ДокументОснование.ДатаИнвентаризации КАК ДатаИнвентаризации,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.ИФО КАК ИФО
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтрокиИнвентаризации.ДокументОснование КАК ДокументОснование,
	|	СтрокиИнвентаризации.НомерСтроки КАК НомерСтроки,
	|	СтрокиИнвентаризации.Контрагент КАК Контрагент,
	|	СтрокиИнвентаризации.Договор КАК Договор,
	|	СтрокиИнвентаризации.Договор.ВидОбязательства КАК ДоговорВидОбязательства,
	|	СтрокиИнвентаризации.Договор.НомерДоговора КАК ДоговорНомерДоговора,
	|	СтрокиИнвентаризации.Договор.ДатаДоговора КАК ДоговорДатаДоговора,
	|	СтрокиИнвентаризации.ВидНалогаИПлатежа КАК ВидНалогаИлиПлатежа,
	|	СтрокиИнвентаризации.НалогИПлатежОрганизации КАК НалогСборПлатеж,
	|	СтрокиИнвентаризации.НалогИПлатежОрганизации.Контрагент КАК Контрагент30300,
	|	СтрокиИнвентаризации.Счет КАК Счет,
	|	СтрокиИнвентаризации.СчетЗабалансовый КАК СчетЗабалансовый,
	|	СтрокиИнвентаризации.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	СтрокиИнвентаризации.Подразделение КАК Подразделение,
	|	СтрокиИнвентаризации.КПС КАК КПС,
	|	СтрокиИнвентаризации.КЭК КАК КЭК,
	|	СтрокиИнвентаризации.КФО КАК КФО,
	|	СтрокиИнвентаризации.ИФО КАК ИФО,
	|	СтрокиИнвентаризации.Валюта КАК Валюта,
	|	СтрокиИнвентаризации.СуммаВал КАК СуммаВал,
	|	СтрокиИнвентаризации.СуммаРуб КАК СуммаРуб,
	|	СтрокиИнвентаризации.ДатаВозникновения КАК ДатаВозникновения,
	|	СтрокиИнвентаризации.ДатаИсполнения КАК ДатаИсполнения
	|ИЗ
	|	СтрокиИнвентаризации КАК СтрокиИнвентаризации
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если НомераСтрокИнвентаризации <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "КредиторскаяЗадолженность.НомерСтроки В(&НомераСтрокИнвентаризации)");
		Запрос.УстановитьПараметр("НомераСтрокИнвентаризации", НомераСтрокИнвентаризации);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоНомерамСтрок", "ИСТИНА");
	КонецЕсли;
	
	НомераТаблиц = Новый Структура;
	НомераТаблиц.Вставить("КредиторскаяЗадолженность", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Шапка", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Контрагенты", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("Задолженность", НомераТаблиц.Количество());
	
	Результат = Запрос.ВыполнитьПакет();
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	// Реквизиты шапки.
	Шапка = Результат[НомераТаблиц.Шапка].Выбрать();
	Если Шапка.Следующий() Тогда
		
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Шапка.Организация;
		Объект.ВидОперации = ВидОперации;
		Если ИспользоватьУчетПоИФО Тогда
			Объект.ИФО = Шапка.ИФО;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетУчета) Тогда
			Объект.СчетУчета = БухгалтерскийУчет.СчетПоКоду(СчетУчета, Объект.Дата, Объект.Организация);
		Иначе
			Объект.СчетУчета = Шапка.Счет;
		КонецЕсли;
		
	КонецЕсли;
	
	// Список контрагентов.
	Контрагенты = Результат[НомераТаблиц.Контрагенты].Выбрать();
	Пока Контрагенты.Следующий() Цикл
		НоваяСтрока = Объект.СписокКонтрагентов.Добавить();
		НоваяСтрока.Контрагент = Контрагенты.Контрагент;
		НоваяСтрока.ИдентификаторПлательщика = БухгалтерскийУчет.ИдентификаторКонтрагента(НоваяСтрока.Контрагент, Объект.ВидДокументаФизЛиц);
	КонецЦикла;
	
	// Задолженность.
	ЭтоСписаниеСоСчета30300 = БухгалтерскийУчет.СчетВИерархии(Объект.СчетУчета, "303.00");
	Задолженность = Результат[НомераТаблиц.Задолженность].Выбрать();
	Пока Задолженность.Следующий() Цикл
		
		НоваяСтрока = Объект.Задолженность.Добавить();
		НоваяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор); // Новый GUID для каждой строки задолженности.
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Задолженность, "Контрагент,Договор,ВидНалогаИлиПлатежа,НалогСборПлатеж,Счет,ИФО,КФО,КПС");
		Если ЭтоСписаниеСоСчета30300 Тогда
			НоваяСтрока.Контрагент = Задолженность.Контрагент30300;
		КонецЕсли;
		
		НоваяСтрока.ОснованиеВозникновенияЗадолженности      = Задолженность.ДоговорВидОбязательства;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиНомер = Задолженность.ДоговорНомерДоговора;
		НоваяСтрока.ОснованиеВозникновенияЗадолженностиДата  = Задолженность.ДоговорДатаДоговора;
		
		Если Задолженность.УчетПоПодразделениям Тогда
			НоваяСтрока.Подразделение = Задолженность.Подразделение;
		КонецЕсли;
		
		Если Задолженность.СчетЗабалансовый Тогда
			НоваяСтрока.КЭК = Задолженность.КЭК;
		Иначе
			НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Задолженность.Счет);
		КонецЕсли;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьСПоследующимНаблюдением Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Неопределено; // Дата окончания наблюдения (срока исковой давности). Автоматически не заполняется.
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.ПрекратитьНаблюдениеЗадолженности Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = Объект.Дата; // Дата в колонке (15) равна дате формирования Решения (ф.0510437).
			
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияКредиторскойЗадолженности.СписатьБезПоследующегоНаблюдения Тогда
			
			НоваяСтрока.РезолюцияКомиссии = Строка(Объект.ВидОперации);
			НоваяСтрока.СрокНаблюдения = НачалоДня(Объект.Дата) - 1; // Дата в колонке (15) равна Дате Решения минус один день.
			
		КонецЕсли;
		
		НоваяСтрока.Валюта          = Задолженность.Валюта;
		НоваяСтрока.ОстатокСумма    = Задолженность.СуммаРуб;
		НоваяСтрока.ОстатокСуммаВал = Задолженность.СуммаВал;
		
		НоваяСтрока.СписатьСумма    = Задолженность.СуммаРуб;
		НоваяСтрока.СписатьСуммаВал = Задолженность.СуммаВал;
		
	КонецЦикла;
	
КонецПроцедуры

