#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		
		ДанныеЗаполнения.Свойство("ДокументОснование", ДокументОснование);
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризацияРасчетовСКонтрагентами") Тогда 
				Документы.СписаниеКредиторскойЗадолженности.ЗаполнитьНаОснованииИнвентаризацииРасчетовСКонтрагентами(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения.ВидОперации, ДанныеЗаполнения.НомераСтрокИнвентаризации);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
				Документы.СписаниеКредиторскойЗадолженности.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовПоПоступлениям(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения);
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
				Документы.СписаниеКредиторскойЗадолженности.ЗаполнитьНаОснованииИнвентаризационнойОписиРасчетовСКонтрагентами(ЭтотОбъект,
					ДокументОснование, ДанныеЗаполнения);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеЗаполнения = Неопределено Или ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ОбщегоНазначенияБГУ.ЗаполнитьРеквизитыЛокальногоАкта(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(ДокументОснование)
		И Дата < ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Дата") Тогда
		ТекстСообщения = СтрШаблон("Дата документа установлена ранее даты документа-основания: %1
			|Это корректно только в случае отражения отклонений при инвентаризации согласно положениям Стандарта ""События после отчетной даты"".", ДокументОснование);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, "Дата", "Объект");
	КонецЕсли;
	
	Документы.СписаниеВосстановлениеЗадолженностиПоДоходам.ПроверитьСоответствиеИнвентаризационнойОписиРасчетов(Ссылка, ДокументОснование);
	
	РеквизитыСчетаУчетаЗадолженности = Новый Структура("Счет, КПС, Подразделение",
		"Счет", "КПС", "Подразделение");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаУчетаЗадолженности,
		ЭтотОбъект, "Задолженность", Отказ);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Для Каждого СтрокаЗадолженность Из Задолженность Цикл
			СтрокаЗадолженность.ИФО = ЭтотОбъект.ИФО;
		КонецЦикла;
	КонецЕсли;
	
	ЭтоСписаниеСоСчета30300 = БухгалтерскийУчет.СчетВИерархии(СчетУчета, "303.00");
	Если ЭтоСписаниеСоСчета30300 Тогда
		// Заполняем таблицу СписокКонтрагентов автоматически по данным таблицы Задолженность.
		Контрагенты = Задолженность.Выгрузить(, "Контрагент");
		Контрагенты.Свернуть("Контрагент");
		СписокКонтрагентов.Загрузить(Контрагенты);
		Для Каждого СтрокаКонтрагент Из СписокКонтрагентов Цикл
			СтрокаКонтрагент.ИдентификаторПлательщика = БухгалтерскийУчет.ИдентификаторКонтрагента(СтрокаКонтрагент.Контрагент, ВидДокументаФизЛиц);
		КонецЦикла;
	КонецЕсли;
	
	СуммаДокумента = Задолженность.Итог("СписатьСумма");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
