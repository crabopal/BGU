&НаКлиенте
Функция ЕстьТаблицыТребующиеОчистки(ПараметрыОчистки)
	Для Каждого ЗаданныйПараметр Из ПараметрыОчистки Цикл
		Если ЗаданныйПараметр.Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаКлиенте
Функция ТаблицыТребующиеОчистки()
	ПараметрыОчистки = ПараметрыОчисткиТЧ();
	Если Объект.ПередаваемыеПроводки.Количество() > 0
		И НЕ ЦентрализованноеСнабжениеКлиентСервер.ПередаваемыеПроводкиСоответствуютВидуИзвещения(ЭтотОбъект) Тогда
		ПараметрыОчистки.ОчиститьПередаваемыеПроводки = Истина;
	КонецЕсли;
	Если НЕ ВидимостьЗакладокНФА(Объект) Тогда
		Если Объект.ОсновныеСредства.Количество() > 0 Тогда
			ПараметрыОчистки.ОчиститьОсновныеСредства = Истина;
		КонецЕсли;
		Если Объект.Материалы.Количество() > 0 Тогда
			ПараметрыОчистки.ОчиститьМатериалы = Истина;
		КонецЕсли;
		Если Объект.ВозвратнаяТара.Количество() > 0 Тогда
			ПараметрыОчистки.ОчиститьВозвратнуюТару = Истина;
		КонецЕсли;
	Иначе
		ТребуетсяПроверитьСчета = Объект.ОсновныеСредства.Количество() > 0
			Или Объект.Материалы.Количество() > 0
			Или Объект.ВозвратнаяТара.Количество() > 0;
		Если ТребуетсяПроверитьСчета И НЕ СчетаСоответствуютВидуОперации(Объект.ВидИзвещения) Тогда
			ПараметрыОчистки.УстановитьСчетаУчетаНФА = Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат ПараметрыОчистки;
КонецФункции

// Параметры очистки ТЧ.
// 
// Возвращаемое значение:
//  Структура - Параметры очистки ТЧ:
// * ОчиститьПередаваемыеПроводки - Булево -
// * ОчиститьОсновныеСредства - Булево -
// * ОчиститьМатериалы - Булево -
// * ОчиститьВозвратнуюТару - Булево -
// * УстановитьСчетаУчетаНФА - Булево -
&НаКлиенте
Функция ПараметрыОчисткиТЧ()
	Результат = Новый Структура;
	Результат.Вставить("ОчиститьПередаваемыеПроводки", Ложь);
	Результат.Вставить("ОчиститьОсновныеСредства",     Ложь);
	Результат.Вставить("ОчиститьМатериалы",            Ложь);
	Результат.Вставить("ОчиститьВозвратнуюТару",       Ложь);
	Результат.Вставить("УстановитьСчетаУчетаНФА",      Ложь);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВидИзвещенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ВидИзвещенияДоИзменения = Объект.ВидИзвещения;
		
КонецПроцедуры

// Вид извещения обработка выбора завершение.
// 
// Параметры:
//  Ответ - КодВозвратаДиалога -
//  ДопПараметры - Структура: см. ПараметрыОчисткиТЧ
&НаКлиенте
Процедура ВидИзвещенияОбработкаВыбораЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Если ДопПараметры.ОчиститьПередаваемыеПроводки Тогда
			Объект.ПередаваемыеПроводки.Очистить();
		КонецЕсли;
		Если ДопПараметры.ОчиститьОсновныеСредства Тогда
			Объект.ОсновныеСредства.Очистить();
		КонецЕсли;
		Если ДопПараметры.ОчиститьМатериалы Тогда
			Объект.Материалы.Очистить();
		КонецЕсли;
		Если ДопПараметры.ОчиститьВозвратнуюТару Тогда
			Объект.ВозвратнаяТара.Очистить();
		КонецЕсли;

		ВидИзвещенияПриИзмененииНаКлиенте();
//		УправлениеВидимостьюЭлементов(ЭтотОбъект);
//		ОбновитьСчетаУчета();
//		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
		
	Иначе
		Объект.ВидИзвещения = ВидИзвещенияДоИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА") Тогда
		СтандартнаяОбработка = Ложь;
		ПараметрыПодбора = ПараметрыПодбораДокументаОснования();
		ОткрытьФорму("Документ.ПоступлениеНФАпоЦС.ФормаВыбора", ПараметрыПодбора, Элемент);
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА") Тогда
		ПараметрыПодбора = Новый Структура;
		ПараметрыПодбора.Вставить("Отбор", Новый Структура);
		ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
		ОткрытьФорму("Документ.ИзвещениеИсходящее.ФормаВыбора", ПараметрыПодбора, Элемент);
	КонецЕсли;
КонецПроцедуры

