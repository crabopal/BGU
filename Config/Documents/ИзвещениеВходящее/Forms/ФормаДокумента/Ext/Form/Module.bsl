&НаКлиенте
Процедура ПередаваемыеПроводкиКФОПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОбработатьВыборКФО(Объект.Организация,
											   Объект.ИФО,
											   ТекущиеДанные.КФО,
											   Объект.Дата,
											   ТекущиеДанные.КПСДт,
											   ТекущиеДанные.КПСКт);
КонецПроцедуры

&НаКлиенте
Процедура ПередаваемыеПроводкиКПСДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;

	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(	Элемент, 
													СтандартнаяОбработка, 
													ТекущиеДанные.КПСДт, 
													Объект.Организация,
													Объект.ИФО,
													ТекущиеДанные.КФО,
													ТекущиеДанные.СчетДт,
													Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ПередаваемыеПроводкиСчетДтПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ПередаваемыеПроводки.ТекущиеДанные;
	ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, ТекущиеДанные, "Дт");

	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ПараметрыПодстановки.ДтКт = "Дт";
	ПараметрыПодстановки.Объект = Объект;
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоВходящееИзвещение(ПараметрыПодстановки, Объект);
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
