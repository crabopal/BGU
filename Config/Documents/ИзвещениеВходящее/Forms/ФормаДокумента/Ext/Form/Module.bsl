	Если Поле.Имя = "ФайлыПриложенийИмяФайла" Тогда
		ПриВыбореФайлаПриложения(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоДокументуОснованию(Команда)
	
	Если Объект.ОсновныеСредства.Количество() > 0
		Или Объект.Материалы.Количество() > 0
		Или Объект.ВозвратнаяТара.Количество() Тогда
			
		ТекстВопроса = НСтр("ru = 'Документ будет заполнен по выбранным документам-основаниям.
			|Продолжить?'");
		ОповещениеПриОтвете = Новый ОписаниеОповещения("ПриОтветеЗаполнитьДокумент", ЭтотОбъект);
		ПоказатьВопрос(ОповещениеПриОтвете, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
			
	КонецЕсли;
	
	ЗаполнитьНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьДокументыОснования(Команда)
	ПараметрыПодбора = ПараметрыПодбораДокументаОснования();
	ПараметрыПодбора.Вставить("МножественныйВыбор", Истина);
	ПараметрыПодбора.Вставить("ЗакрыватьПриВыборе", Ложь);
	ДополнительныеПараметрыПодбора = Новый Структура;
	ДополнительныеПараметрыПодбора.Вставить("КоличествоДокументов", Объект.ДокументыОснования.Количество());
	ОповещениеОбОкончанииПодбора = Новый ОписаниеОповещения("ПослеПодбораДокументовОснований", ЭтотОбъект, ДополнительныеПараметрыПодбора);
	ОткрытьФорму("Документ.ПоступлениеНФАпоЦС.Форма.ФормаВыбора", ПараметрыПодбора, Элементы.ДокументыОснования,
		УникальныйИдентификатор,,,ОповещениеОбОкончанииПодбора);
КонецПроцедуры

