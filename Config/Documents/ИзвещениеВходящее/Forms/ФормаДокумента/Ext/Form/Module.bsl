&НаСервере
Процедура ПоказатьРеквизитыЭДО()
	
	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Отправитель, Объект.Организация);
	ВидимостьОтправленногоИзвещения = Ложь;
	
	ЗаполнитьСведенияЭД();
	
	ЕстьДанныеЭДО = ?(ТаблицаПроводокЭД.Количество() > 0, Истина, Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСведенияЭД", "Видимость", ВидимостьЭлементовЭДО И ЕстьДанныеЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНоменклатураЭД", "Видимость", ВидимостьЭлементовЭДО И ТаблицаНоменклатурыЭД.Количество()>0);
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
			ОтправленноеИзвещение = Объект.ДокументОснование;
			ВидимостьОтправленногоИзвещения = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОтправленноеИзвещение", "Видимость", ВидимостьЭлементовЭДО И ВидимостьОтправленногоИзвещения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТаблицаПроводокЭДпНомерПроводки", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьОтправленногоИзвещения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТаблицаПроводокЭДРекомендуемоеОтражениеВУчете", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьОтправленногоИзвещения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаФайлыПриложений", "Видимость", ВидимостьЭлементовЭДО И НЕ ВидимостьОтправленногоИзвещения);

	Если Объект.ФайлыПриложений.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаФайлыПриложений", "Видимость", Ложь);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияЭД()

	ДанныеЭДИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Объект.Ссылка);
	
	Если ЗначениеЗаполнено(ДанныеЭДИзвещения) Тогда
		ТаблицаНоменклатурыЭД.Загрузить(ДанныеЭДИзвещения.ТаблицаНоменклатуры);
	
		Для каждого ТекСтрока Из ДанныеЭДИзвещения.ТаблицаПроводок Цикл
			НоваяСтрока = ТаблицаПроводокЭД.Добавить();
			НоваяСтрока.пСодержание = ТекСтрока.пСодержание;
			Если ЗначениеЗаполнено(ТекСтрока.пСуммаОтправитель) Тогда
				НоваяСтрока.пСумма = ТекСтрока.пСуммаОтправитель;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекСтрока.пДебетСчетОтправитель) Тогда
				НоваяСтрока.пДебетСчет = ТекСтрока.пДебетСчетОтправитель;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекСтрока.пКредитСчетОтправитель) Тогда
				НоваяСтрока.пКредитСчет = ТекСтрока.пКредитСчетОтправитель;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекСтрока.пСуммаПолучатель) Тогда
				НоваяСтрока.пСумма = ТекСтрока.пСуммаПолучатель;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекСтрока.пДебетСчетПолучатель) Тогда
				НоваяСтрока.пДебетСчет = ТекСтрока.пДебетСчетПолучатель;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекСтрока.пКредитСчетПолучатель) Тогда
				НоваяСтрока.пКредитСчет = ТекСтрока.пКредитСчетПолучатель;
			КонецЕсли;
			НоваяСтрока.пНомерПроводки = ТекСтрока.пНомерПроводки;
		КонецЦикла;
		
		Если Объект.РекомендуемыеПроводки.Количество() > 0 Тогда
			Для Каждого ТекСтрока Из ТаблицаПроводокЭД Цикл
				ТекСтрока.РекомендуемоеОтражениеВУчете = РекомендуемоеОтражениеВУчете(ТекСтрока.пНомерПроводки);
			КонецЦикла;
		КонецЕсли;
		
		ТаблицаОборотов = ТаблицаПроводокЭД.Выгрузить();
		ТаблицаОборотов.Свернуть("пДебетСчет, пКредитСчет", "пСумма");
		
		ТаблицаОборотовПроводокЭД.Загрузить(ТаблицаОборотов);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция РекомендуемоеОтражениеВУчете(НомерПроводки)
	Результат = "";
	
	ПараметрыПоиска = Новый Структура("НомераПроводокОтправителя", Строка(НомерПроводки));
	СтрокиРекомендуемыхПроводок = Объект.РекомендуемыеПроводки.НайтиСтроки(ПараметрыПоиска);
	
	НомерПоПорядку = 0;
	Для Каждого ТекСтрока Из СтрокиРекомендуемыхПроводок Цикл
		НомерПоПорядку = НомерПоПорядку + 1;
		
		ПредставлениеСчетаДт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
			ТекСтрока.КПСДт, ТекСтрока.КФО, ТекСтрока.СчетДт, ТекСтрока.КЭКДт);
		
		ПредставлениеСчетаКт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
			ТекСтрока.КПСКт, ТекСтрока.КФО, ТекСтрока.СчетКт, ТекСтрока.КЭККт);
			
		Проводка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Дт %1 - Кт %2'"),
				ПредставлениеСчетаДт, ПредставлениеСчетаКт);			
			
		Если НомерПоПорядку = 1 Тогда
			Результат = Проводка;
		Иначе
			Результат = Результат + Символы.ПС + Проводка;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПроверкаЭлектронныхИзвещений()
	ВидимостьРезультатовКонтроляЭлектронныхИзвещений = Ложь;
	СуммаИсходящегоИзвещения = 0;
	СуммаВходящегоИзвещения = 0;
	ЕстьИсходящийЭД = Ложь;
	ЕстьВходящийЭД = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
			ДанныеИсходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Объект.ДокументОснование);
			Если ЗначениеЗаполнено(ДанныеИсходящегоИзвещения) Тогда
				Если ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 19
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 23) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 25) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 27) 
				ИЛИ (ДанныеИсходящегоИзвещения.ДанныеЗаголовка.ТипИзвещения = 29) Тогда
					СуммаИсходящегоИзвещения = ДанныеИсходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаПолучатель");
				Иначе	
					СуммаИсходящегоИзвещения = ДанныеИсходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаОтправитель");
				КонецЕсли;
				ЕстьИсходящийЭД = Истина;
			КонецЕсли;
			
			ДанныеВходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Объект.Ссылка);
			Если ЗначениеЗаполнено(ДанныеВходящегоИзвещения) Тогда
				СуммаВходящегоИзвещения = ДанныеВходящегоИзвещения.ТаблицаПроводок.Итог("пСуммаОтправитель");
				ЕстьВходящийЭД = Истина;
			КонецЕсли;
			
			Если ЕстьИсходящийЭД И ЕстьВходящийЭД Тогда
				Если СуммаИсходящегоИзвещения<>СуммаВходящегоИзвещения Тогда
					ВидимостьРезультатовКонтроляЭлектронныхИзвещений = Истина;
					РезультатыКонтроляЭлектронныхИзвещений = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Внимание! Исходящее извещение на сумму: %1, полученные проводки ответного извещения на сумму: %2!'"),
						?(СуммаИсходящегоИзвещения = 0, НСтр("ru='0.00'"), Формат(СуммаИсходящегоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '")), ?(СуммаВходящегоИзвещения = 0, НСтр("ru='0.00'"), Формат(СуммаВходящегоИзвещения, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '")));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РезультатыКонтроляЭлектронныхИзвещений", "Видимость", ВидимостьРезультатовКонтроляЭлектронныхИзвещений);
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьОтправленноеИзвещение(ДокументОтправленногоИзвещения, Форма, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ДокументОтправленногоИзвещения) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОтправленногоИзвещения = Новый Структура("Ключ", ДокументОтправленногоИзвещения);
	
	ОткрытьФорму("Документ.ИзвещениеИсходящее.ФормаОбъекта", ПараметрыОтправленногоИзвещения, Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЭлектронныйДокументИзФайла(ВыбранноеЗначение)
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		ДанныеСтроки = ФайлыПриложенийКИзвещению.НайтиПоИдентификатору(ВыбранноеЗначение);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеСтроки.СодержимоеФайла) Тогда
			Если ЗначениеЗаполнено(ДанныеСтроки.ВременныйФайлПриложения) Тогда
				ИмяВременногоФайла = ДанныеСтроки.ВременныйФайлПриложения;
			Иначе
	            ИмяВременногоФайла = ВременныйФайлПриложенияНаКлиенте(ДанныеСтроки);
			КонецЕсли;	
			Если ЗначениеЗаполнено(ИмяВременногоФайла) Тогда
				ДанныеСтроки.ВременныйФайлПриложения = ИмяВременногоФайла;
			    ФайловаяСистемаКлиент.ОткрытьФайл(ИмяВременногоФайла);
			КонецЕсли;
		КонецЕсли;	
	Иначе	
		ДанныеСтроки = Объект.ФайлыПриложений.НайтиПоИдентификатору(ВыбранноеЗначение);
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДанныеСтроки.ПрисоединенныйФайл) Тогда
			ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
				ДанныеСтроки.ПрисоединенныйФайл, Неопределено, УникальныйИдентификатор);
			
			РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеФайловПриОграниченияхДоступаПоОрганизациям()
	УстановитьПривилегированныйРежим(Истина);
	ИспользуетсяОграничениеДоступаНаУровнеЗаписей = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
	ФайлыПриложенийКИзвещению.Очистить();
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		СведенияЭДИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияСФайламиПоДокументу(Объект.Ссылка);
		Если ЗначениеЗаполнено(СведенияЭДИзвещения) Тогда
			Если СведенияЭДИзвещения.ФайлыПриложений.Количество() > 0 Тогда
				Для Каждого ТекФайл Из СведенияЭДИзвещения.ФайлыПриложений Цикл
					НоваяСтрока = ФайлыПриложенийКИзвещению.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекФайл);
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореФайлаПриложения(ВыбраннаяСтрока)
	МожноОткрытьФайл = Истина;
	
	#Если ВебКлиент Тогда
	МожноОткрытьФайл = Ложь;
	#КонецЕсли
		
	Если МожноОткрытьФайл Тогда
		ОткрытьЭлектронныйДокументИзФайла(ВыбраннаяСтрока);
	Иначе
		ФайлВыгрузки = ФайлПриложения(ВыбраннаяСтрока);
		Если ЗначениеЗаполнено(ФайлВыгрузки.АдресФайла) Тогда
			ПродолжитьВыгрузкуПриложенногоФайла(ФайлВыгрузки);
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВременныйФайлПриложенияНаКлиенте(ДанныеСтроки)
	ИмяФайла = ДанныеСтроки.ИмяФайла; 
	СодержимоеФайлаBase64 = ДанныеСтроки.СодержимоеФайла;
	
	ИмяБезРасширения = Лев(ИмяФайла, СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца) - 1);
	ПозицияРасширениеБезТочки = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если ЗначениеЗаполнено(ПозицияРасширениеБезТочки) Тогда 
		РасширениеБезТочки = Сред(ИмяФайла, ПозицияРасширениеБезТочки + 1);
	Иначе 
		РасширениеБезТочки = "pdf";
	КонецЕсли;

	ДвоичныеДанные = Base64Значение(СтрЗаменить(СодержимоеФайлаBase64,"  ",Символы.ВК));
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		ИмяВременногоФайла = Неопределено;
		Возврат ИмяВременногоФайла;
	КонецЕсли;	

	АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);

	#Если ВебКлиент Тогда
		Каталог = КаталогВременныхФайлов();
		ИмяФайла = Строка(Новый УникальныйИдентификатор) + "." + РасширениеБезТочки;
		ИмяВременногоФайла = Каталог + ИмяФайла;
	#Иначе
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(РасширениеБезТочки);
	#КонецЕсли

	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Возврат ИмяВременногоФайла;
КонецФункции

&НаКлиенте
Процедура ПродолжитьВыгрузкуПриложенногоФайла(ФайлВыгрузки)
	
	Оповещение = Новый ОписаниеОповещения("СохранитьДокументПослеПолученияФайла", ЭтотОбъект, Неопределено);
	
	Фильтр = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Файлы %1 (*.%1)|*.%1'"),
		"pdf");
	
	ПараметрыСохранения = ФайловаяСистемаКлиент.ПараметрыСохраненияФайла();
	ПараметрыСохранения.Диалог.Фильтр = Фильтр;
	ПараметрыСохранения.Диалог.Заголовок = НСтр("ru = 'Выберите файл для сохранения данных'");
	
	ФайловаяСистемаКлиент.СохранитьФайл(
		Оповещение, ФайлВыгрузки.АдресФайла, ФайлВыгрузки.ИмяФайла, ПараметрыСохранения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура СохранитьДокументПослеПолученияФайла(ПолученныеФайлы, Контекст) Экспорт
	
	Если ПолученныеФайлы = Неопределено ИЛИ ПолученныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл сохранен:'"), , ПолученныеФайлы[0].Имя);
	
КонецПроцедуры

&НаКлиенте
Функция ФайлПриложения(ВыбранноеЗначение)

	Результат = Новый Структура;
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;

	ДанныеСтроки = ФайлыПриложенийКИзвещению.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;

	ИмяФайла = ДанныеСтроки.ИмяФайла;
	СодержимоеФайлаBase64 = ДанныеСтроки.СодержимоеФайла;
	
	ДвоичныеДанные = Base64Значение(СтрЗаменить(СодержимоеФайлаBase64,"  ",Символы.ВК));
	Если НЕ ЗначениеЗаполнено(ДвоичныеДанные) Тогда
		Результат.Вставить("ИмяФайла", Неопределено);
		Результат.Вставить("АдресФайла", Неопределено);
		Возврат Результат;
	КонецЕсли;	

	АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	Результат.Вставить("ИмяФайла", ИмяФайла);
	Результат.Вставить("АдресФайла", АдресДвоичныхДанных);
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура УдалениеВременныхФайловПриложенийИзвещения()
	Если ИспользуетсяОграничениеДоступаНаУровнеЗаписей Тогда
		Для Каждого ТекСтрока Из ФайлыПриложенийКИзвещению Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ВременныйФайлПриложения) Тогда
				Попытка
					УдалитьФайлы(ТекСтрока.ВременныйФайлПриложения);
				Исключение
					// Дополнительная обработка не требуется. Файл будет удален после закрытия приложения, если не будет открыт.
				КонецПопытки;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры	

