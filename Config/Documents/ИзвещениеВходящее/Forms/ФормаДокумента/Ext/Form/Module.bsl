&НаКлиенте
Процедура ПереключательИспользоватьСписокДокументовОснованийПриИзменении(Элемент)
	Объект.ИспользоватьСписокДокументовОснований = Булево(ПереключательИспользоватьСписокДокументовОснований);
	Если Объект.ИспользоватьСписокДокументовОснований Тогда
		Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
			Объект.ДокументыОснования.Добавить().ДокументОснование = Объект.ДокументОснование;
			Объект.ДокументОснование = Неопределено;
		КонецЕсли;
	Иначе
		Если Объект.ДокументыОснования.Количество() > 1 Тогда
			ТекстВопроса = НСтр("ru = 'Будут удалены ранее выбранные документы-основания, кроме первого в списке.
				|Продолжить?'");
			ОповещениеПриОтвете = Новый ОписаниеОповещения("ПриОтветеУдалитьДокументыОснования", ЭтотОбъект);
			ПоказатьВопрос(ОповещениеПриОтвете, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Возврат;
		Иначе
			ПеренестиДокументОснованиеИзТЧ();
		КонецЕсли;
	КонецЕсли;
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
КонецПроцедуры

