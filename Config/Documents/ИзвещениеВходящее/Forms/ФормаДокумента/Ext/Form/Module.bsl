&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ПереключательДокументооборотСоСтороныПолучателя = ЦентрализованноеСнабжение.ДокументооборотСоСтороныПолучателя(
		Объект.ВидИзвещения);
	ПрочитатьПередаваемыеПроводки();
	УстановитьСлужебныеДанныеВыбораСчетов();
	ПрочитатьЗначениеПереключателяИспользоватьСписокДокументовОснований(ЭтотОбъект);
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
	Если Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОбновитьСчетаУчетаНаСервере();
	КонецЕсли;
	СоединитьНомераПриложений(ЭтотОбъект);
	УстановитьСчетаУчетаНФАВПараметрыФормы();
	ТипЭлектронногоИзвещенияЗаполнен = ЗначениеЗаполнено(Объект.ТипЭлектронногоИзвещения);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьПроводкиПоПриложениямНаКлиенте()
	Если Объект.ПередаваемыеПроводки.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Передаваемые проводки будут перезаполнены по выбранным ""Приложениям"".'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьПроводкиПоПриложениямНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроводкиПоПриложениямНаСервере()
	
	Объект.ПередаваемыеПроводки.Очистить();
	
	РегистраторыДляПроводок = Новый Массив;
	Для Каждого Строка Из Объект.Приложения Цикл
		Если ЗначениеЗаполнено(Строка.ДокументПриложения) Тогда
			РегистраторыДляПроводок.Добавить(Строка.ДокументПриложения);
		КонецЕсли;
	КонецЦикла;
	Если РегистраторыДляПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	 
	Выборка = ВыборкаПроводокПриложений(РегистраторыДляПроводок);
	Пока Выборка.Следующий() Цикл
		НоваяПроводка = Объект.ПередаваемыеПроводки.Добавить();
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДанныеНовойСтроки(ЭтотОбъект, НоваяПроводка);
		НоваяПроводка.КФО = Выборка.КФО;
		НоваяПроводка.Содержание = Выборка.Содержание;
		НоваяПроводка.Сумма = Выборка.Сумма;
		НоваяПроводка.СчетКт = Выборка.СчетДт;
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьРеквизитыСчета(ЭтотОбъект, НоваяПроводка, "Кт");
		НоваяПроводка.КПСКт = Выборка.КПСДт;
		НоваяПроводка.КЭККт = Выборка.КЭКДт;
		НоваяПроводка.ПодразделениеКт = Выборка.ПодразделениеДт;
		НоваяПроводка.СубконтоКт1 = Выборка.СубконтоДт1;
		НоваяПроводка.СубконтоКт2 = Выборка.СубконтоДт2;
		НоваяПроводка.СубконтоКт3 = Выборка.СубконтоДт3;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВыборкаПроводокПриложений(РегистраторыДляПроводок)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК Период,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки КАК НомерСтроки,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,, Регистратор В (&Регистраторы),,) КАК
	|		ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	Регистратор,
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Регистраторы", РегистраторыДляПроводок);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДанныеПриложенияИзДокумента(СтрокаПриложения)
	Если Не ЗначениеЗаполнено(СтрокаПриложения.ДокументПриложения) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПриложения = ВидНомерДатаДокументаПриложения(СтрокаПриложения.ДокументПриложения);
	Если ЗначениеЗаполнено(ДанныеПриложения.ВидДокумента) Тогда
		ЗаполнитьЗначенияСвойств(СтрокаПриложения, ДанныеПриложения);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидНомерДатаДокументаПриложения(Знач ДокументПриложения)
	Результат = Новый Структура("ВидДокумента, НомерДокумента, ДатаДокумента", "", "", '00010101');
	МетаданныеДокумента = ДокументПриложения.Метаданные();
	
	ТребуемыеДанные = Новый Структура;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВидПервичногоДокумента", МетаданныеДокумента) Тогда
		ТребуемыеДанные.Вставить("ВидДокумента", "ВидПервичногоДокумента");
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаПервичногоДокумента", МетаданныеДокумента) Тогда
		ТребуемыеДанные.Вставить("ДатаДокумента", "ДатаПервичногоДокумента");
	КонецЕсли;
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("НомерПервичногоДокумента", МетаданныеДокумента) Тогда
		ТребуемыеДанные.Вставить("НомерДокумента", "НомерПервичногоДокумента");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТребуемыеДанные) Тогда
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПриложения, ТребуемыеДанные);
		ЗаполнитьЗначенияСвойств(Результат, ДанныеДокумента);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьСубконтоВТаблицу(ИмяЭлемента)
	Если Объект.ПередаваемыеПроводки.Количество() > 0 Тогда
		УстановитьСубконтоВТаблицуНаСервере(ИмяЭлемента);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСубконтоВТаблицуНаСервере(ИмяЭлемента)
	
	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ПараметрыПодстановки.Объект = Объект;
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоВходящееИзвещение(ПараметрыПодстановки, Объект);
	
	Для Каждого Проводка Из Объект.ПередаваемыеПроводки Цикл
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоВСтроке(Проводка, ПараметрыПодстановки);
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, Проводка, "Дт");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПервуюАктивнуюЗакладку()
	Для Каждого ПодчиненнаяСтраница Из Элементы.Страницы.ПодчиненныеЭлементы Цикл
		Если ПодчиненнаяСтраница.Видимость И ПодчиненнаяСтраница.Доступность Тогда
			Элементы.Страницы.ТекущаяСтраница = ПодчиненнаяСтраница;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеПодбораДокументовОснований(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.КоличествоДокументов < Объект.ДокументыОснования.Количество() Тогда
		ТекстВопроса = НСтр("ru = 'Заполнить документ по выбранным документам-основаниям?'");
		ОповещениеПриОтвете = Новый ОписаниеОповещения("ПриОтветеЗаполнитьДокумент", ЭтотОбъект);
		ПоказатьВопрос(ОповещениеПриОтвете, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбораДокументаОснования()
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("НомераПриложенийСтрокой", НомераПриложенийСтрокой);
	ПараметрыПодбора.Вставить("Дата", Объект.Дата);
	ПараметрыПодбора.Вставить("НомераИзвещений", ПолучитьНомераПриложений());
	ПараметрыПодбора.Вставить("Отбор", Новый Структура);
	ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
	Возврат ПараметрыПодбора;
КонецФункции

&НаКлиенте
Функция ПолучитьНомераПриложений()
	Результат = Новый СписокЗначений;
	Для Каждого Приложение Из Объект.Приложения Цикл
		Результат.Добавить(Приложение.НомерДокумента);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПриОтветеЗаполнитьДокумент(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаКлиенте();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОтветеУдалитьДокументыОснования(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПеренестиДокументОснованиеИзТЧ();
		УправлениеВидимостьюЭлементов(ЭтотОбъект);
	Иначе
		Объект.ИспользоватьСписокДокументовОснований = Истина;
		ПрочитатьЗначениеПереключателяИспользоватьСписокДокументовОснований(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиДокументОснованиеИзТЧ()
	Если Объект.ДокументыОснования.Количество() > 0 Тогда
		Объект.ДокументОснование = Объект.ДокументыОснования[0].ДокументОснование;
		Объект.ДокументыОснования.Очистить();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПереключателяИспользоватьСписокДокументовОснований()
	Переключатель = Элементы.Найти("ПереключательИспользоватьСписокДокументовОснований");
	Если Переключатель <> Неопределено Тогда
		Переключатель.СписокВыбора.Добавить(0, НСтр("ru = 'Один документ-основание'"));
		Переключатель.СписокВыбора.Добавить(1, НСтр("ru = 'Список документов'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрочитатьЗначениеПереключателяИспользоватьСписокДокументовОснований(Форма)
	Форма.ПереключательИспользоватьСписокДокументовОснований = Число(Форма.Объект.ИспользоватьСписокДокументовОснований);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСчетаУчетаНаСервере()

	УстановитьСчетаУчетаНФАВПараметрыФормы();
	
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА") Тогда
			
		СчетУчетаОС = СчетУчетаОС(ЭтотОбъект);
		СчетУчетаМЗ = СчетУчетаМЗ(ЭтотОбъект);
		
		Если ЗначениеЗаполнено(СчетУчетаОС) Тогда
			УстановитьСчетУчетаВТаблицу(Объект.ОсновныеСредства, СчетУчетаОС);
		КонецЕсли;
		Если ЗначениеЗаполнено(СчетУчетаМЗ) Тогда
			УстановитьСчетУчетаВТаблицу(Объект.Материалы,        СчетУчетаМЗ);
			УстановитьСчетУчетаВТаблицу(Объект.ВозвратнаяТара,   СчетУчетаМЗ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчетаОС(Форма)
	СчетаУчетаНФА = СчетаУчетаНФА(Форма);
	Если СчетаУчетаНФА = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СчетаУчетаНФА.СчетУчетаОС;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчетаМЗ(Форма)
	СчетаУчетаНФА = СчетаУчетаНФА(Форма);
	Если СчетаУчетаНФА = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СчетаУчетаНФА.СчетУчетаМЗ;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетаУчетаНФА(Форма)
	Локальные = ОбщегоНазначенияБГУКлиентСервер.КэшПараметровФормы(Форма).Локальные;
	Если Не Локальные.Свойство("СчетаУчетаНФА") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Локальные.СчетаУчетаНФА.Получить(Форма.Объект.ВидИзвещения);
КонецФункции

&НаСервере
Процедура УстановитьСчетУчетаВТаблицу(Таблица, СчетУчета)
	Для каждого ТекСтрока Из Таблица Цикл
		Если ТекСтрока.СчетУчета <> СчетУчета Тогда
			ТекСтрока.СчетУчета = СчетУчета;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияСостояниеОригиналаНажатие()
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументовКлиент.ОткрытьМенюВыбораСостояния(ЭтотОбъект,Элементы.ДекорацияСостояниеОригинала);
	//Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
КонецПроцедуры

// Управление видимостью элементов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеВидимостьюЭлементов(Форма)

	Объект   = Форма.Объект; // ДанныеФормыСтруктура
	Элементы = Форма.Элементы; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПередаваемыеПроводки",
		"Видимость", ВидимостьЗакладкиПередаваемыеПроводки(Форма, Объект.ВидИзвещения));
	ИменаЗакладокНФА = Новый Массив;
	ИменаЗакладокНФА.Добавить("ГруппаОсновныеСредства");
	ИменаЗакладокНФА.Добавить("ГруппаМатериалы");
	ИменаЗакладокНФА.Добавить("ГруппаВозвратнаяТара");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЗакладокНФА,
		"Видимость", ВидимостьЗакладокНФА(Объект));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДокументыПолучателя",
		"Видимость", ВидимостьЗакладкиДокументыПолучателя(Объект.ТипЭлектронногоИзвещения));
	
	ВидимостьПоставщика = ВидимостьПоставщика(Объект.ВидИзвещения);
	ЭлементыПоставщика = Новый Массив;
	ЭлементыПоставщика.Добавить("Поставщик");
	ЭлементыПоставщика.Добавить("Договор");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыПоставщика,
		"Видимость", ВидимостьПоставщика);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Поставщик",
		"АвтоОтметкаНезаполненного", ВидимостьПоставщика);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Поставщик",
		"ОтметкаНезаполненного", ВидимостьПоставщика И Не ЗначениеЗаполнено(Объект.Поставщик));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
		"Видимость", ВидимостьДокументаОснования(Объект));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДокументыОснования",
		"Видимость", ВидимостьСпискаДокументовОснований(Объект));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПереключательИспользоватьСписокДокументовОснований",
		"Видимость", ВидимостьПереключателяСпискаДокументовОснований(Объект.ВидИзвещения));

	АвтоОтметкаДокументаОснования =
		Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
		"АвтоОтметкаНезаполненного", АвтоОтметкаДокументаОснования);
	ОтметкаДокументаОснования = АвтоОтметкаДокументаОснования И НЕ ЗначениеЗаполнено(Объект.ДокументОснование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
		"ОтметкаНезаполненного", ОтметкаДокументаОснования);
		
	ВидимостьКолонкиПриложенияДокументПриложения =
		ВидимостьКолонкиПриложенияДокументПриложения(Объект.ВидИзвещения);
	ЭлементыДокументПриложения = Новый Массив;
	ЭлементыДокументПриложения.Добавить("ПриложенияДокументПриложения");
	ЭлементыДокументПриложения.Добавить("ПередаваемыеПроводкиЗаполнитьПроводкиПоПриложениям");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыДокументПриложения,
		"Видимость", ВидимостьКолонкиПриложенияДокументПриложения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЗемельныеУчастки",
		"Видимость", ВидимостьЗемельныхУчастков(Объект));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НадписьДокументооборотСоСтороныПолучателя", "Видимость", Форма.ПереключательДокументооборотСоСтороныПолучателя);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиПередаваемыеПроводки(Форма, ВидИзвещения)
	Возврат ЗначениеЗаполнено(Форма.ВсеДопустимыеКорреспонденции)
		И Форма.ВсеДопустимыеКорреспонденции.СчетаДт.Количество() > 0;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладокНФА(Объект)
	Если Объект.ТипЭлектронногоИзвещения <> 3 Тогда
		Возврат (Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА"));
	Иначе
		Возврат (Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА"))
			И (ЗначениеЗаполнено(Объект.ДокументОснование)
				Или Объект.ДокументыОснования.Количество() > 0);
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьПоставщика(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРБП")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияРБП")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаЭДО");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗакладкиДокументыПолучателя(ТипЭлектронногоИзвещения)

	Возврат ТипЭлектронногоИзвещения = 2;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьДокументаОснования(Объект)
	Возврат Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА")
		ИЛИ (Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
			И НЕ Объект.ИспользоватьСписокДокументовОснований);
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьСпискаДокументовОснований(Объект)
	Возврат Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА")
		И Объект.ИспользоватьСписокДокументовОснований;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьПереключателяСпискаДокументовОснований(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеНФА");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьЗемельныхУчастков(Объект)
	Возврат Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИЭДО");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьКолонкиПриложенияДокументПриложения(ВидИзвещения)
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв");
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьРеквизитыСчета(Счет, Сторона = "Дт")
	// TODO: Нужна ли процедура?
	РеквизитыСчета = Новый Структура;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
		РеквизитыСчета.Вставить("Счет"+Сторона+"УчетПоПодразделениям",	СвойстваСчета.УчетПоПодразделениям);
		РеквизитыСчета.Вставить("Счет"+Сторона+"УчетПоПодразделениямОбязательный",	Не СвойстваСчета.РазрешитьНеУказыватьПодразделение);
		РеквизитыСчета.Вставить("Счет"+Сторона+"УчетПоКПС", 			СвойстваСчета.УчетПоКПС);
		РеквизитыСчета.Вставить("Счет"+Сторона+"УчетПоКЭК", 			СвойстваСчета.УчетПоКЭК);
		РеквизитыСчета.Вставить("Счет"+Сторона+"КоличествоСубконто", 	СвойстваСчета.КоличествоСубконто);
	КонецЕсли;

	Возврат РеквизитыСчета;
КонецФункции

&НаСервере
Процедура ПрочитатьПередаваемыеПроводки()

	Для каждого ТекСтр Из Объект.ПередаваемыеПроводки Цикл
		
		ЗаполнитьЗначенияСвойств(ТекСтр, УстановитьРеквизитыСчета(ТекСтр.СчетДт, "Дт"));
		ЗаполнитьЗначенияСвойств(ТекСтр, УстановитьРеквизитыСчета(ТекСтр.СчетКт, "Кт"));
					
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаКлиенте()
	ЗаполнитьНаСервере();
	УправлениеВидимостьюЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	Если Объект.ИспользоватьСписокДокументовОснований Тогда
		Основание = Объект.ДокументыОснования.Выгрузить().ВыгрузитьКолонку("ДокументОснование");
	Иначе
		Основание = Объект.ДокументОснование;
	КонецЕсли;
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
		Документы.ИзвещениеВходящее.ЗаполнитьНаОснованииИсходящегоИзвещения(Объект, Основание);
	Иначе
		Документы.ИзвещениеВходящее.ЗаполнитьНаОснованииПоступленияНФАПоЦС(Объект, Основание);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СчетаСоответствуютВидуОперации(ВидИзвещения)
	
	СчетУчетаОС = СчетУчетаОС(ЭтотОбъект);
	Если ЗначениеЗаполнено(СчетУчетаОС) Тогда
		Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			Если ТекСтрока.СчетУчета <> СчетУчетаОС Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	СчетУчетаМЗ = СчетУчетаМЗ(ЭтотОбъект);
	Если ЗначениеЗаполнено(СчетУчетаМЗ) Тогда
		Для каждого ТекСтрока Из Объект.Материалы Цикл
			Если ТекСтрока.СчетУчета <> СчетУчетаМЗ Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла; 
		Для каждого ТекСтрока Из Объект.ВозвратнаяТара Цикл
			Если ТекСтрока.СчетУчета <> СчетУчетаМЗ Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура УстановитьСчетаУчетаНФАВПараметрыФормы()
	КэшПараметров = ОбщегоНазначенияБГУКлиентСервер.КэшПараметровФормы(ЭтотОбъект);
	КэшПараметров.Локальные.Вставить("СчетаУчетаНФА", Новый Соответствие);
	СчетаУчетаНФА = Новый Структура;
	СчетаУчетаНФА.Вставить("СчетУчетаОС", БухгалтерскийУчет.СчетПоКоду("22.1", Объект.Дата, Объект.Организация));
	СчетаУчетаНФА.Вставить("СчетУчетаМЗ", БухгалтерскийУчет.СчетПоКоду("22.2", Объект.Дата, Объект.Организация));
	КэшПараметров.Локальные.СчетаУчетаНФА.Вставить(Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеНФА, СчетаУчетаНФА);
	
	СчетаУчетаНФА = Новый Структура;
	СчетаУчетаНФА.Вставить("СчетУчетаОС", БухгалтерскийУчет.СчетПоКоду("05.1", Объект.Дата, Объект.Организация));
	СчетаУчетаНФА.Вставить("СчетУчетаМЗ", БухгалтерскийУчет.СчетПоКоду("05.2", Объект.Дата, Объект.Организация));
	КэшПараметров.Локальные.СчетаУчетаНФА.Вставить(Перечисления.ВидыОперацийВходящееИзвещение.ПодтверждениеПолученияНФА, СчетаУчетаНФА);
КонецПроцедуры

