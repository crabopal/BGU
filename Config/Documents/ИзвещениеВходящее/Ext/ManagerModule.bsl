#Область ПрограммныйИнтерфейс

Функция НомераПриложений(Извещение) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеВходящееПриложения.НомерДокумента
	|ИЗ
	|	Документ.ИзвещениеВходящее.Приложения КАК ИзвещениеВходящееПриложения
	|ГДЕ
	|	ИзвещениеВходящееПриложения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИзвещениеВходящееПриложения.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Извещение);
	НомераПриложений = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.НомерДокумента) Тогда
			НомераПриложений.Добавить(СокрЛП(Выборка.НомерДокумента));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(НомераПриложений, ",");
КонецФункции

