Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	ВводНаОсновании.ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения);
	
	// Продолжаем заполнение нового документа
	
	ВидДокумента			= ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"]["ВидДокумента"];

	Если ВидДокумента = "ПринятиеКУчетуОбъектовОС" Тогда

		ЗаполняемыйДокумент["Дата"]        		= ОбщегоНазначения.ТекущаяДатаПользователя();
		ЗаполняемыйДокумент["ВидПоступления"]	= Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;

		ОтражатьВНалоговомУчете =
			УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ЗаполняемыйДокумент);
		
		МассивСсылок = ОбщегоНазначения.ВыгрузитьКолонку(ЗаполняемыйДокумент["ОсновныеСредства"], "ОсновноеСредство", Истина);
		РеквизитыСпискаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСсылок, "АмортизационнаяГруппа,ПрослеживаемыйТовар,СтранаПроисхождения");

		Для Каждого ТекущаяСтрока Из ЗаполняемыйДокумент["ОсновныеСредства"] Цикл
			
			ТекущаяСтрока["СуммаВВалюте"] = ТекущаяСтрока["Сумма"];
			Если ОтражатьВНалоговомУчете Тогда
				ТекущаяСтрока["СуммаНУ"]  = ТекущаяСтрока["Сумма"];
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитыОС = РеквизитыСпискаОС[ТекущаяСтрока.ОсновноеСредство];
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, РеквизитыОС);
			УстановитьСрокПолезногоИспользованияВСтрокеТЧ(РеквизитыОС, ТекущаяСтрока);
				
		КонецЦикла;
		
	КонецЕсли;	
	
КонецПроцедуры

