// Данные заполнения по поступлениям НФА.
// 
// Параметры:
//  ДокументыПоступления - Массив из ДокументСсылка.ПоступлениеНФАпоЦС, ДокументСсылка.ПоступлениеНФАпоЦС -
// 
// Возвращаемое значение:
//  Структура - Данные заполнения по поступлениям НФА:
// * Документ - ТаблицаЗначений -
// * ОсновныеСредства - ТаблицаЗначений -
// * Материалы - ТаблицаЗначений -
// * ВозвратнаяТара - ТаблицаЗначений -
Функция ДанныеЗаполненияПоПоступлениямНФА(ДокументыПоступления)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПоступлениеНФАпоЦС.Организация,
	|	ПоступлениеНФАпоЦС.ИФО,
	|	ПоступлениеНФАпоЦС.Подразделение,
	|	ПоступлениеНФАпоЦС.Контрагент Как Поставщик,
	|	ПоступлениеНФАпоЦС.Договор Как Договор,
	|	ПоступлениеНФАпоЦС.ЦМО
	|ИЗ
	|	Документ.ПоступлениеНФАпоЦС КАК ПоступлениеНФАпоЦС
	|ГДЕ
	|	ПоступлениеНФАпоЦС.Ссылка В (&ДокументыПоступления)
	|;
	|ВЫБРАТЬ
	|	ПоступлениеНФАпоЦСОсновныеСредства.ОсновноеСредство,
	|	ПоступлениеНФАпоЦСОсновныеСредства.Количество,
	|	ПоступлениеНФАпоЦСОсновныеСредства.Сумма,
	|	ПоступлениеНФАпоЦСОсновныеСредства.КФО,
	|	ПоступлениеНФАпоЦСОсновныеСредства.СчетУчета
	|ИЗ
	|	Документ.ПоступлениеНФАпоЦС.ОсновныеСредства КАК ПоступлениеНФАпоЦСОсновныеСредства
	|ГДЕ
	|	ПоступлениеНФАпоЦСОсновныеСредства.Ссылка В (&ДокументыПоступления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеНФАпоЦСОсновныеСредства.ОсновноеСредство.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеНФАпоЦСМатериалы.Номенклатура,
	|	ПоступлениеНФАпоЦСМатериалы.Количество,
	|	ПоступлениеНФАпоЦСМатериалы.Сумма,
	|	ПоступлениеНФАпоЦСМатериалы.КФО,
	|	ПоступлениеНФАпоЦСМатериалы.СчетУчета
	|ИЗ
	|	Документ.ПоступлениеНФАпоЦС.Материалы КАК ПоступлениеНФАпоЦСМатериалы
	|ГДЕ
	|	ПоступлениеНФАпоЦСМатериалы.Ссылка В (&ДокументыПоступления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеНФАпоЦСМатериалы.Номенклатура.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоступлениеНФАпоЦСВозвратнаяТара.Номенклатура,
	|	ПоступлениеНФАпоЦСВозвратнаяТара.Количество,
	|	ПоступлениеНФАпоЦСВозвратнаяТара.Сумма,
	|	ПоступлениеНФАпоЦСВозвратнаяТара.КФО,
	|	ПоступлениеНФАпоЦСВозвратнаяТара.СчетУчета
	|ИЗ
	|	Документ.ПоступлениеНФАпоЦС.ВозвратнаяТара КАК ПоступлениеНФАпоЦСВозвратнаяТара
	|ГДЕ
	|	ПоступлениеНФАпоЦСВозвратнаяТара.Ссылка В (&ДокументыПоступления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоступлениеНФАпоЦСВозвратнаяТара.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("ДокументыПоступления", ДокументыПоступления);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Результат.Вставить("Документ",         РезультатЗапроса[0].Выгрузить());
	Результат.Вставить("ОсновныеСредства", РезультатЗапроса[1].Выгрузить());
	Результат.Вставить("Материалы",        РезультатЗапроса[2].Выгрузить());
	Результат.Вставить("ВозвратнаяТара",   РезультатЗапроса[3].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

// Заполнить на основании поступления НФАПо ЦС.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее, ДанныеФормыСтруктура -
//  ДокументыПоступления - Массив из ДокументСсылка.ПоступлениеНФАпоЦС, ДокументСсылка.ПоступлениеНФАпоЦС -
Процедура ЗаполнитьНаОснованииПоступленияНФАПоЦС(Объект, ДокументыПоступления) Экспорт
	
	ДанныеЗаполнения = ДанныеЗаполненияПоПоступлениямНФА(ДокументыПоступления);
	
	Если ТипЗнч(ДокументыПоступления) = Тип("ДокументСсылка.ПоступлениеНФАпоЦС")
		И ДанныеЗаполнения.Документ.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения.Документ[0]);
	КонецЕсли;
	
	Объект.ОсновныеСредства.Загрузить(ДанныеЗаполнения.ОсновныеСредства);
	Объект.Материалы.Загрузить(ДанныеЗаполнения.Материалы);
	Объект.ВозвратнаяТара.Загрузить(ДанныеЗаполнения.ВозвратнаяТара);
	
КонецПроцедуры

// Данные заполнения по исходящему извещению.
// 
// Параметры:
//  ДокументОснование - ДокументСсылка.ИзвещениеИсходящее -
// 
// Возвращаемое значение:
//  Структура - Данные заполнения по исходящему извещению:
// * Документ - ТаблицаЗначений -
// * ОсновныеСредства - ТаблицаЗначений -
// * Материалы - ТаблицаЗначений -
// * ВозвратнаяТара - ТаблицаЗначений -
Функция ДанныеЗаполненияПоИсходящемуИзвещению(ДокументОснование)
	Запрос = Новый Запрос;
	Запрос.текст =
	"ВЫБРАТЬ
	|	ИзвещениеИсходящееОсновныеСредства.Ссылка,
	|	ИзвещениеИсходящееОсновныеСредства.НомерСтроки,
	|	ИзвещениеИсходящееОсновныеСредства.ОсновноеСредство,
	|	ИзвещениеИсходящееОсновныеСредства.Количество,
	|	ИзвещениеИсходящееОсновныеСредства.Сумма,
	|	ИзвещениеИсходящееОсновныеСредства.КФО,
	|	ИзвещениеИсходящееОсновныеСредства.СчетУчета
	|ПОМЕСТИТЬ ОсновныеСредства
	|ИЗ
	|	Документ.ИзвещениеИсходящее.ОсновныеСредства КАК ИзвещениеИсходящееОсновныеСредства
	|ГДЕ
	|	ИзвещениеИсходящееОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеИсходящееМатериалы.Ссылка,
	|	ИзвещениеИсходящееМатериалы.НомерСтроки,
	|	ИзвещениеИсходящееМатериалы.Номенклатура,
	|	ИзвещениеИсходящееМатериалы.Количество,
	|	ИзвещениеИсходящееМатериалы.Сумма,
	|	ИзвещениеИсходящееМатериалы.КФО,
	|	ИзвещениеИсходящееМатериалы.СчетУчета
	|ПОМЕСТИТЬ Материалы
	|ИЗ
	|	Документ.ИзвещениеИсходящее.Материалы КАК ИзвещениеИсходящееМатериалы
	|ГДЕ
	|	ИзвещениеИсходящееМатериалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеИсходящееВозвратнаяТара.Ссылка,
	|	ИзвещениеИсходящееВозвратнаяТара.НомерСтроки,
	|	ИзвещениеИсходящееВозвратнаяТара.Номенклатура,
	|	ИзвещениеИсходящееВозвратнаяТара.Количество,
	|	ИзвещениеИсходящееВозвратнаяТара.Сумма,
	|	ИзвещениеИсходящееВозвратнаяТара.КФО,
	|	ИзвещениеИсходящееВозвратнаяТара.СчетУчета
	|ПОМЕСТИТЬ ВозвратнаяТара
	|ИЗ
	|	Документ.ИзвещениеИсходящее.ВозвратнаяТара КАК ИзвещениеИсходящееВозвратнаяТара
	|ГДЕ
	|	ИзвещениеИсходящееВозвратнаяТара.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЕПСБУ.Количественный
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ОсновныеСредства.СчетУчета КАК Поле1
	|				ИЗ
	|					ОсновныеСредства
	|			
	|				ОБЪЕДИНИТЬ
	|			
	|				ВЫБРАТЬ
	|					Материалы.СчетУчета
	|				ИЗ
	|					Материалы
	|			
	|				ОБЪЕДИНИТЬ
	|			
	|				ВЫБРАТЬ
	|					ВозвратнаяТара.СчетУчета
	|				ИЗ
	|					ВозвратнаяТара),
	|			,
	|			Организация = &Организация
	|				И Субконто2 = &Ссылка) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ЕПСБУ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзвещениеИсходящее.Организация,
	|	ИзвещениеИсходящее.Получатель КАК Отправитель,
	|	ИзвещениеИсходящее.Поставщик,
	|	ИзвещениеИсходящее.Договор,
	|	ИзвещениеИсходящее.ИФО,
	|	&Ссылка КАК ДокументОснование
	|ИЗ
	|	Документ.ИзвещениеИсходящее КАК ИзвещениеИсходящее
	|ГДЕ
	|	ИзвещениеИсходящее.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство,
	|	ОсновныеСредства.КФО,
	|	ОсновныеСредства.СчетУчета,
	|	ОсновныеСредства.НомерСтроки,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА ОсновныеСредства.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.СуммаОстатокДт
	|					КОГДА ОсновныеСредства.Количество = 0
	|						ТОГДА Остатки.СуммаОстатокДт
	|					ИНАЧЕ ОсновныеСредства.Количество * Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт
	|				КОНЕЦ
	|		КОГДА ОсновныеСредства.Сумма < Остатки.СуммаОстатокДт
	|			ТОГДА ОсновныеСредства.Сумма
	|		ИНАЧЕ Остатки.СуммаОстатокДт
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА ОсновныеСредства.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.КоличествоОстатокДт
	|					ИНАЧЕ ОсновныеСредства.Количество
	|				КОНЕЦ
	|		ИНАЧЕ ОсновныеСредства.Количество
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ОсновныеСредства.ОсновноеСредство = Остатки.Субконто3
	|			И ОсновныеСредства.СчетУчета = Остатки.Счет
	|			И ОсновныеСредства.КФО = Остатки.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Номенклатура,
	|	Материалы.НомерСтроки,
	|	Материалы.КФО,
	|	Материалы.СчетУчета,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА Материалы.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.СуммаОстатокДт
	|					КОГДА Материалы.Количество = 0
	|						ТОГДА Остатки.СуммаОстатокДт
	|					ИНАЧЕ Материалы.Количество * Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт
	|				КОНЕЦ
	|		КОГДА Материалы.Сумма < Остатки.СуммаОстатокДт
	|			ТОГДА Материалы.Сумма
	|		ИНАЧЕ Остатки.СуммаОстатокДт
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА Материалы.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.КоличествоОстатокДт
	|					ИНАЧЕ Материалы.Количество
	|				КОНЕЦ
	|		ИНАЧЕ Материалы.Количество
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	Материалы КАК Материалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО Материалы.Номенклатура = Остатки.Субконто3
	|			И Материалы.СчетУчета = Остатки.Счет
	|			И Материалы.КФО = Остатки.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВозвратнаяТара.НомерСтроки,
	|	ВозвратнаяТара.Номенклатура,
	|	ВозвратнаяТара.КФО,
	|	ВозвратнаяТара.СчетУчета,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА ВозвратнаяТара.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.СуммаОстатокДт
	|					КОГДА ВозвратнаяТара.Количество = 0
	|						ТОГДА Остатки.СуммаОстатокДт
	|					ИНАЧЕ ВозвратнаяТара.Количество * Остатки.СуммаОстатокДт / Остатки.КоличествоОстатокДт
	|				КОНЕЦ
	|		КОГДА ВозвратнаяТара.Сумма < Остатки.СуммаОстатокДт
	|			ТОГДА ВозвратнаяТара.Сумма
	|		ИНАЧЕ Остатки.СуммаОстатокДт
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.Количественный
	|			ТОГДА ВЫБОР
	|					КОГДА ВозвратнаяТара.Количество >= Остатки.КоличествоОстатокДт
	|						ТОГДА Остатки.КоличествоОстатокДт
	|					ИНАЧЕ ВозвратнаяТара.Количество
	|				КОНЕЦ
	|		ИНАЧЕ ВозвратнаяТара.Количество
	|	КОНЕЦ КАК Количество
	|ИЗ
	|	ВозвратнаяТара КАК ВозвратнаяТара
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ВозвратнаяТара.Номенклатура = Остатки.Субконто3
	|			И ВозвратнаяТара.КФО = Остатки.КФО
	|			И ВозвратнаяТара.СчетУчета = Остатки.Счет";
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "Организация"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Результат.Вставить("Документ",         РезультатЗапроса[4].Выгрузить());
	Результат.Вставить("ОсновныеСредства", РезультатЗапроса[5].Выгрузить());
	Результат.Вставить("Материалы",        РезультатЗапроса[6].Выгрузить());
	Результат.Вставить("ВозвратнаяТара",   РезультатЗапроса[7].Выгрузить());
	
	Возврат Результат;

КонецФункции

// Заполнить на основании исходящего извещения.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее, ДанныеФормыСтруктура -
//  ДокументОснование - ДокументСсылка.ИзвещениеИсходящее -
//  ЗаполнитьШапку - Булево -
Процедура ЗаполнитьНаОснованииИсходящегоИзвещения(Объект, ДокументОснование, ЗаполнитьШапку = Ложь) Экспорт
	
	ДанныеЗаполнения = ДанныеЗаполненияПоИсходящемуИзвещению(ДокументОснование);
	
	Если ЗаполнитьШапку И ДанныеЗаполнения.Документ.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(Объект, ДанныеЗаполнения.Документ[0]);
	КонецЕсли;
	
	Объект.ОсновныеСредства.Загрузить(ДанныеЗаполнения.ОсновныеСредства);
	Объект.Материалы.Загрузить(ДанныеЗаполнения.Материалы);
	Объект.ВозвратнаяТара.Загрузить(ДанныеЗаполнения.ВозвратнаяТара);
	
КонецПроцедуры

// Заполняет срок полезного использования для ОС в строке документа
//
// Параметры:
//  РеквизитыОС - Структура
//  СтрокаТЧ  	- ДокументТабличнаяЧастьСтрока.ПринятиеКУчетуОбъектовОС.ОсновныеСредства
//
Процедура УстановитьСрокПолезногоИспользованияВСтрокеТЧ(РеквизитыОС, ТекущаяСтрока)
	
	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		РеквизитыОС.АмортизационнаяГруппа);
	
	ТекущаяСтрока.СрокПолезногоИспользования    = СрокПолезногоИспользования;
	ТекущаяСтрока.СрокПолезногоИспользованияНУ  = СрокПолезногоИспользования;
	ТекущаяСтрока.СрокПолезногоИспользованияУСН = СрокПолезногоИспользования;

КонецПроцедуры

