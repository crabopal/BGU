Функция ПолучитьПредставлениеНомераБСО(НомерЧисло, Знач ДлинаПредставления)
	
	Если НомерЧисло = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ПрименяемаяДлинаПредставления = ?(ЗначениеЗаполнено(ДлинаПредставления),
		ДлинаПредставления,
		ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО());
	
	Возврат Формат(НомерЧисло, "ЧВН=1; ЧГ=0; ЧЦ=" + Формат(ПрименяемаяДлинаПредставления, "ЧГ=0"));
	
КонецФункции	

Процедура РассчитатьРасхождение(ЗначениеПоФакту, ЗначениеПоУчету, НовоеЗначениеНедостачи, НовоеЗначениеИзлишка)
	
	Дельта = ЗначениеПоУчету - ЗначениеПоФакту;
		
	НовоеЗначениеНедостачи	= ?(Дельта>0, Дельта, 0);
	НовоеЗначениеИзлишка	= ?(Дельта<0, -Дельта, 0);
	
КонецПроцедуры

Процедура ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент, ДокументОснованиеСсылка)
	
	// Настраиваем запрос:
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ДокСсылка", ДокументОснованиеСсылка);
	ЗапросВыборка.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Председатель комиссии, прочие сведения о ней.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьПредседателяКомиссии	КАК ДолжностьПредседательКомиссии,
	|	ФамилияПредседателяКомиссии		КАК ФамилияПредседательКомиссии,
	|	ИмяПредседателяКомиссии			КАК ИмяПредседательКомиссии,
	|	ОтчествоПредседателяКомиссии	КАК ОтчествоПредседательКомиссии,
	|	ДатаПриказаКомиссии				КАК ДатаПриказа,
	|	НомерПриказаКомиссии			КАК НомерПриказа
	|ИЗ
	|	Документ.ИнвентаризацияКассы
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица ""Состав комиссии"".
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ФамилияЧленаКомиссии	КАК ФамилияЧленаКомиссии,
	|	ИмяЧленаКомиссии		КАК ИмяЧленаКомиссии,
	|	ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияКассы.СоставКомиссии
	|ГДЕ
	|	Ссылка = &ДокСсылка
	|;";
	
	РезультатыВыборки = ЗапросВыборка.ВыполнитьПакет();
	
	// Заполняем реквизиты, относящиеся к инвентаризационной комиссии.
	
	// Шапка
	Выборка = РезультатыВыборки[0].Выбрать();
	Пока Выборка.Следующий() Цикл // В выборке всего 0 или 1 запись.
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, Выборка);
	КонецЦикла;
	
	// Табл.часть
	СоставКомиссии = РезультатыВыборки[1].Выгрузить();
	ЗаполняемыйДокумент["СоставКомиссии"].Загрузить(СоставКомиссии);
	
КонецПроцедуры

Функция ПолучитьСписокЦМОДляОтбора(ДокументОбъект)
	
	Если ТипЗнч(ДокументОбъект.МОЛ) = Тип("СправочникСсылка.ЦМО") Тогда
		СписокЦМО = Новый Массив();
		СписокЦМО.Добавить(ДокументОбъект.МОЛ);
		
	ИначеЕсли ТипЗнч(ДокументОбъект.МОЛ) = Тип("СправочникСсылка.Сотрудники") Тогда
		Если ЗначениеЗаполнено(ДокументОбъект.МестоИнвентаризации) Тогда
			МассивМестИнвентаризации = Новый Массив();
			МассивМестИнвентаризации.Добавить(ДокументОбъект.МестоИнвентаризации);
			
			СпискиМОЛ = ИнвентаризацияСервер.ПолучитьСпискиМОЛДляСпискаМестИнвентаризации(ДокументОбъект.МОЛ, МассивМестИнвентаризации);
			
			СписокЦМО = СпискиМОЛ.СписокЦМО;
		Иначе
			СписокЦМО = ИнвентаризацияСервер.ПолучитьВсеЦМОСотрудникаДляОтбора(ДокументОбъект.МОЛ, ДокументОбъект.Организация);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СписокЦМО;
	
КонецФункции

