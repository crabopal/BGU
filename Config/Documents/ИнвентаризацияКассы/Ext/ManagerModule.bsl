	ЗаголовкиКолонокТаблицыОтметки = Новый Структура();
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ВидДенежногоДокумента",	"Вид денежного документа");
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ДенежныйДокумент",			"Денежный документ");
	ЗаголовкиКолонокТаблицыОтметки.Вставить("ЦМО",						"МОЛ/Место хранения");
