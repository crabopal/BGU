	// Настройки таблицы "Отметки"
	//																		Колонка таблицы				Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ВидДенежногоДокумента",	"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ДенежныйДокумент",			"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Сумма",					"");
	Если ВестиКоличественныйУчетДенежныхДокументов Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Количество",				"");
	КонецЕсли;
