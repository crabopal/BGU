Функция Печать0504086_ПолучитьИтогиПрописью(Итоги)
	
	ПараметрыПредметаИсчисления = ", , , , , , , , 0";
	
	КоличествоНомеровПрописью = ЧислоПрописью(Итоги["КоличествоСтрок"], "Л=ru_RU; НП=Ложь", ПараметрыПредметаИсчисления);
	
	КоличествоЕдиницПрописью = ЧислоПрописью(Итоги["КоличествоФакт"], "Л=ru_RU; НП=Ложь", ПараметрыПредметаИсчисления);
	
	ИтогиПрописью = Новый Структура();
	ИтогиПрописью.Вставить("КоличествоПорядковыхНомеров",	КоличествоНомеровПрописью);
	ИтогиПрописью.Вставить("КоличествоЕдиницФактически",	КоличествоЕдиницПрописью);
	
	Возврат ИтогиПрописью;
	
КонецФункции

