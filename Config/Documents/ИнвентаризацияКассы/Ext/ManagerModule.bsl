	Возврат НастройкиМеханизма;
	
КонецФункции

Функция ВводНаОсновании_НастройкиФормыСпискаДокументовВведенныхНаОсновании(ДополнительныйПараметр = Неопределено) Экспорт
	
	Перем	Таблица,
			МассивФлажков;
	
	ВидыДокументовСписание		= Новый Массив();
	ВидыДокументовПоступление	= Новый Массив();
	
	Если ДополнительныйПараметр = "ДС" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "РасходныйКассовыйОрдер";
		ВидыДокументовСписание.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Валюта",	,			"ВалютаДокумента");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
		
		ВидДокумента = "ПриходныйКассовыйОрдер";
		ВидыДокументовПоступление.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Валюта",	,			"ВалютаДокумента");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
	КонецЕсли;
	
	Если ДополнительныйПараметр = "ДД" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "РасходныйОрдерФондовый";
		ВидыДокументовСписание.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
		
		ВидДокумента = "ПриходныйОрдерФондовый";
		ВидыДокументовПоступление.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "Сумма",		,			"СуммаДокумента");
	КонецЕсли;
	
	Если ДополнительныйПараметр = "БСО" ИЛИ ДополнительныйПараметр = Неопределено Тогда
		ВидДокумента = "СписаниеБСО";
		ВидыДокументовСписание.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО",	"МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "КФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "СчетУчета",	"Счет учета");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
		
		ВидДокумента = "ПоступлениеБСО";
		ВидыДокументовПоступление.Добавить(ВидДокумента);
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ЦМО",	"МОЛ/Место хранения");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "КФО");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "СчетУчета",	"Счет учета");
		ВводНаОсновании.ДобавитьКолонкуСпискаДокументов(Таблица, ВидДокумента, "ИФО");
	КонецЕсли;
	
	ЗаголовокФлажка = "Списания недостач";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовСписание, ЗаголовокФлажка);
	
	ЗаголовокФлажка = "Оприходования излишков";
	ВводНаОсновании.ДобавитьФлажок(МассивФлажков, ВидыДокументовПоступление, ЗаголовокФлажка);
	
	
	НастройкиФормыСписка = Новый Структура();
	НастройкиФормыСписка.Вставить("ТаблицаОписаниеКолонок",	Таблица);
	НастройкиФормыСписка.Вставить("МассивФлажков",			МассивФлажков);
	
	Возврат НастройкиФормыСписка;
	
КонецФункции

