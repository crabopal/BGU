#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьОшибкиЗаполненияТаблицыДенежныеСредства(ДокументОбъект) Экспорт
	
	// Инициализация:
	МаксДлинаСообщения = 200;
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Настраиваем запрос:
	ЗапросПроверки = Новый Запрос();
	ЗапросПроверки.УстановитьПараметр("ТЗДенежныеСредства", ДокументОбъект["ДенежныеСредства"].Выгрузить());
	ЗапросПроверки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные данные табличной части ""Денежные средства"".
	|//		(Проверка. Дубли валюты в таблице ""Денежные средства"")
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.Валюта				КАК Валюта
	|ПОМЕСТИТЬ
	|	ТаблицаДенежныеСредства
	|ИЗ
	|	&ТЗДенежныеСредства	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.Валюта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Дубли валюты.
	|//		(Проверка. Дубли валюты в таблице ""Денежные средства"")
	|//
	|ВЫБРАТЬ
	|	Валюта	КАК Валюта
	|ПОМЕСТИТЬ
	|	ДублиСтрок
	|ИЗ
	|	ТаблицаДенежныеСредства
	|СГРУППИРОВАТЬ ПО
	|	Валюта
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(Валюта) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Проверка. Дубли валюты в таблице ""Денежные средства""
	|//		(Финальная таблица для вывода сообщений)
	|//
	|ВЫБРАТЬ
	|	ДублиСтрок.Валюта						КАК Валюта,
	|	ТаблицаДенежныеСредства.НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	ДублиСтрок
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблицаДенежныеСредства
	|		ПО	ДублиСтрок.Валюта = ТаблицаДенежныеСредства.Валюта
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаДенежныеСредства.НомерСтроки
	|ИТОГИ
	|ПО
	|	Валюта
	|;";
	
	// Выполняем запрос:
	РезультатПроверки = ЗапросПроверки.Выполнить();
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ИмяТаблЧастиДляВыводаСообщений = "ДенежныеСредства";
		ИмяПоляДляВыводаСообщений = "Валюта";
		Текст = НСтр("ru='Дубли валюты (Таблица ""Наличные средства"", строки %1)'");

		ДеревоВыборка = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для Каждого СтрокаИтогоВалюта Из ДеревоВыборка.Строки Цикл // Группировки по Валюта
			НомераСтрок = СтрокаИтогоВалюта.Строки.ВыгрузитьКолонку("НомерСтроки");
			ИндексСтроки = НомераСтрок[НомераСтрок.Количество() - 1] - 1;
			
			ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
			
			ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументОбъект["Ссылка"],
				"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Функция ЕстьОшибкиЗаполненияТаблицыДенежныеДокументы(ДокументОбъект) Экспорт
	
	// Инициализация:
	МаксДлинаСообщения = 200;
	ЕстьОшибкиЗаполнения = Ложь;
	
	// Настраиваем запрос:
	ЗапросПроверки = Новый Запрос();
	ЗапросПроверки.УстановитьПараметр("ТЗДенежныеДокументы", ДокументОбъект["ДенежныеДокументы"].Выгрузить());
	ЗапросПроверки.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Исходные данные табличной части ""Денежные документы"".
	|//		(Проверка. Дубли строк в таблице ""Денежные документы"")
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки				КАК НомерСтроки,
	|	ТЗ.ВидДенежногоДокумента	КАК ВидДенежногоДокумента,
	|	ТЗ.ДенежныйДокумент			КАК ДенежныйДокумент
	|ПОМЕСТИТЬ
	|	ТаблицаДенежныеДокументы
	|ИЗ
	|	&ТЗДенежныеДокументы	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.ВидДенежногоДокумента,
	|	ТЗ.ДенежныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Дубли денежных документов
	|//		(Проверка. Дубли строк в таблице ""Денежные документы"")
	|ВЫБРАТЬ
	|	ВидДенежногоДокумента	КАК ВидДенежногоДокумента,
	|	ДенежныйДокумент		КАК ДенежныйДокумент
	|ПОМЕСТИТЬ
	|	ДублиСтрок
	|ИЗ
	|	ТаблицаДенежныеДокументы
	|СГРУППИРОВАТЬ ПО
	|	ВидДенежногоДокумента,
	|	ДенежныйДокумент
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ДенежныйДокумент) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Проверка. Дубли строк в таблице ""Денежные документы""
	|//		(Финальная таблица для вывода сообщений)
	|ВЫБРАТЬ
	|	ТаблицаДенежныеДокументы.ДенежныйДокумент	КАК ДенежныйДокумент,
	|	ТаблицаДенежныеДокументы.НомерСтроки		КАК НомерСтроки
	|ИЗ
	|	ДублиСтрок
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблицаДенежныеДокументы
	|		ПО	ДублиСтрок.ВидДенежногоДокумента = ТаблицаДенежныеДокументы.ВидДенежногоДокумента
	|		И	ДублиСтрок.ДенежныйДокумент = ТаблицаДенежныеДокументы.ДенежныйДокумент
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаДенежныеДокументы.НомерСтроки
	|ИТОГИ
	|ПО
	|	ТаблицаДенежныеДокументы.ВидДенежногоДокумента,
	|	ТаблицаДенежныеДокументы.ДенежныйДокумент
	|;";	
	
	// Выполняем запрос:
	РезультатПроверки = ЗапросПроверки.Выполнить();
	Если НЕ РезультатПроверки.Пустой() Тогда
		ЕстьОшибкиЗаполнения = Истина;
		ИмяТаблЧастиДляВыводаСообщений = "ДенежныеДокументы";
		Текст = НСтр("ru='Дубли денежных документов (Таблица ""Денежные документы"", строки %1)'");
		
		ДеревоВыборка = РезультатПроверки.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		Для Каждого СтрокаИтогоВидДенежногоДокумента Из ДеревоВыборка.Строки Цикл // Группировки по ВидДенежногоДокумента
			Для Каждого СтрокаИтого Из СтрокаИтогоВидДенежногоДокумента.Строки Цикл // Группировки по ДенежныйДокумент
				ИмяПоляДляВыводаСообщений = ?(ЗначениеЗаполнено(СтрокаИтого["ДенежныйДокумент"]),
					"ДенежныйДокумент",
					"ВидДенежногоДокумента");
				НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
				ИндексСтроки = НомераСтрок[НомераСтрок.Количество() - 1] - 1;
				
				ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
				
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%1");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументОбъект["Ссылка"],
					"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьОшибкиЗаполнения;
	
КонецФункции

Функция ПолучитьТаблицуВидыДокументов() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТаблицаВидыДокументов = Новый ТаблицаЗначений();
	ТаблицаВидыДокументов.Колонки.Добавить("Наименование",		ТипСтрока);
	ТаблицаВидыДокументов.Колонки.Добавить("РазделДокумента",	ТипСтрока);
	ТаблицаВидыДокументов.Колонки.Добавить("ЭтоСписание",		ТипБулево);
	
	// Наличные денежные средства
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "РасходныйКассовыйОрдер";	НС["РазделДокумента"] = "ДС";	НС["ЭтоСписание"] = Истина;
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "ПриходныйКассовыйОрдер";	НС["РазделДокумента"] = "ДС";	НС["ЭтоСписание"] = Ложь;
	
	// Денежные документы
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "РасходныйОрдерФондовый";	НС["РазделДокумента"] = "ДД";	НС["ЭтоСписание"] = Истина;
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "ПриходныйОрдерФондовый";	НС["РазделДокумента"] = "ДД";	НС["ЭтоСписание"] = Ложь;
	
	// БСО
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "СписаниеБСО";				НС["РазделДокумента"] = "БСО";	НС["ЭтоСписание"] = Истина;
	НС = ТаблицаВидыДокументов.Добавить();
	НС["Наименование"] = "ПоступлениеБСО";			НС["РазделДокумента"] = "БСО";	НС["ЭтоСписание"] = Ложь;
	
	Возврат ТаблицаВидыДокументов;
	
КонецФункции

Функция ПолучитьКоличествоДокументовВведенныхНаОсновании(ДокументОбъект, Знач РазделДокумента = Неопределено) Экспорт
	
	Перем РезультатРазделаДокумента;
	
	Результат = Новый Структура();
	
	РезультатРазделаДокументаШаблон = Новый Структура();
	РезультатРазделаДокументаШаблон.Вставить("КоличествоСписаний",		0);
	РезультатРазделаДокументаШаблон.Вставить("КоличествоПоступлений",	0);
	РезультатРазделаДокументаШаблон = Новый ФиксированнаяСтруктура(РезультатРазделаДокументаШаблон);
	
	ДокСсылка = ДокументОбъект["Ссылка"];
	
	Если НЕ ДокСсылка.Пустая() Тогда
		
		ТекстШаблон = "
		|ВЫБРАТЬ [Разрешенные]
		|	КОЛИЧЕСТВО(*)		КАК КоличествоДокументов,
		|	[РазделДокумента]	КАК РазделДокумента,
		|	[ЭтоСписание]		КАК ЭтоСписание
		|ИЗ
		|	Документ.[ВидДокумента]	КАК Док
		|ГДЕ
		|	ДокументОснование = &ДокСсылка";
		
		ТекстОбъединить = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|";
		
		ТаблицыВидыДокументов = ПолучитьТаблицуВидыДокументов();
		
		Если НЕ РазделДокумента = Неопределено Тогда
			Поиск = Новый Структура("РазделДокумента", РазделДокумента);
			ТаблицыВидыДокументов = ТаблицыВидыДокументов.НайтиСтроки(Поиск);
			Если ТаблицыВидыДокументов.Количество() = 0 Тогда
				// Указан недопустимый раздел документа
				
				РезультатРазделаДокумента = Новый Структура(РезультатРазделаДокументаШаблон);
				Результат.Вставить(РазделДокумента, РезультатРазделаДокумента);
				
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
		
		ТекстЗапроса = "";
		
		Для Каждого СтрокаТаблицы Из ТаблицыВидыДокументов Цикл
			ТекстРазрешенные		= ?(ТекстЗапроса = "", "РАЗРЕШЕННЫЕ", "");
			ТекстРазделДокумента	= """" + СтрокаТаблицы["РазделДокумента"] + """";
			ТекстЭтоСписание		= ?(СтрокаТаблицы["ЭтоСписание"], "ИСТИНА", "ЛОЖЬ");
			ТекстВидДокумента		= СтрокаТаблицы["Наименование"];
			
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("Разрешенные",		ТекстРазрешенные);
			ВставляемыеЗначения.Вставить("РазделДокумента",	ТекстРазделДокумента);
			ВставляемыеЗначения.Вставить("ЭтоСписание",		ТекстЭтоСписание);
			ВставляемыеЗначения.Вставить("ВидДокумента",	ТекстВидДокумента);
			
			ТекстЗапроса = ТекстЗапроса
				+ ?(ТекстЗапроса = "", "", ТекстОбъединить)
				+ СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблон, ВставляемыеЗначения);
		КонецЦикла;
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("ДокСсылка", ДокСсылка);
		ЗапросПоиск.Текст = ТекстЗапроса;
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			РазделДокумента	= Выборка["РазделДокумента"];
			ЭтоСписание		= Выборка["ЭтоСписание"];
			
			Результат.Свойство(РазделДокумента, РезультатРазделаДокумента);
			
			Если РезультатРазделаДокумента = Неопределено Тогда
				РезультатРазделаДокумента = Новый Структура(РезультатРазделаДокументаШаблон);
			КонецЕсли;
			
			Если ЭтоСписание Тогда
				РезультатРазделаДокумента["КоличествоСписаний"]		= РезультатРазделаДокумента["КоличествоСписаний"] + Выборка["КоличествоДокументов"];
			Иначе
				РезультатРазделаДокумента["КоличествоПоступлений"]	= РезультатРазделаДокумента["КоличествоПоступлений"] + Выборка["КоличествоДокументов"];
			КонецЕсли;
			
			Результат.Вставить(РазделДокумента, РезультатРазделаДокумента);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСотрудника(МОЛ) Экспорт
	
	Если ТипЗнч(МОЛ) = Тип("СправочникСсылка.Сотрудники") Тогда
		Возврат МОЛ;
		
	ИначеЕсли ТипЗнч(МОЛ) = Тип("СправочникСсылка.ЦМО") Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МОЛ, "Сотрудник");
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Флажок <без ограничения>
Функция ФлажокБезОграничения_ПолучитьНастройкиМеханизма() Экспорт
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяРеквизитаСсылка",	"ИФО");
	НастройкиМеханизма.Вставить("ИмяРеквизитаФлажок",	"БезУчетаИФО");
	
	Возврат НастройкиМеханизма;
	
КонецФункции

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	// Форма 0504086
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504086_стр1_103н,Форма0504086_стр2_103н";
	КомандаПечати.Представление = НСтр("ru='Инв.опись БСО и денежных документов (ф. 0504086) (в ред.103н)'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504086_стр1,Форма0504086_стр2";
	КомандаПечати.Представление = НСтр("ru='Инв.опись БСО и денежных документов (ф. 0504086)'");
	
	// Форма 0504086 (факт.наличие)
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504086_стр1_103н,Форма0504086_стр2_ФактНаличие_103н";
	КомандаПечати.Представление = НСтр("ru='Инв.опись БСО и денежных документов (ф. 0504086) (факт.наличие) (в ред.103н)'");
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "Форма0504086_стр1,Форма0504086_стр2_ФактНаличие";
	КомандаПечати.Представление = НСтр("ru='Инв.опись БСО и денежных документов (ф. 0504086) (факт.наличие)'");
	
	// Форма 0504086 (электронная)
