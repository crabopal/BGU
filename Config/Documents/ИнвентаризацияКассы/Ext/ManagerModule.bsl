	ДокументОбъект["ДенежныеДокументы"].Загрузить(ЗапросЗаполнение.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьТаблицу_ДД_ФактическоеНаличие(ДокументОбъект) Экспорт
	
	ТаблЧасть = ДокументОбъект["ДенежныеДокументы"];
	
	// Для расчета расхождения:
	Расчет = Новый Массив();
	//								<Показатель>	<Результат>
	Расчет.Добавить(Новый Структура("Сумма",		""));
	Расчет.Добавить(Новый Структура("Количество",	""));
	
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЧ["СуммаФакт"]		= СтрокаТЧ["СуммаУчет"];
		СтрокаТЧ["КоличествоФакт"]	= СтрокаТЧ["КоличествоУчет"];
		
		РассчитатьРасхождение(СтрокаТЧ["СуммаФакт"], СтрокаТЧ["СуммаУчет"], СтрокаТЧ["НедостачаСумма"], СтрокаТЧ["ИзлишекСумма"]);
		РассчитатьРасхождение(СтрокаТЧ["КоличествоФакт"], СтрокаТЧ["КоличествоУчет"], СтрокаТЧ["НедостачаКоличество"], СтрокаТЧ["ИзлишекКоличество"]);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьТаблицу_ДД_Расхождение(ДокументОбъект, ЭтоНедостача) Экспорт
	
	Если Документы.ИнвентаризацияКассы.ЕстьОшибкиЗаполненияТаблицыДенежныеДокументы(ДокументОбъект) Тогда
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	// Расхождения, указанные в документе:
	Если ЭтоНедостача Тогда
		ИмяКолонкиСуммы			= "НедостачаСумма";
		ИмяКолонкиКоличества	= "НедостачаКоличество";
		ИмяТаблЧасти			= "ДенежныеДокументыНедостачи";
	Иначе
		ИмяКолонкиСуммы			= "ИзлишекСумма";
		ИмяКолонкиКоличества	= "ИзлишекКоличество";
		ИмяТаблЧасти			= "ДенежныеДокументыИзлишки";
	КонецЕсли;
	Поиск = Новый Структура("Забалансовый", Ложь);
	ТаблицаРасхождения = ДокументОбъект["ДенежныеДокументы"].Выгрузить(Поиск, "ВидДенежногоДокумента,ДенежныйДокумент," + ИмяКолонкиСуммы + "," + ИмяКолонкиКоличества);
	ТаблицаРасхождения.Колонки[ИмяКолонкиСуммы].Имя			= "Сумма";
	ТаблицаРасхождения.Колонки[ИмяКолонкиКоличества].Имя	= "Количество";
	
	// Детальные остатки:
	ЗапросДетальныеОстатки = Документы.ИнвентаризацияКассы.ИнициализироватьЗапрос_ДетальныеОстатки_ДД(ДокументОбъект, Ложь); //УчитыватьСчет08
	ЗапросДетальныеОстатки.Текст = ЗапросДетальныеОстатки.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Детальные остатки
	|//		
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ДетальныеОстатки
	|ГДЕ
	|	СуммаУчет >= 0 И КоличествоУчет >= 0
	|;";
	ТаблицаДетальныеОстатки = ЗапросДетальныеОстатки.Выполнить().Выгрузить();
	ТаблицаДетальныеОстатки.Колонки["СуммаУчет"].Имя		= "Сумма";
	ТаблицаДетальныеОстатки.Колонки["КоличествоУчет"].Имя	= "Количество";
	
	// Получим детальные расхождения:
	КоллекцияИменКолонокСвязи		= Новый Структура("ВидДенежногоДокумента, ДенежныйДокумент");
	КоллекцияИменКолонокПоказателей	= Новый Структура("Сумма, Количество");
	РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаРасхождения,
		ТаблицаДетальныеОстатки,
		КоллекцияИменКолонокСвязи,
		КоллекцияИменКолонокПоказателей,
		"СписанияВТаблице2ВРазмереТаблицы1");
	ТаблицаДетальныеРасхождения = РезультатСравнения["СписанияВТаблице2ВРазмереТаблицы1"];
	
	// Заполняем табл.часть:
	ДокументОбъект[ИмяТаблЧасти].Загрузить(ТаблицаДетальныеРасхождения);
	ДокументОбъект[ИмяТаблЧасти].Сортировать("ВидДенежногоДокумента,ДенежныйДокумент,Подразделение,ИФО,КФО,КПС");
	
	Возврат Истина;
	
КонецФункции

