// ДД

Функция	ИнициализироватьЗапрос_ДетальныеОстатки_ДД(ДокументОбъект, УчитыватьСчет08) Экспорт
	
	// Подготовка:
	Счета = Новый Массив();
	Счета.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.35"));
	Если УчитыватьСчет08 Тогда
		Счета.Добавить(БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("08"));
	КонецЕсли;
	ДатаОпределенияОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации);
	
	СписокЦМО = ПолучитьСписокЦМОДляОтбора(ДокументОбъект);
	
	// Настраиваем запрос:
	ЗапросРезультат = Новый Запрос();
	ЗапросРезультат.УстановитьПараметр("Организация",								ДокументОбъект["Организация"]);
	ЗапросРезультат.УстановитьПараметр("ДатаОстатков",								ДатаОпределенияОстатков);
	ЗапросРезультат.УстановитьПараметр("Счета",										Счета);
	ЗапросРезультат.УстановитьПараметр("ИФО",										ДокументОбъект["ИФО"]);
	ЗапросРезультат.УстановитьПараметр("БезУчетаИФО",								ДокументОбъект["БезУчетаИФО"]);
	ЗапросРезультат.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросРезультат.УстановитьПараметр("ВестиКоличественныйУчетДенежныхДокументов",	ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов"));
	ЗапросРезультат.УстановитьПараметр("Подразделение",								ДокументОбъект["Подразделение"]);
	ЗапросРезультат.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(ДокументОбъект["Подразделение"]));
	ЗапросРезультат.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросРезультат.УстановитьПараметр("СписокЦМО",									СписокЦМО);
	ЗапросРезультат.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Детальные остатки ДД
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто1) = ТИП(Справочник.ВидыДенежныхДокументов) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто1	КАК Справочник.ВидыДенежныхДокументов)
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто2) = ТИП(Справочник.ВидыДенежныхДокументов) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто2	КАК Справочник.ВидыДенежныхДокументов)
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто3) = ТИП(Справочник.ВидыДенежныхДокументов) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто3	КАК Справочник.ВидыДенежныхДокументов)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ВидыДенежныхДокументов.ПустаяСсылка)
	|	КОНЕЦ												КАК ВидДенежногоДокумента,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто1) = ТИП(Справочник.ДенежныеДокументы) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто1	КАК Справочник.ДенежныеДокументы)
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто2) = ТИП(Справочник.ДенежныеДокументы) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто2	КАК Справочник.ДенежныеДокументы)
	|		КОГДА ТИПЗНАЧЕНИЯ(Остатки.Субконто3) = ТИП(Справочник.ДенежныеДокументы) ТОГДА
	|			ВЫРАЗИТЬ(Остатки.Субконто3	КАК Справочник.ДенежныеДокументы)
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка)
	|	КОНЕЦ												КАК ДенежныйДокумент,
	|	Остатки.СуммаОстаток								КАК СуммаУчет,
	|	ВЫБОР
	|		КОГДА &ВестиКоличественныйУчетДенежныхДокументов ТОГДА
	|			Остатки.КоличествоОстаток
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ												КАК КоличествоУчет,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			Остатки.ИФО
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ												КАК ИФО,
	|	Остатки.КФО											КАК КФО,
	|	Остатки.КПС											КАК КПС,
	|	Счет.Забалансовый									КАК Забалансовый,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ												КАК Подразделение
	|ПОМЕСТИТЬ
	|	ДетальныеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков, // 1
	|		Счет В ИЕРАРХИИ(&Счета), // 2
	|		, // 3
	|		Организация = &Организация // 4
	|		// Отбор по ИФО
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО И НЕ &БезУчетаИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто1) = ТИП(Справочник.ЦМО) ТОГДА
	|				ВЫРАЗИТЬ(Субконто1 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто2) = ТИП(Справочник.ЦМО) ТОГДА
	|				ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			КОГДА ТИПЗНАЧЕНИЯ(Субконто3) = ТИП(Справочник.ЦМО) ТОГДА
	|				ВЫРАЗИТЬ(Субконто3 КАК Справочник.ЦМО) В(&СписокЦМО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	) КАК Остатки
	|ГДЕ
	|	// Отбор по подразделению
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|;";
	
	Возврат ЗапросРезультат;
	
КонецФункции

Процедура ЗаполнитьТаблицу_ДД(ДокументОбъект) Экспорт
	
	// Настраиваем запрос:
	ЗапросЗаполнение = ИнициализироватьЗапрос_ДетальныеОстатки_ДД(ДокументОбъект, Истина); //УчитыватьСчет08
	ЗапросЗаполнение.Текст = ЗапросЗаполнение.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Свернутые остатки денежных документов по данным учета
	|//		(Остатки денежных документов по данным учета)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидДенежногоДокумента				КАК ВидДенежногоДокумента,
	|	ДенежныйДокумент					КАК ДенежныйДокумент,
	|	Забалансовый						КАК Забалансовый,
	|	СУММА(СуммаУчет)					КАК СуммаУчет,
	|	СУММА(КоличествоУчет)				КАК КоличествоУчет,
	|	
	|	// Поля для дальнейшего упорядочивания:
	|	ВидДенежногоДокумента.Наименование	КАК ВидДенежногоДокументаПредставление,
	|	ДенежныйДокумент.Наименование		КАК ДенежныйДокументПредставление
	|ПОМЕСТИТЬ
	|	СвернутыеОстатки
	|ИЗ
	|	ДетальныеОстатки
	|СГРУППИРОВАТЬ ПО
	|	ВидДенежногоДокумента,
	|	ДенежныйДокумент,
	|	Забалансовый
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Остатки денежных документов по данным учета (свернутые)
	|//		(Финальная таблица)
	|ВЫБРАТЬ
	|	Забалансовый					КАК Забалансовый,
	|	ВидДенежногоДокумента			КАК ВидДенежногоДокумента,
	|	ДенежныйДокумент				КАК ДенежныйДокумент,
	|	СуммаУчет						КАК СуммаУчет,
	|	КоличествоУчет					КАК КоличествоУчет,
	|	
	|	// Недостача:
	|	ВЫБОР
	|		КОГДА СуммаУчет > 0 ТОГДА
	|			СуммаУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК НедостачаСумма,
	|	ВЫБОР
	|		КОГДА КоличествоУчет > 0 ТОГДА
	|			КоличествоУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК НедостачаКоличество,
	|	
	|	// Излишек:
	|	ВЫБОР
	|		КОГДА СуммаУчет < 0 ТОГДА
	|			-СуммаУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК ИзлишекСумма,
	|	ВЫБОР
	|		КОГДА КоличествоУчет < 0 ТОГДА
	|			-КоличествоУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК ИзлишекКоличество,
	|	
	|	// Служебные поля:
	|	ВЫБОР
	|		КОГДА СуммаУчет < 0 ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК СуммаУчетОтрицательная,
	|	ВЫБОР
	|		КОГДА КоличествоУчет < 0 ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ							КАК КоличествоУчетОтрицательное
	|ИЗ
	|	СвернутыеОстатки
	|УПОРЯДОЧИТЬ ПО
	|	Забалансовый,
	|	ВидДенежногоДокументаПредставление,
	|	ДенежныйДокументПредставление
	|;";
	
