		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Подразделение",			"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
		
	
	//////////////////////////////////////////////////////////////////////////////
	ВидДокумента = "ПоступлениеБСО";
	//
	// Настройки разбивки данных
	//															Реквизит документа-основания			Реквизит нового документа
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Дата",									"Дата");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Организация",							"Организация");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"Ссылка",								"ДокументОснование");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СчетУчетаБСО",							"СчетУчета");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.ЦМО",					"ЦМО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.КФО",					"КФО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.БСО",					"СоставБСО.БСО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.Серия",				"СоставБСО.СерияБСО");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.НачальныйНомер",		"СоставБСО.НомерНачальный");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.КонечныйНомер",		"СоставБСО.НомерКонечный");
	ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,	"СоставБСОИзлишки.Количество",			"СоставБСО.Количество");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"СоставБСОИзлишки.ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьСвязьРеквизитов(СвязиРеквизитов,"СоставБСОИзлишки.Подразделение",		"Подразделение");
	КонецЕсли;
	//
	// Настройки таблицы "Отметки"
	//																		Колонка таблицы			Реквизит шапки нового документа
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"КФО",					"КФО");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"ЦМО",					"ЦМО");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"БСО",					"");
	ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,	"Серия",				"");
	Если ИспользоватьУчетПоИФО Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"ИФО",					"ИФО");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям Тогда
		ВводНаОсновании.ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки,"Подразделение",		"Подразделение");
	КонецЕсли;
	ВводНаОсновании.ДобавитьНастройкиМеханизмаДляВидаДокументов(НастройкиМеханизма, ВидДокумента,
		СвязиРеквизитов,
		ТиповаяОперацияСсылка,
		РеквизитыТиповойОперации,
		КолонкиТаблицыОтметки);
		
		
	//////////////////////////////////////////////////////////////////////////////
	// Общие настройки механизма (для всех видов документов)
	//
