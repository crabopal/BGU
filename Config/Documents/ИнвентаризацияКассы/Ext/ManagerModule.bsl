				СтрокаТЧ["Сумма"]		= Выборка["СуммаФакт"];
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Устанавливаем итоговое значение:
	ЗаполняемыйДокумент["ИтогоУчет"] = ИтогоУчет;
	
	// [5]. Данные для заполнения состава инвентаризационной комиссии.
	ТЗВыборка = РезультатыЗаполнения[5].Выгрузить();
