// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр1_103н") Тогда
		
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр1_103н",
															"ф.0504086, стр.1",
															ПечатьФормы0504086_стр1(МассивОбъектов, ОбъектыПечати, "103н"));
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр1") Тогда
		
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр1",
															"ф.0504086, стр.1",
															ПечатьФормы0504086_стр1(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;
														
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр2_103н") Тогда
		
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		
		ВыводитьФактическоеНаличие = Ложь;
		
		ТабДокумент = ПечатьФормы0504086_стр2(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие, "103н");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр2_103н",
															"ф.0504086, стр.2 и далее",
															ТабДокумент);
	КонецЕсли;														
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504086_103н_Электронная") Тогда
		ВыводитьФактическоеНаличие = Ложь;
		
		ТабДокумент = ПечатьФормы0504086_Электронная(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_103н_Электронная",
															"ф.0504086",
															ТабДокумент);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0504086_ФактНаличие_103н_Электронная") Тогда
		ВыводитьФактическоеНаличие = Истина;
		
		ТабДокумент = ПечатьФормы0504086_Электронная(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_ФактНаличие_103н_Электронная",
															"ф.0504086",
															ТабДокумент);
	КонецЕсли;
	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр2") Тогда
		
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		
		ВыводитьФактическоеНаличие = Ложь;
		
		ТабДокумент = ПечатьФормы0504086_стр2(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр2",
															"ф.0504086, стр.2 и далее",
															ТабДокумент);
	КонецЕсли;														
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр2_ФактНаличие_103н") Тогда
			
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		
		ВыводитьФактическоеНаличие = Истина;
		
		ТабДокумент = ПечатьФормы0504086_стр2(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие, "103н");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр2_ФактНаличие_103н",
															"ф.0504086, стр.2 и далее",
															ТабДокумент);
	КонецЕсли;														
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504086_стр2_ФактНаличие") Тогда
			
		// Устанавливаем признак доступности печати покомплектно.
		ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;
		
		ВыводитьФактическоеНаличие = Истина;
		
		ТабДокумент = ПечатьФормы0504086_стр2(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504086_стр2_ФактНаличие",
															"ф.0504086, стр.2 и далее",
															ТабДокумент);
	КонецЕсли;														
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504088_103н") Тогда
		
		ВыводитьФактическоеНаличие = Ложь;
		
		ТабДокумент = ПечатьФормы0504088(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие, "103н");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504088_103н",
															"ф.0504088",
															ТабДокумент);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504088") Тогда
		
		ВыводитьФактическоеНаличие = Ложь;
		
		ТабДокумент = ПечатьФормы0504088(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"Форма0504088",
															"ф.0504088",
															ТабДокумент);
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Форма0504088_ФактНаличие_103н") Тогда
		
		ВыводитьФактическоеНаличие = Истина;
		
		ТабДокумент = ПечатьФормы0504088(МассивОбъектов, ОбъектыПечати, ВыводитьФактическоеНаличие, "103н");
		
