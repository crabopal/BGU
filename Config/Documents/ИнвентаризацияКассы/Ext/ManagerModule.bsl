Функция ПечатьФормы0504086_стр1(МассивСсылок, ОбъектыПечати, РедакцияПечатнойФормы = Неопределено)
	
	Если РедакцияПечатнойФормы = "103н" Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияКассы.ПФ_MXL_Ф0504086_103н");
		
		КлючПараметровПечати = "ПечатьФормы0504086_стр1_103н";
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияКассы.ПФ_MXL_Ф0504086");
		
		КлючПараметровПечати = "ПечатьФормы0504086_стр1";
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ЗапросПечать = Новый Запрос;
	ЗапросПечать.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Количество строк в табличных частях
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК Ссылка,
	|	СУММА(ДенежныеДокументы)	КАК ДенежныеДокументы,
	|	СУММА(СоставБСО)			КАК СоставБСО
	|ПОМЕСТИТЬ
	|	КоличествоСтрокВТабличныхЧастях
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка			КАК Ссылка,
	|		КОЛИЧЕСТВО(*)	КАК ДенежныеДокументы,
	|		0				КАК СоставБСО
	|	ИЗ
	|		Документ.ИнвентаризацияКассы.ДенежныеДокументы
	|	ГДЕ
	|		Ссылка В (&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Ссылка,
	|		0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Ссылка			КАК Ссылка,
	|		0				КАК ДенежныеДокументы,
	|		КОЛИЧЕСТВО(*)	КАК СоставБСО
	|	ИЗ
	|		Документ.ИнвентаризацияКассы.СоставБСО
	|	ГДЕ
	|		Ссылка В (&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Ссылка,
	|		0
	|	)	КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Шапка документа
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка														КАК ДокСсылка,
	|	Док.Дата														КАК Дата,
	|	Док.ДатаИнвентаризации											КАК ДатаИнвентаризации,
	|	Док.Номер														КАК Номер,
	|	Док.Организация													КАК Организация,
	|	Док.Организация.НаименованиеПолное								КАК НаименованиеОрганизации,
	|	Док.Организация.КодОКПО											КАК КодОКПО,
	|	Док.Подразделение.Представление									КАК Подразделение,
	|	Док.МОЛ															КАК МОЛ,
	|	Док.НомерПриказаИнвентаризации									КАК НомерПриказаИнвентаризации,
	|	Док.ДатаПриказаИнвентаризации									КАК ДатаПриказаИнвентаризации,
	|	Док.МестоИнвентаризации											КАК МестоПроведенияИнвентаризации,
	|	Док.ДатаНачала													КАК ДатаНачала,
	|	Док.ДатаОкончания												КАК ДатаОкончания,
	|	Док.ДолжностьПредседателяКомиссии								КАК ДолжностьПредседателяКомиссии,
	|	Док.ФамилияПредседателяКомиссии									КАК ФамилияПредседателяКомиссии,
	|	Док.ИмяПредседателяКомиссии										КАК ИмяПредседателяКомиссии,
	|	Док.ОтчествоПредседателяКомиссии								КАК ОтчествоПредседателяКомиссии,
	|	Док.ПоследнийРОФ												КАК ПоследнийРОФ,
	|	Док.ПоследнийПОФ												КАК ПоследнийПОФ,
	|	ЕСТЬNULL(КоличествоСтрокВТабличныхЧастях.ДенежныеДокументы, 0)	КАК КоличествоСтрокДенежныеДокументы,
	|	ЕСТЬNULL(КоличествоСтрокВТабличныхЧастях.СоставБСО, 0)			КАК КоличествоСтрокСоставБСО,
	|	Док.ОбъяснениеПричинРасхождений									КАК ОбъяснениеПричинРасхождений,
	|	Док.ЗаключениеКомиссии											КАК ЗаключениеКомиссии,
	|	Док.ДатаПодписиКомиссии											КАК ДатаПодписиКомиссии,
	|	Док.ДатаПодписиМОЛ												КАК ДатаПодписиМОЛ
	|ИЗ
	|	Документ.ИнвентаризацияКассы	КАК Док
	|	ЛЕВОЕ СОЕДИНЕНИЕ	КоличествоСтрокВТабличныхЧастях
	|		ПО	Док.Ссылка = КоличествоСтрокВТабличныхЧастях.Ссылка
	|ГДЕ
	|	Док.Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица инвентаризационной комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии		КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии			КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияКассы.СоставКомиссии	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;";
	
	РезультатПечать = ЗапросПечать.ВыполнитьПакет();
	
	// [1]. Шапка документа
	ВыборкаДокШапка = РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// [2]. Таблица инвентаризационной комиссии
	ВыборкаДокКомиссия = РезультатПечать[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаДокШапка.Следующий() Цикл
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаДокШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ЕстьВыборкаДокКомиссия			= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		
		//---------------------
		// с.1, Титульный лист
		//---------------------
		НомерСтраницы = 1;
		ОбластьТитул				= Макет.ПолучитьОбласть("Титул");
		ОбластьПодписьМОЛ			= Макет.ПолучитьОбласть("ПодписьМОЛ");
		ОбластьКомиссия				= Макет.ПолучитьОбласть("Комиссия");
		ОбластьДатаПодписиКомиссии	= Макет.ПолучитьОбласть("ДатаПодписиКомиссии");
		
		ВыборкаШапка = ВыборкаДокШапка.Выбрать();
		ВыборкаШапка.Следующий();
		
		ОбластьТитул.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьТитул,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,Неопределено, Истина);
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("Дата", ВыборкаШапка["ДатаИнвентаризации"]);
		
		// Вид документа определяется по заполненности табличных частей
		ЕстьДенежныеДокументы	= (ВыборкаШапка["КоличествоСтрокДенежныеДокументы"] > 0);
		ЕстьБСО					= (ВыборкаШапка["КоличествоСтрокСоставБСО"] > 0);
		
		Если ЕстьДенежныеДокументы И ЕстьБСО Тогда
			ВидДокумента = НСтр("ru='Бланки строгой отчетности и денежные документы'");
			
		ИначеЕсли ЕстьБСО Тогда
			ВидДокумента = НСтр("ru='Бланки строгой отчетности'");
			
		ИначеЕсли ЕстьДенежныеДокументы Тогда
			ВидДокумента = НСтр("ru='Денежные документы'");
			
		Иначе
			ВидДокумента = "";
		КонецЕсли;
		
		ЗначенияПараметров.Вставить("ВидДокумента",	ВидДокумента);
		
		// Сведения о МОЛ
		МОЛ				= ПолучитьСотрудника(ВыборкаШапка.МОЛ);
		МОЛДолжность	= "";
		МОЛФИО			= "";
		Если ЗначениеЗаполнено(МОЛ) Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность",
				МОЛ,
				ВыборкаШапка["ДатаИнвентаризации"]);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			МОЛДолжность = ТребуемыеДанные.Должность;
			МОЛФИО       = Корреспонденты.ФИОПоОбъекту(МОЛ, Истина);
		КонецЕсли;
		
		ЗначенияПараметров.Вставить("МОЛДолжность",	МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛФИО",		МОЛФИО);
		
		ОбластьТитул.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластьТитул);
		
		//---
		// Объяснение причин расхождений
		//---
		ОбластьОбъяснениеПричинРасхождений = Печать0504086_ВывестиОбъяснениеПричинРасхождений(ВыборкаШапка.ОбъяснениеПричинРасхождений, Макет);
		ТабДокумент.Вывести(ОбластьОбъяснениеПричинРасхождений);
		
		//---
		// Подпись МОЛ
		//---
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("МОЛДолжность",	МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛФИО",		МОЛФИО);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиМОЛ"]);
		
		ОбластьПодписьМОЛ.Параметры.Заполнить(ЗначенияПараметров);
		ОбластьПодписьМОЛ.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		ТабДокумент.Вывести(ОбластьПодписьМОЛ);
		
		//---
		// Заключение комиссии
		//---
		ОбластьЗаключениеКомиссии = Печать0504086_ВывестиЗаключениеКомиссии(ВыборкаШапка.ЗаключениеКомиссии, Макет);
		ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
		
		//---
		// Инвентаризационная комиссия
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиКомиссии"]);
		
		ОбластьДатаПодписиКомиссии.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		ТабДокумент.Вывести(ОбластьДатаПодписиКомиссии);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаДокШапка.ДокСсылка);
		
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьФормы0504086_стр2(МассивСсылок, ОбъектыПечати, ВыводитьФактическоеНаличие, РедакцияПечатнойФормы = Неопределено)
	
	Если РедакцияПечатнойФормы = "103н" Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияКассы.ПФ_MXL_Ф0504086_103н");
		
		КлючПараметровПечати = "ПечатьФормы0504086_стр2_103н";
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИнвентаризацияКассы.ПФ_MXL_Ф0504086");
		
		КлючПараметровПечати = "ПечатьФормы0504086_стр2";
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ЗапросПечать = Новый Запрос;
	ЗапросПечать.УстановитьПараметр("МассивСсылок",					МассивСсылок);
	ЗапросПечать.УстановитьПараметр("ВестиКоличественныйУчетДД",	ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов"));
	ЗапросПечать.УстановитьПараметр("ЕдИзмШт",						Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	ЗапросПечать.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
