	|			ДенежныйДокумент.НомСтоимость
	|		КОГДА КоличествоФакт <> 0 ТОГДА
	|			ВЫРАЗИТЬ(СуммаФакт/КоличествоФакт КАК ЧИСЛО(15,2))
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ								КАК Цена,
	|	ВЫБОР
	|		КОГДА ДенежныйДокумент <> ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка) ТОГДА
	|			ДенежныйДокумент.ЕдиницаИзмерения
	|		ИНАЧЕ
	|			&ЕдИзмШт
	|	КОНЕЦ								КАК ЕдИзм,
	|	ДенежныйДокумент.Серия				КАК Серия,
	|	ДенежныйДокумент.Номер				КАК НомерФакт,
	|	ДенежныйДокумент.Номер				КАК НомерУчет,
	|	
	| 	ВЫБОР
	| 		КОГДА Ссылка.ГруппироватьПоБСО ТОГДА
	| 			ДенежныйДокумент
	| 		ИНАЧЕ
	| 			ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	| 	КОНЕЦ								КАК ДенежныйДокументДляГруппировки,
	| 	ВЫБОР
	| 		КОГДА Ссылка.ГруппироватьПоБСО ТОГДА
	| 			ДенежныйДокумент.Серия
	| 		ИНАЧЕ
	| 			ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка)
	| 	КОНЕЦ								КАК СерияДляГруппировки,
	| 	
	|	0									КАК НомерНачальныйУчетБСО,
	|	0									КАК НомерКонечныйУчетБСО,
	|	0									КАК НомерНачальныйФактБСО,
	|	0									КАК НомерКонечныйФактБСО,
	|	0									КАК ДлинаНомераБСО,
	|	
	|	СуммаУчет							КАК СуммаУчет,
	|	СуммаФакт							КАК СуммаФакт,
	|	ВЫБОР
	|		КОГДА НедостачаКоличество = 0 И НедостачаСумма = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			ДенежныйДокумент.НомСтоимость
	|	КОНЕЦ								КАК НедостачаЦена,
	|	НедостачаСумма						КАК НедостачаСумма,
	|	ВЫБОР
	|		КОГДА ИзлишекКоличество = 0 И ИзлишекСумма = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			ДенежныйДокумент.НомСтоимость
	|	КОНЕЦ								КАК ИзлишекЦена,
	|	ИзлишекСумма						КАК ИзлишекСумма
	|ИЗ
	|	Документ.ИнвентаризацияКассы.ДенежныеДокументы	КАК ТЧ
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Выбираем БСО (БСО учитываются по условной цене 1 руб.):
	|ВЫБРАТЬ
	|	Ссылка								КАК ДокСсылка,
	|	2									КАК НомерТаблЧасти,
	|	НомерСтроки							КАК Номерстроки,
	|	КоличествоУчет						КАК КоличествоУчет,
	|	КоличествоФакт						КАК КоличествоФакт,
	|	Недостача							КАК НедостачаКоличество,
	|	Излишек								КАК ИзлишекКоличество,
	|	
	|	БСО									КАК ДенежныйДокумент,
	|	БСО.Код								КАК Код,
	|	1									КАК Цена,
	|	БСО.ЕдиницаИзмерения				КАК ЕдИзм,
	|	Серия								КАК Серия,
	|	0									КАК НомерФакт,
	|	0									КАК НомерУчет,
	| 	
	| 	ВЫБОР
	| 		КОГДА Ссылка.ГруппироватьПоБСО ТОГДА
	| 			БСО
	| 		ИНАЧЕ
	| 			ЗНАЧЕНИЕ(Справочник.БСО.ПустаяСсылка)
	| 	КОНЕЦ								КАК ДенежныйДокументДляГруппировки,
	| 	ВЫБОР
	| 		КОГДА Ссылка.ГруппироватьПоБСО ТОГДА
	| 			Серия
	| 		ИНАЧЕ
	| 			ЗНАЧЕНИЕ(Справочник.СерииБСО.ПустаяСсылка)
	| 	КОНЕЦ								КАК СерияДляГруппировки,
	|	
	|	НачальныйНомерУчет					КАК НомерНачальныйУчетБСО,
	|	КонечныйНомерУчет					КАК НомерКонечныйУчетБСО,
	|	НачальныйНомерФакт					КАК НомерНачальныйФактБСО,
	|	КонечныйНомерФакт					КАК НомерКонечныйФактБСО,
	|	БСО.ДлинаНомера						КАК ДлинаНомераБСО,
	|
	|	КоличествоУчет						КАК СуммаУчет,
	|	КоличествоФакт						КАК СуммаФакт,
	|	ВЫБОР
	|		КОГДА Недостача = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ								КАК НедостачаЦена,
	|	Недостача							КАК НедостачаСумма,
	|	ВЫБОР
	|		КОГДА Излишек = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ								КАК ИзлишекЦена,
	|	Излишек								КАК ИзлишекСумма
	|ИЗ
	|	Документ.ИнвентаризацияКассы.СоставБСО	КАК ТЧ
	|ГДЕ
	|	Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерТаблЧасти,
	|	НомерСтроки
	|ИТОГИ
	|	МАКСИМУМ(НомерТаблЧасти)				КАК НомерТаблЧасти,
	|	
	|	ДенежныйДокументДляГруппировки			КАК ДенежныйДокумент,
	|	СерияДляГруппировки						КАК Серия,
	|	
	|	ЕСТЬNULL(СУММА(КоличествоУчет), 0)		КАК КоличествоУчет,
	|	ЕСТЬNULL(СУММА(КоличествоФакт), 0)		КАК КоличествоФакт,
	|	ЕСТЬNULL(СУММА(НедостачаКоличество), 0)	КАК НедостачаКоличество,
	|	ЕСТЬNULL(СУММА(ИзлишекКоличество), 0)	КАК ИзлишекКоличество,
	|	
	|	ЕСТЬNULL(СУММА(СуммаУчет), 0)			КАК СуммаУчет,
	|	ЕСТЬNULL(СУММА(СуммаФакт), 0)			КАК СуммаФакт,
	|	ЕСТЬNULL(СУММА(НедостачаСумма), 0)		КАК НедостачаСумма,
	|	ЕСТЬNULL(СУММА(ИзлишекСумма), 0)		КАК ИзлишекСумма
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	| 	Ссылка,
	| 	ДенежныйДокументДляГруппировки,
	| 	СерияДляГруппировки
	|;";
	
	РезультатПечать = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаДокШапка		= РезультатПечать[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокДанные	= РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Области = Новый Структура();
	Области.Вставить("НомерСтраницы",				Макет.ПолучитьОбласть("НомерСтраницы"));
	Области.Вставить("Шапка",						Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("Строка",						Макет.ПолучитьОбласть("Строка"));
	Области.Вставить("СтрокаГруппировкаБСО",		Макет.ПолучитьОбласть("СтрокаГруппировкаБСО"));
	Области.Вставить("СтрокаГруппировкаСерияБСО",	Макет.ПолучитьОбласть("СтрокаГруппировкаСерияБСО"));
	Области.Вставить("ИтогоПоСтраницеЧислами",		Макет.ПолучитьОбласть("ИтогоПоСтраницеЧислами"));
	Области.Вставить("ИтогоПоСтраницеПрописью",		Макет.ПолучитьОбласть("ИтогоПоСтраницеПрописью"));
	Области.Вставить("ИтогоПоОписиЧислами",			Макет.ПолучитьОбласть("ИтогоПоОписиЧислами"));
	Области.Вставить("ИтогоПоОписиПрописью",		Макет.ПолучитьОбласть("ИтогоПоОписиПрописью"));
	
	ПроверкиВывода = Печать0504086_ИнициализироватьПроверкиВывода(Области);
	
	ИменаПолей = Печать0504086_ПолучитьИменаПолей();
	
	ОчищающаяСтруктураСтроки = Печать0504086_ПолучитьОчищающуюСтруктуруСтрокиТаблицы(ИменаПолей);
	
	ОчищающаяСтруктураИтоговПрописью = Печать0504086_ПолучитьОчищающуюСтруктуруИтоговПрописью();
	
	ПараметрыРасчетаИтогов = Новый Структура();
	ПараметрыРасчетаИтогов.Вставить("ВыводитьФактическоеНаличие",		ВыводитьФактическоеНаличие);
	ПараметрыРасчетаИтогов.Вставить("ОчищающаяСтруктураСтроки",			ОчищающаяСтруктураСтроки);
	ПараметрыРасчетаИтогов.Вставить("ОчищающаяСтруктураИтоговПрописью",	ОчищающаяСтруктураИтоговПрописью);
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокШапка.Следующий() Цикл
		
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаДокШапка["ДокСсылка"]);
		
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокДанные = ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокДанные = ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтраницы = 1;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		//---
		// Итого по описи (заполняем, не выводим)
		//---
		
		ИтогиПоОписи = Печать0504086_ПолучитьПустыеИтогиПоСтранице();
		
		КоличествоДетальныхСтрок = Печать0504086_ПолучитьКоличествоДетальныхСтрок(ВыборкаДокДанные);
		
		Если КоличествоДетальныхСтрок > 0 Тогда
			ЗаполнитьЗначенияСвойств(ИтогиПоОписи, ВыборкаДокДанные);
			
			ИтогиПоОписи.Вставить("КоличествоСтрок", КоличествоДетальныхСтрок);
		КонецЕсли;
		
		Печать0504086_ЗаполнитьОбластиИтогов(Области, ИтогиПоОписи, ПараметрыРасчетаИтогов, "ПоОписи");
		
		НачатьСтраницуТабличногоДокумента(ТабДокумент, Области["НомерСтраницы"], Области["Шапка"], НомерСтраницы);
		
		ТребуетсяВывестиСтрокуГруппировки = Новый Структура();
		ТребуетсяВывестиСтрокуГруппировки.Вставить("ДенежныйДокумент", Ложь);
		ТребуетсяВывестиСтрокуГруппировки.Вставить("Серия", Ложь);
		
		НПП = 0;
		
		ИтогиПоСтранице = Печать0504086_ПолучитьПустыеИтогиПоСтранице();
		
		Если ЕстьВыборкаДокДанные Тогда
			
			ИтогиПоСтраницеДляПроверкиВывода = Печать0504086_ПолучитьПустыеИтогиПоСтранице();
			
			ВыборкаДенежныйДокумент = ВыборкаДокДанные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаДенежныйДокумент.Следующий() Цикл
				
				ВыводитьСтрокиГруппировок = (ВыборкаДенежныйДокумент["НомерТаблЧасти"] = 2 И ВыборкаДокШапка["ГруппироватьПоБСО"]);

				Если ВыводитьСтрокиГруппировок Тогда
					//---
					// Группировка по БСО (заполняем, не выводим)
					//---
					
					Области["СтрокаГруппировкаБСО"].Параметры.Заполнить(ВыборкаДенежныйДокумент);
					
					Номер = "";
					
					Печать0504086_НастроитьСериюНомерЦену(
						ВыборкаДенежныйДокумент,
						Номер,
						Области["СтрокаГруппировкаБСО"].Параметры,
						ИменаПолей);
					
					Если НЕ ВыводитьФактическоеНаличие Тогда
						Области["СтрокаГруппировкаБСО"].Параметры.Заполнить(ОчищающаяСтруктураСтроки);
					КонецЕсли;
					
					ТребуетсяВывестиСтрокуГруппировки.Вставить("ДенежныйДокумент", Истина);
				КонецЕсли;
				
				ВыборкаСерия = ВыборкаДенежныйДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаСерия.Следующий() Цикл
					
					Если ВыводитьСтрокиГруппировок Тогда
						//---
						// Группировка по серии БСО (заполняем, не выводим)
						//---
						
						Области["СтрокаГруппировкаСерияБСО"].Параметры.Заполнить(ВыборкаСерия);
						
						Номер = "";
						
						Печать0504086_НастроитьСериюНомерЦену(
							ВыборкаСерия,
							Номер,
							Области["СтрокаГруппировкаСерияБСО"].Параметры,
							ИменаПолей);
						
						Если НЕ ВыводитьФактическоеНаличие Тогда
							Области["СтрокаГруппировкаСерияБСО"].Параметры.Заполнить(ОчищающаяСтруктураСтроки);
						КонецЕсли;
						
						ТребуетсяВывестиСтрокуГруппировки.Вставить("Серия", Истина);
					КонецЕсли;
					
					Выборка = ВыборкаСерия.Выбрать();
					
					ЭтоПерваяДетальнаяСтрокаГруппировки = Истина;
					
					Пока Выборка.Следующий() Цикл
						//---
						// Строка (заполняем, не выводим)
						//---
						
						НПП = НПП + 1;
						
						ЭтоПоследняяСтрока = (НПП = КоличествоДетальныхСтрок);
						
						ЗначенияПараметров = Новый Структура("НПП", НПП);
						
						Номер = Выборка["НомерУчет"];
						
						// Для БСО графы "Номер" заполняем как диапазон номеров
						Если ВыборкаДенежныйДокумент["НомерТаблЧасти"] = 2 Тогда
							Параметр_ДлинаПредставления = Выборка["ДлинаНомераБСО"];
							
							Параметр_НомерНачальныйУчет = Выборка["НомерНачальныйУчетБСО"];
							Параметр_НомерКонечныйУчет = Выборка["НомерКонечныйУчетБСО"];
							Параметр_НомерНачальныйФакт = Выборка["НомерНачальныйФактБСО"];
							Параметр_НомерКонечныйФакт = Выборка["НомерКонечныйФактБСО"];
							
							Если Параметр_НомерНачальныйУчет > 0 И Параметр_НомерКонечныйУчет > 0 Тогда
								Если Параметр_НомерНачальныйУчет = Параметр_НомерКонечныйУчет Тогда
									Номер = ПолучитьПредставлениеНомераБСО(Параметр_НомерНачальныйУчет, Параметр_ДлинаПредставления);
								Иначе
									Номер = ПолучитьПредставлениеНомераБСО(Параметр_НомерНачальныйУчет, Параметр_ДлинаПредставления)
										+ "-"
										+ ПолучитьПредставлениеНомераБСО(Параметр_НомерКонечныйУчет, Параметр_ДлинаПредставления);
								КонецЕсли;
								
								ЗначенияПараметров.Вставить("НомерУчет", Номер);
							КонецЕсли;
							
							Если Параметр_НомерНачальныйФакт > 0 И Параметр_НомерКонечныйФакт > 0 Тогда
								Если Параметр_НомерНачальныйФакт = Параметр_НомерКонечныйФакт Тогда
									Номер = ПолучитьПредставлениеНомераБСО(Параметр_НомерНачальныйФакт, Параметр_ДлинаПредставления);
								Иначе
									Номер = ПолучитьПредставлениеНомераБСО(Параметр_НомерНачальныйФакт, Параметр_ДлинаПредставления)
										+ "-"
										+ ПолучитьПредставлениеНомераБСО(Параметр_НомерКонечныйФакт, Параметр_ДлинаПредставления);
								КонецЕсли;
								
								ЗначенияПараметров.Вставить("НомерФакт", Номер);
							КонецЕсли;
						КонецЕсли;
						
						Области["Строка"].Параметры.Заполнить(Выборка);
						Области["Строка"].Параметры.Заполнить(ЗначенияПараметров);
						
						Печать0504086_НастроитьСериюНомерЦену(
							Выборка,
							Номер,
							Области["Строка"].Параметры,
							ИменаПолей);
						
						Если НЕ ВыводитьФактическоеНаличие Тогда
							Области["Строка"].Параметры.Заполнить(ОчищающаяСтруктураСтроки);
						КонецЕсли;
						
						//---
						// Итого по странице (заполняем, не выводим)
						//---
						Печать0504086_УвеличитьИтогиПоСтранице(ИтогиПоСтраницеДляПроверкиВывода, Выборка);
						
						Печать0504086_ЗаполнитьОбластиИтогов(Области, ИтогиПоСтраницеДляПроверкиВывода, ПараметрыРасчетаИтогов, "ПоСтранице");
						
						// Проверка вывода
						
						Если ТребуетсяВывестиСтрокуГруппировки["ДенежныйДокумент"] Тогда
							ИмяКлючаГруппировка = "КоличествоГруппировок2";
							
						ИначеЕсли ТребуетсяВывестиСтрокуГруппировки["Серия"] Тогда
							ИмяКлючаГруппировка = "КоличествоГруппировок1";
							
						Иначе
							ИмяКлючаГруппировка = "КоличествоГруппировок0";
						КонецЕсли;
						
						ИмяКлючаСтрока = ?(ЭтоПоследняяСтрока, "ПоследняяСтрока", "ОчереднаяСтрока");
						
						ПроверкаВывода = ПроверкиВывода[ИмяКлючаГруппировка][ИмяКлючаСтрока];
						
						Печать0504086_ОбновитьЗаполняемыеОбластиПроверкиВывода(ПроверкаВывода, Области);
						
						Если НЕ ТабДокумент.ПроверитьВывод(ПроверкаВывода.МассивОбластей) Тогда
							//---
							// Итого по странице
							//---
							Печать0504086_ЗаполнитьОбластиИтогов(Области, ИтогиПоСтранице, ПараметрыРасчетаИтогов, "ПоСтранице");
							
							ТабДокумент.Вывести(Области["ИтогоПоСтраницеЧислами"]);
							
							ТабДокумент.Вывести(Области["ИтогоПоСтраницеПрописью"]);
							
							ИтогиПоСтранице = Печать0504086_ПолучитьПустыеИтогиПоСтранице();
							
							НачатьСтраницуТабличногоДокумента(ТабДокумент, Области["НомерСтраницы"], Области["Шапка"], НомерСтраницы);
						КонецЕсли;
						
						//---
						// Группировки
						//---
						
						Если ЭтоПерваяДетальнаяСтрокаГруппировки Тогда
							ЭтоПерваяДетальнаяСтрокаГруппировки = Ложь;
							
							Если ТребуетсяВывестиСтрокуГруппировки["ДенежныйДокумент"] Тогда
								ТребуетсяВывестиСтрокуГруппировки.Вставить("ДенежныйДокумент", Ложь);
								
								ТабДокумент.Вывести(Области["СтрокаГруппировкаБСО"]);
								
								ТабДокумент.НачатьГруппуСтрок();
							КонецЕсли;
							
							Если ТребуетсяВывестиСтрокуГруппировки["Серия"] Тогда
								ТребуетсяВывестиСтрокуГруппировки.Вставить("Серия", Ложь);
								
								ТабДокумент.Вывести(Области["СтрокаГруппировкаСерияБСО"]);
								
								ТабДокумент.НачатьГруппуСтрок();
							КонецЕсли;
						КонецЕсли;
						
						//---
						// Строка
						//---
						
						ТабДокумент.Вывести(Области["Строка"]);
						
						Печать0504086_УвеличитьИтогиПоСтранице(ИтогиПоСтранице, Выборка);
					КонецЦикла;
					
					Если ВыводитьСтрокиГруппировок Тогда
						ТабДокумент.ЗакончитьГруппуСтрок();
					КонецЕсли;
					
				КонецЦикла;
				
				Если ВыводитьСтрокиГруппировок Тогда
					ТабДокумент.ЗакончитьГруппуСтрок();
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЕсли;
		
		//---
		// Итого по описи
		//---
		Печать0504086_ЗаполнитьОбластиИтогов(Области, ИтогиПоСтранице, ПараметрыРасчетаИтогов, "ПоСтранице");
		
		ТабДокумент.Вывести(Области["ИтогоПоСтраницеЧислами"]);
		
		ТабДокумент.Вывести(Области["ИтогоПоОписиЧислами"]);
		
		ТабДокумент.Вывести(Области["ИтогоПоСтраницеПрописью"]);
		
		ТабДокумент.Вывести(Области["ИтогоПоОписиПрописью"]);
		
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаДокШапка.ДокСсылка);
		
	КонецЦикла;
	
	ТабДокумент.АвтоМасштаб = Истина;
	Возврат ТабДокумент;
	
КонецФункции

Функция ПечатьФормы0504086_Электронная(МассивСсылок, ОбъектыПечати, ВыводитьФактическоеНаличие)
	
	РедакцияПечатнойФормы = "103н";
	
	ТабДокумент = ПечатьФормы0504086_стр1(МассивСсылок, ОбъектыПечати, РедакцияПечатнойФормы);
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабДокумент2 = ПечатьФормы0504086_стр2(МассивСсылок, ОбъектыПечати, ВыводитьФактическоеНаличие, РедакцияПечатнойФормы);
	
	ТабДокумент.Вывести(ТабДокумент2);
	
	Возврат ТабДокумент;
	
КонецФункции

Функция Печать0504086_ПолучитьИменаПолей()
	
	ИменаПолейУчет = Новый Структура();
	ИменаПолейУчет.Вставить("Серия",		"СерияУчет");
	ИменаПолейУчет.Вставить("Номер",		"НомерУчет");
	ИменаПолейУчет.Вставить("Цена",			"ЦенаУчет");
	ИменаПолейУчет.Вставить("Количество",	"КоличествоУчет");
	ИменаПолейУчет.Вставить("Сумма",		"СуммаУчет");
	
	ИменаПолейФакт = Новый Структура();
	ИменаПолейФакт.Вставить("Серия",		"СерияФакт");
	ИменаПолейФакт.Вставить("Номер",		"НомерФакт");
	ИменаПолейФакт.Вставить("Цена",			"ЦенаФакт");
	ИменаПолейФакт.Вставить("Количество",	"КоличествоФакт");
	ИменаПолейФакт.Вставить("Сумма",		"СуммаФакт");
	
	ИменаПолейНедостача = Новый Структура();
	ИменаПолейНедостача.Вставить("Серия",		"НедостачаСерия");
	ИменаПолейНедостача.Вставить("Номер",		"НедостачаНомер");
	ИменаПолейНедостача.Вставить("Цена",		"НедостачаЦена");
	ИменаПолейНедостача.Вставить("Количество",	"НедостачаКоличество");
	ИменаПолейНедостача.Вставить("Сумма",		"НедостачаСумма");
	
	ИменаПолейИзлишек = Новый Структура();
	ИменаПолейИзлишек.Вставить("Серия",			"ИзлишекСерия");
	ИменаПолейИзлишек.Вставить("Номер",			"ИзлишекНомер");
	ИменаПолейИзлишек.Вставить("Цена",			"ИзлишекЦена");
	ИменаПолейИзлишек.Вставить("Количество",	"ИзлишекКоличество");
	ИменаПолейИзлишек.Вставить("Сумма",			"ИзлишекСумма");
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("Учет",			ИменаПолейУчет);
	ИменаПолей.Вставить("Факт",			ИменаПолейФакт);
	ИменаПолей.Вставить("Недостача",	ИменаПолейНедостача);
	ИменаПолей.Вставить("Излишек",		ИменаПолейИзлишек);
	
	Возврат Новый ФиксированнаяСтруктура(ИменаПолей);
	
КонецФункции

Функция Печать0504086_ПолучитьОчищающуюСтруктуруСтрокиТаблицы(ИменаПолей)
	
	// Исключаем вывод символа прочерка "-" путем указания пустой строки.
	// Применяется для показателей фактического наличия и расхождений.
	
	ОчищающаяСтруктура = Новый Структура();
	
	Для Каждого ЭлементИмена Из ИменаПолей Цикл
		
		БлокПоказателей = ЭлементИмена.Ключ;
		
		Если БлокПоказателей = "Учет" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЭлементИмя Из ЭлементИмена.Значение Цикл
			ИмяПоля = ЭлементИмя.Значение;
			
			ОчищающаяСтруктура.Вставить(ИмяПоля, "");
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Функция Печать0504086_ПолучитьОчищающуюСтруктуруИтоговПрописью()
	
	// Исключаем вывод символа итогов прописью путем указания пустой строки.
	// Применяется для показателей фактического наличия.
	
	ОчищающаяСтруктура = Новый Структура();
	
	ОчищающаяСтруктура.Вставить("КоличествоЕдиницФактически", "");
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Процедура Печать0504086_НастроитьСериюНомерЦену(Выборка, Номер, ПараметрыОбласти, ИменаПолей)
	
	// Есть заполненные показатели - есть Серия, Номер, Цена.
	// Нет заполненных показателей - также не выводим и Серию, Номер, Цену.
	
	// Эти поля заполнены прямо из табличной части
	
	Серия = Выборка["Серия"];
	Цена = Выборка["Цена"];
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого Элемент Из ИменаПолей Цикл
		
		БлокПоказателей = Элемент.Ключ;
		
		Поля = Элемент.Значение;
		
		ПроверкаПоказателей = Новый Структура(Поля["Количество"] + "," + Поля["Сумма"]);
		
		ЗаполнитьЗначенияСвойств(ПроверкаПоказателей, ПараметрыОбласти);
		
		ПоказателиПустые = (
			НЕ ЗначениеЗаполнено(ПроверкаПоказателей[Поля["Количество"]])
			И НЕ ЗначениеЗаполнено(ПроверкаПоказателей[Поля["Сумма"]])
		);
		
		Если ПоказателиПустые Тогда
			// Обнуляем поля Серия, Номер, Цена.
			// Это должно привести к простановке прочерков.
			
			ЗначениеСерия	= 0;
			ЗначениеНомер	= 0;
			ЗначениеЦена	= 0;
			
		Иначе
			// Устанавливаем значения
			
			ЗначениеСерия	= ?(ЗначениеЗаполнено(Серия), Серия, 0);
			ЗначениеНомер	= ?(ЗначениеЗаполнено(Номер), Номер, 0);
			ЗначениеЦена	= Цена;
		КонецЕсли;
		
		ЗначенияПараметров.Вставить(Поля["Серия"],	ЗначениеСерия);
		ЗначенияПараметров.Вставить(Поля["Номер"],	ЗначениеНомер);
		ЗначенияПараметров.Вставить(Поля["Цена"],	ЗначениеЦена);
		
		ЗаполнитьЗначенияСвойств(ПараметрыОбласти, ЗначенияПараметров);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Печать0504086_ЗаполнитьОбластиИтогов(Области, Итоги, ПараметрыРасчетаИтогов, ВидИтогов)
	
	ИмяОбластиЧислами = "Итого" + ВидИтогов + "Числами";
	ИмяОбластиПрописью = "Итого" + ВидИтогов + "Прописью";
	
	Области[ИмяОбластиЧислами].Параметры.Заполнить(Итоги);
	
	ИтогиПрописью = Печать0504086_ПолучитьИтогиПрописью(Итоги);
	
	Области[ИмяОбластиПрописью].Параметры.Заполнить(ИтогиПрописью);
	
	Если НЕ ПараметрыРасчетаИтогов["ВыводитьФактическоеНаличие"] Тогда
		Области[ИмяОбластиЧислами].Параметры.Заполнить(ПараметрыРасчетаИтогов["ОчищающаяСтруктураСтроки"]);
		
		Области[ИмяОбластиПрописью].Параметры.Заполнить(ПараметрыРасчетаИтогов["ОчищающаяСтруктураИтоговПрописью"]);
	КонецЕсли;
	
КонецПроцедуры

Функция Печать0504086_ПолучитьПустыеИтогиПоСтранице()
	
	Результат = Новый Структура();
	
	Результат.Вставить("СуммаУчет",			0);
	Результат.Вставить("СуммаФакт",			0);
	Результат.Вставить("НедостачаСумма",	0);
	Результат.Вставить("ИзлишекСумма",		0);
	
	Результат.Вставить("КоличествоУчет",		0);
	Результат.Вставить("КоличествоФакт",		0);
	Результат.Вставить("НедостачаКоличество",	0);
	Результат.Вставить("ИзлишекКоличество",		0);
	
	Результат.Вставить("КоличествоСтрок",		0);
	
	Возврат Результат;
	
КонецФункции

Функция Печать0504086_УвеличитьИтогиПоСтранице(ИтогиПоСтранице, Выборка)
	
	ИтогиПоСтранице["СуммаУчет"]		= ИтогиПоСтранице["СуммаУчет"]		+ Выборка["СуммаУчет"];
	ИтогиПоСтранице["СуммаФакт"]		= ИтогиПоСтранице["СуммаФакт"]		+ Выборка["СуммаФакт"];
	ИтогиПоСтранице["НедостачаСумма"]	= ИтогиПоСтранице["НедостачаСумма"]	+ Выборка["НедостачаСумма"];
	ИтогиПоСтранице["ИзлишекСумма"]		= ИтогиПоСтранице["ИзлишекСумма"]	+ Выборка["ИзлишекСумма"];
	
	ИтогиПоСтранице["КоличествоУчет"]		= ИтогиПоСтранице["КоличествоУчет"]			+ Выборка["КоличествоУчет"];
	ИтогиПоСтранице["КоличествоФакт"]		= ИтогиПоСтранице["КоличествоФакт"]			+ Выборка["КоличествоФакт"];
	ИтогиПоСтранице["НедостачаКоличество"]	= ИтогиПоСтранице["НедостачаКоличество"]	+ Выборка["НедостачаКоличество"];
	ИтогиПоСтранице["ИзлишекКоличество"]	= ИтогиПоСтранице["ИзлишекКоличество"]		+ Выборка["ИзлишекКоличество"];
	
	ИтогиПоСтранице["КоличествоСтрок"] = ИтогиПоСтранице["КоличествоСтрок"] + 1;
	
КонецФункции

Функция Печать0504086_ПолучитьКоличествоДетальныхСтрок(ВыборкаДокДанные)
	
	Счетчик = 0;
	
	ВыборкаДенежныйДокумент = ВыборкаДокДанные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДенежныйДокумент.Следующий() Цикл
		
		ВыборкаСерия = ВыборкаДенежныйДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСерия.Следующий() Цикл
			
			Выборка = ВыборкаСерия.Выбрать();
			
			Счетчик = Счетчик + Выборка.Количество();
			
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат Счетчик;
	
КонецФункции

Функция Печать0504086_ИнициализироватьПроверкиВывода(Области)
	
