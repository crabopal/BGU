Функция ИнициализироватьЗапрос_ДетальныеОстатки_ДС(ДокументОбъект) Экспорт
	
	ДатаОпределенияОстатков = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ДокументОбъект.ДатаИнвентаризации);
	
	ЗапросРезультат = Новый Запрос();
	ЗапросРезультат.УстановитьПараметр("Организация",								ДокументОбъект["Организация"]);
	ЗапросРезультат.УстановитьПараметр("ДатаОстатков",								ДатаОпределенияОстатков);
	ЗапросРезультат.УстановитьПараметр("ЗабСчетКассы",								БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("НД"));
	ЗапросРезультат.УстановитьПараметр("ИФО",										ДокументОбъект["ИФО"]);
	ЗапросРезультат.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросРезультат.УстановитьПараметр("БезУчетаИФО",								ДокументОбъект["БезУчетаИФО"]);
	ЗапросРезультат.УстановитьПараметр("ВалютаРУ",									Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросРезультат.УстановитьПараметр("ИспользоватьВалютныйУчет",					ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросРезультат.УстановитьПараметр("Подразделение",								ДокументОбъект["Подразделение"]);
	ЗапросРезультат.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(ДокументОбъект["Подразделение"]));
	ЗапросРезультат.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросРезультат.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Детальные остатки.
	|//		(Остатки денежной кассы по данным учета)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет И НЕ Остатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			Остатки.Валюта
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ											КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет И НЕ Остатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ
	|			Остатки.СуммаОстаток
	|	КОНЕЦ											КАК СуммаУчет,
	|	Остатки.КФО										КАК КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			Остатки.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ											КАК ИФО,
	|	Остатки.КПС										КАК КПС,
	|	Остатки.КЭК										КАК КЭК,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ											КАК Подразделение
	|ПОМЕСТИТЬ
	|	ДетальныеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков, // 1
	|		Счет В ИЕРАРХИИ(&ЗабСчетКассы), // 2
	|		, // 3
	|		Организация = &Организация // 4
	|		// Отбор по ИФО:
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО И НЕ &БезУчетаИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)	КАК Остатки
	|ГДЕ
	|	// Отбор по подразделению:
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И Счет.УчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|;
	|";
	
	Возврат ЗапросРезультат;
	
КонецФункции

Процедура ЗаполнитьТаблицу_ДС(ДокументОбъект) Экспорт
	
	ТаблицаОстатков = ПолучитьТаблицуОстатков_ДС(ДокументОбъект);
	
	ДокументОбъект["ДенежныеСредства"].Загрузить(ТаблицаОстатков);
	
КонецПроцедуры

Функция ПолучитьТаблицуОстатков_ДС(ДокументОбъект) Экспорт
	
	ЗапросЗаполнение = ИнициализироватьЗапрос_ДетальныеОстатки_ДС(ДокументОбъект);
	ЗапросЗаполнение.Текст = ЗапросЗаполнение.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Расчет недостач и излишков.
	|//		(Остатки денежной кассы по данным учета)
	|ВЫБРАТЬ
	|	Валюта								КАК Валюта,
	|	СуммаУчет							КАК СуммаУчет,
	|	ВЫБОР
	|		КОГДА СуммаУчет < 0 ТОГДА
	|			1
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ								КАК СуммаУчетОтрицательная,
	|	ВЫБОР
	|		КОГДА СуммаУчет >= 0 ТОГДА
	|			СуммаУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ								КАК Недостача,
	|	ВЫБОР
	|		КОГДА СуммаУчет < 0 ТОГДА
	|			-СуммаУчет
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ								КАК Излишек
	|ПОМЕСТИТЬ
	|	Расхождения
	|ИЗ
	|	(ВЫБРАТЬ
	|		Валюта				КАК Валюта,
	|		СУММА(СуммаУчет)	КАК СуммаУчет
	|	ИЗ
	|		ДетальныеОстатки
	|	СГРУППИРОВАТЬ ПО
	|		Валюта
	|	)	КАК СвернутыеОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Остатки денежной кассы по данным учета (свернутая).
	|//		(Финальная таблица для дальнейшей обработки)
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Расхождения.Валюта												КАК Валюта,
	|	КурсыВалют.Курс													КАК Курс,
	|	КурсыВалют.Кратность											КАК Кратность,
	|	Расхождения.СуммаУчет											КАК СуммаУчет,
	|	ВЫБОР
	|		КОГДА КурсыВалют.Кратность = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			Расхождения.СуммаУчет * КурсыВалют.Курс / КурсыВалют.Кратность
	|	КОНЕЦ															КАК СуммаУчетРУ,
	|	Расхождения.СуммаУчетОтрицательная								КАК СуммаУчетОтрицательная,
	|
	|	Расхождения.Недостача											КАК Недостача,
	|	ВЫБОР
	|		КОГДА КурсыВалют.Кратность = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			Расхождения.Недостача * КурсыВалют.Курс / КурсыВалют.Кратность
	|	КОНЕЦ															КАК НедостачаРУ,
	|	Расхождения.Излишек												КАК Излишек,
	|	ВЫБОР
	|		КОГДА КурсыВалют.Кратность = 0 ТОГДА
	|			0
	|		ИНАЧЕ
	|			Расхождения.Излишек * КурсыВалют.Курс / КурсыВалют.Кратность
	|	КОНЕЦ															КАК ИзлишекРУ
	|ИЗ
	|	Расхождения
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.КурсыВалют.СрезПоследних(&ДатаОстатков) КАК КурсыВалют
	|		ПО	Расхождения.Валюта = КурсыВалют.Валюта
	|УПОРЯДОЧИТЬ ПО
	|	Расхождения.Валюта.Наименование
	|;";
	
	Возврат ЗапросЗаполнение.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьТаблицу_ДС_ФактическоеНаличие(ДокументОбъект) Экспорт
	
	ТаблЧасть = ДокументОбъект["ДенежныеСредства"];
	
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЧ["СуммаФакт"]	= СтрокаТЧ["СуммаУчет"];
		СтрокаТЧ["СуммаФактРУ"]	= СтрокаТЧ["СуммаУчетРУ"];
		
		РассчитатьРасхождение(СтрокаТЧ["СуммаФакт"], СтрокаТЧ["СуммаУчет"], СтрокаТЧ["Недостача"], СтрокаТЧ["Излишек"]);
		РассчитатьРасхождение(СтрокаТЧ["СуммаФактРУ"], СтрокаТЧ["СуммаУчетРУ"], СтрокаТЧ["НедостачаРУ"], СтрокаТЧ["ИзлишекРУ"]);
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаполнитьТаблицу_ДС_Расхождение(ДокументОбъект, ЭтоНедостача) Экспорт
	
	Если Документы.ИнвентаризацияКассы.ЕстьОшибкиЗаполненияТаблицыДенежныеСредства(ДокументОбъект) Тогда
		// Выходим:
		Возврат Ложь;
	КонецЕсли;
	
	// Расхождения, указанные в документе:
	Если ЭтоНедостача Тогда
		ИмяКолонкиСуммы	= "Недостача";
		ИмяТаблЧасти	= "ДенежныеСредстваНедостачи";
	Иначе
		ИмяКолонкиСуммы	= "Излишек";
		ИмяТаблЧасти	= "ДенежныеСредстваИзлишки";
	КонецЕсли;
	
	ТаблицаРасхождения = ДокументОбъект["ДенежныеСредства"].Выгрузить(, "Валюта," + ИмяКолонкиСуммы);
	ТаблицаРасхождения.Колонки[ИмяКолонкиСуммы].Имя = "Сумма";
	
	// Детальные остатки:
	ЗапросДетальныеОстатки = Документы.ИнвентаризацияКассы.ИнициализироватьЗапрос_ДетальныеОстатки_ДС(ДокументОбъект);
	ЗапросДетальныеОстатки.Текст = ЗапросДетальныеОстатки.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Детальные остатки
	|//		
	|ВЫБРАТЬ
	|	*
	|ИЗ
	|	ДетальныеОстатки
	|ГДЕ
	|	СуммаУчет > 0
	|;";
	ТаблицаДетальныеОстатки = ЗапросДетальныеОстатки.Выполнить().Выгрузить();
	ТаблицаДетальныеОстатки.Колонки["СуммаУчет"].Имя = "Сумма";
	
	// Получим детальные расхождения:
	КоллекцияИменКолонокСвязи		= Новый Структура("Валюта");
	КоллекцияИменКолонокПоказателей	= Новый Структура("Сумма");
	РезультатСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаРасхождения,
		ТаблицаДетальныеОстатки,
		КоллекцияИменКолонокСвязи,
		КоллекцияИменКолонокПоказателей,
		"СписанияВТаблице2ВРазмереТаблицы1");
	ТаблицаДетальныеРасхождения = РезультатСравнения["СписанияВТаблице2ВРазмереТаблицы1"];
	
	// Заполняем табл.часть:
	ДокументОбъект[ИмяТаблЧасти].Загрузить(ТаблицаДетальныеРасхождения);
	ДокументОбъект[ИмяТаблЧасти].Сортировать("Валюта,Подразделение,ИФО,КФО,КПС,КЭК");
	
	Возврат Истина;
	
КонецФункции

