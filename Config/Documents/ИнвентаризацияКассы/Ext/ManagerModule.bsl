	|	Док.ДатаПодписиМОЛ					КАК ДатаПодписиМОЛ
	|ИЗ
	|	Документ.ИнвентаризацияКассы	КАК Док
	|ГДЕ
	|	Док.Ссылка В (&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Таблица инвентаризационной комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	ТЧ.ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ТЧ.ФамилияЧленаКомиссии		КАК ФамилияЧленаКомиссии,
	|	ТЧ.ИмяЧленаКомиссии			КАК ИмяЧленаКомиссии,
	|	ТЧ.ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияКассы.СоставКомиссии	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ ПО
	|	// Обязательно первые итоги по ссылке на документ:
	|	ТЧ.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица данных документа
	|//		Валютные суммы для валюты Рубль не выводим (принудительно обнуляем).
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.Ссылка					КАК ДокСсылка,
	|	&Показатель + "" ("" + ТЧ.Валюта.НаименованиеПолное + "")"" КАК Показатель,
	|	
	|	ВЫБОР
	|		КОГДА ТЧ.Валюта = &ВалютаРУ ТОГДА
	|			0
	|		ИНАЧЕ
	|			ТЧ.СуммаУчет
	|	КОНЕЦ						КАК СуммаУчет,
	|	ТЧ.СуммаУчетРУ				КАК СуммаУчетРУ,
	|	
	|	ВЫБОР
	|		КОГДА ТЧ.Валюта = &ВалютаРУ ТОГДА
	|			0
	|		ИНАЧЕ
	|			ТЧ.СуммаФакт
	|	КОНЕЦ						КАК СуммаФакт,
	|	ТЧ.СуммаФактРУ				КАК СуммаФактРУ,
	|	
	|	ВЫБОР
	|		КОГДА ТЧ.Валюта = &ВалютаРУ ТОГДА
	|			0
	|		ИНАЧЕ
	|			ТЧ.Недостача
	|	КОНЕЦ						КАК Недостача,
	|	ТЧ.НедостачаРУ				КАК НедостачаРУ,
	|	
	|	ВЫБОР
	|		КОГДА ТЧ.Валюта = &ВалютаРУ ТОГДА
	|			0
	|		ИНАЧЕ
	|			ТЧ.Излишек
	|	КОНЕЦ						КАК Излишек,
	|	ТЧ.ИзлишекРУ				КАК ИзлишекРУ
	|ИЗ
	|	Документ.ИнвентаризацияКассы.ДенежныеСредства	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка В (&МассивСсылок)
	|ИТОГИ
	|	СУММА(СуммаУчетРУ),
	|	СУММА(СуммаФактРУ),
	|	СУММА(ИзлишекРУ),
	|	СУММА(НедостачаРУ)
	|ПО
	|	// Обязательно первые итоги по ссылке на документ:
	| 	ТЧ.Ссылка
	|;";
	
	РезультатПечать = ЗапросПечать.ВыполнитьПакет();
	
	ВыборкаШапка		= РезультатПечать[0].Выбрать();
	ВыборкаДокКомиссия	= РезультатПечать[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокДанные	= РезультатПечать[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокКомиссия.Сбросить();
		ВыборкаДокДанные.Сбросить();
		ЕстьВыборкаДокКомиссия		= ВыборкаДокКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		ЕстьВыборкаДокДанные		= ВыборкаДокДанные.НайтиСледующий(ПоискТекущегоДокумента);
		
		
		Если Не ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		
		//---------------------
		// с.1, Титульный лист
		//---------------------
		НомерСтраницы = 1;
		ОбластьТитул				= Макет.ПолучитьОбласть("Титул");
		ОбластьПодписьМОЛ			= Макет.ПолучитьОбласть("ПодписьМОЛ");
		ОбластьКомиссия				= Макет.ПолучитьОбласть("Комиссия");
		ОбластьДатаПодписиКомиссии	= Макет.ПолучитьОбласть("ДатаПодписиКомиссии");
		
		ОбластьТитул.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьТитул,"Номер",ВыборкаШапка.Номер,ВыборкаШапка.ДокСсылка,Неопределено, Истина);
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("Дата", ВыборкаШапка["ДатаИнвентаризации"]);

		// Сведения о МОЛ:
		МОЛ				= ПолучитьСотрудника(ВыборкаШапка.МОЛ);
		МОЛДолжность	= "";
		МОЛФИО			= "";
		Если ЗначениеЗаполнено(МОЛ) Тогда
			ТребуемыеДанные = Новый Структура("СсылкаНаОбъект, Период, Должность",
				МОЛ,
				ВыборкаШапка.Дата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
			
			МОЛДолжность = ТребуемыеДанные.Должность;
			МОЛФИО       = Корреспонденты.ФИОПоОбъекту(МОЛ, Истина);
		КонецЕсли;
		ЗначенияПараметров.Вставить("МОЛДолжность",	МОЛДолжность);
		ЗначенияПараметров.Вставить("МОЛФИО",		МОЛФИО);
		
		ОбластьТитул.Параметры.Заполнить(ЗначенияПараметров);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьТитул);
		
		//---
		// Объяснение причин расхождений
		//---
		ОбластьОбъяснениеПричинРасхождений = Печать0504088_ВывестиОбъяснениеПричинРасхождений(ВыборкаШапка.ОбъяснениеПричинРасхождений, Макет);
		ТабДокумент.Вывести(ОбластьОбъяснениеПричинРасхождений);
		
		//---
		// Подпись МОЛ
		//---
		ОбластьПодписьМОЛ.Параметры.Заполнить(ЗначенияПараметров);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиМОЛ"]);
		
		ОбластьПодписьМОЛ.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		ТабДокумент.Вывести(ОбластьПодписьМОЛ);
		
		//---
		// Заключение комиссии
		//---
		ОбластьЗаключениеКомиссии = Печать0504088_ВывестиЗаключениеКомиссии(ВыборкаШапка.ЗаключениеКомиссии, Макет);
		ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
		
		//---
		// Инвентаризационная комиссия
		//---
		// Заполняем значения параметров выводимой области:
		ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
			ВыборкаШапка,
			ВыборкаДокКомиссия.Выбрать(), 
			ОбластьКомиссия, 
			3);
		// Выводим область:
		ТабДокумент.Вывести(ОбластьВсяКомиссия);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиКомиссии"]);
		
		ОбластьДатаПодписиКомиссии.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		ТабДокумент.Вывести(ОбластьДатаПодписиКомиссии);
		
		//-----------------------------
		// с.2 и далее, Таблица док-та
		//-----------------------------
		//ТабДокумент.ПолеСлева  = 5;
		//ТабДокумент.ПолеСправа = 0;
		
		//
		// Таблица документа
		//
		ОбластьНомерСтраницы   = Макет.ПолучитьОбласть("НомерСтраницы");
		ОбластьШапка           = Макет.ПолучитьОбласть("Шапка");
		ОбластьСтрока          = Макет.ПолучитьОбласть("Строка");
		ОбластьИтогоПоСтранице = Макет.ПолучитьОбласть("ИтогоПоСтранице");
		ОбластьИтого           = Макет.ПолучитьОбласть("Итого");
		
		НачатьСтраницуТабличногоДокумента(ТабДокумент, ОбластьНомерСтраницы, ОбластьШапка, НомерСтраницы);
		
		МассивВыведенныхОбластей = Новый Массив;
		МассивВыведенныхОбластей.Добавить(ОбластьНомерСтраницы);
		МассивВыведенныхОбластей.Добавить(ОбластьШапка);
		МассивВыведенныхОбластей.Добавить(ОбластьСтрока);
		МассивВыведенныхОбластей.Добавить(ОбластьИтогоПоСтранице);
		МассивВыведенныхОбластей.Добавить(ОбластьИтого);
		
		ВсегоПоСтраницеСуммаУчетРУ = 0;
		ВсегоПоСтраницеСуммаФактРУ = 0;
		
		Если ЕстьВыборкаДокДанные Тогда
			
			ВыборкаДанные = ВыборкаДокДанные.Выбрать();
			Пока ВыборкаДанные.Следующий() Цикл
				
				Если НЕ ТабДокумент.ПроверитьВывод(МассивВыведенныхОбластей) Тогда
					//---
					// Итого по странице
					//---
					
					Печать0504088_ВывестиИтогиПоСтранице(
						ТабДокумент,
						ОбластьИтогоПоСтранице,
						ВсегоПоСтраницеСуммаУчетРУ,
						ВсегоПоСтраницеСуммаФактРУ,
						ВыводитьФактическоеНаличие,
						ОчищающаяСтруктураСтроки);
					
					НачатьСтраницуТабличногоДокумента(ТабДокумент, ОбластьНомерСтраницы, ОбластьШапка, НомерСтраницы);
				КонецЕсли;	
				
				//---
				// Строка
				//---
				
				ОбластьСтрока.Параметры.Заполнить(ВыборкаДанные);
				
				Если НЕ ВыводитьФактическоеНаличие Тогда
					ОбластьСтрока.Параметры.Заполнить(ОчищающаяСтруктураСтроки);
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьСтрока);
				
				ВсегоПоСтраницеСуммаУчетРУ = ВсегоПоСтраницеСуммаУчетРУ + ВыборкаДанные.СуммаУчетРУ;
				ВсегоПоСтраницеСуммаФактРУ = ВсегоПоСтраницеСуммаФактРУ + ВыборкаДанные.СуммаФактРУ;
						
			КонецЦикла;	
			
		КонецЕсли;
		
		//---
		// Итого по описи
		//---
		
		Параметр_СуммаУчетРУ = 0;
		Параметр_СуммаФактРУ = 0;
		Если ЕстьВыборкаДокДанные Тогда
			Параметр_СуммаУчетРУ = ВыборкаДокДанные["СуммаУчетРУ"];
			Параметр_СуммаФактРУ = ВыборкаДокДанные["СуммаФактРУ"];
		КонецЕсли;
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("СуммаУчетРУСтрока", ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Параметр_СуммаУчетРУ, ВалютаРУ));
		ЗначенияПараметров.Вставить("СуммаФактРУСтрока", ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(Параметр_СуммаФактРУ, ВалютаРУ));
		ЗначенияПараметров.Вставить("НомерПКО",	ВыборкаШапка["НомерПКО"]);
		ЗначенияПараметров.Вставить("НомерРКО",	ВыборкаШапка["НомерРКО"]);
		
		Если Не ЕстьВыборкаДокДанные Тогда
			ЗначенияПараметров.Вставить("СуммаФактРУ",	0);
			ЗначенияПараметров.Вставить("СуммаУчетРУ",	0);
			ЗначенияПараметров.Вставить("ИзлишекРУ",	0);
			ЗначенияПараметров.Вставить("НедостачаРУ",	0);
		КонецЕсли;
		
		ОбластьИтого.Параметры.Заполнить(ВыборкаДокДанные);
		ОбластьИтого.Параметры.Заполнить(ЗначенияПараметров);
		
		Если НЕ ВыводитьФактическоеНаличие Тогда
			ОбластьИтого.Параметры.Заполнить(ОчищающаяСтруктураСтроки);
			
			ОбластьИтого.Параметры.Заполнить(ОчищающаяСтруктураИтоговПрописью);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьИтого);
		
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция Печать0504088_ПолучитьОчищающуюСтруктуруСтрокиТаблицы()
	
	// Исключаем вывод символа прочерка "-" путем указания пустой строки.
	// Применяется для показателей фактического наличия и расхождений.
	
	ОчищающаяСтруктура = Новый Структура();
	
	ОчищающаяСтруктура.Вставить("СуммаФактРУ",	"");
	ОчищающаяСтруктура.Вставить("СуммаФакт",	"");
	
	ОчищающаяСтруктура.Вставить("ИзлишекРУ",	"");
	ОчищающаяСтруктура.Вставить("Излишек",		"");
	
	ОчищающаяСтруктура.Вставить("НедостачаРУ",	"");
	ОчищающаяСтруктура.Вставить("Недостача",	"");
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Функция Печать0504088_ПолучитьОчищающуюСтруктуруИтоговПрописью()
	
	// Исключаем вывод символа итогов прописью путем указания пустой строки.
	// Применяется для показателей фактического наличия.
	
	ОчищающаяСтруктура = Новый Структура();
	
	ОчищающаяСтруктура.Вставить("СуммаФактРУСтрока", "");
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Процедура Печать0504088_ВывестиИтогиПоСтранице(
	ТабДокумент,
	ОбластьМакетаИтогоПоСтранице,
	ВсегоПоСтраницеУчетРУ,
	ВсегоПоСтраницеФактРУ,
	ВыводитьФактическоеНаличие,
	ОчищающаяСтруктураСтроки)
	
	
	СтруктураОбластьМакетаИтогоПоСтранице = Новый Структура("СуммаУчетРУ,СуммаФактРУ");
	СтруктураОбластьМакетаИтогоПоСтранице.СуммаУчетРУ	= ВсегоПоСтраницеУчетРУ;
	СтруктураОбластьМакетаИтогоПоСтранице.СуммаФактРУ	= ВсегоПоСтраницеФактРУ;
	
	ОтклонениеПоВедомости = ВсегоПоСтраницеУчетРУ - ВсегоПоСтраницеФактРУ;
	
	Если ОтклонениеПоВедомости > 0 Тогда
		СтруктураОбластьМакетаИтогоПоСтранице.Вставить("НедостачаРУ", ОтклонениеПоВедомости);
	ИначеЕсли ОтклонениеПоВедомости < 0 Тогда
		СтруктураОбластьМакетаИтогоПоСтранице.Вставить("ИзлишекРУ", -ОтклонениеПоВедомости);
	КонецЕсли;
	
	ОбластьМакетаИтогоПоСтранице.Параметры.Заполнить(СтруктураОбластьМакетаИтогоПоСтранице);
	
	Если НЕ ВыводитьФактическоеНаличие Тогда
		ОбластьМакетаИтогоПоСтранице.Параметры.Заполнить(ОчищающаяСтруктураСтроки);
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьМакетаИтогоПоСтранице);
	
	ВсегоПоСтраницеСуммаУчет = 0;
	ВсегоПоСтраницеСуммаФакт = 0;
	ВсегоПоСтраницеКоличествоУчет = 0;
	ВсегоПоСтраницеКоличествоФакт = 0;
	
КонецПроцедуры

Функция Печать0504088_ВывестиОбъяснениеПричинРасхождений(Текст, Макет)
	
	БлокиСтрок = Неопределено;
	
	// Блок 1
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, 75, "ОбъяснениеПричинРасхожденийСтрока1");
	
	// Блок 2
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , 125, "ОбъяснениеПричинРасхожденийСтрока2");
	
	МинимальноеКоличествоСтрок = 3;
	
	Возврат ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок);
	
