Процедура ВводНаОсновании_ЗаполнитьДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	ВводНаОсновании.ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения);
	
	// Продолжаем заполнение нового документа
	
	ВидДокумента			= ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"]["ВидДокумента"];
	ДокументОснованиеСсылка	= ДанныеЗаполнения["Основание"];
	
	Если ВидДокумента = "РасходныйКассовыйОрдер" ИЛИ ВидДокумента = "ПриходныйКассовыйОрдер" Тогда
		ЗаполняемыйДокумент["Счет"]				= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.34");
		ЗаполняемыйДокумент["СуммаДокумента"]	= ЗаполняемыйДокумент["РасшифровкаПлатежа"].Итог("Сумма");
		
	ИначеЕсли ВидДокумента = "РасходныйОрдерФондовый" ИЛИ ВидДокумента = "ПриходныйОрдерФондовый" Тогда
		ЗаполняемыйДокумент["Счет"]				= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("201.35");
		ЗаполняемыйДокумент["СуммаДокумента"]	= ЗаполняемыйДокумент["Расшифровка"].Итог("Сумма");
		
		Если ВидДокумента = "ПриходныйОрдерФондовый" Тогда
			ЗаполняемыйДокумент["СпособЗачетаАванса"] = Перечисления.СпособыЗачетаАвансов.Автоматически;
		КонецЕсли;
		
	ИначеЕсли ВидДокумента = "СписаниеБСО" ИЛИ ВидДокумента = "ПоступлениеБСО" Тогда
		СтруктураЗаполнения = Новый Структура();
		СтруктураЗаполнения.Вставить("ПричинаСписания",	НСтр("ru='Списание излишков БСО'"));
		
		// Заменяем номера БСО на их строковые представления
		МассивБСО = ЗаполняемыйДокумент["СоставБСО"].ВыгрузитьКолонку("БСО");
		ДлиныНомеров = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивБСО, "ДлинаНомера");
		Для Каждого СтрокаТЧ Из ЗаполняемыйДокумент["СоставБСО"] Цикл
			ДлинаНомера = ДлиныНомеров.Получить(СтрокаТЧ["БСО"]);
			СтрокаТЧ["НомерНачальный"]	= ПолучитьПредставлениеНомераБСО(СтрокаТЧ["НомерНачальный"], ДлинаНомера);
			СтрокаТЧ["НомерКонечный"]	= ПолучитьПредставлениеНомераБСО(СтрокаТЧ["НомерКонечный"], ДлинаНомера);
			
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтруктураЗаполнения);
		КонецЦикла;
		
		Если ВидДокумента = "СписаниеБСО" Тогда
			// Заполним сведения об инвентаризационной комиссии
			ЗаполнитьИнвентаризационнуюКомиссию(ЗаполняемыйДокумент, ДокументОснованиеСсылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


