		ДЗРезультат = РезультатыПроверок[14].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		ИмяПоляДляВыводаСообщений = "НачальныйНомерПредставление";
		Для Каждого СтрокаИтого Из ДЗРезультат.Строки Цикл
			Результат = Ложь;
			РезультатИзлишкиБСО = Ложь;
			НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("ПересекаетсяСНомерСтроки");
			НомерСтроки = СтрокаИтого["НомерСтроки"];
								
			// Выводим сообщение:
			Текст = НСтр("ru='Обнаружены пересекающиеся диапазоны номеров БСО одной и той же серии (таблица ""Излишки БСО"", строка %1 со строками %2)'");
			Текст = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(Текст, НомераСтрок, МаксДлинаСообщения, "%2");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки);
			
			ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				Объект.Ссылка,
				"Объект." + ИмяТаблЧасти + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
		КонецЦикла;
			
	КонецЕсли;
	
	
	// Возвращаем результат всех проверок:
	Возврат Результат;
	
КонецФункции

// Вызывается при загрузке данных из БГУ1.
Функция РассчитатьБСОНедостачиИзлишки_ПриЗагрузкеДанных(ДокОбъект) Экспорт
	
	Если НЕ БСОЗаполненыКорректно(
		ДокОбъект,
		Истина, // ПроверитьТолькоСоставБСО
		Истина) // РежимЗагрузкиДанных
		Тогда
		
		// Признак наличия ошибок заполнения табл.части:
		Возврат Ложь;
	КонецЕсли;
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыРасчетаРасхожденийБСО(ДокОбъект);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено);
	
	РассчитатьБСОНедостачиИзлишки(ПараметрыПроцедуры, АдресХранилища);
	
	РезультатыРасчета = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	ДокОбъект["СоставБСО"].Загрузить(РезультатыРасчета);
	
	// Недостачи
	ЗаполнитьТаблицу_БСО_Расхождение(ДокОбъект, Истина, Истина);
	
	// Излишки
	ЗаполнитьТаблицу_БСО_Расхождение(ДокОбъект, Ложь, Истина);
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьПараметрыПроцедурыРасчетаРасхожденийБСО(ДокументОбъект) Экспорт
	
	ПараметрыПроцедуры = Новый Структура();
	
	ПараметрыПроцедуры.Вставить("СоставБСО", ДокументОбъект["СоставБСО"].Выгрузить());
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

// Нормализует табл.часть "Состав БСО" и рассчитывает колонки расхождений.
Процедура РассчитатьБСОНедостачиИзлишки(ПараметрыПроцедуры, АдресХранилища) Экспорт
	
	ЗапросыРасчет = Новый Запрос();
	ЗапросыРасчет.УстановитьПараметр("ТЗСоставБСО", ПараметрыПроцедуры["СоставБСО"]);
	ЗапросыРасчет.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходные проверяемые данные табличной части СоставБСО
	|//
	|ВЫБРАТЬ
	|	ТЗ.БСО					КАК БСО,
	|	ТЗ.Серия				КАК СерияБСО,
	|	
	|	ТЗ.ОшибкаУчета			КАК ОшибкаУчета,
	|	ТЗ.НачальныйНомерУчет	КАК НомерНачальныйУчет,
	|	ТЗ.КонечныйНомерУчет	КАК НомерКонечныйУчет,
	|	ВЫБОР
	|		КОГДА ТЗ.ОшибкаУчета И (ТЗ.КонечныйНомерУчет - ТЗ.НачальныйНомерУчет + 1) <> 0 ТОГДА
	|			ТЗ.КоличествоУчет / (ТЗ.КонечныйНомерУчет - ТЗ.НачальныйНомерУчет + 1)
	|		ИНАЧЕ
	|			1
	|	КОНЕЦ					КАК ДельтаКоличествоУчет,
	|	ТЗ.НачальныйНомерФакт	КАК НомерНачальныйФакт,
	|	ТЗ.КонечныйНомерФакт	КАК НомерКонечныйФакт,
	|	1						КАК ДельтаКоличествоФакт
	|ПОМЕСТИТЬ
	|	ТабличнаяЧасть
	|ИЗ
	|	&ТЗСоставБСО	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уникальные границы диапазонов номеров
	|//
	|ВЫБРАТЬ
	|	БСО						КАК БСО,
	|	СерияБСО				КАК СерияБСО,
	|	Граница					КАК Граница,
	|	СУММА(ДельтаКоличествоУчет)	КАК ДельтаКоличествоУчет,
	|	СУММА(ДельтаКоличествоФакт)	КАК ДельтаКоличествоФакт,
	|	МАКСИМУМ(ОшибкаУчета)	КАК ОшибкаУчета
	|ИЗ
	|	(
	|	// По учету
	|	ВЫБРАТЬ
	|		БСО						КАК БСО,
	|		СерияБСО				КАК СерияБСО,
	|		ОшибкаУчета				КАК ОшибкаУчета,
	|		НомерНачальныйУчет		КАК Граница,
	|		ДельтаКоличествоУчет	КАК ДельтаКоличествоУчет,
	|		0						КАК ДельтаКоличествоФакт
	|		
	|	ИЗ
	|		ТабличнаяЧасть
	|	ГДЕ
	|		НомерНачальныйУчет <> 0 И НомерКонечныйУчет <> 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		БСО						КАК БСО,
	|		СерияБСО				КАК СерияБСО,
	|		ЛОЖЬ					КАК ОшибкаУчета,
	|		НомерКонечныйУчет + 1	КАК Граница,
	|		-ДельтаКоличествоУчет	КАК ДельтаКоличествоУчет,
	|		0						КАК ДельтаКоличествоФакт
	|	ИЗ
	|		ТабличнаяЧасть
	|	ГДЕ
	|		НомерНачальныйУчет <> 0 И НомерКонечныйУчет <> 0
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	// По факту
	|	ВЫБРАТЬ
	|		БСО						КАК БСО,
	|		СерияБСО				КАК СерияБСО,
	|		ЛОЖЬ					КАК ОшибкаУчета,
	|		НомерНачальныйФакт		КАК Граница,
	|		0						КАК ДельтаКоличествоУчет,
	|		ДельтаКоличествоФакт	КАК ДельтаКоличествоФакт
	|		
	|	ИЗ
	|		ТабличнаяЧасть
	|	ГДЕ
	|		НомерНачальныйФакт <> 0 И НомерКонечныйФакт <> 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		БСО						КАК БСО,
	|		СерияБСО				КАК СерияБСО,
	|		ЛОЖЬ					КАК ОшибкаУчета,
	|		НомерКонечныйФакт + 1	КАК Граница,
	|		0						КАК ДельтаКоличествоУчет,
	|		-ДельтаКоличествоФакт	КАК ДельтаКоличествоФакт
	|	ИЗ
	|		ТабличнаяЧасть
	|	ГДЕ
	|		НомерНачальныйФакт <> 0 И НомерКонечныйФакт <> 0
	|	
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|ИМЕЮЩИЕ
	|	СУММА(ДельтаКоличествоУчет) <> 0
	|	ИЛИ СУММА(ДельтаКоличествоФакт) <> 0
	|УПОРЯДОЧИТЬ ПО
	|	БСО,
	|	СерияБСО,
	|	Граница
	|ИТОГИ ПО
	|	БСО,
	|	СерияБСО
	|;";
	
	ВыборкаБСО = ЗапросыРасчет.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблЧасть = ПараметрыПроцедуры["СоставБСО"];
	ТаблЧасть.Очистить();
	
	ПредыдущаяВыборка = Новый Структура("
		|БСО,
		|СерияБСО,
		|Граница,
		|ДельтаКоличествоУчет,
		|ДельтаКоличествоФакт,
		|ОшибкаУчета");
	
	Пока ВыборкаБСО.Следующий() Цикл
		
		ВыборкаСерияБСО = ВыборкаБСО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСерияБСО.Следующий() Цикл
			
			ВыборкаГраницыДиапазонов = ВыборкаСерияБСО.Выбрать();
			
			МножительКоличествоУчет = 0;
			МножительКоличествоФакт = 0;
			
			Пока ВыборкаГраницыДиапазонов.Следующий() Цикл
				
				Если МножительКоличествоУчет = 0 И МножительКоличествоФакт = 0 Тогда
					// В завершение текущей итерации
					МножительКоличествоУчет = МножительКоличествоУчет + ВыборкаГраницыДиапазонов["ДельтаКоличествоУчет"];
					МножительКоличествоФакт = МножительКоличествоФакт + ВыборкаГраницыДиапазонов["ДельтаКоличествоФакт"];
					ЗаполнитьЗначенияСвойств(ПредыдущаяВыборка, ВыборкаГраницыДиапазонов);
					
					Продолжить;
				КонецЕсли;
				
				ЕстьДанныеУчет = (МножительКоличествоУчет <> 0);
				ЕстьДанныеФакт = (МножительКоличествоФакт <> 0);
				
				НомерНачальный	= ПредыдущаяВыборка["Граница"];
				НомерКонечный	= ВыборкаГраницыДиапазонов["Граница"] - 1;
				Количество		= НомерКонечный - НомерНачальный + 1;
				
				КоличествоУчет = Количество * МножительКоличествоУчет;
				КоличествоФакт = Количество * МножительКоличествоФакт;
				
				КоличествоРасхождение = КоличествоУчет - КоличествоФакт;
				КоличествоРасхождениеАбс = ?(КоличествоРасхождение > 0, КоличествоРасхождение, -КоличествоРасхождение);
				
				ЕстьДанныеНедостача	= (КоличествоРасхождение > 0);
				ЕстьДанныеИзлишек	= (КоличествоРасхождение < 0);
				
				НоваяСтрока = ТаблЧасть.Добавить();
				
				НоваяСтрока["БСО"]			= ПредыдущаяВыборка.БСО;
				НоваяСтрока["Серия"]		= ПредыдущаяВыборка.СерияБСО;
				НоваяСтрока["ОшибкаУчета"]	= ПредыдущаяВыборка.ОшибкаУчета;
				
				// По учету
				Если ЕстьДанныеУчет Тогда
					НоваяСтрока["НачальныйНомерУчет"]	= НомерНачальный;
					НоваяСтрока["КонечныйНомерУчет"]	= НомерКонечный;
					НоваяСтрока["КоличествоУчет"]		= КоличествоУчет;
				КонецЕсли;
				
				// По факту
				Если ЕстьДанныеФакт Тогда
					НоваяСтрока["НачальныйНомерФакт"]	= НомерНачальный;
					НоваяСтрока["КонечныйНомерФакт"]	= НомерКонечный;
					НоваяСтрока["КоличествоФакт"]		= КоличествоФакт;
				КонецЕсли;
					
				// Недостача
				Если ЕстьДанныеНедостача Тогда
					НоваяСтрока["Недостача"] = КоличествоРасхождениеАбс;
				КонецЕсли;
				
				// Излишек
				Если ЕстьДанныеИзлишек Тогда
					НоваяСтрока["Излишек"] = КоличествоРасхождениеАбс;
				КонецЕсли;
				
				// В завершение текущей итерации
				МножительКоличествоУчет = МножительКоличествоУчет + ВыборкаГраницыДиапазонов["ДельтаКоличествоУчет"];
				МножительКоличествоФакт = МножительКоличествоФакт + ВыборкаГраницыДиапазонов["ДельтаКоличествоФакт"];
				ЗаполнитьЗначенияСвойств(ПредыдущаяВыборка, ВыборкаГраницыДиапазонов);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(ТаблЧасть, АдресХранилища);
	
КонецПроцедуры

// Заполняет одну из табл.частей "Недостачи БСО" или "Излишки БСО" указанного документа.
// В режиме загрузки данных (РежимЗагрузкиДанных=Истина) сообщения не выводятся.
Процедура ЗаполнитьТаблицу_БСО_Расхождение(ДокументОбъект, ЭтоНедостача, РежимЗагрузкиДанных = Ложь) Экспорт
	
	// Расхождения, указанные в документе (оставляем только корректные расхождения):
	Если ЭтоНедостача Тогда
		ИмяКолонкиКоличества		= "Недостача";
		ИмяКолонкиНачальныйНомер	= "НачальныйНомерУчет";
		ИмяКолонкиКонечныйНомер		= "КонечныйНомерУчет";
		ИмяТаблЧасти				= "СоставБСОНедостачи";
	Иначе
		ИмяКолонкиКоличества		= "Излишек";
		ИмяКолонкиНачальныйНомер	= "НачальныйНомерФакт";
		ИмяКолонкиКонечныйНомер		= "КонечныйНомерФакт";
		ИмяТаблЧасти				= "СоставБСОИзлишки";
	КонецЕсли;
	Поиск = Новый Структура("ОшибкаУчета", Ложь);
	
	ИменаКолонок = "БСО,Серия," + ИмяКолонкиКоличества + "," + ИмяКолонкиНачальныйНомер + "," + ИмяКолонкиКонечныйНомер;
	Если РежимЗагрузкиДанных = Ложь Тогда
		ИменаКолонок = ИменаКолонок + ",ДлинаНомера";
	КонецЕсли;
	ТаблицаРасхождения = ДокументОбъект["СоставБСО"].Выгрузить(Поиск, ИменаКолонок);
	КоличествоСтрок = ТаблицаРасхождения.Количество();
	Для сч = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаРасхождения[КоличествоСтрок - сч];
		УдалитьСтроку = СтрокаТаблицы[ИмяКолонкиКоличества] <= 0;
		Если УдалитьСтроку Тогда
			ТаблицаРасхождения.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
	ТаблицаРасхождения.Колонки[ИмяКолонкиКоличества].Имя		= "Количество";
	ТаблицаРасхождения.Колонки[ИмяКолонкиНачальныйНомер].Имя	= "НачальныйНомер";
	ТаблицаРасхождения.Колонки[ИмяКолонкиКонечныйНомер].Имя		= "КонечныйНомер";
	
	ТаблицаРасхождения.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ТаблицаРасхождения.ЗаполнитьЗначения(ДокументОбъект.МОЛ, "ЦМО");
	
	// Заполняем табл.часть:
	ДокументОбъект[ИмяТаблЧасти].Загрузить(ТаблицаРасхождения);
	ДокументОбъект[ИмяТаблЧасти].Сортировать("БСО,Серия,НачальныйНомер,Подразделение,ИФО,КФО");
	
	// Обновляем представления номеров БСО:
	Если РежимЗагрузкиДанных = Ложь Тогда
		ТаблЧасть = ДокументОбъект[ИмяТаблЧасти];
		Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
			ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомер", "КонечныйНомер");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

//---
// Редактирование номеров последних кассовых документов

Функция НомерКассовогоДокумента_ПолучитьПоследниеПроведенныеОрдераСервер(Организация, Подразделение, Дата, ИФО, Фондовые = Неопределено) Экспорт
	
	СоответствиеДокументРеквизит = Новый Соответствие();
	СоответствиеДокументРеквизит.Вставить("ПриходныйКассовыйОрдер",			"ПоследнийПКО");
	СоответствиеДокументРеквизит.Вставить("РасходныйКассовыйОрдер",			"ПоследнийРКО");
	СоответствиеДокументРеквизит.Вставить("ВедомостьНаВыдачуДенегИзКассы",	"ПоследнийРКО"); // конкурент Расходного кассового ордера
	СоответствиеДокументРеквизит.Вставить("ПриходныйОрдерФондовый",			"ПоследнийПОФ");
	СоответствиеДокументРеквизит.Вставить("РасходныйОрдерФондовый",			"ПоследнийРОФ");
	
	ИменаДокументов = Новый Массив();
	Если Фондовые = Истина Тогда
		ИменаДокументов.Добавить("ПриходныйОрдерФондовый");
		ИменаДокументов.Добавить("РасходныйОрдерФондовый");
		
	ИначеЕсли Фондовые = Ложь Тогда
		ИменаДокументов.Добавить("ПриходныйКассовыйОрдер");
		ИменаДокументов.Добавить("РасходныйКассовыйОрдер");
		ИменаДокументов.Добавить("ВедомостьНаВыдачуДенегИзКассы"); // конкурент Расходного кассового ордера
		
	ИначеЕсли Фондовые = Неопределено Тогда
		ИменаДокументов.Добавить("ПриходныйКассовыйОрдер");
		ИменаДокументов.Добавить("РасходныйКассовыйОрдер");
		ИменаДокументов.Добавить("ВедомостьНаВыдачуДенегИзКассы"); // конкурент Расходного кассового ордера
		ИменаДокументов.Добавить("ПриходныйОрдерФондовый");
		ИменаДокументов.Добавить("РасходныйОрдерФондовый");
	КонецЕсли;
	
	// Настраиваем запрос:
	Запросы = Новый Запрос();
	Запросы.УстановитьПараметр("Организация",								Организация);
	Запросы.УстановитьПараметр("ДатаИнвентаризации",						ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(Дата));
	Запросы.УстановитьПараметр("ИФО",										ИФО);
	Запросы.УстановитьПараметр("ИспользоватьУчетПоИФО",						ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запросы.УстановитьПараметр("БезУчетаИФО",								НЕ ЗначениеЗаполнено(ИФО));
	Запросы.УстановитьПараметр("Подразделение",								Подразделение);
	Запросы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запросы.УстановитьПараметр("ИспользоватьОтборПоОдномуПодразделению",	ЗначениеЗаполнено(Подразделение));
	// Получим по одному самому последнему документу каждого вида:
	Текст = "	
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка										КАК Ссылка,
	|	Дата										КАК Дата,
	|	Номер										КАК Номер,
	|	""[ОбозначениеСоответствующегоРеквизита]""	КАК ОбозначениеСоответствующегоРеквизита
	|ИЗ
	|	Документ.[ИмяДокумента]
	|ГДЕ
	|	Дата <= &ДатаИнвентаризации
	|	И	Организация = &Организация
	|	И	Проведен
	|	// Отбор по ИФО:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО И НЕ &БезУчетаИФО ТОГДА
	|			ИФО = &ИФО
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	// Отбор по подразделению:
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям И &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение = &Подразделение
	|		КОГДА &ИспользоватьУчетПоПодразделениям И НЕ &ИспользоватьОтборПоОдномуПодразделению ТОГДА
	|			Подразделение НЕ В (ВЫБРАТЬ Ссылка ИЗ ОбособленныеПодразделения)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ
	|;";
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Обособленные подразделения, которые ведут собственные кассовые книги
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ПОМЕСТИТЬ
	|	ОбособленныеПодразделения
	|ИЗ
	|	Справочник.Подразделения
	|ГДЕ
	|	Владелец = &Организация
	|	И	ОбособленноеПодразделение
	|	И	ВедетсяКассоваяКнига
	|;";
	
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеСоответствующегоРеквизита",	СоответствиеДокументРеквизит.Получить(ИмяДокумента));
		ВставляемыеЗначения.Вставить("ИмяДокумента",			ИмяДокумента);
		ТекстЗапроса = ТекстЗапроса + СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Текст, ВставляемыеЗначения);
	КонецЦикла;
	Запросы.Текст = ТекстЗапроса;
	РезультатыЗапроса = Запросы.ВыполнитьПакет();
	
	// Получим самый последний документ для каждого обозначения реквизита:
	ВозвращаемыйРезультат = Новый Структура();
	ПоследниеДокументы = Новый Структура();
	ПоследнийДокумент = Неопределено;
	инд = 0;
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		ОбозначениеСоответствующегоРеквизита = СоответствиеДокументРеквизит.Получить(ИмяДокумента);
		инд = инд + 1;
		РезультатЗапроса = РезультатыЗапроса[инд];
		
		Если РезультатЗапроса.Пустой() Тогда
			ТекДата		= '00010101';
			ТекСсылка	= Неопределено;
			ТекНомер	= "";
		Иначе
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ТекДата		= Выборка["Дата"];
			ТекСсылка	= Выборка["Ссылка"];
			ТекНомер	= Выборка["Номер"];
		КонецЕсли;
		
		ОбновитьПоследнийДокумент = Ложь;
		Если ПоследниеДокументы.Свойство(ОбозначениеСоответствующегоРеквизита, ПоследнийДокумент) Тогда
			Если ТекДата > ПоследнийДокумент["Дата"] Тогда
				ОбновитьПоследнийДокумент = Истина;
			КонецЕсли;
		Иначе
			ОбновитьПоследнийДокумент = Истина;
		КонецЕсли;
		
		Если ОбновитьПоследнийДокумент Тогда
			ПоследнийДокумент = Новый Структура();
			ПоследнийДокумент.Вставить("Дата",		ТекДата);
			ПоследнийДокумент.Вставить("Ссылка",	ТекСсылка);
			ПоследнийДокумент.Вставить("Номер",		ТекНомер);
			ПоследниеДокументы.Вставить(ОбозначениеСоответствующегоРеквизита, ПоследнийДокумент);
			
			// Возвращаемые сведения
			ИмяРеквизитаСсылка	= ОбозначениеСоответствующегоРеквизита;
			ИмяРеквизитаНомер	= ИмяРеквизитаСсылка + "Номер";
			ЗначениеРеквизитаСсылка	= ТекСсылка;
			Если ЗначениеЗаполнено(ЗначениеРеквизитаСсылка) Тогда
				ЗначениеРеквизитаНомер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
					ЗначениеРеквизитаСсылка,
					ПоследнийДокумент["Номер"]);
			Иначе
				ЗначениеРеквизитаНомер = "";
			КонецЕсли;
			ВозвращаемыйРезультат.Вставить(ИмяРеквизитаСсылка,	ЗначениеРеквизитаСсылка);
			ВозвращаемыйРезультат.Вставить(ИмяРеквизитаНомер,	ЗначениеРеквизитаНомер);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВозвращаемыйРезультат;
	
КонецФункции

//---
// Заполнение на основании

Процедура ЗаполнитьДокумент_АктИнвентаризацияНаличныхДС(ЗаполняемыйДокумент, ДокСсылкаОснование) Экспорт
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ДокументСсылка",	ДокСсылкаОснование);
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРУ",			Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.УстановитьПараметр("ВестиКоличественныйУчетДенежныхДокументов",
		ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов"));
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Данные для заполнения шапки документа.
	|//
	|ВЫБРАТЬ
	|	Организация						КАК Организация,
	|	Подразделение					КАК Подразделение,
	|	ИФО								КАК ИФО,
	|	МОЛ								КАК МОЛ,
	|	&ДокументСсылка					КАК ДокументОснование,
	|	ПоследнийРКО					КАК ПоследнийРКО,
	|	ПоследнийПКО					КАК ПоследнийПКО,
	|	ПоследнийРОФ					КАК ПоследнийРОФ,
	|	ПоследнийПОФ					КАК ПоследнийПОФ,
	|	ПоследнийРКОНомер				КАК ПоследнийРКОНомер,
	|	ПоследнийПКОНомер				КАК ПоследнийПКОНомер,
	|	ПоследнийРОФНомер				КАК ПоследнийРОФНомер,
	|	ПоследнийПОФНомер				КАК ПоследнийПОФНомер,
	|	// Сведения о комиссии (шапка):
	|	ДатаПриказаКомиссии				КАК ДатаПриказаКомиссии,
	|	НомерПриказаКомиссии			КАК НомерПриказаКомиссии,
	|	ДолжностьПредседателяКомиссии	КАК ДолжностьПредседателяКомиссии,
	|	ФамилияПредседателяКомиссии		КАК ФамилияПредседателяКомиссии,
	|	ИмяПредседателяКомиссии			КАК ИмяПредседателяКомиссии,
	|	ОтчествоПредседателяКомиссии	КАК ОтчествоПредседателяКомиссии,
	|	ДатаНачала						КАК ДатаНачала,
	|	ДатаОкончания					КАК ДатаОкончания,
	|	ДатаПриказаИнвентаризации		КАК ДатаПриказаИнвентаризации,
	|	НомерПриказаИнвентаризации		КАК НомерПриказаИнвентаризации,
	|	МестоИнвентаризации				КАК МестоИнвентаризации,
	|	ПричинаИнвентаризации			КАК ПричинаИнвентаризации
	|ИЗ
	|	Документ.ИнвентаризацияКассы
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Результаты инвентаризации наличных д/с.
	|//
	|ВЫБРАТЬ
	|	Валюта		КАК Валюта,
	|	СуммаУчет	КАК СуммаУчет,
	|	СуммаФакт	КАК СуммаФакт,
	|	ВЫБОР
	|		КОГДА Валюта = &ВалютаРУ ТОГДА
	|			СуммаУчет
	|		ИНАЧЕ
	|			СуммаУчетРУ
	|	КОНЕЦ		КАК СуммаУчетРУ,
	|	ВЫБОР
	|		КОГДА Валюта = &ВалютаРУ ТОГДА
	|			СуммаФакт
	|		ИНАЧЕ
	|			СуммаФактРУ
	|	КОНЕЦ		КАК СуммаФактРУ
	|ПОМЕСТИТЬ
	|	ДенежныеСредства
	|ИЗ
	|	Документ.ИнвентаризацияКассы.ДенежныеСредства	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокументСсылка
	|	И НЕ Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Результаты инвентаризации наличных д/с.
	|//
	|ВЫБРАТЬ
	|	Валюта				КАК	Валюта,
	|	ВЫБОР
	|		КОГДА Валюта = &ВалютаРУ ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ				КАК ЭтоРубли,
	|	СУММА(СуммаУчет)	КАК СуммаУчет,
	|	СУММА(СуммаФакт)	КАК СуммаФакт,
	|	СУММА(СуммаУчетРУ)	КАК СуммаУчетРУ,
	|	СУММА(СуммаФактРУ)	КАК СуммаФактРУ
	|ИЗ
	|	ДенежныеСредства
	|СГРУППИРОВАТЬ ПО
	|	Валюта
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоРубли	УБЫВ
	|ИТОГИ
	|	СУММА(СуммаУчетРУ)	КАК СуммаУчетРУ,
	|	СУММА(СуммаФактРУ)	КАК СуммаФактРУ
	|ПО
	|	ОБЩИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Результаты инвентаризации денежных документов.
	|//
	|ВЫБРАТЬ
	|	ВидДенежногоДокумента.Наименование	КАК ВидДенежногоДокумента,
	|	СУММА(СуммаУчет)					КАК СуммаУчет,
	|	СУММА(СуммаФакт)					КАК СуммаФакт,
	|	СУММА(ВЫБОР
	|		КОГДА &ВестиКоличественныйУчетДенежныхДокументов = ИСТИНА ТОГДА
	|			// Учет денежных документов ведется только и по сумме, и по количеству.
	|			КоличествоФакт
	|		ИНАЧЕ
	|			// Учет денежных документов ведется только по сумме
	|			0
	|	КОНЕЦ)								КАК КоличествоФакт
	|ПОМЕСТИТЬ
	|	ДенежныеДокументы
	|ИЗ
	|	Документ.ИнвентаризацияКассы.ДенежныеДокументы	КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ДокументСсылка
	|	И НЕ ВидДенежногоДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДенежныхДокументов.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	ВидДенежногоДокумента.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Результаты инвентаризации денежных документов.
	|//
	|ВЫБРАТЬ
	|	ВидДенежногоДокумента	КАК ВидДенежногоДокумента,
	|	СуммаУчет				КАК СуммаУчет,
	|	СуммаФакт				КАК СуммаФакт
	|ИЗ
	|	ДенежныеДокументы
	|УПОРЯДОЧИТЬ ПО
	|	ВидДенежногоДокумента
	|ИТОГИ
	|	СУММА(СуммаУчет)	КАК СуммаУчет,
	|	СУММА(СуммаФакт)	КАК СуммаФакт
	|ПО
	|	ОБЩИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Данные для заполнения состава инвентаризационной комиссии.
	|//
	|ВЫБРАТЬ
	|	ДолжностьЧленаКомиссии	КАК ДолжностьЧленаКомиссии,
	|	ФамилияЧленаКомиссии	КАК ФамилияЧленаКомиссии,
	|	ИмяЧленаКомиссии		КАК ИмяЧленаКомиссии,
	|	ОтчествоЧленаКомиссии	КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ИнвентаризацияКассы.СоставКомиссии
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|;";
	
	РезультатыЗаполнения = ЗапросЗаполнение.ВыполнитьПакет();
	
	ИтогоУчет = 0;
	ТаблЧасть = ЗаполняемыйДокумент["ЦенностиФакт"];
	
	// [0]. Данные для заполнения шапки документа.
	Выборка = РезультатыЗаполнения[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, Выборка);
	КонецЕсли;
	
	// [2]. Результаты инвентаризации наличных д/с.
	// Пример получаемой строки:
	//	наличных денег (в том числе валюта 34 USD на сумму 102,02 руб.; 15 EUR на сумму 60,42 руб.)
	ВидЦенности			= НСтр("ru='Наличных денег%1'");
	Сумма				= 0;
	ВыборкаИтого = РезультатыЗаполнения[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТекстПереченьВалют	= "";
	Если ВыборкаИтого.Следующий() Тогда
		// Обновляем итоговые значения:
		СуммаУчет = ВыборкаИтого["СуммаУчетРУ"];
		СуммаФакт = ВыборкаИтого["СуммаФактРУ"];
		ИтогоУчет = ИтогоУчет + СуммаУчет;
		
		// Расшифровка фактического наличия д/с:
		ШаблонПереченьВалют	= НСтр("ru=' (в том числе валюта %1)'");
		ШаблонВалюта		= НСтр("ru='%1 на сумму %2руб.'");
		ТекстПрефикс1		= "";
		ТекстПрефикс2N		= "; ";
		
		ЭтоПерваяИностраннаяВалюта = Истина;
		Выборка = ВыборкаИтого.Выбрать();
		Пока Выборка.Следующий() Цикл
			ВывестиВалюту = НЕ Выборка["ЭтоРубли"]
				И (НЕ Выборка["СуммаФакт"] = 0 ИЛИ НЕ Выборка["СуммаФактРУ"] = 0);
			Если ВывестиВалюту Тогда
				Если ЭтоПерваяИностраннаяВалюта Тогда
					ТекстПрефикс = ТекстПрефикс1;
					ЭтоПерваяИностраннаяВалюта = Ложь;
				Иначе
					ТекстПрефикс = ТекстПрефикс2N;
				КонецЕсли;
				
				ТекстПереченьВалют = ТекстПереченьВалют
					+ ТекстПрефикс
					+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВалюта,
						Формат(Выборка["СуммаФакт"], "ЧГ=0; ЧДЦ=2") + Символы.НПП + Выборка["Валюта"],
						Формат(Выборка["СуммаФактРУ"], "ЧГ=0; ЧДЦ=2") + Символы.НПП);
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекстПереченьВалют) Тогда
			ТекстПереченьВалют = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПереченьВалют, ТекстПереченьВалют);
		КонецЕсли;
	КонецЕсли;
	ВидЦенности = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ВидЦенности, ТекстПереченьВалют);
	// Записываем полученную строку в табл.часть:
	ТаблЧасть.Очистить();
	СтрокаТЧ = ТаблЧасть.Добавить();
	СтрокаТЧ["ВидЦенности"]	= ВидЦенности;
	СтрокаТЧ["Сумма"]		= СуммаФакт;
	
	// [4]. Результаты инвентаризации денежных документов.
	Если ЗаполняемыйДокумент["УчитыватьФК"] Тогда
		
		ВыборкаИтого = РезультатыЗаполнения[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если ВыборкаИтого.Следующий() Тогда
			// Обновляем итоговые значения:
			СуммаУчет = ВыборкаИтого["СуммаУчет"];
			ИтогоУчет = ИтогоУчет + СуммаУчет;
			
			Выборка = ВыборкаИтого.Выбрать();
			Пока Выборка.Следующий() Цикл
