		ТекстСообщения = НСтр("ru='Заполнить поле ""Сумма по факту"" значением из ""Сумма по учету""?'");
	КонецЕсли;
	
	Если СледуетПоказатьВопрос Тогда
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДС_ФактическоеНаличие_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьДС_ФактическоеНаличиеСервер();
	КонецЕсли;
	
