// Курсы валют

&НаКлиенте
Процедура ПолучитьНовыйКурс()
	
	// Для строки таблицы "Денежные средства":
	ТекДанные = Элементы.ДенежныеСредства.ТекущиеДанные;
	
	КурсВалюты = ПолучитьКурсВалюты(ТекДанные.Валюта, Объект.ДатаИнвентаризации);
	ТекДанные.Курс		= КурсВалюты.Курс;
	ТекДанные.Кратность	= КурсВалюты.Кратность;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеПараметровВалюты()
	
	// Для строки таблицы "Денежные средства":
	ТекДанные = Элементы.ДенежныеСредства.ТекущиеДанные;
	
	// Доступность элементов "Курс" и "Кратность":
	НастроитьДоступностьЭлементовБлокаВалюты();
	
	// Обновляем суммы в валюте регл.учета в текущей строке:
	ОбновитьСуммыРУ("Валюта");
	
КонецПроцедуры

// Для валюты Регл.Учета отключает редактирование курса, кратности и рублевых сумм.
&НаКлиенте
Процедура НастроитьДоступностьЭлементовБлокаВалюты()
	
	// Для строки таблицы "Денежные средства":
	ТекДанные = Элементы.ДенежныеСредства.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоВалютаРУ = (ТекДанные.Валюта = ВалютаРУ);
	
	// Колонки в таблице "Денежные средства":
	Элементы.ДенежныеСредстваКурс.ТолькоПросмотр		= ЭтоВалютаРУ;
	Элементы.ДенежныеСредстваКратность.ТолькоПросмотр	= ЭтоВалютаРУ;
	Элементы.ДенежныеСредстваСуммаУчетРУ.ТолькоПросмотр	= ЭтоВалютаРУ;
	Элементы.ДенежныеСредстваСуммаФактРУ.ТолькоПросмотр	= ЭтоВалютаРУ;
	Элементы.ДенежныеСредстваНедостачаРУ.ТолькоПросмотр	= ЭтоВалютаРУ;
	Элементы.ДенежныеСредстваИзлишекРУ.ТолькоПросмотр	= ЭтоВалютаРУ;
	
КонецПроцедуры
	
// ИмяПоля="Валюта",
&НаКлиенте
Процедура ОбновитьСуммыРУ(ИмяПоля)
	
	Если ИспользоватьВалютныйУчет Тогда
		// Для строки таблицы "Денежные средства":
		ТекДанные = Элементы.ДенежныеСредства.ТекущиеДанные;
		
		ЭтоВалюта = (ИмяПоля="Валюта" ИЛИ ИмяПоля="Курс" ИЛИ ИмяПоля="Кратность");
		
		ОбновитьСуммаУчетРУ = (ИмяПоля = "СуммаУчет") ИЛИ ЭтоВалюта;
		ОбновитьСуммаФактРУ = (ИмяПоля = "СуммаФакт") ИЛИ ЭтоВалюта;
		
		Множитель = ?(ТекДанные.Кратность = 0, 0, ТекДанные.Курс / ТекДанные.Кратность);
		
		Если ОбновитьСуммаУчетРУ Тогда
			ТекДанные.СуммаУчетРУ	= ТекДанные.СуммаУчет * Множитель;
		КонецЕсли;
		
		Если ОбновитьСуммаФактРУ Тогда
			ТекДанные.СуммаФактРУ	= ТекДанные.СуммаФакт * Множитель;
		КонецЕсли;
		
		// Обновляем НедостачуРУ и ИзлишекРУ.
		
		// <Показатель>УчетРУ - <Показатель>ФактРУ:
		ДельтаРУ = ТекДанные["СуммаУчетРУ"] - ТекДанные["СуммаФактРУ"];
		
		// НедостачаРУ:
		ТекДанные["НедостачаРУ"] = ?(ДельтаРУ>0, ДельтаРУ, 0);
		// ИзлишекРУ:
		ТекДанные["ИзлишекРУ"] = ?(ДельтаРУ<0, -ДельтаРУ, 0);
	Иначе
		Дельта = ДСУчет - ДСФакт;
		
		ДСНедостача	= ?(Дельта>0, Дельта, 0);
		ДСИзлишек	= ?(Дельта<0, -Дельта, 0);
	КонецЕсли;
	
КонецПроцедуры

//---
// Редактирование номеров последних кассовых документов

&НаСервере
Процедура НомерКассовогоДокумента_Инициализация()
	
	// Различные типы у поля "ПоследнийРКО"
	ВремСписок = Новый СписокЗначений();
	ВремСписок.Добавить("Документ.ВедомостьНаВыдачуДенегИзКассы.ФормаВыбора",	Метаданные.Документы.ВедомостьНаВыдачуДенегИзКассы.Синоним);
	ВремСписок.Добавить("Документ.РасходныйКассовыйОрдер.ФормаВыбора",			Метаданные.Документы.РасходныйКассовыйОрдер.Синоним);
	
	// Имена открываемых форм документов
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("ПоследнийПКОНомер", "Документ.ПриходныйКассовыйОрдер.ФормаВыбора");
	ВремСоответствие.Вставить("ПоследнийРКОНомер", ВремСписок);
	ВремСоответствие.Вставить("ПоследнийПОФНомер", "Документ.ПриходныйОрдерФондовый.ФормаВыбора");
	ВремСоответствие.Вставить("ПоследнийРОФНомер", "Документ.РасходныйОрдерФондовый.ФормаВыбора");
	
	ИменаФормДокументов = Новый ФиксированноеСоответствие(ВремСоответствие);
	
КонецПроцедуры

&НаКлиенте
Функция НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент)
	
	ИмяЭлемента = Элемент.Имя;
	
	ИменаРеквизитов = Новый Структура();
	ИменаРеквизитов.Вставить("ДокументСсылка", СтрЗаменить(ИмяЭлемента, "Номер", ""));
	ИменаРеквизитов.Вставить("НомерДокумента", ИмяЭлемента);
	
	Возврат ИменаРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура НомерКассовогоДокумента_ПриИзменении(Элемент)
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	ДокументСсылка = Объект[ИменаРеквизитов["ДокументСсылка"]];
	ВведенныйНомер = Объект[ИменаРеквизитов["НомерДокумента"]];
	
	ОчиститьСсылку = ПустаяСтрока(ВведенныйНомер)
		ИЛИ НЕ НомерКассовогоДокумента_НомераОдинаковые(ДокументСсылка, ВведенныйНомер);
	
	Если ОчиститьСсылку Тогда
		Объект[ИменаРеквизитов["ДокументСсылка"]] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ПриНачалеВыбора(Элемент)
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	КассовыйДокументСсылка	= Объект[ИменаРеквизитов["ДокументСсылка"]];
	
	ИмяОткрываемойФормы = ИменаФормДокументов.Получить(Элемент.Имя);
	
	Если ТипЗнч(ИмяОткрываемойФормы) = Тип("СписокЗначений") Тогда
		ЗаголовокДиалога = НСтр("ru='Выбор типа данных'");
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("КассовыйДокументСсылка",	КассовыйДокументСсылка);
		ПараметрыОповещения.Вставить("Элемент",					Элемент);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НомерКассовогоДокумента_ПриНачалеВыбора_Выбор", ЭтотОбъект, ПараметрыОповещения);
		
		ИмяОткрываемойФормы.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗавершении, ЗаголовокДиалога);
	Иначе
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ПриНачалеВыбора_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда
		ИмяОткрываемойФормы = РезультатВыбора.Значение;
		
		НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, ПараметрыОповещения["КассовыйДокументСсылка"], ПараметрыОповещения["Элемент"]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ОткрытьФормуВыбораДокумента(ИмяОткрываемойФормы, КассовыйДокументСсылка, Элемент)
	
	ПериодДляСписка = Новый СтандартныйПериод();
	ПериодДляСписка.ДатаОкончания = Объект["ДатаИнвентаризации"];
	
	Отбор = Новый Структура();
	Отбор.Вставить("Период",		ПериодДляСписка);
	Отбор.Вставить("Проведен",		Истина);
	Отбор.Вставить("Организация",	Объект["Организация"]);
	Если ИспользоватьУчетПоИФО И ЗначениеЗаполнено(Объект["ИФО"]) Тогда
		Отбор.Вставить("ИФО", Объект["ИФО"]);
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(Объект["Подразделение"]) Тогда
		Отбор.Вставить("Подразделение", Объект["Подразделение"]);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор",			Отбор);
	ПараметрыФормы.Вставить("ТекущаяСтрока",	КассовыйДокументСсылка);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИменаРеквизитов = НомерКассовогоДокумента_ПолучитьИменаРеквизитов(Элемент);
	
	Объект[ИменаРеквизитов["ДокументСсылка"]] = ВыбранноеЗначение;
	
	Объект[ИменаРеквизитов["НомерДокумента"]] = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НомерКассовогоДокумента_НомераОдинаковые(ДокументСсылка, ВведенныйНомер)
	
	// Считаем номера одинаковыми с точностью до префикса, возможно удаленного настройкой
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ПустаяСтрока(ВведенныйНомер);
	КонецЕсли;
	
	ТекущийНомер = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка);
	
	НовыйНомер = НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка, ВведенныйНомер);
	
	Возврат (ТекущийНомер = НовыйНомер);
	
КонецФункции

&НаСервереБезКонтекста
Функция НомерКассовогоДокумента_ПолучитьНомерНаПечать(ДокументСсылка, НомерДокумента = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НомерДокумента = Неопределено Тогда
		НомерДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер");
	КонецЕсли;
	
	Возврат	РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		ДокументСсылка, НомерДокумента);
	
КонецФункции

&НаКлиенте
Процедура НомерКассовогоДокумента_Определить()
	
	НомераПоследнихДокументовУжеЗаполнены =
			ЗначениеЗаполнено(Объект["ПоследнийПКОНомер"])
		ИЛИ ЗначениеЗаполнено(Объект["ПоследнийРКОНомер"])
		ИЛИ ЗначениеЗаполнено(Объект["ПоследнийПОФНомер"])
		ИЛИ ЗначениеЗаполнено(Объект["ПоследнийРОФНомер"]);
		
	Если НомераПоследнихДокументовУжеЗаполнены Тогда
		ТекстСообщения = НСтр("ru='Номера последних кассовых документов будут определены автоматически.
			|Продолжить?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("НомерКассовогоДокумента_Определить_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		НомерКассовогоДокумента_ОпределитьСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерКассовогоДокумента_Определить_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		НомерКассовогоДокумента_ОпределитьСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НомерКассовогоДокумента_ОпределитьСервер()
	
	Фондовые = Неопределено;
	
	ПоследниеОрдера = Документы.ИнвентаризацияКассы.НомерКассовогоДокумента_ПолучитьПоследниеПроведенныеОрдераСервер(
		Объект["Организация"],
		Объект["Подразделение"],
		Объект["ДатаИнвентаризации"],
		Объект["ИФО"],
		Фондовые);
		
	ЗаполнитьЗначенияСвойств(Объект, ПоследниеОрдера);
	
КонецПроцедуры

// РешениеОПроведенииИнвентаризации
&НаКлиенте
Процедура ЗакрытаФормаВыбораДанныхИзРешенияОПроведенииИнвентаризации(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора);
	
	ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписьПоРешениюОПроведенииИнвентаризацииСервер(РезультатВыбора)
	
	ИнвентаризацияСервер.ЗаполнитьОписьПоРешениюИзФормыОписи(ЭтаФорма, РезультатВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаполненияОписиПоРешениюОПроведенииИнвентаризацииКлиент(РезультатВыбора)
	
	ИнвентаризацияКлиент.СообщитьОЗаполненииНаОснованииРешенияОПроведенииИнвентаризации();
	
КонецПроцедуры
