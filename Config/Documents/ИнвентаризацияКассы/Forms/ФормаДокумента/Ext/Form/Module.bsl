&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО()
	
	Если Не НеобходимыеРеквизитыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не МестоИнвентаризацииСоответствуетЦМОКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект["СоставБСО"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Перед заполнением по данным учета
			|табличная часть ""Результаты инвентаризации БСО""
			|будет очищена.	
			|
			|Продолжить и очистить?'");
			
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьБСО_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьБСОКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьБСОКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьБСОКлиент()
	
	РезультатЗадания = ЗаполнитьБСОСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗаполнитьБСОКлиент_ЗавершениеФоновогоЗадания", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьБСОКлиент_ЗавершениеФоновогоЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	Перем СообщениеОбОшибке;
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗаполнитьБСОСервер_ЗавершениеФоновогоЗадания(Результат.АдресРезультата, СообщениеОбОшибке);
		
		Если СообщениеОбОшибке <> Неопределено Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СообщениеОбОшибке.ТекстСообщения,
				Объект.Ссылка,
				"Объект.СоставБСО[" + СообщениеОбОшибке.ИндексСтрокиТекст + "].КоличествоУчет");
				
		ИначеЕсли Объект["СоставБСО"].Количество() = 0 Тогда
			
			ТекстСообщения = НСтр("ru='Остатки БСО, соответствующие условиям поиска, отсутствуют'");
			ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При поиске остатков БСО возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьБСОСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Поиск остатков БСО'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыПоискаОстатковБСО();
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.ИнвентаризацияКассы.ПолучитьОстатки_БСО",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьБСОСервер_ЗавершениеФоновогоЗадания(Знач АдресРезультата, СообщениеОбОшибке)
	
	РезультатыПоиска = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект["СоставБСО"].Загрузить(РезультатыПоиска);
	
	Объект["НеобходимоРассчитатьРасхожденияБСО"] = Ложь;
	
	Поиск = Новый Структура("ОшибкаУчета", Истина);
	
	НомераСтрок = Объект["СоставБСО"].Выгрузить(Поиск, "НомерСтроки").ВыгрузитьКолонку("НомерСтроки");
	
	Если НомераСтрок.Количество() > 0 Тогда
		
		Если НомераСтрок.Количество() = 1 Тогда
			ШаблонСтроки = НСтр("ru='строку %1'");
		Иначе
			ШаблонСтроки = НСтр("ru='строки %1'");
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Обнаружены ошибки учета номеров бланков (см. %1)
			|Например:
			| - отрицательный остаток
			| - остаток больше единицы (несколько поступлений по одному номеру)'"),
			ШаблонСтроки);
		
		ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстСообщения, НомераСтрок, 200, "%1");
		
		ИндексСтроки = НомераСтрок[0] - 1;
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		СообщениеОбОшибке = Новый Структура();
		СообщениеОбОшибке.Вставить("ТекстСообщения", ТекстСообщения);
		СообщениеОбОшибке.Вставить("ИндексСтрокиТекст", ИндексСтрокиТекст);
		
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Функция ПолучитьПараметрыПроцедурыПоискаОстатковБСО()
	
	Поиск = Новый Структура("НомерСтроки", -1);
	
	ПустаяТабличнаяЧасть = Объект.СоставБСО.Выгрузить(Поиск);
	
	ПараметрыПроцедуры = Новый Структура("
		|ДатаИнвентаризации,
		|Организация,
		|Подразделение,
		|МОЛ,
		|ИФО,
		|БезУчетаИФО,
		|СчетУчетаБСО,
		|МестоИнвентаризации");
	
	ЗаполнитьЗначенияСвойств(ПараметрыПроцедуры, Объект);
	
	ПараметрыПроцедуры.Вставить("ТабличнаяЧасть", ПустаяТабличнаяЧасть);
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

