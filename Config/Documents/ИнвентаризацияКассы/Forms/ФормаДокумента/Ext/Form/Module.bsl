#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставБСО

&НаКлиенте
Процедура СоставБСОПриИзменении(Элемент)
	
	// Признак необходимости рассчитать излишки/недостачи БСО,
	// т.к. исходные данные изменились
	//(используется в условном оформлении формы):
	Объект["НеобходимоРассчитатьРасхожденияБСО"] = Истина;
	
	// Обновляем длины номеров записанного БСО во всех таблицах:
	Если ТипЗнч(ОбновитьДлиныНомеровБСО_Параметр) = Тип("Структура") Тогда
		
		// Обновляем длины номеров, а также представления номеров:
		ОбновитьДлиныНомеровБСОСервер(ОбновитьДлиныНомеровБСО_Параметр);
		
		// Сбрасываем флаг:
		ОбновитьДлиныНомеровБСО_Параметр = Неопределено;
		
		//
		// Маски ввода для полей ввода номеров БСО
		//
		// Табл.часть "Состав БСО":
		ТекДанные = Элементы["СоставБСО"].ТекущиеДанные;
		Если НЕ ТекДанные = Неопределено Тогда
			УстановитьМаскуПолейПорядковогоНомера(ТекДанные, "СоставБСО", "НачальныйНомерФакт", "КонечныйНомерФакт");
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоставБСОВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// Ошибка учета БСО - остаток количества БСО >1 или < -1.
	// Если щелкнули на полях "По данным учета" и строка содержит данные, содержащие
	// ошибку учета количества БСО, то выводим сообщение.
	ТекДанные = Элементы["СоставБСО"].ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Если
			ТекДанные["ОшибкаУчета"]
			И	(Поле.Имя = "СоставБСОБСО"
				ИЛИ Поле.Имя = "СоставБСОСерия"
				ИЛИ Поле.Имя = "СоставБСОНачальныйНомерУчетПредставление"
				ИЛИ Поле.Имя = "СоставБСОКонечныйНомерУчетПредставление"
				ИЛИ Поле.Имя = "СоставБСОКоличествоУчет"
				ИЛИ Поле.Имя = "СоставБСОНедостача"
				ИЛИ Поле.Имя = "СоставБСОИзлишек"
				)
			Тогда
			
			КоличествоНорма = ТекДанные["КонечныйНомерУчет"] - ТекДанные["НачальныйНомерУчет"] + 1;
			КоличествоУчет = ТекДанные["КоличествоУчет"];
			МножительКоличества = ?(КоличествоНорма = 0,
				КоличествоУчет,	// исключаем деление на 0.
				КоличествоУчет / КоличествоНорма);
				
			Текст = НСтр("ru='Ошибка учета БСО - остаток количества каждого номера (из указанного диапазона) равен %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, МножительКоличества);
			ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура СоставБСОПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы["СоставБСО"].ТекущиеДанные;
	
	// При копировании очищаем поля, заполняемые по данным учета:
	Если Копирование Тогда
		ОчищающаяСтруктура = Новый Структура("
			|НачальныйНомерУчет,
			|КонечныйНомерУчет,
			|НачальныйНомерУчетПредставление,
			|КонечныйНомерУчетПредставление,
			|КоличествоУчет,
			|ОшибкаУчета,
			|Недостача,
			|Излишек");
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	РедактируемаяСтрока = Новый Структура("БСО, Серия,
		|НачальныйНомерФакт, НачальныйНомерФактПредставление,
		|КонечныйНомерФакт, КонечныйНомерФактПредставление,
		|КоличествоФакт, Недостача, Излишек,
		|ДлинаНомера");
	ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, ТекДанные);
	
	
	// Устанавливаем маску ввода для полей ввода номеров БСО:
	УстановитьМаскуПолейПорядковогоНомера(ТекДанные,
		"СоставБСО",
		"НачальныйНомерФакт",
		"КонечныйНомерФакт");
	
КонецПроцедуры
&НаКлиенте
Процедура СоставБСОПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы["СоставБСО"].ТекущиеДанные;
	
	Если ОтменаРедактирования Тогда
		
		Если НЕ НоваяСтрока Тогда
