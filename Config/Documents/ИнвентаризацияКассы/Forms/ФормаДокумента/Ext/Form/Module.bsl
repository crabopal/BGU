&НаКлиенте
Процедура ПроверитьИЗаполнитьДС()
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		Если ИспользоватьВалютныйУчет Тогда
			СледуетПоказатьВопрос = (Объект["ДенежныеСредства"].Количество() > 0);
			ТекстСообщения = НСтр("ru='Перед заполнением по данным учета
				|табличная часть ""Результаты инвентаризации наличных средств""
				|будет очищена.	
				|
				|Продолжить и очистить?'");
		Иначе
			СледуетПоказатьВопрос = НЕ (ДСУчет = 0 И ДСФакт = 0);
			ТекстСообщения = НСтр("ru='Продолжить и заполнить по данным учета?'");
		КонецЕсли;
		
		Если СледуетПоказатьВопрос Тогда
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДС_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьДСКлиент();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьДС_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДСКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьДСКлиент()
	
	ЗаполнитьДССервер();
	
	// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
	Если ИспользоватьВалютныйУчет Тогда
		СледуетПоказатьСообщение = (Объект["ДенежныеСредства"].Количество() = 0);
	Иначе
		СледуетПоказатьСообщение = (ДСУчет = 0 И ДСФакт = 0);
	КонецЕсли;
	
	Если СледуетПоказатьСообщение Тогда
		ТекстСообщения = НСтр("ru='Остатки наличных денежных средств, соответствующие условиям поиска, отсутствуют'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьДССервер()
	
	// Заполняем табличную часть:
	Документы.ИнвентаризацияКассы.ЗаполнитьТаблицу_ДС(Объект);
	
	ГруппаДенежныеСредства_ПрочитатьИзТабличнойЧасти();
	
	// Обновляем дельты, если необходимо:
	Если ОтображатьСоветДС Тогда
		ЗаполнитьДельтыДС();
	КонецЕсли;
	
	// Обновляем последние кассовые документы
	Фондовые = Ложь;
	
	ПоследниеОрдера = Документы.ИнвентаризацияКассы.НомерКассовогоДокумента_ПолучитьПоследниеПроведенныеОрдераСервер(
		Объект["Организация"],
		Объект["Подразделение"],
		Объект["ДатаИнвентаризации"],
		Объект["ИФО"],
		Фондовые);
		
	ЗаполнитьЗначенияСвойств(Объект, ПоследниеОрдера);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьДС_Расхождение(ЭтоНедостача)
	
	// Входная проверка:
	Если НЕ ЭтоНедостача = Ложь Тогда
		ЭтоНедостача = Истина;
	КонецЕсли;
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		
		// Подготовка:
		Если ЭтоНедостача Тогда
			ИмяТаблЧасти = "ДенежныеСредстваНедостачи";
			ПредставлениеТаблЧасти = НСтр("ru='""Недостачи"" денежных средств'");
			ТекстСообщенияРасхождениеОтсутствует = НСтр("ru='Недостачи наличных денежных средств отсутствуют в таблице ""Наличные средства"".'");
		Иначе
			ИмяТаблЧасти = "ДенежныеСредстваИзлишки";
			ПредставлениеТаблЧасти = НСтр("ru='""Излишки"" денежных средств'");
			ТекстСообщенияРасхождениеОтсутствует = НСтр("ru='Излишки наличных денежных средств отсутствуют в таблице ""Наличные средства"".'");
		КонецЕсли;
		
		ОписаниеРасхождения = Новый Структура();
		ОписаниеРасхождения.Вставить("ЭтоНедостача",							ЭтоНедостача);
		ОписаниеРасхождения.Вставить("ИмяТаблЧасти",							ИмяТаблЧасти);
		ОписаниеРасхождения.Вставить("ПредставлениеТаблЧасти",					ПредставлениеТаблЧасти);
		ОписаниеРасхождения.Вставить("ТекстСообщенияРасхождениеОтсутствует",	ТекстСообщенияРасхождениеОтсутствует);
		
		Если Объект[ИмяТаблЧасти].Количество() > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Перед заполнением по данным учета
					|табличная часть %1
					|будет очищена.	
					|
					|Продолжить и очистить?'"),
				ПредставлениеТаблЧасти);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДС_Расхождение_Выбор", ЭтотОбъект, ОписаниеРасхождения);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьДС_РасхождениеКлиент(ОписаниеРасхождения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьДС_Расхождение_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДС_РасхождениеКлиент(ПараметрыОповещения);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьДС_РасхождениеКлиент(ОписаниеРасхождения)
	
	Перем	ЭтоНедостача,
			ИмяТаблЧасти,
			ПредставлениеТаблЧасти,
			ТекстСообщенияРасхождениеОтсутствует;
			
	ОписаниеРасхождения.Свойство("ЭтоНедостача",							ЭтоНедостача);
	ОписаниеРасхождения.Свойство("ИмяТаблЧасти",							ИмяТаблЧасти);
	ОписаниеРасхождения.Свойство("ПредставлениеТаблЧасти",					ПредставлениеТаблЧасти);
	ОписаниеРасхождения.Свойство("ТекстСообщенияРасхождениеОтсутствует",	ТекстСообщенияРасхождениеОтсутствует);
	
	ЗаполнениеВыполнено = ЗаполнитьДС_РасхождениеСервер(ЭтоНедостача);
	
	Если ЗаполнениеВыполнено Тогда
		// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
		Если Объект[ИмяТаблЧасти].Количество() = 0 Тогда
			ПоказатьПредупреждение(, ТекстСообщенияРасхождениеОтсутствует, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
	Иначе
		// Заполнение не было выполнено.
		Текст = НСтр("ru='Не удалось заполнить таблицу %1, т.к. таблица ""Наличные средства"" заполнена с ошибками.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПредставлениеТаблЧасти);
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Функция ЗаполнитьДС_РасхождениеСервер(ЭтоНедостача)
	
	ГруппаДенежныеСредства_ЗаписатьВТабличнуюЧасть(Объект);
	
	// Заполняем табличную часть:
	Результат = Документы.ИнвентаризацияКассы.ЗаполнитьТаблицу_ДС_Расхождение(Объект, ЭтоНедостача);
	
	// Рассчитываем дельты недостач и излишков (если указано):
	Если ОтображатьСоветДС Тогда
		ЗаполнитьДельтыДС();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

