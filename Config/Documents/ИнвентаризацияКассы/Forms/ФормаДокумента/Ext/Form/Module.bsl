&НаСервере
Процедура НастроитьФормуСервер()
	
	// Инициализация:
	ИспользоватьУчетПоИФО				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьВалютныйУчет			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	КоличественныйУчетДД				= ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов");
	ВалютаРУ							= Константы.ВалютаРегламентированногоУчета.Получить();
	ТекстКассовыйДокументОтсутствует	= НСтр("ru='<отсутствует>'");
	
	// Для нового документа заполняем по возможности пустые поля.
	Если Объект.Ссылка.Пустая() Тогда
		
		// Этот документ создан копированием?
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			// Это копия существующего документа.
			// Очищаем некоторые реквизиты:
			ОчищающаяСтруктура = Новый Структура("
				|ПоследнийРКО,
				|ПоследнийПКО,
				|ПоследнийРОФ,
				|ПоследнийПОФ,
				|ПоследнийРКОНомер,
				|ПоследнийПКОНомер,
				|ПоследнийРОФНомер,
				|ПоследнийПОФНомер");
			ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
			// И табличные части:
			Объект["ДенежныеСредства"].Очистить();
			Объект["ДенежныеСредстваНедостачи"].Очистить();
			Объект["ДенежныеСредстваИзлишки"].Очистить();
			Объект["ДенежныеДокументы"].Очистить();
			Объект["ДенежныеДокументыНедостачи"].Очистить();
			Объект["ДенежныеДокументыИзлишки"].Очистить();
			Объект["СоставБСО"].Очистить();
			Объект["СоставБСОНедостачи"].Очистить();
			Объект["СоставБСОИзлишки"].Очистить();
			
			// Выводим сообщение:	
			ТекстСообщения = НСтр("ru='Этот документ был создан путем копирования другого документа. Поэтому некоторые табличные части и реквизиты копии были очищены.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
				Объект.Ссылка);
		Иначе
			// Это совсем новый документ.
			
		КонецЕсли;
		
	КонецЕсли;
	
	//---
	// Флажок <без ограничения>
	//---
	НастройкиМеханизма = Документы.ИнвентаризацияКассы.ФлажокБезОграничения_ПолучитьНастройкиМеханизма();
	ОбщегоНазначенияБГУ.ФлажокБезОграничения_ИнициализироватьФорму(ЭтаФорма, НастройкиМеханизма);
	
	//---
	// Редактирование номеров последних кассовых документов
	//---
	// (Расположить обязательно ПОСЛЕ возможной очистки документа при копировании)
	НомерКассовогоДокумента_Инициализация();
	
	// Настраиваем видимость колонок "Совет".
	
	// Денежные средства:
	Если ОтображатьСоветДС Тогда
		ЗаполнитьДельтыДС();
	Иначе
		НастроитьФормуОтображатьСоветДССервер();
	КонецЕсли;
	// Денежные документы:
	Если ОтображатьСоветДД Тогда
		ЗаполнитьДельтыДД();
	Иначе
		НастроитьФормуОтображатьСоветДДСервер();
	КонецЕсли;
	
	// Количество документов, введенных на основании
	ОпределитьКоличествоДокументовВведенныхНаОсновании();
	
	НастроитьФормуСервер_ВидимостьКолонокПодразделение();
	
	НастроитьВидимостьИтоговКоличестваДД();
	
	// Учтем ведение валютного учета
	ГруппаДенежныеСредства_ПрочитатьИзТабличнойЧасти();
	Элементы["ГруппаДенежныеСредстваТолькоРубли"].Видимость		= НЕ ИспользоватьВалютныйУчет;
	Элементы["ГруппаДенежныеСредстваРазличныеВалюты"].Видимость	= ИспользоватьВалютныйУчет;
	Элементы["ДенежныеСредстваНедостачиВалюта"].Видимость		= ИспользоватьВалютныйУчет;
	Элементы["ДенежныеСредстваИзлишкиВалюта"].Видимость			= ИспользоватьВалютныйУчет;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьИтоговКоличестваДД()
	
	Элементы["ДенежныеДокументыИтогоФактКоличество"].Видимость		= КоличественныйУчетДД;
	Элементы["ДенежныеДокументыИтогоУчетКоличество"].Видимость		= КоличественныйУчетДД;
	Элементы["ДенежныеДокументыИтогоНедостачиКоличество"].Видимость	= КоличественныйУчетДД;
	Элементы["ДенежныеДокументыИтогоИзлишкиКоличество"].Видимость	= КоличественныйУчетДД;
	
	Элементы["ДенежныеДокументыНедостачиИтогоКоличество"].Видимость	= КоличественныйУчетДД;
	
	Элементы["ДенежныеДокументыИзлишкиИтогоКоличество"].Видимость	= КоличественныйУчетДД;
	
КонецПроцедуры

&НаСервере
Процедура ГруппаДенежныеСредства_ПрочитатьИзТабличнойЧасти()
	
	// Переносим данные о денежных средствах из табличной части в отдельные поля
	Если НЕ ИспользоватьВалютныйУчет Тогда
		
		ТаблЧасть = Объект["ДенежныеСредства"];
		
		Поиск = Новый Структура("Валюта", ВалютаРУ);
		МассивСтрок = ТаблЧасть.НайтиСтроки(Поиск);
		СтрокаТаблицы = Неопределено;
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы = МассивСтрок[0];
		Иначе
			Поиск = Новый Структура("Валюта", Справочники.Валюты.ПустаяСсылка());
			МассивСтрок = ТаблЧасть.НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТаблицы = МассивСтрок[0];
			КонецЕсли;
		КонецЕсли;
		Если СтрокаТаблицы = Неопределено Тогда
			ДСУчет = 0;
			ДСФакт = 0;
		Иначе
			ДСУчет = СтрокаТаблицы["СуммаУчет"];
			ДСФакт = СтрокаТаблицы["СуммаФакт"];
		КонецЕсли;
		
		Дельта = ДСУчет - ДСФакт;
		
		ДСНедостача	= ?(Дельта>0, Дельта, 0);
		ДСИзлишек	= ?(Дельта<0, -Дельта, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГруппаДенежныеСредства_ЗаписатьВТабличнуюЧасть(ТекущийОбъект)
	
	// Переносим данные о денежных средствах из отдельных полей в табличную часть
	Если НЕ ИспользоватьВалютныйУчет Тогда
		ТаблЧасть = ТекущийОбъект["ДенежныеСредства"];
		ТаблЧасть.Очистить();
		Если НЕ (ДСУчет = 0 И ДСФакт = 0) Тогда
			НоваяСтрока = ТаблЧасть.Добавить();
			НоваяСтрока["Валюта"]		= ВалютаРУ;
			НоваяСтрока["Курс"]			= 1;
			НоваяСтрока["Кратность"]	= 1;
			НоваяСтрока["СуммаУчет"]	= ДСУчет;
			НоваяСтрока["СуммаУчетРУ"]	= ДСУчет;
			НоваяСтрока["СуммаФакт"]	= ДСФакт;
			НоваяСтрока["СуммаФактРУ"]	= ДСФакт;
			НоваяСтрока["Недостача"]	= ДСНедостача;
			НоваяСтрока["НедостачаРУ"]	= ДСНедостача;
			НоваяСтрока["Излишек"]		= ДСИзлишек;
			НоваяСтрока["ИзлишекРУ"]	= ДСИзлишек;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент()
	
	ВыборБСООбработан = Ложь;

	// Доступность редактируемой таблицы:
	Элементы.Страницы.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
	НастроитьФормуКлиент_ПараметрыВыбораЦМОдляРасхожденийБСО();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение = Неопределено)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	
	ТекстСообщения = НСтр("ru='Изменение организации вызовет полную очистку
		|табличной части документа и некоторых полей шапки.
		|
		|Продолжить и сменить организацию?'");
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОрганизацияПередИзменениемКлиент_Ответ", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПередИзменениемКлиент_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект["Организация"] = ПараметрыОповещения["ВыбранноеЗначение"];
		ЭтаФорма.Модифицированность = Истина;
		ОрганизацияПриИзмененииКлиент();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияПриИзмененииКлиент()
	
	ОрганизацияПриИзмененииСервер();
	
	НастроитьФормуКлиент();
	
КонецПроцедуры
&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ОчиститьРеквизитыНесоответствующиеОрганизации();
	
	НастроитьФормуСервер_ВидимостьКолонокПодразделение(Истина); //ОбновитьКолонкиПодразделение
	
КонецПроцедуры	
&НаСервере
Процедура ОчиститьРеквизитыНесоответствующиеОрганизации()
	
	// Очищаем реквизиты документа:
	ОчищающаяСтруктура = Новый Структура("
		|ПоследнийПКО,
		|ПоследнийРКО,
		|ПоследнийПОФ,
		|ПоследнийРОФ,
		|ПоследнийПКОНомер,
		|ПоследнийРКОНомер,
		|ПоследнийПОФНомер,
		|ПоследнийРОФНомер,
		|ДолжностьПредседателяКомиссии,
		|ФамилияПредседателяКомиссии,
		|ИмяПредседателяКомиссии,
		|ОтчествоПредседателяКомиссии,
		|НомерПриказа,
		|ДатаПриказа");
	ЗаполнитьЗначенияСвойств(Объект, ОчищающаяСтруктура);
	
	// Очищаем реквизиты формы.
	// Номера последних проведенных кассовых документов:
	ОчищающаяСтруктура = Новый Структура("НомерПКО, НомерРКО, НомерПОФ, НомерРОФ");
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ОчищающаяСтруктура);
	
	// Очищаем табличные части документа:
	Объект.ДенежныеСредства.Очистить();
	Объект.ДенежныеСредстваИзлишки.Очистить();
	Объект.ДенежныеСредстваНедостачи.Очистить();
	
	Объект.ДенежныеДокументы.Очистить();
	Объект.ДенежныеДокументыИзлишки.Очистить();
	Объект.ДенежныеДокументыНедостачи.Очистить();
	
	Объект.СоставБСО.Очистить();
	Объект.СоставБСОИзлишки.Очистить();
	Объект.СоставБСОНедостачи.Очистить();
	
	Объект.СоставКомиссии.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьКоличествоДокументовВведенныхНаОсновании(РазделДокумента = Неопределено)
	
	ОбщееКоличествоДокументов = Документы.ИнвентаризацияКассы.ПолучитьКоличествоДокументовВведенныхНаОсновании(Объект, РазделДокумента);
	
	ИменаВсехНадписей = ПолучитьИменаНадписейОКоличествеДокументовВведенныхНаОсновании(РазделДокумента);
	
	Для Каждого ЭлементКоличество Из ОбщееКоличествоДокументов Цикл
		РазделДокумента			= ЭлементКоличество.Ключ;
		КоличествоДокументов	= ЭлементКоличество.Значение;
		
		ИмяНадписиВсего					= ИменаВсехНадписей[РазделДокумента]["Всего"];
		ИмяНадписиСписанийПоступлений	= ИменаВсехНадписей[РазделДокумента]["СписанийПоступлений"];
		
		// Количество документов
		КоличествоСписаний		= КоличествоДокументов["КоличествоСписаний"];
		КоличествоПоступлений	= КоличествоДокументов["КоличествоПоступлений"];
		
		// Надпись общее количество документов
		Элементы[ИмяНадписиВсего].Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='%1 шт.'"),
			КоличествоПоступлений + КоличествоСписаний);
			
		// Категории для русского языка:
		//	Ноль	(-);
		//	Один	(1 шт);
		//	Два		(-);
		//	Немного	(2 шт);
		//	Много	(5 шт);
		//	Другое	(-)
		
		// Надпись Х списаний
		НадписьСписания = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 списание;;%1 списания;%1 списаний;'"),
			КоличествоСписаний);
		
		// Надпись У поступлений
		НадписьПоступления = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru=';%1 поступление;;%1 поступления;%1 поступлений;'"),
			КоличествоПоступлений);
		
		// Надпись количество документов списаний и поступлений
		НовыйЗаголовок = ?((КоличествоСписаний + КоличествоПоступлений) > 0,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='(%1, %2)'"), НадписьСписания, НадписьПоступления),
			"");
			
		Элементы[ИмяНадписиСписанийПоступлений].Заголовок = НовыйЗаголовок;
			
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИменаНадписейОКоличествеДокументовВведенныхНаОсновании(Знач РазделДокумента = Неопределено)
	
	ИменаВсехНадписей = Новый Структура();
	
	Если РазделДокумента = "ДС" ИЛИ РазделДокумента = Неопределено Тогда
		ИменаНадписей = Новый Структура();
		ИменаНадписей.Вставить("Всего",					"ДекорацияДенежныеСредстваВсегоДокументов");
		ИменаНадписей.Вставить("СписанийПоступлений",	"ДекорацияДенежныеСредстваВсегоДокументовКон");
		ИменаВсехНадписей.Вставить("ДС", ИменаНадписей);
	КонецЕсли;
	
	Если РазделДокумента = "ДД" ИЛИ РазделДокумента = Неопределено Тогда
		ИменаНадписей = Новый Структура();
		ИменаНадписей.Вставить("Всего",					"ДекорацияДенежныеДокументыВсегоДокументов");
		ИменаНадписей.Вставить("СписанийПоступлений",	"ДекорацияДенежныеДокументыВсегоДокументовКон");
		ИменаВсехНадписей.Вставить("ДД", ИменаНадписей);
	КонецЕсли;
	
	Если РазделДокумента = "БСО" ИЛИ РазделДокумента = Неопределено Тогда
		ИменаНадписей = Новый Структура();
		ИменаНадписей.Вставить("Всего",					"ДекорацияБСОВсегоДокументов");
		ИменаНадписей.Вставить("СписанийПоступлений",	"ДекорацияБСОВсегоДокументовКон");
		ИменаВсехНадписей.Вставить("БСО", ИменаНадписей);
	КонецЕсли;
	
	Возврат ИменаВсехНадписей;
	
КонецФункции

&НаСервере
Процедура НастроитьФормуОтображатьСоветДССервер()
	
	// Режим выделения строк:
	НовРежимВыделения = ?(ОтображатьСоветДС,
		РежимВыделенияТаблицы.Одиночный,
		РежимВыделенияТаблицы.Множественный);
	Элементы.ДенежныеСредстваНедостачи.РежимВыделения	= НовРежимВыделения;
	Элементы.ДенежныеСредстваИзлишки.РежимВыделения		= НовРежимВыделения;
	
	// Видимость колонок "Совет":
	НовВидимость = ОтображатьСоветДС;
	Элементы.ДенежныеСредстваНедостачиГруппаСовет.Видимость	= НовВидимость;
	Элементы.ДенежныеСредстваИзлишкиГруппаСовет.Видимость	= НовВидимость;
	
	Элементы.КнопкаДС_Недостачи_Рассчитать.Видимость	= НовВидимость;
	Элементы.КнопкаДС_Излишки_Рассчитать.Видимость		= НовВидимость;
	
КонецПроцедуры
&НаСервере
Процедура НастроитьФормуОтображатьСоветДДСервер()
	
	// Режим выделения строк:
	НовРежимВыделения = ?(ОтображатьСоветДД,
		РежимВыделенияТаблицы.Одиночный,
		РежимВыделенияТаблицы.Множественный);
	Элементы.ДенежныеДокументыНедостачи.РежимВыделения	= НовРежимВыделения;
	Элементы.ДенежныеДокументыИзлишки.РежимВыделения	= НовРежимВыделения;
	
	// Видимость колонок "Совет":
	НовВидимость = ОтображатьСоветДД;
	Элементы.ДенежныеДокументыНедостачиГруппаСовет.Видимость			= НовВидимость;
	Элементы.ДенежныеДокументыИзлишкиГруппаСовет.Видимость				= НовВидимость;
	Элементы.ДенежныеДокументыНедостачиГруппаСоветКоличество.Видимость	= НовВидимость И КоличественныйУчетДД;
	Элементы.ДенежныеДокументыИзлишкиГруппаСоветКоличество.Видимость	= НовВидимость И КоличественныйУчетДД;
	
	Элементы.КнопкаДД_Недостачи_Рассчитать.Видимость	= НовВидимость;
	Элементы.КнопкаДД_Излишки_Рассчитать.Видимость		= НовВидимость;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДенежныйДокумент, "Владелец");
	
КонецФункции

&НаСервере
Процедура НастроитьФормуСервер_ВидимостьКолонокПодразделение(ОбновитьКолонкиПодразделение = Ложь)
	
	НоваяВидимость = НЕ ЗначениеЗаполнено(Объект["Подразделение"]);
	
	Элементы["ДенежныеСредстваНедостачиПодразделение"].Видимость	= НоваяВидимость;
	Элементы["ДенежныеСредстваИзлишкиПодразделение"].Видимость		= НоваяВидимость;
	Элементы["ДенежныеДокументыНедостачиПодразделение"].Видимость	= НоваяВидимость;
	Элементы["ДенежныеДокументыИзлишкиПодразделение"].Видимость		= НоваяВидимость;
	Элементы["СоставБСОНедостачиПодразделение"].Видимость			= НоваяВидимость;
	Элементы["СоставБСОИзлишкиПодразделение"].Видимость				= НоваяВидимость;
	
	Если ОбновитьКолонкиПодразделение Тогда
		ИменаТЧ = Новый Структура("
			|ДенежныеСредстваИзлишки,
			|ДенежныеСредстваНедостачи,
			|ДенежныеДокументыИзлишки,
			|ДенежныеДокументыНедостачи,
			|СоставБСОИзлишки,
			|СоставБСОНедостачи");
		Для Каждого Элем Из ИменаТЧ Цикл
			ТаблЧасть = Объект[Элем.Ключ];
			Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
				СтрокаТЧ["Подразделение"] = Объект["Подразделение"];
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуКлиент_ПараметрыВыбораЦМОдляРасхожденийБСО()
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Сотрудник", ПолучитьСотрудника(Объект.МОЛ));
	
	НовыйМассив = Новый Массив();
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	Элементы.СоставБСОИзлишкиЦМО.ПараметрыВыбора	= НовыеПараметры;
	Элементы.СоставБСОНедостачиЦМО.ПараметрыВыбора	= НовыеПараметры;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСотрудника(МОЛ)
	
	Возврат Документы.ИнвентаризацияКассы.ПолучитьСотрудника(МОЛ);
	
КонецФункции

&НаКлиенте
Процедура ОчиститьКолонкиЦМОдляРасхожденийБСО()
	
	ОчищающаяСтруктура = Новый Структура("ЦМО");
	
	МОЛ = Объект.МОЛ;
	
	Если ТипЗнч(МОЛ) = Тип("СправочникСсылка.ЦМО") Тогда
		ОчищающаяСтруктура.Вставить("ЦМО", МОЛ);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставБСОИзлишки Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставБСОНедостачи Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

//-----------------------------------------------------------------------------
// Представление номеров БСО

// Запускается при открытии формы и заполняет представления номеров БСО во всех таблицах формы.
&НаСервере
Процедура ЗаполнитьПредставленияНомеровБСО(ТолькоСоставБСО = Ложь)
	
	//
	// Табл.часть "Состав БСО"
	//
	ТаблЧасть = Объект["СоставБСО"];
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ТаблЧасть.Выгрузить().ВыгрузитьКолонку("БСО"),
		"ДлинаНомера");
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		Попытка
			ДлинаНомера = ЗначенияРеквизитов[СтрокаТЧ["БСО"]]["ДлинаНомера"];
		Исключение
			ДлинаНомера = 0;
		КонецПопытки;
		СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
		ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомерУчет", "КонечныйНомерУчет");
		ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомерФакт", "КонечныйНомерФакт");
	КонецЦикла;
	
	// В других табл.частях нужно обновлять представления номеров БСО?
	Если ТолькоСоставБСО Тогда
		Возврат;
	КонецЕсли;
	
	//
	// Табл.часть "Недостачи БСО"
	//
	ТаблЧасть = Объект["СоставБСОНедостачи"];
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ТаблЧасть.Выгрузить().ВыгрузитьКолонку("БСО"),
		"ДлинаНомера");
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		Попытка
			ДлинаНомера = ЗначенияРеквизитов[СтрокаТЧ["БСО"]]["ДлинаНомера"];
		Исключение
			ДлинаНомера = 0;
		КонецПопытки;
		СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
		ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомер", "КонечныйНомер");
	КонецЦикла;
	
	//
	// Табл.часть "Излишки БСО"
	//
	ТаблЧасть = Объект["СоставБСОИзлишки"];
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ТаблЧасть.Выгрузить().ВыгрузитьКолонку("БСО"),
		"ДлинаНомера");
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		Попытка
			ДлинаНомера = ЗначенияРеквизитов[СтрокаТЧ["БСО"]]["ДлинаНомера"];
		Исключение
			ДлинаНомера = 0;
		КонецПопытки;
		СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
		ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомер", "КонечныйНомер");
	КонецЦикла;
	
КонецПроцедуры

// ТекДанные	- текущая строка, должна иметь поля, указанные В ЗНАЧЕНИЯХ (а не ключах)
//				элементов структуры имен (см.далее)
// СтруктураИмен	- структура, должна иметь заполненные ключи:
//					ИмяТаблЧасти, НомерНач, НомерКон, Количество
// ОбозначениеИзмененногоПоля	- имя ОБОЗНАЧЕНИЯ того поля текущей строки, которое было изменено.
//								Является именем ключа структуры имен.
&НаКлиенте
Процедура НастроитьНомераИКоличествоБСОПриИзменении(ТекДанные, СтруктураИмен, ОбозначениеИзмененногоПоля)
	
	ИмяТаблЧасти = СтруктураИмен["ИмяТаблЧасти"];
	
	// Имена обрабатываемых далее полей текущей строки:
	ПостфиксИмениПредставления = "Представление";
	ИмяПоляНомерНачальный = СтруктураИмен["НомерНач"];
	ИмяПоляНомерКонечный = СтруктураИмен["НомерКон"];
	ИмяПоляКоличество = СтруктураИмен["Количество"];
	ИмяПоляНомерНачальныйПредставление = ИмяПоляНомерНачальный + ПостфиксИмениПредставления;
	ИмяПоляНомерКонечныйПредставление = ИмяПоляНомерКонечный + ПостфиксИмениПредставления;
	
	// Значения полей текущей строки до начала настройки:
	НомерНач = ТекДанные[ИмяПоляНомерНачальный];
	НомерКон = ТекДанные[ИмяПоляНомерКонечный];
	НомерНачПредставление = ТекДанные[ИмяПоляНомерНачальныйПредставление];
	НомерКонПредставление = ТекДанные[ИмяПоляНомерКонечныйПредставление];
	Количество = ТекДанные[ИмяПоляКоличество];
	
	// Новые значения полей, устанавливаемые в результате настройки:
	НовНомерНач = НомерНач;
	НовНомерКон = НомерКон;
	НовКоличество = Количество;
	
	Если ОбозначениеИзмененногоПоля = "Количество" Тогда
		
		Если Количество = 0 Тогда
			// Обновляем "Номер конечный":
			НовНомерКон = 0;
		Иначе
			// Количество указано.
			
			Если НомерНач > 0 Тогда
				// Номер начальный указан.
				
				// Обновляем "Номер конечный":
				НовНомерКон = НомерНач + Количество - 1;
				
			ИначеЕсли НомерКон > 0 И НомерНач = 0 Тогда
				// Обновляем "Номер начальный":
				НовНомерНач = НомерКон - Количество + 1;
				Если НовНомерНач < 0 Тогда
					НовНомерНач = 0;
				КонецЕсли;
				
				// Обновляем "Количество":
				НовКоличество = НовНомерКон - НовНомерНач + 1;
			КонецЕсли;
			
		КонецЕсли;
		
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "НомерНач" Тогда
		
		// Обновляем "Номер начальный":
		Попытка
			НовНомерНач = Число(НомерНачПредставление);
		Исключение
			НовНомерНач = 0;
		КонецПопытки;
		
		// Обновляем "Номер конечный".
		// Гарантируем, что он >= "Номер начальный":
		Если НовНомерНач > НомерКон Тогда
			// Новое значение "Номер конечный":
			НовНомерКон = НовНомерНач;
		КонецЕсли;
		
		// Обновляем "Количество":
		Если НовНомерНач = 0 ИЛИ НовНомерКон = 0 Тогда
			НовКоличество = 0;
		Иначе
			НовКоличество = НовНомерКон - НовНомерНач + 1;
		КонецЕсли;
		
		
	ИначеЕсли ОбозначениеИзмененногоПоля = "НомерКон" Тогда
		// Обновляем "Номер конечный".
		// Значение:
		Попытка
			НовНомерКон = Число(НомерКонПредставление);
		Исключение
			НовНомерКон = 0;
		КонецПопытки;
			
		// Обновляем "Номер начальный".
		// Гарантируем, что он <= "Номер конечный":
		Если (НовНомерКон < НомерНач ИЛИ НомерНач = 0)
			И НЕ НовНомерКон = 0 Тогда
			// Новое значение "Номер начальный":
			НовНомерНач = НовНомерКон;
		КонецЕсли;
		
		// Обновляем "Количество":
		Если НовНомерНач = 0 ИЛИ НовНомерКон = 0 Тогда
			НовКоличество = 0;
		Иначе
			НовКоличество = НовНомерКон - НовНомерНач + 1;
		КонецЕсли;
		
	Иначе
		Возврат;
		
	КонецЕсли;
	
	// Обновляем поля строки:
	ТекДанные[ИмяПоляНомерНачальный] = НовНомерНач;
	ТекДанные[ИмяПоляНомерКонечный] = НовНомерКон;
	ТекДанные[ИмяПоляКоличество] = НовКоличество;
	
	// Представления:
	ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНачальный, ИмяПоляНомерКонечный);
	
	// Если длина какого-либо номера превысила допустимую, выведем сообщение:
	СообщитьОПревышенииДлиныНомераБСО(ТекДанные, ИмяТаблЧасти, ИмяПоляНомерНачальный, ИмяПоляНомерКонечный);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМаксНомерБСОДляУказаннойДлины(ДлинаНомера)
	
	Возврат Pow(10, ДлинаНомера) - 1;

КонецФункции

&НаКлиенте
Процедура СообщитьОПревышенииДлиныНомераБСО(ТекДанные, ИмяТаблЧасти, ИмяПоляНачальныйНомер, ИмяПоляКонечныйНомер)
	
	ДлинаНомера = ТекДанные["ДлинаНомера"];
	Если НЕ ЗначениеЗаполнено(ДлинаНомера) Тогда
		ДлинаНомера = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	КонецЕсли;
	
	// Максимальный номер, соответствующей указанной длине номера:
	МаксимальныйНомер = ПолучитьМаксНомерБСОДляУказаннойДлины(ДлинаНомера);
	
	Если ТекДанные[ИмяПоляНачальныйНомер] > МаксимальныйНомер
		И ТекДанные[ИмяПоляКонечныйНомер] > МаксимальныйНомер Тогда
		
		ТекстСообщения = НСтр("ru='Длины введенных начального и конечного номеров больше, чем допустимые для выбранного БСО (%1 цифр)'");
		ИмяПоля = ИмяПоляКонечныйНомер;
		
	ИначеЕсли ТекДанные[ИмяПоляНачальныйНомер] > МаксимальныйНомер Тогда
		
		ТекстСообщения = НСтр("ru='Длина введенного начального номера больше, чем допустимая для выбранного БСО (%1 цифр)'");
		ИмяПоля = ИмяПоляНачальныйНомер;
		
	ИначеЕсли ТекДанные[ИмяПоляКонечныйНомер] > МаксимальныйНомер Тогда
		
		ТекстСообщения = НСтр("ru='Длина введенного конечного номера больше, чем допустимая для выбранного БСО (%1 цифр)'");
		ИмяПоля = ИмяПоляКонечныйНомер;
		
	Иначе
		// Оба номера не превышают установленного значения.
		Возврат;
	КонецЕсли;	
	
	// Выводим сообщение:
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ДлинаНомера);
	ИндексСтроки = ТекДанные["НомерСтроки"] - 1;
	
	ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ТекстСообщения,
		Объект.Ссылка,
		"Объект." + ИмяТаблЧасти + "[" + ИндексСтрокиТекст + "]." + ИмяПоля + "Представление");
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеНомераБСО(НомерЧисло, ДлинаПредставления)
	
	Если НомерЧисло = 0 Тогда
		НомерСтрокой = "";
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ДлинаПредставления) Тогда
			ДлинаПредставления = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
		КонецЕсли;
		
		НомерСтрокой = Формат(Число(НомерЧисло), "ЧГ=0");
		ТекущаяДлинаНомера = СтрДлина(НомерСтрокой);
		
		КоличествоСимволов = ДлинаПредставления - ТекущаяДлинаНомера;
		Для сч = 1 по КоличествоСимволов Цикл 
			НомерСтрокой = "0" + НомерСтрокой;
		КонецЦикла;
		
	КонецЕсли;
	
	
	Возврат НомерСтрокой;
	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНач, ИмяПоляНомерКон)
	
	ПостфиксИмениПредставления = "Представление";
	
	ДлинаНомера = ТекДанные["ДлинаНомера"];
	
	// Представление "Номер начальный":
	ТекДанные[ИмяПоляНомерНач + ПостфиксИмениПредставления] = ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерНач],
		ДлинаНомера);
		
	// Представление "Номер конечный":
	ТекДанные[ИмяПоляНомерКон + ПостфиксИмениПредставления] = ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерКон],
		ДлинаНомера);
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьМаскуПолейПорядковогоНомера(ТекДанные, ИмяТаблЧасти, ИмяПоляНомерНачальный, ИмяПоляНомерКонечный)
	
	#Если НЕ ВебКлиент Тогда
		ПостфиксИмениПредставления = "Представление";
		
		// Определим устанавливаемую длину маски.
		// Если уже введен номер, превышающий отведенную ему длину,
		// то длину маски задаем по длине введенного номера, чтобы пользователь имел возможность
		// самостоятельно его изменить:
		НаибольшийНомер = Макс(
			ТекДанные[ИмяПоляНомерНачальный],
			ТекДанные[ИмяПоляНомерКонечный]);
		ДлинаНаибольшегоНомера = СтрДлина(Формат(Число(НаибольшийНомер), "ЧГ=0"));
		
		// Длина номера, определяемая текущим БСО:
		ДлинаНомераБСО = ?(ТекДанные["ДлинаНомера"]>0, ТекДанные["ДлинаНомера"], ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО());
		
		ДлинаМаски = Макс(
			ДлинаНомераБСО,
			ДлинаНаибольшегоНомера);
		
		УправлениеМатериальнымиЗапасамиКлиент.УстановитьМаскуПолейПорядковогоНомера(ДлинаМаски,
			Элементы[ИмяТаблЧасти + ИмяПоляНомерНачальный + ПостфиксИмениПредставления],
			Элементы[ИмяТаблЧасти + ИмяПоляНомерКонечный + ПостфиксИмениПредставления]);
	#КонецЕсли
																				
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьДлинуНомера(ТекБСО)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекБСО, "ДлинаНомера");
	
КонецФункции

&НаСервере
Процедура ОбновитьДлиныНомеровБСОСервер(Параметр)
	
	ДлинаНомера = Параметр.ДлинаНомера;
	Поиск = Новый Структура("БСО", Параметр.Ссылка);
	
	//
	// Обрабатываем табличную часть "Состав БСО"
	//
	ТаблЧасть = Объект["СоставБСО"];
	МассивСтрок = ТаблЧасть.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		// Проверим, отличается ли новое значение длины номера от запомненного ранее.
		// Определяем по первой попавшейся строке табл.части:
		Если НЕ ДлинаНомера = МассивСтрок[0]["ДлинаНомера"] Тогда
			// Длина номера была изменена.
			
			Для Каждого СтрокаТЧ Из МассивСтрок Цикл
				
				СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
				ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомерУчет", "КонечныйНомерУчет");
				ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомерФакт", "КонечныйНомерФакт");
				
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
	
	//
	// Обрабатываем табличную часть "Недостачи БСО"
	//
	ТаблЧасть = Объект["СоставБСОНедостачи"];
	МассивСтрок = ТаблЧасть.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		// Проверим, отличается ли новое значение длины номера от запомненного ранее.
		// Определяем по первой попавшейся строке табл.части:
		Если НЕ ДлинаНомера = МассивСтрок[0]["ДлинаНомера"] Тогда
			// Длина номера была изменена.
			
			Для Каждого СтрокаТЧ Из МассивСтрок Цикл
				
				СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
				ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомер", "КонечныйНомер");
				
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
	
	//
	// Обрабатываем табличную часть "Излишки БСО"
	//
	ТаблЧасть = Объект["СоставБСОИзлишки"];
	МассивСтрок = ТаблЧасть.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		// Проверим, отличается ли новое значение длины номера от запомненного ранее.
		// Определяем по первой попавшейся строке табл.части:
		Если НЕ ДлинаНомера = МассивСтрок[0]["ДлинаНомера"] Тогда
			// Длина номера была изменена.
			
			Для Каждого СтрокаТЧ Из МассивСтрок Цикл
				
				СтрокаТЧ["ДлинаНомера"] = ДлинаНомера;
				ОбновитьПредставленияНомеровБСО(СтрокаТЧ, "НачальныйНомер", "КонечныйНомер");
				
			КонецЦикла;
				
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

//-----------------------------------------------------------------------------
// Расчет ДЕЛЬТ излишков и недостач

// Режим = "ДС" или "ДД".
&НаКлиенте
Процедура ПрименитьСоветСтроки(ТекДанные, ИмяИзменяемогоПоля, ИмяПоляСовет, ИмяПоляДельта, Режим)
	
	ПолеНач = ТекДанные[ИмяИзменяемогоПоля];
	
	Если ТекДанные[ИмяПоляСовет] = 1 Тогда
		// Значок "+".
		ТекДанные[ИмяИзменяемогоПоля] = ТекДанные[ИмяИзменяемогоПоля] + ТекДанные[ИмяПоляДельта];
		
	ИначеЕсли ТекДанные[ИмяПоляСовет] = 2 Тогда
		// Значок "-".
		ПолеНов = ТекДанные[ИмяИзменяемогоПоля] - ТекДанные[ИмяПоляДельта];
		ТекДанные[ИмяИзменяемогоПоля] = ?(ПолеНов > 0, ПолеНов, 0);
		
	КонецЕсли;
	
	ПолеИзменено = НЕ (ТекДанные[ИмяИзменяемогоПоля] = ПолеНач);
	Если ПолеИзменено Тогда
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
	// Очищаем поля совета:
	ТекДанные[ИмяПоляСовет]		= 0;
	ТекДанные[ИмяПоляДельта]	= 0;
	
	// Определим, изменились ли дельты недостачи и излишка
	// и настроим форму по результату проверки:
	Если Режим = "ДС" Тогда
		РассчитатьДельтыДС = РассчитатьДельтыДС ИЛИ ПолеИзменено;
		
	ИначеЕсли Режим = "ДД" Тогда
		РассчитатьДельтыДД = РассчитатьДельтыДД ИЛИ ПолеИзменено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНедостачуИзлишекДС(ТекДанные)
	
	// <Показатель>Учет - <Показатель>Факт:
	Дельта = ТекДанные["СуммаУчет"] - ТекДанные["СуммаФакт"];
		
	ТекДанные["Недостача"] = ?(Дельта>0, Дельта, 0);
	ТекДанные["Излишек"] = ?(Дельта<0, -Дельта, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьНедостачуИзлишекДД(ТекДанные)
	
	// <Показатель>Учет - <Показатель>Факт:
	ДельтаСумма = ТекДанные["СуммаУчет"] - ТекДанные["СуммаФакт"];
	ДельтаКолво = ТекДанные["КоличествоУчет"] - ТекДанные["КоличествоФакт"];
		
	ТекДанные["НедостачаСумма"]			= ?(ДельтаСумма>0, ДельтаСумма, 0);
	ТекДанные["НедостачаКоличество"]	= ?(ДельтаКолво>0, ДельтаКолво, 0);
	ТекДанные["ИзлишекСумма"]			= ?(ДельтаСумма<0, -ДельтаСумма, 0);
	ТекДанные["ИзлишекКоличество"]		= ?(ДельтаКолво<0, -ДельтаКолво, 0);
	
КонецПроцедуры

// Полностью рассчитывает дельты недостач и излишков. Включает отображение колонок "Совет".
&НаСервере
Процедура ЗаполнитьДельтыДС(ОтобразитьСовет = Ложь)
	
	ТЧ			= Объект.ДенежныеСредства;
	ТЧНедостачи	= Объект.ДенежныеСредстваНедостачи;
	ТЧИзлишки	= Объект.ДенежныеСредстваИзлишки;
	
	Запросы = Новый Запрос("
	|///////
	|// 0.
	|ВЫБРАТЬ
	|	ТЧ.Валюта		КАК Валюта,
	|	ТЧ.Недостача	КАК Недостача,
	|	ТЧ.Излишек		КАК Излишек
	|ПОМЕСТИТЬ
	|	ДенежныеСредства
	|ИЗ
	|	&ТЧДенежныеСредства	КАК ТЧ
	|;
	|
	|///////
	|// 1.
	|ВЫБРАТЬ
	|	ТЧ.Валюта	КАК Валюта,
	|	ТЧ.Сумма	КАК Сумма
	|ПОМЕСТИТЬ
	|	Недостачи
	|ИЗ
	|	&ТЧНедостачи	КАК ТЧ
	|;
	|
	|///////
	|// 2.
	|ВЫБРАТЬ
	|	ТЧ.Валюта	КАК Валюта,
	|	ТЧ.Сумма	КАК Сумма
	|ПОМЕСТИТЬ
	|	Излишки
	|ИЗ
	|	&ТЧИзлишки	КАК ТЧ
	|;
	|
	|///////
	|// 3.
	|ВЫБРАТЬ
	|	Недостачи.Валюта		КАК Валюта,
	|	СУММА(Недостачи.Сумма)	КАК ИтогСумма
	|ИЗ
	|	Недостачи
	|СГРУППИРОВАТЬ ПО
	|	Валюта
	|;
	|
	|///////
	|// 4.
	|ВЫБРАТЬ
	|	Излишки.Валюта			КАК Валюта,
	|	СУММА(Излишки.Сумма)	КАК ИтогСумма
	|ИЗ
	|	Излишки
	|СГРУППИРОВАТЬ ПО
	|	Валюта
	|;
	|
	|///////
	|// 5.
	|ВЫБРАТЬ
	|	ДенежныеСредства.Валюта				КАК Валюта,
	|	СУММА(ДенежныеСредства.Недостача)	КАК Недостача,
	|	СУММА(ДенежныеСредства.Излишек)		КАК Излишек
	|ИЗ
	|	ДенежныеСредства
	|СГРУППИРОВАТЬ ПО
	|	Валюта
	|;");
	Запросы.УстановитьПараметр("ТЧНедостачи",		ТЧНедостачи.Выгрузить(, "Валюта, Сумма"));
	Запросы.УстановитьПараметр("ТЧИзлишки",			ТЧИзлишки.Выгрузить(, "Валюта, Сумма"));
	Запросы.УстановитьПараметр("ТЧДенежныеСредства",ТЧ.Выгрузить(, "Валюта, Недостача, Излишек"));
	
	Результаты = Запросы.ВыполнитьПакет();
	
	ТЗСуммыНедостачи	= Результаты[3].Выгрузить();
	ТЗСуммыИзлишки		= Результаты[4].Выгрузить();
	ТЗДенежныеСредства	= Результаты[5].Выгрузить();
	
	// Переносим данные о денежных средствах из отдельных полей в таблицу
	Если НЕ ИспользоватьВалютныйУчет Тогда
		ТЗДенежныеСредства.Очистить();
		НоваяСтрока = ТЗДенежныеСредства.Добавить();
		НоваяСтрока["Валюта"]		= ВалютаРУ;
		НоваяСтрока["Недостача"]	= ДСНедостача;
		НоваяСтрока["Излишек"]		= ДСИзлишек;
	КонецЕсли;
	
	ЗаполнитьДельтыДС_Служебный(ТЧ, ТЗДенежныеСредства, ТЧНедостачи, ТЗСуммыНедостачи, "Недостача");
	ЗаполнитьДельтыДС_Служебный(ТЧ, ТЗДенежныеСредства, ТЧИзлишки, ТЗСуммыИзлишки, "Излишек");
	
	// Дельты только что рассчитали:
	РассчитатьДельтыДС = Ложь;
	
	// Настраиваем форму после выполненного рассчета дельт:
	Если ОтобразитьСовет Тогда
		ОтображатьСоветДС = Истина;
	КонецЕсли;
	НастроитьФормуОтображатьСоветДССервер();
	
КонецПроцедуры

// Служебный метод. ИмяПоля = "Недостача" или "Излишек".
&НаСервере
Процедура ЗаполнитьДельтыДС_Служебный(СвернутаяТЧ, СвернутаяТЗ, РазвернутаяТЧ, РазвернутаяТЗ, ИмяПоля)
	
	Для Каждого СтрокаРазвернутойТЗ Из РазвернутаяТЗ Цикл
		
		// Значение из "развернутой" ТЗ:
		ИтогРазвернутаяТЗ = СтрокаРазвернутойТЗ["ИтогСумма"];
		
		Поиск = Новый Структура("Валюта", СтрокаРазвернутойТЗ.Валюта);
		
		// Значение из "свернутой" ТЗ:
		СтрокиТЗ = СвернутаяТЗ.НайтиСтроки(Поиск);
		ИтогСвернутаяТЗ = 0;
		СтрокаТЗ = Неопределено;
		Если СтрокиТЗ.Количество() > 0 Тогда
			СтрокаТЗ = СтрокиТЗ[0];
			ИтогСвернутаяТЗ = СтрокаТЗ[ИмяПоля];
		КонецЕсли;
		
		Дельта = ИтогСвернутаяТЗ - ИтогРазвернутаяТЗ;
		ДельтаАбс = ?(Дельта >= 0, Дельта, -Дельта);
		
		// Заполняем поля дельт.
		
		// "Свернутая" ТЧ:
		СтрокиТЧ = СвернутаяТЧ.НайтиСтроки(Поиск);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			СтрокаТЧ["Дельта" + ИмяПоля] = Дельта;
		КонецЦикла;	
		
		// "Развернутая" ТЧ:
		СтрокиТЧ = РазвернутаяТЧ.НайтиСтроки(Поиск);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			
			// Значок совета:
			Если Дельта > 0 Тогда
				// Устанавливаем значок "+".
				Совет = 1;
				
			ИначеЕсли Дельта < 0 Тогда
				// Устанавливаем значок "-".
				Совет = 2;
				
			Иначе	
				// Устанавливаем пустой значок.
				Совет = 0;
				
			КонецЕсли;
			СтрокаТЧ["Совет"]	= Совет;
			СтрокаТЧ["Дельта"]	= ДельтаАбс;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Полностью рассчитывает дельты недостач и излишков. Включает отображение колонок "Совет".
&НаСервере
Процедура ЗаполнитьДельтыДД(ОтобразитьСовет = Ложь)
	
	КоличественныйУчетДД = ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов");
	
	НастроитьВидимостьИтоговКоличестваДД();
	
	ТЧ			= Объект.ДенежныеДокументы;
	ТЧНедостачи	= Объект.ДенежныеДокументыНедостачи;
	ТЧИзлишки	= Объект.ДенежныеДокументыИзлишки;
	
	Запросы = Новый Запрос("
	|///////
	|// 0.
	|ВЫБРАТЬ
	|	ТЧ.ДенежныйДокумент		КАК ДенежныйДокумент,
	|	ТЧ.НедостачаСумма		КАК НедостачаСумма,
	|	ТЧ.НедостачаКоличество	КАК НедостачаКоличество,
	|	ТЧ.ИзлишекСумма			КАК ИзлишекСумма,
	|	ТЧ.ИзлишекКоличество	КАК ИзлишекКоличество
	|ПОМЕСТИТЬ
	|	РезИнв
	|ИЗ
	|	&ТЧРезИнв	КАК ТЧ
	|;
	|
	|///////
	|// 1.
	|ВЫБРАТЬ
	|	ТЧ.ДенежныйДокумент	КАК ДенежныйДокумент,
	|	ТЧ.Сумма			КАК Сумма,
	|	ТЧ.Количество		КАК Количество
	|ПОМЕСТИТЬ
	|	Недостачи
	|ИЗ
	|	&ТЧНедостачи	КАК ТЧ
	|;
	|
	|///////
	|// 2.
	|ВЫБРАТЬ
	|	ТЧ.ДенежныйДокумент	КАК ДенежныйДокумент,
	|	ТЧ.Сумма			КАК Сумма,
	|	ТЧ.Количество		КАК Количество
	|ПОМЕСТИТЬ
	|	Излишки
	|ИЗ
	|	&ТЧИзлишки	КАК ТЧ
	|;
	|
	|///////
	|// 3.
	|ВЫБРАТЬ
	|	Недостачи.ДенежныйДокумент	КАК ДенежныйДокумент,
	|	СУММА(Недостачи.Сумма)		КАК ИтогСумма,
	|	СУММА(Недостачи.Количество)	КАК ИтогКоличество
	|ИЗ
	|	Недостачи
	|СГРУППИРОВАТЬ ПО
	|	ДенежныйДокумент
	|;
	|
	|///////
	|// 4.
	|ВЫБРАТЬ
	|	Излишки.ДенежныйДокумент	КАК ДенежныйДокумент,
	|	СУММА(Излишки.Сумма)		КАК ИтогСумма,
	|	СУММА(Излишки.Количество)	КАК ИтогКоличество
	|ИЗ
	|	Излишки
	|СГРУППИРОВАТЬ ПО
	|	ДенежныйДокумент
	|;
	|
	|///////
	|// 5.
	|ВЫБРАТЬ
	|	РезИнв.ДенежныйДокумент				КАК ДенежныйДокумент,
	|	СУММА(РезИнв.НедостачаСумма)		КАК НедостачаСумма,
	|	СУММА(РезИнв.НедостачаКоличество)	КАК НедостачаКоличество,
	|	СУММА(РезИнв.ИзлишекСумма)			КАК ИзлишекСумма,
	|	СУММА(РезИнв.ИзлишекКоличество)		КАК ИзлишекКоличество
	|ИЗ
	|	РезИнв
	|СГРУППИРОВАТЬ ПО
	|	ДенежныйДокумент
	|;");
	Запросы.УстановитьПараметр("ТЧНедостачи",		ТЧНедостачи.Выгрузить(, "ДенежныйДокумент, Сумма, Количество"));
	Запросы.УстановитьПараметр("ТЧИзлишки",			ТЧИзлишки.Выгрузить(, "ДенежныйДокумент, Сумма, Количество"));
	Запросы.УстановитьПараметр("ТЧРезИнв",			ТЧ.Выгрузить(,
		"ДенежныйДокумент, НедостачаСумма, НедостачаКоличество, ИзлишекСумма, ИзлишекКоличество"));
	
	Результаты = Запросы.ВыполнитьПакет();
	
	ТЗСуммыНедостачи	= Результаты[3].Выгрузить();
	ТЗСуммыИзлишки		= Результаты[4].Выгрузить();
	ТЗРезИнв			= Результаты[5].Выгрузить();
	
	ЗаполнитьДельтыДД_Служебный(ТЧ, ТЗРезИнв, ТЧНедостачи, ТЗСуммыНедостачи, "Недостача");
	ЗаполнитьДельтыДД_Служебный(ТЧ, ТЗРезИнв, ТЧИзлишки, ТЗСуммыИзлишки, "Излишек");
	
	// Дельты только что рассчитали:
	РассчитатьДельтыДД = Ложь;
	
	// Настраиваем форму после выполненного рассчета дельт:
	Если ОтобразитьСовет Тогда
		ОтображатьСоветДД = Истина;
	КонецЕсли;
	НастроитьФормуОтображатьСоветДДСервер();
	
КонецПроцедуры

// Служебный метод. НИ = "Недостача" или "Излишек".
&НаСервере
Процедура ЗаполнитьДельтыДД_Служебный(СвернутаяТЧ, СвернутаяТЗ, РазвернутаяТЧ, РазвернутаяТЗ, НИ)
	
	// Поля закодированы следующим образом в именах переменных:
	// 1. Сумма
	// 2. Количество
	
	Для Каждого СтрокаРазвернутойТЗ Из РазвернутаяТЗ Цикл
		
		// Значение из "развернутой" ТЗ:
		Итог1РазвернутаяТЗ = СтрокаРазвернутойТЗ["ИтогСумма"];
		Итог2РазвернутаяТЗ = СтрокаРазвернутойТЗ["ИтогКоличество"];
		
		Поиск = Новый Структура("ДенежныйДокумент", СтрокаРазвернутойТЗ.ДенежныйДокумент);
		
		// Значение из "свернутой" ТЗ:
		СтрокиТЗ = СвернутаяТЗ.НайтиСтроки(Поиск);
		Итог1СвернутаяТЗ = 0;
		Итог2СвернутаяТЗ = 0;
		СтрокаТЗ = Неопределено;
		Если СтрокиТЗ.Количество() > 0 Тогда
			СтрокаТЗ = СтрокиТЗ[0];
			Итог1СвернутаяТЗ = СтрокаТЗ[НИ + "Сумма"];
			Итог2СвернутаяТЗ = СтрокаТЗ[НИ + "Количество"];
		КонецЕсли;
		
		Дельта1 = Итог1СвернутаяТЗ - Итог1РазвернутаяТЗ;
		Дельта2 = Итог2СвернутаяТЗ - Итог2РазвернутаяТЗ;
		Дельта1Абс = ?(Дельта1 >= 0, Дельта1, -Дельта1);
		Дельта2Абс = ?(Дельта2 >= 0, Дельта2, -Дельта2);
		
		// Заполняем поля дельт.
		
		// "Свернутая" ТЧ:
		СтрокиТЧ = СвернутаяТЧ.НайтиСтроки(Поиск);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			СтрокаТЧ["Дельта" + НИ + "Сумма"]		= Дельта1;
			СтрокаТЧ["Дельта" + НИ + "Количество"]	= Дельта2;
		КонецЦикла;	
		
		// "Развернутая" ТЧ:
		СтрокиТЧ = РазвернутаяТЧ.НайтиСтроки(Поиск);
		Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
			
			// Значок совета1:
			Если Дельта1 > 0 Тогда
				// Устанавливаем значок "+".
				Совет1 = 1;
				
			ИначеЕсли Дельта1 < 0 Тогда
				// Устанавливаем значок "-".
				Совет1 = 2;
				
			Иначе	
				// Устанавливаем пустой значок.
				Совет1 = 0;
				
			КонецЕсли;
			
			// Значок совета2:
			Если Дельта2 > 0 Тогда
				// Устанавливаем значок "+".
				Совет2 = 1;
				
			ИначеЕсли Дельта2 < 0 Тогда
				// Устанавливаем значок "-".
				Совет2 = 2;
				
			Иначе	
				// Устанавливаем пустой значок.
				Совет2 = 0;
				
			КонецЕсли;
			
			СтрокаТЧ["СоветСумма"]		= Совет1;
			СтрокаТЧ["СоветКоличество"]	= Совет2;
			СтрокаТЧ["ДельтаСумма"]			= Дельта1Абс;
			СтрокаТЧ["ДельтаКоличество"]	= Дельта2Абс;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры


//-----------------------------------------------------------------------------
// Заполнение табличных частей

&НаКлиенте
Функция НеобходимыеРеквизитыЗаполнены()
	
	Результат = Истина;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Не указана дата проведения инвентаризации'"),
			Объект["Ссылка"],
			"Объект.ДатаИнвентаризации");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.Организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.МОЛ) Тогда
		Результат = Ложь;
		ТекстСообщения = НСтр("ru='Поле ""МОЛ"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
			Объект.Ссылка,
			"Объект.МОЛ");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция МестоИнвентаризацииСоответствуетЦМОКлиент()
	
	Результат = Истина;
	
	Если ЗначениеЗаполнено(Объект.МестоИнвентаризации)
		И ТипЗнч(Объект.МестоИнвентаризации) = Тип("СправочникСсылка.МестаХранения")
		И ЗначениеЗаполнено(Объект.МОЛ)
		И ТипЗнч(Объект.МОЛ) = Тип("СправочникСсылка.ЦМО") Тогда
		
		Результат = МестоИнвентаризацииСоответствуетЦМОСервер();
		
		Если Не Результат Тогда
			ТекстСообщения = НСтр("ru='Указанное место хранения отличается от места хранения в настройках ЦМО ответственного лица.'");
				
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				ТекстСообщения,
				Объект.Ссылка,
				"Объект.МестоИнвентаризации");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МестоИнвентаризацииСоответствуетЦМОСервер()
	
	МестоХраненияИзМОЛ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.МОЛ, "МестоХранения");
	
	Возврат (МестоХраненияИзМОЛ = Объект.МестоИнвентаризации);
	
КонецФункции

&НаКлиенте
Процедура ОчиститьТабличнуюЧастьКлиент(ИмяТЧ, ПредставлениеТЧ)
	
	Если Объект[ИмяТЧ].Количество() > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Очистить табличную часть ""%1""?'"),
			ПредставлениеТЧ);
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ИмяТЧ", ИмяТЧ);
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОчиститьТабличнуюЧастьКлиент_Выбор", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры	
&НаКлиенте
Процедура ОчиститьТабличнуюЧастьКлиент_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ИмяТЧ = ПараметрыОповещения["ИмяТЧ"];
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Объект[ИмяТЧ].Очистить();
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет поле "Сумма" строки значением, уравнивающим величины по этой валюте в табличных частях.
// ИмяТЧ = "Недостача" или "Излишек".
&НаКлиенте
Процедура ЗаполнитьПолеНовойСтроки(ТекДанные, ИмяТЧ)
	
	НоваяСтрока = РедактируемаяСтрока.Свойство("НоваяСтрока");
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	СвернутаяТЧ = Объект.ДенежныеСредства;
	Если ИмяТЧ = "Недостача" Тогда
		РазвернутаяТЧ = Объект.ДенежныеСредстваНедостачи;
		
	ИначеЕсли ИмяТЧ = "Излишек" Тогда
		РазвернутаяТЧ = Объект.ДенежныеСредстваИзлишки;
		
	КонецЕсли;
		
	Поиск = Новый Структура("Валюта", ТекДанные.Валюта);
	
	// Итог "свернутой" таблицы по этой валюте:
	ИтогСвернутаяТЧ = 0;
	СтрокиТЧ = СвернутаяТЧ.НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		ИтогСвернутаяТЧ = ИтогСвернутаяТЧ + СтрокаТЧ[ИмяТЧ];
	КонецЦикла;
	
	// Итог "развернутой" таблицы по этой валюте:
	ИтогРазвернутаяТЧ = -ТекДанные.Сумма;
	СтрокиТЧ = РазвернутаяТЧ.НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		ИтогРазвернутаяТЧ = ИтогРазвернутаяТЧ + СтрокаТЧ.Сумма;
	КонецЦикла;
	
	Дельта = ИтогСвернутаяТЧ - ИтогРазвернутаяТЧ;
	
	ТекДанные.Сумма = ?(Дельта>=0, Дельта, 0);
	
КонецПроцедуры

// Заполняет поля "Сумма", "Кол-во" строки значениями, уравнивающим величины по этому ДД в табличных частях.
// ИмяТЧ = "Недостача" или "Излишек".
&НаКлиенте
Процедура ЗаполнитьПоляНовойСтрокиДД(ТекДанные, ИмяТЧ)
	
	НоваяСтрока = РедактируемаяСтрока.Свойство("НоваяСтрока");
	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	СвернутаяТЧ = Объект.ДенежныеДокументы;
	Если ИмяТЧ = "Недостача" Тогда
		РазвернутаяТЧ = Объект.ДенежныеДокументыНедостачи;
		
	ИначеЕсли ИмяТЧ = "Излишек" Тогда
		РазвернутаяТЧ = Объект.ДенежныеДокументыИзлишки;
		
	КонецЕсли;
		
	Поиск = Новый Структура("ДенежныйДокумент", ТекДанные.ДенежныйДокумент);
	
	// Итог "свернутой" таблицы по этому ДД:
	Итог1СвернутаяТЧ = 0; // 1.Сумма
	Итог2СвернутаяТЧ = 0; // 2.Количество
	СтрокиТЧ = СвернутаяТЧ.НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		Итог1СвернутаяТЧ = Итог1СвернутаяТЧ + СтрокаТЧ[ИмяТЧ + "Сумма"];
		Итог2СвернутаяТЧ = Итог2СвернутаяТЧ + СтрокаТЧ[ИмяТЧ + "Количество"];
	КонецЦикла;
	
	// Итог "развернутой" таблицы по этому ДД:
	Итог1РазвернутаяТЧ = -ТекДанные["Сумма"];
	Итог2РазвернутаяТЧ = -ТекДанные["Количество"];
	СтрокиТЧ = РазвернутаяТЧ.НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		Итог1РазвернутаяТЧ = Итог1РазвернутаяТЧ + СтрокаТЧ["Сумма"];
		Итог2РазвернутаяТЧ = Итог2РазвернутаяТЧ + СтрокаТЧ["Количество"];
	КонецЦикла;
	
	Дельта1 = Итог1СвернутаяТЧ - Итог1РазвернутаяТЧ;
	Дельта2 = Итог2СвернутаяТЧ - Итог2РазвернутаяТЧ;
	
	ТекДанные["Сумма"] = ?(Дельта1>=0, Дельта1, 0);
	Если КоличественныйУчетДД Тогда
		ТекДанные["Количество"] = ?(Дельта2>=0, Дельта2, 0);
	КонецЕсли;
	
КонецПроцедуры

