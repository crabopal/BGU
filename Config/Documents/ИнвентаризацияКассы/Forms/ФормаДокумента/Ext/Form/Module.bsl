// Структура с необходимыми полями строки, которая была отредактирована в таблице.
// Содержит значения полей на момент начала редактирования.
// Используется для расчета дельт излишка и недостачи, для отмены редактирования.
&НаКлиенте
Перем РедактируемаяСтрока;

// Признак получения длины номера БСО при выборе самого БСО.
&НаКлиенте
Перем ВыборБСООбработан;

&НаКлиенте
Перем ОбновитьДлиныНомеровБСО;

// Структура, содержащая параметры для обновления номеров БСО.
// Значение, отличное от Неопределено, является признаком необходимости
// обновить длины номеров БСО (и, как следствие, все представления номеров БСО)
// при завершении редактирования строки табличной части.
&НаКлиенте
Перем ОбновитьДлиныНомеровБСО_Параметр;

&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем СледуетЗаписатьДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	НастроитьФормуСервер();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.ГруппаОтветственныйКомментарий);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов 

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекстЗаголовкаСообщений = НСтр("ru='Инвентаризация кассы'");
	
	НастроитьФормуКлиент();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьПредставленияНомеровБСО();
	
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// СтандартныеПодсистемы.ДатыЗапретаИзменения
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаДокумента();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.ДокументСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаДокумента(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если СледуетЗаписатьДокумент = Истина Тогда
		// Все проверки пройдены
		// Выполняется стандартная запись документа
		
	Иначе
		// Предлагаем рассчитать излишки и недостачи БСО перед записью,
		// если такой расчет еще не выполнялся:
		Если Объект["НеобходимоРассчитатьРасхожденияБСО"] И Объект["СоставБСО"].Количество() > 0 Тогда
			Отказ = Истина;
			
			ТекстСообщения = НСтр("ru='Перед записью этого документа рекомендуется рассчитать излишки и недостачи БСО.
				|Таблица ""Результаты инвентаризации БСО"" будет преобразована для того, чтобы рассчитать недостачу и излишек по каждому диапазону номеров.
				|
				|Рассчитать излишки и недостачи БСО?'");
				
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗаписью_Выбор", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		КонецЕсли;
	КонецЕсли;
	
	СледуетЗаписатьДокумент = Ложь;
	
КонецПроцедуры
&НаКлиенте
Процедура ПередЗаписью_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	СледуетЗаписатьДокумент = Ложь;
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		// Выбрали "Да" (рассчитать недостачи и излишки БСО)
		
		Если ПроверитьИРассчитатьБСОНедостачиИзлишкиКлиент() Тогда
			СледуетЗаписатьДокумент = Истина;
		КонецЕсли;
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		// Выбрали "Нет" (рассчитать недостачи и излишки БСО)
		
		СледуетЗаписатьДокумент = Истина;
	КонецЕсли;
	
	Если СледуетЗаписатьДокумент Тогда
		Записать();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ГруппаДенежныеСредства_ЗаписатьВТабличнуюЧасть(ТекущийОбъект);
	
	ОбщегоНазначенияБГУ.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если ОтображатьСоветДС Тогда
		ЗаполнитьДельтыДС();
	КонецЕсли;
	
	Если ОтображатьСоветДС Тогда
		ЗаполнитьДельтыДД();
	КонецЕсли;
	
	// Настраиваем представления номеров БСО во всех таблицах документа
	ЗаполнитьПредставленияНомеровБСО();
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПослеЗаписи = ОбменСКонтрагентами.ПараметрыПослеЗаписиНаСервере();
	ПараметрыПослеЗаписи.Форма = ЭтотОбъект;
	ПараметрыПослеЗаписи.ДокументСсылка = Объект.Ссылка;
	ПараметрыПослеЗаписи.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПослеЗаписи.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи, ПараметрыПослеЗаписи);
	// Конец подсистема "ОбменСКонтрагентами".

КонецПроцедуры

// Создает документы на основании данного документа.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	//
	// Обновляем выводимое на форме количество документов, введенных на основании данного документа.
	//
	// Наличные ден.средства:
	ЗаписанДокументДСНаОсновании = (Источник = Неопределено
		И	(ТипЗнч(Параметр) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
			ИЛИ ТипЗнч(Параметр) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")));
	Если ЗаписанДокументДСНаОсновании Тогда
		ОпределитьКоличествоДокументовВведенныхНаОсновании("ДС");
	КонецЕсли;
	// Ден.документы:
	ЗаписанДокументДДНаОсновании = (Источник = Неопределено
		И	(ТипЗнч(Параметр) = Тип("ДокументСсылка.РасходныйОрдерФондовый")
			ИЛИ ТипЗнч(Параметр) = Тип("ДокументСсылка.ПриходныйОрдерФондовый")));
	Если ЗаписанДокументДДНаОсновании Тогда
		ОпределитьКоличествоДокументовВведенныхНаОсновании("ДД");
	КонецЕсли;
	// БСО:
	ЗаписанДокументБСОНаОсновании = (Источник = Неопределено
		И	(ТипЗнч(Параметр) = Тип("ДокументСсылка.СписаниеБСО")
			ИЛИ ТипЗнч(Параметр) = Тип("ДокументСсылка.ПоступлениеБСО")));
	Если ЗаписанДокументБСОНаОсновании Тогда
		ОпределитьКоличествоДокументовВведенныхНаОсновании("БСО");
	КонецЕсли;
	
	//
	// Изменена длина номера БСО?
	//
	Если ИмяСобытия = "ЗаписанЭлементСправочникаБСО" Тогда
		// Взводим флаг необходимости обновить представления номеров БСО:
		ОбновитьДлиныНомеровБСО_Параметр = Новый Структура("Ссылка, ДлинаНомера");
		ЗаполнитьЗначенияСвойств(ОбновитьДлиныНомеровБСО_Параметр, Параметр);
	КонецЕсли;

	Если ИмяСобытия = "ОбновитьСостояниеЭД" Тогда
		
		// Подсистема "ОбменСКонтрагентами".
		ПараметрыОповещения = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаДокумента();
		ПараметрыОповещения.Форма = ЭтотОбъект;
		ПараметрыОповещения.ДокументСсылка = Объект.Ссылка;
		ПараметрыОповещения.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
		ПараметрыОповещения.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
		
		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаДокумента(ИмяСобытия, Параметр, Источник, ПараметрыОповещения);
		// Конец подсистема "ОбменСКонтрагентами".

	КонецЕсли;
	
	// СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов    
	УчетОригиналовПервичныхДокументовКлиент.ОбработчикОповещенияФормаДокумента(ИмяСобытия, ЭтотОбъект, Источник);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервичныхДокументов

	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ПередЗакрытием(ЭтотОбъект, Объект, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПослеЗаписи_ФормаДокумента(ЭтотОбъект, ПараметрыЗаписи);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОрганизацияПриИзмененииКлиент();
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка);
	
КонецПроцедуры
&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОрганизацияПередИзменениемКлиент(СтандартнаяОбработка, ВыбранноеЗначение);
	
КонецПроцедуры


&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	НастроитьФормуСервер_ВидимостьКолонокПодразделение(Истина); //ОбновитьКолонкиПодразделение
	
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	
	//---
	// Флажок <без ограничения>
	//---
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_РеквизитСсылка_ПриИзменении(ЭтаФорма, Элемент);
	
КонецПроцедуры
&НаКлиенте
Процедура БезУчетаИФОПриИзменении(Элемент)
	
	//---
	// Флажок <без ограничения>
	//---
	ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_РеквизитФлажок_ПриИзменении(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДСФактПриИзменении(Элемент)
	
	ОбновитьСуммыРУ("СуммаФакт");
	
КонецПроцедуры
&НаКлиенте
Процедура ДСУчетПриИзменении(Элемент)
	
	ОбновитьСуммыРУ("СуммаУчет");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображатьСоветДСПриИзменении(Элемент)
	
	Если ОтображатьСоветДС Тогда
		// Установили флаг.
		
		// Рассчитываем дельты и показываем колонки "Совет":
		ЗаполнитьДельтыДС();
	
	Иначе
		// Сбросили флаг.
		
