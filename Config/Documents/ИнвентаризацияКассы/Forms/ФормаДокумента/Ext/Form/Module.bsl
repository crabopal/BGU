	ИначеЕсли ОтменаРедактирования Тогда
		
		// Восстанавливаем значение всех полей строки,
		// которые были запомнены в момент начала ее редактирования:
		ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		
		Возврат;
		
	КонецЕсли;
	
	РассчитатьНедостачуИзлишекДД(ТекДанные);
	
	// Определим, изменилась ли дельта излишка:
	Попытка
		РассчитатьДельтыДД = РассчитатьДельтыДД
			ИЛИ	НЕ (ТекДанные["ДенежныйДокумент"] = РедактируемаяСтрока["ДенежныйДокумент"])
			ИЛИ НЕ (ТекДанные["СуммаФакт"] = РедактируемаяСтрока["СуммаФакт"])
			ИЛИ НЕ (ТекДанные["КоличествоФакт"] = РедактируемаяСтрока["КоличествоФакт"]);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеДокументыПослеУдаления(Элемент)
	
	// Дельты недостачи и излишка изменились:
	РассчитатьДельтыДД = Истина;
	
КонецПроцедуры


&НаКлиенте
Процедура ДенежныеДокументыДенежныйДокументПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДенежныеДокументы.ТекущиеДанные;
	ДенежныйДокумент = ТекДанные.ДенежныйДокумент;
	
	Если ЗначениеЗаполнено(ДенежныйДокумент) Тогда
		ТекДанные.ВидДенежногоДокумента = ПолучитьВидДенежногоДокумента(ДенежныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияДенежныеДокументыВсегоДокументовНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДокументОснованиеСсылка",	Объект["Ссылка"]);
	ПараметрыФормы.Вставить("ДополнительныйПараметр",	"ДД");
	
	ОткрытьФорму("ОбщаяФорма.СписокДокументовВведенныхНаОсновании", ПараметрыФормы, ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеДокументыКоличествоФактПриИзменении(Элемент)
	
	РассчитатьСуммуФактВТекущейСтрокеДД();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДенежныеДокументыНедостачи

&НаКлиенте
Процедура ДенежныеДокументыНедостачиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если	Поле.Имя = "ДенежныеДокументыНедостачиСоветСумма"
		ИЛИ	Поле.Имя = "ДенежныеДокументыНедостачиДельтаСумма" Тогда
		// Щелкнули поле "Совет" или "Дельта" суммы.
		
		ПрименитьСоветСтроки(Элементы.ДенежныеДокументыНедостачи.ТекущиеДанные,
			"Сумма",	// ИмяИзменяемогоПоля
			"СоветСумма",	// ИмяПоляСовет
			"ДельтаСумма",	// ИмяПоляДельта
			"ДД");			// Режим
		
	ИначеЕсли	Поле.Имя = "ДенежныеДокументыНедостачиСоветКоличество"
		ИЛИ	Поле.Имя = "ДенежныеДокументыНедостачиДельтаКоличество" Тогда
		// Щелкнули поле "Совет" или "Дельта" количества.
		
		ПрименитьСоветСтроки(Элементы.ДенежныеДокументыНедостачи.ТекущиеДанные,
			"Количество",			// ИмяИзменяемогоПоля
			"СоветКоличество",		// ИмяПоляСовет
			"ДельтаКоличество",	// ИмяПоляДельта
			"ДД");				// Режим
		
	КонецЕсли;
		
КонецПроцедуры

// Этот метод используется только из-за особенностей веб-клиента.
&НаКлиенте
Процедура ДенежныеДокументыНедостачиПередНачаломИзменения(Элемент, Отказ)
	
	Если	Элементы.ДенежныеДокументыНедостачи.ТекущийЭлемент = Элементы.ДенежныеДокументыНедостачиДельтаКоличество
		ИЛИ Элементы.ДенежныеДокументыНедостачи.ТекущийЭлемент = Элементы.ДенежныеДокументыНедостачиДельтаСумма Тогда
		Отказ = Истина;
	КонецЕсли;                                      
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеДокументыНедостачиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.ДенежныеДокументыНедостачи.ТекущиеДанные;
	
	// Запоминаем значения полей строки в начале ее редактирования:
	РедактируемаяСтрока = Новый Структура("ВидДенежногоДокумента, ДенежныйДокумент, КФО, ИФО, КПС, Сумма, Количество");
	ЗаполнитьЗначенияСвойств(РедактируемаяСтрока, ТекДанные);
	
	Если НоваяСтрока Тогда
		РедактируемаяСтрока.Вставить("НоваяСтрока", Истина);
	КонецЕсли;
	
	ЗаполнитьПоляНовойСтрокиДД(ТекДанные, "Излишек");
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеДокументыНедостачиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.ДенежныеДокументыНедостачи.ТекущиеДанные;
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
		
	ИначеЕсли ОтменаРедактирования Тогда
		// Восстанавливаем значение всех полей строки,
		// которые были запомнены в момент начала ее редактирования:
		ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		Возврат;
		
	КонецЕсли;
	
	// Определим, изменилась ли дельта излишка:
	Попытка
		РассчитатьДельтыДД = РассчитатьДельтыДД
			ИЛИ	НЕ (ТекДанные["ДенежныйДокумент"] = РедактируемаяСтрока["ДенежныйДокумент"])
			ИЛИ НЕ (ТекДанные["Сумма"] = РедактируемаяСтрока["Сумма"])
			ИЛИ НЕ (ТекДанные["Количество"] = РедактируемаяСтрока["Количество"]);
		Если РассчитатьДельтыДД Тогда
			// Очищаем поля "Совет":
			ТекДанные["СоветСумма"] = 0;
			ТекДанные["СоветКоличество"] = 0;
			ТекДанные["ДельтаСумма"] = 0;
			ТекДанные["ДельтаКоличество"] = 0;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ДенежныеДокументыНедостачиПослеУдаления(Элемент)
	
	// Дельта недостачи изменилась:
	РассчитатьДельтыДД = Истина;
	
КонецПроцедуры

