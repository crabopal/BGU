		Объект["Подразделение"],
		Объект["ДатаИнвентаризации"],
		Объект["ИФО"],
		Фондовые);
		
	ЗаполнитьЗначенияСвойств(Объект, ПоследниеОрдера);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьДД_Расхождение(ЭтоНедостача)
	
	// Входная проверка:
	Если НЕ ЭтоНедостача = Ложь Тогда
		ЭтоНедостача = Истина;
	КонецЕсли;
	
	Если НеобходимыеРеквизитыЗаполнены() Тогда
		
		// Подготовка:
		Если ЭтоНедостача Тогда
			ИмяТаблЧасти = "ДенежныеДокументыНедостачи";
			ПредставлениеТаблЧасти = НСтр("ru='""Недостачи"" денежных документов'");
			ТекстСообщенияРасхождениеОтсутствует = НСтр("ru='Недостачи денежных документов отсутствуют в таблице ""Денежные документы"".'");
		Иначе
			ИмяТаблЧасти = "ДенежныеДокументыИзлишки";
			ПредставлениеТаблЧасти = НСтр("ru='""Излишки"" денежных документов'");
			ТекстСообщенияРасхождениеОтсутствует = НСтр("ru='Излишки денежных документов отсутствуют в таблице ""Денежные документы"".'");
		КонецЕсли;
		
		ОписаниеРасхождения = Новый Структура();
		ОписаниеРасхождения.Вставить("ЭтоНедостача",							ЭтоНедостача);
		ОписаниеРасхождения.Вставить("ИмяТаблЧасти",							ИмяТаблЧасти);
		ОписаниеРасхождения.Вставить("ПредставлениеТаблЧасти",					ПредставлениеТаблЧасти);
		ОписаниеРасхождения.Вставить("ТекстСообщенияРасхождениеОтсутствует",	ТекстСообщенияРасхождениеОтсутствует);
		
		Если Объект[ИмяТаблЧасти].Количество() > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Перед заполнением по данным учета
					|табличная часть %1
					|будет очищена.	
					|
					|Продолжить и очистить?'"),
				ПредставлениеТаблЧасти);
				
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДД_Расхождение_Выбор", ЭтотОбъект, ОписаниеРасхождения);
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		Иначе
			ЗаполнитьДД_РасхождениеКлиент(ОписаниеРасхождения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьДД_Расхождение_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДД_РасхождениеКлиент(ПараметрыОповещения);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ЗаполнитьДД_РасхождениеКлиент(ОписаниеРасхождения)
	
	Перем	ЭтоНедостача,
			ИмяТаблЧасти,
			ПредставлениеТаблЧасти,
			ТекстСообщенияРасхождениеОтсутствует;
			
	ОписаниеРасхождения.Свойство("ЭтоНедостача",							ЭтоНедостача);
	ОписаниеРасхождения.Свойство("ИмяТаблЧасти",							ИмяТаблЧасти);
	ОписаниеРасхождения.Свойство("ПредставлениеТаблЧасти",					ПредставлениеТаблЧасти);
	ОписаниеРасхождения.Свойство("ТекстСообщенияРасхождениеОтсутствует",	ТекстСообщенияРасхождениеОтсутствует);
	
	ЗаполнениеВыполнено = ЗаполнитьДД_РасхождениеСервер(ЭтоНедостача);
	
	Если ЗаполнениеВыполнено Тогда
		// Если по данным учета не было добавлено ни одной строки, выведем сообщение:
		Если Объект[ИмяТаблЧасти].Количество() = 0 Тогда
			ПоказатьПредупреждение(, ТекстСообщенияРасхождениеОтсутствует, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
	Иначе
		// Заполнение не было выполнено.
		Текст = НСтр("ru='Не удалось заполнить таблицу %1, т.к. таблица ""Денежные документы"" заполнена с ошибками.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ПредставлениеТаблЧасти);
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Функция ЗаполнитьДД_РасхождениеСервер(ЭтоНедостача)
	
	// Заполняем табличную часть:
	Результат = Документы.ИнвентаризацияКассы.ЗаполнитьТаблицу_ДД_Расхождение(Объект, ЭтоНедостача);
	
	// Рассчитываем дельты недостач и излишков (если указано):
	Если ОтображатьСоветДД Тогда
		ЗаполнитьДельтыДД();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьДД_ФактическоеНаличие()
	
	Если Объект["ДенежныеДокументы"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Заполнить колонки ""По факту"" данными из соответствующих колонок ""По учету""?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьДД_ФактическоеНаличие_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьДД_ФактическоеНаличиеСервер();
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПроверитьИЗаполнитьДД_ФактическоеНаличие_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДД_ФактическоеНаличиеСервер();
	КонецЕсли;
	
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьДД_ФактическоеНаличиеСервер()
	
	// Заполняем табл.часть:
	Документы.ИнвентаризацияКассы.ЗаполнитьТаблицу_ДД_ФактическоеНаличие(Объект);
	
	// Заполняем дельты:
	Если ОтображатьСоветДД Тогда
		ЗаполнитьДельтыДД();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуФактВТекущейСтрокеДД()
	
	ТекДанные = Элементы["ДенежныеДокументы"].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НеЧислитсяВУчете = (ТекДанные["СуммаУчет"] = 0 И ТекДанные["КоличествоУчет"] = 0);
	
	Если НеЧислитсяВУчете Тогда
		Возврат;
	КонецЕсли;
	
	ЦенаПоУчету = ?(ТекДанные["КоличествоУчет"] = 0,
		0,
		ТекДанные["СуммаУчет"] / ТекДанные["КоличествоУчет"]);
	
	Если ТекДанные["КоличествоФакт"] = ТекДанные["КоличествоУчет"] Тогда
		ТекДанные["СуммаФакт"] = ТекДанные["СуммаУчет"];
	Иначе
		ТекДанные["СуммаФакт"] = ТекДанные["КоличествоФакт"] * ЦенаПоУчету;
	КонецЕсли;
	
КонецПроцедуры

