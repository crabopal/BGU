		ЗаполнитьЗначенияСвойств(ТекДанные, РедактируемаяСтрока);
		Возврат;
		
	КонецЕсли;
	
	РассчитатьНедостачуИзлишекДС(ТекДанные);
	
	// Определим, изменились ли дельты недостачи и излишка:
	Попытка
		РассчитатьДельтыДС = РассчитатьДельтыДС
			ИЛИ	НЕ (ТекДанные["Валюта"] = РедактируемаяСтрока["Валюта"])
			ИЛИ НЕ (ТекДанные["СуммаФакт"] = РедактируемаяСтрока["СуммаФакт"]);
