&НаСервере
Функция БСОЗаполненыКорректно()
	
	Возврат Документы.ИнвентаризацияКассы.БСОЗаполненыКорректно(
		Объект,
		Истина, // ПроверитьТолькоСоставБСО
		Ложь); // РежимЗагрузкиДанных
	
КонецФункции

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_Расхождение(ЭтоНедостача)
	
	// Проверки перед заполнением излишков/недостач БСО:
	//	1) Выбранная табличная часть расхождения уже заполнена? Уточнить, если заполнена.
	//		ПроверитьИЗаполнитьБСО_ТабличнаяЧастьЗаполнена
	//
	//	2) Требуется полный расчет расхождений? Уточнить, если требуется.
	//		ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет
	
	ОписаниеТабличнойЧасти = Новый Структура();
	ОписаниеТабличнойЧасти.Вставить("Имя",				?(ЭтоНедостача, "СоставБСОНедостачи", "СоставБСОИзлишки"));
	ОписаниеТабличнойЧасти.Вставить("Представление",	?(ЭтоНедостача, "Недостачи БСО", "Излишки БСО"));
	ОписаниеТабличнойЧасти.Вставить("ЭтоНедостача",		ЭтоНедостача);
	
	// Если заполняемая табл.часть содержит строки, то просим подтвердить заполнение:
	Если Объект[ОписаниеТабличнойЧасти["Имя"]].Количество() > 0 Тогда
		ЧемЗаполнена = ?(ЭтоНедостача, "недостачами БСО", "излишками БСО");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Таблица ""%1"" будет очищена.
				|
				|Продолжить и заполнить выявленными %2?'"),
			ОписаниеТабличнойЧасти["Представление"],
			ЧемЗаполнена);
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ОписаниеТабличнойЧасти", ОписаниеТабличнойЧасти);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьБСО_ТабличнаяЧастьЗаполнена_Выбор", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет(ОписаниеТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_ТабличнаяЧастьЗаполнена_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет(ПараметрыОповещения["ОписаниеТабличнойЧасти"]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет(ОписаниеТабличнойЧасти)
	
	// Вынуждаем рассчитать излишки и недостачи БСО,
	// если такой расчет еще не выполнялся
	Если Объект["НеобходимоРассчитатьРасхожденияБСО"]
		И Объект["СоставБСО"].Количество() > 0 Тогда
		
		Текст = НСтр("ru='Сначала будут рассчитаны и излишки, и недостачи БСО.
			|Таблица ""Результаты инвентаризации БСО"" будет преобразована для того, чтобы рассчитать недостачу и излишек по каждому диапазону номеров.
			|
			|Затем будет заполнена таблица ""%1"", как и планировалось.
			|
			|Продолжить?'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, ОписаниеТабличнойЧасти["Представление"]);
		
		ПараметрыОповещения = Новый Структура();
		ПараметрыОповещения.Вставить("ОписаниеТабличнойЧасти", ОписаниеТабличнойЧасти);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет_Выбор", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьБСО_РасхождениеКлиент(ОписаниеТабличнойЧасти);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_ТребуетсяПолныйРасчет_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		Если ПроверитьИРассчитатьБСОНедостачиИзлишкиКлиент() Тогда
			ЗаполнитьБСО_РасхождениеКлиент(ПараметрыОповещения["ОписаниеТабличнойЧасти"]);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьБСО_РасхождениеКлиент(ОписаниеТабличнойЧасти)
	
	ЗаполнитьБСО_РасхождениеСервер(ОписаниеТабличнойЧасти);
	
	Если Объект[ОписаниеТабличнойЧасти["Имя"]].Количество() = 0 Тогда
		ТекстСообщения = ?(ОписаниеТабличнойЧасти["ЭтоНедостача"],
			НСтр("ru='Недостачи БСО не выявлены'"),
			НСтр("ru='Излишки БСО не выявлены'"));
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБСО_РасхождениеСервер(ОписаниеТабличнойЧасти)
	
	// Заполняем необходимую табл.часть:
	Документы.ИнвентаризацияКассы.ЗаполнитьТаблицу_БСО_Расхождение(Объект, ОписаниеТабличнойЧасти["ЭтоНедостача"]);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьИРассчитатьБСОНедостачиИзлишкиКлиент()
	
	Если НЕ БСОЗаполненыКорректно() Тогда
		
		ТекстСообщения = НСтр("ru='Расчет недостач и излишков БСО не выполнен, т.к. обнаружены ошибки заполнения таблицы ""Результаты инвентаризации БСО""'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	РассчитатьБСОНедостачиИзлишкиКлиент();
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьБСОНедостачиИзлишкиКлиент()
	
	РезультатЗадания = РассчитатьБСОНедостачиИзлишкиСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("РассчитатьБСОНедостачиИзлишкиКлиент_ЗавершениеФоновогоЗадания", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция РассчитатьБСОНедостачиИзлишкиСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Расчет недостач и излишков БСО'");
	
	ПараметрыПроцедуры = Документы.ИнвентаризацияКассы.ПолучитьПараметрыПроцедурыРасчетаРасхожденийБСО(Объект);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.ИнвентаризацияКассы.РассчитатьБСОНедостачиИзлишки", ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура РассчитатьБСОНедостачиИзлишкиКлиент_ЗавершениеФоновогоЗадания(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		РассчитатьБСОНедостачиИзлишкиСервер_ЗавершениеФоновогоЗадания(Результат.АдресРезультата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьБСОНедостачиИзлишкиСервер_ЗавершениеФоновогоЗадания(Знач АдресРезультата)
	
	РезультатыРасчета = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект["СоставБСО"].Загрузить(РезультатыРасчета);
	
	ЗаполнитьПредставленияНомеровБСО(Истина); // ТолькоСоставБСО
	
	Объект["НеобходимоРассчитатьРасхожденияБСО"] = Ложь;
	
	Модифицированность = Истина;
	
КонецПроцедуры

//---
// Факт по учету БСО

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_ФактическоеНаличие()
	
	Если Объект["СоставБСО"].Количество() > 0 Тогда
		ТекстСообщения = НСтр("ru='Заполнить колонки ""По факту"" данными из соответствующих колонок ""По учету""?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьБСО_ФактическоеНаличие_Выбор", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗаполнитьБСО_ФактическоеНаличие_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ЗаполнитьБСО_ФактическоеНаличиеСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБСО_ФактическоеНаличиеСервер()
	
	ТаблЧасть = Объект["СоставБСО"];
	
	Для Каждого СтрокаТЧ Из ТаблЧасть Цикл
		СтрокаТЧ["НачальныйНомерФакт"]	= СтрокаТЧ["НачальныйНомерУчет"];
		СтрокаТЧ["КонечныйНомерФакт"]	= СтрокаТЧ["КонечныйНомерУчет"];
		СтрокаТЧ["КоличествоФакт"]		= СтрокаТЧ["КонечныйНомерФакт"] - СтрокаТЧ["НачальныйНомерФакт"] + 1;
		
		СтрокаТЧ["НачальныйНомерФактПредставление"]	= СтрокаТЧ["НачальныйНомерУчетПредставление"];
		СтрокаТЧ["КонечныйНомерФактПредставление"]	= СтрокаТЧ["КонечныйНомерУчетПредставление"];
		
		КоличествоРасхождение = СтрокаТЧ["КоличествоУчет"] - СтрокаТЧ["КоличествоФакт"];
		СтрокаТЧ["Недостача"]	= ?(КоличествоРасхождение > 0, КоличествоРасхождение, 0);
		СтрокаТЧ["Излишек"]		= ?(КоличествоРасхождение < 0, -КоличествоРасхождение, 0);
	КонецЦикла;
	
	// Настраиваем форму:
	Объект["НеобходимоРассчитатьРасхожденияБСО"] = Ложь;
	
КонецПроцедуры

//---
// Групповое заполнение строк
//---

&НаКлиенте
Функция ПолучитьПараметрыФормыГрупповогоЗаполненияСтрок(ИмяТабличнойЧасти, КоличествоСтрок) Экспорт
	
	СвязиПараметровВыбора = Новый Структура("Дата, Организация, ИФО");
	ЗаполнитьЗначенияСвойств(СвязиПараметровВыбора, Объект);
	
	СвязиПараметровВыбора.Вставить("Сотрудник", Объект["МОЛ"]);
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("ИФО",				Объект["ИФО"]);
	ЗначенияЗаполнения.Вставить("Подразделение",	Объект["Подразделение"]);
	
	НеиспользуемыеПоля = Новый Массив();
	НеиспользуемыеПоля.Добавить("Счет");
	НеиспользуемыеПоля.Добавить("ВидДокумента");
	
	Если ИмяТабличнойЧасти = "ДенежныеСредстваИзлишки" ИЛИ ИмяТабличнойЧасти = "ДенежныеСредстваНедостачи" Тогда
		
		НеиспользуемыеПоля.Добавить("ЦМО");
		
	ИначеЕсли ИмяТабличнойЧасти = "ДенежныеДокументыИзлишки" ИЛИ ИмяТабличнойЧасти = "ДенежныеДокументыНедостачи" Тогда
		
		НеиспользуемыеПоля.Добавить("ЦМО");
		НеиспользуемыеПоля.Добавить("КЭК");
		
	ИначеЕсли ИмяТабличнойЧасти = "СоставБСОИзлишки" ИЛИ ИмяТабличнойЧасти = "СоставБСОНедостачи" Тогда
		
		НеиспользуемыеПоля.Добавить("КПС");
		НеиспользуемыеПоля.Добавить("КЭК");
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	ПараметрыФормы.Вставить("НеиспользуемыеПоля",		НеиспользуемыеПоля);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТабличнойЧасти = ПараметрыОповещения["ИмяТабличнойЧасти"];
	
	ВыделенныеСтроки = Элементы[ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

