&НаКлиенте
Процедура ПраваПользованияСписатьОтложенныеДоходыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.СписатьОтложенныеДоходы > ТекущиеДанные.ОстатокДБП Тогда
		ТекущиеДанные.СписатьОтложенныеДоходы = ТекущиеДанные.ОстатокДБП;
	КонецЕсли;
	
	ПересчитатьСуммыВСтрокеТаблицы(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияИзменениеБалансоваяСтоимостьПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.ИзменениеБалансоваяСтоимость < 0 // Уменьшаем балансовую стоимость.
		И ТекущиеДанные.ОстатокБалансоваяСтоимость + ТекущиеДанные.ИзменениеБалансоваяСтоимость < 0 Тогда
		ТекущиеДанные.ИзменениеБалансоваяСтоимость = (-1) * ТекущиеДанные.ОстатокБалансоваяСтоимость;
	КонецЕсли;
	
	// Записываем в реквизит табчасти с обратным знаком.
	ТекущиеДанные.СписатьБалансоваяСтоимость = (-1) * ТекущиеДанные.ИзменениеБалансоваяСтоимость;
	
	ПересчитатьСуммыВСтрокеТаблицы(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияИзменениеАмортизацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.ИзменениеАмортизация < 0 // Уменьшаем накопленную амортизацию.
		И ТекущиеДанные.ОстатокАмортизация + ТекущиеДанные.ИзменениеАмортизация < 0 Тогда
		ТекущиеДанные.ИзменениеАмортизация = (-1) * ТекущиеДанные.ОстатокАмортизация;
	КонецЕсли;
	
	// Записываем в реквизит табчасти с обратным знаком.
	ТекущиеДанные.СписатьАмортизация = (-1) * ТекущиеДанные.ИзменениеАмортизация;
	
	ПересчитатьСуммыВСтрокеТаблицы(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияИзменениеДБППриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если ТекущиеДанные.ИзменениеДБП < 0 // Уменьшаем остаток ДБП (отложенные доходы).
		И ТекущиеДанные.ОстатокДБП + ТекущиеДанные.ИзменениеДБП < 0 Тогда
		ТекущиеДанные.ИзменениеДБП = (-1) * ТекущиеДанные.ОстатокДБП;
	КонецЕсли;
	
	// Записываем в реквизит табчасти с обратным знаком.
	ТекущиеДанные.СписатьОтложенныеДоходы = (-1) * ТекущиеДанные.ИзменениеДБП;
	
	ПересчитатьСуммыВСтрокеТаблицы(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияСуммаРасчетовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = ТекущиеДанные.ВалютаРегламентированногоУчета Тогда
		ТекущиеДанные.СуммаРасчетовВВалюте = ТекущиеДанные.СуммаРасчетов;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПраваПользованияЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ПраваПользования Цикл
		
		ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокБалансоваяСтоимость = НСтр("ru = 'Балансовая стоимость:'");
	СтрокаТаблицы.ЗаголовокДоходы              = НСтр("ru = 'Отложенные доходы:'");
	СтрокаТаблицы.ЗаголовокАмортизация         = НСтр("ru = 'Накопленная амортизация:'");
	
	СтрокаТаблицы.ЗаголовокНеЗаполняется = НСтр("ru = '-'");
	СтрокаТаблицы.ПустойКЭК = НСтр("ru = '-'");
	СтрокаТаблицы.ВалютаРегламентированногоУчета = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ТипИзмененийУсловийПользования) Тогда
		КодИзмененийУсловийПользования = Форма.КэшПараметров.Локальные.КодыИзмененийУсловийПользованияОбъектамиОС.Получить(СтрокаТаблицы.ТипИзмененийУсловийПользования);
		СтрокаТаблицы.ГрафикАмортизации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, на сумму %2'"),
			КодИзмененийУсловийПользования + ": " + СтрокаТаблицы.ТипИзмененийУсловийПользования,
			Формат((-1) * СтрокаТаблицы.СписатьБалансоваяСтоимость, "ЧЦ=18; ЧДЦ=2"));
		СтрокаТаблицы.ГрафикАмортизацииЗаполнен = Истина;
	Иначе
		СтрокаТаблицы.ГрафикАмортизации = НСтр("ru = '<не выбрано>'");
		СтрокаТаблицы.ГрафикАмортизацииЗаполнен = Ложь;
	КонецЕсли;
	
	// Записываем из реквизита табчасти с обратным знаком.
	СтрокаТаблицы.ИзменениеБалансоваяСтоимость = (-1) * СтрокаТаблицы.СписатьБалансоваяСтоимость;
	СтрокаТаблицы.ИзменениеАмортизация         = (-1) * СтрокаТаблицы.СписатьАмортизация;
	СтрокаТаблицы.ИзменениеДБП                 = (-1) * СтрокаТаблицы.СписатьОтложенныеДоходы;
	
	ПересчитатьСуммыВСтрокеТаблицы(СтрокаТаблицы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПараметрыАмортизации

&НаКлиенте
Процедура ПараметрыАмортизацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ПараметрыАмортизацииОтражениеДоходовВУчете" Тогда
		ОткрытьФормуНастройкиОтраженияОтложенныхДоходовВУчете(ВыбраннаяСтрока);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииПриАктивизацииЯчейки(Элемент)

	Если Элементы.ПараметрыАмортизации.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоНоваяСтрока Тогда
		ТекущаяКолонкаТаблицы = Элементы.ПараметрыАмортизации.ТекущийЭлемент;
		Если ТекущаяКолонкаТаблицы.Имя = "ПараметрыАмортизацииОтражениеДоходовВУчете"
			И НЕ Элементы.ПараметрыАмортизации.ТекущиеДанные.ОтражениеДоходовВУчетеЗаполнено Тогда
			ВыбраннаяСтрока = Элементы.ПараметрыАмортизации.ТекущаяСтрока;
			ОткрытьФормуНастройкиОтраженияОтложенныхДоходовВУчете(ВыбраннаяСтрока);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииПередНачаломИзменения(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ПараметрыАмортизации.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетРасходов, ПараметрыАмортизацииПоляАналитикиСчетаРасходов(), "ПараметрыАмортизации");
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ПараметрыАмортизации.ТекущиеДанные;
	
	ЭтоНоваяСтрока = НоваяСтрока;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ЭтоНоваяСтрока = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииОтражениеДоходовВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуНастройкиОтраженияОтложенныхДоходовВУчете(Элементы.ПараметрыАмортизации.ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыАмортизацииСчетРасходовПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПараметрыАмортизации.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетРасходов, ПараметрыАмортизацииПоляАналитикиСчетаРасходов());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтотОбъект, ТекущиеДанные.СчетРасходов, ПараметрыАмортизацииПоляАналитикиСчетаРасходов(), "ПараметрыАмортизации");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизацииПоляАналитикиСчетаРасходов()

	// Пути к данным полей аналитики счета, выбираемого в таблице формы.
	Возврат Новый Структура("Счет, Субконто1, Субконто2, Субконто3, КПС, КЭК, Подразделение",
		"Объект.ПараметрыАмортизации.СчетРасходов",
		"Объект.ПараметрыАмортизации.СубконтоРасходов1",
		"Объект.ПараметрыАмортизации.СубконтоРасходов2",
		"Объект.ПараметрыАмортизации.СубконтоРасходов3",
		"Объект.ПараметрыАмортизации.КПСРасходов",
		"Объект.ПараметрыАмортизации.КЭКРасходов",
		"Объект.ПараметрыАмортизации.ПодразделениеРасходов");

КонецФункции

&НаСервере
Процедура ПараметрыАмортизацииЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из Объект.ПараметрыАмортизации Цикл
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетРасходов, ПараметрыАмортизацииПоляАналитикиСчетаРасходов());
		ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(ЭтотОбъект, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

