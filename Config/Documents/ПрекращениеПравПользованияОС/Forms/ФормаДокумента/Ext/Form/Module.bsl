&НаКлиенте
Процедура ПраваПользованияПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если НЕ Отказ Тогда
		
		// Удаляем строки графика амортизации из табличной части.
		ОтборПоОбъекту = Новый Структура("ОсновноеСредство, Договор", ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.Договор);
		ГрафикАмортизацииПоОбъекту = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъекту);
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
		КонецЦикла;
		
		Если Не (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования")
			И Объект.ИзменитьПорядокНачисленияАмортизации) Тогда
			// Удаляем строки параметров амортизации из табличной части.
			ОтборПоОбъекту = Новый Структура("ОсновноеСредство, Договор", ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.Договор);
			ПараметрыАмортизацииПоОбъекту = Объект.ПараметрыАмортизации.НайтиСтроки(ОтборПоОбъекту);
			Для Каждого СтрокаПараметрыАмортизации Из ПараметрыАмортизацииПоОбъекту Цикл
				Объект.ПараметрыАмортизации.Удалить(Объект.ПараметрыАмортизации.Индекс(СтрокаПараметрыАмортизации));
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПраваПользованияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.ПраваПользования.ТекущиеДанные;
		ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

