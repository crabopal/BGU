Процедура ВидОперацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидОперации", Объект.ВидОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение") Тогда
		
		Если НЕ Объект.ИзменитьСтоимостьПравПользования Тогда
			Объект.ИзменитьСтоимостьПравПользования = Истина;
		КонецЕсли;
		
		Если Объект.ИзменитьПорядокНачисленияАмортизации Тогда
			// Не имеет смысла менять порядок начисления амортизации при прекращении договора.
			Объект.ИзменитьПорядокНачисленияАмортизации = Ложь;
		КонецЕсли;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования") Тогда
		
		Объект.ИзменитьСтоимостьПравПользования = Истина;
		Если Объект.ИзменитьПорядокНачисленияАмортизации Тогда
			// Порядок начисления амортизации доступен только для просмотра.
			Объект.ИзменитьПорядокНачисленияАмортизации = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.ПраваПользования.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены. Продолжить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено. Продолжить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Данные документа будут очищены. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВидОперацииПриИзмененииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		УстановитьВидимостьЭлементов(ЭтотОбъект);
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.ПраваПользования.Очистить();
		УстановитьВидимостьЭлементов(ЭтотОбъект);
		ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	Иначе // Возвращаем старое значение вида операции.
		Объект.ВидОперации = ЭтотОбъект.КэшПараметров.Локальные.ВидОперации;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтоимостьПравПользованияПриИзменении(Элемент)
	
	Если НЕ Объект.ИзменитьСтоимостьПравПользования И НЕ Объект.ИзменитьПорядокНачисленияАмортизации Тогда
		Объект.ИзменитьПорядокНачисленияАмортизации = Истина;
	КонецЕсли;
	
	Если НЕ Объект.ИзменитьСтоимостьПравПользования Тогда
		// Проводки не формируются, закладка "Бухгалтерская операция" не отображается.
		Попытка
			ЭтотОбъект.БухгалтерскиеОперации_ТиповаяОперация = ПредопределенноеЗначение("Справочник.ТиповыеОперации.ПустаяСсылка");
			Подключаемый_ПриИзмененииТиповойОперации(ЭтотОбъект.Элементы.ТиповыеОперации_БухгалтерскиеОперации_ТиповаяОперация);
			//ПодключаемыйСервер_ПриИзмененииТиповойОперации("ТиповыеОперации_ТиповаяОперацияДокумента");
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПорядокНачисленияАмортизацииПриИзменении(Элемент)
	
	Если НЕ Объект.ИзменитьСтоимостьПравПользования И НЕ Объект.ИзменитьПорядокНачисленияАмортизации Тогда
