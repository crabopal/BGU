&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("КодыИзмененийУсловийПользованияОбъектамиОС", Новый Соответствие);
	Выборка = Справочники.ТипыИзмененийУсловийПользованияОбъектамиОС.Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтотОбъект.КэшПараметров.Локальные.КодыИзмененийУсловийПользованияОбъектамиОС.Вставить(Выборка.Ссылка, Выборка.Код);
	КонецЦикла;
	
	ПраваПользованияЗаполнитьДобавленныеКолонки();
	ПараметрыАмортизацииЗаполнитьДобавленныеКолонки();
	ОтборОбновитьТекстГиперссылки();
	
	ОбновитьРеквизитыНачисленияАмортизации(Истина, Истина);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоИзменениеСтоимостиПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования"));
	ЭтоИзменениеСрокаПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования"));
	ЭтоДосрочноеПрекрашениеПравПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение"));
	ЭтоЗавершениеСрокаПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования"));
	ЭтоКорректировкаПравПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "АвтоматическиОтразитьВГрафикахИсполненияДоговоров",
		"Видимость", ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизацииЗаполнить", "Видимость", ЭтоКорректировкаПравПользования);
	
	ВыборРежима = Новый Массив;
	ВыборРежима.Добавить("ЗаголовокИзменить");
	ВыборРежима.Добавить("ИзменитьСтоимостьПравПользования");
	ВыборРежима.Добавить("ИзменитьПорядокНачисленияАмортизации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ВыборРежима, "Видимость", ЭтоКорректировкаПравПользования);
	
	// Закладка "Права пользования".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаПраваПользования", "Видимость", Объект.ИзменитьСтоимостьПравПользования);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПраваПользованияГрафикАмортизации", "Видимость", ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	
	ЭлементыУчетаРасчетов = Новый Массив;
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияСуммаРасчетов");
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияСчетРасчетов");
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияКПСРасчетов");
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияСчетРезервов");
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияКПСРезервов");
	ЭлементыУчетаРасчетов.Добавить("ПраваПользованияРезерв");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыУчетаРасчетов, "Видимость",
		ЭтоДосрочноеПрекрашениеПравПользования ИЛИ ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования ИЛИ
			(ЭтоКорректировкаПравПользования И Объект.ИзменитьСтоимостьПравПользования));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПраваПользованияГруппаСписать", "Видимость", ЭтоДосрочноеПрекрашениеПравПользования ИЛИ ЭтоЗавершениеСрокаПользования);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПраваПользованияГруппаИзменение", "Видимость", ЭтоКорректировкаПравПользования ИЛИ ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	
	// Закладка "Порядок начисления амортизации".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СтраницаПараметрыАмортизации", "Видимость", ЭтоКорректировкаПравПользования И Объект.ИзменитьПорядокНачисленияАмортизации
			ИЛИ ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыАмортизации", "ТолькоПросмотр", ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	
	// Закладка "Бухгалтерская операция".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"БухгалтерскаяОперация", "Видимость", Объект.ИзменитьСтоимостьПравПользования);
	
	УстановитьВидимостьЭлементовНачисленияАмортизации(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНачисленияАмортизации(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоИзменениеСтоимостиПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования"));
	ЭтоИзменениеСрокаПользования = (Объект.ВидОперации = ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования"));
	ПоказыватьГруппуНачислениеАмортизации = НЕ (ЭтоИзменениеСтоимостиПользования ИЛИ ЭтоИзменениеСрокаПользования);
	
	ЕстьДокументНачисленияАмортизации = ЗначениеЗаполнено(Форма.НачислениеАмортизации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНачислениеАмортизацииКнопка", "Видимость", ПоказыватьГруппуНачислениеАмортизации И НЕ ЕстьДокументНачисленияАмортизации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНачислениеАмортизацииСсылка", "Видимость", ПоказыватьГруппуНачислениеАмортизации И ЕстьДокументНачисленияАмортизации);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// При передаче в аренду (обычную) доходы от предоставления прав пользования активами отсутствуют.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСписатьОтложенныеДоходы");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияИзменениеДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияОстатокДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияПослеИзмененияДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииПослеИзмененияДБП");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ОстатокДБП", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствуют'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКПСДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКФОДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСчетДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКЭКДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияНоменклатура");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ОстатокДБП", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииОтложенныеДоходы");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ОтложенныеДоходы", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствуют'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ОтложенныеДоходы", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// При передаче в безвозмездное пользование сумма расчетов по договору отсутствует.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСуммаРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.СуммаРасчетов", ВидСравненияКомпоновкиДанных.Равно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствуют'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСуммаРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.СуммаРасчетов", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст); // Ошибка, введены некорректные данные.
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСчетРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКПСРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСчетРезервов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКПСРезервов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияРезерв");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииСчетРасчетов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Отсутствуют'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииКПСРасчетов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииТекстПринятьНДСКВычету");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииПринятьНДСКВычету");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ВидОперации",
			ВидСравненияКомпоновкиДанных.Равно, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// При расчетах в иностранной валюте.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияОстатокРезервовВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСуммаРасчетовВВалюте");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияВалютаРегламентированногоУчета");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.Валюта",
			ВидСравненияКомпоновкиДанных.Равно, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Поля счета и аналитики 401.40 доступны для редактирования, только если остаток по 401.40 равен нулю.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКПСДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКФОДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияСчетДБП");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияКЭКДоходов");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияНоменклатура");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ОстатокДБП", ВидСравненияКомпоновкиДанных.НеРавно, 0);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Видимость "Статьи прочих расходов (НУ)" в таблице параметров амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииСтатьяПрочихРасходовНУ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.СчетРасходов", ВидСравненияКомпоновкиДанных.НеРавно,
			БухгалтерскийУчет.СчетПоКоду("401.20", Объект.Дата));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Способ начисления амортизации "По графику".
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииДатаНачалаАмортизации");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииДатаОкончанияАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.СпособПризнанияРасходов", ВидСравненияКомпоновкиДанных.Равно,
			Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Отражение доходов в учете.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПараметрыАмортизацииОтражениеДоходовВУчете");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПараметрыАмортизации.ОтражениеДоходовВУчетеЗаполнено", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// График начисления амортизации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НезаполненныйРеквизит);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПраваПользованияГрафикАмортизации");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПраваПользования.ГрафикАмортизацииЗаполнен", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОтбораВХранилище(АдресХранилища = "")
	
	Если ПустаяСтрока(АдресХранилища) Тогда
		Результат = ПоместитьВоВременноеХранилище(Объект.Отбор.Выгрузить(), УникальныйИдентификатор);
	Иначе
		ТаблицаОтбора = ПолучитьИзВременногоХранилища(АдресХранилища); 
		Объект.Отбор.Загрузить(ТаблицаОтбора);
		ОтборОбновитьТекстГиперссылки();
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьДокументПараметрыВопроса()
	
	ПараметрыВопроса = Новый Структура;
	ПараметрыВопроса.Вставить("ЗадатьВопрос", Ложь);
	ПараметрыВопроса.Вставить("ТекстВопроса",
		НСтр("ru = 'Заполнить документ по остаткам на счетах и регистрам бухгалтерского учета?'") );
	
	ЕстьДанныеВДокументе = (Объект.ПраваПользования.Количество() > 0);
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ПараметрыВопроса.ТекстВопроса = ПараметрыВопроса.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены.'");
		ПараметрыВопроса.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат ПараметрыВопроса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДокументОбработкаОтвета(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьДокументНаСервере(
			ДополнительныеПараметры.ЗаполнитьСтоимостьПравПользования,
			ДополнительныеПараметры.ЗаполнитьПорядокНачисленияАмортизации);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере(ЗаполнитьСтоимостьПравПользования = Истина, ЗаполнитьПорядокНачисленияАмортизации = Истина)
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент(ЗаполнитьСтоимостьПравПользования, ЗаполнитьПорядокНачисленияАмортизации);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ПраваПользованияЗаполнитьДобавленныеКолонки();
	ПараметрыАмортизацииЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьРеквизитыНачисленияАмортизации(ОбновитьСсылку, ОбновитьДатыНачисленияАмортизации)
	
	Если ОбновитьСсылку Тогда
		
		Если НЕ Объект.Ссылка.Пустая() Тогда
			Реквизиты = Документы.ПрекращениеПравПользованияОС.РеквизитыПодчиненногоДокументаНачислениеАмортизации(Объект.Ссылка);
			НачислениеАмортизации = Реквизиты.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ОбновитьДатыНачисленияАмортизации Тогда
		
		ЕстьДокументНачисленияАмортизации = ЗначениеЗаполнено(НачислениеАмортизации);
		Если НЕ ЕстьДокументНачисленияАмортизации Тогда
			ДатаДокумента = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
			НачислениеАмортизацииДатаНачала = НачалоМесяца(ДатаДокумента);
			НачислениеАмортизацииДатаОкончания = КонецДня(ДатаДокумента);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНачислениеАмортизацииНаКлиенте()
	
	Если Объект.Ссылка.Пустая() Тогда
		Записать();
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура("Организация,ИФО,КФО,Контрагент,Ответственный");
	ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Объект);
	ЗначенияЗаполнения.Вставить("ДокументОснование", Объект.Ссылка);
	ЗначенияЗаполнения.Вставить("Дата", НачислениеАмортизацииДатаОкончания);
	ЗначенияЗаполнения.Вставить("Отбор", Объект.Отбор);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ФормаНовогоДокумента = ОткрытьФорму("Документ.НачислениеАмортизацииПравПользованияОС.ФормаОбъекта",
		ПараметрыФормы, ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ПослеИзмененияБалансоваяСтоимость = СтрокаТаблицы.ОстатокБалансоваяСтоимость - СтрокаТаблицы.СписатьБалансоваяСтоимость;
	СтрокаТаблицы.ПослеИзмененияАмортизация         = СтрокаТаблицы.ОстатокАмортизация         - СтрокаТаблицы.СписатьАмортизация;
	СтрокаТаблицы.ПослеИзмененияДБП                 = СтрокаТаблицы.ОстатокДБП                 - СтрокаТаблицы.СписатьОтложенныеДоходы;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияОтложенныхДоходовВУчете(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ПараметрыАмортизации.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, КФО");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект, "Дата, Организация");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки, "КФО");
	
	ПараметрыФормы.Вставить("РежимДоходы", Истина);
	ПараметрыФормы.Вставить("ИмяРеквизитаСчет", "СчетДоходов");
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК устанавливаются в таблице, изменять их не нужно.
	ПараметрыФормы.Вставить("ВидимостьКФО",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",       Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	
	// Бухгалтерский учет.
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДоходов);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДоходов1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДоходов2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДоходов3);
	
	// Налоговый учет.
	ПараметрыФормы.Вставить("ВидДеятельностиНУ",      ДанныеСтроки.ВидДеятельностиНУ);
	ПараметрыФормы.Вставить("СчетНУ",                 ДанныеСтроки.СчетДоходовНУ);
	ПараметрыФормы.Вставить("СтатьяПрочихДоходовНУ",  ДанныеСтроки.СтатьяПрочихДоходовНУ);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Настройка отражения в учете доходов от предоставления прав пользования активами'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Счет доходов'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("401.10", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ПараметрыСчетаНУ = Новый Структура;
	ПараметрыСчетаНУ.Вставить("ОграниченияСписокСчетов", БухгалтерскийУчетКлиентСервер.СписокСчетов("Н90.01,Н91.01", Объект.Дата));
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчетаНУ.Вставить("Отбор", ОтборСчета);
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияДоходовВУчетеНаКлиенте(СтруктураОтражениеВУчете)

	ТекущиеДанные = Элементы.ПараметрыАмортизации.ТекущиеДанные;
	
	// Бухгалтерский учет.
	ТекущиеДанные.СчетДоходов      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДоходов1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДоходов2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДоходов3 = СтруктураОтражениеВУчете.Субконто3;
	
	// Налоговый учет.
	ТекущиеДанные.ВидДеятельностиНУ     = СтруктураОтражениеВУчете.ВидДеятельностиНУ;
	ТекущиеДанные.СчетДоходовНУ         = СтруктураОтражениеВУчете.СчетНУ;
	ТекущиеДанные.СтатьяПрочихДоходовНУ = СтруктураОтражениеВУчете.СтатьяПрочихДоходовНУ;
	
	ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(ЭтотОбъект, ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьДобавленныеКолонкиОтраженияДоходовВУчете(Форма, СтрокаТаблицы)
	
	Параметры = Новый Структура;
	Параметры.Вставить("РежимДоходы", Истина);
	Параметры.Вставить("ОтражатьВНалоговомУчете", Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО));
	
	ПоляФормы = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,СчетНУ,ВидДеятельностиНУ,СтатьяПрочихДоходовНУ,ОтражениеВУчете",
		"СчетДоходов",
		"СубконтоДоходов1",
		"СубконтоДоходов2",
		"СубконтоДоходов3",
		"СчетДоходовНУ",
		"ВидДеятельностиНУ",
		"СтатьяПрочихДоходовНУ",
		"ОтражениеДоходовВУчете");
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, Параметры, ПоляФормы);
	
	СтрокаТаблицы.ТекстПринятьНДСКВычету = НСтр("ru = ' НДС принимать к вычету'");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуГрафикаНачисленияАмортизации(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Объект.ПраваПользования.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура("Дата, Организация, Договор, ВидОперации, ТипИзмененийУсловийПользования,
		|АренднаяПлатаСумма, АренднаяПлатаСуммаДоИзменения,
		|АренднаяПлатаЗаПериод, АренднаяПлатаЗаПериодДоИзменения,
		|НачалоПериодаПересчета, КонецПериодаПересчета,
		|УсловиеПользованияДоИзменения, УсловиеПользования, 
		|ДатаНачалаАмортизацииДоИзменения, ДатаНачалаАмортизации, ДатаОкончанияАмортизацииДоИзменения, ДатаОкончанияАмортизации");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект, "Дата, Организация");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, ДанныеСтроки);
	
	ПараметрыФормы.Вставить("Валюта", ?(ЗначениеЗаполнено(ДанныеСтроки.Валюта), ДанныеСтроки.Валюта, ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
	ПараметрыФормы.Вставить("ВидОперацииДокумента", Объект.ВидОперации);
	
	ПараметрыФормы.Вставить("ГрафикАмортизации", ПоместитьГрафикАмортизацииВХранилище(ДанныеСтроки.ОсновноеСредство, ДанныеСтроки.Договор));
	
	ОткрытьФорму("Документ.ПрекращениеПравПользованияОС.Форма.ФормаГрафикНачисленияАмортизации", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаСервере
Функция ПоместитьГрафикАмортизацииВХранилище(ОсновноеСредство, Договор)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ОсновноеСредство", ОсновноеСредство);
	Отбор.Вставить("Договор", Договор);
	ГрафикАмортизации = Объект.ГрафикАмортизации.Выгрузить(Отбор);
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораГрафикаНачисленияАмортизацииНаСервере(ТекущаяСтрока, ПараметрыГрафикаАмортизации)
	
	ДанныеСтроки = Объект.ПраваПользования.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
		|АренднаяПлатаСумма,АренднаяПлатаЗаПериод,НачалоПериодаПересчета,КонецПериодаПересчета");
	
	ЗаполнитьЗначенияСвойств(ДанныеСтроки, ПараметрыГрафикаАмортизации,
		"ТипИзмененийУсловийПользования,УсловиеПользования");
	
	// Удаляем строки особого графика из табличной части.
	ОтборПоОбъектуОС = Новый Структура("ОсновноеСредство,Договор", ДанныеСтроки.ОсновноеСредство, ДанныеСтроки.Договор);
	НайденныеСтроки = Объект.ГрафикАмортизации.НайтиСтроки(ОтборПоОбъектуОС);
	Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
		Объект.ГрафикАмортизации.Удалить(Объект.ГрафикАмортизации.Индекс(СтрокаГрафика));
	КонецЦикла;
	
	// Добавляем новые строки графика амортизации.
	БалансоваяСтоимостьИзменение = 0;
	ОтложенныеДоходыИзменение = 0;
	ГрафикАмортизацииПоОбъекту = ПолучитьИзВременногоХранилища(ПараметрыГрафикаАмортизации.ГрафикАмортизации);
	Если ГрафикАмортизацииПоОбъекту.Количество() > 0 Тогда
		Для Каждого СтрокаГрафика Из ГрафикАмортизацииПоОбъекту Цикл
			НоваяСтрока = Объект.ГрафикАмортизации.Добавить();
			НоваяСтрока.ОсновноеСредство = ДанныеСтроки.ОсновноеСредство;
			НоваяСтрока.Договор = ДанныеСтроки.Договор;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика,
				"АмортизацияДоИзменения,Амортизация,АмортизацияПослеИзменения,
				|АренднаяПлатаДоИзменения,АренднаяПлата,АренднаяПлатаПослеИзменения,
				|ДатаНачисленияАмортизации,ОплатитьДо");
			БалансоваяСтоимостьИзменение = БалансоваяСтоимостьИзменение + СтрокаГрафика.Амортизация;
			ОтложенныеДоходыИзменение = ОтложенныеДоходыИзменение + (СтрокаГрафика.Амортизация - СтрокаГрафика.АренднаяПлата);
		КонецЦикла;
	КонецЕсли;
	
	// Пересчитываем в валюту по курсу сформированных резервов.
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет
		И ЗначениеЗаполнено(ДанныеСтроки.Валюта)
		И ДанныеСтроки.Валюта <> ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета Тогда
		КурсПересчета = ?(ДанныеСтроки.ОстатокРезервовВВалюте = 0, 1, ДанныеСтроки.ОстатокРезервов / ДанныеСтроки.ОстатокРезервовВВалюте);
	Иначе
		КурсПересчета = 1;
	КонецЕсли;
	
	ДанныеСтроки.СписатьБалансоваяСтоимость = (-1) * БалансоваяСтоимостьИзменение * КурсПересчета;
	ДанныеСтроки.СписатьОтложенныеДоходы = (-1) * ОтложенныеДоходыИзменение * КурсПересчета;
	ДанныеСтроки.СписатьАмортизация = 0;
	
	ДанныеСтроки.СуммаРасчетов = // Остаточная стоимость права пользования, за исключением безвозмездной части.
		(-1) * ( (ДанныеСтроки.СписатьБалансоваяСтоимость - ДанныеСтроки.СписатьАмортизация) - ДанныеСтроки.СписатьОтложенныеДоходы );
	ДанныеСтроки.СуммаРасчетовВВалюте = БалансоваяСтоимостьИзменение - ОтложенныеДоходыИзменение;
	
	ПраваПользованияЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ДанныеСтроки);
	
	Модифицированность = Истина;
	
КонецПроцедуры

