#Область ОбработчикиСобытийЭлементовТаблицыФормы_Отбор

&НаКлиенте
Процедура НадписьОтборНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура("Дата,Организация,ИФО,КФО,Контрагент");
	ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Объект);
	
	ПараметрыФормы = Новый Структура("ПараметрыОтбора, Отбор, ТолькоПросмотр",
		ПараметрыОтбора, ТаблицаОтбораВХранилище(), ТолькоПросмотр);
	ОткрытьФорму("ОбщаяФорма.НастройкаОтбораПоДоговорам", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОтборОбновитьТекстГиперссылки()
	
	Если Объект.Отбор.Количество() = 0 Тогда
		ТекстГиперссылки = НСтр("ru = '<Без отбора>'");
	Иначе
		ТекстГиперссылки = "";
		Для Каждого СтрокаОтбора Из Объект.Отбор Цикл
			ТекстГиперссылки = ТекстГиперссылки + ?(ТекстГиперссылки = "", "", "; ") + СтрокаОтбора.Договор;
		КонецЦикла;
	КонецЕсли;
	
	НадписьОтбор = ТекстГиперссылки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПраваПользования(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПорядокНачисленияАмортизации =
		(	Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования") );
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаполнитьСтоимостьПравПользования", Истина);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокНачисленияАмортизации", ЗаполнитьПорядокНачисленияАмортизации);
	
	ПараметрыВопроса = ЗаполнитьДокументПараметрыВопроса();
	Если ЗначениеЗаполнено(ПараметрыВопроса.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументОбработкаОтвета", ЭтотОбъект, ПараметрыЗаполнения);
		ПоказатьВопрос(Оповещение, ПараметрыВопроса.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере(
			ПараметрыЗаполнения.ЗаполнитьСтоимостьПравПользования,
			ПараметрыЗаполнения.ЗаполнитьПорядокНачисленияАмортизации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПараметрыАмортизации(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЗаполнитьСтоимостьПравПользования", Ложь);
	ПараметрыЗаполнения.Вставить("ЗаполнитьПорядокНачисленияАмортизации", Истина);
	
	ПараметрыВопроса = ЗаполнитьДокументПараметрыВопроса();
	Если ЗначениеЗаполнено(ПараметрыВопроса.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьДокументОбработкаОтвета", ЭтотОбъект, ПараметрыЗаполнения);
		ПоказатьВопрос(Оповещение, ПараметрыВопроса.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьДокументНаСервере(
			ПараметрыЗаполнения.ЗаполнитьСтоимостьПравПользования,
			ПараметрыЗаполнения.ЗаполнитьПорядокНачисленияАмортизации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНачислениеАмортизации(Команда)
	
	Если Объект.ПометкаУдаления Тогда
		ПоказатьПредупреждение( , НСтр("ru = 'Нельзя сформировать начисление амортизации на основании документа, помеченного на удаление.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Объект.Организация");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НачислениеАмортизацииДатаОкончания) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Дата окончания начисления амортизации'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "НачислениеАмортизацииДатаОкончания");
		Возврат;
	КонецЕсли;
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = НСтр("ru = 'Документ будет записан. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросСформироватьНачислениеАмортизацииЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		СформироватьНачислениеАмортизацииНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСформироватьНачислениеАмортизацииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		СформироватьНачислениеАмортизацииНаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

