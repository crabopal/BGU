
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, ПараметрыНачисленияАмортизации());
	
	Если Параметры.Свойство("ГрафикАмортизации") И ЭтоАдресВременногоХранилища(Параметры.ГрафикАмортизации) Тогда
		ТаблицаГрафикАмортизации = ПолучитьИзВременногоХранилища(Параметры.ГрафикАмортизации);
		ГрафикАмортизации.Загрузить(ТаблицаГрафикАмортизации);
	КонецЕсли;
	
	Если ГрафикАмортизации.Количество() = 0 Тогда
		СформироватьГрафикНачисленияАмортизацииНаСервере();
	КонецЕсли;
	
	НаДату = Параметры.Дата;
	ВидОперации = Параметры.ВидОперации;
	ВидОперацииДокумента = Параметры.ВидОперацииДокумента;
	Договор = Параметры.Договор;
	
	ВестиГрафикПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВестиГрафикПлатежей");
	
	ЗаполнитьСписокТиповИзмененийУсловийПользования(Элементы.ТипИзмененийУсловийПользования.СписокВыбора, ВидОперацииДокумента);
	ТипИзмененийУсловийПользованияКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипИзмененийУсловийПользования, "Код");
	
	ИтогиПоГрафикуАмортизации = РассчитатьИтоговыеСуммыПоГрафикуАмортизации(ЭтотОбъект);
	
	ГрафикАмортизацииЗаполнитьДобавленныеКолонки();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И НЕ Отказ Тогда
			Отказ = НЕ ПроверитьЗаполнениеНаКлиенте();
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(ПараметрыНачисленияАмортизации());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтаФорма);
		
		СтруктураРезультат.Вставить("ГрафикАмортизации", ПоместитьГрафикАмортизацииВХранилище());
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ФормаГрафикНачисленияАмортизации_Закрыть" И Источник = ВладелецФормы Тогда
		// Сообщение от основной формы документа при нажатии там Esc.
		// Сбрасываем флаг модифицированности и закрываем форму редактирования строки без вопросов.
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипИзмененийУсловийПользованияПриИзменении(Элемент)
	
	ТипИзмененийУсловийПользованияПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ТипИзмененийУсловийПользованияПриИзмененииНаСервере()
	
	ТипИзмененийУсловийПользованияКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипИзмененийУсловийПользования, "Код");
	
	Если СтрНайти("С3,С6", ТипИзмененийУсловийПользованияКод) > 0 Тогда
		ДатаОкончанияАмортизации = Дата(1, 1, 1);
	КонецЕсли;
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура АренднаяПлатаСуммаПриИзменении(Элемент)
	
	РассчитатьИтоговыеСуммы();
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПериодовПриИзменении(Элемент)
	
	РассчитатьИтоговыеСуммы();
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПоДоговоруПриИзменении(Элемент)
	
	АмортизацияСумма = СуммаПоДоговору;
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура АмортизацияСуммаПриИзменении(Элемент)
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаАмортизацииПриИзменении(Элемент)
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияАмортизацииПриИзменении(Элемент)
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ГрафикАмортизации

&НаКлиенте
Процедура ГрафикАмортизацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.ГрафикАмортизации.ТекущиеДанные;
		
		Если Копирование Тогда
			ТекущиеДанные.АмортизацияДоИзменения = 0;
			ТекущиеДанные.АренднаяПлатаДоИзменения = 0;
			ТекущиеДанные.Амортизация = ТекущиеДанные.АмортизацияПослеИзменения;
			ТекущиеДанные.АренднаяПлата = ТекущиеДанные.АренднаяПлатаПослеИзменения;
		Иначе
			ГрафикАмортизацииЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ГрафикАмортизации.Сортировать("ДатаНачисленияАмортизации,ОплатитьДо");
	
	ИтогиПоГрафикуАмортизации = РассчитатьИтоговыеСуммыПоГрафикуАмортизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииПослеУдаления(Элемент)
	
	ИтогиПоГрафикуАмортизации = РассчитатьИтоговыеСуммыПоГрафикуАмортизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииАренднаяПлатаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикАмортизации.ТекущиеДанные;
	ТекущиеДанные.АренднаяПлатаПослеИзменения = ТекущиеДанные.АренднаяПлатаДоИзменения + ТекущиеДанные.АренднаяПлата;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииАренднаяПлатаПослеИзмененияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикАмортизации.ТекущиеДанные;
	ТекущиеДанные.АренднаяПлата = ТекущиеДанные.АренднаяПлатаПослеИзменения - ТекущиеДанные.АренднаяПлатаДоИзменения;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииАмортизацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикАмортизации.ТекущиеДанные;
	ТекущиеДанные.АмортизацияПослеИзменения = ТекущиеДанные.АмортизацияДоИзменения + ТекущиеДанные.Амортизация;
	
КонецПроцедуры

&НаКлиенте
Процедура ГрафикАмортизацииАмортизацияПослеИзмененияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ГрафикАмортизации.ТекущиеДанные;
	ТекущиеДанные.Амортизация = ТекущиеДанные.АмортизацияПослеИзменения - ТекущиеДанные.АмортизацияДоИзменения;
	
КонецПроцедуры

&НаСервере
Процедура ГрафикАмортизацииЗаполнитьДобавленныеКолонки()
	
	Для Каждого СтрокаТаблицы Из ГрафикАмортизации Цикл
		
		ГрафикАмортизацииЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(ЭтотОбъект, СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ГрафикАмортизацииЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(Форма, СтрокаТаблицы)
	
	СтрокаТаблицы.ЗаголовокАмортизация   = НСтр("ru = 'Амортизация (справедливая стоимость):'");
	СтрокаТаблицы.ЗаголовокАренднаяПлата = НСтр("ru = 'Арендная плата (сумма по договору):'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериодПересчета(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала = НачалоПериодаПересчета;
	Диалог.Период.ДатаОкончания = КонецПериодаПересчета;
	Диалог.Показать(Новый ОписаниеОповещения("УстановитьПериодПересчетаЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодПересчетаЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		НачалоПериодаПересчета = Период.ДатаНачала;
		КонецПериодаПересчета  = Период.ДатаОкончания;
		
		Модифицированность = Истина;
		
		СформироватьГрафикНачисленияАмортизацииНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьГрафик(Команда)
	
	СформироватьГрафикНачисленияАмортизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыНачисленияАмортизации()
	
	Возврат "ТипИзмененийУсловийПользования,УсловиеПользованияДоИзменения,УсловиеПользования,Валюта,
		|АренднаяПлатаСуммаДоИзменения,АренднаяПлатаСумма,
		|АренднаяПлатаЗаПериодДоИзменения,АренднаяПлатаЗаПериод,
		|НачалоПериодаПересчета,КонецПериодаПересчета,
		|ДатаНачалаАмортизацииДоИзменения,ДатаНачалаАмортизации,ДатаОкончанияАмортизации,ДатаОкончанияАмортизацииДоИзменения";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ЭтоПоступлениеВБезвозмездноеПользование =
		(Форма.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "УсловиеПользования", "Доступность",
		Форма.ВидОперацииДокумента <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "АренднаяПлатаСумма", "ТолькоПросмотр",
		Форма.ВидОперацииДокумента <> ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДатаОкончанияАмортизации", "ТолькоПросмотр",
		Форма.ВидОперацииДокумента = ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования")
			ИЛИ СтрНайти("С3,С6", Форма.ТипИзмененийУсловийПользованияКод) > 0);
	
	ЭлементыПериодПересчета = Новый Массив;
	ЭлементыПериодПересчета.Добавить("НачалоПериодаПересчета");
	ЭлементыПериодПересчета.Добавить("КонецПериодаПересчета");
	ЭлементыПериодПересчета.Добавить("УстановитьПериодПересчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыПериодПересчета, "Видимость",
		Форма.ВидОперацииДокумента = ПредопределенноеЗначение("Перечисление.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования")
			И СтрНайти("А2", Форма.ТипИзмененийУсловийПользованияКод) > 0);
	
	ЭлементыГрафикПлатежей = Новый Массив;
	ЭлементыГрафикПлатежей.Добавить("ГрафикАмортизацииОплатитьДо");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыГрафикПлатежей, "Видимость",
		Форма.ВестиГрафикПлатежей И Не ЭтоПоступлениеВБезвозмездноеПользование);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТиповИзмененийУсловийПользования(СписокВыбора, ВидОперации)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТипыИзмененийУсловийПользованияОбъектамиОС.Ссылка КАК Ссылка,
	|	ТипыИзмененийУсловийПользованияОбъектамиОС.Код КАК Код,
	|	ТипыИзмененийУсловийПользованияОбъектамиОС.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ТипыИзмененийУсловийПользованияОбъектамиОС КАК ТипыИзмененийУсловийПользованияОбъектамиОС
	|ГДЕ
	|	ТипыИзмененийУсловийПользованияОбъектамиОС.ВидОперации = &ВидОперации
	|	И ТипыИзмененийУсловийПользованияОбъектамиОС.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипыИзмененийУсловийПользованияОбъектамиОС.Код";
	ТипыИзмененийПоВидуОперации = Запрос.Выполнить().Выгрузить();
	
	СписокВыбора.Очистить();
	Для Каждого ТипИзменений Из ТипыИзмененийПоВидуОперации Цикл
		СписокВыбора.Добавить(ТипИзменений.Ссылка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: %2'"),
			ТипИзменений.Код,
			ТипИзменений.Наименование));
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()
	
	Отказ = Ложь;
	
	Если СтрНайти("А2", ТипИзмененийУсловийПользованияКод) > 0 Тогда
		
		Если НачалоДня(НачалоПериодаПересчета) > НачалоДня(КонецПериодаПересчета) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Период пересчета'"), , ,
				НСтр("ru = 'Дата начала периода пересчета превышает дату окончания'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "НачалоПериодаПересчета", "", Отказ);
		КонецЕсли;
		
		Если КонецДня(КонецПериодаПересчета) > КонецДня(НаДату) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Период пересчета'"), , ,
				НСтр("ru = 'Дата окончания периода пересчета превышает дату документа'"));
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КонецПериодаПересчета", "", Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Функция ПоместитьГрафикАмортизацииВХранилище()
	
	Возврат ПоместитьВоВременноеХранилище(ГрафикАмортизации.Выгрузить(), УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Функция РассчитатьИтоговыеСуммы()
	
	ЭтоПоступлениеВБезвозмездноеПользование =
		(ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование"));
	
	АмортизацияСумма = КоличествоПериодов * АренднаяПлатаСумма;
	
	Если ЭтоПоступлениеВБезвозмездноеПользование Тогда
		СуммаПоДоговору = 0;
	Иначе
		СуммаПоДоговору = АмортизацияСумма;
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция РассчитатьИтоговыеСуммыПоГрафикуАмортизации(Форма)
	
	ИтоговыеСуммыПоГрафикуАмортизации = Новый Структура("СуммаПоДоговоруДоИзменения,АмортизацияСуммаДоИзменения,СуммаПоДоговору,АмортизацияСумма,КоличествоПериодовДоИзменения,КоличествоПериодов", 0, 0, 0, 0, 0, 0);
	
	Для Каждого СтрокаГрафика Из Форма.ГрафикАмортизации Цикл
		Если ЗначениеЗаполнено(СтрокаГрафика.АренднаяПлатаДоИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.СуммаПоДоговоруДоИзменения = ИтоговыеСуммыПоГрафикуАмортизации.СуммаПоДоговоруДоИзменения + СтрокаГрафика.АренднаяПлатаДоИзменения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГрафика.АмортизацияДоИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.АмортизацияСуммаДоИзменения = ИтоговыеСуммыПоГрафикуАмортизации.АмортизацияСуммаДоИзменения + СтрокаГрафика.АмортизацияДоИзменения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГрафика.АренднаяПлатаПослеИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.СуммаПоДоговору = ИтоговыеСуммыПоГрафикуАмортизации.СуммаПоДоговору + СтрокаГрафика.АренднаяПлатаПослеИзменения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГрафика.АмортизацияПослеИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.АмортизацияСумма = ИтоговыеСуммыПоГрафикуАмортизации.АмортизацияСумма + СтрокаГрафика.АмортизацияПослеИзменения;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГрафика.АренднаяПлатаДоИзменения) ИЛИ ЗначениеЗаполнено(СтрокаГрафика.АмортизацияДоИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.КоличествоПериодовДоИзменения = ИтоговыеСуммыПоГрафикуАмортизации.КоличествоПериодовДоИзменения + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГрафика.АренднаяПлатаПослеИзменения) ИЛИ ЗначениеЗаполнено(СтрокаГрафика.АмортизацияПослеИзменения) Тогда
			ИтоговыеСуммыПоГрафикуАмортизации.КоличествоПериодов = ИтоговыеСуммыПоГрафикуАмортизации.КоличествоПериодов + 1;
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Форма, ИтоговыеСуммыПоГрафикуАмортизации,
		"СуммаПоДоговоруДоИзменения,АмортизацияСуммаДоИзменения,СуммаПоДоговору,АмортизацияСумма,КоличествоПериодовДоИзменения,КоличествоПериодов");
	
	Возврат ИтоговыеСуммыПоГрафикуАмортизации;
	
КонецФункции

&НаСервере
Процедура СформироватьГрафикНачисленияАмортизацииНаСервере()
	
	ПараметрыАмортизации = Новый Структура("ТипИзмененийУсловийПользования,ТипИзмененийУсловийПользованияКод,
		|НачалоПериодаПересчета,КонецПериодаПересчета,НаДату,
		|ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
		|АренднаяПлатаСуммаДоИзменения,АренднаяПлатаСумма");
	ЗаполнитьЗначенияСвойств(ПараметрыАмортизации, ЭтотОбъект);
	
	СформироватьГрафикНачисленияАмортизации(ГрафикАмортизации, ПараметрыАмортизации);
	
	ГрафикАмортизацииЗаполнитьДобавленныеКолонки();
	ИтогиПоГрафикуАмортизации = РассчитатьИтоговыеСуммыПоГрафикуАмортизации(ЭтотОбъект);
	
КонецПроцедуры

// Формирует график амортизации при изменении стоимости или срока аренды (пользования).
//
&НаСервереБезКонтекста
Процедура СформироватьГрафикНачисленияАмортизации(ГрафикАмортизации, ПараметрыАмортизации)
	
	// Очищаем изменения в графике.
	СтрокиКУдалению = Новый Массив;
	Для Каждого СтрокаГрафика Из ГрафикАмортизации Цикл
		Если СтрокаГрафика.АмортизацияДоИзменения = 0 И СтрокаГрафика.АренднаяПлатаДоИзменения = 0 Тогда
			СтрокиКУдалению.Добавить(СтрокаГрафика);
		Иначе
			СтрокаГрафика.Амортизация = 0;
			СтрокаГрафика.АренднаяПлата = 0;
			СтрокаГрафика.АмортизацияПослеИзменения = СтрокаГрафика.АмортизацияДоИзменения;
			СтрокаГрафика.АренднаяПлатаПослеИзменения = СтрокаГрафика.АренднаяПлатаДоИзменения;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
		ГрафикАмортизации.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Если ПараметрыАмортизации.ТипИзмененийУсловийПользованияКод = "А1" Тогда // Изменение арендных платежей на последующий срок.
		
		Для Каждого СтрокаГрафика Из ГрафикАмортизации Цикл
			
			Если СтрокаГрафика.ДатаНачисленияАмортизации >= ПараметрыАмортизации.НаДату Тогда
				КоэффициентПересчета = ?(ПараметрыАмортизации.АренднаяПлатаСуммаДоИзменения <> 0, ПараметрыАмортизации.АренднаяПлатаСумма / ПараметрыАмортизации.АренднаяПлатаСуммаДоИзменения, 1);
				СтрокаГрафика.АмортизацияПослеИзменения = КоэффициентПересчета * СтрокаГрафика.АмортизацияДоИзменения;
				СтрокаГрафика.АренднаяПлатаПослеИзменения = КоэффициентПересчета * СтрокаГрафика.АренднаяПлатаДоИзменения;
				СтрокаГрафика.Амортизация = СтрокаГрафика.АмортизацияПослеИзменения - СтрокаГрафика.АмортизацияДоИзменения;
				СтрокаГрафика.АренднаяПлата = СтрокаГрафика.АренднаяПлатаПослеИзменения - СтрокаГрафика.АренднаяПлатаДоИзменения;
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ПараметрыАмортизации.ТипИзмененийУсловийПользованияКод = "А2" Тогда // Изменение арендных платежей в связи с пересчетом за предыдущий срок.
		
		АмортизацияИзменение = 0;
		АренднаяПлатаИзменение = 0;
		Для Каждого СтрокаГрафика Из ГрафикАмортизации Цикл
			
			ПопадаетВПериодПересчета =
				(СтрокаГрафика.ДатаНачисленияАмортизации >= ПараметрыАмортизации.НачалоПериодаПересчета
				И СтрокаГрафика.ДатаНачисленияАмортизации <= ПараметрыАмортизации.КонецПериодаПересчета);
			
			Если ПопадаетВПериодПересчета Тогда
				КоэффициентПересчета = ?(ПараметрыАмортизации.АренднаяПлатаСуммаДоИзменения <> 0, ПараметрыАмортизации.АренднаяПлатаСумма / ПараметрыАмортизации.АренднаяПлатаСуммаДоИзменения - 1, 0);
				АмортизацияИзменение = АмортизацияИзменение + КоэффициентПересчета * СтрокаГрафика.АмортизацияДоИзменения;
				АренднаяПлатаИзменение = АренднаяПлатаИзменение + КоэффициентПересчета * СтрокаГрафика.АренднаяПлатаДоИзменения;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаКорректировкиГрафика = Неопределено;
		ОтборПоДатеНачисленияАмортизации = Новый Структура("ДатаНачисленияАмортизации", ПараметрыАмортизации.НаДату);
		СтрокиГрафика = ГрафикАмортизации.НайтиСтроки(ОтборПоДатеНачисленияАмортизации);
		Если СтрокиГрафика.Количество() > 0 Тогда // Нашли.
			Для Каждого СтрокаГрафика Из СтрокиГрафика Цикл
				Если Не ЗначениеЗаполнено(СтрокаГрафика.АмортизацияДоИзменения) И Не  ЗначениеЗаполнено(СтрокаГрафика.АренднаяПлатаДоИзменения) Тогда
					СтрокаКорректировкиГрафика = СтрокаГрафика;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если СтрокаКорректировкиГрафика = Неопределено Тогда // Не нашли, создаем.
			СтрокаКорректировкиГрафика = ГрафикАмортизации.Добавить();
			СтрокаКорректировкиГрафика.ДатаНачисленияАмортизации = ПараметрыАмортизации.НаДату;
		КонецЕсли;
		
		СтрокаКорректировкиГрафика.Амортизация   = СтрокаКорректировкиГрафика.Амортизация   + АмортизацияИзменение;
		СтрокаКорректировкиГрафика.АренднаяПлата = СтрокаКорректировкиГрафика.АренднаяПлата + АренднаяПлатаИзменение;
		
		СтрокаКорректировкиГрафика.АмортизацияПослеИзменения   = СтрокаКорректировкиГрафика.АмортизацияДоИзменения   + СтрокаКорректировкиГрафика.Амортизация;
		СтрокаКорректировкиГрафика.АренднаяПлатаПослеИзменения = СтрокаКорректировкиГрафика.АренднаяПлатаДоИзменения + СтрокаКорректировкиГрафика.АренднаяПлата;
		
	ИначеЕсли СтрНайти("С1,С2,С3,С4,С5,С6", ПараметрыАмортизации.ТипИзмененийУсловийПользованияКод) Тогда // Изменение срока на определенный.
		
		Если ГрафикАмортизации.Количество() > 0 И ЗначениеЗаполнено(ПараметрыАмортизации.ДатаОкончанияАмортизации) Тогда
			
			ГрафикАмортизации.Сортировать("ДатаНачисленияАмортизации");
			ПоследняяСтрокаГрафика = ГрафикАмортизации[ГрафикАмортизации.Количество() - 1];
			Если НачалоДня(ПоследняяСтрокаГрафика.ДатаНачисленияАмортизации) <= НачалоДня(ПараметрыАмортизации.ДатаОкончанияАмортизации) Тогда
				
				// Срок пользования увеличен, растягиваем график амортизации на будущие периоды.
				// Цикл по месяцам с последней даты начиления амортизации по новую дату окончания начисления амортизации.
				ОчереднойМесяц = КонецМесяца(ПоследняяСтрокаГрафика.ДатаНачисленияАмортизации);
				Пока ОчереднойМесяц < КонецМесяца(ПараметрыАмортизации.ДатаОкончанияАмортизации) Цикл
					
					НоваяСтрока = ГрафикАмортизации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоследняяСтрокаГрафика, "АмортизацияПослеИзменения,АренднаяПлатаПослеИзменения");
					НоваяСтрока.ДатаНачисленияАмортизации = ДобавитьМесяц(ПоследняяСтрокаГрафика.ДатаНачисленияАмортизации, 1);
					НоваяСтрока.ОплатитьДо = ДобавитьМесяц(ПоследняяСтрокаГрафика.ОплатитьДо, 1);
					
					НоваяСтрока.Амортизация = НоваяСтрока.АмортизацияПослеИзменения;
					НоваяСтрока.АренднаяПлата = НоваяСтрока.АренднаяПлатаПослеИзменения;
					НоваяСтрока.АмортизацияДоИзменения = 0;
					НоваяСтрока.АренднаяПлатаДоИзменения = 0;
					
					// Следующее значение переменной цикла.
					ОчереднойМесяц = КонецМесяца(ДобавитьМесяц(ОчереднойМесяц, 1));
					ПоследняяСтрокаГрафика = НоваяСтрока;
					
				КонецЦикла;
				
			Иначе
				
				// Срок пользования сокращен, обнуляем амортизацию (арендную плату) за будущие периоды.
				СтрокиКУдалению = Новый Массив;
				Для Каждого СтрокаГрафика Из ГрафикАмортизации Цикл
					Если СтрокаГрафика.ДатаНачисленияАмортизации > НачалоДня(ПараметрыАмортизации.ДатаОкончанияАмортизации) Тогда
						Если СтрокаГрафика.АмортизацияДоИзменения = 0 И СтрокаГрафика.АмортизацияДоИзменения = 0 Тогда
							СтрокиКУдалению.Добавить(СтрокаГрафика);
						Иначе
							СтрокаГрафика.АмортизацияПослеИзменения = 0;
							СтрокаГрафика.АренднаяПлатаПослеИзменения = 0;
							СтрокаГрафика.Амортизация = СтрокаГрафика.АмортизацияПослеИзменения - СтрокаГрафика.АмортизацияДоИзменения;
							СтрокаГрафика.АренднаяПлата = СтрокаГрафика.АренднаяПлатаПослеИзменения - СтрокаГрафика.АренднаяПлатаДоИзменения;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
					ГрафикАмортизации.Удалить(СтрокаКУдалению);
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ГрафикАмортизации.Сортировать("ДатаНачисленияАмортизации,ОплатитьДо");
	
КонецПроцедуры

#КонецОбласти

