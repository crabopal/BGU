#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ВидМежотчетногоПериода), КонецГода(Дата) + 1, Дата);
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, ДатаУчетнойПолитики);
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	НепроверяемыеРеквизиты.Добавить("ПраваПользования.СчетРасчетов");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.ДатаНачалаАмортизации");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.ДатаОкончанияАмортизации");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СтатьяПрочихРасходовНУ");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СчетДоходов");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СубконтоДоходов1");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СубконтоДоходов2");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СубконтоДоходов3");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.ВидДеятельностиНУ");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СчетДоходовНУ");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СтатьяПрочихДоходовНУ");
	НепроверяемыеРеквизиты.Добавить("ПараметрыАмортизации.СчетРасчетов");
	
	Если ИзменитьСтоимостьПравПользования Тогда
		
		Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
			
			Если СтрокаТаблицы.ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетРасчетов) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет расчетов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"));
					ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетРасчетов";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			Иначе // ПоступлениеВБезвозмездноеПользование
				
				Если СтрокаТаблицы.СписатьБалансоваяСтоимость - СтрокаТаблицы.СписатьАмортизация - СтрокаТаблицы.СписатьОтложенныеДоходы <> 0 Тогда
					
					Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
							НСтр("ru = 'Списать (сторнировать)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"),
							НСтр("ru = 'В течение срока действия договора безвозмездного пользования амортизация (104.40) и отложенные доходы (401.40) признаются в составе финансового результата текущего периода на одинаковые суммы (п.27.1 Стандарта ""Аренда"").
							|К моменту прекращения договора безвозмездного пользования сумма начисленной амортизации (104.40) должна быть равна разнице балансовой стоимости (111.40) и остатка отложенных доходов (401.40).'"));
						ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СписатьАмортизация";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект");
					ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
							НСтр("ru = 'Списать (сторнировать)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"),
							НСтр("ru = 'В течение срока действия договора безвозмездного пользования амортизация (104.40) и отложенные доходы (401.40) признаются в составе финансового результата текущего периода на одинаковые суммы (п.27.1 Стандарта ""Аренда"").
							|К моменту завершения срока договора безвозмездного пользования сумма начисленной амортизации (104.40) должна быть равна разнице балансовой стоимости (111.40) и остатка отложенных доходов (401.40).'"));
						ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СписатьАмортизация";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект");
					ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
							НСтр("ru = 'Списать (сторнировать)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"),
							НСтр("ru = 'При корректировке сумм по договору безвозмездного пользования изменение балансовой стоимости (111.40) должно быть равно сумме изменений накопленной амортизации (104.40) и отложенных доходов (401.40).'"));
						ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ИзменениеБалансоваяСтоимость";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект");
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ИзменитьПорядокНачисленияАмортизации Тогда
		
		Для Каждого СтрокаТаблицы Из ПараметрыАмортизации Цикл
			
			// Параметры амортизации.
			Если (СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
			 ИЛИ СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням)
			   И ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
			   И ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата начала начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисление амортизации'"));
					ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаНачалаАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Дата окончания начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисление амортизации'"));
					ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
				Если НЕ Отказ И СтрокаТаблицы.ДатаОкончанияАмортизации < СтрокаТаблицы.ДатаНачалаАмортизации Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
						НСтр("ru = 'Дата окончания начисления амортизации'"),
						СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Начисление амортизации'"),
						НСтр("ru = 'Дата начала начисления амортизации превышает дату окончания.'"));
					ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаОкончанияАмортизации";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				
			КонецЕсли;
			
			ЭтоПрочиеРасходы = БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетРасходов, "401.20");
			Если ПлательщикНалогаНаПрибыль И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО)
				И ЭтоПрочиеРасходы И НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихРасходовНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Статья прочих расходов (НУ)'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Параметры амортизации'"));
				ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихРасходовНУ";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
			Если СтрокаТаблицы.ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетРасчетов) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет расчетов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Параметры амортизации'"));
					ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетРасчетов";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаТаблицы.ОтложенныеДоходы <> 0 Тогда
				
				// Проверим счет и аналитику доходов будущих периодов.
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходов) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет доходов'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Счет доходов'"));
					ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходов";
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
				Иначе
					РеквизитыСчетаДоходов = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
						"СчетДоходов", "СубконтоДоходов1", "СубконтоДоходов2", "СубконтоДоходов3");
					БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитикиВСтрокеТабЧасти(СтрокаТаблицы, РеквизитыСчетаДоходов,
						ЭтотОбъект, "ПараметрыАмортизации", Отказ);
				КонецЕсли;
				
				Если ПлательщикНалогаНаПрибыль И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО) Тогда
					
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВидДеятельностиНУ) Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
							НСтр("ru = 'Вид деятельности (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Параметры амортизации'"));
						ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидДеятельностиНУ";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетДоходовНУ) Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
							НСтр("ru = 'Счет доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Параметры амортизации'"));
						ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СчетДоходовНУ";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
						Продолжить;
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СтатьяПрочихДоходовНУ)
						И БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетДоходовНУ, "Н91.01") Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
							НСтр("ru = 'Статья прочих доходов (НУ)'"), СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Параметры амортизации'"));
						ПолеОшибки = "ПараметрыАмортизации[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СтатьяПрочихДоходовНУ";
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект.Ссылка, ПолеОшибки, "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
	Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
		
		// Контроль ведения расчетов в иностранной валюте.
		Если ЗначениеЗаполнено(СтрокаТаблицы.Валюта)
			И СтрокаТаблицы.Валюта <> ВалютаРегламентированногоУчета
			И СтрокаТаблицы.ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Учет в иностранной валюте не поддерживается для вида операции ""%1"".
				|Учет в иностранной валюте поддерживается только для вида операции ""%2"".'"),
					СтрокаТаблицы.ВидОперации, Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАренду);
			ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ВидОперации";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
		
		// Контроль соответствия графика амортизации и итоговой суммы (колонка "Изменить (+/-)") в строке документа.
		Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
		 ИЛИ ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования Тогда
			
			ОтборПоОбъекту = Новый Структура("ОсновноеСредство", СтрокаТаблицы.ОсновноеСредство);
			ГрафикАмортизацииПоОбъекту = ГрафикАмортизации.Выгрузить(ОтборПоОбъекту, "ОсновноеСредство,ДатаНачисленияАмортизации,Амортизация,АренднаяПлата");
			
			Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(СтрокаТаблицы.Валюта) И СтрокаТаблицы.Валюта <> ВалютаРегламентированногоУчета Тогда
				КурсПересчета = ?(СтрокаТаблицы.ОстатокРезервовВВалюте = 0, 1, СтрокаТаблицы.ОстатокРезервов / СтрокаТаблицы.ОстатокРезервовВВалюте);
			Иначе
				КурсПересчета = 1;
			КонецЕсли;
			
			ИтогАмортизация = Окр(ГрафикАмортизацииПоОбъекту.Итог("Амортизация") * КурсПересчета, 2);
			ИтогАренднаяПлата = Окр(ГрафикАмортизацииПоОбъекту.Итог("АренднаяПлата") * КурсПересчета, 2);
			
			Если (-1) * СтрокаТаблицы.СписатьБалансоваяСтоимость <> ИтогАмортизация Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Итоговое изменение балансовой стоимости объекта (%1) не совпадает с итоговой суммой изменений по графику начисления амортизации (%2).'"),
						Формат((-1) * СтрокаТаблицы.СписатьБалансоваяСтоимость, "ЧЦ=15; ЧДЦ=2"),
						Формат(ИтогАмортизация, "ЧЦ=15; ЧДЦ=2") );
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Изменить (+/-) - Балансовая стоимость'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"),
					ТекстОшибки);
				ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ИзменениеБалансоваяСтоимость";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
			Если (-1) * СтрокаТаблицы.СписатьОтложенныеДоходы <> ИтогАмортизация - ИтогАренднаяПлата Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Итоговое изменение отложенных доходов (%1) не совпадает с итоговой суммой изменений по графику начисления амортизации (%2).'"),
						Формат((-1) * СтрокаТаблицы.СписатьОтложенныеДоходы, "ЧЦ=15; ЧДЦ=2"),
						Формат(ИтогАмортизация - ИтогАренднаяПлата, "ЧЦ=15; ЧДЦ=2") );
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Изменить (+/-) - Отложенные доходы'"),
					СтрокаТаблицы.НомерСтроки, НСтр("ru = 'Права пользования'"),
					ТекстОшибки);
				ПолеОшибки = "ПраваПользования[" + Формат(СтрокаТаблицы.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ИзменениеДБП";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Для Каждого СтрокаТаблицы Из ПраваПользования Цикл
		
		Если СтрокаТаблицы.СуммаРасчетов = 0 Или Не ЗначениеЗаполнено(СтрокаТаблицы.Валюта) Тогда
			// Для совместимости с документами, введенными до 2.0.97.
			// При перепроведении документа заполняется реквизит СуммаРасчетов, который используется при формировании бух.записей.
			СтрокаТаблицы.Валюта = ВалютаРегламентированногоУчета;
			СтрокаТаблицы.СуммаРасчетов = (-1) * ( (СтрокаТаблицы.СписатьБалансоваяСтоимость - СтрокаТаблицы.СписатьАмортизация) - СтрокаТаблицы.СписатьОтложенныеДоходы );
			СтрокаТаблицы.СуммаРасчетовВВалюте = СтрокаТаблицы.СуммаРасчетов;
		КонецЕсли;
		
	КонецЦикла;
	
	// В качестве суммы документа используем справедливую стоимость, по аналогии с другими документами по правам пользования.
	Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования
	 ИЛИ ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
	 ИЛИ ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования Тогда
		СуммаДокумента = (-1) * ПраваПользования.Итог("СписатьБалансоваяСтоимость"); // Увеличение с плюсом, уменьшение с минусом.
	Иначе // ДосрочноеПрекрашение, ЗавершениеСрокаПользования.
		СуммаДокумента = ПраваПользования.Итог("СписатьБалансоваяСтоимость");
	КонецЕсли;
	
	Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования Тогда
		
		// Очистим неиспользуемые табличные части.
		Если НЕ ИзменитьСтоимостьПравПользования Тогда
			ПраваПользования.Очистить();
		КонецЕсли;
		Если НЕ ИзменитьПорядокНачисленияАмортизации Тогда
			ПараметрыАмортизации.Очистить();
		КонецЕсли;
		
	Иначе // Флаги не отображаются.
		ИзменитьСтоимостьПравПользования = Истина;
		ИзменитьПорядокНачисленияАмортизации = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ПараметрыАмортизации Цикл
		Если СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоГрафику Тогда
			СтрокаТаблицы.ДатаНачалаАмортизации = Неопределено;
			СтрокаТаблицы.ДатаОкончанияАмортизации = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Если ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования
		И ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования Тогда
		// Автоматическое отражение по регистрам контроля исполнения договоров доступно
		// только в документах с видами операций "Изменение стоимости аренды (пользования)", "Изменение срока аренды (пользования)",
		// которые формируют движения по специальным регистрам Карточки прав пользования
		// (СведенияОбОбъектахПравПользованияОС, ГрафикАмортизацииПравПользованияОС).
		АвтоматическиОтразитьВГрафикахИсполненияДоговоров = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент(ЗаполнитьСтоимостьПравПользования = Истина, ЗаполнитьПорядокНачисленияАмортизации = Истина) Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация"	, Организация);
	
	Запрос.УстановитьПараметр("СчетаУчетаПравПользования",
		БухгалтерскийУчет.СписокСчетов("111.40", Дата));
	Запрос.УстановитьПараметр("СчетаАмортизацииПравПользования" ,
		БухгалтерскийУчет.СписокСчетов("104.40", Дата));
	Запрос.УстановитьПараметр("Счета40140",
		БухгалтерскийУчет.СписокСчетов("401.40"));
	Запрос.УстановитьПараметр("Счета40160",
		БухгалтерскийУчет.СписокСчетов("401.60"));
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("ВидыСубконтоПраваПользования", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоАмортизация", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоДБП", ВидыСубконто);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Резервы);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоРезервы", ВидыСубконто);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПраваПользованияБУ", НомераТаблиц.Количество());
	НомераТаблиц.Вставить("АмортизацияПравПользованияБУ", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПраваПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ПраваПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ПраваПользованияОстатки.КФО КАК КФО,
	|	ПраваПользованияОстатки.КПС КАК КПС,
	|	ПраваПользованияОстатки.Счет КАК СчетУчета,
	|	ПраваПользованияОстатки.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
	|	ПраваПользованияОстатки.СуммаОстатокДт КАК Сумма
	|ПОМЕСТИТЬ ПраваПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаУчетаПравПользования),
	|			&ВидыСубконтоПраваПользования,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент
	|				И &УсловиеДоговор) КАК ПраваПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияПравПользованияОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(АмортизацияПравПользованияОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	АмортизацияПравПользованияОстатки.КФО КАК КФО,
	|	АмортизацияПравПользованияОстатки.КПС КАК КПС,
	|	АмортизацияПравПользованияОстатки.Счет КАК СчетАмортизации,
	|	АмортизацияПравПользованияОстатки.Подразделение КАК Подразделение,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(АмортизацияПравПользованияОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	АмортизацияПравПользованияОстатки.СуммаОстатокКт КАК СуммаАмортизации
	|ПОМЕСТИТЬ АмортизацияПравПользованияБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетаАмортизацииПравПользования),
	|			&ВидыСубконтоАмортизация,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК АмортизацияПравПользованияОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор,
	|	Организация,
	|	ОсновноеСредство,
	|	ИФО,
	|	КФО,
	|	КПС";
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииПоДоговоруВЦелом", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ПараметрыАмортизацииПравПользования.Организация КАК Организация,
	|	ПараметрыАмортизацииПравПользования.Договор КАК Договор,
	|	ПараметрыАмортизацииПравПользования.ВидОперации КАК ВидОперации,
	|	ПараметрыАмортизацииПравПользования.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	ПараметрыАмортизацииПравПользования.ДатаНачалаАмортизации КАК ДатаНачалаАмортизации,
	|	ПараметрыАмортизацииПравПользования.ДатаОкончанияАмортизации КАК ДатаОкончанияАмортизации,
	|	ПараметрыАмортизацииПравПользования.СчетРасчетов КАК СчетРасчетов,
	|	ПараметрыАмортизацииПравПользования.КПСРасчетов КАК КПСРасчетов,
	|	ПараметрыАмортизацииПравПользования.СчетРасходов КАК СчетРасходов,
	|	ПараметрыАмортизацииПравПользования.КПСРасходов КАК КПСРасходов,
	|	ПараметрыАмортизацииПравПользования.КЭКРасходов КАК КЭКРасходов,
	|	ПараметрыАмортизацииПравПользования.ПодразделениеРасходов КАК ПодразделениеРасходов,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов1 КАК СубконтоРасходов1,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов2 КАК СубконтоРасходов2,
	|	ПараметрыАмортизацииПравПользования.СубконтоРасходов3 КАК СубконтоРасходов3,
	|	ПараметрыАмортизацииПравПользования.СтатьяПрочихРасходовНУ КАК СтатьяПрочихРасходовНУ,
	|	ПараметрыАмортизацииПравПользования.ПринятьНДСКВычету КАК ПринятьНДСКВычету
	|ПОМЕСТИТЬ ПараметрыАмортизацииПоДоговоруВЦелом
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииПравПользованияОС.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.Договор КАК Договор
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И ОсновноеСредство = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)) КАК ПараметрыАмортизацииПравПользования
	|
	|ИНДЕКСИРОВАТЬ ПО
