	|	ЕПСБУОстатки.КЭК КАК КЭКДоходов,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокДБП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета40140),
	|			&ВидыСубконтоДБП,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК ЕПСБУОстатки";
	
	// 401.60 Резерв предстоящих расходов по арендной плате (льготная и обычная аренда).
	НомераТаблиц.Вставить("РезервыПредстоящихРасходовПоАренднойПлате", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Счет КАК СчетРезервов,
	|	ЕПСБУОстатки.КПС КАК КПСРезервов,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Резервы) КАК Резерв,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ЕПСБУОстатки.СуммаОстатокКт КАК ОстатокРезервов,
	|	ЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ОстатокРезервовВВалюте,
	|	ЕПСБУОстатки.Валюта КАК Валюта
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&Счета40160),
	|			&ВидыСубконтоРезервы,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И Субконто2 В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПраваПользованияБУ.Договор
	|					ИЗ
	|						ПраваПользованияБУ)) КАК ЕПСБУОстатки";
	
	// График начисления амортизации.
	НомераТаблиц.Вставить("ГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ГрафикАмортизацииПравПользования.Договор КАК Договор,
	|	ГрафикАмортизацииПравПользования.ОсновноеСредство КАК ОсновноеСредство,
	|	ГрафикАмортизацииПравПользования.ДатаНачисленияАмортизации КАК ДатаНачисленияАмортизации,
	|	ГрафикАмортизацииПравПользования.ОплатитьДо КАК ОплатитьДо,
	|	ГрафикАмортизацииПравПользования.АмортизацияОборот КАК Амортизация,
	|	ГрафикАмортизацииПравПользования.АренднаяПлатаОборот КАК АренднаяПлата
	|ИЗ
	|	РегистрНакопления.ГрафикАмортизацииПравПользованияОС.Обороты(
	|			,
	|			,
	|			,
	|			Организация = &Организация
	|				И Договор В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.Договор КАК Договор
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ПраваПользованияБУ.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ПраваПользованияБУ КАК ПраваПользованияБУ)) КАК ГрафикАмортизацииПравПользования
	|
	|УПОРЯДОЧИТЬ ПО
	|	Договор,
	|	ОсновноеСредство,
	|	ДатаНачисленияАмортизации,
	|	ОплатитьДо";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Если Отбор.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
			"ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры) В(&Договоры)");
		Запрос.УстановитьПараметр("Договоры", Отбор.ВыгрузитьКолонку("Договор"));
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаПравПользования = Результат[НомераТаблиц.ПраваПользования].Выгрузить();
	ГрафикАмортизацииПравПользования = Результат[НомераТаблиц.ГрафикАмортизацииПравПользованияОС].Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	ВедетсяУчетПравПользованияПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	
	// Распределим остатки ДБП (401.40) по аналитике прав пользования.
	ДоходыОтПредоставленияПравПользования = Результат[НомераТаблиц.ДоходыОтПредоставленияПравПользования].Выгрузить();
	ТаблицаПравПользования.Колонки.Добавить("СчетДБП",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаПравПользования.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПравПользования.Колонки.Добавить("КПСДоходов",   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаПравПользования.Колонки.Добавить("КЭКДоходов",   Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаПравПользования.Колонки.Добавить("ОстатокДБП",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	Для Каждого ОстатокДБП Из ДоходыОтПредоставленияПравПользования Цикл
		
		СвойстваСчетаДБП = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокДБП.СчетДБП);
		
		ОтборПравПользования = ?(ВедетсяУчетПравПользованияПоПодразделениям И СвойстваСчетаДБП.УчетПоПодразделениям,
			Новый Структура("ИФО,КФО,Подразделение,Договор"),
			Новый Структура("ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокДБП);
		НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокДБП.ОстатокДБП,
			НайденныеСтрокиПравПользования, "ОстатокДБП", "ОстаточнаяСтоимость", Ложь);
		
		Для Каждого СтрокаПравоПользования Из НайденныеСтрокиПравПользования Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПравоПользования, ОстатокДБП,
				"СчетДБП,Номенклатура,КПСДоходов,КЭКДоходов");
		КонецЦикла;
		
	КонецЦикла;
	
	// Распределим остатки резервов (401.60) по аналитике прав пользования.
	РезервыПредстоящихРасходовПоАренднойПлате = Результат[НомераТаблиц.РезервыПредстоящихРасходовПоАренднойПлате].Выгрузить();
	ТаблицаПравПользования.Колонки.Добавить("ОстатокРезервов",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("ОстатокРезервовВВалюте",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Для Каждого ОстатокРезервов Из РезервыПредстоящихРасходовПоАренднойПлате Цикл
		
		СвойстваСчетаРезервов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ОстатокРезервов.СчетРезервов);
		
		ОтборПравПользования = ?(ВедетсяУчетПравПользованияПоПодразделениям И СвойстваСчетаРезервов.УчетПоПодразделениям,
			Новый Структура("СчетРезервов,КПСРезервов,Резерв,ИФО,КФО,Договор,Подразделение"),
			Новый Структура("СчетРезервов,КПСРезервов,Резерв,ИФО,КФО,Договор"));
		ЗаполнитьЗначенияСвойств(ОтборПравПользования, ОстатокРезервов);
		НайденныеСтрокиПравПользования = ТаблицаПравПользования.НайтиСтроки(ОтборПравПользования);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокРезервов.ОстатокРезервов,
			НайденныеСтрокиПравПользования, "ОстатокРезервов", "ОстаточнаяСтоимость", Ложь);
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ОстатокРезервов.ОстатокРезервовВВалюте,
			НайденныеСтрокиПравПользования, "ОстатокРезервовВВалюте", "ОстаточнаяСтоимость", Ложь);
		
		Для Каждого СтрокаПравоПользования Из НайденныеСтрокиПравПользования Цикл
			ЗаполнитьЗначенияСвойств(СтрокаПравоПользования, ОстатокРезервов, "Валюта");
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаПравПользования.Колонки.Добавить("СписатьБалансоваяСтоимость",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("СписатьАмортизация",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	ТаблицаПравПользования.Колонки.Добавить("СписатьОтложенныеДоходы",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой)));
	
	Если ЗаполнитьСтоимостьПравПользования Тогда
	
		ПраваПользования.Очистить();
		ГрафикАмортизации.Очистить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаПравПользования Цикл
			
			СтрокаТаблицы.ДатаНачалаАмортизации = ?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаАмортизации), СтрокаТаблицы.ДатаНачалаАмортизации, СтрокаТаблицы.ДатаНачалаСрокаПользования);
			СтрокаТаблицы.ДатаОкончанияАмортизации = ?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации), СтрокаТаблицы.ДатаОкончанияАмортизации, СтрокаТаблицы.ДатаОкончанияСрокаПользования);
			
			Если (СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам
			 ИЛИ СтрокаТаблицы.СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням)
			   И ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
			   И ВидОперации <> Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования Тогда
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияАмортизации) Тогда
					Продолжить; // Нет параметров учета в регистре. Возможно, объект принят к учету ручной операцией.
				КонецЕсли;
				Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования
					И (КонецДня(Дата) < КонецДня(СтрокаТаблицы.ДатаОкончанияАмортизации)) Тогда
					Продолжить;
				ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение
					И (КонецДня(Дата) >= КонецДня(СтрокаТаблицы.ДатаОкончанияАмортизации)) Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			НоваяСтрока = ПраваПользования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ЗавершениеСрокаПользования Тогда
				
				// Если учет велся правильно, к концу срока пользования остатки:
				// 1) балансовая стоимость (111.40) = накопленной амортизации (104.40),
				// 2) отложенные доходы (401.40) = 0.
				// Если есть ошибки в учете, следует либо: 1) исправить ошибки, 2) указать суммы вручную, 3) закрыть ручными операциями.
				НоваяСтрока.СписатьБалансоваяСтоимость = СтрокаТаблицы.ОстатокАмортизация;
				НоваяСтрока.СписатьАмортизация         = СтрокаТаблицы.ОстатокАмортизация;
				НоваяСтрока.СписатьОтложенныеДоходы    = 0;
				
				Если СтрокаТаблицы.ОстатокБалансоваяСтоимость <> СтрокаТаблицы.ОстатокАмортизация Тогда
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Строка %1: При завершении срока аренды (пользования) начисленная амортизация должна совпадать с балансовой стоимостью права пользования.
						|Балансовая стоимость: %2; Начисленная амортизация: %3'"),
						НоваяСтрока.НомерСтроки,
						СтрокаТаблицы.ОстатокБалансоваяСтоимость,
						СтрокаТаблицы.ОстатокАмортизация);
					ПолеОшибки = "ПраваПользования[" + Формат(НоваяСтрока.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОстатокАмортизация";
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПолеОшибки, "Объект");
					
				КонецЕсли;
				
				Если СтрокаТаблицы.ОстатокДБП <> 0 Тогда
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Строка %1: При завершении срока аренды (пользования) остаток отложенных доходов должен быть полностью включен в доходы текушего периода.
						|Остаток отложенных доходов: %2'"),
						НоваяСтрока.НомерСтроки,
						СтрокаТаблицы.ОстатокДБП);
					ПолеОшибки = "ПраваПользования[" + Формат(НоваяСтрока.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОстатокДБП";
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Ссылка, ПолеОшибки, "Объект");
					
				КонецЕсли;
				
			ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ДосрочноеПрекрашение Тогда
				
				// По умолчанию - полное прекращение права пользования, списываем (сторнируем) все остатки.
				НоваяСтрока.СписатьБалансоваяСтоимость = СтрокаТаблицы.ОстатокБалансоваяСтоимость;
				НоваяСтрока.СписатьАмортизация         = СтрокаТаблицы.ОстатокАмортизация;
				НоваяСтрока.СписатьОтложенныеДоходы    = СтрокаТаблицы.ОстатокДБП;
				
			КонецЕсли;
			
			Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(НоваяСтрока.Валюта) И НоваяСтрока.Валюта <> ВалютаРегламентированногоУчета Тогда
				КурсПересчета = ?(СтрокаТаблицы.ОстатокРезервовВВалюте = 0, 1, СтрокаТаблицы.ОстатокРезервов / СтрокаТаблицы.ОстатокРезервовВВалюте);
			Иначе
				КурсПересчета = 1;
			КонецЕсли;
			
			// Суммы расчетов (резервов) - суммы расчетов (кредиторская задолженность), суммы корректировки резервов по арендной плате.
			НоваяСтрока.СуммаРасчетов = (-1) * ( (НоваяСтрока.СписатьБалансоваяСтоимость - НоваяСтрока.СписатьАмортизация) - НоваяСтрока.СписатьОтложенныеДоходы );
			Если НоваяСтрока.СуммаРасчетов < 0 Тогда // Сокращение срока договора, досрочное прекращение.
				НоваяСтрока.СуммаРасчетовВВалюте = Макс(НоваяСтрока.СуммаРасчетов / КурсПересчета, (-1) * СтрокаТаблицы.ОстатокРезервовВВалюте);
			ИначеЕсли НоваяСтрока.СуммаРасчетов > 0 Тогда // Увеличение срока договора.
				НоваяСтрока.СуммаРасчетовВВалюте = Мин(НоваяСтрока.СуммаРасчетов / КурсПересчета, СтрокаТаблицы.ОстатокРезервовВВалюте);
			КонецЕсли;
			
			// Счет и аналитика расчетов, резервов по арендной плате.
			Если НоваяСтрока.ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "СчетРасчетов,КПСРасчетов");
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда // Если не заполнен, определяем по счету учета.
					НоваяСтрока.СчетРасчетов = УчетРасчетов.СчетРасчетовПоАренднойПлате(СтрокаТаблицы.СчетУчета, Дата, Организация);
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(НоваяСтрока.КПСРасчетов) Тогда // Если не заполнен, совпадает с КПС учета.
					НоваяСтрока.КПСРасчетов = СтрокаТаблицы.КПС;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "СчетРезервов,КПСРезервов,Резерв");
				
			КонецЕсли;
			
			Если ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
			 ИЛИ ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования Тогда
				
				// Сведения об объектах.
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "УсловиеПользования,АренднаяПлатаСумма,АренднаяПлатаЗаПериод");
				НоваяСтрока.УсловиеПользованияДоИзменения = НоваяСтрока.УсловиеПользования;
				НоваяСтрока.АренднаяПлатаСуммаДоИзменения = НоваяСтрока.АренднаяПлатаСумма;
				НоваяСтрока.АренднаяПлатаЗаПериодДоИзменения = НоваяСтрока.АренднаяПлатаЗаПериод;
				
				Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачалаСрокаПользования) Тогда // Из регистра СведенияОбОбъектахПравПользованияОС.
					НоваяСтрока.ДатаНачалаАмортизации            = СтрокаТаблицы.ДатаНачалаСрокаПользования;
					НоваяСтрока.ДатаНачалаАмортизацииДоИзменения = СтрокаТаблицы.ДатаНачалаСрокаПользования;
				Иначе
					НоваяСтрока.ДатаНачалаАмортизации            = СтрокаТаблицы.ДатаНачалаАмортизации;
					НоваяСтрока.ДатаНачалаАмортизацииДоИзменения = СтрокаТаблицы.ДатаНачалаАмортизации;
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончанияСрокаПользования) Тогда // Из регистра СведенияОбОбъектахПравПользованияОС.
					НоваяСтрока.ДатаОкончанияАмортизации            = СтрокаТаблицы.ДатаОкончанияСрокаПользования;
					НоваяСтрока.ДатаОкончанияАмортизацииДоИзменения = СтрокаТаблицы.ДатаОкончанияСрокаПользования;
				Иначе
					НоваяСтрока.ДатаОкончанияАмортизации            = СтрокаТаблицы.ДатаОкончанияАмортизации;
					НоваяСтрока.ДатаОкончанияАмортизацииДоИзменения = СтрокаТаблицы.ДатаОкончанияАмортизации;
				КонецЕсли;
				
				// График амортизации прав пользования.
				ОтборПоОбъекту = Новый Структура("Договор, ОсновноеСредство", СтрокаТаблицы.Договор, СтрокаТаблицы.ОсновноеСредство);
				НайденныеСтроки = ГрафикАмортизацииПравПользования.НайтиСтроки(ОтборПоОбъекту);
				Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
					НоваяСтрока = ГрафикАмортизации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаГрафика, "Договор, ОсновноеСредство, ДатаНачисленияАмортизации, ОплатитьДо");
					НоваяСтрока.АмортизацияДоИзменения = СтрокаГрафика.Амортизация;
					НоваяСтрока.Амортизация = 0;
					НоваяСтрока.АмортизацияПослеИзменения = НоваяСтрока.АмортизацияДоИзменения;
					НоваяСтрока.АренднаяПлатаДоИзменения = СтрокаГрафика.АренднаяПлата;
					НоваяСтрока.АренднаяПлата = 0;
					НоваяСтрока.АренднаяПлатаПослеИзменения = НоваяСтрока.АренднаяПлатаДоИзменения;
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗаполнитьПорядокНачисленияАмортизации Тогда
		
		ПараметрыАмортизации.Очистить();
		
		ТаблицаПравПользования.Свернуть(
			"ВидОперации,ОсновноеСредство,Контрагент,Договор,КФО,КПС,
			|СчетРасчетов,КПСРасчетов,ПринятьНДСКВычету,СчетРезервов,КПСРезервов,Резерв,
			|СпособПризнанияРасходов,ДатаНачалаАмортизации,ДатаОкончанияАмортизации,
			|СчетРасходов,КПСРасходов,КЭКРасходов,ПодразделениеРасходов,
			|СубконтоРасходов1,СубконтоРасходов2,СубконтоРасходов3,СтатьяПрочихРасходовНУ,
			|СчетДоходов,СубконтоДоходов1,СубконтоДоходов2,СубконтоДоходов3,
			|ВидДеятельностиНУ,СчетДоходовНУ,СтатьяПрочихДоходовНУ",
				"ОстатокБалансоваяСтоимость,ОстатокАмортизация,ОстатокДБП,
				|СписатьБалансоваяСтоимость,СписатьАмортизация,СписатьОтложенныеДоходы");
		
		Для Каждого СтрокаТаблицы Из ТаблицаПравПользования Цикл
			
			НоваяСтрока = ПараметрыАмортизации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			// Счет и аналитика расчетов по арендной плате.
			Если НоваяСтрока.ВидОперации <> Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.КПСРасчетов) Тогда // Если не заполнен, совпадает с КПС учета.
					НоваяСтрока.КПСРасчетов = СтрокаТаблицы.КПС;
				КонецЕсли;
			Иначе
				НоваяСтрока.СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
				НоваяСтрока.КПСРасчетов  = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.КПСРасходов) Тогда // Если не заполнен, совпадает с КПС учета.
				НоваяСтрока.КПСРасходов = СтрокаТаблицы.КПС;
			КонецЕсли;
			
			НоваяСтрока.ОстаточнаяСтоимость =
				(СтрокаТаблицы.ОстатокБалансоваяСтоимость - СтрокаТаблицы.ОстатокАмортизация) +
				(СтрокаТаблицы.СписатьБалансоваяСтоимость - СтрокаТаблицы.СписатьАмортизация);
			
			НоваяСтрока.ОтложенныеДоходы =
				(СтрокаТаблицы.ОстатокДБП - СтрокаТаблицы.СписатьОтложенныеДоходы);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
