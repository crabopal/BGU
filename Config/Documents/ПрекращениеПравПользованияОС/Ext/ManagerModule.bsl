#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата,ВидМежотчетногоПериода,ВидОперации,ИзменитьСтоимостьПравПользования,ИзменитьПорядокНачисленияАмортизации,
		|АвтоматическиОтразитьВГрафикахИсполненияДоговоров");
	
	ДатаУчетнойПолитики = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ВидМежотчетногоПериода),
		КонецГода(ЗначенияРеквизитов.Дата) + 1, ЗначенияРеквизитов.Дата);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете",
		НалоговыйУчет.ПлательщикНалогаНаПрибыль(ЗначенияРеквизитов.Организация, ДатаУчетнойПолитики));
	Запрос.УстановитьПараметр("СчетаПрочихРасходов",  БухгалтерскийУчет.СписокСчетов("401.20"));
	Запрос.УстановитьПараметр("СчетаПрочихДоходовНУ", БухгалтерскийУчет.СписокСчетов("Н91.01"));
	
	ВидыОперацийЛьготнаяАренда = Новый Массив;
	ВидыОперацийЛьготнаяАренда.Добавить(Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВАрендуНаЛьготныхУсловиях);
	ВидыОперацийЛьготнаяАренда.Добавить(Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	Запрос.УстановитьПараметр("ВидыОперацийЛьготнаяАренда", ВидыОперацийЛьготнаяАренда);
	
	Запрос.УстановитьПараметр("ЭтоПоступлениеВБезвозмездноеПользование",
		ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ПараметрыАмортизацииПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыАмортизацииПравПользованияОС.Ссылка.Дата КАК Период,
	|	ПараметрыАмортизацииПравПользованияОС.Ссылка.Организация КАК Организация,
	|	ПараметрыАмортизацииПравПользованияОС.Договор КАК Договор,
	|	ПараметрыАмортизацииПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииПравПользованияОС.ВидОперации КАК ВидОперации,
	|	ПараметрыАмортизацииПравПользованияОС.СпособПризнанияРасходов КАК СпособПризнанияРасходов,
	|	ПараметрыАмортизацииПравПользованияОС.ДатаНачалаАмортизации КАК ДатаНачалаАмортизации,
	|	ПараметрыАмортизацииПравПользованияОС.ДатаОкончанияАмортизации КАК ДатаОкончанияАмортизации,
	|	ПараметрыАмортизацииПравПользованияОС.СчетРасходов КАК СчетРасходов,
	|	ПараметрыАмортизацииПравПользованияОС.КПСРасходов КАК КПСРасходов,
	|	ПараметрыАмортизацииПравПользованияОС.КЭКРасходов КАК КЭКРасходов,
	|	ПараметрыАмортизацииПравПользованияОС.ПодразделениеРасходов КАК ПодразделениеРасходов,
	|	ПараметрыАмортизацииПравПользованияОС.СубконтоРасходов1 КАК СубконтоРасходов1,
	|	ПараметрыАмортизацииПравПользованияОС.СубконтоРасходов2 КАК СубконтоРасходов2,
	|	ПараметрыАмортизацииПравПользованияОС.СубконтоРасходов3 КАК СубконтоРасходов3,
	|	ПараметрыАмортизацииПравПользованияОС.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И ПараметрыАмортизацииПравПользованияОС.СчетРасходов В (&СчетаПрочихРасходов)
	|			ТОГДА ПараметрыАмортизацииПравПользованияОС.СтатьяПрочихРасходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихРасходовНУ,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		ИНАЧЕ ПараметрыАмортизацииПравПользованияОС.СчетРасчетов
	|	КОНЕЦ КАК СчетРасчетов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		ИНАЧЕ ПараметрыАмортизацииПравПользованияОС.КПСРасчетов
	|	КОНЕЦ КАК КПСРасчетов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		ИНАЧЕ ПараметрыАмортизацииПравПользованияОС.СчетРезервов
	|	КОНЕЦ КАК СчетРезервов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		ИНАЧЕ ПараметрыАмортизацииПравПользованияОС.КПСРезервов
	|	КОНЕЦ КАК КПСРезервов,
	|	ВЫБОР
	|		КОГДА &ЭтоПоступлениеВБезвозмездноеПользование
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Резервы.ПустаяСсылка)
	|		ИНАЧЕ ПараметрыАмортизацииПравПользованияОС.Резерв
	|	КОНЕЦ КАК Резерв
	|ИЗ
	|	Документ.ПрекращениеПравПользованияОС.ПараметрыАмортизации КАК ПараметрыАмортизацииПравПользованияОС
	|ГДЕ
	|	ПараметрыАмортизацииПравПользованияОС.Ссылка = &Ссылка
	|	И ПараметрыАмортизацииПравПользованияОС.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования)
	|	И ПараметрыАмортизацииПравПользованияОС.Ссылка.ИзменитьПорядокНачисленияАмортизации";
	
	НомераТаблиц.Вставить("ПараметрыСписанияДоходовБудущихПериодов", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПорядокПризнанияДоходов.Ссылка.Дата КАК Период,
	|	ПорядокПризнанияДоходов.Ссылка.Организация КАК Организация,
	|	ПорядокПризнанияДоходов.Договор КАК Договор,
	|	ПорядокПризнанияДоходов.ВидОперации КАК ВидОперации,
	|	ПорядокПризнанияДоходов.СпособПризнанияРасходов КАК СпособПризнанияДоходов,
	|	ПорядокПризнанияДоходов.ДатаНачалаАмортизации КАК ДатаНачалаСписания,
	|	ПорядокПризнанияДоходов.ДатаОкончанияАмортизации КАК ДатаОкончанияСписания,
	|	ПорядокПризнанияДоходов.СчетДоходов КАК СчетДоходов,
	|	ПорядокПризнанияДоходов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ПорядокПризнанияДоходов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ПорядокПризнанияДоходов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ПорядокПризнанияДоходов.ВидДеятельностиНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ПустаяСсылка)
	|	КОНЕЦ КАК ВидДеятельностиНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|			ТОГДА ПорядокПризнанияДоходов.СчетДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетДоходовНУ,
	|	ВЫБОР
	|		КОГДА &ОтражатьВНалоговомУчете
	|				И ПорядокПризнанияДоходов.СчетДоходовНУ В (&СчетаПрочихДоходовНУ)
	|			ТОГДА ПорядокПризнанияДоходов.СтатьяПрочихДоходовНУ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ПрочиеДоходыИРасходы.ПустаяСсылка)
	|	КОНЕЦ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	Документ.ПрекращениеПравПользованияОС.ПараметрыАмортизации КАК ПорядокПризнанияДоходов
	|ГДЕ
	|	ПорядокПризнанияДоходов.Ссылка = &Ссылка
	|	И ПорядокПризнанияДоходов.Ссылка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПрекращениеПравПользованияОС.КорректировкаПравПользования)
	|	И ПорядокПризнанияДоходов.Ссылка.ИзменитьПорядокНачисленияАмортизации
	|	И ПорядокПризнанияДоходов.ВидОперации В(&ВидыОперацийЛьготнаяАренда)";
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСтоимостиПользования
	 ИЛИ ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС.ИзменениеСрокаПользования Тогда
		
		НомераТаблиц.Вставить("СведенияОбОбъектахПравПользованияОС", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ПраваПользования.Ссылка.Дата КАК Период,
		|	ПраваПользования.Ссылка.Организация КАК Организация,
		|	ПраваПользования.ОсновноеСредство КАК ОсновноеСредство,
		|	ПраваПользования.Договор КАК Договор,
		|	ПраваПользования.Контрагент КАК Контрагент,
		|	ПраваПользования.УсловиеПользования КАК УсловиеПользования,
		|	ПраваПользования.ТипИзмененийУсловийПользования КАК ТипИзмененийУсловийПользования,
		|	ПраваПользования.ТипИзмененийУсловийПользования.Код КАК ТипИзмененийУсловийПользованияКод,
		|	ПраваПользования.ДатаНачалаАмортизации КАК ДатаНачалаСрокаПользования,
		|	ПраваПользования.ДатаОкончанияАмортизации КАК ДатаОкончанияСрокаПользования,
		|	ПраваПользования.АренднаяПлатаСумма КАК АренднаяПлатаСумма,
		|	ПраваПользования.АренднаяПлатаЗаПериод КАК АренднаяПлатаЗаПериод,
		|	ПраваПользования.Ссылка.ВидПервичногоДокумента КАК ДокументОснованиеВид,
		|	ПраваПользования.Ссылка.ДатаПервичногоДокумента КАК ДокументОснованиеДата,
		|	ПраваПользования.Ссылка.НомерПервичногоДокумента КАК ДокументОснованиеНомер,
		|	ПраваПользования.НачалоПериодаПересчета КАК НачалоПериодаПересчета,
		|	ПраваПользования.КонецПериодаПересчета КАК КонецПериодаПересчета
		|ИЗ
		|	Документ.ПрекращениеПравПользованияОС.ПраваПользования КАК ПраваПользования
		|ГДЕ
		|	ПраваПользования.Ссылка = &Ссылка
		|	И ПраваПользования.ТипИзмененийУсловийПользования <> ЗНАЧЕНИЕ(Справочник.ТипыИзмененийУсловийПользованияОбъектамиОС.ПустаяСсылка)";
		
		НомераТаблиц.Вставить("ГрафикАмортизацииПравПользованияОС", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ГрафикАмортизации.Ссылка КАК Ссылка,
		|	ГрафикАмортизации.Ссылка.Дата КАК Период,
		|	ГрафикАмортизации.Ссылка.Организация КАК Организация,
		|	ГрафикАмортизации.Договор КАК Договор,
		|	ГрафикАмортизации.ОсновноеСредство КАК ОсновноеСредство,
		|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК ДатаНачисленияАмортизации,
		|	ГрафикАмортизации.ОплатитьДо КАК ОплатитьДо,
		|	ЛОЖЬ КАК ПоПервоначальнойОценке,
		|	ГрафикАмортизации.Амортизация КАК Амортизация,
		|	ГрафикАмортизации.АренднаяПлата КАК АренднаяПлата
		|ИЗ
		|	Документ.ПрекращениеПравПользованияОС.ПраваПользования КАК ПраваПользования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
		|		ПО ПраваПользования.Ссылка = ГрафикАмортизации.Ссылка
		|			И ПраваПользования.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
		|			И ПраваПользования.Договор = ГрафикАмортизации.Договор
		|ГДЕ
		|	ГрафикАмортизации.Ссылка = &Ссылка
		|	И ПраваПользования.Ссылка = &Ссылка
		|	И ПраваПользования.ТипИзмененийУсловийПользования <> ЗНАЧЕНИЕ(Справочник.ТипыИзмененийУсловийПользованияОбъектамиОС.ПустаяСсылка)
		|	И (ГрафикАмортизации.Амортизация <> 0
		|			ИЛИ ГрафикАмортизации.АренднаяПлата <> 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПраваПользования.НомерСтроки,
		|	ГрафикАмортизации.НомерСтроки";
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров")
			И ЗначенияРеквизитов.АвтоматическиОтразитьВГрафикахИсполненияДоговоров Тогда
			
			НомераТаблиц.Вставить("ИсполнениеОбязательствПоставщиками", НомераТаблиц.Количество());
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
			"ВЫБРАТЬ
			|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК Период,
			|	ПраваПользования.Ссылка.Организация КАК Организация,
			|	ПраваПользования.Контрагент КАК Контрагент,
			|	ПраваПользования.Договор КАК Договор,
			|	ПраваПользования.СчетРасчетов КАК СчетРасчетов,
			|	ПраваПользования.Валюта КАК Валюта,
			|	ПраваПользования.ИФО КАК ИФО,
			|	ПраваПользования.КФО КАК КФО,
			|	ПраваПользования.КПСРасчетов КАК КПС,
			|	ПараметрыАмортизации.КЭКРасходов КАК КЭК,
			|	ПраваПользования.ОсновноеСредство КАК ОсновноеСредство,
			|	ГрафикАмортизации.ДатаНачисленияАмортизации КАК ИсполнитьДо,
			|	ГрафикАмортизации.АренднаяПлата КАК Сумма
			|ИЗ
			|	Документ.ПрекращениеПравПользованияОС.ПраваПользования КАК ПраваПользования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
			|		ПО ПраваПользования.Ссылка = ГрафикАмортизации.Ссылка
			|			И ПраваПользования.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
			|			И ПраваПользования.Договор = ГрафикАмортизации.Договор
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеПравПользованияОС.ПараметрыАмортизации КАК ПараметрыАмортизации
			|		ПО ПраваПользования.Ссылка = ПараметрыАмортизации.Ссылка
			|			И ПраваПользования.ОсновноеСредство = ПараметрыАмортизации.ОсновноеСредство
			|			И ПраваПользования.Договор = ПараметрыАмортизации.Договор
			|ГДЕ
			|	ПраваПользования.Ссылка = &Ссылка
			|	И ПраваПользования.Договор.ВестиПланГрафикИсполнения
			|	И ГрафикАмортизации.АренднаяПлата <> 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПраваПользования.НомерСтроки,
			|	ГрафикАмортизации.ДатаНачисленияАмортизации";
			
			НомераТаблиц.Вставить("ОплатаПоставщикамКредиторам", НомераТаблиц.Количество());
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
			"ВЫБРАТЬ
			|	ГрафикАмортизации.ОплатитьДо КАК Период,
			|	ПраваПользования.Ссылка.Организация КАК Организация,
			|	ПраваПользования.Контрагент КАК Контрагент,
			|	ПраваПользования.Договор КАК Договор,
			|	ПраваПользования.СчетРасчетов КАК СчетРасчетов,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг) КАК ВидРасчетов,
			|	ПраваПользования.Валюта КАК Валюта,
			|	ПраваПользования.ИФО КАК ИФО,
			|	ПраваПользования.КФО КАК КФО,
			|	ПраваПользования.КПСРасчетов КАК КПС,
			|	ПараметрыАмортизации.КЭКРасходов КАК КЭК,
			|	ПраваПользования.ОсновноеСредство КАК ОсновноеСредство,
			|	ГрафикАмортизации.ОплатитьДо КАК ОплатитьДо,
			|	ГрафикАмортизации.АренднаяПлата КАК Сумма
			|ИЗ
			|	Документ.ПрекращениеПравПользованияОС.ПраваПользования КАК ПраваПользования
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеПравПользованияОС.ГрафикАмортизации КАК ГрафикАмортизации
			|		ПО ПраваПользования.Ссылка = ГрафикАмортизации.Ссылка
			|			И ПраваПользования.ОсновноеСредство = ГрафикАмортизации.ОсновноеСредство
			|			И ПраваПользования.Договор = ГрафикАмортизации.Договор
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПрекращениеПравПользованияОС.ПараметрыАмортизации КАК ПараметрыАмортизации
			|		ПО ПраваПользования.Ссылка = ПараметрыАмортизации.Ссылка
			|			И ПраваПользования.ОсновноеСредство = ПараметрыАмортизации.ОсновноеСредство
			|			И ПраваПользования.Договор = ПараметрыАмортизации.Договор
			|ГДЕ
			|	ПраваПользования.Ссылка = &Ссылка
			|	И ПраваПользования.Договор.ВестиГрафикПлатежей
			|	И ГрафикАмортизации.АренднаяПлата <> 0
			|
			|УПОРЯДОЧИТЬ ПО
			|	ПраваПользования.НомерСтроки,
			|	ГрафикАмортизации.ОплатитьДо";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
	Если ТипЗнч(СтруктураДополнительныеСвойства.ДанныеАвтоПроведения) = Тип("Структура")
		И ТипЗнч(СтруктураДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты) = Тип("Структура")
		И СтруктураДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты.Свойство("ИсправлениеОшибки")
		И СтруктураДополнительныеСвойства.ДанныеАвтоПроведения.ДополнительныеРеквизиты.ИсправлениеОшибки <> Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка Тогда
		// Это исправление ошибок прошлых лет.
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ОплатаПоставщикамКредиторам");
		КонтрольИсполненияДоговоров.УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(
			СтруктураДополнительныеСвойства.ТаблицыДляДвижений, "ИсполнениеОбязательствПоставщиками");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати					= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПрекращениеПравПользованияОС";
	КомандаПечати.Идентификатор		= "ПечатьКарточекУчетаПраваПользованияНФА";
	КомандаПечати.Представление		= УправлениеПечатьюБГУ.ПредставлениеКомандыПечати(
		НСтр("ru = 'Карточки учета прав пользования НФА'"), "0509214");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатьКарточекУчетаПраваПользованияНФА") Тогда
		
		ДанныеДляПечати = УправлениеОсновнымиСредствами.ОбъектыДляГрупповойПечатиКарточек(МассивОбъектов, "ОсновноеСредство", "ПраваПользования");
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПечатьКарточекУчетаПраваПользованияНФА", "Карточки учета прав пользования НФА",
			Справочники.ОсновныеСредства.ПечатьКарточкиУчетаПраваПользованияНФА(
				ДанныеДляПечати, ОбъектыПечати, ПараметрыПечати));
			
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НачислениеАмортизацииПравПользованияОС

Функция РеквизитыПодчиненногоДокументаНачислениеАмортизации(ДокументПрекращениеПравПользованияОС, ПометкаУдаления = Ложь) Экспорт
	
	Результат = Новый Структура("Номер, Дата, Ссылка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументПрекращениеПравПользованияОС", ДокументПрекращениеПравПользованияОС);
	Запрос.УстановитьПараметр("ПометкаУдаления",   ПометкаУдаления);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НачислениеАмортизацииПравПользованияОС.ДокументОснование КАК ДокументОснование,
	|	НачислениеАмортизацииПравПользованияОС.Ссылка КАК Ссылка,
	|	НачислениеАмортизацииПравПользованияОС.Номер КАК Номер,
	|	НачислениеАмортизацииПравПользованияОС.Дата КАК Дата
	|ИЗ
	|	Документ.НачислениеАмортизацииПравПользованияОС КАК НачислениеАмортизацииПравПользованияОС
	|ГДЕ
	|	НачислениеАмортизацииПравПользованияОС.ДокументОснование = &ДокументПрекращениеПравПользованияОС
	|	И НачислениеАмортизацииПравПользованияОС.Ссылка.ПометкаУдаления = &ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
