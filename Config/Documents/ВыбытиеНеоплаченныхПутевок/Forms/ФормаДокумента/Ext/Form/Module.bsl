&НаКлиенте
Процедура УстановитьПримечаниеЗавершение(НовоеПримечание, ДополнительныеПараметры) Экспорт
	
	Если НовоеПримечание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТекущаяСтрока Из Элементы.Материалы.ВыделенныеСтроки Цикл
		ТекущиеДанные = Объект.Материалы.НайтиПоИдентификатору(ТекущаяСтрока);
		ТекущиеДанные.ПричинаСписания = НовоеПримечание;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДанныеВХранилище()

	ТаблицаДанных = Объект.Материалы.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаДанных);

КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()
	
	Элементы.ЦМО.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение)
	
	ТаблицаДанных = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДанныхВХранилище);
	
	ИсходныеДанные = Объект.Материалы.Выгрузить();
	ИсходныеДанные.Индексы.Добавить("ВидДенежногоДокумента,ДенежныйДокумент");	
	
	Объект.Материалы.Очистить();
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		СтруктураПоиска = Новый Структура("ВидДенежногоДокумента,ДенежныйДокумент");
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицы);
		НайденныеСтроки = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		
		Если НайденныеСтроки.Количество()>0 Тогда
			НоваяСтрока = Объект.Материалы.Добавить();			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
			НоваяСтрока.ПричинаСписания = НайденныеСтроки[0].ПричинаСписания;
			Продолжить;
		Иначе
			НоваяСтрока = Объект.Материалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицы);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

