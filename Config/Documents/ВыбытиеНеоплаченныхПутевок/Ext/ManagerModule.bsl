Функция ПечатьНакладной0315007(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_НакладнаяМ15";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Накладная0315007");
	
	ОбластьМакетаШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого  = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ВыбытиеНеоплаченныхПутевок) КАК Ссылка,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетУчета,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ДенежныеДокументы)
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.ДенежныеДокументы)
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.ДенежныеДокументы)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка)
		|	КОНЕЦ КАК ДенежныйДокумент,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК Количество,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК КоличествоОстаток,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			Регистратор В (&МассивОбъектов)
		|				И (ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|					ИЛИ ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|					ИЛИ ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)),
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ДенежныеДокументы)
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.ДенежныеДокументы)
		|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДенежныеДокументы)
		|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.ДенежныеДокументы)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДенежныеДокументы.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ВыбытиеНеоплаченныхПутевок)";
	ТаблицаДвижений = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписаниеПутевок.Номер КАК пНомер,
	|	СписаниеПутевок.Ссылка КАК Ссылка,
	|	СписаниеПутевок.Дата КАК пДата,
	|	СписаниеПутевок.Организация,
	|	СписаниеПутевок.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	СписаниеПутевок.Организация.КодОКПО КАК пКодОКПО,
	|	СписаниеПутевок.Подразделение,
	|	СписаниеПутевок.Подразделение.Представление КАК пПодразделениеОтправитель,
	|	СписаниеПутевок.ЦМО.Сотрудник,
	|	СписаниеПутевок.Контрагент.Представление КАК пКонтрагент,
	|	СписаниеПутевок.Договор.Представление КАК пДоговор,
	|	СписаниеПутевок.КФО КАК КФО,
	|	СписаниеПутевок.СчетУчета КАК СчетУчета,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.Представление КАК пНоменклатура,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.Наименование КАК НоменклатураНаименование,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.Наименование КАК НоменклатураНаименованиеПолное,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.Код КАК пКодАналитики,
	|	"""" КАК пНоменклатурныйНомер,
	|	ЕСТЬNULL(СписаниеПутевокМатериалы.Количество, 0) КАК пКоличество,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения.Код КАК пКодЕдиницы,
	|	СписаниеПутевокМатериалы.ДенежныйДокумент.ЕдиницаИзмерения.Наименование КАК пЕдиница,
	|	0 КАК пСуммаБезНДС,
	|	0 КАК пСуммаНДС,
	|	0 КАК пВсего
	|ИЗ
	|	Документ.ВыбытиеНеоплаченныхПутевок КАК СписаниеПутевок
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыбытиеНеоплаченныхПутевок.Материалы КАК СписаниеПутевокМатериалы
	|		ПО СписаниеПутевок.Ссылка = СписаниеПутевокМатериалы.Ссылка
	|ГДЕ
	|	СписаниеПутевок.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	пДата,
	|	пНомер,
	|	СписаниеПутевокМатериалы.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаШапка.Следующий() Цикл
	
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
	
		ОбластьМакетаШапка.Параметры.Заполнить(ВыборкаШапка);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(ОбластьМакетаШапка,"пНомер",ВыборкаШапка.пНомер,ВыборкаШапка.Ссылка,Неопределено, Истина);
		ТабличныйДокумент.Вывести(ОбластьМакетаШапка);
		
		КоличествоИтого = 0;
		СуммаБезНДСИтого = 0;
		СуммаНДСИтого = 0;
		ВсегоИтого = 0;
		
		ВыборкаСтроки = ВыборкаШапка.Выбрать();
		Пока ВыборкаСтроки.Следующий() Цикл
		
			ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаСтроки);
			пКорСчет = "" + ВыборкаШапка.КФО;
			пКорСчет = пКорСчет + ?(ПустаяСтрока(пКорСчет), "", ".") + ВыборкаШапка.СчетУчета;
			ОбластьМакетаСтрока.Параметры.Заполнить(Новый Структура("пСчетКредита", пКорСчет));
			
			СтруктураПараметров = Новый Структура("пКоличество, пСуммаБезНДС, пСуммаНДС, пВсего, пЦена", 0, 0, 0, 0, 0);
		
				
			Отбор = Новый Структура("Ссылка, СчетУчета, ДенежныйДокумент");
			ЗаполнитьЗначенияСвойств(Отбор, ВыборкаСтроки);
			СтрокиДвижений = ТаблицаДвижений.НайтиСтроки(Отбор);
			Если СтрокиДвижений.Количество() > 0 Тогда
				
				СтрокаСебестоимости = СтрокиДвижений[0];
				СтруктураПараметров.пКоличество = ВыборкаСтроки.пКоличество;
				Если ВыборкаСтроки.пКоличество = СтрокаСебестоимости.КоличествоОстаток Тогда
					СтруктураПараметров.пВсего = СтрокаСебестоимости.СуммаОстаток;
					СтруктураПараметров.пЦена = ?(СтруктураПараметров.пКоличество = 0, 0, СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток);
				ИначеЕсли СтрокаСебестоимости.КоличествоОстаток > 0 Тогда
					СтруктураПараметров.пЦена = Окр(СтрокаСебестоимости.СуммаОстаток / СтрокаСебестоимости.КоличествоОстаток, 2);
					СтруктураПараметров.пВсего = СтруктураПараметров.пЦена * СтруктураПараметров.пКоличество;
				КонецЕсли;
				СтруктураПараметров.пСуммаБезНДС = СтруктураПараметров.пВсего;
				СтрокаСебестоимости.КоличествоОстаток = СтрокаСебестоимости.КоличествоОстаток - СтруктураПараметров.пКоличество;
				СтрокаСебестоимости.СуммаОстаток = СтрокаСебестоимости.СуммаОстаток - СтруктураПараметров.пВсего;
					
			КонецЕсли;
			
			ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураПараметров);
			
			ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
			
			КоличествоИтого		= КоличествоИтого 	+ СтруктураПараметров.пКоличество;
			СуммаБезНДСИтого	= СуммаБезНДСИтого	+ СтруктураПараметров.пСуммаБезНДС;
			СуммаНДСИтого		= СуммаНДСИтого		+ СтруктураПараметров.пСуммаНДС;
			ВсегоИтого			= ВсегоИтого		+ СтруктураПараметров.пВсего;
			
		
		КонецЦикла; 
	    СтруктураОбластьМакетаИтого = Новый Структура("пКоличествоИтого,пСуммаБезНДСИтого,пСуммаНДСИтого,пВсегоИтого");
		СтруктураОбластьМакетаИтого.пКоличествоИтого	= КоличествоИтого;
		СтруктураОбластьМакетаИтого.пСуммаБезНДСИтого	= СуммаБезНДСИтого;
		СтруктураОбластьМакетаИтого.пСуммаНДСИтого		= СуммаНДСИтого;
		СтруктураОбластьМакетаИтого.пВсегоИтого		= ВсегоИтого;
		ОбластьМакетаИтого.Параметры.Заполнить(СтруктураОбластьМакетаИтого);
		
		ТабличныйДокумент.Вывести(ОбластьМакетаИтого);
		
		СтруктураОбластьМакетаПодвал = Новый Структура("пКоличествоНаименованийПрописью,пВсегоИтогоПрописью,пСуммаНалогов,пДолжностьРуководитель,пФИОРуководитель,пФИОБухгалтер");
		СтруктураОбластьМакетаПодвал.пКоличествоНаименованийПрописью = ЧислоПрописью(ВыборкаСтроки.Количество(),,"наименование,наименования,наименований,с,,,,,0");
		
		СтруктураОбластьМакетаПодвал.пВсегоИтогоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(ВсегоИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		СтруктураОбластьМакетаПодвал.пСуммаНалогов = "в том числе сумма НДС: " 
														+ ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаНДСИтого,Константы.ВалютаРегламентированногоУчета.Получить());
		Руководитель = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.Руководитель,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
											Руководитель.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пДолжностьРуководитель = ДанныеСотрудника.Должность;
		СтруктураОбластьМакетаПодвал.пФИОРуководитель = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
		ГлБухгалтер	 = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ВыборкаШапка.Организация, 
																					Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
																					ВыборкаШапка.пДата);
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", 
											ГлБухгалтер.ОтветственноеЛицоСсылка,
											ВыборкаШапка.пДата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		СтруктураОбластьМакетаПодвал.пФИОБухгалтер	  = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
																										ДанныеСотрудника.Фамилия,
																										ДанныеСотрудника.Имя,
																										ДанныеСотрудника.Отчество));
	    ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьМакетаПодвал);
		ТабличныйДокумент.Вывести(ОбластьМакетаПодвал);
	
	
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьНакладной0504205(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ.ВыбытиеНеоплаченныхПутевок) КАК Ссылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетУчета,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК ВидДенежногоДокументаСсылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК ДенежныйДокументСсылка,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК Количество,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
