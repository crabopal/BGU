Функция ПолучитьСписокТоваровУслуг(ДокументСсылка) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетНаОплатуМатериалы.Номенклатура КАК Номенклатура,
	               |	СчетНаОплатуМатериалы.Количество КАК Количество,
	               |	СчетНаОплатуМатериалы.Цена КАК Цена,
	               |	СчетНаОплатуМатериалы.Всего КАК Всего,
	               |	СчетНаОплатуМатериалы.СтавкаНДС КАК СтавкаНДС
	               |ИЗ
	               |	Документ.СчетНаОплату.Материалы КАК СчетНаОплатуМатериалы
	               |ГДЕ
	               |	СчетНаОплатуМатериалы.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СчетНаОплатуУслуги.Номенклатура,
	               |	СчетНаОплатуУслуги.Количество,
	               |	СчетНаОплатуУслуги.Цена,
	               |	СчетНаОплатуУслуги.Всего,
	               |	СчетНаОплатуУслуги.СтавкаНДС
	               |ИЗ
	               |	Документ.СчетНаОплату.Услуги КАК СчетНаОплатуУслуги
	               |ГДЕ
	               |	СчетНаОплатуУслуги.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;	
	
КонецФункции	

