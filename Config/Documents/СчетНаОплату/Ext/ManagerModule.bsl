		               |	20000 + СчетНаОплатуУслуги.НомерСтроки,
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер,
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).Наименование,
		               |	ВЫБОР
		               |		КОГДА ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
		               |			ТОГДА ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).Наименование
		               |		ИНАЧЕ ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
		               |	КОНЕЦ + ВЫБОР
		               |		КОГДА (ВЫРАЗИТЬ(СчетНаОплатуУслуги.Содержание КАК СТРОКА(1000))) = """"
		               |			ТОГДА """"
		               |		ИНАЧЕ "". "" + (ВЫРАЗИТЬ(СчетНаОплатуУслуги.Содержание КАК СТРОКА(1000)))
		               |	КОНЕЦ,
		               |	СчетНаОплатуУслуги.Номенклатура,
		               |	"""",
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Код,
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Наименование,
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.НаименованиеПолное,
		               |	ВЫРАЗИТЬ(СчетНаОплатуУслуги.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.МеждународноеСокращение,
		               |	СчетНаОплатуУслуги.Цена,
		               |	СчетНаОплатуУслуги.Количество,
		               |	СчетНаОплатуУслуги.Сумма,
		               |	СчетНаОплатуУслуги.Ссылка.СуммаВключаетНДС,
		               |	СчетНаОплатуУслуги.СуммаНДС,
		               |	СчетНаОплатуУслуги.СтавкаНДС,
		               |	СчетНаОплатуУслуги.Ссылка.СуммаВключаетНДС,
		               |	СчетНаОплатуУслуги.Содержание
		               |ИЗ
		               |	Документ.СчетНаОплату.Услуги КАК СчетНаОплатуУслуги
		               |ГДЕ
		               |	СчетНаОплатуУслуги.Ссылка = &Ссылка
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	30000 + СчетНаОплатуОсновныеСредства.НомерСтроки,
		               |	ЕСТЬNULL(НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки, """"),
		               |	ВЫРАЗИТЬ(СчетНаОплатуОсновныеСредства.ОС КАК Справочник.ОсновныеСредства).Наименование,
		               |	ВЫБОР
		               |		КОГДА ВЫРАЗИТЬ(СчетНаОплатуОсновныеСредства.ОС КАК Справочник.ОсновныеСредства).НаименованиеПолное = """"
		               |			ТОГДА ВЫРАЗИТЬ(СчетНаОплатуОсновныеСредства.ОС КАК Справочник.ОсновныеСредства).Наименование
		               |		ИНАЧЕ ВЫРАЗИТЬ(СчетНаОплатуОсновныеСредства.ОС КАК Справочник.ОсновныеСредства).НаименованиеПолное
		               |	КОНЕЦ,
		               |	СчетНаОплатуОсновныеСредства.ОС,
		               |	"""",
		               |	&ШтукаКод,
		               |	&ШтукаНаименование,
		               |	&ШтукаНаименованиеПолное,
		               |	&ШтукаМеждународноеСокращение,
		               |	СчетНаОплатуОсновныеСредства.Цена,
		               |	СчетНаОплатуОсновныеСредства.Количество,
		               |	СчетНаОплатуОсновныеСредства.Сумма,
		               |	СчетНаОплатуОсновныеСредства.Ссылка.СуммаВключаетНДС,
		               |	СчетНаОплатуОсновныеСредства.СуммаНДС,
		               |	СчетНаОплатуОсновныеСредства.СтавкаНДС,
		               |	СчетНаОплатуОсновныеСредства.Ссылка.СуммаВключаетНДС,
		               |	""""
		               |ИЗ
		               |	Документ.СчетНаОплату.ОсновныеСредства КАК СчетНаОплатуОсновныеСредства
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
		               |				&Период,
		               |				ОсновноеСредство В
		               |					(ВЫБРАТЬ
		               |						СчетНаОплатуОсновныеСредства.ОС
		               |					ИЗ
		               |						Документ.СчетНаОплату.ОсновныеСредства КАК СчетНаОплатуОсновныеСредства
		               |					ГДЕ
		               |						СчетНаОплатуОсновныеСредства.Ссылка = &Ссылка)) КАК НомераИнвентарныхКарточекСрезПоследних
		               |		ПО СчетНаОплатуОсновныеСредства.ОС = НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство
		               |ГДЕ
		               |	СчетНаОплатуОсновныеСредства.Ссылка = &Ссылка
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	40000 + СчетНаОплатуВозвратнаяТара.НомерСтроки,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).НоменклатурныйНомер,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).Наименование,
		               |	ВЫБОР
		               |		КОГДА ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное = """"
		               |			ТОГДА ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).Наименование
		               |		ИНАЧЕ ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
		               |	КОНЕЦ,
		               |	СчетНаОплатуВозвратнаяТара.Номенклатура,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).СтранаПроисхождения,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Код,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.Наименование,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.НаименованиеПолное,
		               |	ВЫРАЗИТЬ(СчетНаОплатуВозвратнаяТара.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения.МеждународноеСокращение,
		               |	СчетНаОплатуВозвратнаяТара.Цена,
		               |	СчетНаОплатуВозвратнаяТара.Количество,
		               |	СчетНаОплатуВозвратнаяТара.Сумма,
		               |	ИСТИНА,
		               |	0,
		               |	&СтавкаБезНДС,
		               |	СчетНаОплатуВозвратнаяТара.Ссылка.СуммаВключаетНДС,
		               |	""""
		               |ИЗ
		               |	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетНаОплатуВозвратнаяТара
		               |ГДЕ
		               |	СчетНаОплатуВозвратнаяТара.Ссылка = &Ссылка
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	НомерСтроки";
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", ДокументСсылка.МоментВремени());
	Запрос.УстановитьПараметр("СтавкаБезНДС", Перечисления.СтавкиНДС.БезНДС);
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", ВалютаРегУчета);
	
	Штука = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	Если Штука <> Неопределено Тогда
		Запрос.УстановитьПараметр("ШтукаКод", "796");
		Запрос.УстановитьПараметр("ШтукаНаименование", "шт");
		Запрос.УстановитьПараметр("ШтукаНаименованиеПолное", "Штука");
		Запрос.УстановитьПараметр("ШтукаМеждународноеСокращение", "PCE");
	Иначе	
		Запрос.УстановитьПараметр("ШтукаКод", Штука.Код);
		Запрос.УстановитьПараметр("ШтукаНаименование", Штука.Наименование);
		Запрос.УстановитьПараметр("ШтукаНаименованиеПолное", Штука.НаименованиеПолное);
		Запрос.УстановитьПараметр("ШтукаМеждународноеСокращение", Штука.МеждународноеСокращение);
	КонецЕсли;	
	
	Возврат(Запрос.ВыполнитьПакет());
КонецФункции	

Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка, ФорматЭД = "") Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
	ДокументСсылка.Организация, ВидКИАдрес);
	
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Плательщик) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен плательщик.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Плательщик = ДокументСсылка.Плательщик;
		
		Если ЗначениеЗаполнено(Плательщик.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Плательщик.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Плательщик.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес плательщика.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо плательщика.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ЛицевойСчет) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен лицевой счет.'");
		Сообщить(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.РеквизитыЛицевогоСчета) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнены реквизиты лицевого счета.'");
			Сообщить(ОписаниеОшибки);
			Результат = Ложь;
		Иначе	
			//контроль БИК
			РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ДокументСсылка.ЛицевойСчет, ДокументСсылка.РеквизитыЛицевогоСчета, РеквизитыПолучателя, Истина);
			
			Если РеквизитыПолучателя.БикБанкаПолучателя = "" Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен БИК банка получателя.'");
				Сообщить(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ДокументСсылка.Материалы Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Материалы"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.Услуги Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Услуги / работы"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.ВозвратнаяТара Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Возвратная тара"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

