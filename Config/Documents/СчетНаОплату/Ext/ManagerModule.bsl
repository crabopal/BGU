// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейсПодготовкиДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка, ФорматЭД = "") Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ФорматЭД = "ФНС101" ИЛИ ФорматЭД = "ФНС501" Тогда
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ВЫРАЗИТЬ(СчетНаОплату.НазначениеПлатежа КАК СТРОКА(1000)) КАК НазначениеПлатежа,
		               |	ВЫБОР
		               |		КОГДА СчетНаОплату.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		               |			ТОГДА СчетНаОплату.ВалютаДокумента
		               |		ИНАЧЕ &РегламентированнаяВалюта
		               |	КОНЕЦ КАК Валюта,
		               |	СчетНаОплату.Курс КАК Курс,
		               |	СчетНаОплату.Плательщик КАК Плательщик,
		               |	СчетНаОплату.Договор КАК Договор,
		               |	СчетНаОплату.ИдентификаторГосКонтракта КАК ИдентификаторГосКонтракта,
		               |	СчетНаОплату.Контрагент КАК Покупатель,
		               |	СчетНаОплату.СчетПлательщика КАК СчетПлательщика,
		               |	СчетНаОплату.Организация КАК Продавец,
		               |	СчетНаОплату.Подразделение КАК ПодразделениеПродавца,
		               |	СчетНаОплату.ЛицевойСчет КАК ЛицевойСчетПродавца,
		               |	СчетНаОплату.ОрганизацияПолучательДенежныхСредств КАК ПолучательДенежныхСредств,
		               |	СчетНаОплату.ЛицевойСчетПолучателяДенежныхСредств КАК ЛицевойСчетПолучателяДенежныхСредств,
		               |	СчетНаОплату.РеквизитыЛицевогоСчетаПолучателяДенежныхСредств КАК РеквизитыЛицевогоСчетаПолучателяДенежныхСредств,
		               |	СчетНаОплату.Грузоотправитель КАК Грузоотправитель,
		               |	СчетНаОплату.Грузополучатель КАК Грузополучатель,
		               |	СчетНаОплату.СрокОплаты КАК СрокОплаты,
		               |	СчетНаОплату.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчетаПродавца,
		               |	ВЫРАЗИТЬ(СчетНаОплату.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
		               |	СчетНаОплату.Дата КАК Дата,
		               |	СчетНаОплату.Номер КАК Номер,
		               |	СчетНаОплату.СуммаВключаетНДС КАК СуммаВключаетНДС,
		               |	СчетНаОплату.СуммаДокумента КАК СуммаДокумента,
		               |	СчетНаОплату.НеЗаполнятьЦеныВЭлектронномДокументе КАК НеЗаполнятьЦеныВЭлектронномДокументе,
		               |	ВЫБОР
		               |		КОГДА СчетНаОплату.ЭтоСчетОферта = ИСТИНА
		               |			ТОГДА ""1""
		               |		ИНАЧЕ ""0""
		               |	КОНЕЦ КАК Функция,
		               |	ВЫРАЗИТЬ(СчетНаОплату.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК ЗаказчикОбособленноеПодразделение,
		               |	ВЫРАЗИТЬ(СчетНаОплату.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК ЗаказчикГоловнаяОрганизация,
		               |	ВЫБОР
