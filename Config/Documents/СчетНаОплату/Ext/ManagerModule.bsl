#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

Процедура СформироватьОписаниеДокументовСКонтрагентомВШапке(Описание, ДокументСсылка, ДокументОбъект, Форма) Экспорт
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Контрагент,
	ДокументОбъект.Контрагент,
	Форма.Элементы.ГруппаКонтрагент);
	
	ПроверкаКонтрагентов.ДополнитьОписание(
	Описание, 
	ДокументСсылка, 
	Форма.Элементы.Плательщик,
	ДокументОбъект.Плательщик,
	Форма.Элементы.ГруппаПлательщик);
	
КонецПроцедуры

#Область ПрограммныйИнтерфейсПодсистемыПечать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.СчетНаОплату";
	КомандаПечати.Идентификатор = "Счет";
	КомандаПечати.Представление = НСтр("ru = 'Счет на оплату'");
	КомандаПечати.Порядок = 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.СчетНаОплату";
	КомандаПечати.Идентификатор = "Счет_QR";
	КомандаПечати.Представление = НСтр("ru = 'Счет на оплату (с QR-кодом)'");
	КомандаПечати.Порядок = 2;	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Счет") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"Счет", "Счет", ПечатьСчета_QR(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Счет", ПараметрыПечати));
		
	КонецЕсли;
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Счет_QR") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"Счет_QR", "Счет с QR-кодом", ПечатьСчета_QR(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Счет_QR", ПараметрыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать

// Функция формирует табличный документ Счет
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция ПечатьСчета_QR(МассивОбъектов, ОбъектыПечати, ИмяМакета, ПараметрыПечати)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы  = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб         = Истина;
	ТабДокумент.ИмяПараметровПечати = "ПечатьДокумента" + ИмяМакета;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ПустаяВалюта",Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", Константы.ВалютаРегламентированногоУчета.Получить());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет.Ссылка КАК Ссылка,
	|	Счет.Номер КАК Номер,
	|	Счет.Дата КАК Дата,
	|	Счет.Организация КАК ОрганизацияСсылка,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕСТЬNULL(Счет.Подразделение.ОбособленноеПодразделение, ЛОЖЬ)
	|				И ЕСТЬNULL(Счет.Подразделение.НаименованиеПолное, """") <> """"
	|			ТОГДА Счет.Подразделение.НаименованиеПолное
	|		КОГДА Счет.Организация.НаименованиеПолное = """"
	|			ТОГДА Счет.Организация.Наименование
	|		ИНАЧЕ Счет.Организация.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеПродавца,
	|	Счет.Организация.ИНН КАК ИННПродавца,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕСТЬNULL(Счет.Подразделение.ОбособленноеПодразделение, ЛОЖЬ)
	|				И ЕСТЬNULL(Счет.Подразделение.РегистрацияВНалоговомОргане, ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|			ТОГДА Счет.Подразделение.РегистрацияВНалоговомОргане.КПП
	|		ИНАЧЕ Счет.Организация.КПП
	|	КОНЕЦ КАК КПППродавца,
	|	Счет.ЛицевойСчет КАК ЛицевойСчет,
	|	Счет.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	ВЫБОР
	|		КОГДА Счет.ЛицевойСчет.НеВыводитьКБК
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ Счет.ЛицевойСчет.НеВыводитьКОСГУ
	|							И Счет.КПС.ДатаНачалаДействия < ДАТАВРЕМЯ(2016, 1, 1)
	|						ТОГДА ""000""
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		КОГДА Счет.КПС.ДатаНачалаДействия < ДАТАВРЕМЯ(2016, 1, 1)
	|			ТОГДА ПОДСТРОКА(Счет.КПС.Код, 1, 3)
	|		КОГДА Счет.ЛицевойСчет.НеВыводитьКодГлавы
	|			ТОГДА ""000""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Счет.ИФО.ИспользоватьРеквизитыИФО И ИспользоватьУчетПоИФО.Значение
	|					ТОГДА ЕСТЬNULL(Счет.ИФО.КодГлавыБК.Код, ""000"")
	|				ИНАЧЕ ЕСТЬNULL(Счет.ЛицевойСчет.Владелец.КодПоППП.Код, ""000"")
	|			КОНЕЦ
	|	КОНЕЦ КАК КодГлавы,
	|	ВЫБОР
	|		КОГДА Счет.ЛицевойСчет.НеВыводитьКБК
	|			ТОГДА ВЫБОР
	|					КОГДА НЕ Счет.ЛицевойСчет.НеВыводитьКОСГУ
	|							И Счет.КПС.ДатаНачалаДействия < ДАТАВРЕМЯ(2016, 1, 1)
	|						ТОГДА ""00000000000000"" + Счет.КОСГУ.Код
	|					ИНАЧЕ """"
	|				КОНЕЦ
	|		КОГДА Счет.КПС.ДатаНачалаДействия < ДАТАВРЕМЯ(2016, 1, 1)
	|			ТОГДА ПОДСТРОКА(Счет.КПС.Код, 4, 14) + Счет.КОСГУ.Код
	|		КОГДА Счет.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.ЛицевойСчет.НеВыводитьРазделПодраздел
	|						ТОГДА ""0000""
	|					ИНАЧЕ ПОДСТРОКА(Счет.КПС.Код, 1, 4)
	|				КОНЕЦ
	|		ИНАЧЕ Счет.КПС.Код
	|	КОНЕЦ КАК КодКПС,
	|	ВЫБОР
	|		КОГДА Счет.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|				И НЕ Счет.ЛицевойСчет.НеВыводитьКБК
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.ЛицевойСчет.НеВыводитьАналитическийКод
	|						ТОГДА ""0000000000"" + ПОДСТРОКА(Счет.КПС.Код, 15, 3)
	|					ИНАЧЕ ПОДСТРОКА(Счет.КПС.Код, 5, 13)
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодАналитикиКПС,
	|	Счет.КодОКАТО КАК КодОКАТО,
	|	Счет.Контрагент КАК КонтрагентСсылка,
	|	ВЫБОР
	|		КОГДА Счет.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ Счет.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА Счет.Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ Счет.Контрагент.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(Счет.Контрагент.НаименованиеСокращенное, """")
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	ЕСТЬNULL(Счет.Контрагент.ИНН, """") КАК КонтрагентИНН,
	|	ЕСТЬNULL(Счет.Контрагент.КПП, """") КАК КонтрагентКПП,
	|	Счет.Договор.Представление КАК Основание,
	|	Счет.Договор.НомерДоговора КАК НомерДоговора,
	|	Счет.Плательщик КАК ПлательщикСсылка,
	|	ВЫБОР
	|		КОГДА Счет.Плательщик.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Плательщик.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ Счет.Плательщик.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА Счет.Плательщик.ЮридическоеФизическоеЛицо.НаименованиеПолное
	|					ИНАЧЕ Счет.Плательщик.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ ЕСТЬNULL(Счет.Плательщик.НаименованиеСокращенное, """")
	|	КОНЕЦ КАК ПлательщикНаименование,
	|	ЕСТЬNULL(Счет.Плательщик.ИНН, """") КАК ПлательщикИНН,
	|	ЕСТЬNULL(Счет.Плательщик.КПП, """") КАК ПлательщикКПП,
	|	Счет.СчетПлательщика КАК СчетПлательщика,
	|	ВЫБОР
	|		КОГДА Счет.Плательщик.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПлательщикФизЛицо,
	|	ВЫБОР
	|		КОГДА Счет.СчетПлательщика.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СчетПлательщикаКазначейский,
	|	Счет.НазначениеПлатежа КАК НазначениеПлатежа,
	|	Счет.СуммаДокумента КАК СуммаДокумента,
	|	ВЫБОР
	|		КОГДА Счет.ВалютаДокумента = &ПустаяВалюта
	|			ТОГДА &РегламентированнаяВалюта
	|		ИНАЧЕ Счет.ВалютаДокумента
	|	КОНЕЦ КАК ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Счет.ВалютаДокумента = &ПустаяВалюта
	|				ИЛИ Счет.ВалютаДокумента = &РегламентированнаяВалюта
	|			ТОГДА ""Руб.""
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(Счет.ВалютаДокумента)
	|	КОНЕЦ КАК ВалютаПредставление,
	|	Счет.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	Счет.Руководитель КАК Руководитель,
	|	Счет.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	ВЫБОР
	|		КОГДА Счет.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	|				И (Счет.СчетПлательщика.ВсегдаУказыватьКПП
	|					ИЛИ Счет.СчетПлательщика.ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК УказыватьКПППлательщика,
	|	Счет.ВидОбменаДляQRКода КАК ВидОбменаДляQRКода,
	|	Счет.ФорматОбменаДляQRКода КАК ФорматОбменаДляQRКода,
	|	ВЫРАЗИТЬ(Счет.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК ЗаказчикОбособленноеПодразделение,
	|	ВЫРАЗИТЬ(Счет.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК ЗаказчикГоловнаяОрганизация,
	|	ВЫБОР
	|		КОГДА Счет.Контрагент.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					КОГДА НЕ Счет.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	|						ТОГДА Счет.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	|					КОГДА Счет.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ Счет.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ВЫРАЗИТЬ(Счет.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	|					ИНАЧЕ Счет.Контрагент.ГоловнаяОрганизация.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЗаказчикГоловнаяОрганизацияПредставление,
	|	ВЫБОР
	|		КОГДА Счет.Контрагент.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					ИНАЧЕ Счет.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ЗаказчикГоловнаяОрганизацияИНН,
	|	ВЫРАЗИТЬ(Счет.Плательщик КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	|	ВЫРАЗИТЬ(Счет.Плательщик КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	|	ВЫБОР
	|		КОГДА Счет.Плательщик.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Плательщик.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					КОГДА НЕ Счет.Плательщик.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	|						ТОГДА Счет.Плательщик.ГоловнаяОрганизация.НаименованиеСокращенное
	|					КОГДА Счет.Плательщик.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|							И НЕ Счет.Плательщик.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	|						ТОГДА ВЫРАЗИТЬ(Счет.Плательщик.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	|					ИНАЧЕ Счет.Плательщик.ГоловнаяОрганизация.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияПредставление,
	|	ВЫБОР
	|		КОГДА Счет.Плательщик.ОбособленноеПодразделение = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА Счет.Плательщик.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|						ТОГДА """"
	|					ИНАЧЕ Счет.Плательщик.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КонтрагентГоловнаяОрганизацияИНН,
	|	Счет.ПрименяетсяФорматЗначенийФНС КАК ПрименяетсяФорматЗначенийФНС
	|ПОМЕСТИТЬ СчетШапка
	|ИЗ
	|	Документ.СчетНаОплату КАК Счет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
	|		ПО (ИСТИНА) 
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константа.ИспользоватьУчетПоИФО КАК ИспользоватьУчетПоИФО
	|		ПО (ИСТИНА) 
	|ГДЕ
	|	Счет.Ссылка В(&МассивОбъектов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетШапка.Ссылка КАК Ссылка,
	|	СчетШапка.Номер КАК Номер,
	|	СчетШапка.Дата КАК Дата,
	|	СчетШапка.ОрганизацияСсылка КАК ОрганизацияСсылка,
	|	СчетШапка.НаименованиеПродавца КАК НаименованиеПродавца,
	|	СчетШапка.ИННПродавца КАК ИННПродавца,
	|	СчетШапка.КПППродавца КАК КПППродавца,
	|	СчетШапка.ЛицевойСчет КАК ЛицевойСчет,
	|	СчетШапка.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	СчетШапка.КодГлавы + СчетШапка.КодКПС + СчетШапка.КодАналитикиКПС КАК КодБК,
	|	СчетШапка.КодОКАТО КАК КодОКАТО,
	|	СчетШапка.КонтрагентСсылка КАК КонтрагентСсылка,
	|	СчетШапка.КонтрагентНаименование КАК КонтрагентНаименование,
	|	СчетШапка.КонтрагентИНН КАК КонтрагентИНН,
	|	СчетШапка.КонтрагентКПП КАК КонтрагентКПП,
	|	СчетШапка.Основание КАК Основание,
	|	СчетШапка.НомерДоговора КАК НомерДоговора,
	|	СчетШапка.ПлательщикСсылка КАК ПлательщикСсылка,
	|	СчетШапка.ПлательщикНаименование КАК ПлательщикНаименование,
	|	СчетШапка.ПлательщикИНН КАК ПлательщикИНН,
	|	СчетШапка.ПлательщикКПП КАК ПлательщикКПП,
	|	СчетШапка.СчетПлательщика КАК СчетПлательщика,
	|	СчетШапка.ПлательщикФизЛицо КАК ПлательщикФизЛицо,
	|	СчетШапка.СчетПлательщикаКазначейский КАК СчетПлательщикаКазначейский,
	|	СчетШапка.НазначениеПлатежа КАК НазначениеПлатежа,
	|	СчетШапка.СуммаДокумента КАК СуммаДокумента,
	|	СчетШапка.ВалютаДокумента КАК ВалютаДокумента,
	|	СчетШапка.ВалютаПредставление КАК ВалютаПредставление,
	|	СчетШапка.СуммаВключаетНДС КАК СуммаВключаетНДС,
	|	СчетШапка.Руководитель КАК Руководитель,
	|	СчетШапка.ГлавныйБухгалтер КАК ГлавныйБухгалтер,
	|	СчетШапка.УказыватьКПППлательщика КАК УказыватьКПППлательщика,
	|	СчетШапка.ВидОбменаДляQRКода КАК ВидОбменаДляQRКода,
	|	СчетШапка.ФорматОбменаДляQRКода КАК ФорматОбменаДляQRКода,
	|	СчетШапка.ЗаказчикОбособленноеПодразделение КАК ЗаказчикОбособленноеПодразделение,
	|	СчетШапка.ЗаказчикГоловнаяОрганизация КАК ЗаказчикГоловнаяОрганизация,
	|	СчетШапка.ЗаказчикГоловнаяОрганизацияПредставление КАК ЗаказчикГоловнаяОрганизацияПредставление,
	|	СчетШапка.ЗаказчикГоловнаяОрганизацияИНН КАК ЗаказчикГоловнаяОрганизацияИНН,
	|	СчетШапка.КонтрагентОбособленноеПодразделение КАК ПлательщикОбособленноеПодразделение,
	|	СчетШапка.КонтрагентГоловнаяОрганизация КАК ПлательщикГоловнаяОрганизация,
	|	СчетШапка.КонтрагентГоловнаяОрганизацияПредставление КАК ПлательщикГоловнаяОрганизацияПредставление,
	|	СчетШапка.КонтрагентГоловнаяОрганизацияИНН КАК ПлательщикГоловнаяОрганизацияИНН,
	|	СчетШапка.ПрименяетсяФорматЗначенийФНС КАК ПрименяетсяФорматЗначенийФНС
	|ИЗ
	|	СчетШапка КАК СчетШапка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СчетУслуги.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПОДСТРОКА(СчетУслуги.Содержание, 1, 1000)
	|		КОГДА ПОДСТРОКА(СчетУслуги.Содержание, 1, 1000) <> """"
	|			ТОГДА ПОДСТРОКА(СчетУслуги.Содержание, 1, 1000)
	|		КОГДА СчетУслуги.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА СчетУслуги.Номенклатура.Наименование
	|		ИНАЧЕ СчетУслуги.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК Наименование,
	|	ВЫБОР
	|		КОГДА СчетУслуги.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА СчетУслуги.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ СчетУслуги.ЕдиницаИзмерения.Представление
	|	КОНЕЦ КАК Единица,
	|	СчетУслуги.Количество КАК Количество,
	|	СчетУслуги.Цена КАК Цена,
	|	СчетУслуги.Сумма КАК Сумма,
	|	СчетУслуги.СуммаНДС КАК СуммаНДС,
	|	СчетУслуги.Всего КАК Всего,
	|	СчетУслуги.Ссылка КАК Ссылка,
	|	1 КАК ТипТаблицы,
	|	СчетУслуги.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.Услуги КАК СчетУслуги
	|ГДЕ
	|	СчетУслуги.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СчетМатериалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА СчетМатериалы.Номенклатура.Наименование
	|		ИНАЧЕ СчетМатериалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СчетМатериалы.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА СчетМатериалы.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ СчетМатериалы.ЕдиницаИзмерения.Представление
	|	КОНЕЦ,
	|	СчетМатериалы.Количество,
	|	СчетМатериалы.Цена,
	|	СчетМатериалы.Сумма,
	|	СчетМатериалы.СуммаНДС,
	|	СчетМатериалы.Всего,
	|	СчетМатериалы.Ссылка,
	|	2,
	|	СчетМатериалы.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.Материалы КАК СчетМатериалы
	|ГДЕ
	|	СчетМатериалы.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СчетОсновныеСредства.ОС.НаименованиеПолное = """"
	|			ТОГДА СчетОсновныеСредства.ОС.Наименование
	|		ИНАЧЕ СчетОсновныеСредства.ОС.НаименованиеПолное
	|	КОНЕЦ,
	|	""шт."",
	|	СчетОсновныеСредства.Количество,
	|	СчетОсновныеСредства.Цена,
	|	СчетОсновныеСредства.Сумма,
	|	СчетОсновныеСредства.СуммаНДС,
	|	СчетОсновныеСредства.Всего,
	|	СчетОсновныеСредства.Ссылка,
	|	3,
	|	СчетОсновныеСредства.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.ОсновныеСредства КАК СчетОсновныеСредства
	|ГДЕ
	|	СчетОсновныеСредства.Ссылка В(&МассивОбъектов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СчетВозвратнаяТара.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА СчетВозвратнаяТара.Номенклатура.Наименование
	|		ИНАЧЕ СчетВозвратнаяТара.Номенклатура.НаименованиеПолное
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СчетВозвратнаяТара.ЕдиницаИзмерения = ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка)
	|			ТОГДА СчетВозвратнаяТара.Номенклатура.ЕдиницаИзмерения.Представление
	|		ИНАЧЕ СчетВозвратнаяТара.ЕдиницаИзмерения.Представление
	|	КОНЕЦ,
	|	СчетВозвратнаяТара.Количество,
	|	СчетВозвратнаяТара.Цена,
	|	СчетВозвратнаяТара.Сумма,
	|	0,
	|	СчетВозвратнаяТара.Сумма,
	|	СчетВозвратнаяТара.Ссылка,
	|	4,
	|	СчетВозвратнаяТара.НомерСтроки
	|ИЗ
	|	Документ.СчетНаОплату.ВозвратнаяТара КАК СчетВозвратнаяТара
	|ГДЕ
	|	СчетВозвратнаяТара.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ТипТаблицы,
	|	НомерСтроки
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС),
	|	СУММА(Всего)
	|ПО
	|	Ссылка";
	
	ПервыйДокумент = Истина;	
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Шапка = МассивРезультатов[1].Выбрать();
	
	ТаблицаТЧ   = МассивРезультатов[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.СчетНаОплату."+ИмяМакета);
	
	НужноПечататьQRКод = Прав(ИмяМакета,2) = "QR";
	
	Пока Шапка.Следующий() Цикл
		
		РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(Шапка.ЛицевойСчет, Шапка.РеквизитыЛицевогоСчета, РеквизитыПолучателя, Истина);
		
		Если Не ПервыйДокумент Тогда
			// Все документы нужно выводить на разных страницах.
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ.
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ОбластьМакетаШапка  = Макет.ПолучитьОбласть("Шапка");
		ОбластьМакетаСтрока = Макет.ПолучитьОбласть("Строка");
		ОбластьМакетаСтрокаФорматФНС = Макет.ПолучитьОбласть("СтрокаФорматФНС");
		ОбластьМакетаИтого  = Макет.ПолучитьОбласть("Итого");
		ОбластьМакетаНДС    = Макет.ПолучитьОбласть("НДС");
		ОбластьМакетаПодвал = Макет.ПолучитьОбласть("Подвал");
		
		СтруктураОбластьМакетаШапка = Новый Структура("НомерДата, НаименованиеОрганизации, АдресТелефон, Контрагент, Плательщик, АдресПлательщика, ТелефонПлательщика");
		
		СтруктураОбластьМакетаШапка.НомерДата = "" + ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Шапка.Ссылка,Шапка.Номер) + " от " + Формат(Шапка.Дата, "ДЛФ=Д");
		НаименованиеОрганизации = СтрШаблон(НСтр("ru = '%1 ИНН %2 КПП %3'"),
			Шапка.НаименованиеПродавца, Шапка.ИННПродавца, Шапка.КПППродавца);
		СтруктураОбластьМакетаШапка.НаименованиеОрганизации = НаименованиеОрганизации; 
		
		ДанныеКИ = Новый Структура;
		ДанныеКИ.Вставить("ЮрАдресОрганизации", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Шапка.ОрганизацияСсылка,Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации));
		ДанныеКИ.Вставить("ТелефонОрганизации", УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Шапка.ОрганизацияСсылка,Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации));
		СтруктураОбластьМакетаШапка.АдресТелефон = "" + ДанныеКИ.ЮрАдресОрганизации + ", тел.: " + ДанныеКИ.ТелефонОрганизации;
		
		ИННЗаказчика = Шапка.КонтрагентИНН;
		КППЗаказчика = Шапка.КонтрагентКПП;
		ЗаказчикНаименование = Шапка.КонтрагентНаименование;
		
		СтруктураОбластьМакетаШапка.Контрагент = ЗаказчикНаименование
		+ ?(ПустаяСтрока(ИННЗаказчика), "", " ИНН " + ИННЗаказчика)
		+ ?(ПустаяСтрока(КППЗаказчика), "", " КПП " + КППЗаказчика);
		
		ИННПлательщика = Шапка.ПлательщикИНН;
		КПППлательщика = Шапка.ПлательщикКПП;
		ПлательщикНаименование = Шапка.ПлательщикНаименование;
		АдресПлательщика = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(Шапка.ПлательщикСсылка, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		ТелефонПлательщика = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(Шапка.ПлательщикСсылка,Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
		
		СтруктураОбластьМакетаШапка.АдресПлательщика 	= АдресПлательщика;
		СтруктураОбластьМакетаШапка.ТелефонПлательщика 	= ТелефонПлательщика; 
		
		СтруктураОбластьМакетаШапка.Плательщик = ПлательщикНаименование
		+ ?(ПустаяСтрока(ИННПлательщика), "", " ИНН " + ИННПлательщика)
		+ ?(ПустаяСтрока(КПППлательщика), "", " КПП " + КПППлательщика)
		+ ?(ПустаяСтрока(СтруктураОбластьМакетаШапка.АдресПлательщика), "", ", " + СтруктураОбластьМакетаШапка.АдресПлательщика)
		+ ?(ПустаяСтрока(СтруктураОбластьМакетаШапка.ТелефонПлательщика), "", ", тел.: " + СтруктураОбластьМакетаШапка.ТелефонПлательщика);
		
		//счет плательщика 
		Если ЗначениеЗаполнено(Шапка.СчетПлательщика) Тогда
			РеквизитыПлательщика = Новый Структура("Корреспондент, БанковскийСчет, НаименованиеБанка, БИКБанка, КорСчетБанка", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(Шапка.СчетПлательщика, Шапка.СчетПлательщика, РеквизитыПлательщика, Ложь);
			СтруктураОбластьМакетаШапка.Плательщик = СтруктураОбластьМакетаШапка.Плательщик + "
			|счет № " + РеквизитыПлательщика.БанковскийСчет + ", " + РеквизитыПлательщика.НаименованиеБанка + ", БИК " + РеквизитыПлательщика.БИКБанка;
			Если ЗначениеЗаполнено(РеквизитыПлательщика.КорСчетБанка) Тогда
				СтруктураОбластьМакетаШапка.Плательщик = СтруктураОбластьМакетаШапка.Плательщик + ", к/с " + РеквизитыПлательщика.КорСчетБанка;
			КонецЕсли;
			Если Шапка.СчетПлательщикаКазначейский Тогда
				СтруктураОбластьМакетаШапка.Плательщик = СтруктураОбластьМакетаШапка.Плательщик + "
				|" + РеквизитыПлательщика.Корреспондент;
			КонецЕсли;
		КонецЕсли;	
		
		ПараметрыШапки = ОбластьМакетаШапка.Параметры;
		
		ПараметрыШапки.Заполнить(Шапка);
		
		ПараметрыШапки.Заполнить(РеквизитыПолучателя);
		
		ПараметрыШапки.Заполнить(СтруктураОбластьМакетаШапка);
		
		Если НужноПечататьQRКод Тогда
			
			ОшибкаЗаполнения = Ложь;
			
			QRСтрока = "";
			
			Если ЗначениеЗаполнено(Шапка.ВидОбменаДляQRКода) И  ЗначениеЗаполнено(Шапка.ФорматОбменаДляQRКода) Тогда
				QRСтрока = ПолучитьСтрокуQRПоПравилуОбмена(ОшибкаЗаполнения, Шапка);
			Иначе
				QRСтрока = ПолучитьСтрокуQRПоВстроенномуАлгоритму(ОшибкаЗаполнения, Шапка, РеквизитыПолучателя, СтруктураОбластьМакетаШапка);
			КонецЕсли;	
			
			Если НЕ ОшибкаЗаполнения Тогда
				
				Если НЕ ПустаяСтрока(QRСтрока) Тогда
					
					ДанныеQRКода = ГенерацияШтрихкода.ДанныеQRКода(QRСтрока, 1, 300);

					
					Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
						
						Шаблон = Нстр("ru = 'Не удалось сформировать QR-код для документа %1.
						|Технические подробности см. в журнале регистрации.'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
						Шапка.Ссылка);
						
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
						
						Продолжить;
					КонецЕсли;
					
					КартинкаQRКода = Новый Картинка(ДанныеQRКода);
					
					ОбластьМакетаШапка.Рисунки.QRКодСправа.Картинка = КартинкаQRКода;
				Иначе
					//уберем QR код из макета, т.к. в нем тестовые данные
					ОбластьМакетаШапка.Рисунки.QRКодСправа.Картинка = Новый Картинка;
				КонецЕсли;
			Иначе
				//уберем QR код из макета, т.к. в нем тестовые данные
				ОбластьМакетаШапка.Рисунки.QRКодСправа.Картинка = Новый Картинка;	
			КонецЕсли;
			
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакетаШапка);
		
		Ном = 0;
		Поиск = Новый Структура;
		Поиск.Вставить("Ссылка", Шапка.Ссылка);
		Сумма = 0;
		СуммаНДС = 0;
		СуммаВсего = 0;
		
		Если ТаблицаТЧ.НайтиСледующий(Поиск) Тогда
			
			Сумма = ТаблицаТЧ.Сумма;
			СуммаНДС = ТаблицаТЧ.СуммаНДС;
			СуммаВсего = ТаблицаТЧ.Всего;
			ВыборкаПоТЧ = ТаблицаТЧ.Выбрать();
			
			Пока ВыборкаПоТЧ.Следующий() Цикл
				Ном = Ном + 1;
				Если Шапка.ПрименяетсяФорматЗначенийФНС Тогда
					ОбластьМакетаСтрокаФорматФНС.Параметры.Заполнить(ВыборкаПоТЧ);
					ОбластьМакетаСтрокаФорматФНС.Параметры.Заполнить(Новый Структура("Ном", Ном));
					ТабДокумент.Вывести(ОбластьМакетаСтрокаФорматФНС);
				Иначе	
					ОбластьМакетаСтрока.Параметры.Заполнить(ВыборкаПоТЧ);
					ОбластьМакетаСтрока.Параметры.Заполнить(Новый Структура("Ном", Ном));
					ТабДокумент.Вывести(ОбластьМакетаСтрока);
				КонецЕсли;
			КонецЦикла;	
			
		КонецЕсли;
		
		ОбластьМакетаИтого.Параметры.Заполнить(Новый Структура("ИтогоСумма", Сумма)); 
		ТабДокумент.Вывести(ОбластьМакетаИтого);
		
		СтруктураОбластьМакетаНДС = Новый Структура("ИтогоНДС,ТекстНДС",СуммаНДС,?(Шапка.СуммаВключаетНДС, "В т.ч. НДС:", "Итого сумма НДС:"));
		ОбластьМакетаНДС.Параметры.Заполнить(СтруктураОбластьМакетаНДС);
		ТабДокумент.Вывести(ОбластьМакетаНДС);
		
		СтруктураОбластьМакетаПодвал = Новый Структура("ИтогоВсего,КоличествоСтрок,ИтогоВсегоПрописью,ФИОРуководитель,ФИОБухгалтер");
		СтруктураОбластьМакетаПодвал.ИтогоВсего = СуммаВсего;
		СтруктураОбластьМакетаПодвал.КоличествоСтрок = Ном;
		СтруктураОбластьМакетаПодвал.ИтогоВсегоПрописью = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаВсего, Шапка.ВалютаДокумента);
		
		СтруктураОбластьМакетаПодвал.ФИОРуководитель = Справочники.Сотрудники.ФамилияИО(Шапка.Руководитель, Истина);
		СтруктураОбластьМакетаПодвал.ФИОБухгалтер    = Справочники.Сотрудники.ФамилияИО(Шапка.ГлавныйБухгалтер, Истина);
		ОбластьМакетаПодвал.Параметры.Заполнить(СтруктураОбластьМакетаПодвал);
		ТабДокумент.Вывести(ОбластьМакетаПодвал);
		
		// В табличном документе необходимо задать имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно. 
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, Шапка.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьСтрокуQRПоВстроенномуАлгоритму(ОшибкаЗаполнения, Шапка, РеквизитыПолучателя, СтруктураОбластьМакетаШапка)
	
	Если НЕ ЗначениеЗаполнено(Шапка.ЛицевойСчет) Тогда
		ТекстСообщения = Нстр("ru = 'Не выбран лицевой счет'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Шапка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Шапка.РеквизитыЛицевогоСчета) Тогда
		ТекстСообщения = Нстр("ru = 'Не выбраны реквизиты лицевого счета'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Шапка.Ссылка);
		ОшибкаЗаполнения = Истина;
	КонецЕсли;
	
	Если НЕ ОшибкаЗаполнения Тогда
		
		Если Не ЗначениеЗаполнено(РеквизитыПолучателя.ТекстПолучателя) Тогда
			ТекстСообщения = Нстр("ru = 'В реквизите лицевого счета не заполнено поле: ""Получатель""'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Шапка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РеквизитыПолучателя.НомерСчетаПолучателя) Тогда
			ТекстСообщения = Нстр("ru = 'В реквизите лицевого счета не заполнен номер счета'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Шапка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РеквизитыПолучателя.НаименованиеБанкаПолучателя) Тогда
			ТекстСообщения = Нстр("ru = 'В реквизите лицевого счета не заполнен банк получателя'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Шапка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(РеквизитыПолучателя.БикБанкаПолучателя) Тогда
			ТекстСообщения = Нстр("ru = 'В реквизите лицевого счета не заполнен БИК банка получателя'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,Шапка.Ссылка);
			ОшибкаЗаполнения = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ОшибкаЗаполнения Тогда
		
		РеквизитыПлатежа = Новый Структура("
		|ТекстПолучателя,
		|НомерСчетаПолучателя,
		|НаименованиеБанкаПолучателя,
		|БИКБанкаПолучателя,
		|СчетБанкаПолучателя,
		|СуммаЧислом,
		|НазначениеПлатежа,
		|ИННПлательщика,
		|ИННПолучателя,
		|КПППолучателя,
		|КодБК,
		|КодОКТМО,
		|ФамилияПлательщика,
		|ИмяПлательщика,
		|ОтчествоПлательщика,
		|АдресПлательщика,
		|СНИЛС,
		|ИдентификаторНачисления,
		|НомерДоговора,
		|СтатусСоставителя,
		|ПоказательОснования,
		|ПоказательПериода,
		|ПоказательНомера,
		|ПоказательДаты,
		|ПоказательТипа,
		|Ссылка");
		
		РеквизитыПлатежа.Ссылка 						= Шапка.Ссылка;		
		РеквизитыПлатежа.ТекстПолучателя 				= РеквизитыПолучателя.ТекстПолучателя;
		РеквизитыПлатежа.НомерСчетаПолучателя 			= РеквизитыПолучателя.НомерСчетаПолучателя;
		РеквизитыПлатежа.НаименованиеБанкаПолучателя 	= РеквизитыПолучателя.НаименованиеБанкаПолучателя;
		РеквизитыПлатежа.БИКБанкаПолучателя 			= РеквизитыПолучателя.БикБанкаПолучателя;
		РеквизитыПлатежа.СчетБанкаПолучателя 			= СокрЛП(РеквизитыПолучателя.СчетБанкаПолучателя); 
		//
		РеквизитыПлатежа.СуммаЧислом 					= Шапка.СуммаДокумента;
		РеквизитыПлатежа.НазначениеПлатежа 				= Шапка.НазначениеПлатежа;
		
		РеквизитыПлатежа.ИННПолучателя  				= РеквизитыПолучателя.ИННПолучателя;
		РеквизитыПлатежа.КПППолучателя  				= РеквизитыПолучателя.КПППолучателя;
		РеквизитыПлатежа.КодБК 							= Шапка.КодБК;
		РеквизитыПлатежа.КодОКТМО 						= Шапка.КодОКАТО;
		
		РеквизитыПлатежа.ИННПлательщика 				= Шапка.ПлательщикИНН;
		//
		Если Шапка.ПлательщикФизЛицо Тогда
			ФиоФизЛица = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", Шапка.ПлательщикСсылка, Шапка.Дата);
			
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ФиоФизЛица);
			
			РеквизитыПлатежа.ФамилияПлательщика 			= ?(ЗначениеЗаполнено(ФиоФизЛица.Фамилия), 	ФиоФизЛица.Фамилия, "");
			РеквизитыПлатежа.ИмяПлательщика 				= ?(ЗначениеЗаполнено(ФиоФизЛица.Имя), 		ФиоФизЛица.Имя, "");
			РеквизитыПлатежа.ОтчествоПлательщика 			= ?(ЗначениеЗаполнено(ФиоФизЛица.Отчество), ФиоФизЛица.Отчество, "");
		КонецЕсли;
		
		РеквизитыПлатежа.АдресПлательщика 				= ?(ЗначениеЗаполнено(СтруктураОбластьМакетаШапка.АдресПлательщика), СтруктураОбластьМакетаШапка.АдресПлательщика, "");
		
		РеквизитыПлатежа.НомерДоговора 					= ?(ЗначениеЗаполнено(Шапка.НомерДоговора), Шапка.НомерДоговора, "");	
		
		QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
		
		Возврат QRСтрока;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции			

Функция ПолучитьСтрокуQRПоПравилуОбмена(ОшибкаЗаполнения, Шапка)
	
	Возврат УправлениеПечатьюБГУ.ПолучитьтекстВыгрузкиПоПравилуОбмена(
	ОшибкаЗаполнения, 
	Шапка.Ссылка, 
	Шапка.Дата, 
	Шапка.ОрганизацияСсылка, 
	Шапка.ВидОбменаДляQRКода, 
	Шапка.ФорматОбменаДляQRКода);
	
КонецФункции	

