	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.СодержитНекорректныхКонтрагентов</Field>
				<Field>Список.СостояниеОригиналаПервичногоДокумента</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументСчетНаОплату.Ссылка,
	ДокументСчетНаОплату.ПометкаУдаления,
	ДокументСчетНаОплату.Номер,
	ДокументСчетНаОплату.Дата,
	ДокументСчетНаОплату.Проведен,
	ДокументСчетНаОплату.ВалютаДокумента,
	ДокументСчетНаОплату.ГлавныйБухгалтер,
	ДокументСчетНаОплату.Договор,
	ДокументСчетНаОплату.ИФО,
	ДокументСчетНаОплату.КодОКАТО,
	ДокументСчетНаОплату.Комментарий,
	ДокументСчетНаОплату.Контрагент,
	ДокументСчетНаОплату.КОСГУ,
	ДокументСчетНаОплату.КПС,
	ДокументСчетНаОплату.Кратность,
	ДокументСчетНаОплату.Курс,
	ДокументСчетНаОплату.КФО,
	ДокументСчетНаОплату.ЛицевойСчет,
	ДокументСчетНаОплату.НазначениеПлатежа,
	ДокументСчетНаОплату.Организация,
	ДокументСчетНаОплату.Плательщик,
	ДокументСчетНаОплату.Подразделение,
	ДокументСчетНаОплату.РеквизитыЛицевогоСчета,
	ДокументСчетНаОплату.Руководитель,
	ДокументСчетНаОплату.СуммаВключаетНДС,
	ДокументСчетНаОплату.СуммаДокумента,
	ДокументСчетНаОплату.СчетОплачен,
	ДокументСчетНаОплату.СчетПлательщика,
	ДокументСчетНаОплату.ТипЦены,
	ДокументСчетНаОплату.СрокОплаты,
	ДокументСчетНаОплату.Материалы,
	ДокументСчетНаОплату.Услуги,
	ДокументСчетНаОплату.ОсновныеСредства,
	ДокументСчетНаОплату.ВозвратнаяТара,
	ДокументСчетНаОплату.ДополнительныеРеквизиты,
	ДокументСчетНаОплату.МоментВремени,
	ДокументСчетНаОплату.ПрименяетсяФорматЗначенийФНС,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	ДокументСчетНаОплату.Ответственный,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	NULL КАК СостояниеОригиналаПервичногоДокумента,
	ИСТИНА КАК ОбщееСостояние,
	0 КАК СостояниеОригиналПолучен,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументСчетНаОплату.Контрагент
            ТОГДА ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.ВЭлектронномВиде)
        ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СпособыСоставленияДокумента.НаБумажномНосителе)
    КОНЕЦ КАК СпособСоставленияДокументаПоУмолчанию,
	ВЫБОР
        КОГДА НастройкиЭДО.Получатель = ДокументСчетНаОплату.Контрагент
            ТОГДА 1
        ИНАЧЕ 0
    КОНЕЦ КАК ЕстьНастройкаЭДО,
    ВЫБОР
		КОГДА ДокументыСОшибкамиПроверкиКонтрагентов.Документ ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК СодержитНекорректныхКонтрагентов
ИЗ
	Документ.СчетНаОплату КАК ДокументСчетНаОплату
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыСОшибкамиПроверкиКонтрагентов КАК ДокументыСОшибкамиПроверкиКонтрагентов
		ПО ДокументСчетНаОплату.Ссылка = ДокументыСОшибкамиПроверкиКонтрагентов.Документ
		И &amp;ИспользованиеПроверкиВозможно
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументСчетНаОплату.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
