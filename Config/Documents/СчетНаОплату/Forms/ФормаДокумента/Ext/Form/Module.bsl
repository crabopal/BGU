&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ТипЦены, ВалютаДокумента, СуммаВключаетНДС, Курс, Кратность");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьТипЦены", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО)
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КодФорматаЭДО", "Видимость", ВидимостьЭлементовЭДО);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИнформацияОКодеФорматаЭДО", "Видимость", ВидимостьЭлементовЭДО);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиПризнакНоменклатуры", "Видимость", Объект.ТипФорматаЭД = 2);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"МатериалыПризнакНоменклатуры", "Видимость", Объект.ТипФорматаЭД = 2);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваПризнакНоменклатуры", "Видимость", Объект.ТипФорматаЭД = 2);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВозвратнаяТараПризнакНоменклатуры", "Видимость", Объект.ТипФорматаЭД = 2);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСостояниеЭПД", "Видимость", Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭЗЗ);

	Если Форма.НастроенОбменЭПД И Форма.ЕстьПравоСозданиеЭЗЗ Тогда
		ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(Форма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Объект = Форма.Объект;
	
	ИспользоватьСкидкиНаценки = Объект.ИспользоватьСкидкиНаценки;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиЦенаБезСкидок", "Видимость", ИспользоватьСкидкиНаценки);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"МатериалыЦенаБезСкидок", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваЦенаБезСкидок", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиГруппаУправлениеСкидками", "Видимость", ИспользоватьСкидкиНаценки);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"МатериалыГруппаУправлениеСкидками", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваГруппаУправлениеСкидками", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваГруппаУправлениеСкидками", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УслугиСкидка", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"МатериалыСкидка", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОсновныеСредстваСкидка", "Видимость", ИспользоватьСкидкиНаценки);
	
	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСкидкиДляУслуги", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСкидкиДляМатериала", "Видимость", ИспользоватьСкидкиНаценки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаСкидкиДляОсновногоСредства", "Видимость", ИспользоватьСкидкиНаценки);
	
	
КонецПроцедуры

&НаСервере
Процедура ИспользоватьСкидкиНаценкиПриИзмененииНаСервере()
	Если Объект.ИспользоватьСкидкиНаценки Тогда
		Для каждого ТекСтрока Из Объект.Услуги Цикл
			Если ТекСтрока.ЦенаБезСкидок = 0 Тогда
				СтруктураПараметров = Новый Структура("Организация, Номенклатура, ТипЦены, ДатаЦены",
					Объект.Организация, ТекСтрока.Номенклатура, Объект.ТипЦены, Объект.Дата);
				
				ТекСтрока.ЦенаБезСкидок = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
			КонецЕсли;
			Если ТекСтрока.КлючСвязи = 0 Тогда
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Услуги, ТекСтрока, "КлючСвязи");
			КонецЕсли;
		КонецЦикла;
		Для каждого ТекСтрока Из Объект.Материалы Цикл
			Если ТекСтрока.ЦенаБезСкидок = 0 Тогда
				СтруктураПараметров = Новый Структура("Организация, Номенклатура, ТипЦены, ДатаЦены",
					Объект.Организация, ТекСтрока.Номенклатура, Объект.ТипЦены, Объект.Дата);
				
				ТекСтрока.ЦенаБезСкидок = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
			КонецЕсли;
			Если ТекСтрока.КлючСвязи = 0 Тогда
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Материалы, ТекСтрока, "КлючСвязи");
			КонецЕсли;
		КонецЦикла;
		Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			Если ТекСтрока.ЦенаБезСкидок = 0 Тогда
				СтруктураПараметров = Новый Структура("Организация, Номенклатура, ТипЦены, ДатаЦены",
					Объект.Организация, ТекСтрока.ОС, Объект.ТипЦены, Объект.Дата);
				
				ТекСтрока.ЦенаБезСкидок = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
			КонецЕсли;
			Если ТекСтрока.КлючСвязи = 0 Тогда
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.ОсновныеСредства, ТекСтрока, "КлючСвязи");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляУслуг(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДобавитьОбщуюСкидкуДляУслугНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбщуюСкидкуДляУслугНаСервере(СкидкаНаценка)
	НомерТабличнойЧасти = 1;
	
	Для каждого ТекСтрока Из Объект.Услуги Цикл
		НоваяСтрока = Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.НомерТабличнойЧасти = НомерТабличнойЧасти;
		НоваяСтрока.КлючСвязи = ТекСтрока.КлючСвязи;
		НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
		
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		
		НоваяСтрока.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
			
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
			
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЦикла;	
	
	ОбновитьСкидкиНаценкиИИтогиДляУслугНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляМатериалов(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДобавитьОбщуюСкидкуДляМатериаловНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбщуюСкидкуДляМатериаловНаСервере(СкидкаНаценка)
	НомерТабличнойЧасти = 2;
	
	Для каждого ТекСтрока Из Объект.Материалы Цикл
		НоваяСтрока = Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.НомерТабличнойЧасти = НомерТабличнойЧасти;
		НоваяСтрока.КлючСвязи = ТекСтрока.КлючСвязи;
		НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
		
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		
		НоваяСтрока.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
			
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
			
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЦикла;	
	
	ОбновитьСкидкиНаценкиИИтогиДляМатериаловНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляОС(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДобавитьОбщуюСкидкуДляОСНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОбщуюСкидкуДляОСНаСервере(СкидкаНаценка)
	НомерТабличнойЧасти = 3;
	
	Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		НоваяСтрока = Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.НомерТабличнойЧасти = НомерТабличнойЧасти;
		НоваяСтрока.КлючСвязи = ТекСтрока.КлючСвязи;
		НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
		
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		
		НоваяСтрока.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
			
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
			
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЦикла;	
	
	ОбновитьСкидкиНаценкиИИтогиДляОСНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры)
	Возврат РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
КонецФункции

&НаСервере
Функция ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, КлючСвязи)
	ПараметрыОтбора = Новый Структура("НомерТабличнойЧасти, КлючСвязи", НомерТабличнойЧасти, КлючСвязи); 	
	МассивОтбора = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Результат = 0;
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		Результат = Результат + СтрокаОтбора.Сумма;
	КонецЦикла;	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбновитьСкидкиНаценкиИИтогиДляУслугНаСервере()
	НомерТабличнойЧасти = 1;
	
	Для каждого ТекСтрока Из Объект.Услуги Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;
	КонецЦикла;
	
	ОбновитьВсеСкидки();
	РассчитатьИтог();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкидкиНаценкиИИтогиДляМатериаловНаСервере()
	НомерТабличнойЧасти = 2;
	
	Для каждого ТекСтрока Из Объект.Материалы Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;
	КонецЦикла;
	
	ОбновитьВсеСкидки();
	РассчитатьИтог();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкидкиНаценкиИИтогиДляОСНаСервере()
	НомерТабличнойЧасти = 3;
	
	Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
		ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;
	КонецЦикла;
	
	ОбновитьВсеСкидки();
	РассчитатьИтог();
КонецПроцедуры

&НаСервере
Процедура ОбновитьВсеСкидки()

	ДанныеВсеСкидкиНаценки = ДанныеВсеСкидкиНаценки();
	
	ЭтаФорма.ВсеСкидкиНаценки.Загрузить(ДанныеВсеСкидкиНаценки);	
	
КонецПроцедуры

&НаСервере
Функция ДанныеВсеСкидкиНаценки()
	Скидки = Объект.СкидкиНаценки.Выгрузить();	
	Услуги = Объект.Услуги.Выгрузить();
	Материалы = Объект.Материалы.Выгрузить();
	ОсновныеСредства = Объект.ОсновныеСредства.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	1 КАК НомерТабличнойЧасти,
	               |	Услуги.КлючСвязи КАК КлючСвязи,
	               |	Услуги.НомерСтроки КАК НомерСтроки,
	               |	Услуги.Номенклатура КАК Номенклатура,
	               |	Услуги.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаУслуги
	               |ИЗ
	               |	&Услуги КАК Услуги
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	2 КАК НомерТабличнойЧасти,
	               |	Материалы.КлючСвязи КАК КлючСвязи,
	               |	Материалы.НомерСтроки КАК НомерСтроки,
	               |	Материалы.Номенклатура КАК Номенклатура,
	               |	Материалы.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаМатериалы
	               |ИЗ
	               |	&Материалы КАК Материалы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	3 КАК НомерТабличнойЧасти,
	               |	ОсновныеСредства.КлючСвязи КАК КлючСвязи,
	               |	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	               |	ОсновныеСредства.ОС КАК Номенклатура,
	               |	ОсновныеСредства.Количество КАК Количество
	               |ПОМЕСТИТЬ ТаблицаОС
	               |ИЗ
	               |	&ОсновныеСредства КАК ОсновныеСредства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Материалы.НомерТабличнойЧасти КАК НомерТабличнойЧасти,
	               |	Материалы.КлючСвязи КАК КлючСвязи,
	               |	Материалы.НомерСтроки КАК НомерСтроки,
	               |	Материалы.Номенклатура КАК Номенклатура,
	               |	Материалы.Количество КАК Количество
	               |ПОМЕСТИТЬ ТоварыРаботыУслуги
	               |ИЗ
	               |	ТаблицаМатериалы КАК Материалы
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Услуги.НомерТабличнойЧасти,
	               |	Услуги.КлючСвязи,
	               |	Услуги.НомерСтроки,
	               |	Услуги.Номенклатура,
	               |	Услуги.Количество
	               |ИЗ
	               |	ТаблицаУслуги КАК Услуги
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОС.НомерТабличнойЧасти,
	               |	ОС.КлючСвязи,
	               |	ОС.НомерСтроки,
	               |	ОС.Номенклатура,
	               |	ОС.Количество
	               |ИЗ
	               |	ТаблицаОС КАК ОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СкидкиНаценки.НомерТабличнойЧасти КАК НомерТабличнойЧасти,
	               |	СкидкиНаценки.КлючСвязи КАК КлючСвязи,
	               |	СкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
	               |	СкидкиНаценки.Сумма КАК Сумма
	               |ПОМЕСТИТЬ СкидкиНаценки
	               |ИЗ
	               |	&СкидкиНаценки КАК СкидкиНаценки
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТоварыРаботыУслуги.НомерСтроки КАК НомерСтроки,
	               |	ТоварыРаботыУслуги.Номенклатура КАК Номенклатура,
	               |	СкидкиНаценки.СкидкаНаценка КАК СкидкаНаценка,
	               |	СкидкиНаценки.Сумма КАК Сумма,
	               |	ТоварыРаботыУслуги.Количество КАК Количество,
	               |	ТоварыРаботыУслуги.Количество * СкидкиНаценки.Сумма КАК Всего,
	               |	ТоварыРаботыУслуги.НомерТабличнойЧасти КАК НомерТабличнойЧасти
	               |ПОМЕСТИТЬ ИтогиСкидокНаценок
	               |ИЗ
	               |	ТоварыРаботыУслуги КАК ТоварыРаботыУслуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СкидкиНаценки КАК СкидкиНаценки
	               |		ПО ТоварыРаботыУслуги.КлючСвязи = СкидкиНаценки.КлючСвязи
	               |			И ТоварыРаботыУслуги.НомерТабличнойЧасти = СкидкиНаценки.НомерТабличнойЧасти
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИтогиСкидокНаценок.НомерСтроки КАК НомерСтроки,
	               |	ИтогиСкидокНаценок.НомерТабличнойЧасти КАК НомерТабличнойЧасти,
	               |	ИтогиСкидокНаценок.Номенклатура КАК Номенклатура,
	               |	ИтогиСкидокНаценок.СкидкаНаценка КАК СкидкаНаценка,
	               |	ИтогиСкидокНаценок.Сумма КАК Сумма,
	               |	ИтогиСкидокНаценок.Количество КАК Количество,
	               |	ИтогиСкидокНаценок.Всего КАК Всего
	               |ИЗ
	               |	ИтогиСкидокНаценок КАК ИтогиСкидокНаценок
	               |ГДЕ
	               |	ИтогиСкидокНаценок.Всего <> 0";
				   
	Запрос.УстановитьПараметр("Услуги", Услуги);
	Запрос.УстановитьПараметр("Материалы", Материалы);
	Запрос.УстановитьПараметр("ОсновныеСредства", ОсновныеСредства);
	Запрос.УстановитьПараметр("СкидкиНаценки", Скидки);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПерерассчитатьСкидку(НомерТабличнойЧасти, КлючСвязи, Номенклатура, ЦенаБезСкидок)
	Результат = 0;
	ПараметрыОтбора = Новый Структура("НомерТабличнойЧасти, КлючСвязи", НомерТабличнойЧасти, КлючСвязи);
	НайденныеСтроки = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
			
	Если НайденныеСтроки.Количество() > 0 Тогда
		Для каждого ТекСкидка Из НайденныеСтроки Цикл
			СуммаСкидки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(ТекСкидка.СкидкаНаценка, ЦенаБезСкидок);
			ТекСкидка.Сумма = СуммаСкидки;
			Результат = Результат + СуммаСкидки;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция РассчитатьСкидку(НомерТабличнойЧасти, КлючСвязи, Номенклатура, ЦенаБезСкидок)
	
	Покупатель = Объект.Контрагент;
	ПокупательНеопределен = ?(ЗначениеЗаполнено(Покупатель), Ложь, Истина);
	
	ТЗ_ДействующиеСкидкиНаценки = ТаблицаДействующихСкидокНаценок(Объект.Организация);
	
	Номенклатура = Номенклатура;
	ЦенаНоменклатуры = ЦенаБезСкидок;
	
	ОбщаяСуммаСкидки = 0;
	
	Для каждого ТекСкидкаНаценка Из ТЗ_ДействующиеСкидкиНаценки Цикл
		СкидкаНаценка = ТекСкидкаНаценка.СкидкаНаценка;
		ДобавитьСкидкуНаценку = Ложь;
		
		Если СкидкаНаценка.Получатели.Количество()>0 Тогда
			Если ПокупательНеопределен Тогда
				Продолжить;
			Иначе
				ПараметрыОтбора = Новый Структура("Получатель", Покупатель); 	
				МассивПолучателей = СкидкаНаценка.Получатели.НайтиСтроки(ПараметрыОтбора);
				Если МассивПолучателей.Количество()>0 Тогда
					ДобавитьСкидкуНаценку = Истина;
				Иначе
					ДобавитьСкидкуНаценку = Ложь;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		Если ДобавитьСкидкуНаценку Тогда
			ПараметрыОтбора = Новый Структура("НомерТабличнойЧасти, КлючСвязи, СкидкаНаценка", НомерТабличнойЧасти, КлючСвязи, СкидкаНаценка);
			НайденныеСтроки = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				НоваяСтрока = Объект.СкидкиНаценки.Добавить();
				НоваяСтрока.КлючСвязи = КлючСвязи;
				НоваяСтрока.СкидкаНаценка = СкидкаНаценка;
				СуммаСкидки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
				НоваяСтрока.Сумма = СуммаСкидки;
				ОбщаяСуммаСкидки = ОбщаяСуммаСкидки + СуммаСкидки
			Иначе
				Для каждого ТекСкидка Из НайденныеСтроки Цикл
					СуммаСкидки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
					ТекСкидка.Сумма = СуммаСкидки;
					ОбщаяСуммаСкидки = ОбщаяСуммаСкидки + СуммаСкидки
				КонецЦикла;	
			КонецЕсли;	
				
		КонецЕсли;
		
	КонецЦикла;
	Результат = ОбщаяСуммаСкидки;
	ОбновитьВсеСкидки();
	
	Возврат Результат;		
КонецФункции	

&НаСервере
Функция ТаблицаДействующихСкидокНаценок(Организация)
	ДатаСведений = Объект.Дата;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СкидкиНаценки.Ссылка КАК СкидкаНаценка
	               |ИЗ
	               |	Справочник.СкидкиНаценки КАК СкидкиНаценки
	               |ГДЕ
	               |	СкидкиНаценки.ДатаНачалаДействия <= &ДатаСведений
	               |	И (СкидкиНаценки.ДатаОкончанияДействия > &ДатаСведений ИЛИ СкидкиНаценки.ДатаОкончанияДействия = &ПустаяДата)
	               |	И СкидкиНаценки.СтатусДействия = &СтатусДействия
	               |	И СкидкиНаценки.Организация = &Организация
	               |	И СкидкиНаценки.ПометкаУдаления = ЛОЖЬ";
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("СтатусДействия", Перечисления.СтатусыДействияСкидок.Действует);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПустаяДата", ДАТА(1,1,1));
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляУслугОтмена(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ОтменитьОбщуюСкидкуДляУслугНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляМатериаловОтмена(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ОтменитьОбщуюСкидкуДляМатериаловНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценокДляОСОтмена(РезультатОткрытияФормы, ДокОбъект) Экспорт
	
	НоваяСтрока = Неопределено;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ОтменитьОбщуюСкидкуДляОСНаСервере(РезультатОткрытияФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьОбщуюСкидкуДляУслугНаСервере(СкидкаНаценка)
	НомерТабличнойЧасти = 1;
	
	ПараметрыОтбора = Новый Структура("СкидкаНаценка", СкидкаНаценка); 	
	МассивКУдалению = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СкидкиНаценки.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Для каждого ТекСтрока Из Объект.Услуги Цикл
		ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
			
		ЦенаБезСкидок = ТекСтрока.ЦенаБезСкидок;
		ТекСтрока.Цена = ЦенаБезСкидок - ТекСтрока.Скидка;
		РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЦикла;
	
	ОбновитьСкидкиНаценкиИИтогиДляУслугНаСервере();
КонецПроцедуры

