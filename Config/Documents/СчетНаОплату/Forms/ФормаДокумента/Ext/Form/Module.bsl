	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные.КлючСвязи = 0;
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.ОсновныеСредства, ТекущиеДанные, "КлючСвязи");
