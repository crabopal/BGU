&НаКлиенте
Процедура СкидкиНаценкиУслугиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.Услуги.ТекущиеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не выбрана услуга, для которой добавляется скидка.'");
		Сообщение.Сообщить();
		
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиУслугиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Элементы.Услуги.ТекущиеДанные <> Неопределено Тогда
		ТекущиеДанные = Элементы.СкидкиНаценкиУслуги.ТекущиеДанные;
		ТекущиеДанные.КлючСвязи = Элементы.Услуги.ТекущиеДанные.КлючСвязи;
		ТекущиеДанные.НомерТабличнойЧасти = 1;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиУслугиПослеУдаления(Элемент)
	НомерТабличнойЧасти = 1;
	
	ТекСтрока = Элементы.Услуги.ТекущиеДанные;
	ТекСтрока.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекСтрока.КлючСвязи);
	ТекСтрока.Цена = ТекСтрока.ЦенаБезСкидок - ТекСтрока.Скидка;

	РассчитатьСтроку(ТекСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
	
	РассчитатьИтог();	
КонецПроцедуры

&НаКлиенте
Процедура СкидкиНаценкиУслугиНаценкаПриИзменении(Элемент)
	НомерТабличнойЧасти = 1;
	
	ТекущиеДанные = Элементы.СкидкиНаценкиУслуги.ТекущиеДанные;
	ТекущиеДанныеНоменклатуры = Элементы.Услуги.ТекущиеДанные;
	ЦенаБезСкидок = ТекущиеДанныеНоменклатуры.ЦенаБезСкидок;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СкидкаНаценка) Тогда
		ТекущиеДанные.Сумма = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(ТекущиеДанные.СкидкаНаценка, ЦенаБезСкидок);
		
		ТекущиеДанныеНоменклатуры.Скидка = ОбщаяСкидкаПоНоменклатуре(НомерТабличнойЧасти, ТекущиеДанные.КлючСвязи);
		
