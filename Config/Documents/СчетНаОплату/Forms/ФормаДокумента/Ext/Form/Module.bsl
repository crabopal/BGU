&НаКлиенте
Асинх Процедура СоздатьЭлектроннуюЗаказЗаявкуНаКлиенте()
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		Результат = Ждать ЗаписатьДокумент();
		Если НЕ Результат Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЭлектронныеДокументыБГУВызовСервера.ДанныеДляЗаполненияЭЗЗ(Объект.Ссылка));
	
	ОписаниеОповещения = Новый ОписаниеОповещения("СоздатьЭлектроннуюЗаказЗаявкуЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Документ.ЭлектронныйЗаказЗаявка.ФормаОбъекта",ПараметрыФормы,,,,,ОписаниеОповещения);
КонецПроцедуры 

