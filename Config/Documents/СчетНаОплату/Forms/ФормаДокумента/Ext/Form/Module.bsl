	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(
		Объект.Организация, "Документ.СчетНаОплату", Объект.Дата);
	
	Объект.ЛицевойСчет = Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииНоменклатуры(Номенклатура,ТекИдентификатор,ИмяТЧ)
	ТекСтрока = Объект[ИмяТЧ].НайтиПоИдентификатору(ТекИдентификатор);
	ЗаполнитьСтрокуТЧПоНоменклатуре(ТекСтрока,Номенклатура,ИмяТЧ);
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииВалюты()
	
	СтруктураНовойВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, КонецДня(Объект.Дата));
	Объект.Курс      = СтруктураНовойВалюты.Курс;
	Объект.Кратность = СтруктураНовойВалюты.Кратность;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииТипаЦен()
	
	МассивТабЧастей = Новый Массив;
	МассивТабЧастей.Добавить("Услуги");
	МассивТабЧастей.Добавить("Материалы");
	МассивТабЧастей.Добавить("ВозвратнаяТара");
	СтруктураПараметров = Новый Структура("Организация,ТипЦены,ДатаЦены",
		Объект.Организация, Объект.ТипЦены, Объект.Дата);
	Для каждого ИмяТЧ из МассивТабЧастей Цикл	
		Для каждого СтрокаТЧ из Объект[ИмяТЧ] Цикл
			СтруктураПараметров.Вставить("Номенклатура", СтрокаТЧ.Номенклатура);
			СтрокаТЧ.Цена = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
			
			Если Объект.ИспользоватьСкидкиНаценки Тогда
				СтрокаТЧ.ЦенаБезСкидок = СтрокаТЧ.Цена;
				
				Если ИмяТЧ = "Услуги" Тогда
					НомерТабличнойЧасти = 1;
				ИначеЕсли ИмяТЧ = "Материалы" Тогда
					НомерТабличнойЧасти = 2;
				ИначеЕсли ИмяТЧ = "ОсновныеСредства" Тогда
					НомерТабличнойЧасти = 3;
				КонецЕсли;
				
				Если Объект.СкидкиНаценки.Количество() > 0 Тогда
					Скидка = ПерерассчитатьСкидку(НомерТабличнойЧасти, СтрокаТЧ.КлючСвязи, СтрокаТЧ.Номенклатура, СтрокаТЧ.ЦенаБезСкидок);
				Иначе	
					Скидка = РассчитатьСкидку(НомерТабличнойЧасти, СтрокаТЧ.КлючСвязи, СтрокаТЧ.Номенклатура, СтрокаТЧ.ЦенаБезСкидок);
				КонецЕсли;
				
				СтрокаТЧ.Скидка = Скидка;
				СтрокаТЧ.Цена = СтрокаТЧ.ЦенаБезСкидок - Скидка;
			КонецЕсли;	
			
			РассчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Цена", ИмяТЧ<>"ВозвратнаяТара", Ложь,Объект.ПрименяетсяФорматЗначенийФНС);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПодписей()
	
	ГлавБух = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, Объект.Организация,
		Объект.Дата, Объект.Подразделение);
	Объект.ГлавныйБухгалтер = ГлавБух.ОтветственноеЛицоСсылка;
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, Объект.Организация,
		Объект.Дата, Объект.Подразделение);
	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТЧПоНоменклатуре(ДанныеСтроки, ТекНоменклатура, ИмяТЧ)
	
	Если ИмяТЧ = "Материалы" ИЛИ ИмяТЧ = "Услуги" Тогда 
		
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекНоменклатура);
		
		ДанныеСтроки.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
		
		Если ИмяТЧ = "Услуги" Тогда
			ДанныеСтроки.Содержание= ДанныеНоменклатуры.СодержаниеУслуги;
		КонецЕсли;	
		
		Если ДанныеСтроки.Количество = 0 Тогда
			ДанныеСтроки.Количество = 1;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура("Организация, Номенклатура, ТипЦены, ДатаЦены",
			Объект.Организация, ТекНоменклатура, Объект.ТипЦены, Объект.Дата);
		Цена = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);	
		ДанныеСтроки.ЦенаБезСкидок = Цена;
		ДанныеСтроки.Цена = Цена;
		
		Если ИмяТЧ = "Материалы" Тогда
			РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Материалы, ДанныеСтроки, "КлючСвязи");
			
			Скидка = РассчитатьСкидку(2, ДанныеСтроки.КлючСвязи, ДанныеСтроки.Номенклатура, ДанныеСтроки.ЦенаБезСкидок);
			ДанныеСтроки.Скидка = Скидка;
			ДанныеСтроки.Цена = ДанныеСтроки.ЦенаБезСкидок - Скидка;
			РассчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
			
		ИначеЕсли ИмяТЧ = "Услуги" Тогда
			РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Услуги, ДанныеСтроки, "КлючСвязи");
			
			Скидка = РассчитатьСкидку(1, ДанныеСтроки.КлючСвязи, ДанныеСтроки.Номенклатура, ДанныеСтроки.ЦенаБезСкидок);
			ДанныеСтроки.Скидка = Скидка;
			ДанныеСтроки.Цена = ДанныеСтроки.ЦенаБезСкидок - Скидка;
			РассчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
		Конецесли;
		
		РассчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Количество",,,Объект.ПрименяетсяФорматЗначенийФНС);
		
	ИначеЕсли ИмяТЧ = "ОсновныеСредства" Тогда
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.ОсновныеСредства, ДанныеСтроки, "КлючСвязи");
		
		Скидка = РассчитатьСкидку(3, ДанныеСтроки.КлючСвязи, ДанныеСтроки.Номенклатура, ДанныеСтроки.ЦенаБезСкидок);
		ДанныеСтроки.Скидка = Скидка;
		ДанныеСтроки.Цена = ДанныеСтроки.ЦенаБезСкидок - Скидка;
		РассчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
		
	ИначеЕсли ИмяТЧ = "ВозвратнаяТара" Тогда
		
		Если ДанныеСтроки.Количество = 0 Тогда
			ДанныеСтроки.Количество = 1;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура("Организация, Номенклатура, ТипЦены, ДатаЦены",
			Объект.Организация, ТекНоменклатура, Объект.ТипЦены, Объект.Дата);
		ДанныеСтроки.Цена = УправлениеМатериальнымиЗапасамиВызовСервера.ЦенаНоменклатурыВвалюте(СтруктураПараметров);
		РассчитатьСтроку(ДанныеСтроки, Объект.СуммаВключаетНДС, "Количество", Ложь,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуТЧприПодборе(ИмяТЧ, Номенклатура, ЕстьСтавкаНДС = Истина)
	
	Док = РеквизитФормыВЗначение("Объект");
	ТекСтрока = Док[ИмяТЧ].Найти(Номенклатура, "Номенклатура");
	Если ТекСтрока<>Неопределено Тогда
		ТекСтрока.Количество = ТекСтрока.Количество + 1;
		РассчитатьСтроку(ТекСтрока,Док.СуммаВключаетНДС,"Количество",ЕстьСтавкаНДС,,Объект.ПрименяетсяФорматЗначенийФНС);
	Иначе
		НоваяСтрока = Док[ИмяТЧ].Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		ЗаполнитьСтрокуТЧПоНоменклатуре(НоваяСтрока,Номенклатура,ИмяТЧ);
	КонецЕсли;
	ЗначениеВРеквизитФормы(Док,"Объект");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоОрганизации()
	
	Если ЗначениеЗаполнено(Объект.Дата)Тогда
		ПроверяемаяДата = Объект.Дата;
	Иначе
		ПроверяемаяДата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ПроверяемаяДата < Дата('20140101') Тогда
		Объект.КодОКАТО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "КодОКАТО");
	Иначе
		Объект.КодОКАТО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Организация, "КодОКТМО");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчет(РеквизитыЛС)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыЛС, "Владелец");
	
КонецФункции

&НаСервере
Процедура РассчитатьИтог()
	
	ИтогВсего = Объект.Услуги.Итог("Всего")
		+ Объект.Материалы.Итог("Всего")
		+ Объект.ОсновныеСредства.Итог("Всего")
		+ Объект.ВозвратнаяТара.Итог("Сумма");
	ИтогНДС   = Объект.Услуги.Итог("СуммаНДС")
		+ Объект.Материалы.Итог("СуммаНДС")
		+ Объект.ОсновныеСредства.Итог("СуммаНДС");
		
КонецПроцедуры

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	
	Массив = Новый Массив;
	Массив.Добавить("Материалы");
	Массив.Добавить("Услуги");
	Массив.Добавить("ОсновныеСредства");
	Для Каждого ЭлементМассива Из Массив Цикл
		Для Каждого СтрокаТЧ из Объект[ЭлементМассива] Цикл
			РассчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма",,,Объект.ПрименяетсяФорматЗначенийФНС);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(ТекНоменклатура)
	
	ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура, "СтавкаНДС, Наименование, НаименованиеПолное");

	Результат = Новый Структура;
	Если ЗначениеЗаполнено(ДанныеНоменклатуры.НаименованиеПолное) Тогда
		Результат.Вставить("СодержаниеУслуги", ДанныеНоменклатуры.НаименованиеПолное);
	Иначе
		Результат.Вставить("СодержаниеУслуги", ДанныеНоменклатуры.Наименование);
	КонецЕсли;
	Результат.Вставить("СтавкаНДС", ДанныеНоменклатуры.СтавкаНДС);
		
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита, ЕстьСтавкаНДС = Истина, РассчитыватьЦену = Ложь, ПрименяетсяФорматЗначенийФНС = Ложь)
	
	Если ЕстьСтавкаНДС Тогда
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", РассчитыватьЦену);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
		Если НЕ ПрименяетсяФорматЗначенийФНС Тогда
			СтрокаТЧ.Цена = Окр(СтрокаТЧ.Цена, 2);
		КонецЕсли;	
	Иначе
		Если (ИмяРеквизита = "Цена" ИЛИ ИмяРеквизита = "Количество")  Тогда
			СтруктураПараметров = Новый Структура("Цена, Количество", СтрокаТЧ.Цена, СтрокаТЧ.Количество);
			СтрокаТЧ.Сумма = УправлениеНФАКлиентСервер.РассчитатьСуммуТабЧасти(СтруктураПараметров);
		ИначеЕсли ИмяРеквизита = "Сумма" Тогда
			СтруктураПараметров = Новый Структура("Количество, Сумма", СтрокаТЧ.Количество, СтрокаТЧ.Сумма);
			СтрокаТЧ.Цена    = УправлениеНФАКлиентСервер.РасчитатьЦенуПриИзмененииСуммыТабЧасти(СтруктураПараметров, 1);
		КонецЕсли;
		Если НЕ ПрименяетсяФорматЗначенийФНС Тогда
			СтрокаТЧ.Цена = Окр(СтрокаТЧ.Цена, 2);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьМассивКФО()
	
	Результат = Новый Массив;
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Бюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС"));
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ДополнитьСтруктуруПодбора(ДополнительныйПараметр)
	
	ПараметрыПодбора = Новый Структура;
	ИмяТЧ = ДополнительныйПараметр;
	
	ПараметрыПодбора.Вставить("КФО",Объект.КФО);
	
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",Истина);
	
	ТипыНоменклатуры = Новый СписокЗначений;
	Если ИмяТЧ = "Материалы" Тогда
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
		ПараметрыПодбора.Вставить("РазрешитьПодборПоСправочнику",Истина);
	ИначеЕсли ИмяТЧ = "ВозвратнаяТара" Тогда
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Тара"));
	ИначеЕсли ИмяТЧ = "Услуги" Тогда
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Услуга"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.УслугиАренды"));
		ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга"));
		ПараметрыПодбора.Вставить("ПоказыватьОстатки",Ложь);
		ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",Ложь);
		ПараметрыПодбора.Вставить("ВыводитьНулевуюНоменклатуру",Истина);
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("Валюта",Объект.ВалютаДокумента);
	ПараметрыПодбора.Вставить("ЕстьЦена",Истина);
	ПараметрыПодбора.Вставить("ИмяТаблицы",ИмяТЧ);
	ПараметрыПодбора.Вставить("ПоказыватьЦены",Истина);
	ПараметрыПодбора.Вставить("ТипЦен",Объект.ТипЦены);
	
	Возврат ПараметрыПодбора; 
	
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение,ИмяТЧ)
	
	СписокПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	ЕстьНДС = ИмяТЧ <> "ВозвратнаяТара";
	ЕстьСодержание = ИмяТЧ = "Услуги";

	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		НоваяСтрока = Объект[ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭлементПодбора);
		
		Если ЕстьСодержание Тогда
			НоваяСтрока["Содержание"] = ?(ЗначениеЗаполнено(ЭлементПодбора.Номенклатура.НаименованиеПолное), ЭлементПодбора.Номенклатура.НаименованиеПолное, ЭлементПодбора.Номенклатура.Наименование);
 	    КонецЕсли;
		
		Если Объект.ИспользоватьСкидкиНаценки Тогда
			Если ИмяТЧ = "Услуги" Тогда
				НомерТабличнойЧасти = 1;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Услуги, НоваяСтрока, "КлючСвязи");
			ИначеЕсли ИмяТЧ = "Материалы" Тогда
				НомерТабличнойЧасти = 2;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Материалы, НоваяСтрока, "КлючСвязи");
			ИначеЕсли ИмяТЧ = "ОсновныеСредства" Тогда
				НомерТабличнойЧасти = 3;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.ОсновныеСредства, НоваяСтрока, "КлючСвязи");
			КонецЕсли;	
				
			НоваяСтрока.ЦенаБезСкидок = НоваяСтрока.Цена;
			
			Скидка = РассчитатьСкидку(НомерТабличнойЧасти, НоваяСтрока.КлючСвязи, НоваяСтрока.Номенклатура, НоваяСтрока.ЦенаБезСкидок);
			НоваяСтрока.Скидка = Скидка;
			НоваяСтрока.Цена = НоваяСтрока.ЦенаБезСкидок - Скидка;
			РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Цена",,,Объект.ПрименяетсяФорматЗначенийФНС);
		КонецЕсли;	
		
		РассчитатьСтроку(НоваяСтрока,Объект.СуммаВключаетНДС,"Количество",ЕстьНДС,,Объект.ПрименяетсяФорматЗначенийФНС);
	КонецЦикла;
	
	РассчитатьИтог();
	
КонецПроцедуры

