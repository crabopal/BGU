&НаСервере
Процедура ЗаполнитьРассчитатьПредоплатуНаСервере()
	
	ТаблицаТоваров = Документы.СчетНаОплату.ПолучитьСписокТоваровУслуг(Объект.Ссылка);
	Объект.Предоплата.Загрузить(ТаблицаТоваров);
	Для Каждого СтрокаПредоплата Из Объект.Предоплата Цикл 
		СтрокаПредоплата.ПроцентПредоплаты 	= Объект.ПроцентПредоплаты;
		СтрокаПредоплата.СуммаПредоплаты 	= СтрокаПредоплата.Всего/100*СтрокаПредоплата.ПроцентПредоплаты;
		СтавкаНДС 							= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтрокаПредоплата.СтавкаНДС);
		СтрокаПредоплата.СуммаНДС 			= СтрокаПредоплата.СуммаПредоплаты * СтавкаНДС / (100 + СтавкаНДС);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРассчитатьПредоплату(Команда)
	
	Если Параметры.Ключ.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Перед заполнением списка необходимо записать документ.'");
		Сообщение.Сообщить();
	Иначе	
		ЗаполнитьРассчитатьПредоплатуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредоплатаПроцентПредоплатыПриИзменении(Элемент)
	
	ТекущиеДанные 					= Элементы.Предоплата.ТекущиеДанные;
	ТекущиеДанные.СуммаПредоплаты 	= ТекущиеДанные.Всего/100*ТекущиеДанные.ПроцентПредоплаты;
	СтавкаНДС 						= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС);
	ТекущиеДанные.СуммаНДС 			= ТекущиеДанные.СуммаПредоплаты * СтавкаНДС / (100 + СтавкаНДС);

КонецПроцедуры

&НаКлиенте
Процедура ПредоплатаСуммаПредоплатыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Предоплата.ТекущиеДанные;
	Если ТекущиеДанные.СуммаПредоплаты > ТекущиеДанные.Всего Тогда 
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Сумма предоплаты больше суммы Всего!'");
		Сообщение.Сообщить();
		ТекущиеДанные.СуммаПредоплаты = ТекущиеДанные.Всего;
	Иначе 	
		ТекущиеДанные.ПроцентПредоплаты = ТекущиеДанные.СуммаПредоплаты*100/ТекущиеДанные.Всего;
		СтавкаНДС 						= УчетНДСКлиентСервер.ЗначениеСтавкиНДС(ТекущиеДанные.СтавкаНДС);
		ТекущиеДанные.СуммаНДС 			= ТекущиеДанные.СуммаПредоплаты * СтавкаНДС / (100 + СтавкаНДС);
	КонецЕсли;

КонецПроцедуры

