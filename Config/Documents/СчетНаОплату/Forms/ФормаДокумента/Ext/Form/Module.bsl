	РассчитатьСтроку(Элементы.Материалы.ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДС",,,Объект.ПрименяетсяФорматЗначенийФНС);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыНоменклатураПриИзменении(Элемент)
	ТекДанные = Элементы.Материалы.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.Номенклатура) Тогда
		ПриИзмененииНоменклатуры(ТекДанные.Номенклатура,ТекДанные.ПолучитьИдентификатор(),"Материалы");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЗаполнитьСтрокуТЧприПодборе("Материалы", ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыСкидокПриАктивизацииНоменклатурыМатериалов", 0.1, Истина);
	Иначе	
		Элементы.СкидкиНаценкиМатериала.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("НомерТабличнойЧасти, КлючСвязи", 0, 0));
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПередУдалением(Элемент, Отказ)
	НомерТабличнойЧасти = 2;
	ПараметрыОтбора = Новый Структура("НомерТабличнойЧасти, КлючСвязи", НомерТабличнойЧасти, Элемент.ТекущиеДанные.КлючСвязи); 	
	МассивКУдалению = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого СтрокаКУдалению Из МассивКУдалению Цикл
		Объект.СкидкиНаценки.Удалить(СтрокаКУдалению);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура МатериалыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.Материалы.ТекущиеДанные;
	Если НоваяСтрока ИЛИ Копирование Тогда
		ТекущиеДанные.КлючСвязи = 0;
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязиСкидки(Объект.Материалы, ТекущиеДанные, "КлючСвязи");
	КонецЕсли;	
КонецПроцедуры

