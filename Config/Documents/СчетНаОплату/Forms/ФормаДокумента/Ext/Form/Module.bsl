		Элементы.ОсновныеСредства.ТекущиеДанные.Количество = 1;
		Элементы.ОсновныеСредства.ТекущиеДанные.СтавкаНДС  = УчетНДСКлиентСервер.ПолучитьОсновнуюСтавку(Объект.Дата);
