&НаСервере
Процедура ЗаполнитьДатуПерегистрации()
	
	НоваяДата = Объект.ФинансовыйГод + 1;
	
	Если Объект.ПеререгистрироватьБюджетныеДанные 
		И НЕ Год(НоваяДата) = Год(Объект.ДатаПерегистрации) Тогда
		
		ОсновнойКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
		
		Если НЕ ОсновнойКалендарь = Неопределено Тогда
			НачальныеДаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НоваяДата);
			БлижайшиеДаты = КалендарныеГрафики.БлижайшиеРабочиеДаты(ОсновнойКалендарь, НачальныеДаты);
			РабочаяДата = БлижайшиеДаты.Получить(НоваяДата);
			Если НЕ РабочаяДата = Неопределено Тогда
				НоваяДата = РабочаяДата;
			КонецЕсли;	
		КонецЕсли;	
			
		Объект.ДатаПерегистрации = НоваяДата;
		
	КонецЕсли;	
	
КонецПроцедуры

