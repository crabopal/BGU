Процедура ЗаменаКПС(Команда)
	
	ПараметрыЗамены = Новый Структура("Объект", Объект);
	
	ОткрытьФорму("Документ.ЗакрытиеСчетовСанкционирования.Форма.ЗаменаКПС", ПараметрыЗамены, ЭтотОбъект,,,, Новый ОписаниеОповещения("ПослеВыбораЗаменыКПС", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте 
Процедура ПослеВыбораЗаменыКПС(ДопПараметры, Контекст) Экспорт
	
	Если ТипЗнч(ДопПараметры) = Тип("Соответствие") Тогда
		
		Для Каждого Стр Из Объект.Перерегистрация Цикл
			Если НЕ ДопПараметры[Стр.КПСДт] = Неопределено Тогда
				Стр.КПСДт = ДопПараметры[Стр.КПСДт];
			КонецЕсли;	
			Если НЕ ДопПараметры[Стр.КПСКт] = Неопределено Тогда
				Стр.КПСКт = ДопПараметры[Стр.КПСКт];
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры	

