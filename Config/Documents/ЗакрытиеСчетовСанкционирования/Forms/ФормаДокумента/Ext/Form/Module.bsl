&НаСервере
Процедура ЗаполнитьОстатки()
	
    ЗаблокироватьДанныеФормыДляРедактирования();
	
	МаксКоличествоСубконто = 0;
	УчетПоПодразделениям = Ложь;
	СчетаДляЗапроса = Документы.ЗакрытиеСчетовСанкционирования.СчетаТекущегоГода(Объект.ОбрабатыватьСчетаПлановыхПериодов, Объект.ФинансовыйГод);
	СчетаТекущегоГода = БухгалтерскийУчет.ПолучитьСвойстваСчетов(СчетаДляЗапроса,
																 Ложь, 
																 "УчетПоПодразделениям, КоличествоСубконто, Валютный, Количественный");
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("КонецПериода", 		Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(Объект.ФинансовыйГод), 4), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 		Объект.Организация);
	Запрос.УстановитьПараметр("СчетаТекущегоГода",	СчетаДляЗапроса);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК ОстатокДебет,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаДт,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК ОстатокКредит,
	|	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаКт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт КАК КоличествоОстатокКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&КонецПериода, Счет В (&СчетаТекущегоГода), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИФО,
	|	Подразделение,
	|	КФО,
	|	Счет,
	|	КПС,
	|	КЭК,
	|	Валюта
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Объект.ТаблицаОстатков.Загрузить(Запрос.Выполнить().Выгрузить());
	ЗаполнитьКоличествоСубконто("ТаблицаОстатков");
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидМежотчетногоПериода) Тогда
		Объект.ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ТехнологическиеОперации");
	КонецЕсли;	
	
КонецПроцедуры // ЗаполнитьОстатки()

&НаСервере
Процедура ЗаполнитьОборотыДляПерегистрации()
	
	Если НЕ ПроверитьВозможностьПеререгистрации(ТекстФинансовыйГод, Объект.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	МаксКоличествоСубконто = 0;
	УчетПоПодразделениям = Ложь;
	СчетаДляЗапроса = Документы.ЗакрытиеСчетовСанкционирования.СчетаПлановогоПериода(Объект.ФинансовыйГод);
	СчетаПерегистраци = Документы.ЗакрытиеСчетовСанкционирования.СчетаПерегистраци(Объект.ФинансовыйГод);
	
	СоответствиеСчетов = Документы.ЗакрытиеСчетовСанкционирования.СоответствиеСчетов(СчетаДляЗапроса, СчетаПерегистраци);
	
	СчетаТекущегоГода = БухгалтерскийУчет.ПолучитьСвойстваСчетов(СчетаПерегистраци,
	Ложь, 
	"УчетПоПодразделениям, КоличествоСубконто, Валютный, Количественный, Субконто");
	
	СчетаПереноса = БухгалтерскийУчет.ПолучитьСвойстваСчетов(СчетаДляЗапроса,
	Ложь, 
	"УчетПоПодразделениям, КоличествоСубконто, Валютный, Количественный, Субконто");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоПериода",      НачалоДня(НачалоГода(Объект.ФинансовыйГод)));
	Запрос.УстановитьПараметр("КонецПериода", 		КонецДня(КонецГода(Объект.ФинансовыйГод)));
	Запрос.УстановитьПараметр("Организация", 		Объект.Организация);
	Запрос.УстановитьПараметр("СчетаТекущегоГода",	СчетаДляЗапроса);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт КАК ВалютаДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт КАК ВалютаКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт) КАК ВалютнаяСуммаДт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт) КАК ВалютнаяСуммаКт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт) КАК КоличествоДт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК КоличествоКт,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			СчетДт В (&СчетаТекущегоГода)
	|				И СчетКт В (&СчетаТекущегоГода)
	|				И Организация = &Организация
	|				И Активность,
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт";
	
	Объект.Перерегистрация.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//Замена счетов
	
	Для Каждого Стр Из Объект.Перерегистрация Цикл
		
		НовыйСчетДт 	= СоответствиеСчетов.Получить(Стр.СчетДт); 
		НовыеСвойстваДт = СчетаТекущегоГода.Получить(НовыйСчетДт);
		СтарыеСвойстваДт = СчетаПереноса.Получить(Стр.СчетДт);
		
		НовыйСчетКт 	= СоответствиеСчетов.Получить(Стр.СчетКт); 
		НовыеСвойстваКт = СчетаТекущегоГода.Получить(НовыйСчетКт);
		СтарыеСвойстваКт = СчетаПереноса.Получить(Стр.СчетКт);
		
		Для инд = 1 По 3 Цикл
			
			Если НЕ НовыеСвойстваДт["ВидСубконто" + Строка(инд)] = СтарыеСвойстваДт ["ВидСубконто" + Строка(инд)] Тогда
				Стр["СубконтоДт" + Строка(инд)] = Неопределено;
			КонецЕсли;
			
			Если НЕ НовыеСвойстваКт["ВидСубконто" + Строка(инд)] = СтарыеСвойстваКт ["ВидСубконто" + Строка(инд)] Тогда
				Стр["СубконтоКт" + Строка(инд)] = Неопределено;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ НовыеСвойстваДт.УчетПоПодразделениям Тогда
			Стр.ПодразделениеДт = Неопределено;
		КонецЕсли;
		
		Если НЕ НовыеСвойстваКт.УчетПоПодразделениям Тогда
			Стр.ПодразделениеКт = Неопределено;
		КонецЕсли;
		
		Если НЕ НовыеСвойстваДт.Валютный Тогда
			Стр.ВалютаДт = Неопределено;
			Стр.ВалютнаяСуммаДт = 0;
		КонецЕсли;
		
		Если НЕ НовыеСвойстваКт.Валютный Тогда
			Стр.ВалютаКт = Неопределено;
			Стр.ВалютнаяСуммаКт = 0;
		КонецЕсли;
		
		Если НЕ НовыеСвойстваДт.Количественный Тогда
			Стр.КоличествоДт = 0;
		КонецЕсли;
		
		Если НЕ НовыеСвойстваКт.Количественный Тогда
			Стр.КоличествоКт = 0;
		КонецЕсли;
		
		Стр.СчетДт = НовыйСчетДт; 
		Стр.СчетКт = НовыйСчетКт; 
		
	КонецЦикла;
	
	ЗаполнитьКоличествоСубконто("Перерегистрация", "СчетДт");
	
	// Замена КПС по данным регистра "СоответствиеКПСПриПереносеОстатков"
	РегистрыСведений.СоответствиеКПСПриПереносеОстатков.ЗаменитьКПСвТаблицахСУчетомПереносаОстатковПоКПС(
		КонецГода(Объект.ФинансовыйГод) + 1, Объект.Перерегистрация, "КПСДт,КПСКт");
	
КонецПроцедуры // ЗаполнитьОборотыДляПерегистрации()

&НаСервере
Процедура ЗаполнитьОбороты()
	
	// Если перезаполняем форму - делаем это уже по новым правилам
	Объект.СчетаСанкционирования.Очистить();
	НастроитьФорму();
	ЗаполнитьОстатки();
	Возврат;

КонецПроцедуры // ЗаполнитьОбороты()

&НаСервере
Процедура ЗаполнитьКоличествоСубконто(ИмяТаблицы = "СчетаСанкционирования", ИмяСчДт = "Счет")
	
	Количественный = Ложь;
	Валютный = Ложь;
	
	Для каждого ТекСтрока Из Объект[ИмяТаблицы] Цикл
		
		СвойстваСчета = СчетаТекущегоГода.Получить(ТекСтрока[ИмяСчДт]);
		
		Если СвойстваСчета <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(ТекСтрока, СвойстваСчета);
			
			Количественный = Количественный ИЛИ СвойстваСчета.Количественный;
			Валютный = Валютный ИЛИ СвойстваСчета.Валютный;      
			
		КонецЕсли;
		
		Если ИмяТаблицы = "СчетаСанкционирования" ИЛИ ИмяТаблицы = "Перерегистрация" Тогда
			
			СвойстваСчета = СчетаТекущегоГода.Получить(ТекСтрока.СчетКт);
			
			Если СвойстваСчета <> Неопределено Тогда
				
				ТекСтрока.УчетПоПодразделениямКт = СвойстваСчета.УчетПоПодразделениям;
				ТекСтрока.КоличествоСубконтоКт =  СвойстваСчета.КоличествоСубконто;
				
				Количественный = Количественный ИЛИ СвойстваСчета.Количественный;
				Валютный = Валютный ИЛИ СвойстваСчета.Валютный; 
				
			КонецЕсли;
		КонецЕсли;

	КонецЦикла; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "Валюта", "Видимость", Валютный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "ВалютаДт", "Видимость", Валютный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "ВалютнаяСуммаДт", "Видимость", Валютный);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "ВалютаКт", "Видимость", Валютный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "ВалютнаяСуммаКт", "Видимость", Валютный);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "КоличествоДт", "Видимость", Количественный);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, ИмяТаблицы + "КоличествоКт", "Видимость", Количественный);
	
КонецПроцедуры // ЗаполнитьКоличествоСубконто()

&НаСервере
Процедура НастроитьФорму() 
	
	ЗакрытиеОборотов = Объект.СчетаСанкционирования.Количество() > 0;
	
	ТолькоПросмотр = Объект.Проведен;
	
	Если НЕ ДатыЗапретаИзменения.ИзменениеЗапрещено("Документ.ЗакрытиеСчетовСанкционирования", Объект.Ссылка)
		И ПравоДоступа("ОтменаПроведения", Метаданные.Документы.ЗакрытиеСчетовСанкционирования) Тогда
		Элементы.ФормаКнопкаОтменитьПроведение.Видимость = Истина;
	КонецЕсли;	
	
	МассивСчет = Новый Массив;
	Если ЗакрытиеОборотов Тогда
		МассивСчет 	= Объект.СчетаСанкционирования.Выгрузить(,"Счет").ВыгрузитьКолонку("Счет");
		МассивСчетКт = Объект.СчетаСанкционирования.Выгрузить(,"СчетКт").ВыгрузитьКолонку("СчетКт");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчет, МассивСчетКт, Истина);
	Иначе
		Если Объект.ТаблицаОстатков.Количество() > 0 тогда 
			МассивСчет 	= Объект.ТаблицаОстатков.Выгрузить(,"Счет").ВыгрузитьКолонку("Счет");
		Иначе
			МассивСчет 	= Объект.Перерегистрация.Выгрузить(,"СчетДт").ВыгрузитьКолонку("СчетДт");
			МассивСчетКт = Объект.Перерегистрация.Выгрузить(,"СчетКт").ВыгрузитьКолонку("СчетКт");
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчет, МассивСчетКт, Истина);
		КонецЕсли;
	КонецЕсли;
	
	СчетаТекущегоГода = БухгалтерскийУчет.ПолучитьСвойстваСчетов(ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСчет),
																 Ложь, 
																 "УчетПоПодразделениям, КоличествоСубконто, Валютный, Количественный");
	ЗаполнитьКоличествоСубконто();
	ЗаполнитьКоличествоСубконто("ТаблицаОстатков");
	ЗаполнитьКоличествоСубконто("Перерегистрация", "СчетДт");

	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если УчетПоПодразделениям Тогда
		
		УчетПоПодразделениям = Ложь;
		
		Если  ТипЗнч(СчетаТекущегоГода) = Тип("Соответствие") ИЛИ ТипЗнч(СчетаТекущегоГода) = Тип("ФиксированноеСоответствие") Тогда
			
			Для каждого ТекСчет Из СчетаТекущегоГода Цикл
				
				УчетПоПодразделениям = Макс(УчетПоПодразделениям, ТекСчет.Значение.УчетПоПодразделениям);	
				
			КонецЦикла; 
			
		КонецЕсли;
	КонецЕсли;

 	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетаСанкционированияПодразделение", "Видимость", УчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетаСанкционированияПодразделениеКт", "Видимость", УчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТаблицаОстатковПодразделение", "Видимость", УчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПеререгистрацияПодразделениеДт", "Видимость", УчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПеререгистрацияПодразделениеКт", "Видимость", УчетПоПодразделениям);

	
	Если ЗакрытиеОборотов Тогда
		Элементы.Обороты.Видимость = Истина;
		Элементы.Остатки.Видимость = Ложь;
	Иначе
		Элементы.Обороты.Видимость = Ложь;
		Элементы.Остатки.Видимость = Истина;
	КонецЕсли;
	
	Элементы.ПеререгистрироватьБюджетныеДанные.ТолькоПросмотр = Объект.ИзменениеТипаУчреждения;  
	Элементы.ОбрабатыватьСчетаПлановыхПериодов.ТолькоПросмотр = Объект.ИзменениеТипаУчреждения;
	Элементы.ПеререгистрацияДанных.ТолькоПросмотр = НЕ Объект.ПеререгистрироватьБюджетныеДанные ИЛИ Объект.ИзменениеТипаУчреждения;
	Элементы.ЗаполнитьПеререгистрацию.Доступность = Объект.ПеререгистрироватьБюджетныеДанные;
	Элементы.ПеререгистрироватьБюджетныеДанные.ТолькоПросмотр = НЕ Объект.ОбрабатыватьСчетаПлановыхПериодов ИЛИ Объект.ИзменениеТипаУчреждения;

	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПроверитьВозможностьПеререгистрации(ФинГод, ОбъектОрганизация)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПереносПоказателейПоСанкционированию.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПереносПоказателейПоСанкционированию КАК ПереносПоказателейПоСанкционированию
	|ГДЕ
	|	ГОД(ПереносПоказателейПоСанкционированию.ФинансовыйГод) = &ФинансовыйГод
	|	И ПереносПоказателейПоСанкционированию.Организация = &Организация
	|	И ПереносПоказателейПоСанкционированию.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("ФинансовыйГод",  ФинГод);
	Запрос.УстановитьПараметр("Организация",  ОбъектОрганизация);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции	

