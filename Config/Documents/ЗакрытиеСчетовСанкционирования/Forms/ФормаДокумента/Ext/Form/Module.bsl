&НаКлиенте
Процедура КомандаОтменитьПроведение(Команда)
	
	Если НЕ Объект.Проведен Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЗакрытиеОборотов Тогда
		Объект.СчетаСанкционирования.Очистить();
	КонецЕсли;	
	
	ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
	ПараметрыЗаписи.Вставить("ИсходныйРежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения);
	Записать(ПараметрыЗаписи);

КонецПроцедуры

