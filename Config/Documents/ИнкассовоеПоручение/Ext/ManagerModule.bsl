#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЗначенияРеквизитовИнкассовоеПоручение(Ссылка)
	
	СтруктураДанных = Новый Структура;

	// Значения реквизитов Платежного поручения 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
	|	Поручение.Номер 																		КАК НомерДок,
	|	Поручение.Дата 																			КАК ДатаДок,
	|	Поручение.ВидПлатежа 																	КАК ВидПлатежа,
	|	Поручение.СтатусСоставителя 															КАК СтатусСоставителя,
	|	Поручение.ИННПолучателя																КАК ИноеИННПолучателя,
	|	Поручение.КПППолучателя																КАК ИноеКПППолучателя,
	|	""ИНН "" + Поручение.ИННПолучателя													КАК ИННПолучателя,
	|	""КПП "" + Поручение.КПППолучателя													КАК КПППолучателя,
	|	Поручение.СуммаДокумента 																КАК СуммаДокумента,
	|	Поручение.ПолучательНаименование 														КАК ТекстПолучателя,
	|	Поручение.ПолучательБанковскийСчет 													КАК НомерСчетаПолучателя,
	|	Поручение.ПолучательНаименованиеБанка 													КАК НаименованиеБанкаПолучателя,
	|	Поручение.ПолучательБИКБанка 															КАК БИКБанкаПолучателя,
	|	Поручение.ПолучательКорСчетБанка 														КАК СчетБанкаПолучателя,
	|	Поручение.КонтрагентНаименованиеБанка 													КАК НаименованиеБанкаПлательщика,
	|	Поручение.КонтрагентБИКБанка 															КАК БИКБанкаПлательщика,
	|	Поручение.КонтрагентКорСчетБанка 														КАК СчетБанкаПлательщика,
	|	Поручение.КонтрагентИНН																КАК КонтрагентИНН,
	|	Поручение.КонтрагентКПП																КАК КонтрагентКПП,
	|	""ИНН "" + Поручение.КонтрагентИНН														КАК ИННПлательщика,
	|	""КПП "" + Поручение.КонтрагентКПП														КАК КПППлательщика,
	|	Поручение.КонтрагентНаименование 														КАК ТекстПлательщика,
	|	Поручение.КонтрагентБанковскийСчет 													КАК НомерСчетаПлательщика,
	|	Поручение.СрокПлатежа																	КАК СрокПлатежа,
	|	Поручение.ОчередностьПлатежа 															КАК Очередность,
	|	Поручение.КодБКНалога 																	КАК КодБК,
	|	Поручение.КодОКАТО 																	КАК КодОКАТО,
	|	Поручение.ПоказательОснования 															КАК ПоказательОснования,
	|	Поручение.ПоказательПериода 															КАК ПоказательПериода,
	|	Поручение.ПоказательНомера 															КАК ПоказательНомера,
	|	Поручение.ПоказательДаты 																КАК ПоказательДаты,
	|	Поручение.ПоказательТипа 																КАК ПоказательТипа,
	|	Поручение.НазначениеПлатежа 															КАК НазначениеПлатежа,
	|//////// Служебные реквизиты
	|	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.МесяцПрописью, ЛОЖЬ) 	КАК МесяцПрописью,
	|	ЕСТЬNULL(Поручение.РеквизитыЛицевогоСчета.СуммаБезКопеек, ЛОЖЬ) 	КАК СуммаБезКопеек,
	|	Поручение.ЛицевойСчет 												КАК ЛицевойСчет,
	|	Поручение.РеквизитыЛицевогоСчета 									КАК РеквизитыЛицевогоСчета,
	|	Поручение.Организация 												КАК Организация,
	|	Поручение.СчетКонтрагента 											КАК СчетКонтрагента
	|ИЗ
	|	Документ.ИнкассовоеПоручение КАК Поручение
	|ГДЕ
	|	Поручение.Ссылка = &Ссылка
	|";

	МассивРезультатов = Запрос.Выполнить();
	
	Выборка = МассивРезультатов.Выбрать();			   
	Выборка.Следующий();
	
	Для Каждого Колонка ИЗ МассивРезультатов.Колонки Цикл
		СтруктураДанных.Вставить(Колонка.Имя, Выборка[Колонка.Имя]);	
	КонецЦикла;

	// требует преобразования
	//СтруктураДанных.Вставить("НомерДок", ОбщегоНазначенияБГУ.ПолучитьНомерНаПечать(Новый Структура("Номер, Учреждение", СтруктураДанных.НомерДок, СтруктураДанных.Учреждение)));
	СтруктураДанных.Вставить("ДатаДокумента", 	Формат(СтруктураДанных.ДатаДок, "ДФ=" + ?(СтруктураДанных.МесяцПрописью, "'дд ММММ гггг'", "'дд.ММ.гггг'")));
	СтруктураДанных.Вставить("СуммаЧислом",		ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(СтруктураДанных.СуммаДокумента, СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.Вставить("СуммаПрописью",	ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(СтруктураДанных.СуммаДокумента, , СтруктураДанных.СуммаБезКопеек));
	СтруктураДанных.Вставить("НаименованиеНомер","ИНКАССОВОЕ ПОРУЧЕНИЕ № " + ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Ссылка,СтруктураДанных.НомерДок)); 
    	
	
	Возврат СтруктураДанных;
		
КонецФункции	

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати = "Документ.ИнкассовоеПоручение";
	КомандаПечати.Идентификатор = "ИнкассовоеПоручение";
	КомандаПечати.Представление = НСтр("ru = 'Инкассовое поручение (ф. 0401071)'");
	КомандаПечати.Порядок		= 1;
			
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Устанавливаем признак доступности печати покомплектно.
	//ПараметрыВывода.ДоступнаПечатьПоКомплектно = Истина;

	// Проверяем, нужно ли для макета ЗаявкаНаКассовыйРасход0531801 формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнкассовоеПоручение") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ИнкассовоеПоручение",
			"Инкассовое поручение",
			Печать0401071(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует табличный документ инкассовое поручение (ф 0401071)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0401071(МассивОбъектов, ОбъектыПечати)
	
	ТабДокумент 					= Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ИнкассовоеПоручение_ИнкассовоеПоручение";
	Макет 							= УправлениеПечатью.МакетПечатнойФормы("Документ.ИнкассовоеПоручение.ПФ_MXL_ИнкассовоеПоручение");
	Обл   							= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
	
	Для НомерДокумента = 0 по МассивОбъектов.Количество()-1 цикл
	
		Обл.Параметры.Заполнить(ЗначенияРеквизитовИнкассовоеПоручение(МассивОбъектов[НомерДокумента]));
		
		ТабДокумент.Вывести(Обл);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 
			                                               НомерДокумента+1, ОбъектыПечати, МассивОбъектов[НомерДокумента]);
	КонецЦикла;	
	
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли
