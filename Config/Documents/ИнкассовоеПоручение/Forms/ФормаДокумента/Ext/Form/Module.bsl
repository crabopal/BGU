&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежа(Команда)
	
	СписокШаблонов = СписокШаблонов();
	
	Если СписокШаблонов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не найдено ни одного подходящего шаблона заполнения.'"));
	ИначеЕсли СписокШаблонов.Количество() = 1 Тогда
		ЗаполнитьНазначениеПлатежаНаКлиенте(СписокШаблонов[0], "");
	Иначе
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьНазначениеПлатежаНаКлиенте", ЭтотОбъект);
		СписокШаблонов.ПоказатьВыборЭлемента(Оповещение, "Выберите шаблон", СписокШаблонов[0]);
	КонецЕсли;

КонецПроцедуры

