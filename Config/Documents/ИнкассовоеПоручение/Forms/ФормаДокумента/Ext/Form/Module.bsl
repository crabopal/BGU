	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьДоговора()

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

	Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовКонтрагента()
 
&НаСервереБезКонтекста
Функция ПересчитатьСуммуНДС(СуммаДокумента, СтавкаНДС)

	ПроцентНДС = УчетНДСПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
	СуммаНДС   = Окр(СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);

	Возврат СуммаНДС;

КонецФункции

&НаСервере
Функция СписокШаблонов()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	СписокШаблонов = Справочники.ШаблоныЗаполненияПП.ПолучитьСписокШаблонов(ДокОбъект);
	
	Возврат СписокШаблонов;
КонецФункции

&НаСервере
Процедура НазначениеПлатежа(ВыбранныйШаблон)
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Шаблон = ВыбранныйШаблон.ПолучитьОбъект();
	Объект.НазначениеПлатежа = Шаблон.СформироватьНазначениеПлатежа(ДокОбъект);
КонецПроцедуры

