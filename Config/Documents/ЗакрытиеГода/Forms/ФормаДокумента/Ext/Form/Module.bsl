&НаКлиенте
Процедура ЗакрываемыеСчетаСчет40130НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ЗакрываемыеСчета.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			ТекущиеДанные.Счет40130, 
																			ТекущиеДанные.КПС40130, 
																			ТекущиеДанные.КФО), 
															Объект.Организация,
															ТекущиеДанные.ИФО,
															ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("401.30"),
															ТекущиеДанные.КФО,
															,
															Объект.Дата);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрываемыеСчетаСчет40130ОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ЗакрываемыеСчета.ТекущиеДанные;
	
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.Счет);
	Если СвойстваСчета.Вид = ПредопределенноеЗначение("ВидСчета.Пассивный") Тогда
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
																ТекущиеДанные.КПС40130,
																,
																,
																ТекущиеДанные.КЭК40130);
	Иначе
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(	ВыбранноеЗначение, 
																ТекущиеДанные.КПС40130,
																,
																ТекущиеДанные.КЭК40130,
																);
	КонецЕсли;		
															
КонецПроцедуры

