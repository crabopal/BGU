	|			ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|		ИЗ
	|			ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ГДЕ
	|			ЕПСБУВидыСубконто.НомерСтроки = 2) КАК ФРВидСубконто2
	|		ПО (&СчетФинРезультата = ФРВидСубконто2.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто,
	|			ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|		ИЗ
	|			ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ГДЕ
	|			ЕПСБУВидыСубконто.НомерСтроки = 3) КАК ФРВидСубконто3
	|		ПО (&СчетФинРезультата = ФРВидСубконто3.Ссылка)
	|ГДЕ
	|	(НЕ ОстаткиДтКт.ОстатокДебет = 0
	|			ИЛИ НЕ ОстаткиДтКт.ОстатокКредит = 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОстаткиДтКт.Счет.Порядок,
	|	ИФО,
	|	КФО,
	|	КПС,
	|	Субконто1,
	|	Субконто2,
	|	Субконто3
	|АВТОУПОРЯДОЧИВАНИЕ";
				   
	Запрос.УстановитьПараметр("Период", 				Новый Граница(Объект.ФинансовыйГод, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НачГода",            	Новый Граница(НачалоГода(Объект.ФинансовыйГод), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 			Объект.Организация);
	Запрос.УстановитьПараметр("СчетаЗакрытия",			СчетаЗакрытия);
	Запрос.УстановитьПараметр("Счета30404",				Счета30404);
	Запрос.УстановитьПараметр("Счета30406",				Счета30406);
	Запрос.УстановитьПараметр("СчетФинРезультата",		СчетФинРезультата);
	Запрос.УстановитьПараметр("Счета30404Развернуто",	ИСТИНА);
    Запрос.УстановитьПараметр("Счета40110",				Счета40110); 
	Запрос.УстановитьПараметр("Счета40120",				Счета40120);
	
	Если Год(Объект.ФинансовыйГод) < 2022 Тогда
		Запрос.УстановитьПараметр("Счета40110Развернуто",	ЛОЖЬ);
		Запрос.УстановитьПараметр("Счета40120Развернуто",	ЛОЖЬ);
	Иначе
		Запрос.УстановитьПараметр("Счета40110Развернуто",	ИСТИНА);
		Запрос.УстановитьПараметр("Счета40120Развернуто",	ИСТИНА);
	КонецЕсли;

	Объект.ЗавершениеСчетов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Для Каждого Стр Из Объект.ЗавершениеСчетов Цикл
		
		Стр.КПС40130  = БухгалтерскиеОперацииПовтИсп.КПССчета(Объект.Организация, Стр.ИФО, Стр.КФО, Объект.ФинансовыйГод, Стр.СчетФР);
		 		
	КонецЦикла;	
	
	Объект.ВидМежотчетногоПериода = ПредопределенноеЗначение("Перечисление.ВидыМежотчетногоПериода.ЗаключениеСчетов");
		
	Модифицированность = Истина;
	
КонецПроцедуры	


