&НаКлиенте
Процедура ЗакрываемыеСчетаКЭК40130НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ЗакрываемыеСчета.ТекущиеДанные;
	
	СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные.Счет);
	ДК = ?(СвойстваСчета.Вид = ПредопределенноеЗначение("ВидСчета.Пассивный"), "Кт", "Дт");
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, 
								СтандартнаяОбработка,
								ТекущиеДанные.КЭК40130,
								Объект.Организация, 
								ТекущиеДанные.ИФО,
								ТекущиеДанные.КФО, 
                                ТекущиеДанные.Счет40130,
								Объект.Дата,
								ДК);
