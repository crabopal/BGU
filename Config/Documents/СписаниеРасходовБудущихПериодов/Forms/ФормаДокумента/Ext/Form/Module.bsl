	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.СчетРасходов, РасходыБудущихПериодовПоляАналитикиСчетаРасходов());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтаФорма, ТекущиеДанные.СчетРасходов, РасходыБудущихПериодовПоляАналитикиСчетаРасходов());
	
	ТекущиеДанные.КЭКРасходовДоступность =
		( Счета10660.НайтиПоЗначению(ТекущиеДанные.СчетРасходов) <> Неопределено );
	ТекущиеДанные.КоличествоДоступность =
		( Счета10600.НайтиПоЗначению(ТекущиеДанные.СчетРасходов) <> Неопределено );
	
