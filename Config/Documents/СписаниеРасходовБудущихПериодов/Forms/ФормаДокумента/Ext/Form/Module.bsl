Процедура РасходыБудущихПериодовСписатьСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.РасходыБудущихПериодов.ТекущиеДанные;
	
	// Сумма к списанию изменена вручную, сбросим параметры авторасчета.
	ТекущиеДанные.КоэффициентЧислитель   = 0;
	ТекущиеДанные.КоэффициентЗнаменатель = 0;
	
	// Коэффициент списания определим по фактически указанной сумме списания.
	ТекущиеДанные.Коэффициент = ?(ТекущиеДанные.ОстатокСумма = 0, 0,
		ТекущиеДанные.СписатьСумма / ТекущиеДанные.ОстатокСумма);
	
	ЗаполнитьРасчетКоэффициентаСписания(ТекущиеДанные);
	
