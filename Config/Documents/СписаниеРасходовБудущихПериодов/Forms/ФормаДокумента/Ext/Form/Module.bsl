	Для Каждого СтрокаТаблицы Из Объект.РасходыБудущихПериодов Цикл
		
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетРБП, РасходыБудущихПериодовПоляАналитикиСчетаРБП());
		БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
			СтрокаТаблицы, СтрокаТаблицы.СчетРасходов, РасходыБудущихПериодовПоляАналитикиСчетаРасходов());
		
		СтрокаТаблицы.КЭКРасходовДоступность =
			( Счета10660.НайтиПоЗначению(СтрокаТаблицы.СчетРасходов) <> Неопределено );
		СтрокаТаблицы.КоличествоДоступность =
			( Счета10600.НайтиПоЗначению(СтрокаТаблицы.СчетРасходов) <> Неопределено );
		
	КонецЦикла;
	
