		"Объект.РасходыБудущихПериодов.СубконтоРасходов3");
	
	// Если подразделение расходов не указано явно, подразделение определяется из остатков по счету 401.50.
	ПоляАналитикиСчетаРасходов.Вставить("АвтоПодразделение", Истина);
	
	Возврат ПоляАналитикиСчетаРасходов;

