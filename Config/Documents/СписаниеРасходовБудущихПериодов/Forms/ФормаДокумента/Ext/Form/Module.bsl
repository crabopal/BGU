&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаИтоговБУ = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	ВалютаИтоговНУ = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	
	Счета10600.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("106.00"));
	Счета10660.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("106.60"));
	
	РасходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	РасходыБудущихПериодовНУЗаполнитьДобавленныеКолонки();
	РасходыБудущихПериодовНУОбновитьЗаголовкиСтрок();
	ЗаполнитьРасчетКоэффициентовСписания();
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// КЭК расходов для счетов 106.60.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасходыБудущихПериодовКЭКРасходов");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.РасходыБудущихПериодов.КЭКРасходовДоступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Количество для счетов 106.хх - только при отражении результатов инвентаризации.
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасходыБудущихПериодовСписатьКоличество");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасходыБудущихПериодовЗаголовокКоличество");
	ГруппаИли = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементУО.Отбор,, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИли,
		"Объект.ДокументОснование", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИли,
		"Объект.РасходыБудущихПериодов.КоличествоДоступность", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "РасходыБудущихПериодовЗаголовокКоличество");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ДокументОснование", ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.РасходыБудущихПериодов.КоличествоДоступность", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Кол.'"));
	
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление,
		РасходыБудущихПериодовПоляАналитикиСчетаРБП());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление,
		РасходыБудущихПериодовПоляАналитикиСчетаРасходов());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление,
		РасходыБудущихПериодовНУПоляАналитикиСчетаРБП());
	БухгалтерскийУчет.УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление,
		РасходыБудущихПериодовНУПоляАналитикиСчетаРасходов());
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма, Объект)
	
	ЭтоОтражениеРезультатовИнвентаризацииРБП = ЗначениеЗаполнено(Объект.ДокументОснование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ПредставлениеПериодаРегистрации", "Видимость", НЕ ЭтоОтражениеРезультатовИнвентаризацииРБП);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Дата", "Видимость", ЭтоОтражениеРезультатовИнвентаризацииРБП);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументОснование", "Видимость", ЭтоОтражениеРезультатовИнвентаризацииРБП);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СтраницаНалоговыйУчет", "Видимость", Форма.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Перем Ошибки;
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент(Ошибки);
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	РасходыБудущихПериодовЗаполнитьДобавленныеКолонки();
	РасходыБудущихПериодовНУЗаполнитьДобавленныеКолонки();
	РасходыБудущихПериодовНУОбновитьЗаголовкиСтрок();
	ЗаполнитьРасчетКоэффициентовСписания();
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРасчетКоэффициентовСписания()
	
	Для Каждого СтрокаТаблицы Из Объект.РасходыБудущихПериодов Цикл
		ЗаполнитьРасчетКоэффициентаСписания(СтрокаТаблицы);
	КонецЦикла;
	Для Каждого СтрокаТаблицы Из Объект.РасходыБудущихПериодовНУ Цикл
		ЗаполнитьРасчетКоэффициентаСписания(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьРасчетКоэффициентаСписания(СтрокаТаблицы)
	
	Если СтрокаТаблицы.КоэффициентЧислитель = 0
	   И СтрокаТаблицы.КоэффициентЗнаменатель = 0 Тогда
		Если СтрокаТаблицы.Коэффициент <> 0 Тогда
			СтрокаТаблицы.РасчетКоэффициентаСписания =
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),
					СтрокаТаблицы.Коэффициент);
		Иначе
			СтрокаТаблицы.РасчетКоэффициентаСписания = "";
		КонецЕсли;
	Иначе
		СтрокаТаблицы.РасчетКоэффициентаСписания =
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 / %2 = %3'"),
				СтрокаТаблицы.КоэффициентЧислитель,
				СтрокаТаблицы.КоэффициентЗнаменатель,
				СтрокаТаблицы.Коэффициент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, НомерСубконто,
		Счет, Субконто1, Субконто2, Субконто3)

	СтруктураСчета = Новый Структура;
	СтруктураСчета.Вставить("Счет", Счет);
	СтруктураСчета.Вставить("Субконто1", Субконто1);
	СтруктураСчета.Вставить("Субконто2", Субконто2);
	СтруктураСчета.Вставить("Субконто3", Субконто3);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
		ДанныеВыбора,
		СтандартнаяОбработка,
		Объект.Организация,
		СтруктураСчета,
		НомерСубконто);
	
КонецПроцедуры

