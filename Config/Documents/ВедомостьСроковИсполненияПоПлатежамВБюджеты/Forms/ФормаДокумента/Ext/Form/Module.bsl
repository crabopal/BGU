&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидНалогаИлиПлатежаДоИзменения", Объект.ВидНалогаИлиПлатежа);
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ПериодичностьДоИзменения", Объект.Периодичность);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НалогиРегистратор", "Видимость", Объект.Периодичность = 0);
	
	ФорматПоляПериод = Новый Соответствие;
	ФорматПоляПериод.Вставить(0,  "ДФ=дд.ММ.гггг;"); // Документ.
	ФорматПоляПериод.Вставить(9,  "ДФ=ММММ.гггг;"); // Месяц.
	ФорматПоляПериод.Вставить(10, "ДФ='к ""квартал"" гггг ""г.""'"); // Квартал.
	ФорматПоляПериод.Вставить(12, "ДФ='гггг ""г.""'"); // Год.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НалогиПериод", "Формат", ФорматПоляПериод[Объект.Периодичность]);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	Отказ = Документы.ВедомостьСроковИсполненияПоПлатежамВБюджеты.ЗаполнитьПоДаннымУчета(ДокументОбъект);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

