#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидНалогаИлиПлатежаПриИзменении(Элемент)
	
	ДопПараметры = Новый Структура;
	
	ЕстьДанныеВДокументе = (Объект.Налоги.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено, а табличная часть будет очищена. Продолжить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено. Продолжить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Табличная часть документа будет очищена. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВидНалогаИлиПлатежаПриИзмененииЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВидНалогаИлиПлатежаПриИзмененииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНалогаИлиПлатежаПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВидНалогаИлиПлатежаПриИзмененииНаСервере();
	Иначе
		Объект.ВидНалогаИлиПлатежа = ЭтотОбъект.КэшПараметров.Локальные.ВидНалогаИлиПлатежаДоИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВидНалогаИлиПлатежаПриИзмененииНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Объект.Налоги.Очистить();
	
	Объект.Периодичность = Документы.ВедомостьСроковИсполненияПоПлатежамВБюджеты.ПериодичностьВидаНалогаИлиПлатежа(
		Объект.ВидНалогаИлиПлатежа);
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ВидНалогаИлиПлатежаДоИзменения", Объект.ВидНалогаИлиПлатежа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзменении(Элемент)
	
	ДопПараметры = Новый Структура;
	
	ЕстьДанныеВДокументе = (Объект.Налоги.Количество() > 0);
	
	ТекстВопроса = "";
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено, а табличная часть будет очищена. Продолжить?'");
	ИначеЕсли Объект.Проведен Тогда
		ТекстВопроса = НСтр("ru = 'Проведение документа будет отменено. Продолжить?'");
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		ТекстВопроса = НСтр("ru = 'Табличная часть документа будет очищена. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ПериодичностьПриИзмененииЗавершение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ПериодичностьПриИзмененииНаСервере();
	КонецЕсли;
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодичностьПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПериодичностьПриИзмененииНаСервере();
	Иначе
		Объект.Периодичность = ЭтотОбъект.КэшПараметров.Локальные.ПериодичностьДоИзменения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПериодичностьПриИзмененииНаСервере()
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Объект.Налоги.Очистить();
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("ПериодичностьДоИзменения", Объект.Периодичность);
	
КонецПроцедуры

