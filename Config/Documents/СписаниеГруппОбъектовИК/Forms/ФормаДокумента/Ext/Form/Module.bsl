&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт

	//ПараметрыПодбора.Отбор.Вставить("ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.Казна"));
	ПараметрыПодбора.Вставить("Казна", Истина);
	ПараметрыПодбора.Вставить("ТребуемыеДанные","ГрупповойУчет,СчетУчета,Цена");
	
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ЕстьИнвентарныйНомер",
		ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны);
	ПараметрыПодбора.Отбор.Вставить("КФО",				Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("КПС",				Объект.КПС);
	ПараметрыПодбора.Отбор.Вставить("ИФО",				Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("Подразделение",	Объект.Подразделение);
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт

	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если УчитываетсяПодразделение() Тогда
		СтруктураРеквизитов.Вставить("Подразделение");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("КПС");
	
    Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Функция СформироватьСтруктуруПроверяемыхРеквизитов(ВключатьПодразделение=Ложь)
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		СтруктураРеквизитов.Вставить("ИФО");
	КонецЕсли;
	Если ВключатьПодразделение Тогда
		СтруктураРеквизитов.Вставить("Подразделение");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("КФО");
	СтруктураРеквизитов.Вставить("КПС");
	
    Возврат СтруктураРеквизитов;
КонецФункции

&НаСервере
Функция ПоместитьОСВХранилище()

	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);

КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение)
	ДобавленныеСтроки = УправлениеОсновнымиСредствами.ОбработатьПодборОсновныхСредств(Объект.ОсновныеСредства,ВыбранноеЗначение,,"ОсновноеСредство,ИнвентарныйНомер");
	
	Для каждого ЭлементКоллекции Из Объект.ОсновныеСредства Цикл
		
		Если НЕ ЭлементКоллекции.ГрупповойУчет И ЭлементКоллекции.Количество<>1 Тогда
			ЭлементКоллекции.Количество = 1;
		КонецЕсли;

	КонецЦикла;
	
	РассчитатьСтоимостьОС();
	
КонецПроцедуры

