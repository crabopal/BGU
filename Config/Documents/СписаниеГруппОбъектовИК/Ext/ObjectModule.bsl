#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	МассивНепроверяемыхРеквизитов = Новый Массив;
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
	    МассивНепроверяемыхРеквизитов.Добавить("Подразделение");
	КонецЕсли;
	
	Если НЕ Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата).ВедениеАналитическогоУчетаИмуществаКазны Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ОсновныеСредства.Цена");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОСДокумента.ОсновноеСредство,
	               |	ОСДокумента.ИнвентарныйНомер,
	               |	ОСДокумента.НомерСтроки
	               |ПОМЕСТИТЬ ОСДокумента
	               |ИЗ
	               |	&ОСДокумента КАК ОСДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ДатаСобытия,
	               |	ВложенныйЗапрос1.ДатаСобытия КАК ДатаСобытия1,
	               |	ВложенныйЗапрос.ОсновноеСредство,
	               |	ВложенныйЗапрос.ИнвНомер
	               |ПОМЕСТИТЬ ПередачаВАренду
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия,
	               |		СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		СобытияОС.ИнвНомер КАК ИнвНомер
	               |	ИЗ
	               |		РегистрСведений.СобытияОС КАК СобытияОС
	               |	ГДЕ
	               |		СобытияОС.Период < &Период
	               |		И (СобытияОС.ОсновноеСредство, СобытияОС.ИнвНомер) В
	               |				(ВЫБРАТЬ
	               |					ОСДокумента.ОсновноеСредство,
	               |					ОСДокумента.ИнвентарныйНомер
	               |				ИЗ
	               |					ОСДокумента)
	               |		И СобытияОС.Организация = &Организация
	               |		И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.СдачаВАренду)
	               |		И СобытияОС.Регистратор <> &Ссылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия,
	               |			СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |			СобытияОС.ИнвНомер КАК ИнвНомер
	               |		ИЗ
	               |			РегистрСведений.СобытияОС КАК СобытияОС
	               |		ГДЕ
	               |			СобытияОС.Период <= &Период
	               |			И (СобытияОС.ОсновноеСредство, СобытияОС.ИнвНомер) В
	               |					(ВЫБРАТЬ
	               |						ОСДокумента.ОсновноеСредство,
	               |						ОСДокумента.ИнвентарныйНомер
	               |					ИЗ
	               |						ОСДокумента)
	               |			И СобытияОС.Организация = &Организация
	               |			И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзАренды)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СобытияОС.ОсновноеСредство,
	               |			СобытияОС.ИнвНомер) КАК ВложенныйЗапрос1
	               |		ПО ВложенныйЗапрос.ДатаСобытия < ВложенныйЗапрос1.ДатаСобытия
	               |			И ВложенныйЗапрос.ОсновноеСредство = ВложенныйЗапрос1.ОсновноеСредство
	               |			И ВложенныйЗапрос.ИнвНомер = ВложенныйЗапрос1.ИнвНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ДатаСобытия,
	               |	ВложенныйЗапрос1.ДатаСобытия КАК ДатаСобытия1,
	               |	ВложенныйЗапрос.ОсновноеСредство,
	               |	ВложенныйЗапрос.ИнвНомер
	               |ПОМЕСТИТЬ ПередачаВБезвозмездноеПользование
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия,
	               |		СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		СобытияОС.ИнвНомер КАК ИнвНомер
	               |	ИЗ
	               |		РегистрСведений.СобытияОС КАК СобытияОС
	               |	ГДЕ
	               |		СобытияОС.Период < &Период
	               |		И (СобытияОС.ОсновноеСредство, СобытияОС.ИнвНомер) В
	               |				(ВЫБРАТЬ
	               |					ОСДокумента.ОсновноеСредство,
	               |					ОСДокумента.ИнвентарныйНомер
	               |				ИЗ
	               |					ОСДокумента)
	               |		И СобытияОС.Организация = &Организация
	               |		И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПередачаВБезвозмездноеПользование)
	               |		И СобытияОС.Регистратор <> &Ссылка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия,
	               |			СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |			СобытияОС.ИнвНомер КАК ИнвНомер
	               |		ИЗ
	               |			РегистрСведений.СобытияОС КАК СобытияОС
	               |		ГДЕ
	               |			СобытияОС.Период <= &Период
	               |			И (СобытияОС.ОсновноеСредство, СобытияОС.ИнвНомер) В
	               |					(ВЫБРАТЬ
	               |						ОСДокумента.ОсновноеСредство,
	               |						ОСДокумента.ИнвентарныйНомер
	               |					ИЗ
	               |						ОСДокумента)
	               |			И СобытияОС.Организация = &Организация
	               |			И СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СобытияОС.ОсновноеСредство,
	               |			СобытияОС.ИнвНомер) КАК ВложенныйЗапрос1
	               |		ПО ВложенныйЗапрос.ДатаСобытия < ВложенныйЗапрос1.ДатаСобытия
	               |			И ВложенныйЗапрос.ОсновноеСредство = ВложенныйЗапрос1.ОсновноеСредство
	               |			И ВложенныйЗапрос.ИнвНомер = ВложенныйЗапрос1.ИнвНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МестонахождениеОССрезПоследних.Состояние,
	               |	МестонахождениеОССрезПоследних.ОсновноеСредство,
	               |	МестонахождениеОССрезПоследних.ИнвНомер
	               |ПОМЕСТИТЬ МестонахождениеОССрезПоследних
	               |ИЗ
	               |	РегистрСведений.МестонахождениеОС.СрезПоследних(
	               |			&Период,
	               |			Организация = &Организация
	               |				И (ОсновноеСредство, ИнвНомер) В
	               |					(ВЫБРАТЬ
	               |						ОСДокумента.ОсновноеСредство,
	               |						ОСДокумента.ИнвентарныйНомер
	               |					ИЗ
	               |						ОСДокумента)
	               |				И Регистратор <> &Ссылка) КАК МестонахождениеОССрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ОсновноеСредство,
	               |	ВложенныйЗапрос.ИнвентарныйНомер,
	               |	ВложенныйЗапрос.НомерСтроки,
	               |	ОСДокумента.НомерСтроки КАК НомерСтрокиОшибки,
	               |	NULL КАК Состояние,
	               |	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.ОсновноеСредство) КАК ПредставлениеОС,
	               |	ПРЕДСТАВЛЕНИЕ(ВложенныйЗапрос.ИнвентарныйНомер) КАК ПредставлениеИнвНомер,
	               |	NULL КАК ДатаПередачиВАренду,
	               |	NULL КАК ДатаПередачиВПользование
	               |ИЗ
	               |	ОСДокумента КАК ОСДокумента
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ОСДокумента.ОсновноеСредство КАК ОсновноеСредство,
	               |			ОСДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	               |			МИНИМУМ(ОСДокумента.НомерСтроки) КАК НомерСтроки
	               |		ИЗ
	               |			ОСДокумента КАК ОСДокумента
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ОСДокумента.ОсновноеСредство,
	               |			ОСДокумента.ИнвентарныйНомер) КАК ВложенныйЗапрос
	               |		ПО ОСДокумента.ОсновноеСредство = ВложенныйЗапрос.ОсновноеСредство
	               |			И ОСДокумента.ИнвентарныйНомер = ВложенныйЗапрос.ИнвентарныйНомер
	               |			И ОСДокумента.НомерСтроки > ВложенныйЗапрос.НомерСтроки
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОСДокумента.ОсновноеСредство,
	               |	ОСДокумента.ИнвентарныйНомер,
	               |	ОСДокумента.НомерСтроки,
	               |	0,
	               |	МестонахождениеОССрезПоследних.Состояние,
	               |	ПРЕДСТАВЛЕНИЕ(ОСДокумента.ОсновноеСредство),
	               |	ПРЕДСТАВЛЕНИЕ(ОСДокумента.ИнвентарныйНомер),
	               |	ПередачаВАренду.ДатаСобытия,
	               |	ПередачаВБезвозмездноеПользование.ДатаСобытия
	               |ИЗ
	               |	ОСДокумента КАК ОСДокумента
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МестонахождениеОССрезПоследних КАК МестонахождениеОССрезПоследних
	               |		ПО ОСДокумента.ОсновноеСредство = МестонахождениеОССрезПоследних.ОсновноеСредство
	               |			И ОСДокумента.ИнвентарныйНомер = МестонахождениеОССрезПоследних.ИнвНомер
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПередачаВАренду КАК ПередачаВАренду
	               |		ПО ОСДокумента.ОсновноеСредство = ПередачаВАренду.ОсновноеСредство
	               |			И ОСДокумента.ИнвентарныйНомер = ПередачаВАренду.ИнвНомер
	               |			И (ПередачаВАренду.ДатаСобытия ЕСТЬ НЕ NULL )
	               |			И (ПередачаВАренду.ДатаСобытия1 ЕСТЬ NULL )
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПередачаВБезвозмездноеПользование КАК ПередачаВБезвозмездноеПользование
	               |		ПО ОСДокумента.ОсновноеСредство = ПередачаВБезвозмездноеПользование.ОсновноеСредство
	               |			И ОСДокумента.ИнвентарныйНомер = ПередачаВБезвозмездноеПользование.ИнвНомер
	               |			И (ПередачаВБезвозмездноеПользование.ДатаСобытия ЕСТЬ НЕ NULL )
	               |			И (ПередачаВБезвозмездноеПользование.ДатаСобытия1 ЕСТЬ NULL )
	               |ГДЕ
	               |	МестонахождениеОССрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	               |	И МестонахождениеОССрезПоследних.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)";
	Запрос.УстановитьПараметр("ОсДокумента", ОсновныеСредства.Выгрузить(,"НомерСтроки,ОсновноеСредство,ИнвентарныйНомер"));
	Запрос.УстановитьПараметр("Период", ?(ДатаСписанияСБухУчета='00010101',?(Ссылка.Пустая(), КонецДня(Дата),Дата),ДатаСписанияСБухУчета));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
		
			Если Выборка.НомерСтрокиОшибки<>0 Тогда
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru='%1 инв. №%2 уже выбрано в строке %3'"),Выборка.ПредставлениеОС, СокрЛП(Выборка.ПредставлениеИнвНомер), Выборка.НомерСтроки),,
																	"Объект.ОсновныеСредства["+(Выборка.НомерСтрокиОшибки-1)+"].ИнвентарныйНомер",,Отказ);
			КонецЕсли;	
			Если ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
				Если Выборка.Состояние = Перечисления.СостоянияОС.СнятоСУчета Тогда
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru='%1 инв. №%2 уже снято с учета'"),Выборка.ПредставлениеОС, СокрЛП(Выборка.ПредставлениеИнвНомер)),,
																		"Объект.ОсновныеСредства["+(Выборка.НомерСтроки-1)+"].ИнвентарныйНомер",,Отказ);
				ИначеЕсли ЗначениеЗаполнено(Выборка.ДатаПередачиВАренду) Тогда
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru='%1 инв. №%2 передано в аренду %3'"),Выборка.ПредставлениеОС, СокрЛП(Выборка.ПредставлениеИнвНомер),
												Формат(Выборка.ДатаПередачиВАренду,"ДЛФ=D")),, "Объект.ОсновныеСредства["+(Выборка.НомерСтроки-1)+"].ИнвентарныйНомер",,Отказ);
				ИначеЕсли ЗначениеЗаполнено(Выборка.ДатаПередачиВПользование) Тогда
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru='%1 инв. №%2 передано в безвозмездное пользование %3'"),Выборка.ПредставлениеОС, СокрЛП(Выборка.ПредставлениеИнвНомер),
												Формат(Выборка.ДатаПередачиВПользование,"ДЛФ=D")),, "Объект.ОсновныеСредства["+(Выборка.НомерСтроки-1)+"].ИнвентарныйНомер",,Отказ);
																		
				ИначеЕсли Выборка.НомерСтрокиОшибки=0 Тогда
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru='%1 инв. №%2 еще не принято к учету'"),Выборка.ПредставлениеОС, СокрЛП(Выборка.ПредставлениеИнвНомер)),,
																		"Объект.ОсновныеСредства["+(Выборка.НомерСтроки-1)+"].ИнвентарныйНомер",,Отказ);
				КонецЕсли;					
			КонецЕсли;
			
		КонецЦикла; 
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ДатаСписанияСБухУчета) Тогда
		ЭтотОбъект.ДатаСписанияСБухУчета = ЭтотОбъект.Дата;
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства, РежимПроведения);
	
	// Инициализация данных документа
	Документы.СписаниеГруппОбъектовИК.ИнициализироватьДанныеДокумента(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);

	// Движения по регистрам накопления
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СтоимостьОбъектовОС");
	ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "АмортизацияОбъектовОС");
	
	// Движения по регистрам сведений
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);
	Если УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "МестонахождениеОС");
		ПроведениеСервер.ОтразитьДвиженияПоРегистру(ДополнительныеСвойства, Движения, Отказ, "СобытияОС");
	КонецЕсли;
	
КонецПроцедуры
    
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ДатаСписанияСБухУчета = '00010101';
	Для каждого ТекСтр Из ОсновныеСредства Цикл
	
		ТекСтр.ИнвентарныйНомер = Неопределено;
		ТекСтр.Сумма 			= 0;
		ТекСтр.СуммаАмортизации	= 0;
		ТекСтр.Цена 			= 0;
	
	КонецЦикла; 
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ДанныеЗаполнения.Свойство("Основание", Основание);
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
			СтандартнаяОбработка = Ложь;
			Документы.ИнвентаризацияИК.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

