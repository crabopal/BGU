КонецПроцедуры

&НаКлиенте
Процедура ВидУведомленияПриИзменении(Элемент)
	
	Элементы.ОснованиеИзменения.ТолькоПросмотр = Объект.ВидУведомления <= 1;
	
	Если Объект.ВидУведомления >1 Тогда
		Объект.ДатаИзменения = ТекущаяДата();
	Иначе
		Объект.ДатаИзменения = "";
	КонецЕсли;
	
	Если Объект.ВидУведомления = 3 И ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда		
		//Аннулируем
		Объект.АннулированнаяСуммаДокумента = Объект.СуммаДокумента;						
	КонецЕсли;
	
	Если Объект.ВидУведомления <> 3 И Объект.СуммаДокумента = 0 Тогда
		Объект.СуммаДокумента = Объект.АннулированнаяСуммаДокумента;
		Объект.АннулированнаяСуммаДокумента = 0;
	КонецЕсли;
		
	Если Объект.ВидУведомления<=1 Тогда
		Объект.ОснованиеИзменения = "";	
	КонецЕсли;
	
КонецПроцедуры

