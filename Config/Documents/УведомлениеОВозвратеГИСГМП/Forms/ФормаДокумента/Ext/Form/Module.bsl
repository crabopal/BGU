&НаСервере
Процедура ОбновитьУИВНаСервере(Знач ТекОбъект = Неопределено)
	
	Настройки = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.Организация);
	Код = "";
	Код = Настройки.УРН;
	
	Если ТекОбъект = Неопределено Тогда
		ТекОбъект = РеквизитФормыВЗначение("Объект");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Номер) Тогда		
		ТекОбъект.УстановитьНовыйНомер();
		Объект.Номер = ТекОбъект.Номер;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекОбъект.Дата) Тогда
		ТекОбъект.Дата = ТекущаяДата();
		Объект.Дата = ТекОбъект.Дата;
	КонецЕсли;
	
	Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(XMLСтрока(БиблиотекаФункцийОбменаПовтИсп.ПеревестиИз16В10(ВРег(Код))),8,0,"Слева");
	ТекНомер = БиблиотекаФункцийОбмена.НомерБезПрефиксовИЛидирующихНулей(ТекОбъект.Номер);
	ТекНомер = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(ТекНомер,9),9,"0","Слева");
	ПолныйКод = Код + Формат(Объект.Дата,"ДФ=ddMMyyyy") + ТекНомер;
	Объект.УИВ = ПолныйКод;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПлатежаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
		|	ПлатежВОплатуГосуслуг.ИдентификаторПлательщика КАК ИдентификаторПлательщика
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|ГДЕ
		|	ПлатежВОплатуГосуслуг.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ВозвращаемыйПлатеж);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Объект.БанковскийИдентификаторПлатежа = ВыборкаДетальныеЗаписи.БанковскийИдентификаторПлатежа;
		//т.к. платеж может быть старый, загруженный по формату до 2.0, то преобразуем его в новый формат
		Объект.ИдентификаторПлательщика = ГосУслуги.ПреобразоватьИдентификаторПлательщикаВФормат20(ВыборкаДетальныеЗаписи.ИдентификаторПлательщика);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	
	Объект.КонтрагентНаименование		= ""; 
	//Объект.КонтрагентИНН				= ""; 
	//Объект.КонтрагентКПП				= ""; 
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) тогда
		
		Объект.КонтрагентБанковскийСчет	= ""; 
		Объект.КонтрагентНаименованиеБанка	= ""; 
		Объект.КонтрагентБИКБанка			= ""; 
		Объект.КонтрагентКорСчетБанка		= ""; 
		
		Возврат;	
	КонецЕсли;
	
	Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.ЗаявкаНаВозврат");
	
	ПриИзмененииСчетаКонтрагента();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчетаКонтрагента()
	
	Объект.КонтрагентНаименование 		= "";
	Объект.КонтрагентБанковскийСчет		= ""; 
	Объект.КонтрагентНаименованиеБанка	= ""; 
	Объект.КонтрагентБИКБанка			= ""; 
	Объект.КонтрагентКорСчетБанка		= ""; 
	//Объект.КонтрагентИНН 				= ""; 
	//Объект.КонтрагентКПП 				= ""; 

	Если НЕ ЗначениеЗаполнено(Объект.Счетконтрагента) Тогда
		
		РеквизитыПолучателя = ПолучитьРеквизитыКонтрагента(Объект.Контрагент);
		Объект.КонтрагентНаименование 		= РеквизитыПолучателя.НаименованиеПолное;
		//Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИНН; 
		//Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПП; 

		Возврат;
	КонецЕСли;	
	
	РеквизитыПолучателя = ПолучитьПлатежныеРеквизитыКонтрагента(Объект.СчетКонтрагента);
	
	Объект.КонтрагентНаименование 		= РеквизитыПолучателя.ТекстПолучателя;
	Объект.КонтрагентБанковскийСчет		= РеквизитыПолучателя.НомерСчетаПолучателя; 
	Объект.КонтрагентНаименованиеБанка	= РеквизитыПолучателя.НаименованиеБанкаПолучателя; 
	Объект.КонтрагентБИКБанка			= РеквизитыПолучателя.БикБанкаПолучателя; 
	Объект.КонтрагентКорСчетБанка		= РеквизитыПолучателя.СчетБанкаПолучателя; 
	//Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИННПолучателя; 
	//Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПППолучателя; 

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыКонтрагента(Знач Контрагент)
	
	РеквизитыПолучателя = Новый Структура("СсылкаНаОбъект, ИНН, КПП, НаименованиеПолное, Наименование", Контрагент);
	
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(РеквизитыПолучателя);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыКонтрагента(Знач СчетКонтрагента)
	
	РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СчетКонтрагента, СчетКонтрагента, РеквизитыПолучателя, , Ложь);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции

&НаСервере
Процедура ПолучитьЛицевойСчет()
	
	Объект.ЛицевойСчет 				= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РеквизитыЛицевогоСчета, "Владелец");
	
   	ПриИзмененииЛицевогоСчета();

КонецПроцедуры

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	Перем ДопустимыеИсточникиСредств;
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет);
		
	Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ДопустимыеИсточникиСредств);
	
	Если ДопустимыеИсточникиСредств.Найти(Объект.ИсточникСредств) = Неопределено Тогда
		Объект.ИсточникСредств = "";
		Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
			Объект.ИсточникСредств = ДопустимыеИсточникиСредств[0];
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

