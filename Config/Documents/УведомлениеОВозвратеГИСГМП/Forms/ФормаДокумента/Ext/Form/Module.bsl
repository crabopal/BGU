&НаСервере
Процедура ЗаявкаНаВозвратПриИзмененииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаВозврат.ИФО КАК ИФО,
		|	ЗаявкаНаВозврат.ИсточникСредств КАК ИсточникСредств,
		|	ЗаявкаНаВозврат.ЛицевойСчет КАК ЛицевойСчет,
		|	ЗаявкаНаВозврат.НазначениеПлатежа КАК НазначениеПлатежа,
		|	ЗаявкаНаВозврат.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
		|	ЗаявкаНаВозврат.СуммаДокумента КАК СуммаДокумента,
		|	ЗаявкаНаВозврат.ДокументОснованиеВид КАК ДокументОснованиеВид,
		|	ЗаявкаНаВозврат.ДокументОснованиеДата КАК ДокументОснованиеДата,
		|	ЗаявкаНаВозврат.ДокументОснованиеНомер КАК ДокументОснованиеНомер,
		|	ЗаявкаНаВозврат.Контрагент КАК Контрагент,
		|	ЗаявкаНаВозврат.КонтрагентНаименование КАК КонтрагентНаименование,
		|	ЗаявкаНаВозврат.КодОКАТО КАК КодОКАТО,
		|	ЗаявкаНаВозврат.Дата КАК ДатаЗаявки,
		|	ЗаявкаНаВозврат.Номер КАК НомерЗаявки,
		|	ЗаявкаНаВозврат.СчетКонтрагента КАК СчетКонтрагента,
		|	ЗаявкаНаВозврат.КОСГУНазначениеПлатежа КАК КОСГУНазначениеПлатежа,
		|	ЗаявкаНаВозврат.КБКНазначениеПлатежа КАК КБКНазначениеПлатежа,
		|	ЗаявкаНаВозврат.КодОКТМОПолучателя КАК КодОКТМОПолучателя,
		|	ЗаявкаНаВозврат.КодБКПолучателя КАК КодБКПолучателя,
		|	ЗаявкаНаВозврат.КонтрагентБанковскийСчет КАК КонтрагентБанковскийСчет,
		|	ЗаявкаНаВозврат.КонтрагентЛицевойСчет КАК КонтрагентЛицевойСчет,
		|	ЗаявкаНаВозврат.КБКНазначениеПлатежа.ДатаНачалаДействия КАК ДатаНачалаДействия,
		|	ЗаявкаНаВозврат.КонтрагентБИКБанка КАК КонтрагентБИКБанка,
		|	ЗаявкаНаВозврат.КонтрагентКорСчетБанка КАК КонтрагентКорСчетБанка,
		|	ЗаявкаНаВозврат.КонтрагентНаименованиеБанка КАК КонтрагентНаименованиеБанка
		|ИЗ
		|	Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
		|ГДЕ
		|	ЗаявкаНаВозврат.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЗаявкаНаВозврат);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(Объект,ВыборкаДетальныеЗаписи);
		
		МассивДок = Новый Массив;
		МассивДок.Добавить(Объект.ЗаявкаНаВозврат);
		РеквизитыЗаявок = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаВозврат(МассивДок);		
		Объект.КодБКНазначениеПлатежа = РеквизитыЗаявок[0].КодБК;//БиблиотекаФункцийОбмена.ПолучитьРеквизитШапкиПРДокумента(Объект.ЗаявкаНаВозврат, "КодБК");		
		Объект.НомерЗаявки = БиблиотекаФункцийОбмена.НомерДокументаПоНастройке("ЗаявкаНаВозврат",Объект.НомерЗаявки);
		Элементы.ИсточникСредств.СписокВыбора.ЗагрузитьЗначения(ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(Объект.ЛицевойСчет));
		
	КонецЕсли;
	
КонецПроцедуры

