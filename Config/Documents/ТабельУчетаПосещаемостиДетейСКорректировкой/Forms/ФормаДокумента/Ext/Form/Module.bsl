&НаСервере
Процедура НастроитьТабличнуюЧастьТабеля()

	ТабельПоДням = Объект.ВидТабеля = 0;
	
	ВидыДней.Очистить();
	ВидыДней.Добавить();
	
	Для К = 1 По 31 Цикл
		Если К > КалендарьДнейВМесяце Тогда
			Элементы.ДанныеОПосещениях.ПодчиненныеЭлементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].Видимость = Ложь;
		Иначе
			Элементы.ДанныеОПосещениях.ПодчиненныеЭлементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].Видимость = ТабельПоДням;
			
			ВидыДней[0]["ВидДня"+К] = КалендарьВидыДней[К-1].ВидДня;
			
			Если ВидыДней[0]["ВидДня"+К] = Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий
				 ИЛИ ВидыДней[0]["ВидДня"+К] = Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный Тогда
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].Доступность = ИСТИНА;
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].ЦветТекстаЗаголовка = ЦветаСтиля.ЦветТекстаПоля;
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].СписокВыбора.Очистить();
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].СписокВыбора.Вставить(0, 
					ВидЗаписиОпл, "Н (опл)");
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].СписокВыбора.Вставить(1, 
					ВидЗаписиНеопл, "Н (неопл)");
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].СписокВыбора.Вставить(2, 
					ВидЗаписиПустая, "посещение");
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].ЦветТекста = ЦветаСтиля.ЦветТекстаПоля;
			Иначе
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].Доступность = ЛОЖЬ;
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].ЦветТекстаЗаголовка = ЦветаСтиля.ВидДняПроизводственногоКалендаряВоскресеньеЦвет;
				Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].ЦветТекста = ЦветаСтиля.ВидДняПроизводственногоКалендаряВоскресеньеЦвет;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДниМесяца()
	
	КалендарьДнейВМесяце = 0;
	КалендарьРабочихДней = 0;
	КалендарьВидыДней.Очистить();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоМесяца", НачалоМесяца(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Объект.НачалоПериода));
	
	График = Объект.ГрафикРаботы;
	Если НЕ ЗначениеЗаполнено(График) Тогда
		График = Справочники.ПроизводственныеКалендари.НайтиПоКоду("РФ");
	КонецЕсли;
	
	Если ТипЗнч(График) = Тип("СправочникСсылка.ПроизводственныеКалендари") Тогда
		Запрос.УстановитьПараметр("ПроизводственныйКалендарь", График);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ДанныеПроизводственногоКалендаря.Дата,
		|	ДанныеПроизводственногоКалендаря.ВидДня
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И ДанныеПроизводственногоКалендаря.ВидДня В (ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий), ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК ДанныеПроизводственногоКалендаря
		|ГДЕ
		|	ДанныеПроизводственногоКалендаря.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И ДанныеПроизводственногоКалендаря.ПроизводственныйКалендарь = &ПроизводственныйКалендарь";
	ИначеЕсли ТипЗнч(График) = Тип("СправочникСсылка.Календари") Тогда
		Запрос.УстановитьПараметр("ПроизводственныйКалендарь",	График.ПроизводственныйКалендарь);
		Запрос.УстановитьПараметр("Календарь", График);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	График.ДатаГрафика КАК Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий) КАК ВидДня
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК График
		|ГДЕ
		|	График.Календарь = &Календарь
		|	И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И График.ДеньВключенВГрафик
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Календарь.Дата,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыДнейПроизводственногоКалендаря.Воскресенье)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК Календарь
		|ГДЕ
		|	Календарь.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И Календарь.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И НЕ Календарь.Дата В
		|				(ВЫБРАТЬ
		|					График.ДатаГрафика
		|				ИЗ
		|					РегистрСведений.КалендарныеГрафики КАК График
		|				ГДЕ
		|					График.Календарь = &Календарь
		|					И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|					И График.ДеньВключенВГрафик)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	РегистрСведений.КалендарныеГрафики КАК График
		|ГДЕ
		|	График.Календарь = &Календарь
		|	И График.ДатаГрафика МЕЖДУ &НачалоМесяца И &КонецМесяца
		|	И График.ДеньВключенВГрафик
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*)
		|ИЗ
		|	РегистрСведений.ДанныеПроизводственногоКалендаря КАК Календарь
		|ГДЕ
		|	Календарь.ПроизводственныйКалендарь = &ПроизводственныйКалендарь
		|	И Календарь.Дата МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Иначе
		Возврат;
	КонецЕсли;
	
	Результат = Запрос.ВыполнитьПакет();
	
	Если Результат.Количество() > 0 Тогда
		КалендарьДнейВМесяце = Результат[1].Выгрузить()[1].Количество;
		КалендарьРабочихДней = Результат[1].Выгрузить()[0].Количество;
		КалендарьВидыДней.Загрузить(Результат[0].Выгрузить());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеНачалаПериода(Элемент)
	
	Объект.КонецПериода = КонецМесяца(Объект.НачалоПериода);
	ПериодПриИзмененииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПериодПриИзмененииНаСервере()
	
	ЗаполнитьДниМесяца();
	НастроитьТабличнуюЧастьТабеля();
	
	Объект.КоличествоДнейВМесяце = КалендарьДнейВМесяце;
	Объект.КоличествоРабочихДней = КалендарьРабочихДней;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПредупреждение()
	
	ОтображениеПредупреждения = ОтображениеПредупрежденияПриРедактировании.НеОтображать;
	Если Объект.ДанныеОПосещениях.Количество() > 0 Тогда
		ОтображениеПредупреждения = ОтображениеПредупрежденияПриРедактировании.Отображать;
	КонецЕсли;
			
	Элементы.Организация.ОтображениеПредупрежденияПриРедактировании 				= ОтображениеПредупреждения;
	Элементы.Группа.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупреждения;
	Элементы.НачалоПериодаСтрокой.ОтображениеПредупрежденияПриРедактировании 		= ОтображениеПредупреждения;
	Элементы.Дата.ОтображениеПредупрежденияПриРедактировании 						= ОтображениеПредупреждения;
	Элементы.РодительскаяПлатаДопУслуги.ОтображениеПредупрежденияПриРедактировании	= ОтображениеПредупреждения;
	Элементы.ВидТабеля.ОтображениеПредупрежденияПриРедактировании					= ОтображениеПредупреждения;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГрафикРаботыПоГруппе()
	
	КалендарныйГрафикГруппы = Неопределено;
	Если ЗначениеЗаполнено(Объект.Группа) Тогда
		КалендарныйГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(Объект.Группа, Объект.НачалоПериода);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(КалендарныйГрафикГруппы) Тогда
		Объект.ГрафикРаботы = КалендарныйГрафикГруппы;
	Иначе
		Объект.ГрафикРаботы = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГруппаПриИзмененииНаСервере()
	
	ЗаполнитьГрафикРаботыПоГруппе();
	ЗаполнитьДниМесяца();
	НастроитьТабличнуюЧастьТабеля();
	
	Объект.КоличествоДнейВМесяце = КалендарьДнейВМесяце;
	Объект.КоличествоРабочихДней = КалендарьРабочихДней;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	Объект.Группа = Справочники.ГруппыДетскогоУчреждения.ПустаяСсылка();
	Объект.ГрафикРаботы = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу(РебенокОтбор = Неопределено)
	
	НачалоПериода = НачалоМесяца(Объект.НачалоПериода);
	КонецПериода = КонецМесяца(Объект.КонецПериода);
	
	Если Объект.РодительскаяПлатаДопУслуги = 0 Тогда
		ТаблицаДетей = РодительскаяПлата.СписокДетейДляТабеляОсновнаяПрограмма(НачалоПериода, КонецПериода,
																				?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация), РебенокОтбор);
	Иначе
		ТаблицаДетей = РодительскаяПлата.СписокДетейДляТабеляДополнительнаяПрограмма(НачалоПериода, КонецПериода,
																				?(ЗначениеЗаполнено(Объект.Группа), Объект.Группа, Объект.Организация), РебенокОтбор);
	КонецЕсли;
	ТаблицаДетей.Индексы.Добавить("Ребенок");
	
	ОбработатьДубли(ТаблицаДетей, Истина);
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаДетей.Ребенок,
	|	ТаблицаДетей.НачалоПериода КАК НачалоПериода,
	|	ТаблицаДетей.ОкончаниеПериода КАК ОкончаниеПериода
	|ПОМЕСТИТЬ 
	|	ВТ_ТаблицаДетей
	|ИЗ
	|	&ТаблицаДетей КАК ТаблицаДетей;
	|	
	|ВЫБРАТЬ
	|	ТаблицаДней.*
	|ПОМЕСТИТЬ 
	|	ВТ_ТаблицаДней
	|ИЗ
	|	&ТаблицаДней КАК ТаблицаДней;";
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДетей.Ребенок.Код КАК Счет,
	|	ВТ_ТаблицаДетей.Ребенок,";
	
	Для К = 1 По Объект.КоличествоДнейВМесяце Цикл
		ТекстЗапроса = ТекстЗапроса + "
		|	ВЫБОР	
		|		КОГДА (" + К + " < ДЕНЬ(ВТ_ТаблицаДетей.НачалоПериода) ИЛИ " + К + " > ДЕНЬ(ВТ_ТаблицаДетей.ОкончаниеПериода)) 
		|				И ВТ_ТаблицаДней.ВидДня" + К + " В (&ДниКалендаряРабочий) ТОГДА 1
		|		ИНАЧЕ 
		|			ВЫБОР 
		|				КОГДА ВТ_ТаблицаДней.ВидДня" + К + " В (&ДниКалендаряВыходной) ТОГДА 0
		|				ИНАЧЕ 2
		|			КОНЕЦ
		|	КОНЕЦ КАК День" + К + ",";
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|	ВТ_ТаблицаДетей.Ребенок.Наименование КАК ИмяРебенка
	|ПОМЕСТИТЬ
	|	ВТ_ТаблицаДляГруппировки
	|ИЗ
	|	ВТ_ТаблицаДетей,
	|	ВТ_ТаблицаДней
	|	;";
		
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ
	|	ВТ_ТаблицаДляГруппировки.Счет,
	|	ВТ_ТаблицаДляГруппировки.Ребенок,";
	
	Для К = 1 По Объект.КоличествоДнейВМесяце Цикл
		ТекстЗапроса = ТекстЗапроса + "
		|	МАКСИМУМ(ВТ_ТаблицаДляГруппировки.День" + К + ") КАК День" + К + ",";
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "	
	|	ВТ_ТаблицаДляГруппировки.ИмяРебенка
	|ПОМЕСТИТЬ ВТ_ЧисловыеПоля
	|ИЗ
	|	ВТ_ТаблицаДляГруппировки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТаблицаДляГруппировки.ИмяРебенка,
	|	ВТ_ТаблицаДляГруппировки.Счет,
	|	ВТ_ТаблицаДляГруппировки.Ребенок
	|;";
		
	ТекстЗапроса = ТекстЗапроса + "
	|ВЫБРАТЬ
	|	ВТ_ЧисловыеПоля.Ребенок,
	|	0 ";
	
	Для К = 1 По Объект.КоличествоДнейВМесяце Цикл
		ТекстЗапроса = ТекстЗапроса + "
		|	+ ВЫБОР КОГДА ВТ_ЧисловыеПоля.День" + К + " = 2 ТОГДА 1 ИНАЧЕ 0 КОНЕЦ";
	КонецЦикла;
		
	ТекстЗапроса = ТекстЗапроса + "
	|	КАК ВсегоПосещений
	|ПОМЕСТИТЬ ВТ_КоличествоПосещений
	|ИЗ
	|	ВТ_ЧисловыеПоля
	|;
	|ВЫБРАТЬ
	|	ВТ_ЧисловыеПоля.Счет КАК Счет,
	|	ВТ_ЧисловыеПоля.Ребенок КАК Ребенок,";
	
	Для К = 1 По Объект.КоличествоДнейВМесяце Цикл
		ТекстЗапроса = ТекстЗапроса + "
		|	ВЫБОР 
		|		КОГДА ВТ_ЧисловыеПоля.День" + К + " = 0 ТОГДА &ВидЗаписиТабеляВыходной
		|		КОГДА ВТ_ЧисловыеПоля.День" + К + " = 1 ТОГДА &ВидЗаписиТабеляНеЧислится
		|		ИНАЧЕ &ВидЗаписиТабеляПустаяСсылка
		|	КОНЕЦ КАК ВидЗаписиТабеля" + К + ",";
	КонецЦикла;
	
	ТекстЗапроса = ТекстЗапроса + "
	|	ВТ_ЧисловыеПоля.ИмяРебенка КАК ИмяРебенка,
	|	ВТ_КоличествоПосещений.ВсегоПосещений КАК ВсегоПосещений
	|ИЗ
	|	ВТ_ЧисловыеПоля КАК ВТ_ЧисловыеПоля
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоПосещений КАК ВТ_КоличествоПосещений
	|		ПО ВТ_ЧисловыеПоля.Ребенок = ВТ_КоличествоПосещений.Ребенок
	|УПОРЯДОЧИТЬ ПО
	|	ИмяРебенка;";
		
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("ТаблицаДней", ВидыДней.Выгрузить());
	Запрос.УстановитьПараметр("ТаблицаДетей", ТаблицаДетей);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ДниКалендаряВыходной = Новый Массив;
	ДниКалендаряВыходной.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Праздник);
	ДниКалендаряВыходной.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Нерабочий);
	ДниКалендаряВыходной.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Воскресенье);
	ДниКалендаряВыходной.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Суббота);
	
	ДниКалендаряРабочий = Новый Массив;
	ДниКалендаряРабочий.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий);
	ДниКалендаряРабочий.Добавить(Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	
	Запрос.УстановитьПараметр("ДниКалендаряВыходной", ДниКалендаряВыходной);
	Запрос.УстановитьПараметр("ДниКалендаряРабочий", ДниКалендаряРабочий);
	
	Запрос.УстановитьПараметр("ВидЗаписиТабеляВыходной", Перечисления.ВидыЗаписейТабеля.Выходной);
	Запрос.УстановитьПараметр("ВидЗаписиТабеляНеЧислится", Перечисления.ВидыЗаписейТабеля.НеЧислитсяВГруппе);
	Запрос.УстановитьПараметр("ВидЗаписиТабеляПустаяСсылка", Перечисления.ВидыЗаписейТабеля.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Объект.ДанныеОПосещениях.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДубли(ТаблицаДетей, УчитыватьПериод = Ложь)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	Таблица.Ребенок КАК Ребенок";
					
	Если УчитыватьПериод Тогда
		Запрос.Текст = Запрос.Текст + ",
						|Таблица.НачалоПериода КАК НачалоПериода,
						|Таблица.ОкончаниеПериода КАК ОкончаниеПериода";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
					|ПОМЕСТИТЬ втДети
					|ИЗ
					|	&Таблица КАК Таблица;
					|
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	втДети.Ребенок";
					
	Если УчитыватьПериод Тогда
		Запрос.Текст = Запрос.Текст + ",
						|втДети.НачалоПериода КАК НачалоПериода,
						|втДети.ОкончаниеПериода КАК ОкончаниеПериода";
	КонецЕсли;					
	
	Запрос.Текст = Запрос.Текст + "
					|ИЗ
					|	втДети
					|УПОРЯДОЧИТЬ ПО
					|	втДети.Ребенок.Наименование;";
	Запрос.УстановитьПараметр("Таблица", ТаблицаДетей);
	
	ТаблицаДетей = Запрос.Выполнить().Выгрузить();
КонецПроцедуры

&НаКлиенте
Процедура ПервыйРабочийДень(ИндексДня)
	Если ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий") Или
		ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный") Тогда
		
		Возврат;
	КонецЕсли;
	
	Пока ИндексДня <= Объект.КоличествоДнейВМесяце Цикл
		Если ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Рабочий") Или
			ВидыДней[0]["ВидДня"+ИндексДня] = ПредопределенноеЗначение("Перечисление.ВидыДнейПроизводственногоКалендаря.Предпраздничный") Тогда
			
			Прервать;
		Иначе
			ИндексДня = ИндексДня + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидТабеля()
	
	Если Объект.ВидТабеля = 0 Тогда
		// Вид табеля по дням. 
		// Колонки по дням отображаются, итоговые колонки недоступны.
		ВидимостьКолонокПоДням = Истина;
		ТолькоПросмотрИтогов = Истина;
	Иначе
		// Вид табеля сводно. 
		// Колонки по дням скрываются, итоговые колонки становятся доступными для редактирования.
		ВидимостьКолонокПоДням = Ложь;
		ТолькоПросмотрИтогов = Ложь;
	КонецЕсли;
	
	Элементы.ДанныеОПосещенияхОплНевыходы.ТолькоПросмотр = ТолькоПросмотрИтогов;
	Элементы.ДанныеОПосещенияхНеоплНевыходы.ТолькоПросмотр = ТолькоПросмотрИтогов;
	
	Для К = 1 По 31 Цикл
		Если К > Объект.КоличествоДнейВМесяце Тогда
			// Колонки по дням, которых нет в месяце, скрываются всегда.
			ВидимостьКолонокПоДням = Ложь;
		КонецЕсли;	
		Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+К].Видимость = ВидимостьКолонокПоДням;
	КонецЦикла;
	
	ПересчитатьИтоги();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоВыбораПериода(Элемент, СтандартнаяОбработка)
	СтароеЗначение = Объект.НачалоПериода;
		
	РаботаСоСтудентамиКлиент.ПериодРегистрацииНачалоВыбора(ЭтотОбъект, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Элемент, СтандартнаяОбработка);
		
	Если Объект.НачалоПериода <> СтароеЗначение Тогда
			
		ОбработатьИзменениеНачалаПериода(Элемент);
			
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура РегулированиеПериода(Элемент, СтандартнаяОбработка, Направление)
	РаботаСоСтудентамиКлиент.ПериодРегистрацииРегулирование(ЭтотОбъект, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Элемент, Направление, СтандартнаяОбработка);
	
	ОбработатьИзменениеНачалаПериода(Элемент);
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементыОформления = УсловноеОформление.Элементы;
	
	Для К = 1 По 31 Цикл
		
		// Представление выходного дня.
		ЭлементОформления = ЭлементыОформления.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Представление = "ВидЗаписиТабеляВыходной"+К;
		
		ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеОПосещенияхВидЗаписиТабеля"+К);
		ПолеЭлемента.Использование = Истина;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,"Объект.ДанныеОПосещениях.ВидЗаписиТабеля"+К,
			ВидСравненияКомпоновкиДанных.Равно,ВидЗаписиВыходной,,Истина);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='В'"));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		// Представление Н(н).
		ЭлементОформления = ЭлементыОформления.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Представление = "ВидЗаписиТабеляНеопл"+К;
		
		ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеОПосещенияхВидЗаписиТабеля"+К);
		ПолеЭлемента.Использование = Истина;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,"Объект.ДанныеОПосещениях.ВидЗаписиТабеля"+К,
			ВидСравненияКомпоновкиДанных.Равно,ВидЗаписиНеопл,,Истина);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Н(н)'"));
				
		// Представление Н(о).
		ЭлементОформления = ЭлементыОформления.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Представление = "ВидЗаписиТабеляОпл"+К;
		
		ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеОПосещенияхВидЗаписиТабеля"+К);
		ПолеЭлемента.Использование = Истина;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,"Объект.ДанныеОПосещениях.ВидЗаписиТабеля"+К,
			ВидСравненияКомпоновкиДанных.Равно,ВидЗаписиОпл,,Истина);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='Н(о)'"));
		
		// Представление не числится в группе.
		ЭлементОформления = ЭлементыОформления.Добавить();
		ЭлементОформления.Использование = Истина;
		ЭлементОформления.Представление = "ВидЗаписиТабеляНеВГруппе"+К;
		
		ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДанныеОПосещенияхВидЗаписиТабеля"+К);
		ПолеЭлемента.Использование = Истина;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,"Объект.ДанныеОПосещениях.ВидЗаписиТабеля"+К,
			ВидСравненияКомпоновкиДанных.Равно,ВидЗаписиНеВГруппе,,Истина);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.НедоступныеДанныеЦвет);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='-'"));
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоги()
	
	ВсегоПропущеноДней = Объект.ДанныеОПосещениях.Итог("ОплНевыходы") + Объект.ДанныеОПосещениях.Итог("НеоплНевыходы");
	ПропущеноОплачиваемых = Объект.ДанныеОПосещениях.Итог("ОплНевыходы");
	ВсегоДнейКОплате = Объект.ДанныеОПосещениях.Итог("ВсегоПосещений");
	ВсегоЗаписейТабеля = Объект.ДанныеОПосещениях.Количество();
	
КонецПроцедуры

&НаКлиенте
Функция РассчитатьИтогиПоСтрокеСводно(ТекДанные)
	
	ПосещенийБезНевыходов = 0;
	
	ВсегоПосещений = Объект.КоличествоДнейВМесяце;
	
	Для Сч = 1 По Объект.КоличествоДнейВМесяце Цикл
		// Необходимо очистить отметки о непосещении для вида табеля 1 "Сводно".
		Если ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиНеопл ИЛИ ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиОпл Тогда
			ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиПустая;
			
		ИначеЕсли ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиВыходной ИЛИ ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиНеВГруппе Тогда
			ВсегоПосещений = ВсегоПосещений - 1;
		КонецЕсли;
	КонецЦикла;
	
	ПосещенийБезНевыходов = ВсегоПосещений - ТекДанные.ОплНевыходы - ТекДанные.НеоплНевыходы;
				
	Возврат ПосещенийБезНевыходов;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьИтогиПоСтрокеПоДням()
	
	ТекДанные = Элементы.ДанныеОПосещениях.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		ОплНевыходы = 0;
		НеоплНевыходы = 0;
		ВсегоПосещений = 0;
		
		Для Сч = 1 По Объект.КоличествоДнейВМесяце Цикл
			
			Если ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиОпл Тогда
				ОплНевыходы = ОплНевыходы + 1;
			ИначеЕсли ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиНеопл Тогда
				НеоплНевыходы = НеоплНевыходы + 1;
			ИначеЕсли ТекДанные["ВидЗаписиТабеля"+Сч] = ВидЗаписиПустая Тогда
				ВсегоПосещений = ВсегоПосещений + 1;
			КонецЕсли;	
				
		КонецЦикла;
		
		ТекДанные.ОплНевыходы = ОплНевыходы;
		ТекДанные.НеоплНевыходы = НеоплНевыходы;
		ТекДанные.ВсегоПосещений = ВсегоПосещений;

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборРебенкаСервер(Выбор, Элемент, ТекстСообщения, НомерСтроки)
	
	СтрокиТЧ = Объект.ДанныеОПосещениях.НайтиСтроки(Новый Структура("Ребенок", Выбор));
	Если СтрокиТЧ.Количество() > 0 Тогда
		СтрокаТЧ = СтрокиТЧ[0];
		
		ТекстСообщения = НСтр("ru='Выбранный ребенок ""%1"" дублирует ребенка в строке %2 табличной части. Добавление строки недопустимо.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Выбор, СтрокаТЧ.НомерСтроки);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицу(Выбор);
	
	Если Объект.ДанныеОПосещениях.Количество() > 0 Тогда
		Элементы.ДанныеОПосещениях.ТекущаяСтрока = Объект.ДанныеОПосещениях[
			Объект.ДанныеОПосещениях.Количество() - 1].ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидЗаписиВДанныеОПосещениях(НовыйВидЗаписи)
	
	ТекущаяСтрока = Элементы.ДанныеОПосещениях.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяКолонка = Элементы.ДанныеОПосещениях.ТекущийЭлемент;
	Если ТекущаяКолонка = Неопределено 
		ИЛИ СтрНайти(ТекущаяКолонка.Имя, "ВидЗаписиТабеля") = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИндексДня = Число(ТекущаяКолонка.Заголовок);
	
	ПервыйРабочийДень(ИндексДня);
	
	ТекущиеДанные = Элементы.ДанныеОПосещениях.ТекущиеДанные;
	
	ТекущийВидЗаписи = ТекущиеДанные["ВидЗаписиТабеля"+ИндексДня];
	Если ТекущийВидЗаписи = ВидЗаписиНеВГруппе ИЛИ ТекущийВидЗаписи = ВидЗаписиВыходной Тогда
		// Обработка недоступных записей не выполняется.
	Иначе
		Элементы.ДанныеОПосещениях.ТекущиеДанные["ВидЗаписиТабеля"+ИндексДня] = НовыйВидЗаписи;
	КонецЕсли;	
	
	Если ИндексДня < Объект.КоличествоДнейВМесяце Тогда
		Элементы.ДанныеОПосещениях.ТекущийЭлемент = Элементы["ДанныеОПосещенияхВидЗаписиТабеля"+(ИндексДня+1)];
	КонецЕсли;
	
	РассчитатьИтогиПоСтрокеПоДням();
	
	ПересчитатьИтоги();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРедакцииДокумента()
	
	Элементы.ГруппаДействующийДокумент.Видимость = ЗначениеЗаполнено(Объект.Основание);
	
	ТолькоПросмотр = ЗначениеЗаполнено(ДействующийДокумент);
	Элементы.ГруппаПереходаКДействующемуДокументу.Видимость = ЗначениеЗаполнено(ДействующийДокумент);
	
	
КонецПроцедуры

