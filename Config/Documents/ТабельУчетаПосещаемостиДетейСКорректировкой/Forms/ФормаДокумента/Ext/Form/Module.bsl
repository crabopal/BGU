#Область ОбработчикиОповещений

&НаКлиенте
Процедура ОбработатьВыборРебенка(Выбор, ДопПараметры) Экспорт
	Если Выбор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = Неопределено;
	ДопПараметры.Свойство("Элемент", Элемент);
	
	Ребенок = Неопределено;
	
	Если ТипЗнч(Выбор) = Тип("Структура") Тогда
		Ребенок = Выбор.Ребенок;
	ИначеЕсли ТипЗнч(Выбор) = Тип("СправочникСсылка.Дети") Тогда
		Ребенок = Выбор;
	КонецЕсли;
	
	ТекстСообщения = "";
	НомерСтроки = 0;
	
	ОбработатьВыборРебенкаСервер(Ребенок, Элемент.Имя, ТекстСообщения, НомерСтроки);
	
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , Элемент.Имя + "[" + НомерСтроки + "].Ребенок");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеПериода(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Действие = "";
	Элемент = Неопределено;
	СтандартнаяОбработка = Истина;
	Направление = 0;
	
	ДопПараметры.Свойство("Действие", Действие);
	ДопПараметры.Свойство("Элемент", Элемент);
	ДопПараметры.Свойство("СтандартнаяОбработка", СтандартнаяОбработка);
	
	Объект.ДанныеОПосещениях.Очистить();
	
	Если Действие = "НачалоВыбора" Тогда
		НачалоВыбораПериода(Элемент, СтандартнаяОбработка);
	ИначеЕсли Действие = "Регулирование" Тогда
		ДопПараметры.Свойство("Направление", Направление);
		РегулированиеПериода(Элемент, СтандартнаяОбработка, Направление);
	КонецЕсли;	
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеОрганизации(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Выбор = Ложь;
	ДопПараметры.Свойство("Выбор", Выбор);
	
	Если Выбор Тогда
		ОткрытьФорму("Справочник.Организации.ФормаВыбора", , Элементы.Организация);
	КонецЕсли;
	
	Объект.ДанныеОПосещениях.Очистить();
	
	ПересчитатьИтоги();
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьИзменениеГруппы(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.Группа = ПредЗначениеГруппа;
	Иначе
		Выбор = Ложь;
		ДопПараметры.Свойство("Выбор", Выбор);
		
		Если Выбор Тогда
			ПараметрыФормы = Новый Структура("Владелец", Объект.Организация);
			ОткрытьФорму("Справочник.ГруппыДетскогоУчреждения.Форма.ФормаВыбора", ПараметрыФормы, Элементы.Группа);
		КонецЕсли;
		
		Объект.ДанныеОПосещениях.Очистить();
		
		ГруппаПриИзмененииНаСервере();
		
		ПересчитатьИтоги();
		
		ПредЗначениеГруппа = Объект.Группа;
	КонецЕсли;
	
КонецПроцедуры

