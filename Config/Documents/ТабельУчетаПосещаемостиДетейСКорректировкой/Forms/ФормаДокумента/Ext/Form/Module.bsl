&НаКлиенте
Процедура ДанныеОПосещенияхРебенокПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДанныеОПосещениях.ТекущиеДанные;
	ТекРебенок = ТекДанные.Ребенок;
	
	Если ЗначениеЗаполнено(ТекРебенок) Тогда
		СтрокиТЧ = Объект.ДанныеОПосещениях.НайтиСтроки(Новый Структура("Ребенок", ТекРебенок));
		Если СтрокиТЧ.Количество() > 0 Тогда
			СтрокаТЧ = СтрокиТЧ[0];
			
			ТекстСообщения = НСтр("ru='Выбранный ребенок ""%1"" дублирует ребенка в строке %2 табличной части. Повторный выбор одного ребенка в табеле недопустим.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекРебенок, СтрокаТЧ.НомерСтроки);
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , Элемент.Имя + "[" + ТекДанные.НомерСтроки + "].ОплНевыходы");
			Элементы.ДанныеОПосещениях.ТекущиеДанные.Ребенок = Неопределено;
		Иначе
			ЗаполнитьТаблицу(ТекРебенок);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

