
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Заполнение видов записей для заполнения табличной части.
	ВидЗаписиНеопл		= ПредопределенноеЗначение("Перечисление.ВидыЗаписейТабеля.НепосещениеНеоплачиваемое");
	ВидЗаписиОпл		= ПредопределенноеЗначение("Перечисление.ВидыЗаписейТабеля.НепосещениеОплачиваемое");
	ВидЗаписиПустая		= ПредопределенноеЗначение("Перечисление.ВидыЗаписейТабеля.ПустаяСсылка");
	ВидЗаписиВыходной	= ПредопределенноеЗначение("Перечисление.ВидыЗаписейТабеля.Выходной");
	ВидЗаписиНеВГруппе	= ПредопределенноеЗначение("Перечисление.ВидыЗаписейТабеля.НеЧислитсяВГруппе");
	
	Если Параметры.Ключ.Пустая() 
		И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) 
		И НЕ ЗначениеЗаполнено(Объект.Основание) Тогда
		
		// Первичное заполнение документа.
		Если Параметры.Свойство("ЗначенияЗаполнения") И Параметры.ЗначенияЗаполнения.Свойство("Группа") Тогда
			// Задана группа учреждения, необходимо установить график работы по ней.
			Объект.Группа = Параметры.ЗначенияЗаполнения.Группа;
			ЗаполнитьГрафикРаботыПоГруппе();
		Иначе
			Объект.ГрафикРаботы = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
		КонецЕсли;
		
		Объект.ВидТабеля = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ТабельУчетаПосещаемостиРодительскаяПлата_ВидТабеля", "ВидТабеля", 0);

		Объект.НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
		Объект.КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
		
		ЗаполнитьДниМесяца();
		Объект.КоличествоДнейВМесяце = КалендарьДнейВМесяце;
		Объект.КоличествоРабочихДней = КалендарьРабочихДней;
		
	Иначе
		ЗаполнитьДниМесяца();
		ДействующийДокумент = РодительскаяПлата.ПолучитьКорректирующийТабельУчетаПосещаемости(Объект.Ссылка);
	КонецЕсли;
	
	УстановитьВидимостьРедакцииДокумента();
	
	НастроитьТабличнуюЧастьТабеля();
	
	ПредЗначениеГруппа = Объект.Группа;
	ТекущееЗначениеВидУслуг = Объект.РодительскаяПлатаДопУслуги;
	
	УстановитьУсловноеОформление();
	
	// Централизованная бухгалтерия
	ЗаполнениеРеквизитовОбъектов.ОпределитьПараметрыВыбораСотрудников(ЭтотОбъект, Объект.Организация);
	// Конец Централизованная бухгалтерия
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);

	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);

	// СтандартныеПодсистемы.УчетОригиналовПервчиныхДокументов
	УчетОригиналовПервичныхДокументов.ПриСозданииНаСервере_ФормаДокумента(ЭтотОбъект, Элементы.Подвал);
	// Конец СтандартныеПодсистемы.УчетОригиналовПервчиныхДокументов 

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьВидТабеля();
	
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставление(ЭтотОбъект, "Объект.НачалоПериода", "НачалоПериодаСтрокой", Отказ);
	
	УстановитьПредупреждение();
	
	ПересчитатьИтоги();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ТабельУчетаПосещаемостиРодительскаяПлата_ВидТабеля", "ВидТабеля", Объект.ВидТабеля);
	
	ОбщегоНазначенияБГУ.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);

КонецПроцедуры

