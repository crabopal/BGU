&НаКлиенте
Процедура РодительскаяПлатаДопУслугиПриИзменении(Элемент)
	
	Перем НовоеЗначениеВидУслуг;
	
	Если ТекущееЗначениеВидУслуг <> НовоеЗначениеВидУслуг Тогда
		Если Объект.ДанныеОПосещениях.Количество() > 0 Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ТекущееЗначениеПереключателя", ТекущееЗначениеВидУслуг);
			
			Оповещение = Новый ОписаниеОповещения("ПриИзмененииПереключателяРодПлатаДопУслуги", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, НСтр("ru='Табличная часть будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Иначе
			ТекущееЗначениеВидУслуг = Объект.РодительскаяПлатаДопУслуги;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

