&НаКлиенте
Процедура ЗаполнитьТабель(Команда)
		
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Текст = НСтр("ru = 'Не указана организация, заполнение невозможно!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст, , "Организация", "Объект");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Группа) Тогда
		Текст = Нстр("ru='Не указана группа по услуге, заполнение невозможно!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст, , "Группа", "Объект");
		Возврат;
	КонецЕсли;
	
	Если Объект.ДанныеОПосещениях.Количество() > 0 Тогда 
		Оповещение = Новый ОписаниеОповещения("ВопросОбОчисткеТЧ", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Табель будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьТаблицу();
	КонецЕсли;
	
	ПересчитатьИтоги();
КонецПроцедуры

