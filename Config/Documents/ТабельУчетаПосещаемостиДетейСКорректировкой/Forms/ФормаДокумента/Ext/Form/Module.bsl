&НаКлиенте
Процедура ВидТабеляПриИзменении(Элемент)
	
	Если Объект.ВидТабеля = 0 Тогда
		// При переключении на табель по дням необходимо очистить общее количество отсуствий
		Для Каждого СтрокаТЧ Из Объект.ДанныеОПосещениях Цикл
			ОплНевыходы = 0;
			НеоплНевыходы = 0;
			ВсегоПосещений = 0;
			Для Сч = 1 По Объект.КоличествоДнейВМесяце Цикл
				Если СтрокаТЧ["ВидЗаписиТабеля"+Сч] = ВидЗаписиОпл Тогда
					ОплНевыходы = ОплНевыходы + 1;
				ИначеЕсли СтрокаТЧ["ВидЗаписиТабеля"+Сч] = ВидЗаписиНеопл Тогда
					НеоплНевыходы = НеоплНевыходы + 1;
				ИначеЕсли СтрокаТЧ["ВидЗаписиТабеля"+Сч] = ВидЗаписиПустая Тогда
					ВсегоПосещений = ВсегоПосещений + 1;
				КонецЕсли;	
			КонецЦикла;
			
			СтрокаТЧ.ОплНевыходы = ОплНевыходы;
			СтрокаТЧ.НеоплНевыходы = НеоплНевыходы;
			СтрокаТЧ.ВсегоПосещений = ВсегоПосещений;
		КонецЦикла;
	КонецЕсли;
	
	УстановитьВидТабеля();
		
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.ДанныеОПосещениях.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		
		ДопПараметры = Новый Структура("Выбор", Истина);
		Оповещение = Новый ОписаниеОповещения("ЗапроситьИзменениеОрганизации", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru='Табель будет очищен. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);	
	КонецЕсли;
	
КонецПроцедуры

