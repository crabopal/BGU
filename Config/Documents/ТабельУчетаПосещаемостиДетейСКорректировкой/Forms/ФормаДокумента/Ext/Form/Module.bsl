&НаКлиенте
Процедура ДанныеОПосещенияхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Форма = ?(Объект.РодительскаяПлатаДопУслуги = 0, "Справочник.Дети.Форма.ФормаВыбора", "Справочник.Дети.Форма.ФормаВыбораДопУслуги");
	
	Отбор = Новый Структура;
	Отбор.Вставить("НаДату", Объект.НачалоПериода);
	Отбор.Вставить("ГруппаДетскогоУчреждения", Объект.Группа);
	Отбор.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Элемент", Элемент);
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборРебенка", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму(Форма, ПараметрыФормы, Элемент, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

	
КонецПроцедуры

&НаКлиенте
Процедура ДанныеОПосещенияхОплНевыходыПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДанныеОПосещениях.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
	
		ПосещенийБезНевыходов = РассчитатьИтогиПоСтрокеСводно(ТекДанные);
		Если ПосещенийБезНевыходов >=0 Тогда 
			ТекДанные.ВсегоПосещений = ПосещенийБезНевыходов;
		Иначе
			ТекстСообщения = НСтр("ru = 'Недопустимое значение: указанное количество невыходов превышает общее количество дней в строке'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , Элемент.Имя + "[" + ТекДанные.НомерСтроки + "].ОплНевыходы");
			
			ТекДанные.ОплНевыходы = ТекущееЗначениеОплНевыходы;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

