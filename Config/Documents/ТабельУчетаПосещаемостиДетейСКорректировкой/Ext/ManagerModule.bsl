Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, ДополнительныеСвойства) Экспорт

	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "НачалоПериода, Основание, ВидТабеля");  
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИсправляемыйДокумент", РеквизитыДокумента.Основание);
	
	Если РеквизитыДокумента.ВидТабеля = 0 Тогда
		
		НачалоПериода 	= НачалоМесяца(РеквизитыДокумента.НачалоПериода);
		ГодТабеля 		= Год(НачалоПериода);
		МесяцТабеля 	= Месяц(НачалоПериода);
		ДнейВМесяце 	= День(КонецМесяца(НачалоПериода));
		
		ТекстыЗапроса = Новый Массив;
		
		Для ДеньТабеля = 1 По ДнейВМесяце Цикл
			
			ТекстыЗапроса.Добавить(ТекстЗапросаТабельУчетаПосещаемостиДетейСКорректировкой(ДеньТабеля));
			
			Если ЗначениеЗаполнено(РеквизитыДокумента.Основание) Тогда
				ТекстыЗапроса.Добавить(ТекстЗапросаТабельУчетаПосещаемостиДетейСКорректировкойСторно(ДеньТабеля));
			КонецЕсли;
			
			ИмяПараметраПериод 	= СтрШаблон("Период%1", ДеньТабеля);
			ПараметрПериод 		= Дата(ГодТабеля, МесяцТабеля, ДеньТабеля);
			
			Запрос.УстановитьПараметр(ИмяПараметраПериод, ПараметрПериод);
			
		КонецЦикла;
		
		ТекстЗапроса = СтрСоединить(ТекстыЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС);
	
	Иначе
		
		ТекстЗапроса = ТекстЗапросаТабельУчетаПосещаемостиДетейСКорректировкойСводный();
		Запрос.УстановитьПараметр("УсловиеСторно", ЗначениеЗаполнено(РеквизитыДокумента.Основание));
		Запрос.УстановитьПараметр("Период", КонецМесяца(РеквизитыДокумента.НачалоПериода));
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	ДополнительныеСвойства.ТаблицыДляДвижений.Вставить("ТабельУчетаПосещаемостиДетейСКорректировкой", Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетейСКорректировкой";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0504608_103н";
	КомандаПечати.Представление		= НСтр("ru = 'Табель учета посещаемости детей (ф. 0504608), ред.103н'");
	КомандаПечати.Порядок			= 1;

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ТабельУчетаПосещаемостиДетейСКорректировкой";
	КомандаПечати.Идентификатор		= "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно";
	КомандаПечати.Представление		= НСтр("ru = 'Табель учета посещаемости детей (сводно)'");
	КомандаПечати.Порядок			= 2;
    
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0504608_103н") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		"ПФ_MXL_Форма0504608_103н",
		"Табель учета посещаемости детей (ф.0504608), ред.103н",
		ПечатьТабеля(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Форма0504608_103н"));
	КонецЕсли;	
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно",
			"Табель учета посещаемости детей (сводно)",
			ПечатьТабеляСводно(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ТабельУчетаПосещаемостиДетейСводно"));
	КонецЕсли;
		
КонецПроцедуры // Печать()

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

