#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	РеквизитыСчетаДт = Новый Структура("Счет, КПС, КЭК, Подразделение, Субконто1, Субконто2, Субконто3",
		"СчетДт", "КПСДт", "КЭКДт", "ПодразделениеДт", "СубконтоДт1", "СубконтоДт2", "СубконтоДт3");
	БухгалтерскийУчет.ПроверитьЗаполнениеСчетаИАналитики(РеквизитыСчетаДт,
		ЭтотОбъект, "ДвиженияДокумента", Отказ);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ДвиженияДокумента.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	// Инициализация дополнительных свойств для проведения документа
	ПроведениеСервер.ИнициализироватьДополнительныеСвойстваДляПроведения(Ссылка, ДополнительныеСвойства);
	
	// Подготовка наборов записей
	ПроведениеСервер.ПодготовитьНаборыЗаписейКРегистрацииДвижений(ЭтотОбъект);
	
	// Запись наборов записей
	ПроведениеСервер.ЗаписатьНаборыЗаписей(ЭтотОбъект);
	
	ПроведениеСервер.ОчиститьДополнительныеСвойстваДляПроведения(ДополнительныеСвойства);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьДокумент() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ДвиженияДокумента.Очистить();
	
	СтруктураПараметров = Новый Структура("Организация, Дата, КФО, ИФО", Организация, Дата, КФО, ИФО);
	ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль = НалоговыйУчет.ПодготовитьТаблицуРасчетыСБюджетомПоНалогуНаПрибыль(СтруктураПараметров);
	
	Если НалоговыйУчетКлиентСервер.НачислениеНалогаНаПрибыльПоКЭК189(Дата) Тогда
		ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.Колонки.Добавить("КЭКДт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
		ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль.ЗаполнитьЗначения(БухгалтерскийУчетПовтИсп.КЭКПоКоду("189"), "КЭКДт");
	КонецЕсли;
	
	ДвиженияДокумента.Загрузить(ТаблицаРасчетыСБюджетомПоНалогуНаПрибыль);
	
	Для Каждого СтрокаТаблицы Из ДвиженияДокумента Цикл
		СтрокаТаблицы.НалогСборПлатеж = Документы.РасчетНалогаНаПрибыль.НалогСборПлатежПоУмолчанию(Организация, СтрокаТаблицы.ВидНалога);
	КонецЦикла;
	
КонецПроцедуры

Процедура РаспределитьНалогПоДоходам() Экспорт
	
	Если Проведен Тогда
		Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
	ТаблицаНалогНаПрибыль = ДвиженияДокумента.Выгрузить(,"ИФО,КФО,ВидНалога,НалогСборПлатеж,Сумма");
	ТаблицаНалогНаПрибыль.Свернуть("ИФО,КФО,ВидНалога,НалогСборПлатеж", "Сумма");
	
	СтруктураПараметров = Новый Структура("Организация, Дата, КФО, ИФО", Организация, Дата, КФО, ИФО);
	НалогНаПрибыльРаспределенный = НалоговыйУчет.РаспределитьНалогНаПрибыльПоДоходам(СтруктураПараметров, ТаблицаНалогНаПрибыль);
	
	ДвиженияДокумента.Загрузить(НалогНаПрибыльРаспределенный);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
