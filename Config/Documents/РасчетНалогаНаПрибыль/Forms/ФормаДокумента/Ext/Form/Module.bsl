&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВалютаРубли = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	ОбновитьСтавкиНалогаНаФорме();
	
	ДвиженияДокументаЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтавкиНалогаНаФорме()
	
	СтавкаФБ = 0;
	СтавкаРФ = 0;
	НалоговыйУчет.ПолучитьСтавкуНалогаНаПрибыль(Объект, СтавкаФБ, СтавкаРФ);
	
	НадписьСтавкиНалогаНаПрибыль = НСтр("ru = 'Налоговые ставки: в федеральный бюджет %1%, в бюджет субъекта РФ %2%'");
	Элементы.НадписьСтавкиНалогаНаПрибыль.Заголовок = 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НадписьСтавкиНалогаНаПрибыль,
			СтавкаФБ*100, СтавкаРФ*100);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДокументНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьДокумент();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура РаспределитьПоДоходамНаСервере()
	
	ЗаблокироватьДанныеФормыДляРедактирования();
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.РаспределитьНалогПоДоходам();
	
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	
	ДвиженияДокументаЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

