#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СсылкиНаОплатуЧерезПлатежнуюСистему") Тогда
		ЗаполнитьПоСсылкиНаОплатуЧерезПлатежнуюСистему(ДанныеЗаполнения);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоСсылкиНаОплатуЧерезПлатежнуюСистему(ДокументОснование)
	
	ЗаполняемыеДанные = "Организация, ПараметрыДоговораЭквайринга, НоменклатураПлатежа";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	
	ТекстСообщения = "";
	Если НЕ ЗначениеЗаполнено(ДанныеДокументаОснования.Организация) Тогда 
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'Не заполнено поле ""Организация"".'") + Символы.ПС;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ДанныеДокументаОснования.ПараметрыДоговораЭквайринга) Тогда 
		ТекстСообщения = ТекстСообщения + НСтр("ru = 'Не заполнено поле ""Параметры договора и операций эквайринга"".'");
	КонецЕсли;
	
	Если ТекстСообщения <> "" Тогда 
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	ЭтотОбъект.ДокументОснование = ДокументОснование;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеДокументовСсылкиНаОплату.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ДанныеДокументовСсылкиНаОплату.ЭквайринговаяОперация КАК ЭквайринговаяОперация
	               |ИЗ
	               |	РегистрСведений.ДанныеДокументовСсылкиНаОплату КАК ДанныеДокументовСсылкиНаОплату
	               |ГДЕ
	               |	ДанныеДокументовСсылкиНаОплату.Документ.Ссылка = &Документ";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документ", ДокументОснование);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из РезультатЗапроса Цикл 
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ЭквайринговаяОперация) Тогда 
			СтрокаДанных = ДокументОснование.СсылкиНаОплату.Найти(СтрокаТаблицы.ИдентификаторСтроки);
			Если Не СтрокаДанных = Неопределено Тогда 
				НоваяСтрока = ЭтотОбъект.СсылкиНаОплату.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
				НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли