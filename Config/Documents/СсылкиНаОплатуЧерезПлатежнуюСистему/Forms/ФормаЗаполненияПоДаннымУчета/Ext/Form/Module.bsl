
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Организация	= Параметры.Организация;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ДанныеНачислений.Количество() > 0 И НЕ ЗакрытьФорму И НЕ ПеренестиДанные Тогда 
		ТекстВопроса 	= НСтр("ru = 'Данные начислений не будут перенесены в документ. Закрыть форму?'");
		Оповещение 		= Новый ОписаниеОповещения("ЗакрытьФормуЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		Отказ = Истина;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	Если ДанныеНачислений.Количество() = 0 Тогда  
		ПеренестиДанные = Истина; 
		Закрыть();
	Иначе
		ПеренестиДанные = Истина;
		АдресДанныхВхранилище = ПоместитьДанныеВхранилище();
		Закрыть(АдресДанныхВхранилище);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПлановыеДатыОплатыОбразованиеСрезПоследних.Учащийся КАК Учащийся,
	               |	ПлановыеДатыОплатыОбразованиеСрезПоследних.Сумма КАК Сумма,
	               |	ПараметрыСписанияДоходовБудущихПериодовСрезПоследних.Договор КАК ДоговорСвязи,
	               |	ПлановыеДатыОплатыОбразованиеСрезПоследних.Валюта КАК Валюта,
	               |	ПлановыеДатыОплатыОбразованиеСрезПоследних.Договор КАК Договор
	               |ПОМЕСТИТЬ ВТДанныеНачислений
	               |ИЗ
	               |	РегистрСведений.ПлановыеДатыОплатыОбразование.СрезПоследних(&Дата, ДатаОплаты МЕЖДУ &НачалоПериода И &КонецПериода) КАК ПлановыеДатыОплатыОбразованиеСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(&Дата, ) КАК ПараметрыСписанияДоходовБудущихПериодовСрезПоследних
	               |		ПО ПлановыеДатыОплатыОбразованиеСрезПоследних.Договор = ПараметрыСписанияДоходовБудущихПериодовСрезПоследних.Договор
	               |ГДЕ
	               |	ПлановыеДатыОплатыОбразованиеСрезПоследних.Сумма > 0
	               |	И &УсловиеФакультет
	               |	И ПлановыеДатыОплатыОбразованиеСрезПоследних.Договор.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ПлательщикиПоДоговоруОбразованиеСрезПоследних.Контрагент ЕСТЬ NULL
	               |			ТОГДА ВТДанныеНачислений.Сумма
	               |		ИНАЧЕ ВТДанныеНачислений.Сумма / 100 * ПлательщикиПоДоговоруОбразованиеСрезПоследних.ДоляОплаты
	               |	КОНЕЦ КАК Сумма,
	               |	ВТДанныеНачислений.Договор КАК Договор,
	               |	ЕСТЬNULL(ПлательщикиПоДоговоруОбразованиеСрезПоследних.Контрагент, ВТДанныеНачислений.Учащийся.Контрагент) КАК Контрагент,
	               |	ВТДанныеНачислений.Учащийся КАК Учащийся,
	               |	ВТДанныеНачислений.Валюта КАК Валюта
	               |ПОМЕСТИТЬ ВТНачисленияИПлательщики
	               |ИЗ
	               |	ВТДанныеНачислений КАК ВТДанныеНачислений
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(&Дата, ) КАК ПлательщикиПоДоговоруОбразованиеСрезПоследних
	               |		ПО ВТДанныеНачислений.Учащийся = ПлательщикиПоДоговоруОбразованиеСрезПоследних.Студент
	               |ГДЕ
	               |	ПлательщикиПоДоговоруОбразованиеСрезПоследних.Активность = ИСТИНА
	               |	И (ВТДанныеНачислений.ДоговорСвязи ЕСТЬ NULL) = &УсловиеТипДоговора
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВТНачисленияИПлательщики.Валюта = &РегламентнаяВалюта
	               |			ТОГДА ВТНачисленияИПлательщики.Сумма
	               |		ИНАЧЕ ВЫРАЗИТЬ(ВТНачисленияИПлательщики.Сумма * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) / ЕСТЬNULL(КурсыВалютСрезПоследних.Кратность, 1) КАК ЧИСЛО(15, 2))
	               |	КОНЕЦ КАК Сумма,
	               |	ВТНачисленияИПлательщики.Договор КАК Договор,
	               |	ВТНачисленияИПлательщики.Контрагент КАК Контрагент,
	               |	ВТНачисленияИПлательщики.Учащийся КАК Учащийся
	               |ИЗ
	               |	ВТНачисленияИПлательщики КАК ВТНачисленияИПлательщики
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дата, ) КАК КурсыВалютСрезПоследних
	               |		ПО ВТНачисленияИПлательщики.Валюта = КурсыВалютСрезПоследних.Валюта";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Дата"				, Период.ДатаОкончания); 
	Запрос.УстановитьПараметр("НачалоПериода"		, Период.ДатаНачала);
    Запрос.УстановитьПараметр("КонецПериода"		, Период.ДатаОкончания);  
	Запрос.УстановитьПараметр("Организация"			, Организация); 
	Запрос.УстановитьПараметр("РегламентнаяВалюта"	, ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета());
	Если ЗначениеЗаполнено(Факультет) Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеФакультет", "ПлановыеДатыОплатыОбразованиеСрезПоследних.Факультет = &Факультет");
		Запрос.УстановитьПараметр("Факультет", Факультет);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеФакультет", "ИСТИНА");
	КонецЕсли;
	Если ТипДоговора = 0 Тогда 
		Запрос.УстановитьПараметр("УсловиеТипДоговора", Ложь);
	Иначе 
		Запрос.УстановитьПараметр("УсловиеТипДоговора", Истина);
	КонецЕсли;	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ДанныеНачислений.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

&НаСервере 
Функция ПоместитьДанныеВхранилище()
	
	ТаблицаНачислений 		= ДанныеНачислений.Выгрузить();
	АдресДанныхВХранилище 	= ПоместитьВоВременноеХранилище(ТаблицаНачислений, УникальныйИдентификатор);
	Возврат АдресДанныхВХранилище;
	
КонецФункции	

&НаКлиенте
Процедура ЗакрытьФормуЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда 
		ЗакрытьФорму = Истина;
		ЭтаФорма.Закрыть();
	КонецЕсли;	
		
КонецПроцедуры		
		
#КонецОбласти
