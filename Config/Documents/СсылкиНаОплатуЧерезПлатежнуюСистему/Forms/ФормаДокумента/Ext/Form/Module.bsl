&НаСервере
Процедура ЗаполнитьПоДокументуНаСервере(Регистратор)
	
	Объект.СсылкиНаОплату.Очистить();
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПлановыеДатыОплатыРодительскойПлаты.Сумма КАК Сумма,
	               |	ПлановыеДатыОплатыРодительскойПлаты.ДоговорКонтрагента КАК Договор,
	               |	ЕСТЬNULL(ПлательщикиПоУслугамДДУСрезПоследних.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	               |	ПлановыеДатыОплатыРодительскойПлаты.Ребенок КАК Учащийся
	               |ИЗ
	               |	РегистрСведений.ПлановыеДатыОплатыРодительскойПлаты КАК ПлановыеДатыОплатыРодительскойПлаты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&Дата, ) КАК ПлательщикиПоУслугамДДУСрезПоследних
	               |		ПО ПлановыеДатыОплатыРодительскойПлаты.Ребенок = ПлательщикиПоУслугамДДУСрезПоследних.Ребенок
	               |ГДЕ
	               |	ПлановыеДатыОплатыРодительскойПлаты.Регистратор = &Регистратор
	               |	И ПлановыеДатыОплатыРодительскойПлаты.Активность = ИСТИНА";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Регистратор"	, Регистратор);
	Запрос.УстановитьПараметр("Дата"		, Регистратор.Дата);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл 
		НоваяСтрока = Объект.СсылкиНаОплату.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, РезультатЗапроса);
		НоваяСтрока.НоменклатураПлатежа = Объект.НоменклатураПлатежа;
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		
		КонтактнаяИнформация 	= ПолучитьАдресТелефонКонтрагента(НоваяСтрока.Контрагент);
		ТелефонКонтрагента 		= КонтактнаяИнформация.Телефон;
		АдресПочтыКонтрагента 	= КонтактнаяИнформация.Почта;
		НоваяСтрока.КонтактнаяИнформация 		= ТелефонКонтрагента;
		НоваяСтрока.ВидКонтактнойИнформации 	= 0;
		Если ЗначениеЗаполнено(АдресПочтыКонтрагента) Тогда
			НоваяСтрока.КонтактнаяИнформация 	= АдресПочтыКонтрагента;
			НоваяСтрока.ВидКонтактнойИнформации = 1;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкиНаОплатуОбработкаЗаполненияПоДокументуЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораДокумента", ЭтотОбъект);
		Режим 					= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыОтбора 		= Новый Структура("Организация", Объект.Организация);
		ПараметрыФормы 			= Новый Структура;
		ПараметрыФормы.Вставить("Отбор"			, ПараметрыОтбора);
		ПараметрыФормы.Вставить("РежимВыбора"	, Истина);
		ОткрытьФорму("Документ.ПлановыеПоступленияОплатыРодительскаяПлата.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,, ОбработчикОповещения, Режим);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораДокумента(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		ЗаполнитьПоДокументуНаСервере(РезультатОткрытияФормы);
		Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура СсылкиНаОплатуОбработкаЗаполненияПоДаннымУчетаЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуЗаполненияПоДаннымУчета", ЭтотОбъект);
		Режим 					= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы 			= Новый Структура("Организация"	, Объект.Организация);
		ОткрытьФорму("Документ.СсылкиНаОплатуЧерезПлатежнуюСистему.Форма.ФормаЗаполненияПоДаннымУчета", ПараметрыФормы, ЭтаФорма,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуЗаполненияПоДаннымУчета(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		Объект.СсылкиНаОплату.Очистить();
		ЗаполнитьТаблицуИзХранилища(РезультатОткрытияФормы);
		Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуИзХранилища(АдресВХранилище)
	
	ДанныеЗаполнения = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Объект.СсылкиНаОплату.Загрузить(ДанныеЗаполнения);
	
	Для Каждого СтрокаТаблицы Из Объект.СсылкиНаОплату Цикл 
		СтрокаТаблицы.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		СтрокаТаблицы.НоменклатураПлатежа = Объект.НоменклатураПлатежа;
		КонтактнаяИнформация 	= ПолучитьАдресТелефонКонтрагента(СтрокаТаблицы.Контрагент);
		ТелефонКонтрагента 		= КонтактнаяИнформация.Телефон;
		АдресПочтыКонтрагента 	= КонтактнаяИнформация.Почта;
		СтрокаТаблицы.КонтактнаяИнформация 		= ТелефонКонтрагента;
		СтрокаТаблицы.ВидКонтактнойИнформации 	= 0;
		Если ЗначениеЗаполнено(АдресПочтыКонтрагента) Тогда
			СтрокаТаблицы.КонтактнаяИнформация 		= АдресПочтыКонтрагента;
			СтрокаТаблицы.ВидКонтактнойИнформации 	= 1;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДоговорЭквайринга()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораОплатыПоQRКоду КАК ПараметрыДоговораОплатыПоQRКоду
	               |ИЗ
	               |	РегистрСведений.НастройкиЭквайрингаДляРабочихМест КАК НастройкиЭквайрингаДляРабочихМест
	               |ГДЕ
	               |	НастройкиЭквайрингаДляРабочихМест.РабочееМесто = &РабочееМесто";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто); 
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда 
		Объект.ПараметрыДоговораЭквайринга = РезультатЗапроса.ПараметрыДоговораОплатыПоQRКоду;
	КонецЕсли;
	УстановитьЗаголовкиДоступностьЭлементовНастройкиСБП();
	
КонецПроцедуры	

&НаКлиенте
Функция ПроверитьЗаполенниеРеквизитовДляСсылки()
	
	РеквизитыЗаполнены = Истина;
	Для Каждого СтрокаТаблицы Из Объект.СсылкиНаОплату Цикл 
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Контрагент) Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не заполнен реквизит ""Плательщик""'"), СтрокаТаблицы.НомерСтроки);
			Сообщить(ТекстСообщения);
			РеквизитыЗаполнены = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НоменклатураПлатежа) Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не заполнен реквизит ""Номенклатура платежа""'"), СтрокаТаблицы.НомерСтроки);
			Сообщить(ТекстСообщения);
			РеквизитыЗаполнены = Ложь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сумма) Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не заполнен реквизит ""Сумма""'"), СтрокаТаблицы.НомерСтроки);
			Сообщить(ТекстСообщения);
			РеквизитыЗаполнены = Ложь;
		КонецЕсли;
	КонецЦикла;	
	Возврат РеквизитыЗаполнены;
	
КонецФункции	

&НаКлиенте
Функция ПроверитьЗаполенниеРеквизитовДляОтправки()
	
	РеквизитыЗаполнены = Истина;
	Для Каждого СтрокаТаблицы Из Объект.СсылкиНаОплату Цикл 
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КонтактнаяИнформация) Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %1 не заполнен реквизит ""Контактные данные""'"), СтрокаТаблицы.НомерСтроки);
			Сообщить(ТекстСообщения);
			РеквизитыЗаполнены = Ложь;
		КонецЕсли;
	КонецЦикла;	
	Возврат РеквизитыЗаполнены;
	
КонецФункции	

&НаСервере
Процедура УдалитьСтрокиИзРегистра()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ДанныеДокументовСсылкиНаОплату.Документ КАК Документ,
	               |	ДанныеДокументовСсылкиНаОплату.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ДанныеДокументовСсылкиНаОплату.СсылкаНаОплату КАК СсылкаНаОплату,
	               |	ДанныеДокументовСсылкиНаОплату.СчетНаОплату КАК СчетНаОплату,
	               |	ДанныеДокументовСсылкиНаОплату.Примечание КАК Примечание,
	               |	ДанныеДокументовСсылкиНаОплату.СтатусОплаты КАК СтатусОплаты,
	               |	ДанныеДокументовСсылкиНаОплату.ЭквайринговаяОперация КАК ЭквайринговаяОперация,
	               |	ДанныеДокументовСсылкиНаОплату.СсылкаОтправлена КАК СсылкаОтправлена
	               |ИЗ
	               |	РегистрСведений.ДанныеДокументовСсылкиНаОплату КАК ДанныеДокументовСсылкиНаОплату
	               |ГДЕ
	               |	ДанныеДокументовСсылкиНаОплату.Документ = &Документ
	               |	И ДанныеДокументовСсылкиНаОплату.ИдентификаторСтроки В(&ИдентификаторыСтроки)";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документ"			, Объект.Ссылка);
	Запрос.УстановитьПараметр("ИдентификаторыСтроки", Объект.СсылкиНаОплату.Выгрузить().ВыгрузитьКолонку("ИдентификаторСтроки"));
    РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = РегистрыСведений.ДанныеДокументовСсылкиНаОплату.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Документ.Установить(Объект.Ссылка);
	НаборЗаписей.Загрузить(РезультатЗапроса);
	НаборЗаписей.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеКолонки()
	
	СформированоСсылок 	= 0;
	ОтправленоСсылок 	= 0;
	ОплаченоСсылок		= 0;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеДокументовСсылкиНаОплату.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	ДанныеДокументовСсылкиНаОплату.СсылкаНаОплату КАК СсылкаНаОплату,
	               |	ДанныеДокументовСсылкиНаОплату.СчетНаОплату КАК СчетНаОплату,
	               |	ДанныеДокументовСсылкиНаОплату.Примечание КАК Примечание,
	               |	ДанныеДокументовСсылкиНаОплату.СтатусОплаты КАК СтатусОплаты,
	               |	ДанныеДокументовСсылкиНаОплату.ЭквайринговаяОперация КАК ЭквайринговаяОперация,
	               |	ДанныеДокументовСсылкиНаОплату.СсылкаОтправлена КАК СсылкаОтправлена
	               |ИЗ
	               |	РегистрСведений.ДанныеДокументовСсылкиНаОплату КАК ДанныеДокументовСсылкиНаОплату
	               |ГДЕ
	               |	ДанныеДокументовСсылкиНаОплату.Документ.Ссылка = &Документ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Документ", Объект.Ссылка);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДанных Из РезультатЗапроса Цикл                   
		ПараметрыОтбора = Новый Структура("ИдентификаторСтроки", СтрокаДанных.ИдентификаторСтроки);
		СтрокиТаблицы = Объект.СсылкиНаОплату.НайтиСтроки(ПараметрыОтбора);
		Если СтрокиТаблицы.Количество() > 0 Тогда 
			ЗаполнитьЗначенияСвойств(СтрокиТаблицы[0], СтрокаДанных);			
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СтрокаДанных.СсылкаНаОплату) Тогда 
			СформированоСсылок = СформированоСсылок + 1;			
		КонецЕсли;
		Если СтрокаДанных.СсылкаОтправлена Тогда 
			ОтправленоСсылок = ОтправленоСсылок + 1;			
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаДанных.ЭквайринговаяОперация) Тогда 
			ОплаченоСсылок = ОплаченоСсылок + 1;			
		КонецЕсли;
	КонецЦикла;	 
	
	ВсегоСтрок 			= Объект.СсылкиНаОплату.Количество();
    СсылкиСформировано 	= "сформировано - " + СформированоСсылок + "/" + ВсегоСтрок;
	СсылкиОтправлено 	= "отправлено - " + ОтправленоСсылок + "/" + ВсегоСтрок;
	СсылкиОплачено 		= "оплачено - " + ОплаченоСсылок + "/" + ВсегоСтрок;  
	СсылкиИтог 			= СсылкиСформировано + " " + СсылкиОтправлено + " " + СсылкиОплачено;

КонецПроцедуры
	
