&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСсылкиНаОплату

&НаКлиенте
Процедура СсылкиНаОплатуПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		Элемент.ТекущиеДанные.НоменклатураПлатежа 	= Объект.НоменклатураПлатежа;
	КонецЕсли;
	
	Если НоваяСтрока Или Копирование Тогда 
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкиНаОплатуКонтрагентПриИзменении(Элемент)
	
	ТекущиеДанные 			= Элементы.СсылкиНаОплату.ТекущиеДанные;
	Контрагент 				= ТекущиеДанные.Контрагент;
	КонтактнаяИнформация 	= ПолучитьАдресТелефонКонтрагента(Контрагент);
	ТелефонКонтрагента 		= КонтактнаяИнформация.Телефон;
	АдресПочтыКонтрагента 	= КонтактнаяИнформация.Почта;
	ТекущиеДанные.КонтактнаяИнформация 		= ТелефонКонтрагента;
	ТекущиеДанные.ВидКонтактнойИнформации 	= 0;
	Если ЗначениеЗаполнено(АдресПочтыКонтрагента) Тогда
		ТекущиеДанные.КонтактнаяИнформация 		= АдресПочтыКонтрагента;
		ТекущиеДанные.ВидКонтактнойИнформации 	= 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкиНаОплатуКонтактнаяИнформацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Контрагент = Элементы.СсылкиНаОплату.ТекущиеДанные.Контрагент;
	
	СписокВыбора = Элемент.СписокВыбора;
	СписокВыбора.Очистить();
	
	КонтактнаяИнформация 	= ПолучитьАдресТелефонКонтрагента(Контрагент);
	АдресПочтыКонтрагента 	= КонтактнаяИнформация.Почта;
	ТелефонКонтрагента 		= КонтактнаяИнформация.Телефон;
	Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
		СписокВыбора.Добавить(ТелефонКонтрагента);
	КонецЕсли;
	Если ЗначениеЗаполнено(АдресПочтыКонтрагента) Тогда
		СписокВыбора.Добавить(АдресПочтыКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СсылкиНаОплатуКонтактнаяИнформацияПриИзменении(Элемент)
	
	ВыбраннаяСтрока = Элемент.СписокВыбора.НайтиПоЗначению(Элемент.ТекстРедактирования);
	Если (НЕ ВыбраннаяСтрока = Неопределено) И Элемент.СписокВыбора.Количество() = 2 Тогда
		Элементы.СсылкиНаОплату.ТекущиеДанные.ВидКонтактнойИнформации = Элемент.СписокВыбора.Индекс(ВыбраннаяСтрока);
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьСсылкиНаСервере()
	
	ПараметрыОплаты		= Объект.СсылкиНаОплату.Выгрузить();
	ПараметрыОперации	= Новый Структура;
	ПараметрыОперации.Вставить("НастройкаСБП"				, НастройкаСБП);
	ПараметрыОперации.Вставить("ДокументСсылка" 			, Объект.Ссылка);
	ПараметрыОперации.Вставить("Организация" 				, Объект.Организация);
	ПараметрыОперации.Вставить("ПараметрыОплаты"			, ПараметрыОплаты);
	ПараметрыОперации.Вставить("ПараметрыДоговораЭквайринга", Объект.ПараметрыДоговораЭквайринга);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Документы.СсылкиНаОплатуЧерезПлатежнуюСистему.СформироватьСчетаИСсылкиДлительнаяОперация", ПараметрыОперации);
	
КонецФункции

&НаСервере
Процедура ПриЗавершенииФормированияСсылок(Результат, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьДополнительныеКолонки();
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовкиДоступностьЭлементовНастройкиСБП()
	
	НастройкаСБП = Справочники.НастройкиПодключенияКСистемеБыстрыхПлатежей.ПустаяСсылка();
	Если Не СистемаБыстрыхПлатежей.НастройкаПодключенияДоступна() Тогда
		Элементы.ДекорацияНастройкаСБП.Заголовок = НСтр("ru = 'Оплата через СБП не доступна'");
		Элементы.СсылкиНаОплатуГруппаСБП.Доступность = Ложь; 
		Возврат;
	КонецЕсли;
	
	НастройкиИнтеграции = ИнтеграцияССервисомПриемаПлатежейБГУ.НастройкиИнтеграцииСБП(Объект.Организация, Объект.ПараметрыДоговораЭквайринга);
	Если НастройкиИнтеграции.ИнтеграцияДоступна И НастройкиИнтеграции.Настройка <> Неопределено Тогда
		Элементы.ДекорацияНастройкаСБП.Заголовок = НСтр("ru = 'Подключение к СБП настроено'");
		Элементы.СсылкиНаОплатуГруппаСБП.Доступность = Истина;
		НастройкаСБП = НастройкиИнтеграции.Настройка;
	Иначе
		Элементы.ДекорацияНастройкаСБП.Заголовок = НСтр("ru = 'Не настроено подключение к СБП'");
		Элементы.СсылкиНаОплатуГруппаСБП.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТелефонКонтрагента(Контрагент)
	
	КонтактнаяИнформация = Новый Структура;
	КонтактнаяИнформация.Вставить("Почта"	, ПодключаемоеОборудованиеБГУВызовСервера.ПервыйАдресЭлектроннойПочтыПокупателя(Контрагент));
	КонтактнаяИнформация.Вставить("Телефон"	, ПодключаемоеОборудованиеБГУВызовСервера.ПервыйНомерТелефонаПокупателя(Контрагент));
	Возврат КонтактнаяИнформация;
	
КонецФункции

&НаСервере
Функция ОтправитьСсылкиПлательщикамНаСервере()

	ОтправкаSMSВозможна 	= ПроверитьВозможностьОтправкиSMS();
	ОтправкаEmailВозможна 	= ПроверитьВозможностьОтправкиEmail(); 
		
	ПараметрыОплаты		= Объект.СсылкиНаОплату.Выгрузить();
	ПараметрыОперации	= Новый Структура;
	ПараметрыОперации.Вставить("НастройкаСБП"				, НастройкаСБП);
	ПараметрыОперации.Вставить("ДокументСсылка" 			, Объект.Ссылка);
	ПараметрыОперации.Вставить("Организация" 				, Объект.Организация);
	ПараметрыОперации.Вставить("ПараметрыОплаты"			, ПараметрыОплаты);
	ПараметрыОперации.Вставить("ПараметрыДоговораЭквайринга", Объект.ПараметрыДоговораЭквайринга);  
	ПараметрыОперации.Вставить("ОтправкаSMSВозможна"		, ОтправкаSMSВозможна);
	ПараметрыОперации.Вставить("ОтправкаEmailВозможна"		, ОтправкаEmailВозможна);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "Документы.СсылкиНаОплатуЧерезПлатежнуюСистему.ОтправитьСсылкиДлительнаяОперация", ПараметрыОперации);	

КонецФункции 

&НаСервере
Процедура ПриЗавершенииОтправкиСсылок(Результат, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьДополнительныеКолонки();
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
		Возврат;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПроверитьВозможностьОтправкиSMS()
	
	ЕстьНомерТелефона = Ложь;
	Для Каждого СтрокаСсылка Из Объект.СсылкиНаОплату Цикл 
		Если ЗначениеЗаполнено(СтрокаСсылка.КонтактнаяИнформация) И СтрокаСсылка.ВидКонтактнойИнформации = 0 Тогда 
			ЕстьНомерТелефона = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	Если ЕстьНомерТелефона Тогда 
		ОтправкаSMSВозможна = Истина;
		Если Не ОтправкаSMS.ДоступнаОтправкаSMS() Тогда
			Сообщить(НСтр("ru = 'Отправка SMS не доступна!'") + Символы.ПС);
			ОтправкаSMSВозможна = Ложь;
		КонецЕсли;
		Если Не ОтправкаSMS.НастройкаОтправкиSMSВыполнена() Тогда
			Сообщить(НСтр("ru = 'Отправка SMS не настроена!'"));
			ОтправкаSMSВозможна = Ложь;
		КонецЕсли;	
	Иначе
		ОтправкаSMSВозможна = Ложь;
	КонецЕсли;
	Возврат ОтправкаSMSВозможна;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьОтправкиEmail() 
	
	ЕстьАдресПочты = Ложь;
	Для Каждого СтрокаСсылка Из Объект.СсылкиНаОплату Цикл 
		Если ЗначениеЗаполнено(СтрокаСсылка.КонтактнаяИнформация) И СтрокаСсылка.ВидКонтактнойИнформации = 1 Тогда 
			ЕстьАдресПочты = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	Если ЕстьАдресПочты Тогда 
		ОтправкаEmailВозможна = Истина;
		Если Не РаботаСПочтовымиСообщениями.ДоступнаОтправкаПисем() Тогда 
			Сообщить(НСтр("ru = 'Отправка писем не доступна!'") + Символы.ПС); 
			ОтправкаEmailВозможна = Ложь;
		КонецЕсли;
		Если Не РаботаСПочтовымиСообщениями.ПроверитьСистемнаяУчетнаяЗаписьДоступна() Тогда 
			Сообщить(НСтр("ru = 'Системная учетная запись для отправки писем не доступна!'") + Символы.ПС); 
			ОтправкаEmailВозможна = Ложь; 
		Иначе
			УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
			Если Не РаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(УчетнаяЗапись, Истина, Ложь) Тогда 
				Сообщить(НСтр("ru = 'Учетная запись для отправки писем не настроена!'") + Символы.ПС); 
				ОтправкаEmailВозможна = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе 
		ОтправкаEmailВозможна = Ложь;
	КонецЕсли;
	Возврат ОтправкаEmailВозможна;
		
КонецФункции

