Функция ПараметрыРасчета(Объект = Неопределено) Экспорт
	Результат = Новый Структура("НаДату, Организация, ДетскоеУчреждение, Ребенок, ИФО, СтарыйКПС, НовыйКПС");
	
	Если Объект <> Неопределено Тогда
		Результат.НаДату					= КонецДня(Объект.Дата);
		Результат.Организация				= Объект.Организация;
		Результат.ДетскоеУчреждение 		= Объект.ДетскоеУчреждение;
		Результат.ИФО						= Объект.ИФО;
		Результат.СтарыйКПС					= Объект.СтарыйКПС;
		Результат.НовыйКПС					= Объект.НовыйКПС;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция РассчитатьОстаткиКомпенсации(ПараметрЗаполнения) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетКомпенсацииРодительскойПлатыОстатки.НачалоПериода КАК НачалоПериода,
	|	УчетКомпенсацииРодительскойПлатыОстатки.ДетскоеУчреждение КАК ДетскоеУчреждение,
	|	УчетКомпенсацииРодительскойПлатыОстатки.Ребенок КАК Ребенок,
	|	УчетКомпенсацииРодительскойПлатыОстатки.Плательщик КАК Плательщик,
	|	УчетКомпенсацииРодительскойПлатыОстатки.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	УчетКомпенсацииРодительскойПлатыОстатки.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	УчетКомпенсацииРодительскойПлатыОстатки.КФО КАК КФО,
	|	УчетКомпенсацииРодительскойПлатыОстатки.СуммаКомпенсацииОстаток КАК СуммаКомпенсации
	|ИЗ
	|	РегистрНакопления.УчетКомпенсацииРодительскойПлаты.Остатки(&НаДату, &УсловияЗапроса) КАК УчетКомпенсацииРодительскойПлатыОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДетскоеУчреждение,
	|	Ребенок,
	|	НачалоПериода";
	
	УсловияЗапроса = Новый Массив;
	УсловияЗапроса.Добавить("Организация = &Организация");
	УсловияЗапроса.Добавить("КПС = &СтарыйКПС");
	Если ЗначениеЗаполнено(ПараметрЗаполнения.ДетскоеУчреждение) Тогда
		УсловияЗапроса.Добавить("ДетскоеУчреждение = &ДетскоеУчреждение");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрЗаполнения.Ребенок) Тогда
		УсловияЗапроса.Добавить("Ребенок = &Ребенок");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПараметрЗаполнения.ИФО) Тогда
		УсловияЗапроса.Добавить("ИФО = &ИФО");
	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияЗапроса", СтрСоединить(УсловияЗапроса, " И "));
	
	Запрос.УстановитьПараметр("НаДату",            	ПараметрЗаполнения.НаДату);
	Запрос.УстановитьПараметр("ИФО",                ПараметрЗаполнения.ИФО);
	Запрос.УстановитьПараметр("Организация",		ПараметрЗаполнения.Организация);
	Запрос.УстановитьПараметр("ДетскоеУчреждение",	ПараметрЗаполнения.ДетскоеУчреждение);
	Запрос.УстановитьПараметр("СтарыйКПС",          ПараметрЗаполнения.СтарыйКПС);
	Запрос.УстановитьПараметр("Ребенок",            ПараметрЗаполнения.Ребенок);
	
	ТаблицаКомпенсации = Запрос.Выполнить().Выгрузить();	
	Возврат ТаблицаКомпенсации;
	
КонецФункции

