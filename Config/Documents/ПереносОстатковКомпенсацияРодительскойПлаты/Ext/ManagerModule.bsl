Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
 
	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидДвиженияРасход", ВидДвиженияНакопления.Расход);
	Запрос.УстановитьПараметр("ВидДвиженияПриход", ВидДвиженияНакопления.Приход);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ВидДвиженияРасход КАК ВидДвижения,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Дата КАК Период,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Организация КАК Организация,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.ИФО КАК ИФО,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.СтарыйКПС КАК КПС,
	|	ТабЧасть.НачалоПериода КАК НачалоПериода,
	|	ТабЧасть.ДетскоеУчреждение КАК ДетскоеУчреждение,
	|	ТабЧасть.Ребенок КАК Ребенок,
	|	ТабЧасть.Плательщик КАК Плательщик,
	|	ТабЧасть.ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	ТабЧасть.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	ТабЧасть.КФО КАК КФО,
	|	ТабЧасть.СуммаКомпенсации КАК СуммаКомпенсации
	|ИЗ
	|	Документ.ПереносОстатковКомпенсацияРодительскойПлаты КАК ПереносОстатковКомпенсацияРодительскойПлаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереносОстатковКомпенсацияРодительскойПлаты.ПереносПоКПС КАК ТабЧасть
	|		ПО ПереносОстатковКомпенсацияРодительскойПлаты.Ссылка = ТабЧасть.Ссылка
	|ГДЕ
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ВидДвиженияПриход,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Дата,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Организация,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.ИФО,
	|	ПереносОстатковКомпенсацияРодительскойПлаты.НовыйКПС,
	|	ТабЧасть.НачалоПериода,
	|	ТабЧасть.ДетскоеУчреждение,
	|	ТабЧасть.Ребенок,
	|	ТабЧасть.Плательщик,
	|	ТабЧасть.ПроцентКомпенсации,
	|	ТабЧасть.НастройкаКомпенсации,
	|	ТабЧасть.КФО,
	|	ТабЧасть.СуммаКомпенсации
	|ИЗ
	|	Документ.ПереносОстатковКомпенсацияРодительскойПлаты КАК ПереносОстатковКомпенсацияРодительскойПлаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПереносОстатковКомпенсацияРодительскойПлаты.ПереносПоКПС КАК ТабЧасть
	|		ПО ПереносОстатковКомпенсацияРодительскойПлаты.Ссылка = ТабЧасть.Ссылка
	|ГДЕ
	|	ПереносОстатковКомпенсацияРодительскойПлаты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТаблицыДляДвижений.Вставить("УчетКомпенсацииРодительскойПлаты", Результат);

КонецПроцедуры

