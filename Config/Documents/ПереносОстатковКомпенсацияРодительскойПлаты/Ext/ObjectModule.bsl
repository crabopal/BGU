Процедура ЗаполнитьИзДанныхЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Дата", ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	НачалоПериода = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "НачалоПериода", НачалоМесяца(Дата));
	КонецПериода  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "КонецПериода",  КонецМесяца(Дата));
	
	РасчетЗаНесколькоМесяцев = НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода);

КонецПроцедуры

