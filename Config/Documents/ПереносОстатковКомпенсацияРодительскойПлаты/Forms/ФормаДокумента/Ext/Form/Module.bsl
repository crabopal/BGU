&НаСервере
Процедура ЗаполнитьНаСервере()

	ПараметрыРасчета = Документы.ПереносОстатковКомпенсацияРодительскойПлаты.ПараметрыРасчета(Объект);
	
	ТаблицаКомпенсации = Документы.ПереносОстатковКомпенсацияРодительскойПлаты.РассчитатьОстаткиКомпенсации(ПараметрыРасчета);
	Объект.ПереносПоКПС.Загрузить(ТаблицаКомпенсации);
	УстановитьПредупреждение(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСтроки(ИдентификаторСтроки)
	ТекущиеДанные = Объект.ПереносПоКПС.НайтиПоИдентификатору(ИдентификаторСтроки);

	ПараметрыРасчета = Документы.ПереносОстатковКомпенсацияРодительскойПлаты.ПараметрыРасчета(Объект);
	ПараметрыРасчета.ДетскоеУчреждение        = ТекущиеДанные.ДетскоеУчреждение;
	ПараметрыРасчета.Ребенок                  = ТекущиеДанные.Ребенок;
	
	ДанныеЗаполнения = Документы.ПереносОстатковКомпенсацияРодительскойПлаты.РассчитатьОстаткиКомпенсации(ПараметрыРасчета);
	Если ДанныеЗаполнения.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеЗаполнения[0]);
	Иначе
		ТекущиеДанные.КПС = Неопределено;
		ТекущиеДанные.КФО = Неопределено;
		ТекущиеДанные.ПроцентКомпенсации = 0;
		ТекущиеДанные.СуммаКомпенсации = 0;
	КонецЕсли;
КонецПроцедуры

