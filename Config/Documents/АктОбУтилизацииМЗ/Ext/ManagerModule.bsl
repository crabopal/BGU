#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Подготовить таблицу списание материальных запасов по документу.
// 
// Параметры:
//  Документ - ДокументОбъект.АктОбУтилизацииМЗ
//  Параметры - Структура
// 
// Возвращаемое значение:
//  ТаблицаЗначений
Функция ПодготовитьТаблицуСписаниеМатериальныхЗапасовПоДокументу(Документ, Параметры) Экспорт
	
	Счет_02_4 = БухгалтерскийУчет.СчетПоКоду("02.4", Документ.Дата, Документ.Организация);
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет_02_4);
	
	Запрос = Новый Запрос;
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Материалы"" КАК ИмяСписка,
	|	""Материалы"" КАК СинонимСписка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Ссылка.ИФО КАК ИФО,
	|	Материалы.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КЭК,
	|	Материалы.Ссылка.Подразделение КАК Подразделение,
	|	Материалы.Ссылка.Подразделение КАК ПодразделениеПолучатель,
	|	&УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	&РазрешитьНеУказыватьПодразделение КАК РазрешитьНеУказыватьПодразделение,
	|	&СчетУчета КАК СчетУчета,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.ДополнительнаяАналитикаСчета КАК ДопАналитика,
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
	|	Материалы.Ссылка.ЦМО КАК ДопИзмерение,
	|	Материалы.Ссылка.ЦМО КАК ДопИзмерениеПолучатель,
	|	Материалы.Количество КАК Количество,
	|	ЛОЖЬ КАК НеПересчитыватьСумму,
	|	0 КАК СуммаСписания,
	|	0 КАК СуммаСписанияНУ
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("СчетУчета", Счет_02_4);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", СвойстваСчета.УчетПоПодразделениям);
	Запрос.УстановитьПараметр("РазрешитьНеУказыватьПодразделение", СвойстваСчета.РазрешитьНеУказыватьПодразделение);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Настройка недоступности элементов таблицы.
// Ключ структуры - Имя табличной части, значение - массив имен реквизитов табличной части.
// 
// Возвращаемое значение:
//  Структура - Настройка недоступности элементов таблицы.
Функция НастройкаНедоступностиЭлементовТаблицы() Экспорт
	Результат = Новый Структура;
	ИменаРеквизитов = Новый Массив;
	ИменаРеквизитов.Добавить("Номенклатура");
	ИменаРеквизитов.Добавить("КФО");
	ИменаРеквизитов.Добавить("Количество");
	Результат.Вставить("Материалы", ИменаРеквизитов);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	ТаблицыДляДвижений = СтруктураДополнительныеСвойства.ТаблицыДляДвижений;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента",
		НСтр("ru = 'Решение о прекращении признания активом объекта НФА (ф. 0510440)'"));
	Запрос.УстановитьПараметр("НомерДокумента",
		ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка.Ссылка, ДокументСсылка.Номер));
	
	НомераТаблиц = Новый Структура;
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	Результат = Запрос.ВыполнитьПакет();
	
	Для Каждого НомерТаблицы Из НомераТаблиц Цикл
		ТаблицыДляДвижений.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ДокументСсылка);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)

	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	
	Запрос.Текст = 
	 "ВЫБРАТЬ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.АктОбУтилизацииМЗ.ДрагоценныеМатериалы КАК АктОбУтилизацииМЗДрагоценныеМатериалы
	 |ГДЕ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И АктОбУтилизацииМЗДрагоценныеМатериалы.МассаДМ > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	 "ВЫБРАТЬ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата КАК Период,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка КАК Регистратор,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.МассаДМ КАК ЧистаяМасса,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЛигатурнаяМасса КАК ЛигатурнаяМасса,
	 |	&ИмяДокумента КАК Основание,
	 |	&НомерДокумента КАК НомерОснования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	 |ИЗ
	 |	Документ.АктОбУтилизацииМЗ.ДрагоценныеМатериалы КАК АктОбУтилизацииМЗДрагоценныеМатериалы
	 |ГДЕ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И АктОбУтилизацииМЗДрагоценныеМатериалы.МассаДМ > 0
	 |	И НЕ АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.НоменклатураЛома = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	 |
	 |ОБЪЕДИНИТЬ ВСЕ
	 |
	 |ВЫБРАТЬ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка,
	 |	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.НомерСтроки,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Организация,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ОбъектНФА,
	 |	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ),
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ВидДрагМатериала,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЧистаяМасса,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЛигатурнаяМасса,
	 |	&ИмяДокумента,
	 |	&НомерДокумента,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.Дата,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ЕдИзм,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.ИсточникОбразования,
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами
	 |ИЗ
	 |	Документ.АктОбУтилизацииМЗ.ДрагоценныеМатериалы КАК АктОбУтилизацииМЗДрагоценныеМатериалы
	 |ГДЕ
	 |	АктОбУтилизацииМЗДрагоценныеМатериалы.Ссылка = &Ссылка
	 |	И АктОбУтилизацииМЗДрагоценныеМатериалы.МассаДМ = 0
	 |	И АктОбУтилизацииМЗДрагоценныеМатериалы.ЛигатурнаяМасса + АктОбУтилизацииМЗДрагоценныеМатериалы.ЧистаяМасса > 0
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	НомерСтроки";
	 
КонецПроцедуры	

#КонецОбласти

#Область ГолосованиеКомиссиии

// Заполнить результат голосования.
// 
// Параметры:
//  Форма - см. Документ.АктОбУтилизацииМЗ.Форма.ФормаДокумента
Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	Если ЗаполнитьРезультатыГолосования Тогда
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
	КонецЕсли;
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбрабатываемаяТаблица = Объект.ПолученныеМатериалы;
	Иначе
		ОбрабатываемаяТаблица = Объект.Материалы;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ОбрабатываемаяТаблица Цикл
		
		СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Неопределено;
		СтрокаТаблицы.ИтогГолосования = 0;
		СтрокаТаблицы.РезолюцияКомиссииОдобрена = Ложь;
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Управление элементами голосования.
// 
// Параметры:
//  Форма - см. Документ.АктОбУтилизацииМЗ.Форма.ФормаДокумента
Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	Если ПолучитьФункциональнуюОпцию("РезервироватьМЗПриВыбытии") Тогда
		ОбъектАннулирован = Объект.Аннулирован;
		ДоступностьГолосования = Не ОбъектАннулирован
			И (Объект.Резервировать Или Не Объект.Проведен);
	Иначе
		ОбъектАннулирован = Ложь;
		ДоступностьГолосования = Не Объект.Проведен;
	КонецЕсли;

	ДоступностьГолосования = ДоступностьГолосования
		И Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
		
	ПараметрыВидимости = УправлениеНФАКлиентСервер.ПараметрыУправленияЭлементамиГолосования();
	ПараметрыВидимости.ДоступностьГолосования = ДоступностьГолосования;
	ПараметрыВидимости.ИспользуемыеИмена = ИменаЭлементовГолосования();
	ПараметрыВидимости.Модифицированность = Форма.РешениеСотрудникаМодифицированность;
	ПараметрыВидимости.Сотрудник = Форма.Сотрудник;
	ПараметрыВидимости.УправляющийРеквизит = Объект.ГолосованиеЗаПолученныеМатериалы;
	УправлениеНФАКлиентСервер.УправлениеЭлементамиГолосования(Форма, ПараметрыВидимости);
	
КонецПроцедуры

Функция ИменаЭлементовГолосования()
	Результат = Новый Структура;
	Результат.Вставить("Сотрудник",
		НовыйСоответствие(Ложь, "Сотрудник1", Истина, "Сотрудник"));
	Результат.Вставить("ЕдиногласноЗаВоВсехСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЕдиногласноЗаВоВсехСтроках"));
	Результат.Вставить("ЕдиногласноПротивВоВсехСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЕдиногласноПротивВоВсехСтроках"));
	Результат.Вставить("ЗаВоВсехСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеЗаВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЗаВоВсехСтроках"));
	Результат.Вставить("ПротивВоВсехСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеПротивВоВсехСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеПротивВоВсехСтроках"));
	Результат.Вставить("ЗаВВыделенныхСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеЗаВВыделенныхСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеЗаВВыделенныхСтроках"));
	Результат.Вставить("ПротивВВыделенныхСтроках",
		НовыйСоответствие(Ложь, "МатериалыУстановитьРешениеПротивВВыделенныхСтроках",
						Истина, "ПолученныеМатериалыУстановитьРешениеПротивВВыделенныхСтроках"));
	Результат.Вставить("РешениеСотрудника",
		НовыйСоответствие(Ложь, "МатериалыРешениеСотрудникаПоРезолюции",
						Истина, "ПолученныеМатериалыРешениеСотрудникаПоРезолюции"));
	Результат.Вставить("СохранитьРезультаты",
		НовыйСоответствие(Ложь, "СохранитьРезультатыГолосования1",
						Истина, "СохранитьРезультатыГолосования"));
	Результат.Вставить("ИтогГолосования",
		НовыйСоответствие(Ложь, "МатериалыИтогГолосования",
						Истина, "ПолученныеМатериалыИтогГолосования"));
	Результат.Вставить("РезолюцияОдобрена",
		НовыйСоответствие(Ложь, "МатериалыРезолюцияКомиссииОдобрена",
						Истина, "ПолученныеМатериалыРезолюцияКомиссииОдобрена"));
	Результат.Вставить("НадписьФайл",
		НовыйСоответствие(Ложь, "НадписьФайл1",
						Истина, "НадписьФайл"));
	Результат.Вставить("НадписьФайлНеВыбран",
		НовыйСоответствие(Ложь, "НадписьФайлНеВыбран1",
						Истина, "НадписьФайлНеВыбран"));
	Результат.Вставить("НадписьУдалитьФайл",
		НовыйСоответствие(Ложь, "НадписьУдалитьФайл1",
						Истина, "НадписьУдалитьФайл"));
	Результат.Вставить("ФайлСотрудника",
		НовыйСоответствие(Ложь, "ФайлСотрудника1",
						Истина, "ФайлСотрудника"));
	Результат.Вставить("НадписьГолосование",
		НовыйСоответствие(Ложь, "НадписьГолосование1",
						Истина, "НадписьГолосование"));
		
	Возврат Результат;
КонецФункции

Функция НовыйСоответствие(Ключ1, Значение1, Ключ2, Значение2)
	Результат = Новый Соответствие;
	Результат.Вставить(Ключ1, Значение1);
	Результат.Вставить(Ключ2, Значение2);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.АктОбУтилизацииМЗ";
	КомандаПечати.Идентификатор		= "Акт0510435";
	КомандаПечати.Представление		= НСтр("ru = 'Акт об утилизации (ф. 0510435)'");
	КомандаПечати.Порядок			= 1;

	УправлениеПечатьюБГУ.ДобавитьКомандуПечати(КомандыПечати, "СправкаОСодержанииДрагМатериалов", 3);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - ТаблицаЗначений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм, "Акт0510435");
	Если ПечатнаяФорма <> Неопределено Тогда
		ПечатнаяФорма.ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510435(МассивОбъектов, ОбъектыПечати,
			ДанныеДляПечати0510435(МассивОбъектов));
		ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Акт (ф. 0510435)'");
	КонецЕсли;
	
КонецПроцедуры

// Данные для печати0510435.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  см. УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОбУтилизации0510435
Функция ДанныеДляПечати0510435(МассивОбъектов)
	
	ЧастиЗапроса = Новый Массив;
	ЧастиЗапроса.Добавить(ТекстЗапросаШапкиДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаНеинвентарныеОбъектыДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаПолученныеМЦДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаПолученныеДрагматериалыДляПечатиАктаОбУтилизации0510435());
	ЧастиЗапроса.Добавить(ТекстЗапросаДрагматериалыДляПечатиАктаОбУтилизации0510435());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Запрос.Текст = СтрСоединить(ЧастиЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(МассивОбъектов);
	
	ВыборкаШапка	= РезультатЗапроса[0].Выбрать();
	ВыборкаМЗ			= РезультатЗапроса[1].Выбрать();
	ВыборкаПолученныеМЗ = РезультатЗапроса[2].Выбрать();
	ВыборкаДМПолученныхМЗ = РезультатЗапроса[3].Выбрать();
	ВыборкаДМ           = РезультатЗапроса[4].Выбрать();

	ДанныеДляПечати = УправлениеПечатьюБГУ.ТаблицаШапкиДляПечатиАктаОбУтилизации0510435();

	СтруктураПоискаДМ = Новый Структура;
	СтруктураПоискаДМ.Вставить("Ссылка", Неопределено);
	СтруктураПоискаДМ.Вставить("ОбъектНФА", Неопределено);
	СтруктураПоискаДМ.Вставить("ИнвНомер", Справочники.ИнвентарныеНомераОС.ПустаяСсылка());

	СтруктураПоиска = Новый Структура("Ссылка", Неопределено);
	ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки", Неопределено, "");

	Пока ВыборкаШапка.Следующий() Цикл 

		СтрокаШапки = ДанныеДляПечати.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		
		СтрокаШапки.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
			
		АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			ВыборкаШапка.МестоХранения,
			Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Если ЗначениеЗаполнено(АдресМестаХранения) Тогда
			СтрокаШапки.Местонахождение = СтрШаблон(НСтр("ru = '%1, %2'"),
				СтрокаШапки.Местонахождение,
				АдресМестаХранения);
		КонецЕсли;
		
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаШапка.Руководитель);
		СотрудникиДокумента.Добавить(ВыборкаШапка.Сотрудник);
		
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента,
			"Фамилия,Имя,Отчество,НаименованиеПолное,ДолжностьНаименование",
			ВыборкаШапка.ДатаАкта);
		
		ДанныеРуководителя = ДанныеСотрудников.Получить(ВыборкаШапка.Руководитель);
		СтрокаШапки.ДолжностьРуководителя = ДанныеРуководителя.ДолжностьНаименование;
		СтрокаШапки.ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ДанныеРуководителя, Истина);
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.Сотрудник);
		СтрокаШапки.ЦМО = ДанныеСотрудника.НаименованиеПолное;
		
		СтруктураПоиска.Ссылка = ВыборкаШапка.Ссылка;
		СтруктураПоискаДМ.Ссылка = ВыборкаШапка.Ссылка;

		МероприятияПоУтилизации = УправлениеПечатьюБГУ.ТаблицаМероприятияПоУтилизацииДляПечатиАктаОбУтилизации0510435();
		СтрокаШапки.МероприятияПоУтилизации = МероприятияПоУтилизации; 
		
		// Неинвентарные объекты
		
		НеинвентарныеОбъекы = УправлениеПечатьюБГУ.ТаблицаНеинвентарныеОбъектыДляПечатиАктаОбУтилизации0510435();
		СтрокаШапки.НеинвентарныеОбъекты = НеинвентарныеОбъекы;
		
		ВыборкаМЗ.Сбросить();
		
		Пока ВыборкаМЗ.НайтиСледующий(СтруктураПоиска) Цикл
			
			НомерСтрокиСтрокой = Формат(ВыборкаМЗ.НомерСтроки, "ЧЦ=3; ЧВН=");
			
			// Раздел 1.2
			СтрокаНеинвОбъекта = НеинвентарныеОбъекы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаНеинвОбъекта, ВыборкаМЗ);
			СтрокаНеинвОбъекта.КодСтроки = "12" + НомерСтрокиСтрокой;
			ДрагматериалыОбъекта = УправлениеПечатьюБГУ.ТаблицаДрагматериалыДляПечатиАктаОбУтилизации0510435();
			СтрокаНеинвОбъекта.Драгматериалы = ДрагматериалыОбъекта;
			
			СтруктураПоискаДМ.ОбъектНФА = ВыборкаМЗ.Номенклатура;
			
			ВыборкаДМ.Сбросить();
			Пока ВыборкаДМ.НайтиСледующий(СтруктураПоискаДМ) Цикл
				СтрокаДМОбъекта = ДрагматериалыОбъекта.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДМОбъекта, ВыборкаДМ);
				СтрокаДМОбъекта.Драгметалл = ВыборкаДМ.ВидДрагМатериала;
				Если ВыборкаДМ.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни Тогда
					СтрокаДМОбъекта.Количество = ВыборкаДМ.КоличествоДМ;
				Иначе
					СтрокаДМОбъекта.Количество = ВыборкаДМ.МассаДМ;
				КонецЕсли;
			КонецЦикла;
			
			// Раздел 2.1
			СтрокаМероприятия = МероприятияПоУтилизации.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаМероприятия, ВыборкаМЗ);

			СтрокаМероприятия.КодСтроки      = "21" + НомерСтрокиСтрокой;
			СтрокаМероприятия.Наименование   = СтрокаНеинвОбъекта.НаименованиеМЗ;
			СтрокаМероприятия.ОбъектУчета    = СтрокаНеинвОбъекта.Номенклатура;
			СтрокаМероприятия.КлассОпасности = УправлениеПечатьюБГУ.ПредставлениеКлассаОпасности(ВыборкаМЗ.КлассОпасности);
			
		КонецЦикла;
		
		// Полученные МЗ
		
		ПолученныеМЗ = УправлениеПечатьюБГУ.ТаблицаПолученныеМЦДляПечатиАктаОбУтилизации0510435();
		СтрокаШапки.ПолученныеМЦ = ПолученныеМЗ;
		
		НомераСтрокРаздела22 = Новый Соответствие;
		ВыборкаПолученныеМЗ.Сбросить();
		Пока ВыборкаПолученныеМЗ.НайтиСледующий(СтруктураПоиска) Цикл
			НоваяСтрока = ПолученныеМЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПолученныеМЗ);
			ОтборПоИдентификаторуСтроки.Документ = ВыборкаШапка.Ссылка;
			НоваяСтрока.КодСтроки = "22" + Формат(ВыборкаПолученныеМЗ.КодСтроки, "ЧЦ=3; ЧВН=");
			ОтборПоИдентификаторуСтроки.ИдентификаторСтроки = ВыборкаПолученныеМЗ.ИдентификаторСтроки;
			РезультатыГолосованияПоСтроке = РезультатыГолосования.НайтиСтроки(ОтборПоИдентификаторуСтроки);
			Если РезультатыГолосованияПоСтроке.Количество() > 0
				И РезультатыГолосованияПоСтроке[0].ГолосованиеПоСтрокеЗавершено Тогда
				НоваяСтрока.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
			КонецЕсли;
			НомераСтрокРаздела22.Вставить(ВыборкаПолученныеМЗ.Номенклатура, НоваяСтрока.КодСтроки);
		КонецЦикла;
		
		// Драгматериалы полученных МЗ
		ПолученныеДрагматериалы = УправлениеПечатьюБГУ.ТаблицаПолученныеДрагматериалыДляПечатиАктаОбУтилизации0510435();
		СтрокаШапки.ПолученныеДрагматериалы = ПолученныеДрагматериалы;
		
		ВыборкаДМПолученныхМЗ.Сбросить();
		Пока ВыборкаДМПолученныхМЗ.НайтиСледующий(СтруктураПоиска) Цикл
			СтрокаПолученногоДМ = ПолученныеДрагматериалы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПолученногоДМ, ВыборкаДМПолученныхМЗ);
			Если ВыборкаДМПолученныхМЗ.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни Тогда
				СтрокаПолученногоДМ.Количество = ВыборкаДМПолученныхМЗ.КоличествоДМ;
			Иначе
				СтрокаПолученногоДМ.Количество = ВыборкаДМПолученныхМЗ.МассаДМ;
			КонецЕсли;
			СтрокаПолученногоДМ.КодСтроки = НомераСтрокРаздела22.Получить(ВыборкаДМПолученныхМЗ.ОбъектНФА);
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ДанныеДляПечати;

КонецФункции

Функция ТекстЗапросаШапкиДляПечатиАктаОбУтилизации0510435()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктОбУтилизацииМЗ.Ссылка КАК Ссылка,
	|	АктОбУтилизацииМЗ.Номер КАК Номер,
	|	АктОбУтилизацииМЗ.Дата КАК ДатаАкта,
	|	АктОбУтилизацииМЗ.Организация КАК Организация,
	|	АктОбУтилизацииМЗ.Подразделение КАК СтруктурноеПодразделение,
	|	АктОбУтилизацииМЗ.ЦМО.Сотрудник КАК Сотрудник,
	|	АктОбУтилизацииМЗ.ЦМО.МестоХранения.Наименование КАК Местонахождение,
	|	ЕСТЬNULL(АктОбУтилизацииМЗ.ЦМО.Местохранения, ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)) КАК МестоХранения,
	|	АктОбУтилизацииМЗ.Комиссия.НаименованиеПриказа КАК НаименованиеПриказа,
	|	АктОбУтилизацииМЗ.Комиссия.НомерПриказа КАК НомерПриказа,
	|	АктОбУтилизацииМЗ.Комиссия.ДатаПриказа КАК ДатаПриказа,
	|	АктОбУтилизацииМЗ.Руководитель КАК Руководитель
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ КАК АктОбУтилизацииМЗ
	|ГДЕ
	|	АктОбУтилизацииМЗ.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаАкта,
	|	Номер";
		
КонецФункции

Функция ТекстЗапросаНеинвентарныеОбъектыДляПечатиАктаОбУтилизации0510435()
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.НомерСтроки КАК НомерСтроки,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА Материалы.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА Материалы.Номенклатура.Наименование
	|		ИНАЧЕ Материалы.Номенклатура.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМЗ,
	|	ВЫБОР
	|		КОГДА Материалы.Номенклатура.НоменклатурныйНомер = """"
	|			ТОГДА Материалы.Номенклатура.Код
	|		ИНАЧЕ Материалы.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК НоменклатурныйНомер,
	|	Материалы.Количество КАК КоличествоМЗ,
	|	Материалы.Сумма КАК Сумма,
	|	Материалы.КлассОпасности КАК КлассОпасности,
	|	Материалы.СпособУтилизации КАК СпособУтилизации,
	|	Материалы.ОснованиеНаименование КАК ДокументНаименование,
	|	Материалы.ОснованиеДата КАК ДокументДата,
	|	Материалы.ОснованиеНомер КАК ДокументНомер,
	|	Материалы.ОснованиеРаботы КАК Работы,
	|	ЕСТЬNULL(Материалы.Номенклатура.ЕдиницаИзмерения.Код, """") КАК КодЕИМЗ,
	|	ЕСТЬNULL(Материалы.Номенклатура.ЕдиницаИзмерения.Наименование, """") КАК НаименованиеЕИМЗ,
	|	Материалы.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Материалы.Контрагент.НаименованиеСокращенное = """"
	|			ТОГДА ВЫБОР
	|				КОГДА Материалы.Контрагент.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|				И ВЫРАЗИТЬ(Материалы.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное <> """"
	|					ТОГДА ВЫРАЗИТЬ(Материалы.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
	|				ИНАЧЕ Материалы.Контрагент.Наименование
	|			КОНЕЦ
	|		ИНАЧЕ Материалы.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК КонтрагентНаименование,
	|	Материалы.ИдентификаторКонтрагента КАК КонтрагентИД,
	|	Материалы.РаботыНаименование КАК РаботыНаименование,
	|	Материалы.РаботыДата КАК РаботыДата,
	|	Материалы.РаботыНомер КАК РаботыНомер,
	|	Материалы.РаботыСодержание КАК РаботыСодержание
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В (&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";	
КонецФункции

