Процедура УправлениеЭлементамиГолосования()
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	Если Объект.Аннулирован Или (Объект.Проведен И НЕ Объект.Резервировать) Тогда
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		РешениеСотрудникаМодифицированность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости()

	Если Не ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.Утилизация = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	ПрослеживаемостьФормыБГУ.ЗаполнитьСписокВыбораКодаОперацииПрослеживаемости(Элементы.КодОперацииПрослеживаемости, ДанныеВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	РассчитатьПрослеживаемыеТовары();
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	УправлениеМатериальнымиЗапасамиФормыКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект);
	УстановитьСвойстваСчетаЗабаланса();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	Элементы = Форма.Элементы;
	
	// Прослеживаемость
	ВидимостьЭлементовПрослеживаемости = Форма.ВедетсяУчетПрослеживаемыхТоваров И Форма.ЕстьПрослеживаемыеТовары;
	
	ИменаЭлементовПрослеживаемости = Новый Массив;
	ИменаЭлементовПрослеживаемости.Добавить("МатериалыПрослеживаемыйТовар");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ИменаЭлементовДвиженияПрослеживаемости = Новый Массив;
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("МатериалыСтранаПроисхождения");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("МатериалыРНПТ");
	ИменаЭлементовДвиженияПрослеживаемости.Добавить("КодОперацииПрослеживаемости");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовДвиженияПрослеживаемости,
		"Видимость", ВидимостьЭлементовПрослеживаемости);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Форма.Элементы,
	"МатериалыДополнительнаяАналитикаСчета",
	"Видимость",
	ЗначениеЗаполнено(Форма.ВидСубконтоДопАналитики024));

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуПолученногоМатериала(Строка, ИмяКолонки)
	Если ИмяКолонки = "Цена" Или ИмяКолонки = "Количество" Тогда
		Строка.Сумма = Строка.Цена * Строка.Количество;
	ИначеЕсли ИмяКолонки = "Сумма" Тогда
		Если Строка.Количество <> 0 Тогда
			Строка.Цена = Строка.Сумма / Строка.Количество;
		Иначе
			Строка.Цена = 0;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Единица измерения номенклатуры.
// 
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура
// 
// Возвращаемое значение:
//  СправочникСсылка.КлассификаторЕдиницИзмерения - Единица измерения номенклатуры
&НаСервереБезКонтекста
Функция ЕдиницаИзмеренияНоменклатуры(Знач Номенклатура)
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
	Иначе
		Возврат Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаКлиенте
Функция ДополнитьСтруктуруПодбора()

	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("СчетУчета",              Счет024);
	ПараметрыПодбора.Вставить("ЦМО", 					Объект.ЦМО);
	ПараметрыПодбора.Вставить("Подразделение",			Объект.Подразделение);
	ПараметрыПодбора.Вставить("ПоказыватьОстатки",		Истина);
	ПараметрыПодбора.Вставить("ПоказыватьСчетУчета",	Истина);
	ТипыНоменклатуры = Новый СписокЗначений;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Блюдо"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ГСМ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Медикаменты"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МолоднякИЖивотныеНаОткорме"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.МягкийИнвентарь"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Посуда"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПродуктыПитания"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Продукция"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Стройматериалы"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Оборудование"));
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БСО"));
	ПараметрыПодбора.Вставить("ТипыНоменклатуры",		ТипыНоменклатуры);
	ПараметрыПодбора.Вставить("ИмяТаблицы",				"Материалы");
	Возврат ПараметрыПодбора;
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
	
	ТаблицаПодбора = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	
	Если ТаблицаПодбора.Количество() Тогда
		ВтМатериалы = Объект.Материалы.Выгрузить();
		УправлениеМатериальнымиЗапасами.ЗаполнитьТаблицуИзПодбораМатериалов(ВтМатериалы, ТаблицаПодбора);
		
		СуммыНоменклатуры = СтоимостьНоменклатуры(ТаблицаПодбора);
		СуммыНоменклатуры.Индексы.Добавить("Номенклатура, КФО");
		Отбор = Новый Структура("Номенклатура, КФО");

		Для Каждого СтрокаМатериалы Из ВтМатериалы Цикл
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаМатериалы);
			Остатки = СуммыНоменклатуры.НайтиСтроки(Отбор);
			Если СтрокаМатериалы.НоваяСтрока Тогда
				СтрокаМатериалы.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
			Если СтрокаМатериалы.Количество > 0 И Остатки.Количество() И Остатки[0].Количество <> 0 Тогда
				Если СтрокаМатериалы.Количество = Остатки[0].Количество Тогда
					СтрокаМатериалы.Сумма = Остатки[0].Сумма;
				Иначе
					СтрокаМатериалы.Сумма = СтрокаМатериалы.Количество * Остатки[0].Сумма / Остатки[0].Количество;
				КонецЕсли;
				СтрокаМатериалы.ОснованиеНаименование = Остатки[0].ОснованиеНаименование;
				СтрокаМатериалы.ОснованиеНомер = Остатки[0].ОснованиеНомер;
				СтрокаМатериалы.ОснованиеДата = Остатки[0].ОснованиеДата;
			КонецЕсли;
		КонецЦикла;
		
		Объект.Материалы.Загрузить(ВтМатериалы);
		
		РассчитатьПрослеживаемыеТовары();
		УстановитьВидимостьЭлементов(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СтоимостьНоменклатуры(ТаблицаНоменклатуры)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТаблицаНоменклатуры.КФО КАК КФО,
	|	&ЦМО КАК ЦМО
	|ПОМЕСТИТЬ ТаблицаНоменклатуры
	|ИЗ
	|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто2 ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто3 КАК Справочник.Номенклатура)
	|	КОНЕЦ КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто1 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто2 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУОбороты.Субконто3 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто3 КАК Справочник.ЦМО)
	|	КОНЕЦ КАК ЦМО,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО
	|ПОМЕСТИТЬ ДокументыОприходованияНа02_4
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			&ДатаОкончания,
	|			Регистратор,
	|			Счет = &СчетУчета,
	|			,
	|			Организация = &Организация
	|			И &УсловиеИФО
	|				И ВЫБОР
	|					КОГДА Субконто1 ССЫЛКА Справочник.Номенклатура
	|						ТОГДА ВЫРАЗИТЬ(Субконто1 КАК Справочник.Номенклатура)
	|					КОГДА Субконто2 ССЫЛКА Справочник.Номенклатура
	|						ТОГДА ВЫРАЗИТЬ(Субконто2 КАК Справочник.Номенклатура)
	|					КОГДА Субконто3 ССЫЛКА Справочник.Номенклатура
	|						ТОГДА ВЫРАЗИТЬ(Субконто3 КАК Справочник.Номенклатура)
	|				КОНЕЦ В
	|					(ВЫБРАТЬ
	|						ТаблицаНоменклатуры.Номенклатура
	|					ИЗ
	|						ТаблицаНоменклатуры),
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|ГДЕ
	|	ЖурналПроводокЕПСБУОбороты.КоличествоОборотДт <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыОприходованияНа02_4.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ДокументыОприходованияНа02_4.Регистратор) КАК Регистратор,
	|	ДокументыОприходованияНа02_4.КФО КАК КФО
	|ПОМЕСТИТЬ ПоследнийДокументОприходованияТекущееЦМО
	|ИЗ
	|	ДокументыОприходованияНа02_4 КАК ДокументыОприходованияНа02_4
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДокументыОприходованияНа02_4.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(ДокументыОприходованияНа02_4.Период) КАК Период,
	|			ДокументыОприходованияНа02_4.КФО КАК КФО
	|		ИЗ
	|			ДокументыОприходованияНа02_4 КАК ДокументыОприходованияНа02_4
	|		ГДЕ
	|			ДокументыОприходованияНа02_4.ЦМО = &ЦМО
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ДокументыОприходованияНа02_4.Номенклатура,
	|			ДокументыОприходованияНа02_4.КФО) КАК МаксимальныеДатыПоступления
	|		ПО ДокументыОприходованияНа02_4.Номенклатура = МаксимальныеДатыПоступления.Номенклатура
	|			И ДокументыОприходованияНа02_4.Период = МаксимальныеДатыПоступления.Период
	|			И ДокументыОприходованияНа02_4.КФО = МаксимальныеДатыПоступления.КФО
	|ГДЕ
	|	ДокументыОприходованияНа02_4.ЦМО = &ЦМО
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыОприходованияНа02_4.Номенклатура,
	|	ДокументыОприходованияНа02_4.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДокументыОприходованияНа02_4.Номенклатура КАК Номенклатура,
	|	МАКСИМУМ(ДокументыОприходованияНа02_4.Регистратор) КАК Регистратор,
	|	ДокументыОприходованияНа02_4.КФО КАК КФО
	|ПОМЕСТИТЬ ПоследнийДокументОприходованияСписания
	|ИЗ
	|	ДокументыОприходованияНа02_4 КАК ДокументыОприходованияНа02_4
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ДокументыОприходованияНа02_4.Номенклатура КАК Номенклатура,
	|			МАКСИМУМ(ДокументыОприходованияНа02_4.Период) КАК Период,
	|			ДокументыОприходованияНа02_4.КФО КАК КФО
	|		ИЗ
	|			ДокументыОприходованияНа02_4 КАК ДокументыОприходованияНа02_4
	|		ГДЕ
	|			ТИПЗНАЧЕНИЯ(ДокументыОприходованияНа02_4.Регистратор) В (ТИП(Документ.АктСписанияМЗ), ТИП(Документ.РешениеОПрекращенииПризнанияАктивомМЗ))
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ДокументыОприходованияНа02_4.Номенклатура,
	|			ДокументыОприходованияНа02_4.КФО) КАК МаксимальныеДатыПоступления
	|		ПО ДокументыОприходованияНа02_4.Номенклатура = МаксимальныеДатыПоступления.Номенклатура
	|			И ДокументыОприходованияНа02_4.Период = МаксимальныеДатыПоступления.Период
	|			И ДокументыОприходованияНа02_4.КФО = МаксимальныеДатыПоступления.КФО
	|
	|СГРУППИРОВАТЬ ПО
	|	ДокументыОприходованияНа02_4.Номенклатура,
	|	ДокументыОприходованияНа02_4.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоследнийДокументОприходованияТекущееЦМО.Номенклатура КАК Номенклатура,
	|	ПоследнийДокументОприходованияТекущееЦМО.КФО КАК КФО,
	|	ЕСТЬNULL(ПоследнийДокументОприходованияСписания.Регистратор, ПоследнийДокументОприходованияТекущееЦМО.Регистратор) КАК Регистратор
	|ПОМЕСТИТЬ ПоследнийДокументОприходования
	|ИЗ
	|	ПоследнийДокументОприходованияТекущееЦМО КАК ПоследнийДокументОприходованияТекущееЦМО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПоследнийДокументОприходованияСписания КАК ПоследнийДокументОприходованияСписания
	|		ПО ПоследнийДокументОприходованияТекущееЦМО.Номенклатура = ПоследнийДокументОприходованияСписания.Номенклатура
	|			И ПоследнийДокументОприходованияТекущееЦМО.КФО = ПоследнийДокументОприходованияСписания.КФО
	|			И (НЕ ТИПЗНАЧЕНИЯ(ПоследнийДокументОприходованияТекущееЦМО.Регистратор) В (ТИП(Документ.АктСписанияМЗ), ТИП(Документ.РешениеОПрекращенииПризнанияАктивомМЗ)))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК Номенклатура,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт) КАК Количество,
	|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма
	|ПОМЕСТИТЬ СписанияМЗ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В
	|				(ВЫБРАТЬ
	|					ПоследнийДокументОприходования.Регистратор
	|				ИЗ
	|					ПоследнийДокументОприходования),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
