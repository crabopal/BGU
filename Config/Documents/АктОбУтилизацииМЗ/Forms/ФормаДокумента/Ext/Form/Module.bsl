	|				ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|				ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|				ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|			ИНАЧЕ NULL
	|		КОНЕЦ ЕСТЬ НЕ NULL 
	|	И ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт.ТипСчета, ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АктСписанияМЗМатериалы.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗ.КФОВТабличнойЧасти
	|			ТОГДА АктСписанияМЗМатериалы.КФО
	|		ИНАЧЕ АктСписанияМЗ.КФО
	|	КОНЕЦ КАК КФО,
	|	МАКСИМУМ(АктСписанияМЗ.Ссылка) КАК АктСписания,
	|	МАКСИМУМ(ВЫРАЗИТЬ(АктСписанияМЗ.ДокументОснование КАК Документ.РешениеОПрекращенииПризнанияАктивомМЗ)) КАК Регистратор
	|ПОМЕСТИТЬ АктыСписания
	|ИЗ
	|	Документ.АктСписанияМЗ.Материалы КАК АктСписанияМЗМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|		ПО АктСписанияМЗМатериалы.Ссылка = АктСписанияМЗ.Ссылка
	|ГДЕ
	|	АктСписанияМЗ.ЕстьРешениеОПрекращенииПризнанияАктивом
	|	И АктСписанияМЗ.ДокументОснование В
	|			(ВЫБРАТЬ
	|				СписанияМЗ.Регистратор
	|			ИЗ
	|				СписанияМЗ
	|			ГДЕ
	|				СписанияМЗ.Регистратор ССЫЛКА Документ.РешениеОПрекращенииПризнанияАктивомМЗ)
	|
	|СГРУППИРОВАТЬ ПО
	|	АктСписанияМЗМатериалы.Номенклатура,
	|	ВЫБОР
	|		КОГДА АктСписанияМЗ.КФОВТабличнойЧасти
	|			ТОГДА АктСписанияМЗМатериалы.КФО
	|		ИНАЧЕ АктСписанияМЗ.КФО
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписанияМЗ.Номенклатура КАК Номенклатура,
	|	СписанияМЗ.КФО КАК КФО,
	|	МАКСИМУМ(ЕСТЬNULL(АктыСписания.АктСписания, СписанияМЗ.Регистратор)) КАК Регистратор,
	|	СУММА(СписанияМЗ.Количество) КАК Количество,
	|	СУММА(СписанияМЗ.Сумма) КАК Сумма
	|ИЗ
	|	ПоследнийДокументОприходования КАК ПоследнийДокументОприходования
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписанияМЗ КАК СписанияМЗ
	|		ПО ПоследнийДокументОприходования.Регистратор = СписанияМЗ.Регистратор
	|			И ПоследнийДокументОприходования.Номенклатура = СписанияМЗ.Номенклатура
	|			И ПоследнийДокументОприходования.КФО = СписанияМЗ.КФО
	|		ЛЕВОЕ СОЕДИНЕНИЕ АктыСписания КАК АктыСписания
	|		ПО ПоследнийДокументОприходования.Регистратор = АктыСписания.Регистратор
	|			И ПоследнийДокументОприходования.Номенклатура = АктыСписания.Номенклатура
	|			И ПоследнийДокументОприходования.КФО = АктыСписания.КФО
	|
	|СГРУППИРОВАТЬ ПО
	|	СписанияМЗ.Номенклатура,
	|	СписанияМЗ.КФО";
	ДатаЗапроса = Объект.Дата;
	Если Объект.Ссылка.Пустая() Тогда
		ДатаЗапроса = КонецДня(Объект.Дата);
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаЗапроса);
	Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ЦМО", Объект.ЦМО);
	Запрос.УстановитьПараметр("СчетУчета", Счет024);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Субконто = Новый Массив;
	Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("Регистратор", Документы.ТипВсеСсылки());
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ОснованиеНаименование", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ОснованиеДата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ОснованиеНомер", Новый ОписаниеТипов("Строка"));
	
	ДокументыПоТипам = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		ТипРегистратора = ТипЗнч(Выборка.Регистратор);
		СтрокаТипа = ДокументыПоТипам.Получить(ТипРегистратора);
		Если СтрокаТипа = Неопределено Тогда
			СтрокаТипа = Новый Массив;
			ДокументыПоТипам.Вставить(ТипРегистратора, СтрокаТипа);
		КонецЕсли;
		СтрокаТипа.Добавить(Выборка.Регистратор);
	КонецЦикла;
	
	ВсеРегистраторы = УправлениеМатериальнымиЗапасами.ДанныеРегистраторовДляЗаполненияАктаОбУтилизации(ДокументыПоТипам);
	Для Каждого СтрокаРезультата Из Результат Цикл
		
		РеквизитыДокумента = ВсеРегистраторы.Получить(СтрокаРезультата.Регистратор);
		Если РеквизитыДокумента <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаРезультата, РеквизитыДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Решение сотрудника - Материалы.
	УправлениеНФА.УстановитьУсловноеОформлениеРешенияЧленаКомиссии(УсловноеОформление, "Материалы");
	// Решение сотрудника - ПолученныеМатериалы.
	УправлениеНФА.УстановитьУсловноеОформлениеРешенияЧленаКомиссии(УсловноеОформление, "ПолученныеМатериалы");
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииНаСервере()
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИдентификаторКонтрагента(Контрагент)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент);
	
КонецФункции

#Область ГолосованиеКомиссии

&НаКлиенте
Процедура УстановитьРешениеЕдиногласноВоВсехСтроках(Решение)

	Если Модифицированность Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Документ был изменен. Сначала следует записать документ!'"));
		Возврат;
	КонецЕсли;
	
	Если Решение = "За" Тогда
		НовоеЗначение = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.За");
	ИначеЕсли Решение = "Против" Тогда
		НовоеЗначение = ПредопределенноеЗначение("Перечисление.РезультатыГолосованияЧленовКомиссии.Против");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимое значение параметра ""Решение"" - %1'"), Решение);
	КонецЕсли;
		
	Оповещение = Новый ОписаниеОповещения("ВопросУстановитьРешениеЕдиногласноЗавершение", ЭтотОбъект,
		НовоеЗначение);
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Будет установлено и сохранено решение %1 для всех присутствующих членов комиссии по всем строкам документа.
			|Все предыдущие результаты голосования по документу будут перезаписаны. Продолжить?'"), Решение);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования1", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник)
				И Форма.РешениеСотрудникаМодифицированность
				И Не Форма.Объект.ГолосованиеЗаПолученныеМатериалы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СохранитьРезультатыГолосования", "Доступность",
			ЗначениеЗаполнено(Форма.Сотрудник)
				И Форма.РешениеСотрудникаМодифицированность
				И Форма.Объект.ГолосованиеЗаПолученныеМатериалы);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРешениеВСтрокахДокумента(РешениеСотрудника, ВоВсехСтроках = Истина)
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбрабатываемаяТаблица = Объект.ПолученныеМатериалы;
		ЭлементТаблица = Элементы.ПолученныеМатериалы;	
	Иначе
		ОбрабатываемаяТаблица = Объект.Материалы;
		ЭлементТаблица = Элементы.Материалы;	
	КонецЕсли;
	УправлениеНФАКлиентСервер.УстановитьРешениеВСтрокахДокумента(ОбрабатываемаяТаблица,
		РешениеСотрудника,
		ВоВсехСтроках,
		ЭлементТаблица.ВыделенныеСтроки);
	
	РешениеСотрудникаМодифицированность = Истина;
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьРезультатыГолосованияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьРезультатыГолосованияНаСервере(ДополнительныеПараметры.Сотрудник, ДополнительныеПараметры.РезультатыГолосования);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьРезультатыГолосованияНаСервере(ЧленКомиссии, РезультатыГолосования)
	
	ОбщегоНазначенияБГУ.СохранитьРезультатыГолосованияНаСервере(Объект, ЧленКомиссии, РезультатыГолосования);
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУстановитьРешениеЕдиногласноЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		УстановитьРешениеЕдиногласноНаСервере(ДополнительныеПараметры);
		ОповеститьОбИзменении(Объект.Ссылка);
	КонецЕсли;
	
	РешениеСотрудникаМодифицированность = Ложь; // При любом ответе сбрасываем признак модифицированности.
	УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРешениеЕдиногласноНаСервере(РезультатГолосования)
	
	Если Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "ПолученныеМатериалы", РезультатГолосования);
	Иначе
		ОбщегоНазначенияБГУ.УстановитьРешениеЕдиногласноНаСервере(Объект, "Материалы", РезультатГолосования);
	КонецЕсли;
	РешениеСотрудникаМодифицированность = Ложь;
	
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	
КонецПроцедуры

// Файлы сотрудников

&НаКлиенте
Процедура ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ЗначениеВыбора) Тогда
		ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборФайлаСотрудникаНаСервере(ЗначениеВыбора)
	
	УправлениеНФА.ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник, ПараметрыФайлаСотрудника());
	
КонецПроцедуры

&НаСервере
Процедура ОткрепитьФайлСотрудникаНаСервере()
	
	УправлениеНФА.ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник, ПараметрыФайлаСотрудника());
	
КонецПроцедуры

&НаСервере
Функция ПараметрыФайлаСотрудника()
	ПараметрыФайлаСотрудника = УправлениеНФА.ФайлСотрудника_Параметры(ЭтотОбъект);
	Если НЕ Объект.ГолосованиеЗаПолученныеМатериалы Тогда
		ПараметрыФайлаСотрудника.ПолеФайла = "ФайлСотрудника";
		ПараметрыФайлаСотрудника.ПолеНадписи = "НадписьФайлНеВыбран1";
		ПараметрыФайлаСотрудника.ПолеУдалить = "НадписьУдалитьФайл1";
		ПараметрыФайлаСотрудника.ЭлементПолеФайла = "ФайлСотрудника1";
	КонецЕсли;
	Возврат ПараметрыФайлаСотрудника
КонецФункции

// Конец Файлы сотрудников

#КонецОбласти

&НаСервере
Процедура УдалитьСтрокиРНПТ(Знач ИдентификаторСтроки)
	СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
		Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьРНПТВХранилище(Адрес, ДополнительныеПараметры) Экспорт
	Если ЭтоАдресВременногоХранилища(Адрес) Тогда
		ПоместитьРНПТВХранилищеНаСервере(Адрес, ДополнительныеПараметры.ИдентификаторСтроки);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПоместитьРНПТВХранилищеНаСервере(Адрес, ИдентификаторСтроки)

	ТаблицаРНПТ = Объект.СведенияПрослеживаемости.Выгрузить(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	ПоместитьВоВременноеХранилище(ТаблицаРНПТ, Адрес);

КонецПроцедуры

&НаСервере
Процедура ПоместитьМатериалыВХранилищеНаСервере(ПараметрыПодбора)
	
	ПараметрыПодбора.ПараметрыТчДокумента = Новый Структура("АдресТчВХранилище");
	КолонкиРеквизитов = УправлениеМатериальнымиЗапасами.КолонкиПодбораДляВыгрузкиТабличнойЧасти(ЭтотОбъект.ПолучитьРеквизиты("Объект.Материалы"));
	ТаблицаМатериалы = Объект.Материалы.Выгрузить(,КолонкиРеквизитов);
	ПараметрыПодбора.ПараметрыТчДокумента.АдресТчВХранилище = ПоместитьВоВременноеХранилище(ТаблицаМатериалы, ЭтотОбъект.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораРНПТННаКлиенте(ВыбранноеЗначение)
	
	СтрокаТабличнойЧасти = Элементы.Материалы.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
		СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыбранноеЗначение.ВариантКомплектаПТ) Тогда
		СтрокаТабличнойЧасти.ВариантКомплектаПТ = ВыбранноеЗначение.ВариантКомплектаПТ; 
	КонецЕсли;

	ОбработкаВыбораРНПТННаСервере(СтрокаТабличнойЧасти.ИдентификаторСтроки, ВыбранноеЗначение, СтрокаТабличнойЧасти.ПолучитьИдентификатор());
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораРНПТННаСервере(Знач ИдентификаторСтроки, Знач ВыбранноеЗначение, Знач ИдентификаторСтрокиВнутр)
	
	СтрокаТабличнойЧасти = Объект.Материалы.НайтиПоИдентификатору(ИдентификаторСтрокиВнутр);
	ПрослеживаемостьФормыБГУ.ОбработкаВыбораРНПТН(ЭтотОбъект, ИдентификаторСтроки, ВыбранноеЗначение);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_УправлениеПрослеживаемостью()

	РассчитатьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура РассчитатьПрослеживаемыеТовары()

	ПрослеживаемыеТовары     = Объект.Материалы.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	ЕстьПрослеживаемыеТовары = ПрослеживаемыеТовары.Количество() > 0;

КонецПроцедуры

#Область УчетДрагМатериалов

&НаСервере
Функция СтруктураПараметровПолученияОстатков()
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ссылка",Объект.Ссылка);
	СтруктураПараметров.Вставить("Период",Объект.Дата);
	
	Если Объект.Ссылка.Пустая() Тогда
		СтруктураПараметров.Период = КонецДня(Объект.Дата);
	Иначе
		СтруктураПараметров.Период = Объект.Дата;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	ПараметрыПолученияОстатков = СтруктураПараметровПолученияОстатков();
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);

	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
КонецПроцедуры	
	
&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	ТЧ = Объект.Материалы.Выгрузить();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОбъектовНФА.Номенклатура,
			|	ТаблицаОбъектовНФА.Количество КАК Количество
			|ПОМЕСТИТЬ СписокНФАСписания
			|ИЗ
			|	&ТаблицаОбъектовНФА КАК ТаблицаОбъектовНФА
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СписокНФАСписания.Номенклатура КАК ОбъектНФА,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
			|	СписокНФАСписания.Количество
			|ИЗ
			|	СписокНФАСписания КАК СписокНФАСписания";
			
	Запрос.УстановитьПараметр("ТаблицаОбъектовНФА", ТЧ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМЗ(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков);

	ТаблицаДМДляНФА = Объект.Материалы.Выгрузить(, "Номенклатура,Количество");
	ОстаткиДМДляЗаполнения = УчетДрагМатериалов.СодержаниеДрагМатериаловСУчетомТехДокументации(ОстаткиДМ, ТаблицаДМДляНФА);  
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМДляЗаполнения);
	
	Для Каждого ТекСтрока Из Объект.Материалы Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.Номенклатура);
		НайденныеСтроки = ОстаткиДМ.НайтиСтроки(ПараметрыОтбора);		
		Если ТипЗнч(НайденныеСтроки) = Тип("Массив") Тогда
			Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
				ТекСтрока.КоличествоВсегоДМ = ТекСтрокаМассива.КоличествоВсего; 
				Прервать;
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	Для каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, "");
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	ТаблицаВсехОбъектов = Объект.Материалы.Выгрузить(,"Номенклатура, Количество, КоличествоВсегоДМ");
	
	ТаблицаОбъектовМЗ = Новый ТаблицаЗначений;
	ТаблицаОбъектовМЗ.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаОбъектовМЗ.Колонки.Добавить("КоличествоВсегоДМ",Новый ОписаниеТипов("Число"));
	
	НеСодержатДрагМатериалы = УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов();
	
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			Если НеСодержатДрагМатериалы.Найти(ТекСтрока.Номенклатура.ТипНоменклатуры) = Неопределено Тогда
				НоваяСтрока = ТаблицаОбъектовМЗ.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.Номенклатура, ""); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовМЗ);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;	
	
	//Заголовки
	РеквизитыДрагМатериалы = Новый Массив;
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМЗаголовок");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоЗаголовок");
	
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличествоВсегоДМ");
	РеквизитыДрагМатериалы.Добавить("СписокНФАДокументаОснованияКоличество");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыДрагМатериалы, "Видимость", Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока)

	ТекущаяСтрока.КоличествоВсегоДМЗаголовок = НСтр("ru = 'Всего:'");
	ТекущаяСтрока.КоличествоЗаголовок = НСтр("ru = 'Списать:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОбъектовДрагМатериалов(Форма)
	
	Для каждого ТекущаяСтрока Из Форма.ОбъектыНФАСДрагМатериалами Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОбъектовДрагМатериалов(ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	Если ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
КонецПроцедуры

&НаСервере
Функция ЕдиницыИзмеренияДрагМатериалов(ВидДрагМатериала)
	Возврат УчетДрагМатериалов.ЕдиницыИзмеренияДрагМатериалов(ВидДрагМатериала);
КонецФункции	

&НаСервере
Процедура ЗаполнитьСписокДрагМатериалыПолученныеПоТехДокументацииНаСервере()
 	КС = Новый КвалификаторыСтроки(100);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	ТаблицаНФА = Объект.ПолученныеМатериалы.Выгрузить();
	ТаблицаНФА.Колонки.Добавить("КлючСтроки", ОписаниеТиповС, "Ключ строки", 100);
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументацииПоДеталям(ТаблицаНФА, "Материалы");
	Объект.ДрагоценныеМатериалыВПолученныхМЦ.Загрузить(ТаблицаНФА);
КонецПроцедуры	

