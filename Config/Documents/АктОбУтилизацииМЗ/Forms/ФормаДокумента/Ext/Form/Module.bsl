	ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
	УстановитьРуководителя(Объект);
	
	УстановитьСвойстваСчетаЗабаланса();
	УстановитьВидимостьЭлементов(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	НовыйРуководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель",
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Если ЗначениеЗаполнено(НовыйРуководитель.ОтветственноеЛицоСсылка) 
		И Объект.Руководитель <> НовыйРуководитель.ОтветственноеЛицоСсылка Тогда
		Объект.Руководитель = НовыйРуководитель.ОтветственноеЛицоСсылка;
		#Если НаКлиенте Тогда
		ПоказатьОповещениеПользователя(,,НСтр("ru = 'Установлено новое значение поля ""Руководитель""'"));			
		#КонецЕсли
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваСчетаЗабаланса()
	
	ПериодСчета = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	
	ЭтотОбъект.КэшПараметров.Локальные.Вставить("Счет024",
		БухгалтерскийУчет.СчетПоКоду("02.4", ПериодСчета, Объект.Организация));

	Если Счет024 <> ЭтотОбъект.КэшПараметров.Локальные.Счет024 Тогда
		
		Счет024 = ЭтотОбъект.КэшПараметров.Локальные.Счет024;
		ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Объект.Организация, Ложь);
		ПараметрыДанныхСчетов.ДатаСчета = ПериодСчета;
		ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
		
		Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
			Если ДанныеСчета.ТекущийСчет = Счет024 Тогда
				ВидСубконтоДопАналитики024 = ДанныеСчета.ДополнительноеСубконто;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(ВидСубконтоДопАналитики024) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Элементы,
			"МатериалыДополнительнаяАналитикаСчета",
			"ОграничениеТипа",
			ВидСубконтоДопАналитики024.ТипЗначения);
		КонецЕсли;
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияФлажкаАннулирован(Результат, ДополнительныеПараметры) Экспорт
