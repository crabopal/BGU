#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = СписокНоменклатуры.Итог("ВсегоПоФакту");
	КоличествоРасхождений = СписокНоменклатуры.Итог("КоличествоПоФакту") - СписокНоменклатуры.Итог("КоличествоПоДокументам");
	СуммаРасхождений = СписокНоменклатуры.Итог("ВсегоПоФакту") - СписокНоменклатуры.Итог("ВсегоПоДокументам");
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		ЗаполнитьПоПоступлениюУслугРабот(ДанныеЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ЭлектронныйДокументПоставщика) Экспорт
	ДокументОснование = ЭлектронныйДокументПоставщика;
	
	БолееРаннийАкт = ЭлектронныеДокументыБГУ.НайтиАктОРасхожденияхПоОснованию(ЭлектронныйДокументПоставщика);
	
	Если ЗначениеЗаполнено(БолееРаннийАкт) Тогда
		ИсправляемыйДокумент = БолееРаннийАкт;
		
		ДокументИсправление = ИсправляемыйДокумент;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДокументИсправление, ,"Номер,СписокНоменклатуры, СертификатыСоответствия, СведенияПоТранспортнымДокументам, ПрилагаемыеДокументы, СоставКомиссии, ДополнительныеРеквизиты");
		СписокНоменклатуры.Загрузить(ДокументИсправление.СписокНоменклатуры.Выгрузить());
		СертификатыСоответствия.Загрузить(ДокументИсправление.СертификатыСоответствия.Выгрузить());
		СведенияПоТранспортнымДокументам.Загрузить(ДокументИсправление.СведенияПоТранспортнымДокументам.Выгрузить());
		ПрилагаемыеДокументы.Загрузить(ДокументИсправление.ПрилагаемыеДокументы.Выгрузить());
		СоставКомиссии.Загрузить(ДокументИсправление.СоставКомиссии.Выгрузить());
		ДополнительныеРеквизиты.Загрузить(ДокументИсправление.ДополнительныеРеквизиты.Выгрузить());
		
		ИсправляемыйДокумент = ДокументИсправление;
		НомерИсправления = ДокументИсправление.НомерИсправления + 1;
		
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеДанные = "Организация, Контрагент, Договор, ВалютаДокумента, СуммаВключаетНДС, Грузополучатель, Отправитель, 
	|ДатаПолученияТоваров, ОтветственныйПринялТоварыВид, ОтветственныйПринялТоварыДолжность, ОтветственныйПринялТоварыИныеСведения,
	|ОтветственныйПринялТовары, ОтветственныйПринялТоварыДоверенность, ОтветственныйПринялТоварыОснованиеПолномочий, ОтветственныйПринялТоварыКонтрагент,
	|ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	Грузоотправитель = ДанныеДокументаОснования.Отправитель;
	
	СопроводительныйДокументНаименование = ДанныеДокументаОснования.ВидПервичногоДокумента;
	СопроводительныйДокументНомер = ДанныеДокументаОснования.НомерПервичногоДокумента;
	СопроводительныйДокументДата = ДанныеДокументаОснования.ДатаПервичногоДокумента;
	
	РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокументаОснования.Договор, РеквизитыДоговора);
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.ИдентификаторГосконтракта) Тогда
		ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
	КонецЕсли;	
	
	Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.СписокНоменклатуры Цикл
		НоваяСтрока = СписокНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
		НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Цена;
		НоваяСтрока.СуммаПоДокументам = ТекСтрока.Сумма;
		НоваяСтрока.СтавкаНДСПоДокументам = ТекСтрока.СтавкаНДС;
		НоваяСтрока.СуммаНДСПоДокументам = ТекСтрока.СуммаНДС;
		НоваяСтрока.ВсегоПоДокументам = ТекСтрока.Всего;
		
		НоваяСтрока.КоличествоПоФакту = ТекСтрока.Количество;
		НоваяСтрока.ЦенаПоФакту = ТекСтрока.Цена;
		НоваяСтрока.СуммаПоФакту = ТекСтрока.Сумма;
		НоваяСтрока.СтавкаНДСПоФакту = ТекСтрока.СтавкаНДС;
		НоваяСтрока.СуммаНДСПоФакту = ТекСтрока.СуммаНДС;
		НоваяСтрока.ВсегоПоФакту = ТекСтрока.Всего;
		
		НаборНоменклатурыКонтрагентов = Новый Массив;
		
		НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
			Контрагент, ТекСтрока.ИдентификаторПоставщика);
				
		НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
		
		Отбор = Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов);
		Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
		Для Каждого Элемент Из Сопоставление Цикл
			Представление = Элемент.НоменклатураКонтрагента.Наименование;	
			НоваяСтрока.НаименованиеТовара = Представление;
		КонецЦикла;	
	КонецЦикла;
	
	//коды маркировки
	Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.КодыУпаковокМаркируемойПродукции Цикл
		НоваяСтрока = КодыУпаковокМаркируемойПродукцииПоДокументам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока = КодыУпаковокМаркируемойПродукцииПоФакту.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьПоПоступлениюУслугРабот(ЭлектронныйДокументПоставщика) Экспорт
	ДокументОснование = ЭлектронныйДокументПоставщика;
	
	БолееРаннийАкт = ЭлектронныеДокументыБГУ.НайтиАктОРасхожденияхПоОснованию(ЭлектронныйДокументПоставщика);
	
	Если ЗначениеЗаполнено(БолееРаннийАкт) Тогда
		ИсправляемыйДокумент = БолееРаннийАкт;
		
		ДокументИсправление = ИсправляемыйДокумент;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДокументИсправление, ,"Номер, СписокНоменклатуры, СертификатыСоответствия, СведенияПоТранспортнымДокументам, ПрилагаемыеДокументы, СоставКомиссии, ДополнительныеРеквизиты");
		СписокНоменклатуры.Загрузить(ДокументИсправление.СписокНоменклатуры.Выгрузить());
		СертификатыСоответствия.Загрузить(ДокументИсправление.СертификатыСоответствия.Выгрузить());
		СведенияПоТранспортнымДокументам.Загрузить(ДокументИсправление.СведенияПоТранспортнымДокументам.Выгрузить());
		ПрилагаемыеДокументы.Загрузить(ДокументИсправление.ПрилагаемыеДокументы.Выгрузить());
		СоставКомиссии.Загрузить(ДокументИсправление.СоставКомиссии.Выгрузить());
		ДополнительныеРеквизиты.Загрузить(ДокументИсправление.ДополнительныеРеквизиты.Выгрузить());
		
		ИсправляемыйДокумент = ДокументИсправление;
		НомерИсправления = ДокументИсправление.НомерИсправления + 1;
		
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеДанные = "Организация, Контрагент, Договор, ВалютаДокумента, СуммаВключаетНДС,  
	|ДатаПолученияУслугиРаботы, ОтветственныйПринялУслугиРаботыВид, ОтветственныйПринялУслугиРаботыДолжность, ОтветственныйПринялУслугиРаботыИныеСведения,
	|ОтветственныйПринялУслугиРаботы, ОтветственныйПринялУслугиРаботыДоверенность, ОтветственныйПринялУслугиРаботыОснованиеПолномочий, ОтветственныйПринялУслугиРаботыКонтрагент,
	|ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента";
	ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокументаОснования);
	
	СопроводительныйДокументНаименование = ДанныеДокументаОснования.ВидПервичногоДокумента;
	СопроводительныйДокументНомер = ДанныеДокументаОснования.НомерПервичногоДокумента;
	СопроводительныйДокументДата = ДанныеДокументаОснования.ДатаПервичногоДокумента;
	
	РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокументаОснования.Договор, РеквизитыДоговора);
	
	Если ЗначениеЗаполнено(РеквизитыДоговора.ИдентификаторГосконтракта) Тогда
		ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
	КонецЕсли;	
	
	Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.УслугиИРаботы Цикл
		НоваяСтрока = СписокНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
		Если ТекСтрока.Количество = 0 Тогда
			НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Сумма;
		Иначе	
			НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Сумма / ТекСтрока.Количество;
		КонецЕсли;
		НоваяСтрока.СуммаПоДокументам = ТекСтрока.Сумма;
		НоваяСтрока.СтавкаНДСПоДокументам = ТекСтрока.СтавкаНДС;
		НоваяСтрока.СуммаНДСПоДокументам = ТекСтрока.СуммаНДС;
		НоваяСтрока.ВсегоПоДокументам = ТекСтрока.Всего;
		
		НоваяСтрока.КоличествоПоФакту = ТекСтрока.Количество;
		Если ТекСтрока.Количество = 0 Тогда
			НоваяСтрока.ЦенаПоФакту = ТекСтрока.Сумма;
		Иначе	
			НоваяСтрока.ЦенаПоФакту = ТекСтрока.Сумма / ТекСтрока.Количество;
		КонецЕсли;
		НоваяСтрока.СуммаПоФакту = ТекСтрока.Сумма;
		НоваяСтрока.СтавкаНДСПоФакту = ТекСтрока.СтавкаНДС;
		НоваяСтрока.СуммаНДСПоФакту = ТекСтрока.СуммаНДС;
		НоваяСтрока.ВсегоПоФакту = ТекСтрока.Всего;
		
		НоваяСтрока.НаименованиеТовара = ТекСтрока.Содержание;
		
		НаборНоменклатурыКонтрагентов = Новый Массив;
		
		НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
			Контрагент, ТекСтрока.ИдентификаторПоставщика);
				
		НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
		
		Отбор = Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов);
		Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
		Для Каждого Элемент Из Сопоставление Цикл
			Представление = Элемент.НоменклатураКонтрагента.Наименование;	
			НоваяСтрока.НаименованиеТовара = Представление;
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры
	

#КонецОбласти

#КонецЕсли

