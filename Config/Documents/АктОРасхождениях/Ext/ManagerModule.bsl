#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ПодготовкаДанныхЭДО

Функция ПодготовитьДанныеДляЭД(ДокументСсылка) Экспорт
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.ВалютаДокумента) Тогда
		КурсВзаиморасчетов = 1;
		КратностьВзаиморасчетов = 1;
	Иначе
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументСсылка.ВалютаДокумента, ДокументСсылка.Дата);
		КурсВзаиморасчетов = КурсКратность.Курс;
		КратностьВзаиморасчетов = КурсКратность.Кратность;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	АктОРасхождениях.Номер КАК Номер,
	               |	АктОРасхождениях.Дата КАК Дата,
	               |	АктОРасхождениях.Организация КАК Организация,
	               |	АктОРасхождениях.Контрагент КАК Контрагент,
	               |	АктОРасхождениях.ДокументОснование КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.Договор КАК Справочник.Договоры) КАК Договор,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.Договор КАК Справочник.Договоры).НомерДоговора КАК ДоговорНомер,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДоговорДата,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДоговорНаименование,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.ОснованиеЗаполненияСоставителем КАК Справочник.Договоры).НомерДоговора КАК ДоверенностьНомер,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.ОснованиеЗаполненияСоставителем КАК Справочник.Договоры).ДатаДоговора КАК ДоверенностьДата,
	               |	ВЫРАЗИТЬ(АктОРасхождениях.ОснованиеЗаполненияСоставителем КАК Справочник.Договоры).ВидОбязательства КАК ДоверенностьНаименование,
	               |	ВЫБОР
	               |		КОГДА АктОРасхождениях.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(АктОРасхождениях.ВалютаДокумента КАК Справочник.Валюты).Код
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код
	               |	КОНЕЦ КАК ВалютаКод,
	               |	ВЫБОР
	               |		КОГДА АктОРасхождениях.ВалютаДокумента <> ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	               |			ТОГДА ВЫРАЗИТЬ(АктОРасхождениях.ВалютаДокумента КАК Справочник.Валюты).НаименованиеПолное
	               |		ИНАЧЕ ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).НаименованиеПолное
	               |	КОНЕЦ КАК ВалютаНаименование,
	               |	&КурсВзаиморасчетов КАК Курс,
	               |	ВЫБОР
