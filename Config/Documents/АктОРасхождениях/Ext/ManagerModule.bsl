Функция ПредварительныйКонтрольДанныхДляЭД(ДокументСсылка) Экспорт
	Результат = Истина;
	
	ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ДокументСсылка.Организация, ВидКИАдрес);
		
	Если НЕ ЗначениеЗаполнено(АдресОрганизации) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес организации.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если ДокументСсылка.НомерИсправления <> 0 Тогда
		Если НЕ ЗначениеЗаполнено(ДокументСсылка.ИсправляемыйДокумент) Тогда
			ОписаниеОшибки = НСтр("ru='Указан номер исправления, но не заполнен исправляемый документ.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	Иначе
		Контрагент = ДокументСсылка.Контрагент;
		
		Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
			Иначе
				ВидКИАдрес = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			КонецЕсли;
			АдресКонтрагента = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Контрагент.ЮридическоеФизическоеЛицо, ВидКИАдрес);
			
			Если НЕ ЗначениеЗаполнено(АдресКонтрагента) Тогда
				ОписаниеОшибки = НСтр("ru='Не заполнен юридический адрес контрагента.'");
				ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
				Результат = Ложь;
			КонецЕсли;	
		Иначе
			ОписаниеОшибки = НСтр("ru='Не заполнено юридическое/физическое лицо контрагента.'");
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСсылка.КраткоеОписаниеСобытия) Тогда
		ДлинаРеквизита = СтрДлина(ДокументСсылка.КраткоеОписаниеСобытия);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Краткое описание события"" на закладке ""Основное"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.УсловияХраненияТоваровНаСкладеПолучателя) Тогда
		ДлинаРеквизита = СтрДлина(ДокументСсылка.УсловияХраненияТоваровНаСкладеПолучателя);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Условия хранения товаров на складе получателя"" на закладке ""Приемка"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.СостояниеТарыУпаковки) Тогда
		ДлинаРеквизита = СтрДлина(ДокументСсылка.СостояниеТарыУпаковки);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Состояние тары упаковки"" на закладке ""Приемка"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДокументСсылка.ДополнительныеСведенияПриемки) Тогда
		ДлинаРеквизита = СтрДлина(ДокументСсылка.ДополнительныеСведенияПриемки);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Дополнительные сведения приемки"" на закладке ""Приемка"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументСсылка.ЗаключениеКомиссии) Тогда
		ДлинаРеквизита = СтрДлина(ДокументСсылка.ЗаключениеКомиссии);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Заключение комиссии"" на закладке ""Заключение комиссии"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена номенклатура в строке %1 таблицы на закладке ""Товары, работы, услуги и иное"".'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		НаименованиеТовара = СокрЛП(ТекСтрока.НаименованиеТовара);
		ДлинаРеквизита = СтрДлина(НаименованиеТовара);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Наименование товара"" списка номенклатуры в строке %1 таблицы на закладке ""Товары, работы, услуги и иное"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		ХарактеристикаТовара = СокрЛП(ТекСтрока.ХарактеристикаТовара);
		ДлинаРеквизита = СтрДлина(ХарактеристикаТовара);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Характеристика товара"" списка номенклатуры в строке %1 таблицы на закладке ""Товары, работы, услуги и иное"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		ИнформацияОРасхождениях = СокрЛП(ТекСтрока.ИнформацияОРасхождениях);
		ДлинаРеквизита = СтрДлина(ИнформацияОРасхождениях);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Информация о расхождениях"" списка номенклатуры в строке %1 таблицы на закладке ""Товары, работы, услуги и иное"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДокументСсылка.СведенияПоТранспортнымДокументам Цикл
		НаименованиеГруза = СокрЛП(ТекСтрока.НаименованиеГруза);
		ДлинаРеквизита = СтрДлина(НаименованиеГруза);
		Если ДлинаРеквизита > 1000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Наименование груза"" списка ""Транспортные документы"" в строке %1 таблицы на закладке ""Документы"" действует ограничение 1000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
		
		ОтметкиОтправителя = СокрЛП(ТекСтрока.ОтметкиОтправителя);
		ДлинаРеквизита = СтрДлина(ОтметкиОтправителя);
		Если ДлинаРеквизита > 2000 Тогда
			ОписаниеОшибки = НСтр("ru='Для реквизита ""Отметки отправителя"" списка ""Транспортные документы"" в строке %1 таблицы на закладке ""Документы"" действует ограничение 2000 символов (длина значения %1 символов).'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, ТекСтрока.НомерСтроки, ДлинаРеквизита);
			ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
			Результат = Ложь;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

