&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ЗначениеСвойства;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	НаименованиеТовара = Параметры.НаименованиеТовара;
	АртикулТовара = Параметры.АртикулТовара;
	КодТовара = Параметры.КодТовара;
	СортТовара = Параметры.СортТовара;
	ПаспортТовара = Параметры.ПаспортТовара;
	ХарактеристикаТовара = Параметры.ХарактеристикаТовара;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ПеренестиВДокумент = Истина Тогда
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("АртикулТовара", АртикулТовара);
		СтруктураДанных.Вставить("КодТовара", КодТовара);
		СтруктураДанных.Вставить("СортТовара", СортТовара);
		СтруктураДанных.Вставить("ПаспортТовара", ПаспортТовара);
		СтруктураДанных.Вставить("ХарактеристикаТовара", ХарактеристикаТовара);
		СтруктураДанных.Вставить("ИдентификаторСтроки", ИдентификаторСтроки);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = Данные не будут внесены в документ.
			|
			|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

	

#КонецОбласти
