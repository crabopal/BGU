	ДанныеИныхСведенийОНоменклатуре = ДанныеИныхСведенийОНоменклатуре(Форма, ТекущаяСтрока);
	ТекстИныеСведения = ДанныеИныхСведенийОНоменклатуре.ТекстИныхСведений;
	ЕстьИныеСведения = ДанныеИныхСведенийОНоменклатуре.ЕстьИныеСведения;
	ОбновитьТекстИныеСведения(Форма, ТекущаяСтрока, ЕстьИныеСведения, ТекстИныеСведения);
