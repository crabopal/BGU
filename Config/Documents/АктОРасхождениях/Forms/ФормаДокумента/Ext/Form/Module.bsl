// "Объект" передается явно, без этого данные объекта не заполняются в web-клиенте.
&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект)	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	ОбновитьТекстЗаголовковВсехСтрокТаблицыСписокНоменклатуры(ЭтаФорма);
	ОбновитьТекстИныеСведенияВсехСтрокТаблицыСписокНоменклатуры(ЭтаФорма);
	ОбновитьТекстЗаголовковВсехСтрокТаблицыСведенияПоТранспортнымДокументам(ЭтаФорма);
	
	УстановитьДоступностьРеквизитовОрганизации(ЭтотОбъект);
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьОснованияСоставления(ЭтотОбъект);
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРеквизитовОрганизации(Форма)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Подразделение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация));

КонецПроцедуры // УстановитьДоступностьРеквизитовОрганизации()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Контрагент));

КонецПроцедуры

&НаКлиенте
Процедура ДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОснованияСоставления(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОснованиеЗаполненияСоставителем",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Составитель));

КонецПроцедуры

&НаКлиенте
Процедура ДоступностьОснованияСоставления()

	Элементы.ОснованиеЗаполненияСоставителем.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Составитель);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеСтрокиЦенаНДСВалюта(Форма)

	Объект = Форма.Объект;
	
	ПараметрыПредставления = Новый Структура("ВалютаДокумента, СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ПараметрыПредставления, Объект);
	ПараметрыПредставления.Вставить("ПоказыватьНДС", Истина);
	ПараметрыПредставления.Вставить("ПоказыватьВалюту", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	Форма.НадписьВалютаНДС = БухгалтерскийУчетКлиентСервер.ПредставлениеСтрокиЦенаНДСВалюта(
		ПараметрыПредставления);
		
КонецПроцедуры
	
&НаКлиенте
Процедура ПослеЗакрытияВыбораТипаЦеныВалютыНДС(Результат, ДополнительныеПараметры) Экспорт

	Если ЭтотОбъект.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента Тогда
		БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.Локальные.СуммаВключаетНДС <> Объект.СуммаВключаетНДС Тогда
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
	
	УстановитьПредставлениеСтрокиЦенаНДСВалюта(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ДатаПриИзмененииНаСервере()
	
	Если ЭтотОбъект.КэшПараметров.ИзмениласьУчетнаяПолитика Тогда
		
		ОбщегоНазначенияБГУ.ПриИзмененииУчетнойПолитики(ЭтотОбъект, Объект);
		
	КонецЕсли;
	
	БухгалтерскиеОперацииКлиентСервер.ОбновитьКурсВалютыВФормеДокумента(ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьТабличнуюЧасть()
	Для Каждого СтрокаТЧ из Объект.СписокНоменклатуры Цикл
		РассчитатьСтроку(СтрокаТЧ, Объект.СуммаВключаетНДС, "Сумма");
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	РассчитатьСтрокуПоДокументам(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита);
	РассчитатьСтрокуПоФакту(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтрокуПоДокументам(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	Если ИмяРеквизита = "КоличествоПоДокументам"
		ИЛИ ИмяРеквизита = "ЦенаПоДокументам"
		ИЛИ ИмяРеквизита = "СуммаПоДокументам"
		ИЛИ ИмяРеквизита = "ВсегоПоДокументам"
		ИЛИ ИмяРеквизита = "СтавкаНДСПоДокументам"
		ИЛИ ИмяРеквизита = "СуммаНДСПоДокументам" Тогда
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("ИмяРеквизитаКоличество", "КоличествоПоДокументам");
		ПараметрыРасчета.Вставить("ИмяРеквизитаЦена", "ЦенаПоДокументам");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСтавкаНДС", "СтавкаНДСПоДокументам");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСуммаНДС", "СуммаНДСПоДокументам");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСумма", "СуммаПоДокументам");
		ПараметрыРасчета.Вставить("ИмяРеквизитаВсего", "ВсегоПоДокументам");
		
		Если ИмяРеквизита = "СуммаПоДокументам" ИЛИ  ИмяРеквизита = "ВсегоПоДокументам" Тогда
			ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
		КонецЕсли;
		
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита, "ПоДокументам", "");
		
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтрокуПоФакту(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	Если ИмяРеквизита = "КоличествоПоФакту"
		ИЛИ ИмяРеквизита = "ЦенаПоФакту"
		ИЛИ ИмяРеквизита = "СуммаПоФакту"
		ИЛИ ИмяРеквизита = "ВсегоПоФакту"
		ИЛИ ИмяРеквизита = "СтавкаНДСПоФакту"
		ИЛИ ИмяРеквизита = "СуммаНДСПоФакту" Тогда
		
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("ИмяРеквизитаКоличество", "КоличествоПоФакту");
		ПараметрыРасчета.Вставить("ИмяРеквизитаЦена", "ЦенаПоФакту");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСтавкаНДС", "СтавкаНДСПоФакту");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСуммаНДС", "СуммаНДСПоФакту");
		ПараметрыРасчета.Вставить("ИмяРеквизитаСумма", "СуммаПоФакту");
		ПараметрыРасчета.Вставить("ИмяРеквизитаВсего", "ВсегоПоФакту");
		
		Если ИмяРеквизита = "СуммаПоФакту" ИЛИ  ИмяРеквизита = "ВсегоПоФакту" Тогда
			ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
		КонецЕсли;
		
		ИмяРеквизита = СтрЗаменить(ИмяРеквизита, "ПоФакту", "");
		
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	КонецЕсли;
	
КонецПроцедуры

