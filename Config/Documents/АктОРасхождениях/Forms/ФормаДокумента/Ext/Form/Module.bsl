		Объект.ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияПоТранспортнымДокументам(ТекущаяСтрока)

	ТекущаяСтрока.ЗаголовокОтметкаОбОпломбировании = НСтр("ru = 'опломбирование:'");
	ТекущаяСтрока.ЗаголовокВидУпаковки = НСтр("ru = 'вид упаковки:'");
	
	ТекущаяСтрока.ЗаголовокКоличество = НСтр("ru = 'количество:'");
	ТекущаяСтрока.ЗаголовокЕдиницаИзмерения = НСтр("ru = 'ед.изм.:'");
	
	ТекущаяСтрока.ЗаголовокНоменклатураГруза = НСтр("ru = 'номенклатура:'");
	ТекущаяСтрока.ЗаголовокНаименованиеГруза = НСтр("ru = 'наименование:'");
	
	ТекущаяСтрока.ЗаголовокМассаОтправленияБрутто = НСтр("ru = 'брутто:'");
	ТекущаяСтрока.ЗаголовокМассаОтправленияНетто = НСтр("ru = 'нетто:'");
	
	ТекущаяСтрока.ЗаголовокМассаПрибытияБрутто = НСтр("ru = 'брутто:'");
	ТекущаяСтрока.ЗаголовокМассаПрибытияНетто = НСтр("ru = 'нетто:'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыСведенияПоТранспортнымДокументам(Форма)

	Объект = Форма.Объект;
	
	Для Каждого ТекущаяСтрока Из Объект.СведенияПоТранспортнымДокументам Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыСведенияПоТранспортнымДокументам(ТекущаяСтрока);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДокументОснованиеПриИзмененииНаСервере()
	ЭлектронныйДокументПоставщика = Объект.ДокументОснование;
	
	БолееРаннийАкт = ЭлектронныеДокументыБГУ.НайтиАктОРасхожденияхПоОснованию(ЭлектронныйДокументПоставщика, Объект.Ссылка);
	
	Если ЗначениеЗаполнено(БолееРаннийАкт) Тогда
		Объект.ИсправляемыйДокумент = БолееРаннийАкт;
		ДокументИсправлениеПриИзмененииНаСервере();
		
		Возврат;
	КонецЕсли;	
	
	Если ТипЗнч(ЭлектронныйДокументПоставщика) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		
		Если ЗначениеЗаполнено(ЭлектронныйДокументПоставщика) Тогда
			ЗаполняемыеДанные = "Организация, Контрагент, Договор, ВалютаДокумента, СуммаВключаетНДС, Грузополучатель, Отправитель, 
			|ДатаПолученияТоваров, ОтветственныйПринялТоварыВид, ОтветственныйПринялТоварыДолжность, ОтветственныйПринялТоварыИныеСведения,
			|ОтветственныйПринялТовары, ОтветственныйПринялТоварыДоверенность, ОтветственныйПринялТоварыОснованиеПолномочий, ОтветственныйПринялТоварыКонтрагент,
			|ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента";
			ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ДокументОснование, ЗаполняемыеДанные);
			ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
			Объект.Грузоотправитель = ДанныеДокументаОснования.Отправитель;
			
			Объект.СопроводительныйДокументНаименование = ДанныеДокументаОснования.ВидПервичногоДокумента;
			Объект.СопроводительныйДокументНомер = ДанныеДокументаОснования.НомерПервичногоДокумента;
			Объект.СопроводительныйДокументДата = ДанныеДокументаОснования.ДатаПервичногоДокумента;
			
			РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
			Если ЗначениеЗаполнено(ДанныеДокументаОснования.Договор) Тогда
				РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокументаОснования.Договор, РеквизитыДоговора);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(РеквизитыДоговора.ИдентификаторГосконтракта) Тогда
				Объект.ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
			КонецЕсли;	
			
			Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.СписокНоменклатуры Цикл
				НоваяСтрока = Объект.СписокНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
				НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Цена;
				НоваяСтрока.СуммаПоДокументам = ТекСтрока.Сумма;
				НоваяСтрока.СтавкаНДСПоДокументам = ТекСтрока.СтавкаНДС;
				НоваяСтрока.СуммаНДСПоДокументам = ТекСтрока.СуммаНДС;
				НоваяСтрока.ВсегоПоДокументам = ТекСтрока.Всего;
				
				НоваяСтрока.КоличествоПоФакту = ТекСтрока.Количество;
				НоваяСтрока.ЦенаПоФакту = ТекСтрока.Цена;
				НоваяСтрока.СуммаПоФакту = ТекСтрока.Сумма;
				НоваяСтрока.СтавкаНДСПоФакту = ТекСтрока.СтавкаНДС;
				НоваяСтрока.СуммаНДСПоФакту = ТекСтрока.СуммаНДС;
				НоваяСтрока.ВсегоПоФакту = ТекСтрока.Всего;
				
				НаборНоменклатурыКонтрагентов = Новый Массив;
				
				НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
					Объект.Контрагент, ТекСтрока.ИдентификаторПоставщика);
						
				НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
				
				Отбор = Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов);
				Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
				Для Каждого Элемент Из Сопоставление Цикл
					Представление = Элемент.НоменклатураКонтрагента.Наименование;	
					НоваяСтрока.НаименованиеТовара = Представление;
				КонецЦикла;	
			КонецЦикла;
			
			//коды маркировки
			Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.КодыУпаковокМаркируемойПродукции Цикл
				НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукцииПоДокументам.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				
				НоваяСтрока = Объект.КодыУпаковокМаркируемойПродукцииПоФакту.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЭлектронныйДокументПоставщика) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		Если ЗначениеЗаполнено(ЭлектронныйДокументПоставщика) Тогда
			ДокументОснование = ЭлектронныйДокументПоставщика;
			
			БолееРаннийАкт = ЭлектронныеДокументыБГУ.НайтиАктОРасхожденияхПоОснованию(ЭлектронныйДокументПоставщика);
			
			Если ЗначениеЗаполнено(БолееРаннийАкт) Тогда
				Объект.ИсправляемыйДокумент = БолееРаннийАкт;
				ДокументИсправлениеПриИзмененииНаСервере();
				
				Возврат;
			КонецЕсли;
			
			ЗаполняемыеДанные = "Организация, Контрагент, Договор, ВалютаДокумента, СуммаВключаетНДС,  
			|ДатаПолученияУслугиРаботы, ОтветственныйПринялУслугиРаботыВид, ОтветственныйПринялУслугиРаботыДолжность, ОтветственныйПринялУслугиРаботыИныеСведения,
			|ОтветственныйПринялУслугиРаботы, ОтветственныйПринялУслугиРаботыДоверенность, ОтветственныйПринялУслугиРаботыОснованиеПолномочий, ОтветственныйПринялУслугиРаботыКонтрагент,
			|ВидПервичногоДокумента, НомерПервичногоДокумента, ДатаПервичногоДокумента";
			ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, ЗаполняемыеДанные);
			ЗаполнитьЗначенияСвойств(Объект, ДанныеДокументаОснования);
			
			Объект.СопроводительныйДокументНаименование = ДанныеДокументаОснования.ВидПервичногоДокумента;
			Объект.СопроводительныйДокументНомер = ДанныеДокументаОснования.НомерПервичногоДокумента;
			Объект.СопроводительныйДокументДата = ДанныеДокументаОснования.ДатаПервичногоДокумента;
			
			РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеДокументаОснования.Договор, РеквизитыДоговора);
			
			Если ЗначениеЗаполнено(РеквизитыДоговора.ИдентификаторГосконтракта) Тогда
				Объект.ИдентификаторГосКонтракта = РеквизитыДоговора.ИдентификаторГосконтракта;	
			КонецЕсли;	
			
			Для каждого ТекСтрока Из ЭлектронныйДокументПоставщика.УслугиИРаботы Цикл
				НоваяСтрока = Объект.СписокНоменклатуры.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
				НоваяСтрока.КоличествоПоДокументам = ТекСтрока.Количество;
				НоваяСтрока.ЦенаПоДокументам = ТекСтрока.Сумма / ТекСтрока.Количество;
				НоваяСтрока.СуммаПоДокументам = ТекСтрока.Сумма;
				НоваяСтрока.СтавкаНДСПоДокументам = ТекСтрока.СтавкаНДС;
				НоваяСтрока.СуммаНДСПоДокументам = ТекСтрока.СуммаНДС;
				НоваяСтрока.ВсегоПоДокументам = ТекСтрока.Всего;
				
				НоваяСтрока.КоличествоПоФакту = ТекСтрока.Количество;
				НоваяСтрока.ЦенаПоФакту = ТекСтрока.Сумма / ТекСтрока.Количество;
				НоваяСтрока.СуммаПоФакту = ТекСтрока.Сумма;
				НоваяСтрока.СтавкаНДСПоФакту = ТекСтрока.СтавкаНДС;
				НоваяСтрока.СуммаНДСПоФакту = ТекСтрока.СуммаНДС;
				НоваяСтрока.ВсегоПоФакту = ТекСтрока.Всего;
				
				НоваяСтрока.НаименованиеТовара = ТекСтрока.Содержание;
				
				НаборНоменклатурыКонтрагентов = Новый Массив;
				
				НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
					Объект.Контрагент, ТекСтрока.ИдентификаторПоставщика);
						
				НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
				
				Отбор = Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов);
				Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
				Для Каждого Элемент Из Сопоставление Цикл
					Представление = Элемент.НоменклатураКонтрагента.Наименование;	
					НоваяСтрока.НаименованиеТовара = Представление;
				КонецЦикла;	
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
	ПодготовитьФормуНаСервере();	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовЭДО(Форма, ВидимостьЭлементовЭДО, ВидимостьЭлементовМаркировки)
	
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", ВидимостьЭлементовЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаКодыМаркировки", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыГруппаМаркировка", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыГруппаМаркировкаПоФакту", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыОтклоненияГруппаБракМаркировка", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыОтклоненияГруппаБойМаркировка", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыОтклоненияГруппаНедостачаМаркировка", "Видимость", ВидимостьЭлементовМаркировки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыОтклоненияГруппаИзлишкиМаркировка", "Видимость", ВидимостьЭлементовМаркировки);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуЭДО(Команда)
	
	ЭлектронноеВзаимодействиеКлиент.ВыполнитьПодключаемуюКомандуЭДО(Команда, ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ДокументИсправлениеПриИзмененииНаСервере()
	ДокументИсправление = Объект.ИсправляемыйДокумент;
	
	ЗаполнитьЗначенияСвойств(Объект, ДокументИсправление, ,"Номер, СписокНоменклатуры, СертификатыСоответствия, СведенияПоТранспортнымДокументам, ПрилагаемыеДокументы, СоставКомиссии, ДополнительныеРеквизиты");
	Объект.СписокНоменклатуры.Загрузить(ДокументИсправление.СписокНоменклатуры.Выгрузить());
	Объект.СертификатыСоответствия.Загрузить(ДокументИсправление.СертификатыСоответствия.Выгрузить());
	Объект.СведенияПоТранспортнымДокументам.Загрузить(ДокументИсправление.СведенияПоТранспортнымДокументам.Выгрузить());
	Объект.ПрилагаемыеДокументы.Загрузить(ДокументИсправление.ПрилагаемыеДокументы.Выгрузить());
	Объект.СоставКомиссии.Загрузить(ДокументИсправление.СоставКомиссии.Выгрузить());
	Объект.ДополнительныеРеквизиты.Загрузить(ДокументИсправление.ДополнительныеРеквизиты.Выгрузить());
	
	Объект.ИсправляемыйДокумент = ДокументИсправление;
	Объект.НомерИсправления = ДокументИсправление.НомерИсправления + 1;
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеНоменклатуры(Номенклатура)
	СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Код,НаименованиеПолное");
	
	Возврат СтруктураРезультат;
КонецФункции	

&НаКлиенте
Процедура РассчитатьИтоги()
	
	Объект.СуммаДокумента = Объект.СписокНоменклатуры.Итог("ВсегоПоФакту");
	Объект.КоличествоРасхождений = Объект.СписокНоменклатуры.Итог("КоличествоПоФакту") - Объект.СписокНоменклатуры.Итог("КоличествоПоДокументам");
	Объект.СуммаРасхождений = Объект.СписокНоменклатуры.Итог("ВсегоПоФакту") - Объект.СписокНоменклатуры.Итог("ВсегоПоДокументам");
	
КонецПроцедуры

&НаСервере
Функция МаркируемыйТовар(ИдентификаторНоменклатуры)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.СписокНоменклатуры.НайтиПоИдентификатору(ИдентификаторНоменклатуры).Номенклатура);
	СписокМаркируемыхТоваров = ЭлектронныеДокументыБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Процедура СоздатьКнопкуДляСодержанияИтоговПриемки(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиЗаполненияСодержанияИтоговПриемки";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Заполнить'");
	Команда.Подсказка = НСтр("ru = 'Заполнить содержание итогов приемки'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКнопкиЗаполненияСодержанияИтоговПриемки(КомандаФормы)
	
	Элемент = ЭтаФорма.Элементы.Найти(КомандаФормы.Имя);
	СписокДляСодержанияИтоговПриемки = СписокЗначенийВариантовСодержанияДополнительныхСведений();
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораСодержанияИтоговПриемки", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокДляСодержанияИтоговПриемки, Элемент);
	
КонецПроцедуры

&НаКлиенте
Функция СписокЗначенийВариантовСодержанияДополнительныхСведений() Экспорт

	Результат = Новый СписокЗначений;
	Результат.Добавить("Материальные ценности приняты и оприходованы", НСтр("ru = 'Материальные ценности приняты и оприходованы'"));
	Результат.Добавить("Документ о приемке и (или) расхождениях утверждаю", НСтр("ru = 'Документ о приемке и (или) расхождениях утверждаю'"));
		
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбораСодержанияИтоговПриемки(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Сред(ДополнительныеПараметры.Элемент.Имя,10);
	Объект[ИмяРеквизита] = ВыбранныйЭлемент; 
	
КонецПроцедуры


