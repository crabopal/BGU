			ТекДанныеСтроки.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);	
		КонецЕсли;
		
		Если НЕ ТекДанныеСтроки.МаркируемыйТоварБой Тогда
			ТекДанныеСтроки.МаркируемыйТоварБой = МаркируемыйТовар(ТекДанныеСтроки.ПолучитьИдентификатор());	
		КонецЕсли;	
		
		Если ТекДанныеСтроки.МаркируемыйТоварБой Тогда
			ЭлектронныеДокументыБГУКлиент.ВыбратьКодыМаркировкиАктаОРасхожденияхБой(ЭтотОбъект, СтандартнаяОбработка, "СписокНоменклатурыОтклонения");
