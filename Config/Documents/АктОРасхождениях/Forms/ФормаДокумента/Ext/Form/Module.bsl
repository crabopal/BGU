&НаКлиентеНаСервереБезКонтекста
Функция ДанныеИныхСведенийОНоменклатуре(Форма, ТекущиеИныеСведения)
	Объект = Форма.Объект;
	
	ЕстьСведения = Ложь;
	ТекстСведений = "";
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.АртикулТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений + "артикул: "+СокрЛП(ТекущиеИныеСведения.АртикулТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.СортТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," ")) + "сорт: "+СокрЛП(ТекущиеИныеСведения.СортТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.КодТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "код: "+СокрЛП(ТекущиеИныеСведения.КодТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.ПаспортТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "паспорт: "+СокрЛП(ТекущиеИныеСведения.ПаспортТовара);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекущиеИныеСведения.ХарактеристикаТовара) Тогда
		ЕстьСведения = Истина;
		ТекстСведений = ТекстСведений +(?(ЗначениеЗаполнено(ТекстСведений),", "," "))+ "характеристика: "+Сред(СокрЛП(ТекущиеИныеСведения.ХарактеристикаТовара),1,10)
			+ (?(СтрДлина(ТекущиеИныеСведения.ХарактеристикаТовара)>10,"...",""));
	КонецЕсли;	
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстИныхСведений", ТекстСведений);
	Результат.Вставить("ЕстьИныеСведения", ЕстьСведения);
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстИныеСведения(Форма, ТекущаяСтрока, ЕстьИныеСведения = Ложь, ТекстИныеСведения)
	Если ЕстьИныеСведения Тогда
		ТекущаяСтрока.ИныеСведения = СокрЛП(ТекстИныеСведения);
	Иначе
		ТекущаяСтрока.ИныеСведения = НСтр("ru = 'Ввести данные'");
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВводаДанныхОНоменклатуре(ВыбранноеЗначение)

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеСтроки = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИдентификаторСтроки", ВыбранноеЗначение);
	ПараметрыФормы.Вставить("АртикулТовара", ДанныеСтроки.АртикулТовара);
	ПараметрыФормы.Вставить("СортТовара", ДанныеСтроки.СортТовара);
	ПараметрыФормы.Вставить("КодТовара", ДанныеСтроки.КодТовара);
	ПараметрыФормы.Вставить("ПаспортТовара", ДанныеСтроки.ПаспортТовара);
	ПараметрыФормы.Вставить("ХарактеристикаТовара", ДанныеСтроки.ХарактеристикаТовара);
	ПараметрыФормы.Вставить("НаименованиеТовара", ДанныеСтроки.НаименованиеТовара);
	
	ОткрытьФорму("Документ.АктОРасхождениях.Форма.ФормаВводаДанныхНоменклатурыПоставщика", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияДанныхОНоменклатуреНаСервере(Знач ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Если ВыбранноеЗначение.Свойство("ИдентификаторСтроки") Тогда
			ДанныеСтроки = Объект.СписокНоменклатуры.НайтиПоИдентификатору(ВыбранноеЗначение.ИдентификаторСтроки);
			
			ДанныеСтроки.АртикулТовара = ВыбранноеЗначение.АртикулТовара;
			ДанныеСтроки.СортТовара = ВыбранноеЗначение.СортТовара;
			ДанныеСтроки.КодТовара = ВыбранноеЗначение.КодТовара;
			ДанныеСтроки.ПаспортТовара = ВыбранноеЗначение.ПаспортТовара;
			ДанныеСтроки.ХарактеристикаТовара = ВыбранноеЗначение.ХарактеристикаТовара;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМестоСоставленияНаСервере()
	ФактическийАдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Организация,
														Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
														
	Если НЕ ЗначениеЗаполнено(ФактическийАдресОрганизации) Тогда 													
		ФактическийАдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Объект.Организация,
														Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	КонецЕсли;
	
	Объект.МестоСоставленияДокумента = АдресБезИндекса(ФактическийАдресОрганизации);
КонецПроцедуры

&НаСервере
Функция АдресБезИндекса(Адрес)
	СтрокаАдреса = СокрЛП(Адрес);
	Результат = СтрокаАдреса;
	Если СтрДлина(СтрокаАдреса)>6 Тогда
		Если (КодСимвола(СтрокаАдреса, 1) > 47)И(КодСимвола(СтрокаАдреса, 1) < 58) И			
			 (КодСимвола(СтрокаАдреса, 2) > 47)И(КодСимвола(СтрокаАдреса, 2) < 58) И
			 (КодСимвола(СтрокаАдреса, 3) > 47)И(КодСимвола(СтрокаАдреса, 3) < 58) И
			 (КодСимвола(СтрокаАдреса, 4) > 47)И(КодСимвола(СтрокаАдреса, 4) < 58) И
			 (КодСимвола(СтрокаАдреса, 5) > 47)И(КодСимвола(СтрокаАдреса, 5) < 58) И
			 (КодСимвола(СтрокаАдреса, 6) > 47)И(КодСимвола(СтрокаАдреса, 6) < 58) Тогда
			Результат = СокрЛП(Сред(СтрокаАдреса, 8));
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УстановитьТипОтветственныйПринялТовары()
	Если Объект.ОтветственныйПринялТоварыВид = 0 Тогда
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
		Элементы.ОтветственныйПринялТовары.ОграничениеТипа = ОписаниеТипа;
	Иначе	
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица");
		Элементы.ОтветственныйПринялТовары.ОграничениеТипа = ОписаниеТипа;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовОтветственныйЗаТовары(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовОтветственныйЗаТовары(Форма)
	Объект = Форма.Объект;
	
	ВидимостьОтветственныйСотрудник = ?(Объект.ОтветственныйПринялТоварыВид = 0, Истина, Ложь);
	ВидимостьОтветственныйПредставительКонтрагента = ?(Объект.ОтветственныйПринялТоварыВид = 1, Истина, Ложь);
	ВидимостьОтветственныйФизЛицо = ?(Объект.ОтветственныйПринялТоварыВид = 2, Истина, Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаОтветственныйОрганизация", "Видимость", ВидимостьОтветственныйПредставительКонтрагента);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОтветственныйПринялТоварыДоверенность", "Видимость", НЕ ВидимостьОтветственныйСотрудник);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОтветственныйПринялТоварыОснованиеПолномочий", "Видимость", НЕ ВидимостьОтветственныйФизЛицо);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПоУмолчаниюОтветственныйЗаТовары();
	Если НЕ ЗначениеЗаполнено(Объект.ОтветственныйПринялТоварыОснованиеПолномочий) Тогда
		Объект.ОтветственныйПринялТоварыОснованиеПолномочий = НСтр("ru = 'Должностные обязанности'");
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	РеквизитыДоговора = Новый Структура("ИдентификаторГосконтракта, КонтрактСУчастникомГОЗ",  "ГосударственныйКонтрактПоГОЗ.Код");
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, РеквизитыДоговора);
	
