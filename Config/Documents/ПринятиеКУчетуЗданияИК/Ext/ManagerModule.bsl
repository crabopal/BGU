#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"				, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"		, "Принятие к учету здания (сооружения) ИК (ОС-1а)");
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям());
	
	ТаблицыЗапроса = Новый Массив;
	
	ТаблицыЗапроса.Добавить("МестонахождениеОС");
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗданияИК.Организация КАК Организация,
	|	ПринятиеКУчетуЗданияИК.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ПринятиеКУчетуЗданияИК.Подразделение КАК Подразделение,
	|	ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету) КАК Состояние,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ПринятиеКУчетуЗданияИК.Номер КАК НомерДокумента,
	|	ПринятиеКУчетуЗданияИК.Дата КАК ДатаДокумента
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)";
	
	ТаблицыЗапроса.Добавить("СобытияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.Организация,
	|	СобытияОС.ИнвНомер,
	|	СобытияОС.Событие,
	|	СобытияОС.ДатаСобытия,
	|	СобытияОС.НазваниеДокумента,
	|	СобытияОС.НомерДокумента,
	|	СобытияОС.ДатаДокумента,
	|	СобытияОС.Регистратор,
	|	СобытияОС.Период
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|		ПринятиеКУчетуЗданияИК.Организация КАК Организация,
	|		ПринятиеКУчетуЗданияИК.ИнвентарныйНомер КАК ИнвНомер,
	|		ВЫБОР
	|			КОГДА ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|			КОГДА ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ВозвратАренда)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзАренды)
	|			КОГДА ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование)
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования)
	|		КОНЕЦ КАК Событие,
	|		ПринятиеКУчетуЗданияИК.Дата КАК ДатаСобытия,
	|		&ИмяДокумента КАК НазваниеДокумента,
	|		ПринятиеКУчетуЗданияИК.Номер КАК НомерДокумента,
	|		ПринятиеКУчетуЗданияИК.Дата КАК ДатаДокумента,
	|		1 КАК Порядок,
	|		ИСТИНА КАК Включать,
	|		&Ссылка КАК Регистратор,
	|		ПринятиеКУчетуЗданияИК.Дата КАК Период
	|	ИЗ
	|		Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|	ГДЕ
	|		ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПринятиеКУчетуЗданияИК.ОсновноеСредство,
	|		ПринятиеКУчетуЗданияИК.Организация,
	|		ПринятиеКУчетуЗданияИК.ИнвентарныйНомер,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию),
	|		ВЫБОР
	|			КОГДА ПринятиеКУчетуЗданияИК.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ПринятиеКУчетуЗданияИК.Дата
	|			ИНАЧЕ ПринятиеКУчетуЗданияИК.ДатаВводаВЭксплуатацию
	|		КОНЕЦ,
	|		&ИмяДокумента,
	|		ПринятиеКУчетуЗданияИК.Номер,
	|		ПринятиеКУчетуЗданияИК.Дата,
	|		2,
	|		ВЫБОР
	|			КОГДА ПринятиеКУчетуЗданияИК.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ,
	|		&Ссылка,
	|		ПринятиеКУчетуЗданияИК.Дата
	|	ИЗ
	|		Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|	ГДЕ
	|		ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|		И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.Включать
	|
	|УПОРЯДОЧИТЬ ПО
	|	СобытияОС.Порядок";
	
	ТаблицыЗапроса.Добавить("НачислениеАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗданияИК.Организация КАК Организация,
	|	ПринятиеКУчетуЗданияИК.НачислятьАмортизацию,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|	И ПринятиеКУчетуЗданияИК.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	|	И ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)";
	
	ТаблицыЗапроса.Добавить("ПараметрыАмортизацииОСБухгалтерскийУчет");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗданияИК.Организация КАК Организация,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	ПринятиеКУчетуЗданияИК.СпособНачисленияАмортизации,
	|	ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)";
	
	ТаблицыЗапроса.Добавить("АмортизацияОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	ПринятиеКУчетуЗданияИК.СчетУчетаЗатрат,
	|	ПринятиеКУчетуЗданияИК.КЭКЗатрат КАК КЭК,
	|	ПринятиеКУчетуЗданияИК.СубконтоЗатрат1 КАК Субконто1,
	|	ПринятиеКУчетуЗданияИК.СубконтоЗатрат2 КАК Субконто2,
	|	ПринятиеКУчетуЗданияИК.СубконтоЗатрат3 КАК Субконто3,
	|	ПринятиеКУчетуЗданияИК.КПСЗатрат КАК КПС,
	|	ПринятиеКУчетуЗданияИК.ПодразделениеЗатрат КАК Подразделение,
	|	ПринятиеКУчетуЗданияИК.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|	И (ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ИЛИ ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))";
	
	ТаблицыЗапроса.Добавить("РасчетАмортизацииОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	|	&Ссылка КАК Регистратор,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	ПринятиеКУчетуЗданияИК.СрокПолезногоИспользования,
	|	ПринятиеКУчетуЗданияИК.ОставшийсяСрокПолезногоИспользования КАК СрокИспользованияДляВычисленияАмортизации,
	|	ПринятиеКУчетуЗданияИК.ПервоначальнаяСтоимость - ПринятиеКУчетуЗданияИК.СуммаАмортизации КАК СтоимостьДляВычисленияАмортизации,
	|	ПринятиеКУчетуЗданияИК.Организация
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|	И (ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|			ИЛИ ПринятиеКУчетуЗданияИК.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))";
	
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +	
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	ПринятиеКУчетуЗданияИК.Организация,
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство,
	|	ПринятиеКУчетуЗданияИК.ИнвентарныйНомер,
	|	ПринятиеКУчетуЗданияИК.ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА ПринятиеКУчетуЗданияИК.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ПринятиеКУчетуЗданияИК.ПервоначальнаяСтоимость КАК Стоимость,
	|	1 КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету) КАК Событие,
	|	&ИмяДокумента КАК НазваниеДокумента,
	|	ПринятиеКУчетуЗданияИК.Номер КАК НомерДокумента,
	|	ПринятиеКУчетуЗданияИК.Дата КАК ДатаДокумента
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|	И ПринятиеКУчетуЗданияИК.ПервоначальнаяСтоимость <> 0";
	
	ТаблицыЗапроса.Добавить("АмортизацияОбъектовОС");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +	
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ПринятиеКУчетуЗданияИК.Дата КАК Период,
	|	ПринятиеКУчетуЗданияИК.Организация,
	|	ПринятиеКУчетуЗданияИК.ОсновноеСредство,
	|	ПринятиеКУчетуЗданияИК.ИнвентарныйНомер,
	|	ПринятиеКУчетуЗданияИК.Подразделение,
	|	ПринятиеКУчетуЗданияИК.СуммаАмортизации
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	|ГДЕ
	|	ПринятиеКУчетуЗданияИК.Ссылка = &Ссылка
	|	И ПринятиеКУчетуЗданияИК.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.Поступление)
	|	И ПринятиеКУчетуЗданияИК.СуммаАмортизации <> 0";	
	
	ТаблицыЗапроса.Добавить("СтоимостьОбъектовОСПоКонтрагентам");
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	ВЫБОР
	|		КОГДА Документ.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ВозвратАренда)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВАренду)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВПользование)
	|	КОНЕЦ КАК ВидРаспоряжения,
	|	Документ.Дата КАК Период,
	|	Документ.Организация КАК Организация,
	|	Документ.ОсновноеСредство КАК ОсновноеСредство,
	|	Документ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Документ.ЦМО КАК ЦМО,
	|	Документ.Контрагент КАК Контрагент,
	|	Документ.Подразделение КАК Подразделение,
	|	Документ.ПервоначальнаяСтоимость КАК Стоимость,
	|	1 КАК Количество
	|ИЗ
	|	Документ.ПринятиеКУчетуЗданияИК КАК Документ
	|ГДЕ
	|	Документ.Ссылка = &Ссылка
	|	И (Документ.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ВозвратАренда)
	|			ИЛИ Документ.ВидПоступления = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийИК.ВозвратБезвозмездноеПользование))
	|	И Документ.ПервоначальнаяСтоимость <> 0";
	
	Результат = Запрос.ВыполнитьПакет();			   
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, ТаблицыЗапроса);
		
КонецПроцедуры

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПринятиеКУчетуЗданияИК";
	КомандаПечати.Идентификатор		= "ОС1а";
	КомандаПечати.Представление		= НСтр("ru = 'Акт о приеме - передаче здания (ОС-1а)'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	Перем ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОС1а") Тогда
		
		ПодготовитьОС1(МассивОбъектов, ОбъектыПечати, ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1а","ОС-1а", ТабличныйДокумент1);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1а_2","ОС-1а (стр. 2)", ТабличныйДокумент2);
		//УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,"ОС1а_3","ОС-1а (стр. 3)", ТабличныйДокумент3);
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодготовитьОС1(МассивОбъектов, ОбъектыПечати, ТабличныйДокумент1, ТабличныйДокумент2, ТабличныйДокумент3, ТабличныйДокумент4=неопределено)
    ТабличныйДокумент1 = Новый ТабличныйДокумент;
	ТабличныйДокумент2 = Новый ТабличныйДокумент;
	ТабличныйДокумент3 = Новый ТабличныйДокумент;
	ТабличныйДокумент1.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПринятиеКУчетуОС_ОС1";
	ТабличныйДокумент2.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПринятиеКУчетуОС_ОС1";
	ТабличныйДокумент3.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПринятиеКУчетуОС_ОС1";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство
	               |ПОМЕСТИТЬ СписокОС
	               |ИЗ
	               |	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	               |ГДЕ
	               |	ПринятиеКУчетуЗданияИК.Ссылка В(&МассивОбъектов)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПринятиеКУчетуЗданияИК.Ссылка КАК Ссылка,
	               |	ПринятиеКУчетуЗданияИК.Номер КАК НомерАкта,
	               |	ПринятиеКУчетуЗданияИК.Дата КАК пДата,
	               |	ПринятиеКУчетуЗданияИК.Организация КАК Организация,
	               |	ПринятиеКУчетуЗданияИК.Организация.НаименованиеПолное КАК НаимПолучателя,
	               |	ПринятиеКУчетуЗданияИК.Организация.КодОКПО КАК КодОКПОПолучателя,
	               |	ПринятиеКУчетуЗданияИК.Подразделение КАК ПодрПолучателя,
	               |	ПринятиеКУчетуЗданияИК.ОснованиеДляАкта КАК ОснованиеДляАкта,
	               |	ПринятиеКУчетуЗданияИК.НомерОснованияДляАкта КАК НомерОснованияДляАкта,
	               |	ПринятиеКУчетуЗданияИК.ДатаОснованияДляАкта КАК ДатаОснованияДляАкта,
	               |	ПринятиеКУчетуЗданияИК.Дата КАК ДатаАктаВВода,
	               |	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(ВложенныйЗапрос.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))) КАК КПС,
	               |	ПРЕДСТАВЛЕНИЕ(ЕСТЬNULL(ВложенныйЗапрос.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))) КАК КФО,
	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗданияИК.СчетУчета) КАК СчетУчета,
	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗданияИК.СчетУчета.КОСГУДт) КАК КЭК,
	               |	ПринятиеКУчетуЗданияИК.ОсновноеСредство.КодОКОФ.Код КАК пКодПоОКОФ,
	               |	ВЫБОР
	               |		КОГДА ПринятиеКУчетуЗданияИК.ОсновноеСредство.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПустаяСсылка)
	               |			ТОГДА """"
	               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗданияИК.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1)
	               |	КОНЕЦ КАК НомерАмортГруппы,
	               |	ПринятиеКУчетуЗданияИК.ИнвентарныйНомер КАК ИнвНомер,
	               |	ПринятиеКУчетуЗданияИК.ИнвентарныйНомер.ЗаводскойНомер КАК пЗавНомер,
	               |	ВЫБОР
	               |		КОГДА ПринятиеКУчетуЗданияИК.ОсновноеСредство.НаименованиеПолное = """"
	               |			ТОГДА ПринятиеКУчетуЗданияИК.ОсновноеСредство.Наименование
	               |		ИНАЧЕ ПринятиеКУчетуЗданияИК.ОсновноеСредство.НаименованиеПолное
	               |	КОНЕЦ КАК НаимОС,
	               |	ВЫБОР
	               |		КОГДА ПринятиеКУчетуЗданияИК.ОсновноеСредство.ИзготовительОС.НаименованиеПолное = """"
	               |			ТОГДА ПринятиеКУчетуЗданияИК.ОсновноеСредство.ИзготовительОС.Наименование
	               |		ИНАЧЕ ПринятиеКУчетуЗданияИК.ОсновноеСредство.ИзготовительОС.НаименованиеПолное
	               |	КОНЕЦ КАК Изготовитель,
	               |	ПринятиеКУчетуЗданияИК.ПервоначальнаяСтоимость КАК НачСтоимость,
	               |	ПринятиеКУчетуЗданияИК.ОставшийсяСрокПолезногоИспользования КАК СрокПолезнИспПриПост,
	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗданияИК.СпособНачисленияАмортизации) КАК СпособАморт,
	               |	ПринятиеКУчетуЗданияИК.Приложение КАК ТекстПриложения,
	               |	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК МОЛ,
	               |	"""" КАК ТабНомМОЛ,
	               |	ПринятиеКУчетуЗданияИК.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	               |	ПринятиеКУчетуЗданияИК.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	               |	ПринятиеКУчетуЗданияИК.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	               |	ПринятиеКУчетуЗданияИК.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	               |	ПринятиеКУчетуЗданияИК.ОсновноеСредство КАК ОсновноеСредство,
	               |	ПринятиеКУчетуЗданияИК.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	ПринятиеКУчетуЗданияИК.РеквизитыЛицевогоСчета.Владелец КАК ЛицевойСчет,
	               |	СведенияКадастровогоУчета.КоличествоЭтажей КАК КолЭтажей,
	               |	СведенияКадастровогоУчета.ОбщаяПлощадь КАК ОбщаяПлощадь,
	               |	СведенияКадастровогоУчета.ОбщийОбъем КАК ОбщийОбъем,
	               |	СведенияКадастровогоУчета.ПодземныйОбъем КАК ПодземныйОбъем
	               |ИЗ
	               |	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(
	               |				,
	               |				(Организация, ОсновноеСредство) В
	               |					(ВЫБРАТЬ
	               |						ВТ.Организация,
	               |						ВТ.ОсновноеСредство
	               |					ИЗ
	               |						Документ.ПринятиеКУчетуЗданияИК КАК ВТ
	               |					ГДЕ
	               |						ВТ.Ссылка В (&МассивОбъектов))) КАК СведенияКадастровогоУчета
	               |		ПО ПринятиеКУчетуЗданияИК.ОсновноеСредство = СведенияКадастровогоУчета.ОсновноеСредство
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	               |			ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	               |			ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт
	               |		ИЗ
	               |			РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |					,
	               |					,
	               |					Регистратор В (&МассивОбъектов)
	               |						И СчетДт В (&СчетаКазны),
	               |					,
	               |					1) КАК ЖурналПроводокЕПСБУДвиженияССубконто) КАК ВложенныйЗапрос
	               |		ПО ПринятиеКУчетуЗданияИК.Ссылка = ВложенныйЗапрос.Регистратор
	               |ГДЕ
	               |	ПринятиеКУчетуЗданияИК.Ссылка В(&МассивОбъектов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	пДата,
	               |	НомерАкта
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОсновноеСредство,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК Справочник.ОсновныеСредства).НаименованиеПолное + "" / "" + ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК Справочник.ИнвентарныеНомераОС).Код КАК НазвДетали,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Наименование КАК Драгметалл,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Код КАК КодДрагМеталла,
	               |	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК НазвЕИ,
	               |	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток, 0) КАК ВесДраг
	               |ИЗ
	               |	Документ.ПринятиеКУчетуЗданияИК КАК ПринятиеКУчетуЗданияИК
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	               |		ПО ПринятиеКУчетуЗданияИК.ОсновноеСредство = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
	               |			И ПринятиеКУчетуЗданияИК.ИнвентарныйНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер
	               |ИТОГИ ПО
	               |	ОсновноеСредство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.Ссылка КАК Ссылка,
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	               |ИЗ
	               |	Документ.ПринятиеКУчетуЗданияИК.СоставКомиссии КАК ПринятиеКУчетуЗданияИКСоставКомиссии
	               |ГДЕ
	               |	ПринятиеКУчетуЗданияИКСоставКомиссии.Ссылка В(&МассивОбъектов)
	               |ИТОГИ ПО
	               |	Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДополнительныеСведения.Объект КАК ОсновноеСредство,
	               |	ПРЕДСТАВЛЕНИЕ(ДополнительныеСведения.Свойство) КАК ВидХарактеристики,
	               |	ПРЕДСТАВЛЕНИЕ(ДополнительныеСведения.Значение) КАК НазваниеХарактеристики
	               |ИЗ
	               |	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	               |ГДЕ
	               |	ДополнительныеСведения.Объект В
	               |			(ВЫБРАТЬ
	               |				СписокОС.ОсновноеСредство
	               |			ИЗ
	               |				СписокОС КАК СписокОС)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОсновныеСредстваДополнительныеРеквизиты.Ссылка,
	               |	ПРЕДСТАВЛЕНИЕ(ОсновныеСредстваДополнительныеРеквизиты.Свойство),
	               |	ПРЕДСТАВЛЕНИЕ(ОсновныеСредстваДополнительныеРеквизиты.Значение)
	               |ИЗ
	               |	Справочник.ОсновныеСредства.ДополнительныеРеквизиты КАК ОсновныеСредстваДополнительныеРеквизиты
	               |ГДЕ
	               |	ОсновныеСредстваДополнительныеРеквизиты.Ссылка В
	               |			(ВЫБРАТЬ
	               |				СписокОС.ОсновноеСредство
	               |			ИЗ
	               |				СписокОС КАК СписокОС)
	               |ИТОГИ ПО
	               |	ОсновноеСредство";
				   
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("СчетаКазны"		, БухгалтерскийУчет.СписокСчетов("108.50"));
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаШапка 			= Результат[1].Выбрать();
	ВыборкаДрагМеталлы 		= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия 		= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
