// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345007_390";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса необщего пользования (пр. № 390 от 28.09.2022)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345007_368";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса необщего пользования (пр. № 368 от 11.09.2020)'");
	КомандаПечати.Порядок			= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345007_152";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса необщего пользования (пр. № 152 от 18.09.2008)'");
	КомандаПечати.Порядок			= 3;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6спец";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345007";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса необщего пользования (ф. 6 спец)'");
	КомандаПечати.Порядок			= 4;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_390") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_390", "Путевой лист автобуса необщего пользования (пр. № 390 от 28.09.2022)", ПечатьПутевогоЛиста390ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_368") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_368", "Путевой лист автобуса необщего пользования (пр. № 368 от 11.09.2020)", ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_152") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007_152", "Путевой лист автобуса необщего пользования (пр. № 152 от 18.09.2008)", ПечатьПутевогоЛиста152ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345007", "Путевой лист автобуса необщего пользования (ф. 6 спец)", ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист6спец";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист6спец.ПФ_MXL_Форма0345007");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист6спец.Ссылка КАК Ссылка,
	|	ПутевойЛист6спец.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист6спец.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист6спец.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист6спец.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист6спец.СрокДействия,
	|	ПутевойЛист6спец.ТранспортноеСредство,
	|	ПутевойЛист6спец.Водитель,
	|	ПутевойЛист6спец.ЛицензионнаяКарточка,
	|	ПутевойЛист6спец.Комментарий,
	|	ПутевойЛист6спец.ВремяВыездаТС,
	|	ПутевойЛист6спец.ВремяВозвращенияТС,
	|	ПутевойЛист6спец.ВыпускающийТСДиспетчер,
	|	ПутевойЛист6спец.ЛицоДопускающееВодителяПоСостояниюЗдоровья,
	|	ПутевойЛист6спец.ОсобыеОтметки,
	|	ПутевойЛист6спец.ВодительПринялТС,
	|	ПутевойЛист6спец.ВодительСдалТС,
	|	ПутевойЛист6спец.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист6спец.ВыездРазрешилМеханик,
	|	ПутевойЛист6спец.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист6спец.ПринялТСМеханик,
	|	ПутевойЛист6спец.ТаксировщикПутевогоЛиста,
	|	ПутевойЛист6спец.НулевойПробегПриВыезде,
	|	ПутевойЛист6спец.НулевойПробегПриВозвращении,
	|	ПутевойЛист6спец.ВремяВыездаТСФактическое,
	|	ПутевойЛист6спец.ВремяВозвращенияТСФактическое,
	|	ПутевойЛист6спец.ПриВозвращенииТСНеисправно,
	|	ПутевойЛист6спец.РежимРаботы,
	|	ПутевойЛист6спец.ВыдатьГорючего,
	|	ПутевойЛист6спец.НомерЗаправочногоЛиста,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6спец.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомер,
	|	ПутевойЛист6спец.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист6спец.ГаражныйНомер,
	|	ПутевойЛист6спец.Бригада,
	|	ПутевойЛист6спец.Колонна,
	|	ПутевойЛист6спец.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		АдресЗаказчика,
	|		ВремяПрибытия,
	|		ВремяУбытия,
	|		КоличествоЧасов,
	|		КоличествоЕздок
	|	),
	|	ПутевойЛист6спец.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ВыданоГорючее,
	|		ОстатокГорючегоПриВыезде,
	|		ОстатокГорючегоПриВозвращении,
	|		СданоГорючее,
	|		КоэффициентИзмененияНормы
	|	),
	|	ПутевойЛист6спец.ВыданныеТалоныНаГорючее.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДенежныйДокумент
	|	),
	|	ПутевойЛист6спец.Организация.НаименованиеСокращенное
	|ИЗ
	|	Документ.ПутевойЛист6спец КАК ПутевойЛист6спец
	|ГДЕ
	|	ПутевойЛист6спец.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345007";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("АдресТелефонОрганизации", АдресОрганизации+", "+ТелефонОрганизации);
		
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		СтруктураДанных.Вставить("ОтСрокДействияПутевогоЛиста", УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия, Истина));
		
		МаркаТС = УчетГСМ.ПолучитьМаркуТС(СтруктураДанных.ТранспортноеСредство);
		СтруктураДанных.Вставить("МаркаАвтомобиля", МаркаТС);	
		ТипТС = УчетГСМ.ПолучитьТипТС(СтруктураДанных.ТранспортноеСредство);
		СтруктураДанных.Вставить("ТипМаркаАвтомобиля", ?(ЗначениеЗаполнено(ТипТС),ТипТС+", ","")+МаркаТС);	
		
		СтруктураДанных.Вставить("ВремяВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ:мм"""));	       //
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращенияФактическое", Формат(ВыборкаДокументов.ВремяВозвращенияТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		//выдать горючего прописью
		КоличествоЛитровГСМ = "";
		ДробнаяЧасть = ВыборкаДокументов.ВыдатьГорючего - Цел(ВыборкаДокументов.ВыдатьГорючего);
		Если (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть = 0) Тогда
			ПараметрыПрописи = ",,,,,,,,0";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		ИначеЕсли (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть > 0) Тогда
			ПараметрыПрописи = "целая, целых, целых, ж, сотая, сотых, сотых, м, 2";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		КонецЕсли;	
		СтруктураДанных.Вставить("ВыдатьГорючегоПрописью", КоличествоЛитровГСМ);	
		
		//Талоны на топливо
		ВыданыТалоныНаТопливо = Ложь;
		ТалоныНаТопливо = "";
		ВыборкаТалоны = ВыборкаДокументов.ВыданныеТалоныНаГорючее.Выбрать();
		
		Пока ВыборкаТалоны.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаТалоны.ДенежныйДокумент) Тогда
				ТалоныНаТопливо = ТалоныНаТопливо + СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Серия)+" "+СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Номер)+"; ";
				
