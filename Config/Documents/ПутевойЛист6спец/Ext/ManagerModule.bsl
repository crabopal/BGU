	|	) КАК ПростоиНаЛинии,
	|	ПутевойЛист6спец.РезультатыРаботыТС.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		КоличествоВремениРаботыТСВсего КАК КоличествоВремениРаботыТСВсего,
	|		КоличествоВремениРаботыТСВПростоеПоТехНеисправностям КАК КоличествоВремениРаботыТСВПростоеПоТехНеисправностям,
	|		ПробегТСВсего КАК ПробегТСВсего,
	|		ПробегТССПассажирами КАК ПробегТССПассажирами
	|	) КАК РезультатыРаботыТС
	|ИЗ
	|	Документ.ПутевойЛист6спец КАК ПутевойЛист6спец
	|ГДЕ
	|	ПутевойЛист6спец.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345007";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("АдресТелефонОрганизации", АдресОрганизации+", "+ТелефонОрганизации);
		
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		СтруктураДанных.Вставить("ОтСрокДействияПутевогоЛиста", УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия, Истина));
		
		МаркаТС = УчетГСМ.ПолучитьМаркуИМодельТС(СтруктураДанных.ТранспортноеСредство);
		СтруктураДанных.Вставить("МаркаАвтомобиля", МаркаТС);
		
		СтруктураДанных.Вставить("СведенияОПеревозке", СтруктураДанных.СведенияОПеревозке);
		
		ТипТС = УчетГСМ.ПолучитьТипТС(СтруктураДанных.ТранспортноеСредство);
		СтруктураДанных.Вставить("ТипМаркаАвтомобиля", ?(ЗначениеЗаполнено(ТипТС),ТипТС+", ","")+МаркаТС);	
		
		СтруктураДанных.Вставить("ВремяВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	       //
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращенияФактическое", Формат(ВыборкаДокументов.ВремяВозвращенияТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		//выдать горючего прописью
		КоличествоЛитровГСМ = "";
		ДробнаяЧасть = ВыборкаДокументов.ВыдатьГорючего - Цел(ВыборкаДокументов.ВыдатьГорючего);
		Если (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть = 0) Тогда
			ПараметрыПрописи = ",,,,,,,,0";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		ИначеЕсли (ВыборкаДокументов.ВыдатьГорючего<>0) И (ДробнаяЧасть > 0) Тогда
			ПараметрыПрописи = "целая, целых, целых, ж, сотая, сотых, сотых, м, 2";
			КоличествоЛитровГСМ = ЧислоПрописью(ВыборкаДокументов.ВыдатьГорючего,,ПараметрыПрописи);
		КонецЕсли;	
		СтруктураДанных.Вставить("ВыдатьГорючегоПрописью", КоличествоЛитровГСМ);	
		
		//Талоны на топливо
		ВыданыТалоныНаТопливо = Ложь;
		ТалоныНаТопливо = "";
		ВыборкаТалоны = ВыборкаДокументов.ВыданныеТалоныНаГорючее.Выбрать();
		
		Пока ВыборкаТалоны.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаТалоны.ДенежныйДокумент) Тогда
				ТалоныНаТопливо = ТалоныНаТопливо + СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Серия)+" "+СокрЛП(ВыборкаТалоны.ДенежныйДокумент.Номер)+"; ";
				
				ВыданыТалоныНаТопливо = Истина;
			КонецЕсли;
		КонецЦикла;
		СтруктураДанных.Вставить("ТалоныНаТопливо", ТалоныНаТопливо);
		
		//Движение горючего
		ВыборкаГорючее = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаГорючее.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Горючего", ВыборкаГорючее.МаркаГорючего);
			СтруктураДанных.Вставить("КодМарки"+НомерСтроки+"Горючего", ВыборкаГорючее.КодМаркиГорючего);
			СтруктураДанных.Вставить("Выдано"+НомерСтроки+"Горючего", ВыборкаГорючее.ВыданоГорючее);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВыезде", ВыборкаГорючее.ОстатокГорючегоПриВыезде);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВозвращении", ВыборкаГорючее.ОстатокГорючегоПриВозвращении);
			СтруктураДанных.Вставить("Сдано"+НомерСтроки+"Горючего", ВыборкаГорючее.СданоГорючее);
			СтруктураДанных.Вставить("Коэффициент"+НомерСтроки+"Горючего", ВыборкаГорючее.КоэффициентИзмененияНормы);
		КонецЦикла;
		
		ЗаказчикиФизЛица = Новый Массив;
		
		//Задание водителю
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 5 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Заказчик"+НомерСтроки+"НаименованиеАдрес", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика)+", "+СокрЛП(ВыборкаЗадания.АдресЗаказчика));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Прибытие", Формат(ВыборкаЗадания.ВремяПрибытия,"ДФ=""ЧЧ:мм"""));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Убытие", Формат(ВыборкаЗадания.ВремяУбытия,"ДФ=""ЧЧ:мм"""));
			СтруктураДанных.Вставить("Время"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЧасов);
			СтруктураДанных.Вставить("Ездки"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЕздок);
			
			Заказчик = ВыборкаЗадания.Заказчик;
			Если Заказчик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
				Если ЗаказчикиФизЛица.Найти(Заказчик) = Неопределено Тогда
					ЗаказчикиФизЛица.Добавить(Заказчик);	
				КонецЕсли;
			КонецЕсли;	
		КонецЦикла;
	
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВыпускающийТСДиспетчер, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ДиспетчерВыпустилИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.ЛицоДопускающееВодителяПоСостояниюЗдоровья, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ДолжностьМедРаботника", ДанныеСотрудника.Должность);
		СтруктураДанных.Вставить("МедРаботник", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВыездРазрешилМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикВыпустилТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ПринялТСМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительПринялТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительСдалТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительСдалТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ТаксировщикПутевогоЛиста, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ТаксировщикИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		
		СтруктураДанных.Вставить("СтандартнаяКарточка", 	"стандартная, ");
		СтруктураДанных.Вставить("ОграниченнаяКарточка", 	"ограниченная");
		
		//вывод областей табличного документа
		ДанныеВодителя = УчетГСМ.ПолучитьДанныеВодителя(СтруктураДанных.Водитель, СтруктураДанных.ДатаПутевогоЛиста);
		
		ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Водитель, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
		СтруктураДанных.Водитель = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
			
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(СтруктураДанных);
		Область.Параметры.Заполнить(ДанныеВодителя);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		ЗачеркнутыйШрифт = Новый Шрифт("Arial",9,,,,Истина);
		Если ЗначениеЗаполнено(СтруктураДанных.ЛицензионнаяКарточка) Тогда
			Если СтруктураДанных.ЛицензионнаяКарточка.ОграниченнаяКарточка Тогда
				ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			Иначе
				ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			КонецЕсли;
		Иначе
			ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
		КонецЕсли;	
		
		Область = Макет.ПолучитьОбласть("ЗаданиеРаботаВодителя");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		
		Если ЗначениеЗаполнено(СокрЛП(СтруктураДанных.ОсобыеОтметки)) Тогда
			Область = Макет.ПолучитьОбласть("ДвижениеГорючегоОтметкиЗаполнены");
		Иначе
			Область = Макет.ПолучитьОбласть("ДвижениеГорючегоОтметки");
		КонецЕсли;
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Если ВыданыТалоныНаТопливо Тогда
			Область = Макет.ПолучитьОбласть("ТалоныНаГСМЗаполнены");
		Иначе
			Область = Макет.ПолучитьОбласть("ТалоныНаГСМ");
		КонецЕсли;
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
	
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		
		Область = Макет.ПолучитьОбласть("ЗаголовокОборотнойСтороны");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("МаршрутДвижения");
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", 
			СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
			
		Если СтруктураДанных.ДокументПолучен Тогда	
			//Маршрут движения
			ВыборкаМаршрутДвижения = ВыборкаДокументов.МаршрутДвижения.Выбрать();
			
			НомерСтроки = 0;
			Пока ВыборкаМаршрутДвижения.Следующий() Цикл
				НомерСтроки = НомерСтроки + 1;
				Если НомерСтроки > 5 Тогда
					Прервать;
				КонецЕсли;
				
				СтруктураДанных.Вставить("МаршрутДвиженияНомерЕздки"+Строка(НомерСтроки), Строка(НомерСтроки));
				СтруктураДанных.Вставить("МаршрутДвиженияОткуда"+Строка(НомерСтроки), ВыборкаМаршрутДвижения.МестоОтправления);
				СтруктураДанных.Вставить("МаршрутДвиженияКуда"+Строка(НомерСтроки), ВыборкаМаршрутДвижения.МестоНазначения);
				
				СтруктураДанных.Вставить("МаршрутДвиженияПробегСПассажирами"+Строка(НомерСтроки), ВыборкаМаршрутДвижения.ПробегСПассажирами);
				СтруктураДанных.Вставить("МаршрутДвиженияПробегБезПассажиров"+Строка(НомерСтроки), ВыборкаМаршрутДвижения.ПробегБезПассажиров);
			КонецЦикла;
			
			//Если Заказчик-сотрудник
			Если ЗаказчикиФизЛица.Количество() = 1 Тогда
				ДанныеЗаказчикаСотрудника = УчетГСМ.ДанныеКонтрагентаСотрудника(ЗаказчикиФизЛица[0], СтруктураДанных.ДатаПутевогоЛиста);
				Если ЗначениеЗаполнено(ДанныеЗаказчикаСотрудника.Должность) Тогда
					СтруктураДанных.Вставить("МаршрутДвиженияДолжностьЗаказчика", Строка(ДанныеЗаказчикаСотрудника.Должность));
				КонецЕсли;	
				СтруктураДанных.Вставить("МаршрутДвиженияЗаказчикТСИнициалыФамилия", ДанныеЗаказчикаСотрудника.ФамилияИО);
			КонецЕсли;
			
		КонецЕсли;
		
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("Простои");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("РезультатРаботыТС");
		
		Если СтруктураДанных.ДокументПолучен Тогда
			РезультатПробегВсего = 0;
			РезультатПробегСПассажирами = 0;
			РезультатРасходГорючегоФактически = 0;
			РезультатВремяВНарядеВсего = 0;
			РезультатВремяВНарядеПростои = 0;
			
			ВыборкаРезультатыРаботыТС = ВыборкаДокументов.РезультатыРаботыТС.Выбрать();
			
			Если ВыборкаРезультатыРаботыТС.Следующий() Тогда
				РезультатПробегВсего = ВыборкаРезультатыРаботыТС.ПробегТСВсего;	
				РезультатПробегСПассажирами = ВыборкаРезультатыРаботыТС.ПробегТССПассажирами;	
				РезультатВремяВНарядеВсего = ВыборкаРезультатыРаботыТС.КоличествоВремениРаботыТСВсего;	
				РезультатВремяВНарядеПростои = ВыборкаРезультатыРаботыТС.КоличествоВремениРаботыТСВПростоеПоТехНеисправностям;	
			КонецЕсли;
			
			ВыборкаДвижениеГорючего = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
			Пока ВыборкаДвижениеГорючего.Следующий() Цикл
				РезультатРасходГорючегоФактически = РезультатРасходГорючегоФактически +
					ВыборкаДвижениеГорючего.ОстатокГорючегоПриВыезде + ВыборкаДвижениеГорючего.ВыданоГорючее -
					ВыборкаДвижениеГорючего.ОстатокГорючегоПриВозвращении;	
			КонецЦикла;
			
			СтруктураДанных.Вставить("РезультатПробегВсего", РезультатПробегВсего);
			СтруктураДанных.Вставить("РезультатПробегСПассажирами", РезультатПробегСПассажирами);
			СтруктураДанных.Вставить("РезультатРасходГорючегоФактически", РезультатРасходГорючегоФактически);
			СтруктураДанных.Вставить("РезультатВремяВНарядеВсего", УчетВремениКлиентСервер.ЧислоВСтроку(РезультатВремяВНарядеВсего));
			СтруктураДанных.Вставить("РезультатВремяВНарядеПростои", УчетВремениКлиентСервер.ЧислоВСтроку(РезультатВремяВНарядеПростои));
			
		КонецЕсли;
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("РезультатТаксировки");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

