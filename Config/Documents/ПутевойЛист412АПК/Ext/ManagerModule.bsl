	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма412АПК";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		НаименованиеПутевогоЛиста = "ПУТЕВОЙ ЛИСТ ТРАКТОРА "+?(СтруктураДанных.СерияПутевогоЛиста = "","", СокрЛП(СтруктураДанных.СерияПутевогоЛиста)+" ")+"№ ";
		СтруктураДанных.Вставить("НаименованиеПутевогоЛиста", НаименованиеПутевогоЛиста);	
		
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("СокращенноеНаименованиеОрганизации", СтруктураДанных.СокращенноеНаименованиеОрганизации);
		СтруктураДанных.Вставить("ОГРН", СтруктураДанных.ОГРН);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
	
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		
		СтруктураДанных.Вставить("МаркаТрактора", 	УчетГСМ.ПолучитьМаркуИМодельТС(СтруктураДанных.ТранспортноеСредство));	
		СтруктураДанных.Вставить("ИнвентарныйНомер", 	УчетГСМ.ИнвентарныйНомерОбъекта(СтруктураДанных.ТранспортноеСредство));
		СтруктураДанных.Вставить("СведенияОПеревозке", СтруктураДанных.СведенияОПеревозке);
		
		СтруктураДанных.Вставить("ЧислоВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВыезда", Формат(ВыборкаДокументов.ВремяВыездаТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВыездаФактическое", Формат(ВыборкаДокументов.ВремяВыездаТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		СтруктураДанных.Вставить("ЧислоВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""дд"""));	
		СтруктураДанных.Вставить("МесяцВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ММ"""));	
		СтруктураДанных.Вставить("ЧасВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""ЧЧ"""));	
		СтруктураДанных.Вставить("МинутыВозвращения", Формат(ВыборкаДокументов.ВремяВозвращенияТС,"ДФ=""мм"""));	
		
		СтруктураДанных.Вставить("ВремяВозвращенияФактическое", Формат(ВыборкаДокументов.ВремяВозвращенияТСФактическое,"ДФ=""дд.ММ.гггг ЧЧ:мм"""));	
		
		Если ЗначениеЗаполнено(СтруктураДанных.Тракторист) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.Тракторист, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураДанных.Вставить("ТрактористФИО", ДанныеСотрудника.Фамилия + " "+ДанныеСотрудника.Имя+" "+ДанныеСотрудника.Отчество);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.Прицепщик) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.Прицепщик, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураДанных.Вставить("ПрицепщикФИО", ДанныеСотрудника.Фамилия + " "+ДанныеСотрудника.Имя+" "+ДанныеСотрудника.Отчество);
		КонецЕсли;

		Если ЗначениеЗаполнено(СтруктураДанных.Бригадир) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.Бригадир, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураДанных.Вставить("БригадирФИО", ДанныеСотрудника.Фамилия + " "+ДанныеСотрудника.Имя+" "+ДанныеСотрудника.Отчество);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ВыездРазрешилМеханик) Тогда
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", СтруктураДанных.ВыездРазрешилМеханик, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			СтруктураДанных.Вставить("МеханикВыпустилТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь));
		КонецЕсли;
		                   
		//Прицепы
		ВыборкаПрицепы = ВыборкаДокументов.Прицепы.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаПрицепы.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 1 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьМаркуИМодельТС(ВыборкаПрицепы.Прицеп));
			СтруктураДанных.Вставить("ГосНомер"+НомерСтроки+"Прицепа", УчетГСМ.ПолучитьГосударственныйНомернойЗнакТС(ВыборкаПрицепы.Прицеп));
			СтруктураДанных.Вставить("ИнвентарныйНомер"+НомерСтроки+"Прицепа", УчетГСМ.ИнвентарныйНомерОбъекта(ВыборкаПрицепы.Прицеп));
		КонецЦикла;
		
		//Движение горючего
		ВыборкаГорючее = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаГорючее.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 1 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Марка"+НомерСтроки+"Горючего", ВыборкаГорючее.МаркаГорючего);
			СтруктураДанных.Вставить("КодМарки"+НомерСтроки+"Горючего", ВыборкаГорючее.КодМаркиГорючего);
			СтруктураДанных.Вставить("ЕдИзм"+НомерСтроки+"Горючего", ?(ЗначениеЗаполнено(ВыборкаГорючее.ЕдиницаИзмерения), ВыборкаГорючее.ЕдиницаИзмерения, "кг"));
			СтруктураДанных.Вставить("Выдано"+НомерСтроки+"Горючего", ВыборкаГорючее.ВыданоГорючее);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВыезде", ВыборкаГорючее.ОстатокГорючегоПриВыезде);
			СтруктураДанных.Вставить("Остаток"+НомерСтроки+"ГорючегоПриВозвращении", ВыборкаГорючее.ОстатокГорючегоПриВозвращении);
		КонецЦикла;
		
		//вывод областей табличного документа
		Область = Макет.ПолучитьОбласть("Заголовок");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ЗаданиеТрактористуОсновное");
		
		ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		
		НомерСтроки = 0;
		Пока ВыборкаЗадания.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			
			Если НомерСтроки < 5 Тогда
				СтруктураДанных.Вставить("Заказчик"+НомерСтроки+"Наименование", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика));
				СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Откуда", ВыборкаЗадания.АдресПунктаПогрузки);
				СтруктураДанных.Вставить("Пункт"+НомерСтроки+"Куда", ВыборкаЗадания.АдресПунктаРазгрузки);
				СтруктураДанных.Вставить("Расстояние"+НомерСтроки+"Км", ВыборкаЗадания.Расстояние);
				СтруктураДанных.Вставить("Груз"+НомерСтроки+"Наименование", ВыборкаЗадания.НаименованиеГруза);
				СтруктураДанных.Вставить("Класс"+НомерСтроки+"Груз", СокрЛП(ВыборкаЗадания.КлассГруза));
				СтруктураДанных.Вставить("Ездки"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоЕздок);
				СтруктураДанных.Вставить("Мест"+НомерСтроки+"Количество", ВыборкаЗадания.КоличествоМест);
				СтруктураДанных.Вставить("Вес"+НомерСтроки+"Тонн", ВыборкаЗадания.ПеревезтиТонн);
			Иначе
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		Если НомерСтроки > 4 Тогда
			ВыборкаЗадания = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
			
			Пока ВыборкаЗадания.Следующий() Цикл
				НомерСтроки = НомерСтроки + 1;
				Если НомерСтроки > 15 Тогда
					Прервать;
				КонецЕсли;
				
				Если НомерСтроки > 4 Тогда
					Область = Макет.ПолучитьОбласть("ЗаданиеТрактористуСтрока");
					СтруктураДанныхСтроки = Новый Структура;
					СтруктураДанныхСтроки.Вставить("ЗаказчикНаименование", СокрЛП(ВыборкаЗадания.НаименованиеЗаказчика));
					СтруктураДанныхСтроки.Вставить("ПунктОткуда", ВыборкаЗадания.АдресПунктаПогрузки);
					СтруктураДанныхСтроки.Вставить("ПунктКуда", ВыборкаЗадания.АдресПунктаРазгрузки);
					СтруктураДанныхСтроки.Вставить("РасстояниеКм", ВыборкаЗадания.Расстояние);
					СтруктураДанныхСтроки.Вставить("ГрузНаименование", ВыборкаЗадания.НаименованиеГруза);
					СтруктураДанныхСтроки.Вставить("КлассГруз", СокрЛП(ВыборкаЗадания.КлассГруза));
					СтруктураДанныхСтроки.Вставить("ЕздкиКоличество", ВыборкаЗадания.КоличествоЕздок);
					СтруктураДанныхСтроки.Вставить("МестКоличество", ВыборкаЗадания.КоличествоМест);
					СтруктураДанныхСтроки.Вставить("ВесТонн", ВыборкаЗадания.ПеревезтиТонн);
					
					Область.Параметры.Заполнить(СтруктураДанныхСтроки);
					ТабличныйДокумент.Вывести(Область);
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		
		Для н = 1 По 15 - НомерСтроки Цикл
			Область = Макет.ПолучитьОбласть("ЗаданиеТрактористуСтрока");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
		
		
		Область = Макет.ПолучитьОбласть("Отметки");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		
		Область = Макет.ПолучитьОбласть("Подвал");
		Область.Параметры.Заполнить(СтруктураДанных);
		
		ТабличныйДокумент.Вывести(Область);
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		
		Область = Макет.ПолучитьОбласть("ЗаголовокОборотнойСтороны");
		ТабличныйДокумент.Вывести(Область);
		
		Область = Макет.ПолучитьОбласть("ШапкаВыполненияЗадания");
		ТабличныйДокумент.Вывести(Область);
		
		Для н = 1 По 21 Цикл
			Область = Макет.ПолучитьОбласть("СтрокаВыполненияЗадания");
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;
		
		Область = Макет.ПолучитьОбласть("ПодвалВыполненияЗадания");
		ТабличныйДокумент.Вывести(Область);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист412АПК";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист412АПК.ПФ_MXL_Форма412АПК");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист412АПК.Ссылка КАК Ссылка,
	|	ПутевойЛист412АПК.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист412АПК.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист412АПК.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист412АПК.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист412АПК.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист412АПК.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист412АПК.СрокДействия,
	|	ПутевойЛист412АПК.ТранспортноеСредство,
	|	ПутевойЛист412АПК.Водитель КАК Тракторист,
	|	ВЫРАЗИТЬ(ПутевойЛист412АПК.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
