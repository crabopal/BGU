			Если ЗначениеЗаполнено(ЗначениеПредрейсовыхРеквизитов.Должность) Тогда 
				СтруктураДанных.Вставить("ДолжностьПредрейсовогоМедработника", ТРег(ЗначениеПредрейсовыхРеквизитов.Должность) + ПредрейсовыйРазделитель);
			КонецЕсли;
			
		Иначе 
			
			ДанныеПредрейсовогоСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
															СтруктураДанных.ПроведшийПредрейсовыйМедосмотр, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПредрейсовогоСотрудника, Истина);
			СтруктураДанных.Вставить("ФИОПредрейсовогоМедработника", КорреспондентыКлиентСервер.ФИО(ДанныеПредрейсовогоСотрудника, Истина));
			
			Если ЗначениеЗаполнено(ДанныеПредрейсовогоСотрудника.Должность) Тогда
				СтруктураДанных.Вставить("ДолжностьПредрейсовогоМедработника", ТРег(ДанныеПредрейсовогоСотрудника.Должность) + ПредрейсовыйРазделитель);  
			КонецЕсли;
			
		КонецЕсли;  
		
		Если ЗначениеЗаполнено(СтруктураДанных.СокращенноеНаименованиеОрганизации) Тогда				
			НаименованиеОрганизацииДокумента = СтруктураДанных.СокращенноеНаименованиеОрганизации;			
