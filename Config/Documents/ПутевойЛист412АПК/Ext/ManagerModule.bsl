			РезультатПредрейсовогоМедосмотра = НСтр("ru = 'прошел предрейсовый медицинский осмотр, к исполнению трудовых обязанностей допущен'");
		КонецЕсли;
		СтруктураДанных.Вставить("РезультатПредрейсовогоМедосмотра", РезультатПредрейсовогоМедосмотра);
		 
		ПредрейсовыйРазделитель = ?(ЗначениеЗаполнено(СтруктураДанных.ПроведшийПредрейсовыйМедосмотр),",", "");
