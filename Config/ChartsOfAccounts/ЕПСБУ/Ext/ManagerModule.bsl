
// Описание параметров, используемых для отбора списков и данных выбора:
//
//	ОграниченияСчета	- ПланСчетовСсылка - ссылка счета,
//						- Строка - код счета (счетов через запятую);
//						Используется с видом сравнения "В иерархии"
//	КодТекущейСтроки	- ПланСчетовСсылка - ссылка счета,
//						- Строка - код счета;
//						Используется для позиционирования в форме списка
//	ОграниченияСписокСчетов	- СписокЗначений - список ссылок или кодов счетов,
//							- Массив - массив ссылок или кодов счетов,
//							- ФиксированныйМассив - массив ссылок или кодов счетов;
//							Тип значений в коллекции (ссылка или строка) определяется по первому элементу.
//	ВидСравненияВСписке	- Булево - Используется только с параметром "ОграниченияСписокСчетов". Если Истина,
//								то устанавливается вид сравнения "ВСписке" иначе "ВСпискеПоИерархии"
//
// Механизм корректных корреспонденций:
//
//	КорреспонденцияДт		- ПланСчетовСсылка - ссылка на счет;
//	КорреспонденцияДтКод	- Строка - код счета. Если задан "КорреспонденцияДт", то не проверяется.
//						Устанавливает отбор по корректным корреспонденциям, где СчетДт = КорреспонденцияДт
//
//	КорреспонденцияКт		- ПланСчетовСсылка - ссылка на счет;
//	КорреспонденцияКтКод	- Строка - код счета. Если задан "КорреспонденцияКт", то не проверяется.
//						Устанавливает отбор по корректным корреспонденциям, где СчетКт = КорреспонденцияКт
//
//	ОграничениеПоСубконто	- Массив - массив видов субконто,
//							- СписокЗначений - список видов субконто,
//							- ПланВидовХарактеристикСсылка.ВидыСубконто - вид субконто;
//							Устанавливает отбор по счетам, для которых задан требуемый вид субконто.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПроверитьИсправитьПризнакЭлементГруппа");
КонецПроцедуры

#КонецОбласти

// Возвращает описание блокируемых реквизитов.
//
// Возвращаемое значение:
// Массив - содержит строки в формате ИмяРеквизита[;ИмяЭлементаФормы,...]
// где ИмяРеквизита - имя реквизита объекта, ИмяЭлементаФормы - имя элемента формы,
// связанного с реквизитом.
//
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("Код");
	Результат.Добавить("Наименование");
	Результат.Добавить("Родитель");
	Результат.Добавить("ТипСчета");
	Результат.Добавить("Вид");
	Результат.Добавить("Забалансовый");
	Результат.Добавить("ДатаНачалаДействия;ДатаНачалаДействия");
	Результат.Добавить("ДатаОкончанияДействия;ДатаОкончанияДействия");
	Результат.Добавить("ЗапретитьИспользоватьВПроводках");
	Результат.Добавить("НомерЖурнала");
	Результат.Добавить("КОСГУДт");
	Результат.Добавить("КОСГУКт");
	Результат.Добавить("ДляКазенных");
	Результат.Добавить("ДляБюджетных");
	Результат.Добавить("ДляАвтономных");
	Результат.Добавить("Валютный; Валютный");
	Результат.Добавить("Количественный");
	Результат.Добавить("НалоговыйУчетНеУчитываемых");
	Результат.Добавить("НалоговыйУчетЕНВД");
	Результат.Добавить("НалоговыйУчетНДС");
	Результат.Добавить("УчетПоКПС");
	Результат.Добавить("УчетПоКЭК");
	Результат.Добавить("УчетПоПодразделениям");
	Результат.Добавить("РазрешитьНеУказыватьПодразделение; РазрешитьНеУказыватьПодразделение");
	Результат.Добавить("ВидыСубконто");
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив счетов с оборотным КЭК
// 
// Параметры:
//  ДопСписокНеучитываемых - Строка - Доп список неучитываемых
// 
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.ЕПСБУ - Счета с оборотным КЭК
Функция СчетаСОборотнымКЭК(ДопСписокНеучитываемых = "") Экспорт
	
	СписокНеучитываемых = КодыСчетовСНеоборотнымиКЭК() + "
	|" + ДопСписокНеучитываемых;
	
	НеУчитываемыеСчета = БухгалтерскийУчет.СписокСчетов(СписокНеучитываемых);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.УчетПоКЭК
	|	И ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|	И НЕ ЕПСБУ.Ссылка В (&ИсключитьСчета)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|	И НЕ ЕПСБУ.Забалансовый";
	
	Запрос.УстановитьПараметр("ИсключитьСчета", НеУчитываемыеСчета);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции  

Функция СчетаСНеоборотнымиКЭК() Экспорт
	
	Возврат БухгалтерскийУчет.СписокСчетов(КодыСчетовСНеоборотнымиКЭК());
	
КонецФункции  

Функция КодыСчетовСНеоборотнымиКЭК() Экспорт
	
	СписокКодов =
	"109.00, 110.00,
	|210.02, 210.04,
	|304.04,304.05,304.06,304.84,304.94,304.86,304.96,
	|401.00,402.10,
	|501.00,502.00,503.00,504.00,506.00,507.00,508.00";  
	
	Возврат СписокКодов;
	
КонецФункции


Процедура СоздатьНовыеСчета(Данные = Неопределено) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		ТаблицаСчетов = Данные;
	Иначе
		Таблица = ПолучитьДанныеСчетов(Данные, "БезСвойств");
		ТаблицаСчетов = Таблица.Скопировать(, "Код,ДатаНачалаДействия");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетов", ТаблицаСчетов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСчетов.Код КАК Код,
	|	ТаблицаСчетов.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ КодыИДатыНачала
	|ИЗ
	|	&ТаблицаСчетов КАК ТаблицаСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК Ссылка,
	|	КодыИДатыНачала.Код КАК Код,
	|	КодыИДатыНачала.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ИЗ
	|	КодыИДатыНачала КАК КодыИДатыНачала
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО (ЕПСБУ.Код = КодыИДатыНачала.Код)
	|			И (ЕПСБУ.ДатаНачалаДействия = КодыИДатыНачала.ДатаНачалаДействия)
	|ГДЕ
	|	ЕПСБУ.Ссылка ЕСТЬ NULL";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	СписокСчетов = Результат.Выгрузить();
	
	Попытка
		
		НачатьТранзакцию();
		
		Для Каждого СтрокаСчета Из СписокСчетов Цикл
			
			СчетОбъект = ПланыСчетов.ЕПСБУ.СоздатьСчет();
			СчетОбъект.Код = СтрокаСчета.Код;
			СчетОбъект.ДатаНачалаДействия = СтрокаСчета.ДатаНачалаДействия;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СчетОбъект, Истина);
			
			СтрокаСчета.Ссылка = СчетОбъект.Ссылка;
			
		КонецЦикла;
		
		ВосстановитьСвойстваСчетов(СписокСчетов,, Новый Структура("Порядок"));
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьПредопределенныеСчета() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код,
	|	ЕПСБУ.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Предопределенный";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	СписокСчетов = Запрос.Выполнить().Выгрузить();
	
	ВосстановитьСвойстваСчетов(СписокСчетов,, Новый Структура("Порядок"));
	
КонецПроцедуры

// Восстановить свойства счетов
//
// Параметры:
//  СписокСчетов 			- ТаблицаЗначений, Строка, Массив - см. параметр СписокСчетов функции ТаблицаСчетов()
//  Свойства				- Строка, Массив - восстанавливаемые свойства. Строка свойств через запятую или массив свойств.
//  УстанавливаемыеЗначения	- Структура - ключ и значение это имя свойства и значение, которое свойству необходимо установить.
//
// Примеры:
//
// ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов("502.12,502.22,502.32,502.42,502.92", "ВидыКЭК");
//
// СписокСчетов = "301.11,301.12,301.13,301.14,301.21,301.23,301.24,301.31,301.33,301.42,301.43,301.44";
// ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(СписокСчетов, "ВидыКПС");
//
// СписокСчетов = "108.57:2018.01.01";
// ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(СписокСчетов, "Субконто");
//
// СписокСчетов = БухгалтерскийУчет.СписокСчетов("114.00");
// ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(СписокСчетов, "Вид,Субконто");
//
Процедура ВосстановитьСвойстваСчетов(СписокСчетов, Свойства = Неопределено, УстанавливаемыеЗначения = Неопределено) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	ТаблицаСчетов = ТаблицаСчетов(СписокСчетов);
	
	Если Свойства = Неопределено Тогда
		СписокСвойств = Новый Массив;
		Таблица = ПустаяТаблицаДанныхСчетов();
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Если Колонка.Имя <> "Код" И Колонка.Имя <> "ДатаНачалаДействия" Тогда
				СписокСвойств.Добавить(Колонка.Имя);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Свойства) = Тип("Строка") Тогда
		СписокСвойств = СтрРазделить(Свойства, ",", Ложь);
	Иначе
		СписокСвойств = Свойства;
	КонецЕсли;
	
	Если СписокСвойств.Количество() = 0 Тогда
		ДанныеСчетов = ПустаяТаблицаДанныхСчетов();
	Иначе
		ДанныеСчетов = ПолучитьДанныеСчетов(ТаблицаСчетов, СписокСвойств);
	КонецЕсли;
	
	Если ДанныеСчетов.Количество() = 0 И УстанавливаемыеЗначения = Неопределено Тогда
		Возврат; // Значения по умолчанию отсутствуют (либо их не получали т.к. нет восстанавливаемых свойств) и нет устанавливаемых значений
	КонецЕсли;
	
	Для Каждого СтрокаСчета Из ТаблицаСчетов Цикл
		
		СчетОбъект = СтрокаСчета.Ссылка.ПолучитьОбъект();
		ЕстьИзменения = Ложь;
		
		Попытка
			
			НачатьТранзакцию();
			
			СтрокиТаблицы = ДанныеСчетов.НайтиСтроки(Новый Структура("Код,ДатаНачалаДействия", СтрокаСчета.Код, СтрокаСчета.ДатаНачалаДействия));
			
			Если СтрокиТаблицы.Количество() > 0 Тогда
				
				ЗначенияПоУмолчанию = СтрокиТаблицы[0];
				
				Для Каждого Свойство Из СписокСвойств Цикл
					
					Если Свойство = "Родитель" Тогда
						
						Если ЗначениеЗаполнено(ЗначенияПоУмолчанию.Родитель) Тогда
							СчетРодитель = СчетПоКоду(ЗначенияПоУмолчанию.Родитель, ЗначенияПоУмолчанию.ДатаНачалаДействия, Истина);
							Если СчетРодитель.Пустая() Тогда
								Комментарий = НСтр("ru = 'Не найден счет %1. Родитель для счета %2 не установлен.'");
								Комментарий = СтрШаблон(Комментарий, ЗначенияПоУмолчанию.Родитель, СчетОбъект.Код);
								ЗаписьЖурналаРегистрации(НСтр("ru = 'Восстановление свойств счетов'"),
									УровеньЖурналаРегистрации.Предупреждение, Метаданные.ПланыСчетов.ЕПСБУ, СтрокаСчета.Ссылка, Комментарий);
							КонецЕсли;
						Иначе
							СчетРодитель = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
						КонецЕсли;
						
						Если СчетОбъект.Родитель <> СчетРодитель Тогда
							СчетОбъект.Родитель = СчетРодитель;
						КонецЕсли;
						
					ИначеЕсли Свойство = "Субконто" Тогда
						
						// Можно только добавить новые субконто, при условии что состав и порядок субконто на счете по умолчанию
						ДанныеАнализа = АнализТаблицСубконто(СчетОбъект.ВидыСубконто, ЗначенияПоУмолчанию.Субконто);
						Если ДанныеАнализа.Различаются Тогда
							Если ДанныеАнализа.ПоУмолчанию Тогда
								СчетОбъект.ВидыСубконто.Загрузить(ЗначенияПоУмолчанию.Субконто);
							Иначе
								Комментарий = НСтр("ru = 'Состав субконто счета %1 не восстановлен, т.к. отличается от типового.'");
								Комментарий = СтрЗаменить(Комментарий, "%1", СчетОбъект.Код);
								ЗаписьЖурналаРегистрации(НСтр("ru = 'Восстановление свойств счетов'"),
									УровеньЖурналаРегистрации.Предупреждение, Метаданные.ПланыСчетов.ЕПСБУ, СтрокаСчета.Ссылка, Комментарий);
							КонецЕсли;
						КонецЕсли;
						
					ИначеЕсли Свойство = "ВидыКПС" Тогда
						
						ЗаписатьКПССчета(СтрокаСчета.Ссылка, ЗначенияПоУмолчанию.ВидыКПС);
						ЕстьИзменения = Истина;
						
					ИначеЕсли Свойство = "ВидыКЭК" Тогда
						
						ЗаписатьКЭКСчета(СтрокаСчета.Ссылка, ЗначенияПоУмолчанию.ВидыКЭК);
						ЕстьИзменения = Истина;
						
					Иначе
						
						Если СчетОбъект[Свойство] <> ЗначенияПоУмолчанию[Свойство] Тогда
							СчетОбъект[Свойство] = ЗначенияПоУмолчанию[Свойство];
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			Если УстанавливаемыеЗначения <> Неопределено Тогда
				Для Каждого КлючСвойства Из УстанавливаемыеЗначения Цикл
					Если КлючСвойства.Ключ = "Порядок" Тогда
						СчетОбъект.АктуализироватьПорядок();
					ИначеЕсли СчетОбъект[КлючСвойства.Ключ] <> КлючСвойства.Значение Тогда
						СчетОбъект[КлючСвойства.Ключ] = КлючСвойства.Значение;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если СчетОбъект.Модифицированность() Тогда
				СчетОбъект.ДополнительныеСвойства.Вставить("ОтключитьБизнесЛогику");
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СчетОбъект, Истина, Истина);
				ЕстьИзменения = Истина;
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура - Установить окончание действия счетов
//
// Параметры:
//  СписокСчетов	 - см. параметр "СписокСчетов" функции "ТаблицаСчетов"
//  ДатаОкончания	 - 	 - дата, на которую будут закрыты переданные счета
//
Процедура УстановитьОкончаниеДействияСчетов(СписокСчетов, ДатаОкончания) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	ТаблицаСчетов = ТаблицаСчетов(СписокСчетов);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов" , ТаблицаСчетов.ВыгрузитьКолонку("Ссылка"));
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СписокСчетов)
	|	И ЕПСБУ.ДатаОкончанияДействия <> &ДатаОкончания";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СчетОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СчетОбъект.ДатаОкончанияДействия = ДатаОкончания;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СчетОбъект, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Формирует порядок, который будет удовлетворять иерархии плана счетов
//
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ или ПланСчетовОбъект.ЕПСБУ (для вызова при записи) - 
//   счет, чей порядок надо сформировать
//
// Возвращаемое значение - Строка
//
Функция ПолучитьПорядокСчета(Счет) Экспорт
	
	Результат = Новый Массив;
	
	ЧастьКода = Лев(СтрЗаменить(Счет.Код, ".", "") + "+++++", 5);
	Результат.Добавить(ЧастьКода);
	
	СчетРодитель = Счет.Родитель;
	КонтрольЗацикленности = Новый Соответствие;
	ИерархияЗациклилась = Ложь;
	
	Пока ЗначениеЗаполнено(СчетРодитель) Цикл
		
		ДанныеСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетРодитель, "Код,Родитель");
		Если КонтрольЗацикленности.Получить(ДанныеСчета.Родитель) <> Неопределено Тогда
			ИерархияЗациклилась = Истина;
			Прервать;
		КонецЕсли;
		КонтрольЗацикленности.Вставить(ДанныеСчета.Родитель, Истина);
		ЧастьКода = Лев(СтрЗаменить(ДанныеСчета.Код, ".", "") + "+++++", 5);
		Результат.Вставить(0, ЧастьКода);
		
		СчетРодитель = ДанныеСчета.Родитель;
		
	КонецЦикла;
	
	Если ИерархияЗациклилась Тогда
		// Не можем определить порядок из-за зацикленности иерархии счетов
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные.Изменение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Счет.Метаданные(),
			Счет.Ссылка,
			СтрШаблон(НСтр("ru = 'Обнаружено зацикливание иерархии счета ""%1""'"), Счет.Код));
		Возврат Счет.Порядок;
	КонецЕсли;
	
	НачальныйСимвол = "+";
	
	Если Счет.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский Тогда
		Если Счет.Забалансовый Тогда
			НачальныйСимвол = "А";
		КонецЕсли;
	ИначеЕсли Счет.ТипСчета = Перечисления.ТипыСчетов.Налоговый Тогда
		НачальныйСимвол = "Н";
	ИначеЕсли Счет.ТипСчета = Перечисления.ТипыСчетов.Управленческий Тогда
		НачальныйСимвол = "У";
	ИначеЕсли Счет.ТипСчета = Перечисления.ТипыСчетов.Вспомогательный Тогда
		НачальныйСимвол = "я";
	КонецЕсли;
	
	Результат.Вставить(0, НачальныйСимвол);
	
	НовыйКод = Лев(СтрСоединить(Результат, "") + "++++++++++++++++++++++", 22);
	
	Возврат НовыйКод;
	
КонецФункции

//  Функция определяет список субсчетов заданного счета
//  СчетРодитель - код счета или ссылка плана счетов
//
Функция ПолучитьАналитическиеСубсчета(Знач СчетРодитель) Экспорт
	Запрос = Новый Запрос;
	Если ТипЗнч(СчетРодитель) = Тип("Строка") Тогда
		СчетРодитель = БухгалтерскийУчет.СчетПоКоду(СчетРодитель, Неопределено);
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетРодитель", СчетРодитель);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетРодитель)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Результат = Запрос.Выполнить();
	Возврат Результат;
КонецФункции

// Процедура выполняет замену вида субконто на счете из переданного соответствия, 
// где ключ соответствия - текущий вид субконто, а значение соответствия новый вид субконто
Процедура ЗаменаВидаСубконтоНаСчете(СчетЗамены,СоответствиеЗамены) Экспорт//ВидСубконтоТекущий,ВидСубконтоНовый) Экспорт
	
	Если ТипЗнч(СоответствиеЗамены) <>Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.ВидСубконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка = &Счет
	|	И ЕПСБУВидыСубконто.ВидСубконто В (&ВидыСубконто)";
	
	МассивВС = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеЗамены Цикл
		МассивВС.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ВидыСубконто", МассивВС);
	Запрос.УстановитьПараметр("Счет", СчетЗамены);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	СоответствиеСубконто = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		СоответствиеСубконто.Вставить(Выборка.ВидСубконто,СоответствиеЗамены[Выборка.ВидСубконто]);
	КонецЦикла;
	Если СоответствиеСубконто.Количество()=0 Тогда
		//На счете нет таких субконто, заменять нечего
		Возврат;
	КонецЕсли;
	
	НовыйБуферныйСчет = СчетЗамены.Скопировать();
	НовыйБуферныйСчет.ОбменДанными.Загрузка = Истина;
	НовыйБуферныйСчет.Код = "ХХХ.ХХХ";
	НовыйБуферныйСчет.Наименование = "Буферный счет";
	НовыйБуферныйСчет.Родитель = Неопределено;
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйБуферныйСчет);
	
	НовыйБуферныйСчетСсылка = НовыйБуферныйСчет.Ссылка;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ Различные
	|	ЖурналПроводокЕПСБУ.Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.СчетДт = &СчетЗамены
	|	ИЛИ ЖурналПроводокЕПСБУ.СчетКт = &СчетЗамены";
	
	Запрос.УстановитьПараметр("СчетЗамены", СчетЗамены);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	//Переносим записи на буферный счет
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого СтрНабора Из НаборЗаписей Цикл
			Если СтрНабора.СчетДт = СчетЗамены Тогда
				СтрНабора.СчетДт = НовыйБуферныйСчетСсылка;
			КонецЕсли;
			Если СтрНабора.СчетКт = СчетЗамены Тогда
				СтрНабора.СчетКт = НовыйБуферныйСчетСсылка;
			КонецЕсли;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
	КонецЦикла;
	
	СчетОбъект = СчетЗамены.ПолучитьОбъект();
	
	Для Каждого СтрВидСуб Из СчетОбъект.ВидыСубконто Цикл
		Если СоответствиеСубконто[СтрВидСуб.ВидСубконто]<>Неопределено Тогда
			СтрВидСуб.ВидСубконто = СоответствиеСубконто[СтрВидСуб.ВидСубконто];
		КонецЕсли;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(СчетОбъект);
	ВыборкаДетальныеЗаписи.Сбросить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого СтрНабора Из НаборЗаписей Цикл
			Если СтрНабора.СчетДт = НовыйБуферныйСчетСсылка Тогда
				СтрНабора.СчетДт = СчетЗамены;
				Для Каждого КлючИЗначение Из СоответствиеСубконто Цикл
					ТекЗначение = СтрНабора.СубконтоДт[КлючИЗначение.Ключ];
					СтрНабора.СубконтоДт.Вставить(КлючИЗначение.Значение,ТекЗначение);
					СтрНабора.СубконтоДт.Удалить(КлючИЗначение.Ключ);
				КонецЦикла;
			КонецЕсли;
			Если СтрНабора.СчетКт = НовыйБуферныйСчетСсылка Тогда
				СтрНабора.СчетКт = СчетЗамены;
				Для Каждого КлючИЗначение Из СоответствиеСубконто Цикл
					ТекЗначение = СтрНабора.СубконтоКт[КлючИЗначение.Ключ];
					СтрНабора.СубконтоКт.Вставить(КлючИЗначение.Значение,ТекЗначение);
					СтрНабора.СубконтоКт.Удалить(КлючИЗначение.Ключ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	НовыйБуферныйСчет.ОбменДанными.Загрузка = Истина;
	НовыйБуферныйСчет.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	НовыйБуферныйСчет.Удалить();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

// Обработчик получения данных выбора типа данных ПланСчетов.ЕПСБУ.
// Вызов принудительно переводится на сервер, чтобы в ТолстомКлиентеУправляемоеПриложение алгоритм работал так же, как
// и в тонком клиенте.
//
// При вызове с клиента в режимах ТонкийКлиент или ВебКлиент необходимо установить параметр ПреобразоватьТаблицуВМассив = Истина.
//
// Параметры:
//  Параметры	 - Структура - Параметры, переданные обработчик ОбработкаПолученияДанныхВыбора.
//  ПреобразоватьТаблицуВМассив - Булево - Преобразовать результат в массив структур. Используется при вызове с клиента.
// 
// Возвращаемое значение:
// ТаблицаЗначений - счета и необходимые реквизиты.
//
Функция ОбработкаПолученияДанныхВыбораСчетаЕПСБУ(Параметры, ПреобразоватьТаблицуВМассив = Ложь) Экспорт
	Перем СтрокаПоиска;
	Перем ОграниченияСчета;
	Перем ОграниченияСчетаПоКЭК;
	Перем ОграниченияСписокСчетов;
	Перем ПредустановленныйОтбор;
	Перем КорреспонденцияДт;
	Перем КорреспонденцияКт;
	Перем ОграничениеПоСубконто;
	Перем ВыборГруппИЭлементов;
	Перем НаДату;
	Перем Организация;
	Перем ИФО;
	
	Если Параметры.Свойство("СтрокаПоиска", СтрокаПоиска) Тогда
		СтрокаПоиска = СтрЗаменить(СтрокаПоиска, ",", ".");
	КонецЕсли;
	
	СтрокаПоискаДоп = "";
	Если СтрНайти(СтрокаПоиска, ".") = 0 Тогда
		Если СтрДлина(СтрокаПоиска) > 2 Тогда
			СтрокаПоискаДоп = Лев(СтрокаПоиска, 2)+"."+Сред(СтрокаПоиска, 3);
		КонецЕсли;
		Если СтрДлина(СтрокаПоиска) > 3 Тогда
			СтрокаПоиска = Лев(СтрокаПоиска, 3)+"."+Сред(СтрокаПоиска, 4);
		КонецЕсли;
	КонецЕсли;
	
	Параметры.Свойство("НаДату", НаДату);
	Если НЕ Параметры.Свойство("КорреспонденцияДт", КорреспонденцияДт) Тогда
		Если Параметры.Свойство("КорреспонденцияДтКод") Тогда
			КорреспонденцияДт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияДтКод"], НаДату);
		КонецЕсли;
	КонецЕсли;
	Если Не Параметры.Свойство("КорреспонденцияКт", КорреспонденцияКт) Тогда
		Если Параметры.Свойство("КорреспонденцияКтКод") Тогда
			КорреспонденцияКт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияКтКод"], НаДату);
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "НеОграничиватьКоличествоСчетов", Ложь) Тогда
		ТекстПервые = "";
	Иначе
		ТекстПервые = "Первые 51";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ " + ТекстПервые + "
	               |	ОсновнаяТаблица.Ссылка,
	               |	ОсновнаяТаблица.ПометкаУдаления,
	               |	ОсновнаяТаблица.Код,
	               |	ОсновнаяТаблица.ДатаОкончанияДействия,";
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	ВЫБОР
	               |		КОГДА ОсновнаяТаблица.Код = &ЗначениеПоиска
	               |			ИЛИ ОсновнаяТаблица.Код ПОДОБНО &ЗначениеПоиска + "".%""
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК ТочноеСоответствие,";
		Запрос.УстановитьПараметр("ЗначениеПоиска", СтрокаПоиска);
	Иначе
		Запрос.Текст = Запрос.Текст + "
	               |	1 КАК ТочноеСоответствие,";
	КонецЕсли;
	Если Параметры.Свойство("ВернутьСтруктуруСКОСГУДтКт") Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	ОсновнаяТаблица.КОСГУДт,
	               |	ОсновнаяТаблица.КОСГУКт,";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	               |	ОсновнаяТаблица.Наименование
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ОсновнаяТаблица";
	ПервоеУсловие = Истина;
	Если ЗначениеЗаполнено(КорреспонденцияДт) Тогда
		Запрос.Текст = Запрос.Текст + "
					|ГДЕ
					|	(ИСТИНА В
					|		(ВЫБРАТЬ ПЕРВЫЕ 1
					|			ИСТИНА КАК Поле1
					|		ИЗ
					|			РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
					|		ГДЕ
					|			КорректныеКорреспонденцииСчетов.СчетКт = ОсновнаяТаблица.Ссылка
					|			И КорректныеКорреспонденцииСчетов.СчетДт = &КорреспонденцияДт)
					|			
					|	// кор. счет, если в корректных проводках указан родитель счета Дт
					|	ИЛИ ИСТИНА В
					|		(ВЫБРАТЬ ПЕРВЫЕ 1
					|			ИСТИНА КАК Поле1
					|		ИЗ
					|			РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
					|				ПО
					|					КорректныеКорреспонденцииСчетов.СчетДт = ЕПСБУ.Родитель
					|		ГДЕ
					|			КорректныеКорреспонденцииСчетов.СчетКт = ОсновнаяТаблица.Ссылка
					|			И ЕПСБУ.Ссылка = &КорреспонденцияДт)
					|			
					|	// потомок кор. счета, если в корректных проводках указан переданный счет
					|	ИЛИ ИСТИНА В
