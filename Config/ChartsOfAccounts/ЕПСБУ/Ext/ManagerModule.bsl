		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|	ОсновнаяТаблица.ДатаОкончанияДействия < &НаДату И ОсновнаяТаблица.ДатаОкончанияДействия <> ДАТАВРЕМЯ(1, 1, 1)";
		Запрос.УстановитьПараметр("НаДату", НаДату);
		
	КонецЕсли;
	
	Если Параметры.Свойство("Организация", Организация) И ЗначениеЗаполнено(Организация) Тогда
		
		// Отбор по типу учреждения (типу плана счетов).
		ТекущийИФО = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
			И Параметры.Свойство("ИФО", ИФО) И ЗначениеЗаполнено(ИФО), ИФО,
			Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
		ТипПланаСчетов = БухгалтерскийУчетПовтИсп.ТекущийТипПланаСчетов(Организация, ТекущийИФО, НаДату);
		Если ЗначениеЗаполнено(ТипПланаСчетов) Тогда
			
			Если ПервоеУсловие Тогда
				Запрос.Текст = Запрос.Текст + "
				|ГДЕ
				|	";
				ПервоеУсловие = Ложь;
			Иначе
				Запрос.Текст = Запрос.Текст + "
				|	И ";
			КонецЕсли;
			
			Если ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных") Тогда
				Запрос.Текст = Запрос.Текст + "ОсновнаяТаблица.ДляАвтономных";
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") Тогда
				Запрос.Текст = Запрос.Текст + "ОсновнаяТаблица.ДляБюджетных";
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
				Запрос.Текст = Запрос.Текст + "ОсновнаяТаблица.ДляКазенных";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "	
	               |УПОРЯДОЧИТЬ ПО
				   |	ТочноеСоответствие,
	               |	ОсновнаяТаблица.Порядок,
				   |	ОсновнаяТаблица.ДатаНачалаДействия УБЫВ";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ПреобразоватьТаблицуВМассив Тогда
		Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат);
	Иначе
		Возврат Результат;
	КонецЕсли;

КонецФункции

Функция ГруппыУчетаПоПодразделениям() Экспорт
	
	СчетаОС				= БухгалтерскийУчет.СписокСчетов("101.00,102.00,104.10,104.20,104.30,104.40,104.60,104.90,111.60,114.10,114.20,114.30,21");
	СчетаНПА			= БухгалтерскийУчет.СписокСчетов("103.00,114.60,114.70");
	СчетаППА			= БухгалтерскийУчет.СписокСчетов("111.40,114.40");
	СчетаАмортизацииППА	= БухгалтерскийУчет.СписокСчетов("104.40", '29990101');
	СчетаОбесцененияНМА	= БухгалтерскийУчет.СписокСчетов("114.60", '29990101');
	
	СчетаГруппыОС = Новый Массив;
	Для Каждого Счет Из СчетаОС Цикл
		Если СчетаАмортизацииППА.Найти(Счет) = Неопределено Тогда // Исключаем счета амортизации права пользования 104.40
			СчетаГруппыОС.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	// Добавляем счета обесценения права пользования НМА 114.60
	Для Каждого Счет Из СчетаОбесцененияНМА Цикл
		СчетаГруппыОС.Добавить(Счет);
	КонецЦикла;
	
	СчетаГруппыНПА = Новый Массив;
	Для Каждого Счет Из СчетаНПА Цикл
		Если СчетаОбесцененияНМА.Найти(Счет) = Неопределено Тогда // Исключаем счета обесценения права пользования 114.60
			СчетаГруппыНПА.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	
	СчетаГруппыППА = Новый Массив;
	// Добавляем счета прав пользования 111.40 и 114.40
	Для Каждого Счет Из СчетаППА Цикл
		СчетаГруппыППА.Добавить(Счет);
	КонецЦикла;
	// Добавляем счета амортизации права пользования ОС 104.40
	Для Каждого Счет Из СчетаАмортизацииППА Цикл
		СчетаГруппыППА.Добавить(Счет);
	КонецЦикла;
	
	Группы = Новый ТаблицаЗначений;
	Группы.Колонки.Добавить("Имя");
	Группы.Колонки.Добавить("Наименование");
	Группы.Колонки.Добавить("Счета");
	Группы.Колонки.Добавить("ГруппаВнутри");
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "ОС";
	НоваяГруппа.Наименование	= "Основные средства, нематериальные активы, амортизация (101, 102, 104.10, 104.20, 104.30, 104.60, 104.90, 111.60, 114.10, 114.20, 114.30, 114.60, 21)";
	НоваяГруппа.Счета			= СчетаГруппыОС;
	НоваяГруппа.ГруппаВнутри	= Ложь;
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "НПА";
	НоваяГруппа.Наименование	= "Непроизведенные активы (103, 114.70)";
	НоваяГруппа.Счета			= СчетаГруппыНПА;
	НоваяГруппа.ГруппаВнутри	= Ложь;
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "ТоварыВРозницеОЦИ";
	НоваяГруппа.Наименование	= "(В рознице) Товары и наценка - особо ценное движимое имущество учреждения. (105.Б8, 105.29)";
	НоваяГруппа.Счета			= БухгалтерскийУчет.СписокСчетов("105.Б8,105.29");
	НоваяГруппа.ГруппаВнутри	= Истина;
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "ТоварыВРозницеИное";
	НоваяГруппа.Наименование	= "(В рознице) Товары и наценка - иное движимое имущество учреждения. (105.Г8, 105.39)";
	НоваяГруппа.Счета			= БухгалтерскийУчет.СписокСчетов("105.Г8,105.39");
	НоваяГруппа.ГруппаВнутри	= Истина;
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "ИК";
	НоваяГруппа.Наименование	= "Имущество казны, амортизация (108, 104.50)";
	НоваяГруппа.Счета			= БухгалтерскийУчет.СписокСчетов("108.00,104.50");
	НоваяГруппа.ГруппаВнутри	= Ложь;
	
	НоваяГруппа					= Группы.Добавить();
	НоваяГруппа.Имя				= "ППА";
	НоваяГруппа.Наименование	= "Права пользования активами (111.40, 104.40, 114.40)";
	НоваяГруппа.Счета			= СчетаГруппыППА;
	НоваяГруппа.ГруппаВнутри	= Ложь;
	
	Возврат Группы;
	
КонецФункции

Функция ГруппаУчетаПоПодразделениям(Счет) Экспорт
	
	Группы = ГруппыУчетаПоПодразделениям();
	
	Для Каждого Группа Из Группы Цикл
		Если Группа.Счета.Найти(Счет) <> Неопределено Тогда
			Возврат Группа.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция УчетПоПодразделениямГруппы(ИмяГруппы) Экспорт
	
	Группы = ГруппыУчетаПоПодразделениям();
	
	Группа = Группы.Найти(ИмяГруппы, "Имя");
	Если Группа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет", Группа.Счета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.УчетПоПодразделениям;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьОбщийУчетПоПодразделениямНаСчетахГрупп() Экспорт
	
	ГруппыУчета = ГруппыУчетаПоПодразделениям();
	
	Для Каждого ГруппаУчета Из ГруппыУчета Цикл
		
		УчетВГруппе = УчетПоПодразделениямГруппы(ГруппаУчета.Имя);
		
		Для Каждого Счет Из ГруппаУчета.Счета Цикл
			Если Счет.УчетПоПодразделениям <> УчетВГруппе Тогда
				СчетОбъект = Счет.ПолучитьОбъект();
				СчетОбъект.УчетПоПодразделениям = УчетВГруппе;
				СчетОбъект.ОбменДанными.Загрузка = Истина;
				СчетОбъект.Записать();
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КодыСчетовРасчетовКИСЕ() Экспорт
	
	Возврат "205.00,206.00,207.00,208.00,209.00,210.03,210.05,210.06,210.10,302.00,303.00,304.01,304.02,304.03,304.06,304.86,304.96";
	
КонецФункции

// Процедура проверяет, что для счетов-групп значение реквизита ЭлементГруппа = Истина,
// а для детальных счетов значение реквизита ЭлементГруппа = Ложь,
// и если находит не верные значения реквизита ЭлементГруппа, то исправляет.  
//
Процедура ПроверитьИсправитьПризнакЭлементГруппа(ПараметрОбработчика = Неопределено) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕПСБУ.Родитель КАК Родитель
		|ПОМЕСТИТЬ ТабРодители
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабРодители.Родитель КАК Родитель,
		|	ТабРодители.Родитель.Код КАК Код
		|ИЗ
		|	ТабРодители КАК ТабРодители
		|ГДЕ
		|	ТабРодители.Родитель.ЭлементГруппа = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Код КАК Код
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.ЭлементГруппа = ИСТИНА
		|	И НЕ ЕПСБУ.Ссылка В
		|				(ВЫБРАТЬ
		|					ТабРодители.Родитель
		|				ИЗ
		|					ТабРодители)";
	
		
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Если РезультатыЗапроса[1].Пустой() И РезультатыЗапроса[2].Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
	Если ТипЗнч(ПараметрОбработчика) = Тип("Структура") И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		// установим признак необходимости монопольного режима
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;

	
	//Исправление признака ЭлементГруппа для групп счетов 
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекОбъект = ВыборкаДетальныеЗаписи.Родитель.ПолучитьОбъект();
		ТекОбъект.ЭлементГруппа = Истина;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Истина,Ложь);
		Исключение
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для счета ""%1"" установлено некорректное значение реквизита ""Элемент группа"" = Ложь.
					|Не удалось установить корректное значение и записать счет ""%1"".'"),
						ВыборкаДетальныеЗаписи.Код);
			ЗаписьЖурналаРегистрации(Сообщение, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ПланыСчетов.ЕПСБУ, ТекОбъект,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
			
	//Исправление признака ЭлементГруппа для детальных счетов	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[2].Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ТекОбъект.ЭлементГруппа = Ложь;
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Истина,Ложь);
		Исключение
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для счета ""%1"" установлено некорректное значение реквизита ""Элемент группа"" = Истина.
					|Не удалось установить корректное значение и записать счет ""%1"".'"),
						ВыборкаДетальныеЗаписи.Код);
			ЗаписьЖурналаРегистрации(Сообщение, УровеньЖурналаРегистрации.Ошибка,
				Метаданные.ПланыСчетов.ЕПСБУ, ТекОбъект,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Проверяет учет по подразделениям по массиву счетов
//
// Параметры:
//  Счета - Массив Из ПланыСчетовСсылка.ЕПСБУ - массив ссылок на счета, по которым приозводим проверку
//
// Возвращаемое значение:
//  Булево - если, хотя бы один счет в переданном массиве имеет учет по подразделениям, то возвращается ИСТИНА,
//           иначе - ЛОЖЬ
Функция УчетПоПодразделениямНаСчетах(Счета) Экспорт
	Результат = Ложь;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ (&Счета)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Счета", Счета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.УчетПоПодразделениям;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// Формирует коды счетов, у которых есть субконто "ВидСубконто" и которые удовлетворяют маске счета
// МаскаСчета и не удовлетворяют маске счета МаскаСчетаИсключение
//
// Параметры:
//  ВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
//  МаскаСчета - Строка - для конструкции ПОДОБНО
//  МаскаСчетаИсключение - Строка - для конструкции ПОДОБНО
//  ТипВозвращаемогоЗначения - Строка - Моежт принимать значения: "Строка" или "Массив"
//
// Возвращаемое значение:
//  - Строка - если ТипВозвращаемогоЗначения = "Строка"
//  ИЛИ Массив - если ТипВозвращаемогоЗначения = "Массив"
Функция КодыСчетовПоМаскеИСубконто(ВидСубконто, МаскаСчета = "", МаскаСчетаИсключение = "", ТипВозвращаемогоЗначения = "Строка") Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУВидыСубконто.Ссылка.Код КАК Код
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто = &ВидСубконто
	|	И &МаскаСчета_
	|	И &МаскаСчетаИсключение_";

	Если ЗначениеЗаполнено(МаскаСчета) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МаскаСчета_", 
		"ЕПСБУВидыСубконто.Ссылка.Код ПОДОБНО """ + МаскаСчета + """");
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МаскаСчета_", "ИСТИНА");
	КонецЕсли;	
	Если ЗначениеЗаполнено(МаскаСчетаИсключение) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МаскаСчетаИсключение_", 
		"НЕ ЕПСБУВидыСубконто.Ссылка.Код ПОДОБНО """ + МаскаСчетаИсключение + """");
	Иначе	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&МаскаСчетаИсключение_", "ИСТИНА");
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконто[ВидСубконто]);
	
	Если ТипВозвращаемогоЗначения = "Массив" Тогда
		Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");
	Иначе	
		Выборка = Запрос.Выполнить().Выбрать();
		
		Результат = "";
		Пока Выборка.Следующий() Цикл
			Результат = Результат + ?(ЗначениеЗаполнено(Результат), ",", "") + Выборка.Код;
		КонецЦикла;
	КонецЕсли;		
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Нестандартные параметры, используемые процедурой, указаны в начале модуля менеджера Плана счетов. ЕПСБУ
//
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВыбранныеСчета = ОбработкаПолученияДанныхВыбораСчетаЕПСБУ(Параметры);
	
	ДанныеВыбора = Новый СписокЗначений;
	ВернутьСтруктуруСКОСГУДтКт = Параметры.Свойство("ВернутьСтруктуруСКОСГУДтКт");
	
	Для каждого СтрокаСчета Из ВыбранныеСчета Цикл
	
		Если ВернутьСтруктуруСКОСГУДтКт Тогда
			СчетСсылка = Новый Структура("Счет, КОСГУДт, КОСГУКт, ПометкаУдаления");
			СчетСсылка.Счет            = СтрокаСчета.Ссылка;
		Иначе
			СчетСсылка = Новый Структура("Значение, ПометкаУдаления");
			СчетСсылка.Значение        = СтрокаСчета.Ссылка;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СчетСсылка, СтрокаСчета);
		
		ДанныеВыбора.Добавить(СчетСсылка, СтрШаблон(НСтр("ru = '%1 (%2)'"),
			ОбщегоНазначенияБГУВызовСервера.ПредставлениеСчетаЕПСБУ(СтрокаСчета.Код, СтрокаСчета.ДатаОкончанияДействия),
			СтрокаСчета.Наименование));
		
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция СчетПоКоду(Код, ДатаНачалаДействия, ЭтоРодитель = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачалаДействия);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = &Код
	|	И ЕПСБУ.ДатаНачалаДействия = &ДатаНачалаДействия
	|	И НЕ ЕПСБУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.ДатаНачалаДействия УБЫВ";
	
	Если ЭтоРодитель Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "= &Дата", "<= &Дата");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	Иначе
		Результат = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Таблица счетов
//
// Параметры:
//  СписокСчетов 	- ТаблицаЗначений - должна содержать колонки "Код", "ДатаНачалаДействия",
//										будет возвращена таблица (только строки с сущесвующими счетами), дополненная колонкой "Ссылка",
//										если содержит колонку "Ссылка", то функция возращает эту таблицу;
//  				- Строка - коды счетов через запятую;
//  				- Массив - коды счетов или ссылки на счета;
//	Коды счетов в формате <Код>:<Дата начала действия> (например "101.11:0001.01.01", или "101.11:01.01.0001").
//	Если дата пустая, то можно ее не указывать.
// 
// Возвращаемое значение:
//   - ТаблицаЗначений - таблица с колонками "Ссылка", "Код", "ДатаНачалаДействия".
//
Функция ТаблицаСчетов(СписокСчетов) Экспорт
	
	Если ТипЗнч(СписокСчетов) = Тип("ТаблицаЗначений") Тогда
		Если СписокСчетов.Колонки.Найти("Ссылка") <> Неопределено Тогда
			Возврат СписокСчетов;
		КонецЕсли;
		ТаблицаКлючей = СписокСчетов;
	Иначе
		Если ТипЗнч(СписокСчетов) = Тип("Строка") Тогда
			Счета = СтрРазделить(СписокСчетов, ",", Ложь);
		ИначеЕсли ТипЗнч(СписокСчетов) = Тип("Массив") Тогда
			Счета = СписокСчетов;
		Иначе
			ВызватьИсключение "Неверный тип параметра функции ТаблицаСчетов()";
		КонецЕсли;
		Если Счета.Количество() > 0 И ТипЗнч(Счета[0]) = Тип("Строка") Тогда
			ТаблицаКлючей = Новый ТаблицаЗначений;
			ТаблицаКлючей.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(6)));
			ТаблицаКлючей.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
			Для Каждого Счет Из Счета Цикл
				Ключ = ПолучитьКлючСчета(Счет, Истина);
				НоваяСтрока = ТаблицаКлючей.Добавить();
				НоваяСтрока.Код = Ключ.Код;
				НоваяСтрока.ДатаНачалаДействия = Ключ.Дата;
			КонецЦикла;
		Иначе
			ТаблицаКлючей = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ТаблицаКлючей = Неопределено Тогда // Передан массив счетов
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Счета);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Код КАК Код,
		|	ЕПСБУ.ДатаНачалаДействия КАК ДатаНачалаДействия
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&Ссылка)";
		ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Таблица", ТаблицаКлючей);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Таблица.Код КАК Код,
		|	Таблица.ДатаНачалаДействия КАК ДатаНачалаДействия
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка,
		|	ЕПСБУ.Код КАК Код,
		|	ЕПСБУ.ДатаНачалаДействия КАК ДатаНачалаДействия
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ КАК ВТ
		|		ПО ЕПСБУ.Код = ВТ.Код
		|			И ЕПСБУ.ДатаНачалаДействия = ВТ.ДатаНачалаДействия";
		ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	Возврат ТаблицаСчетов;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьНеВалютныеСчета() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Валютный = ЛОЖЬ";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Функция УстановкаПризнакаУчетПоКЭК() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка,
		|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Предопределенный = ЛОЖЬ
		|	И ЕПСБУ.УчетПоКПС <> ЕПСБУ.УчетПоКЭК";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СчетОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Код = СчетОбъект.Код;
		СчетОбъект.УчетПоКЭК = ВыборкаДетальныеЗаписи.УчетПоКПС;
		Попытка 
			СчетОбъект.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать счет %1'"),Код));
		КонецПопытки;
	КонецЦикла;
	
КонецФункции

Функция ПустаяТаблицаДанныхСчетов() Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	ТипСтрока	= Новый ОписаниеТипов("Строка");
	ТипБулево	= Новый ОписаниеТипов("Булево");
	ТипДата		= Новый ОписаниеТипов("Дата");
	ТипКЭК		= Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
	ТипМассив	= Новый ОписаниеТипов("Массив");
	ТипТЗ		= Новый ОписаниеТипов("ТаблицаЗначений");
	
	Таблица.Колонки.Добавить("Код"								, Новый ОписаниеТипов("Строка",,,, Новый КвалификаторыСтроки(6)));
	Таблица.Колонки.Добавить("Родитель"							, ТипСтрока);	
	Таблица.Колонки.Добавить("НомерЖурнала"						, Новый ОписаниеТипов("СправочникСсылка.Журналы"));
	Таблица.Колонки.Добавить("Вид"								, Новый ОписаниеТипов("ВидСчета"));
	Таблица.Колонки.Добавить("Забалансовый"						, ТипБулево);
	Таблица.Колонки.Добавить("Количественный"					, ТипБулево);
	Таблица.Колонки.Добавить("Валютный"							, ТипБулево);
	Таблица.Колонки.Добавить("ДляАвтономных"					, ТипБулево);
	Таблица.Колонки.Добавить("ДляБюджетных"						, ТипБулево);
	Таблица.Колонки.Добавить("ДляКазенных"						, ТипБулево);
	Таблица.Колонки.Добавить("КОСГУДт"							, ТипКЭК);
	Таблица.Колонки.Добавить("КОСГУКт"							, ТипКЭК);
	Таблица.Колонки.Добавить("УчетПоКПС"						, ТипБулево);
	Таблица.Колонки.Добавить("УчетПоКЭК"						, ТипБулево);
	Таблица.Колонки.Добавить("УчетПоПодразделениям"				, ТипБулево);
	Таблица.Колонки.Добавить("РазрешитьНеУказыватьПодразделение", ТипБулево);
	Таблица.Колонки.Добавить("ДатаНачалаДействия"				, ТипДата);
	Таблица.Колонки.Добавить("ДатаОкончанияДействия"			, ТипДата);
	Таблица.Колонки.Добавить("Наименование"						, ТипСтрока);
	Таблица.Колонки.Добавить("Субконто"							, ТипТЗ);
	Таблица.Колонки.Добавить("ЗапретитьИспользоватьВПроводках"	, ТипБулево);
	Таблица.Колонки.Добавить("ЭлементГруппа"					, ТипБулево);
	Таблица.Колонки.Добавить("ТипСчета"							, Новый ОписаниеТипов("ПеречислениеСсылка.ТипыСчетов"));
	Таблица.Колонки.Добавить("ВидыКПС"							, ТипМассив);
	Таблица.Колонки.Добавить("НалоговыйУчетНеУчитываемых"		, ТипБулево);
	Таблица.Колонки.Добавить("НалоговыйУчетЕНВД"				, ТипБулево);
	Таблица.Колонки.Добавить("НалоговыйУчетНДС"					, ТипБулево);
	Таблица.Колонки.Добавить("ВидыКЭК"							, ТипТЗ);
	Таблица.Колонки.Добавить("БезДетализацииКОСГУ"				, ТипБулево);

	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДанныеСчетов(СчетаОбласть = Неопределено, Свойства = "") Экспорт
	
	МакетыЗагрузки = Новый Массив;
	
	Если ТипЗнч(СчетаОбласть) = Тип("ТабличныйДокумент") Тогда
		МакетыЗагрузки.Добавить(СчетаОбласть);
		
	Иначе
		
		МакетАктуальных	= ПолучитьМакет("ПланСчетов");
		МакетУстаревших	= ПолучитьМакет("ПланСчетовУстаревшие");
		
		Если СчетаОбласть = Неопределено Тогда
			МакетыЗагрузки.Добавить(МакетАктуальных);
			МакетыЗагрузки.Добавить(МакетУстаревших);
		Иначе
			
			Если ТипЗнч(СчетаОбласть) = Тип("Строка") Тогда
				ПараметрыСтроки = СтрРазделить(СчетаОбласть, ",");
			ИначеЕсли ТипЗнч(СчетаОбласть) = Тип("Массив") Тогда
				ПараметрыСтроки = СчетаОбласть;
			ИначеЕсли ТипЗнч(СчетаОбласть) = Тип("ТаблицаЗначений") Тогда
				ПараметрыСтроки = СчетаОбласть;
			Иначе
				ВызватьИсключение "Неверный тип параметра функции ПолучитьДанныеСчетов()";
			КонецЕсли;
			
			КлючиСчетов = Новый Массив;
			
			Если ТипЗнч(ПараметрыСтроки) = Тип("ТаблицаЗначений") Тогда
				Для Каждого Параметр Из ПараметрыСтроки Цикл
					КлючиСчетов.Добавить(Параметр.Код + ":" + Формат(Параметр.ДатаНачалаДействия, "ДФ=yyyy.MM.dd; ДП=0001.01.01"));
				КонецЦикла;
			Иначе
				Для Каждого Параметр Из ПараметрыСтроки Цикл
					ИмяОбласти = СокрЛП(Параметр);
					Если МакетАктуальных.Области.Найти(ИмяОбласти) <> Неопределено Тогда
						МакетыЗагрузки.Добавить(МакетАктуальных.ПолучитьОбласть(ИмяОбласти));
					ИначеЕсли МакетУстаревших.Области.Найти(ИмяОбласти) <> Неопределено Тогда
						МакетыЗагрузки.Добавить(МакетУстаревших.ПолучитьОбласть(ИмяОбласти));
					Иначе
						КлючиСчетов.Добавить(ПолучитьКлючСчета(Параметр));
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если КлючиСчетов.Количество() > 0 Тогда
				Макеты = Новый Массив;
				Макеты.Добавить(МакетАктуальных);
				Макеты.Добавить(МакетУстаревших);
				Для Каждого Макет Из Макеты Цикл
					Для НомерСтроки = 2 По Макет.ВысотаТаблицы Цикл
						КодСчета = ПолучитьЗначение(Макет, НомерСтроки, 01, "Строка");
						Если ЗначениеЗаполнено(КодСчета) Тогда
							ДатаНачала = ПолучитьЗначение(Макет, НомерСтроки, 17, "Строка");
							КлючСтроки = ПолучитьКлючСчета(КодСчета + ":" + ДатаНачала);
							Если КлючиСчетов.Найти(КлючСтроки) <> Неопределено Тогда
								МакетыЗагрузки.Добавить(Макет.ПолучитьОбласть(НомерСтроки,,НомерСтроки));
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКолонок = Новый Структура;
	ПараметрыКолонок.Вставить("Код",								СтрРазделить("01,Строка",","));
	ПараметрыКолонок.Вставить("Родитель",							СтрРазделить("02,Строка",","));
	ПараметрыКолонок.Вставить("НомерЖурнала",						СтрРазделить("03,Журнал",","));
	ПараметрыКолонок.Вставить("Вид",								СтрРазделить("04,ВидСчета",","));
	ПараметрыКолонок.Вставить("Забалансовый",						СтрРазделить("05,Булево",","));
	ПараметрыКолонок.Вставить("Количественный",						СтрРазделить("06,Булево",","));
	ПараметрыКолонок.Вставить("Валютный",							СтрРазделить("07,Булево",","));
	ПараметрыКолонок.Вставить("ДляАвтономных",						СтрРазделить("08,Булево",","));
	ПараметрыКолонок.Вставить("ДляБюджетных",						СтрРазделить("09,Булево",","));
	ПараметрыКолонок.Вставить("ДляКазенных",						СтрРазделить("10,Булево",","));
	ПараметрыКолонок.Вставить("КОСГУДт",							СтрРазделить("11,КЭК",","));
	ПараметрыКолонок.Вставить("КОСГУКт",							СтрРазделить("12,КЭК",","));
	ПараметрыКолонок.Вставить("УчетПоКПС",							СтрРазделить("13,Булево",","));
	ПараметрыКолонок.Вставить("УчетПоКЭК",							СтрРазделить("14,Булево",","));
	ПараметрыКолонок.Вставить("УчетПоПодразделениям",				СтрРазделить("15,Булево",","));
	ПараметрыКолонок.Вставить("РазрешитьНеУказыватьПодразделение",	СтрРазделить("16,Булево",","));
	ПараметрыКолонок.Вставить("ДатаНачалаДействия",					СтрРазделить("17,Дата",","));
	ПараметрыКолонок.Вставить("ДатаОкончанияДействия",				СтрРазделить("18,Дата",","));
	ПараметрыКолонок.Вставить("Наименование",						СтрРазделить("19,Строка",","));
	ПараметрыКолонок.Вставить("ЗапретитьИспользоватьВПроводках",	СтрРазделить("38,Булево",","));
	ПараметрыКолонок.Вставить("ЭлементГруппа",						СтрРазделить("39,Булево",","));
	ПараметрыКолонок.Вставить("ТипСчета",							СтрРазделить("40,ТипСчета",","));
	ПараметрыКолонок.Вставить("ВидыКПС",							СтрРазделить("41,ВидКБК",","));
	ПараметрыКолонок.Вставить("НалоговыйУчетНеУчитываемых",			СтрРазделить("42,Булево",","));
	ПараметрыКолонок.Вставить("НалоговыйУчетЕНВД",					СтрРазделить("43,Булево",","));
	ПараметрыКолонок.Вставить("НалоговыйУчетНДС",					СтрРазделить("44,Булево",","));
	ПараметрыКолонок.Вставить("БезДетализацииКОСГУ",				СтрРазделить("45,Булево",","));

	
	Таблица = ПустаяТаблицаДанныхСчетов();
	
	СписокСвойств = ?(ТипЗнч(Свойства) = Тип("Строка"), СтрРазделить(СокрЛП(Свойства), ",", Ложь),
		ОбщегоНазначения.СкопироватьРекурсивно(Свойства, Ложь));
		
	Если СписокСвойств.Количество() = 0 Тогда
		Для Каждого Колонка Из Таблица.Колонки Цикл
			СписокСвойств.Добавить(Колонка.Имя);
		КонецЦикла;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(СписокСвойств, "Код");
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(СписокСвойств, "ДатаНачалаДействия");
	
	ТаблицаКЭК = Новый ТаблицаЗначений;
	Если СписокСвойств.Найти("ВидыКЭК") <> Неопределено Тогда	
		
		ТаблицаКЭК.Колонки.Добавить("Код");
		ТаблицаКЭК.Колонки.Добавить("Дата");
		ТаблицаКЭК.Колонки.Добавить("КЭК");
		ТаблицаКЭК.Колонки.Добавить("Наименование");
		
		МакетКЭК = ПолучитьМакет("КЭКСчетов");
		
		Для НомерСтроки = 2 По МакетКЭК.ВысотаТаблицы Цикл
			КЭК = ПолучитьЗначение(МакетКЭК, НомерСтроки, 3, "Строка");
			Если ЗначениеЗаполнено(КЭК) Тогда				
				НоваяСтрока					= ТаблицаКЭК.Добавить();
				НоваяСтрока.Код				= ПолучитьЗначение(МакетКЭК, НомерСтроки, 1, "Строка");
				НоваяСтрока.Дата			= ПолучитьЗначение(МакетКЭК, НомерСтроки, 2, "Дата");
				НоваяСтрока.КЭК				= КЭК;
				НоваяСтрока.Наименование	= ПолучитьЗначение(МакетКЭК, НомерСтроки, 4, "Строка");
			КонецЕсли;
		КонецЦикла;
		
		ТаблицаКЭК.Индексы.Добавить("Код,Дата");
		
	КонецЕсли;
	
	КэшЖурналы = Новый Соответствие;
	
	Для Каждого Макет Из МакетыЗагрузки Цикл
		
		Для НомерСтроки = 1 По Макет.ВысотаТаблицы Цикл
			
			Код = ПолучитьЗначение(Макет, НомерСтроки, ПараметрыКолонок["Код"][0], ПараметрыКолонок["Код"][1]);
			
			Если ПустаяСтрока(Код) Или Код = "Код" Тогда
				Продолжить;
			КонецЕсли;
			
			ДатаНачалаДействия = ПолучитьЗначение(Макет, НомерСтроки, ПараметрыКолонок["ДатаНачалаДействия"][0], ПараметрыКолонок["ДатаНачалаДействия"][1]);
			
			Результат = Таблица.НайтиСтроки(Новый Структура("Код,ДатаНачалаДействия", Код, ДатаНачалаДействия));
			Если Результат.Количество() > 0 Тогда
				СтруктураЭлемента = Результат[0];
			Иначе
				СтруктураЭлемента = Таблица.Добавить();
			КонецЕсли;
			
			СтруктураЭлемента.Код = Код;
			СтруктураЭлемента.ДатаНачалаДействия = ДатаНачалаДействия;
			
			Для Каждого Свойство Из СписокСвойств Цикл
				ПараметрыКолонки = Неопределено;
				Если ПараметрыКолонок.Свойство(Свойство, ПараметрыКолонки) Тогда
					СтруктураЭлемента[Свойство] = ПолучитьЗначение(Макет, НомерСтроки, ПараметрыКолонки[0], ПараметрыКолонки[1], КэшЖурналы);
				ИначеЕсли Свойство = "ВидыКЭК" Тогда
					СтруктураЭлемента[Свойство] = ПолучитьКЭКСчетов(ТаблицаКЭК, Код, ДатаНачалаДействия);
				ИначеЕсли Свойство = "Субконто" Тогда
					
					ТаблицаСубконто = Новый ТаблицаЗначений;
					ТаблицаСубконто.Колонки.Добавить("ВидСубконто");
					ТаблицаСубконто.Колонки.Добавить("ТолькоОбороты");
					ТаблицаСубконто.Колонки.Добавить("Суммовой");
					ТаблицаСубконто.Колонки.Добавить("Валютный");
					ТаблицаСубконто.Колонки.Добавить("Количественный");
					ТаблицаСубконто.Колонки.Добавить("Обязательный");
					
					Для НомерСубконто = 1 По 3 Цикл
						Смещение = 6*(НомерСубконто-1);
						ВидСубконто = ПолучитьЗначение(Макет, НомерСтроки, 20 + Смещение, "ВидСубконто");
						Если ЗначениеЗаполнено(ВидСубконто) Тогда
							СтрокаСубконто = ТаблицаСубконто.Добавить();
							СтрокаСубконто.ВидСубконто		= ВидСубконто;
							СтрокаСубконто.Обязательный		= ПолучитьЗначение(Макет, НомерСтроки, 21 + Смещение, "Булево");
							СтрокаСубконто.Валютный			= ПолучитьЗначение(Макет, НомерСтроки, 22 + Смещение, "Булево");
							СтрокаСубконто.Количественный	= ПолучитьЗначение(Макет, НомерСтроки, 23 + Смещение, "Булево");
							СтрокаСубконто.Суммовой			= ПолучитьЗначение(Макет, НомерСтроки, 24 + Смещение, "Булево");
							СтрокаСубконто.ТолькоОбороты	= ПолучитьЗначение(Макет, НомерСтроки, 25 + Смещение, "Булево");
						КонецЕсли;
					КонецЦикла;
					
					СтруктураЭлемента[Свойство] = ТаблицаСубконто;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТипСчета(Знач Текст)
	
	Текст = СокрЛП(Текст);
	
	Если Текст = "Бухгалтерский" Тогда
		Возврат Перечисления.ТипыСчетов.Бухгалтерский;
	ИначеЕсли Текст = "Налоговый" Тогда
		Возврат Перечисления.ТипыСчетов.Налоговый;
	ИначеЕсли Текст = "Управленческий" Тогда
		Возврат Перечисления.ТипыСчетов.Управленческий;
	ИначеЕсли Текст = "Вспомогательный" Тогда
		Возврат Перечисления.ТипыСчетов.Вспомогательный;
	Иначе
		Возврат Перечисления.ТипыСчетов.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция ПолучитьВидКБКСчета(Текст)
	
	МассивВидовКБК = Новый Массив;
	
	МассивКодов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(Текст));
	
	Для Каждого ЗначениеКода Из МассивКодов Цикл
		
		Если ЗначениеКода = "КРБ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КРБ;
		ИначеЕсли ЗначениеКода = "КДБ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КДБ;
		ИначеЕсли ЗначениеКода = "КИФ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КИФ;
		ИначеЕсли ЗначениеКода = "гКБК" Тогда
			ВидКБК = Перечисления.ВидыКБК.гКБК;
		Иначе
			Продолжить;
		Конецесли;
		
		МассивВидовКБК.Добавить(ВидКБК);
		
	КонецЦикла;
	
	Возврат МассивВидовКБК;
	
КонецФункции

Функция ПолучитьКлючСчета(Ключ, Структурой = Ложь)
	
	ПозицияТочек = Найти(Ключ, ":");
	Если ПозицияТочек = 0 Тогда
		КлючКод  = СокрЛП(Ключ);
		КлючДата = "0001.01.01";
	Иначе
		КлючДата = СокрЛП(Сред(Ключ,(ПозицияТочек + 1)));
		Если ПустаяСтрока(КлючДата) Тогда
			КлючДата = "0001.01.01";
		ИначеЕсли Сред(КлючДата, 3, 1) = "." Тогда
			КлючДата = Сред(КлючДата, 7, 4) + "." + Сред(КлючДата, 4, 2) + "." + Лев(КлючДата, 2);
		КонецЕсли;
		КлючКод = СокрЛП(Лев(Ключ,(ПозицияТочек - 1)));
	КонецЕсли;
	
	Если Структурой Тогда
		КлючСчета = Новый Структура("Код,Дата", КлючКод, Дата(СтрЗаменить(КлючДата, ".", "")));
	Иначе
		КлючСчета = КлючКод + ":" + КлючДата;
	КонецЕсли;
	
	Возврат КлючСчета;
	
КонецФункции

Функция ПолучитьЗначение(Макет, НомерСтроки, НомерКолонки, Правило, КэшЖурналы = Неопределено)
	
	Текст = СокрЛП(Макет.Область("R"+Формат(НомерСтроки, "ЧГ=")+"C"+НомерКолонки).Текст);
	
	Если Правило = "Булево" Тогда
		Значение = (Текст = "V");
	ИначеЕсли Правило = "Строка" Тогда
		Значение = Текст;
	ИначеЕсли Правило = "ВидСубконто" Тогда
		Значение = ?(ПустаяСтрока(Текст), ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка(),
			ПланыВидовХарактеристик.ВидыСубконто[Текст]);
	ИначеЕсли Правило = "Дата" Тогда
		Значение = ?(ПустаяСтрока(Текст), '00010101',
			Дата(Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2)));
	ИначеЕсли Правило = "КЭК" Тогда
		Значение = ?(ПустаяСтрока(Текст), Справочники.КОСГУ.ПустаяСсылка(),
			БухгалтерскийУчетПовтИсп.КЭКПоКоду(Текст));
	ИначеЕсли Правило = "ТипСчета" Тогда
		Значение = ПолучитьТипСчета(Текст);
	ИначеЕсли Правило = "ВидСчета" Тогда
		Значение =  ?(Текст = "А",	ВидСчета.Активный,
					?(Текст = "П",	ВидСчета.Пассивный,
									ВидСчета.АктивноПассивный));
	ИначеЕсли Правило = "ВидКБК" Тогда
		Значение = ПолучитьВидКБКСчета(Текст);
	ИначеЕсли Правило = "Журнал" Тогда
		Значение = КэшЖурналы[Текст];
		Если Значение = Неопределено Тогда
			Значение = ?(ПустаяСтрока(Текст), Справочники.Журналы.ПустаяСсылка(),
				Справочники.Журналы.НайтиПоКоду(Текст));
			КэшЖурналы.Вставить(Текст, Значение);
		КонецЕсли;
	Иначе
		ВызватьИсключение "Не определено правило конвертации значения макета";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьКЭКСчетов(ТаблицаКЭК, КодСчета, ДатаНачалаДействия)
	
	КЭКСчетов = Новый ТаблицаЗначений;
	КЭКСчетов.Колонки.Добавить("КЭК");
	КЭКСчетов.Колонки.Добавить("НаименованиеСчета");
	КЭКСчетов.Колонки.Добавить("Использовать");
	
	Отбор = Новый Структура("Код,Дата", КодСчета, ДатаНачалаДействия);
	СтрокиТаблицы = ТаблицаКЭК.НайтиСтроки(Отбор);
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		СтрокаКЭК					= КЭКСчетов.Добавить();
		СтрокаКЭК.КЭК				= БухгалтерскийУчетПовтИсп.КЭКПоКоду(СтрокаТаблицы.КЭК);
		СтрокаКЭК.НаименованиеСчета	= СтрокаТаблицы.Наименование;
		СтрокаКЭК.Использовать		= Истина;
	КонецЦикла;
	
	Возврат КЭКСчетов;
	
КонецФункции

Процедура ЗаписатьКЭКСчета(СчетСсылка, ВидыКЭК)
	
	НаборЗаписей = РегистрыСведений.КЭКСчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Счет.Установить(СчетСсылка);
	НаборЗаписей.Очистить();
	
	Для Каждого Элемент Из ВидыКЭК Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Элемент);
		НоваяЗапись.Счет = СчетСсылка;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей,, Истина);
	
КонецПроцедуры

Процедура ЗаписатьКПССчета(СчетСсылка, ВидыКПС)
	
	НаборЗаписей = РегистрыСведений.ВидыКБКСчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Счет.Установить(СчетСсылка);
	НаборЗаписей.Очистить();
	
	Для Каждого ВидКПС Из ВидыКПС Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Счет = СчетСсылка;
		НоваяЗапись.ВидКБК = ВидКПС;
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей,, Истина);
	
КонецПроцедуры

Функция АнализТаблицСубконто(ТекущееСубконто, СубконтоПоУмолчанию)
	
	Результат = Новый Структура("ПоУмолчанию,Различаются", Истина, Ложь);
	
	Если ТекущееСубконто.Количество() > СубконтоПоУмолчанию.Количество() Тогда
		Результат.ПоУмолчанию = Ложь;
		Результат.Различаются = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Для Сч = 1 По ТекущееСубконто.Количество() Цикл
		СтрокаТекущее = ТекущееСубконто[Сч-1];
		СтрокаПоУмолчанию = СубконтоПоУмолчанию[Сч-1];
		Если СтрокаТекущее["ВидСубконто"] <> СтрокаПоУмолчанию["ВидСубконто"] Тогда
			Результат.ПоУмолчанию = Ложь;
		КонецЕсли;
		Для Каждого Колонка Из СубконтоПоУмолчанию.Колонки Цикл
			Если СтрокаТекущее[Колонка.Имя] <> СтрокаПоУмолчанию[Колонка.Имя] Тогда
				Результат.Различаются = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ТекущееСубконто.Количество() < СубконтоПоУмолчанию.Количество() Тогда
		Результат.Различаются = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура добавляет отбор переданный в параметрах обработки выбора в условие запроса
// Может использоваться, например, в обработке получения данных выбора, когда в конфигураторе заданы параметры выбора
//
Процедура ДобавитьПараметрыВыбораВЗапрос(Запрос, Отбор = "", ЭлементыОтбора, ПервоеУсловие, НомерПараметра = 1, МетаданныеОбъекта = Неопределено)
	
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если МетаданныеОбъекта <> Неопределено Тогда
			// выполняем проверку реквизита отбора у объекта метаданных
			РеквизитНайден = Ложь;
			ПолноеИмяМетаданного = МетаданныеОбъекта.ПолноеИмя();
			ПроверятьПоРеквизитам = Лев(ПолноеИмяМетаданного, 13) <> "Перечисление.";
			Если ПроверятьПоРеквизитам Тогда
				РеквизитНайден = МетаданныеОбъекта.Реквизиты.Найти(ЭлементОтбора.Ключ) <> Неопределено;
			КонецЕсли;
			
			Если НЕ РеквизитНайден Тогда
				Для каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				
					Если ЭлементОтбора.Ключ = СтандартныйРеквизит.Имя Тогда
						РеквизитНайден = Истина;
						Прервать;
					КонецЕсли;
				
				КонецЦикла; 
			КонецЕсли;
			
			Если НЕ РеквизитНайден Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ИмяПараметра = "П"+НомерПараметра;
		Если ТипЗнч(ЭлементОтбора.Значение) = Тип("ФиксированныйМассив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("Массив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"ОсновнаяТаблица."+ЭлементОтбора.Ключ+" В (&"+ИмяПараметра+")";
		Иначе
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"ОсновнаяТаблица."+ЭлементОтбора.Ключ+" = &"+ИмяПараметра;
		КонецЕсли;
	    Запрос.УстановитьПараметр(ИмяПараметра, ЭлементОтбора.Значение);
		ПервоеУсловие = Ложь;
		НомерПараметра = НомерПараметра + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Использовать ЗагрузитьСчета()
// Загружает типовой план счетов. Используется при первом запуске и для того, 
// чтобы восстановить первоначальные настройки плана счетов.
//
Процедура ЗагрузитьСчетаМакета(Макет, Перезаписывать = Истина) Экспорт
	
	Отказ = Ложь; 
	ВысотаМакета = Макет.ВысотаТаблицы;
	
	ПоляСтруктуры = ПоляСтруктурыСчета();
	
	КОСГУСчетов = ПолучитьМакет("КЭКСчетов");
	
	Для ТекСтрока=2 По ВысотаМакета Цикл
		Если Отказ Тогда
			Прервать;
		КонецЕсли;
		СтруктураЭлемента = Новый Структура(ПоляСтруктуры,
		Макет.Область("R"+ТекСтрока+"C1").Текст,
		Макет.Область("R"+ТекСтрока+"C2").Текст,
		Макет.Область("R"+ТекСтрока+"C3").Текст,
		Макет.Область("R"+ТекСтрока+"C4").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C5").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C6").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C7").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C8").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C9").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C10").Текст),
		Макет.Область("R"+ТекСтрока+"C11").Текст,
		Макет.Область("R"+ТекСтрока+"C12").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C13").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C14").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C15").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C16").Текст),
		ВДату(Макет.Область("R"+ТекСтрока+"C17").Текст),
		ВДату(Макет.Область("R"+ТекСтрока+"C18").Текст),
		Макет.Область("R"+ТекСтрока+"C19").Текст,
		
		Макет.Область("R"+ТекСтрока+"C20").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C21").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C22").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C23").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C24").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C25").Текст),
		
		Макет.Область("R"+ТекСтрока+"C26").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C27").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C28").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C29").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C30").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C31").Текст),
		
		Макет.Область("R"+ТекСтрока+"C32").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C33").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C34").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C35").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C36").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C37").Текст),
		
		Макет.Область("R"+ТекСтрока+"C38").Текст,
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C39").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C40").Текст),
		ПолучитьТипСчета(Макет.Область("R"+ТекСтрока+"C41").Текст),
		ПолучитьВидКБКСчета(Макет.Область("R"+ТекСтрока+"C42").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C43").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C44").Текст),
		ИстинаЛожь(Макет.Область("R"+ТекСтрока+"C45").Текст)
		);
		
		ОбластьКОСГУ = ?(КОСГУСчетов.Области.Найти("С" + СтрЗаменить(СтруктураЭлемента.Код, ".", "_")) = Неопределено, Неопределено, КОСГУСчетов.ПолучитьОбласть("С" + СтрЗаменить(СтруктураЭлемента.Код, ".", "_")));
		
		ЗагрузитьЭлементПланаСчетов(СтруктураЭлемента, ОбластьКОСГУ, Отказ, Перезаписывать);
	КонецЦикла;
	
КонецПроцедуры

// Устарела. Использовать ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(<СписокСчетов>, "ВидыКЭК")
//
Процедура ОбновитьДопустимыеКОСГУСчета(СчетКодИлиСсылка) Экспорт
	
	КОСГУСчетов = ПолучитьМакет("КЭКСчетов");
	
	Если ТипЗнч(СчетКодИлиСсылка) = Тип("Строка") Тогда
		КодСчета = СчетКодИлиСсылка;
		СчетСсылка = БухгалтерскийУчет.СчетПоКоду(СчетКодИлиСсылка, Неопределено);
	Иначе
		СчетСсылка = СчетКодИлиСсылка;
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетСсылка, "Код");
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.СсылкаСуществует(СчетСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьКОСГУ = ?(КОСГУСчетов.Области.Найти("С" + СтрЗаменить(КодСчета, ".", "_")) = Неопределено, Неопределено, КОСГУСчетов.ПолучитьОбласть("С" + СтрЗаменить(КодСчета, ".", "_")));
	
	ЗагрузитьДопустимыеКОСГУСчета(СчетСсылка, ОбластьКОСГУ);
	
КонецПроцедуры

// Устарела. Использовать ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(<СписокСчетов>, "ВидыКПС")
//
Процедура ОбновитьДопустимыеВидыКПССчета(ИмяОбласти = "ЕПСБУ", СчетКодИлиСсылка) Экспорт
	
	Макет = ПланыСчетов.ЕПСБУ.ПолучитьМакет("ПланСчетов");
	МакетЗагрузки = Макет.ПолучитьОбласть(ИмяОбласти);
	
	Если ТипЗнч(СчетКодИлиСсылка) = Тип("Строка") Тогда
		КодСчета = СчетКодИлиСсылка;
		СчетСсылка = БухгалтерскийУчет.СчетПоКоду(СчетКодИлиСсылка, Неопределено);
	Иначе
		СчетСсылка = СчетКодИлиСсылка;
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетСсылка, "Код");
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.СсылкаСуществует(СчетСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Строка = МакетЗагрузки.НайтиТекст(КодСчета,,МакетЗагрузки.Область("C1"),Ложь).Верх;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидыКБКСчета = ПолучитьВидКБКСчета(МакетЗагрузки.Область("R"+Строка+"C42").Текст);
	
	Регистр = РегистрыСведений.ВидыКБКСчетов.СоздатьНаборЗаписей();
	Регистр.Отбор.Счет.Установить(СчетСсылка);
	Регистр.Очистить();

	Для Каждого ВидКПС Из ВидыКБКСчета Цикл
		
		НоваяЗапись = Регистр.Добавить();
		НоваяЗапись.Счет = СчетСсылка;
		НоваяЗапись.ВидКБК = ВидКПС;
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Регистр);
	
КонецПроцедуры

// Устарела. Использовать БухгалтерскийУчет.СписокСчетов()
// Возвращает массив счетов для использования в условиях и запросах
//
Функция ПолучитьМассивСчетов(Счета, БезУчетаИерархии=Ложь) Экспорт
	Возврат БухгалтерскийУчет.СписокСчетов(Счета, БезУчетаИерархии);
КонецФункции

// Устарела.
//
Функция ПоляСтруктурыСчета() Экспорт
	
	ПоляСтруктуры = "Код, Родитель, НомерЖурнала, Вид, Забалансовый, Количественный, Валютный, ДляАвтономных, 
	|ДляБюджетных, ДляКазенных, КОСГУДт, КОСГУКт, УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, РазрешитьНеУказыватьПодразделение,
	|ДатаНачалаДействия, ДатаОкончанияДействия, Наименование,
	|Субконто1Вид, Субконто1Обязательный, Субконто1Валютный, Субконто1Количественный, Субконто1Суммовой, Субконто1ТолькоОбороты,
	|Субконто2Вид, Субконто2Обязательный, Субконто2Валютный, Субконто2Количественный, Субконто2Суммовой, Субконто2ТолькоОбороты,
	|Субконто3Вид, Субконто3Обязательный, Субконто3Валютный, Субконто3Количественный, Субконто3Суммовой, Субконто3ТолькоОбороты,
	|Порядок, ЗапретитьИспользоватьВПроводках, ЭлементГруппа, ТипСчета, ВидыКПС,
	|НалоговыйУчетНеУчитываемых, НалоговыйУчетЕНВД, НалоговыйУчетНДС";
	
	Возврат ПоляСтруктуры;
	
КонецФункции

// Устарела.
// Загружает элемент плана счетов. Если счет уже существует, то приводит его к тому виду, в котором он поставляется.
// Проверяются так же виды субконто и признаки учета у них. При этом субконто отстуствующие, но которые должны быть у
// счета добавляются. Восстанавливается первоначальный порядок субконто, недостающие субконто добавляются. При этом
// если для субконто не хватает места, то удаляется последнее субконто, добавленное пользователем.
//
// Параметры
//  СтруктураЭлемента  - Структура - Содержит все данные о счете и субконто.
//
Процедура ЗагрузитьЭлементПланаСчетов(СтруктураЭлемента, МакетКОСГУ, Отказ, Знач Перезаписывать)
	
	МаксимальноеКоличествоСубконто=Метаданные.ПланыСчетов.ЕПСБУ.МаксКоличествоСубконто;
	ПланСчетов = ПланыСчетов.ЕПСБУ;
	
	Если НЕ ЗначениеЗаполнено(СтруктураЭлемента.Код) Тогда
		Возврат; // Пустые строки пропускаем.
	КонецЕсли;
	
	СчетРодитель = СчетПоКоду(СтруктураЭлемента.Родитель, СтруктураЭлемента.ДатаНачалаДействия, Истина);
	
	Если ЗначениеЗаполнено(СтруктураЭлемента.Родитель) И СчетРодитель.Пустая() Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Не найден счет %1. Заполнение плана счетов остановлено.'"), СтруктураЭлемента.Родитель);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ВидСч = ?(СтруктураЭлемента.Вид = "А", ВидСчета.Активный, ?(СтруктураЭлемента.Вид = "П", ВидСчета.Пассивный, ВидСчета.АктивноПассивный));
	КОСГУДт = Справочники.КОСГУ.НайтиПоКоду(СтруктураЭлемента.КОСГУДт);
	КОСГУКт = Справочники.КОСГУ.НайтиПоКоду(СтруктураЭлемента.КОСГУКт);
	НомерЖурнала = Справочники.Журналы.НайтиПоКоду(СтруктураЭлемента.НомерЖурнала);
	
	КоличествоСубконто=0;
	ВидыСубконтоЭталон = Новый Массив;
	Если ЗначениеЗаполнено(СтруктураЭлемента.Субконто1Вид) Тогда
		ВидыСубконтоЭталон.Добавить(ПланыВидовХарактеристик.ВидыСубконто[СтруктураЭлемента.Субконто1Вид]);
		КоличествоСубконто=1;
		Если ЗначениеЗаполнено(СтруктураЭлемента.Субконто2Вид) Тогда
			ВидыСубконтоЭталон.Добавить(ПланыВидовХарактеристик.ВидыСубконто[СтруктураЭлемента.Субконто2Вид]);
			КоличествоСубконто=2;
			Если ЗначениеЗаполнено(СтруктураЭлемента.Субконто3Вид) Тогда
				ВидыСубконтоЭталон.Добавить(ПланыВидовХарактеристик.ВидыСубконто[СтруктураЭлемента.Субконто3Вид]);
				КоличествоСубконто=3;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НайденыйСчет = СчетПоКоду(СтруктураЭлемента.Код, СтруктураЭлемента.ДатаНачалаДействия);
	
	Если НайденыйСчет.Пустая() Тогда
		СчетОбъект 			= ПланСчетов.СоздатьСчет();
		СчетОбъект.Родитель = СчетРодитель;
		СчетОбъект.Код 		= СтруктураЭлемента.Код;
		Перезаписывать 		= Истина;
	Иначе
		СчетОбъект = НайденыйСчет.ПолучитьОбъект();
		Попытка
			
			СчетОбъект.Заблокировать();
			
		Исключение
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не удалось заблокировать для записи счет %1.
			|Возможно он редактируется другим пользователем.
			|Заполнение плана счетов остановлено.'"), СчетОбъект.Код);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,СчетОбъект.Ссылка,,,Отказ);
			Возврат;
			
		КонецПопытки;
	КонецЕсли;
	
	Если СчетОбъект.Наименование <> СтруктураЭлемента.Наименование И (Перезаписывать ИЛИ НЕ ЗначениеЗаполнено(СчетОбъект.Наименование)) Тогда
		СчетОбъект.Наименование = СтруктураЭлемента.Наименование;
	КонецЕсли;
	
	Если СчетОбъект.ДляАвтономных<>СтруктураЭлемента.ДляАвтономных И Перезаписывать Тогда
		СчетОбъект.ДляАвтономных = СтруктураЭлемента.ДляАвтономных;
	КонецЕсли;
	
	Если СчетОбъект.ДляБюджетных <> СтруктураЭлемента.ДляБюджетных И Перезаписывать Тогда
		СчетОбъект.ДляБюджетных = СтруктураЭлемента.ДляБюджетных;
	КонецЕсли;
	
	Если СчетОбъект.ДляКазенных <> СтруктураЭлемента.ДляКазенных И Перезаписывать Тогда
		СчетОбъект.ДляКазенных = СтруктураЭлемента.ДляКазенных;
	КонецЕсли;
	
	Если СчетОбъект.КОСГУДт <> КОСГУДт И (Перезаписывать ИЛИ НЕ ЗначениеЗаполнено(СчетОбъект.КОСГУДт)) Тогда
		СчетОбъект.КОСГУДт = КОСГУДт;
	КонецЕсли;
	
	Если СчетОбъект.КОСГУКт <> КОСГУКт И (Перезаписывать ИЛИ НЕ ЗначениеЗаполнено(СчетОбъект.КОСГУКт)) Тогда
		СчетОбъект.КОСГУКт = КОСГУКт;
	КонецЕсли;
	
	Если СчетОбъект.УчетПоКПС <> СтруктураЭлемента.УчетПоКПС И Перезаписывать Тогда
		СчетОбъект.УчетПоКПС = СтруктураЭлемента.УчетПоКПС;
	КонецЕсли;
	
	Если СчетОбъект.УчетПоКЭК <> СтруктураЭлемента.УчетПоКЭК И Перезаписывать Тогда
		СчетОбъект.УчетПоКЭК = СтруктураЭлемента.УчетПоКЭК;
	КонецЕсли;
	
	Если СчетОбъект.УчетПоПодразделениям <> СтруктураЭлемента.УчетПоПодразделениям И Перезаписывать Тогда
		СчетОбъект.УчетПоПодразделениям = СтруктураЭлемента.УчетПоПодразделениям;
	КонецЕсли;
	
	Если СчетОбъект.РазрешитьНеУказыватьПодразделение <> СтруктураЭлемента.РазрешитьНеУказыватьПодразделение И Перезаписывать Тогда
		СчетОбъект.РазрешитьНеУказыватьПодразделение = СтруктураЭлемента.РазрешитьНеУказыватьПодразделение;
	КонецЕсли;
	
	Если СчетОбъект.НомерЖурнала <> НомерЖурнала И (Перезаписывать ИЛИ НЕ ЗначениеЗаполнено(СчетОбъект.НомерЖурнала)) Тогда
		СчетОбъект.НомерЖурнала = НомерЖурнала;
	КонецЕсли;
	
	Если СчетОбъект.ЗапретитьИспользоватьВПроводках <> СтруктураЭлемента.ЗапретитьИспользоватьВПроводках И Перезаписывать Тогда
		СчетОбъект.ЗапретитьИспользоватьВПроводках=СтруктураЭлемента.ЗапретитьИспользоватьВПроводках;
	КонецЕсли;
	
	Если СчетОбъект.Порядок <> СтруктураЭлемента.Порядок Тогда
		СчетОбъект.Порядок = СтруктураЭлемента.Порядок;
	КонецЕсли;
	
	Если СчетОбъект.ДатаНачалаДействия <> СтруктураЭлемента.ДатаНачалаДействия Тогда
		СчетОбъект.ДатаНачалаДействия = СтруктураЭлемента.ДатаНачалаДействия;
	КонецЕсли;
	
	Если СчетОбъект.ЭлементГруппа <> СтруктураЭлемента.ЭлементГруппа Тогда
		СчетОбъект.ЭлементГруппа = СтруктураЭлемента.ЭлементГруппа;
	КонецЕсли;
	 
	Если СчетОбъект.ТипСчета <> СтруктураЭлемента.ТипСчета Тогда
		СчетОбъект.ТипСчета = СтруктураЭлемента.ТипСчета;
	КонецЕсли;
	
	Если СчетОбъект.НалоговыйУчетНеУчитываемых <> СтруктураЭлемента.НалоговыйУчетНеУчитываемых Тогда
		СчетОбъект.НалоговыйУчетНеУчитываемых = СтруктураЭлемента.НалоговыйУчетНеУчитываемых;
	КонецЕсли;
	
	Если СчетОбъект.НалоговыйУчетЕНВД <> СтруктураЭлемента.НалоговыйУчетЕНВД Тогда
		СчетОбъект.НалоговыйУчетЕНВД = СтруктураЭлемента.НалоговыйУчетЕНВД;
	КонецЕсли;
	
	Если СчетОбъект.НалоговыйУчетНДС <> СтруктураЭлемента.НалоговыйУчетНДС Тогда
		СчетОбъект.НалоговыйУчетНДС = СтруктураЭлемента.НалоговыйУчетНДС;
	КонецЕсли;
	
	Если СчетОбъект.Валютный <> СтруктураЭлемента.Валютный И Перезаписывать Тогда
		СчетОбъект.Валютный = СтруктураЭлемента.Валютный;
	КонецЕсли;
	
	Если СчетОбъект.Вид <> ВидСч И (Перезаписывать ИЛИ НЕ ЗначениеЗаполнено(СчетОбъект.Вид)) Тогда
		СчетОбъект.Вид = ВидСч;
	КонецЕсли;
	
	Если СчетОбъект.Забалансовый <> СтруктураЭлемента.Забалансовый И Перезаписывать Тогда
		СчетОбъект.Забалансовый = СтруктураЭлемента.Забалансовый;
	КонецЕсли;
	
	Если СчетОбъект.Количественный <> СтруктураЭлемента.Количественный И Перезаписывать Тогда
		СчетОбъект.Количественный = СтруктураЭлемента.Количественный;
	КонецЕсли;
	
	Если СчетОбъект.ПометкаУдаления Тогда
		СчетОбъект.ПометкаУдаления = Ложь;
	КонецЕсли;
	
	ВидыСубконто = СчетОбъект.ВидыСубконто;
	МассивДобавленных = ПолучитьДобавленныеВидыСубконто(ВидыСубконтоЭталон, ВидыСубконто);
	
	Для ТекНомерСубконто = 0 По КоличествоСубконто-1 Цикл
		
		Если ВидыСубконто.Количество() > ТекНомерСубконто Тогда //Субконто уже есть, это изменения
			
			Если ВидыСубконто[ТекНомерСубконто].Предопределенное ИЛИ НЕ Перезаписывать Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВидыСубконто[ТекНомерСубконто].ВидСубконто <> ВидыСубконтоЭталон[ТекНомерСубконто] Тогда 
				
				Если ВидыСубконто.Количество() > 1 И (ТекНомерСубконто + 1) < МаксимальноеКоличествоСубконто 
					И ВидыСубконто.Количество() > ТекНомерСубконто + 1 И ВидыСубконто[ТекНомерСубконто + 1].ВидСубконто = ВидыСубконтоЭталон[ТекНомерСубконто] Тогда
					
					ВидыСубконто.Сдвинуть(ТекНомерСубконто + 1, -1);
					ПроверитьДобавитьВидСубконто(ВидыСубконто[ТекНомерСубконто],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Обязательный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Валютный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Количественный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Суммовой"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "ТолькоОбороты"]);
					
				ИначеЕсли ВидыСубконто.Количество() > 2 И (ТекНомерСубконто + 2) <= МаксимальноеКоличествоСубконто 
					И ВидыСубконто.Количество() > ТекНомерСубконто + 2 И ВидыСубконто[ТекНомерСубконто + 2].ВидСубконто = ВидыСубконтоЭталон[ТекНомерСубконто] Тогда
					
					ВидыСубконто.Сдвинуть(ТекНомерСубконто + 2, -2);
					ПроверитьДобавитьВидСубконто(ВидыСубконто[ТекНомерСубконто],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Обязательный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Валютный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Количественный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Суммовой"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "ТолькоОбороты"]);
					
				Иначе // вид субконто не найден,
					
					Если ВидыСубконто.Количество() = МаксимальноеКоличествоСубконто Тогда // нет места для добавления
						ВидыСубконто.Удалить(МассивДобавленных.Количество() - 1);
					КонецЕсли;
					
					НовСубконто = ВидыСубконто.Вставить(ТекНомерСубконто);
					НовСубконто.ВидСубконто = ВидыСубконтоЭталон[ТекНомерСубконто];
					ПроверитьДобавитьВидСубконто(НовСубконто,
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Обязательный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Валютный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Количественный"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Суммовой"],
					СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "ТолькоОбороты"]);
					
				КонецЕсли;
				
			Иначе
				
				ПроверитьДобавитьВидСубконто(ВидыСубконто[ТекНомерСубконто],
				СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Обязательный"],
				СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Валютный"],
				СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Количественный"],
				СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Суммовой"],
				СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "ТолькоОбороты"]);
				
			КонецЕсли;
			
		ИначеЕсли ВидыСубконто.Найти(ВидыСубконтоЭталон[ТекНомерСубконто], "ВидСубконто") = Неопределено И Перезаписывать Тогда 
			
			НовСубконто = ВидыСубконто.Добавить();
			НовСубконто.ВидСубконто = ВидыСубконтоЭталон[ТекНомерСубконто];
			ПроверитьДобавитьВидСубконто(НовСубконто,
			СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Обязательный"],
			СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Валютный"],
			СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Количественный"],
			СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "Суммовой"],
			СтруктураЭлемента["Субконто" + (ТекНомерСубконто + 1) + "ТолькоОбороты"]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СчетОбъект.Модифицированность() Тогда
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СчетОбъект);
		
	КонецЕсли; 
	
	// Допустимые КОСГУ счета.
	ЗагрузитьДопустимыеКОСГУСчета(СчетОбъект.Ссылка, МакетКОСГУ);
	
	// Допустимые виды КПС (КБК) счета (используются для казенных учреждений).
	Регистр = РегистрыСведений.ВидыКБКСчетов.СоздатьНаборЗаписей();
	Регистр.Отбор.Счет.Установить(СчетОбъект.Ссылка);
	Регистр.Очистить();

	Для Каждого ВидКПС Из СтруктураЭлемента.ВидыКПС Цикл
		
		НоваяЗапись = Регистр.Добавить();
		НоваяЗапись.Счет = СчетОбъект.Ссылка;
		НоваяЗапись.ВидКБК = ВидКПС;
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Регистр);
	
КонецПроцедуры

// Устарела.
//
Процедура ЗагрузитьДопустимыеКОСГУСчета(СчетСсылка, МакетКОСГУ)
	
	Регистр = РегистрыСведений.КЭКСчетов.СоздатьНаборЗаписей();
	Регистр.Отбор.Счет.Установить(СчетСсылка);
	Регистр.Очистить();
	
	Если НЕ МакетКОСГУ = Неопределено Тогда
		
		Для ТекСтрока=1 По МакетКОСГУ.ВысотаТаблицы Цикл
			
			Стр = Новый Структура("Счет, НаименованиеСчета, КЭК, Использовать", СчетСсылка, МакетКОСГУ.Область("R"+ТекСтрока+"C3").Текст, Справочники.КОСГУ.НайтиПоКоду(МакетКОСГУ.Область("R"+ТекСтрока+"C2").Текст), Истина);
			ЗаполнитьЗначенияСвойств(Регистр.Добавить(), Стр); 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(Регистр);
	
КонецПроцедуры

// Устарела.
// Процедура устанавливает признаки учета у вида субконто.
//
// Параметры
//  ВидСубконто  - ПланСчетовВидСубконтоСтрока - проверяемый вид субконто
//  Валютный  - Булево - Признак валютного учета
//  Количественный  - Булево - Признак количественного учета
//  Суммовой  - Булево - Признак суммового учета
//  ТолькоОбороты  - Булево - Признак оборотного субконто
//
Процедура ПроверитьДобавитьВидСубконто(ВидСубконто, Обязательный, Валютный, Количественный, Суммовой, ТолькоОбороты)
	
	Если ВидСубконто.Обязательный <> Обязательный Тогда
		ВидСубконто.Обязательный = Обязательный;
	КонецЕсли;
	
	Если ВидСубконто.Валютный <> Валютный Тогда
		ВидСубконто.Валютный = Валютный;
	КонецЕсли;
	
	Если ВидСубконто.Количественный <> Количественный Тогда
		ВидСубконто.Количественный = Количественный;
	КонецЕсли;
	
	Если ВидСубконто.Суммовой <> Суммовой Тогда
		ВидСубконто.Суммовой = Суммовой;
	КонецЕсли;
	
	Если ВидСубконто.ТолькоОбороты <> ТолькоОбороты Тогда
		ВидСубконто.ТолькоОбороты = ТолькоОбороты;
	КонецЕсли;
	
КонецПроцедуры

// Устарела.
// Возвращает массив видов субконто, добавленных по отношению к эталонному набору видов субконто.
//
// Параметры
//  ВидыСубконтоЭталон  - Массив - Эталонный набор видов субконто у счета
//  ВидыСубконто  - Массив - Реальный набор видов субконто у счета
//
// Возвращаемое значение:
//   Массив   - Массив видов субконто, добавленных к счету 
//
Функция ПолучитьДобавленныеВидыСубконто(ВидыСубконтоЭталон, ВидыСубконто)
	МассивДобавленных = Новый Массив;
	Для каждого ТекСубконто Из ВидыСубконто Цикл
		Если ВидыСубконтоЭталон.Найти(ТекСубконто.ВидСубконто) = Неопределено Тогда
			МассивДобавленных.Добавить(ТекСубконто);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивДобавленных;
КонецФункции

// Устарела.
// Преобразует текст в таблице в значения "Истина" и "Ложь".
// В таблице значения "Истина" отмечены символом "V".
//
// Параметры
//  Текст  - Строка - Текст ячейки таблицы, который надо преобразовать.
//
// Возвращаемое значение:
//   Булево   - Значение, приведенное к булевому.
//
Функция ИстинаЛожь(Текст)
	
	Если СокрЛП(Текст) = "V" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Устарела.
//
Функция ВДату(Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат '00010101';
	КонецЕсли;
	
	Возврат Дата(Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2));
	
КонецФункции

// Устарела.
// Проверяет в какой группе по учету подразделений находится счет. Возвращает группу и признак учета
// по подразделениям.
// Параметры:
// Счет - Ссылка на план счетов ЕПСБУ;
// Группа - строка;
// УчетПоПодразделениям - булево.
//
Процедура ПолучитьГруппуУчетаПоПодразделениям(Счет,Группа,УчетПоПодразделениям) Экспорт
	Группа = "";
	УчетПоПодразделениям = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В (&СчетОСНМА)
	|			ТОГДА ""Основные средства, нематериальные активы, амортизация (101, 102, 104.10, 104.20, 104.30, 104.40, 21)""
	|		КОГДА ЕПСБУ.Ссылка В (&СчетИК)
	|			ТОГДА ""Имущество казны, амортизация (108, 104.50)""
	|		КОГДА ЕПСБУ.Код = ""105.Б8""
	|				ИЛИ ЕПСБУ.Код = ""105.29""
	|			ТОГДА ""(В рознице) Товары и наценка - особо ценное движимое имущество учреждения. (105.Б8, 105.29)""
	|		КОГДА ЕПСБУ.Код = ""105.Г8""
	|				ИЛИ ЕПСБУ.Код = ""105.39""
	|			ТОГДА ""(В рознице) Товары и наценка - иное движимое имущество учреждения. (105.Г8, 105.39)""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Группа,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям
	|ПОМЕСТИТЬ ГруппыСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыСчетов.Группа КАК Группа
	|ИЗ
	|	ГруппыСчетов КАК ГруппыСчетов
	|ГДЕ
	|	ГруппыСчетов.Ссылка = &Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыСчетов.Группа КАК Группа,
	|	МАКСИМУМ(ГруппыСчетов.УчетПоПодразделениям) КАК УчетПоПодразделениям
	|ИЗ
	|	ГруппыСчетов КАК ГруппыСчетов
	|ГДЕ
	|	ГруппыСчетов.Группа <> &ПустаяГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	ГруппыСчетов.Группа";
	
	Запрос.УстановитьПараметр("Счет"			, Счет);
	Запрос.УстановитьПараметр("ПустаяГруппа"	, "");
	Запрос.УстановитьПараметр("СчетОСНМА"		, БухгалтерскийУчет.СписокСчетов("101.00,102.00,104.10,104.20,104.30,104.40,21"));
	Запрос.УстановитьПараметр("СчетИК"			, БухгалтерскийУчет.СписокСчетов("108.00,104.50"));
	
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаГруппаСчета = Результаты[1].Выбрать();
	
	Если ВыборкаГруппаСчета.Следующий() Тогда
		Группа = ВыборкаГруппаСчета.Группа;
	КонецЕсли;
	Если Группа = "" Тогда		
		Возврат;
	КонецЕсли;
	ТаблицаГруппУчета = Результаты[2].Выгрузить();
	СтрокаУчета = ТаблицаГруппУчета.Найти(Группа,"Группа");
	Если СтрокаУчета<>Неопределено Тогда
		УчетПоПодразделениям = СтрокаУчета.УчетПоПодразделениям;
	КонецЕсли;
	
КонецПроцедуры

// Устарела. Использовать СоздатьНовыеСчета
// Загружает Счета типовго план счетов. Используется при первом запуске и для того, 
// чтобы восстановить первоначальные настройки плана счетов.
//
// Параметры:
//  ИмяОбласти	 	- Строка, Массив 	-	коды счетов и/или имен областей макетов "ПланСчетов" и "ПланСчетовУстаревшие"
//                             				в которых указаны свойства загружаемых счетов. Либо табличный документ со свойствами.
//											Если не указан - загружается весь план счетов.
//  Перезаписывать	- Булево 			-	если ИСТИНА, то все настройки счетов будут удалены и сформированы заново, 
//											иначе будут установлены только отсутствующие свойства.
//
Процедура ЗагрузитьСчета(ИмяОбласти = Неопределено, Перезаписывать = Истина) Экспорт
	
	Если Не ПланыОбмена.ГлавныйУзел() = Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	Таблица = ПолучитьДанныеСчетов(ИмяОбласти);
	ЗаписатьДанныеСчетов(Таблица, Перезаписывать);

КонецПроцедуры

// Устарела.
//
Процедура ЗаписатьДанныеСчетов(Таблица, Перезаполнить = Истина) Экспорт
	
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	
	Для Каждого СтруктураЭлемента Из Таблица Цикл
		
		СчетРодитель = СчетПоКоду(СтруктураЭлемента.Родитель, СтруктураЭлемента.ДатаНачалаДействия, Истина);
		
		Если ЗначениеЗаполнено(СтруктураЭлемента.Родитель) И СчетРодитель.Пустая() Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не найден счет %1. Заполнение плана счетов остановлено.'"), СтруктураЭлемента.Родитель);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
			
		НайденыйСчет = СчетПоКоду(СтруктураЭлемента.Код, СтруктураЭлемента.ДатаНачалаДействия);
		
		Если НайденыйСчет.Пустая() Тогда
			СчетОбъект						= ПланыСчетов.ЕПСБУ.СоздатьСчет();
			СчетОбъект.Код					= СтруктураЭлемента.Код;
			СчетОбъект.ДатаНачалаДействия	= СтруктураЭлемента.ДатаНачалаДействия;
			Перезаписывать = Истина;
		Иначе
			СчетОбъект = НайденыйСчет.ПолучитьОбъект();
			Перезаписывать = Перезаполнить;
			Попытка
				СчетОбъект.Заблокировать();
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Не удалось заблокировать для записи счет %1.
				|Возможно он редактируется другим пользователем.
				|Заполнение плана счетов остановлено.'"), СчетОбъект.Код);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, СчетОбъект.Ссылка);
				Возврат;
			КонецПопытки;
		КонецЕсли;
		
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Родитель							, СчетРодитель											, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Наименование						, СтруктураЭлемента.Наименование						, Перезаписывать, Истина);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ДатаОкончанияДействия				, СтруктураЭлемента.ДатаОкончанияДействия				, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ДляАвтономных						, СтруктураЭлемента.ДляАвтономных						, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ДляБюджетных						, СтруктураЭлемента.ДляБюджетных						, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ДляКазенных						, СтруктураЭлемента.ДляКазенных							, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.КОСГУДт							, СтруктураЭлемента.КОСГУДт								, Перезаписывать, Истина);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.КОСГУКт							, СтруктураЭлемента.КОСГУКт								, Перезаписывать, Истина);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.УчетПоКПС							, СтруктураЭлемента.УчетПоКПС							, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.УчетПоКЭК							, СтруктураЭлемента.УчетПоКЭК							, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.УчетПоПодразделениям				, СтруктураЭлемента.УчетПоПодразделениям				, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.РазрешитьНеУказыватьПодразделение	, СтруктураЭлемента.РазрешитьНеУказыватьПодразделение	, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.НомерЖурнала						, СтруктураЭлемента.НомерЖурнала						, Перезаписывать, Истина);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ЗапретитьИспользоватьВПроводках	, СтруктураЭлемента.ЗапретитьИспользоватьВПроводках		, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Порядок							, СтруктураЭлемента.Порядок								, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ЭлементГруппа						, СтруктураЭлемента.ЭлементГруппа						, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.ТипСчета							, СтруктураЭлемента.ТипСчета							, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.НалоговыйУчетНеУчитываемых		, СтруктураЭлемента.НалоговыйУчетНеУчитываемых			, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.НалоговыйУчетЕНВД					, СтруктураЭлемента.НалоговыйУчетЕНВД					, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.НалоговыйУчетНДС					, СтруктураЭлемента.НалоговыйУчетНДС					, Истина		, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Валютный							, СтруктураЭлемента.Валютный							, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Вид								, СтруктураЭлемента.Вид									, Перезаписывать, Истина);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Забалансовый						, СтруктураЭлемента.Забалансовый						, Перезаписывать, Ложь	);
		ЗаполнитьЗначениеРеквизита(СчетОбъект.Количественный					, СтруктураЭлемента.Количественный						, Перезаписывать, Ложь	);

		Если СчетОбъект.ПометкаУдаления Тогда
			СчетОбъект.ПометкаУдаления = Ложь;
		КонецЕсли;
		
		Если Перезаписывать Тогда
			Если ТаблицыСубконтоРазличаются(СчетОбъект.ВидыСубконто, СтруктураЭлемента.Субконто) Тогда
				ТекущиеСубконто = СчетОбъект.ВидыСубконто.Выгрузить();
				СчетОбъект.ВидыСубконто.Загрузить(СтруктураЭлемента.Субконто);
				Для Каждого СтрокаСубконто Из ТекущиеСубконто Цикл
					Если СчетОбъект.ВидыСубконто.Найти(СтрокаСубконто.ВидСубконто, "ВидСубконто") = Неопределено
						И СчетОбъект.ВидыСубконто.Количество() < МаксКоличествоСубконто Тогда
						ЗаполнитьЗначенияСвойств(СчетОбъект.ВидыСубконто.Добавить(), СтрокаСубконто);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если СчетОбъект.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СчетОбъект);
		КонецЕсли; 
		
		// Допустимые КОСГУ счета.
		ЗаписатьКЭКСчета(СчетОбъект.Ссылка, СтруктураЭлемента.ВидыКЭК);
		
		// Допустимые виды КПС (КБК) счета (используются для казенных учреждений).
		ЗаписатьКПССчета(СчетОбъект.Ссылка, СтруктураЭлемента.ВидыКПС);
		
	КонецЦикла;
	
КонецПроцедуры

// Устарела.
//
Процедура ЗаполнитьЗначениеРеквизита(ТекущееЗначение, НовоеЗначение, Перезаписывать = Истина, ПроверятьЗаполнение = Истина)
	
	Если ТекущееЗначение <> НовоеЗначение
		И (Перезаписывать Или ПроверятьЗаполнение И Не ЗначениеЗаполнено(ТекущееЗначение)) Тогда
		ТекущееЗначение = НовоеЗначение;
	КонецЕсли;
	
КонецПроцедуры

// Устарела.
//
Функция ТаблицыСубконтоРазличаются(ТекущееСубконто, СубконтоПоУмолчанию)
	
	Если ТекущееСубконто.Количество() <> СубконтоПоУмолчанию.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Сч = 1 По ТекущееСубконто.Количество() Цикл
		СтрокаТекущее = ТекущееСубконто[Сч-1];
		СтрокаПоУмолчанию = СубконтоПоУмолчанию[Сч-1];
		Для Каждого Колонка Из СубконтоПоУмолчанию.Колонки Цикл
			Если СтрокаТекущее[Колонка.Имя] <> СтрокаПоУмолчанию[Колонка.Имя] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Устарела.
//
Функция ПустаяТаблицаСчетов() Экспорт
	
	Возврат ПустаяТаблицаДанныхСчетов();
	
КонецФункции

#КонецОбласти

#КонецЕсли
