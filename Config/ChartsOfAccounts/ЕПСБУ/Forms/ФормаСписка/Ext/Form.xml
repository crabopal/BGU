	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
				<Field>Список.ДатаНачалаДействия</Field>
				<Field>Список.ДатаОкончанияДействия</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЕПСБУ.Код КАК Код,
	ЕПСБУ.Наименование,
	ВЫБОР
		КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
			ТОГДА "А"
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
					ТОГДА "П"
				ИНАЧЕ "АП"
			КОНЕЦ
	КОНЕЦ КАК Вид,
	ЕПСБУ.Забалансовый КАК Забалансовый,
	ЕПСБУ.Валютный,
	ЕПСБУ.Количественный,
	ЕПСБУ.Родитель,
	ЕПСБУ.Порядок КАК ПорядокСчетов,
	ЕПСБУ.ЗапретитьИспользоватьВПроводках,
	ЕПСБУ.НомерЖурнала,
	ЕПСБУ.ЭлементГруппа,
	ЕПСБУ.ДляКазенных,
	ЕПСБУ.ДляБюджетных,
	ЕПСБУ.ДляАвтономных,
	Субконто1.Субконто КАК Субконто1,
	Субконто2.Субконто КАК Субконто2,
	Субконто3.Субконто КАК Субконто3,
	ВЫБОР
		КОГДА ИспользоватьВалютныйУчет.Значение 
			ИЛИ ЕПСБУ.ЭлементГруппа 
			ИЛИ ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
			ИЛИ ЕПСБУ.Предопределенный
			ТОГДА ИСТИНА
		ИНАЧЕ ВЫБОР
				КОГДА ЕПСБУ.Валютный
					ТОГДА ЛОЖЬ
				ИНАЧЕ ИСТИНА
			КОНЕЦ
	КОНЕЦ КАК СчетСоответствуетНастройкеВалютногоУчета,
	ЕПСБУ.Ссылка,
	ЕПСБУ.ТипСчета,
	ЕПСБУ.УчетПоКПС,
	ЕПСБУ.УчетПоПодразделениям,
	ЕПСБУ.ДатаНачалаДействия,
	ЕПСБУ.ДатаОкончанияДействия
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЕПСБУВидыСубконто.ВидСубконто.Наименование + ВЫБОР
				КОГДА ЕПСБУВидыСубконто.ТолькоОбороты
					ТОГДА " (об)"
				ИНАЧЕ ""
			КОНЕЦ КАК Субконто,
			ЕПСБУВидыСубконто.Ссылка КАК Ссылка
		ИЗ
			ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		ГДЕ
			ЕПСБУВидыСубконто.НомерСтроки = 1) КАК Субконто1
		ПО ЕПСБУ.Ссылка = Субконто1.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЕПСБУВидыСубконто.ВидСубконто.Наименование + ВЫБОР
				КОГДА ЕПСБУВидыСубконто.ТолькоОбороты
					ТОГДА " (об)"
				ИНАЧЕ ""
			КОНЕЦ КАК Субконто,
			ЕПСБУВидыСубконто.Ссылка КАК Ссылка
		ИЗ
			ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		ГДЕ
			ЕПСБУВидыСубконто.НомерСтроки = 2) КАК Субконто2
		ПО ЕПСБУ.Ссылка = Субконто2.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЕПСБУВидыСубконто.ВидСубконто.Наименование + ВЫБОР
				КОГДА ЕПСБУВидыСубконто.ТолькоОбороты
					ТОГДА " (об)"
				ИНАЧЕ ""
			КОНЕЦ КАК Субконто,
