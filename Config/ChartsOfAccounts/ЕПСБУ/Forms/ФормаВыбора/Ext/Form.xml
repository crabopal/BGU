				ГДЕ
					КорректныеКорреспонденцииСчетов.СчетДт = ПланСчетовЕПСБУ.Ссылка
					И КорректныеКорреспонденцииСчетов.СчетКт = &amp;КорреспонденцияКт)
					
			// кор. счет, если в корректных проводках указан родитель счета Кт
