			// проверка по субконто текущего счета
			ИЛИ ИСТИНА В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ИСТИНА КАК Поле1
				ИЗ
					ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
				ГДЕ
					ЕПСБУВидыСубконто.ВидСубконто В (&amp;ОграничениеПоСубконто)
					И ЕПСБУВидыСубконто.Ссылка = ПланСчетовЕПСБУ.Ссылка)
								
			// проверка по потомку 1 уровня		
