ПОМЕСТИТЬ КорректныеСчетаКт	
ИЗ
	РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
ГДЕ
	НЕ &amp;НеУстановленаКорреспонденкцияСчетовДт
	И &amp;ВыбиратьГруппы
	И КорректныеКорреспонденцииСчетов.СчетДт = &amp;КорреспонденцияДт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	КорректныеКорреспонденцииСчетов.СчетКт,
	КорректныеКорреспонденцииСчетов.СчетДт,
	КорректныеКорреспонденцииСчетов.СчетДт.Родитель КАК СчетДтРодитель1,
	КорректныеКорреспонденцииСчетов.СчетДт.Родитель.Родитель КАК СчетДтРодитель2,
	КорректныеКорреспонденцииСчетов.СчетДт.Родитель.Родитель.Родитель КАК СчетДтРодитель3
ПОМЕСТИТЬ КорректныеСчетаДт	
ИЗ
	РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
ГДЕ
	НЕ &amp;НеУстановленаКорреспонденкцияСчетовКт
	И &amp;ВыбиратьГруппы
	И КорректныеКорреспонденцииСчетов.СчетКт = &amp;КорреспонденцияКт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПланСчетовЕПСБУ.Ссылка,
	ПланСчетовЕПСБУ.ВерсияДанных,
	ПланСчетовЕПСБУ.ПометкаУдаления,
	ПланСчетовЕПСБУ.Предопределенный,
	ПланСчетовЕПСБУ.Родитель,
	ПланСчетовЕПСБУ.Код,
	ПланСчетовЕПСБУ.Наименование,
	ПланСчетовЕПСБУ.Порядок,
	ПланСчетовЕПСБУ.Вид,
	ПланСчетовЕПСБУ.Забалансовый,
	ПланСчетовЕПСБУ.ЗапретитьИспользоватьВПроводках,
	ПланСчетовЕПСБУ.НомерЖурнала,
	ПланСчетовЕПСБУ.КОСГУДт,
	ПланСчетовЕПСБУ.КОСГУКт,
	ПланСчетовЕПСБУ.ЭлементГруппа,
	ПланСчетовЕПСБУ.ДляКазенных,
	ПланСчетовЕПСБУ.ДляБюджетных,
	ПланСчетовЕПСБУ.ДляАвтономных,
	ПланСчетовЕПСБУ.ТипСчета,
	ПланСчетовЕПСБУ.Валютный,
	ПланСчетовЕПСБУ.Количественный,
	ПланСчетовЕПСБУ.УчетПоКПС,
	ПланСчетовЕПСБУ.УчетПоПодразделениям,
	ПланСчетовЕПСБУ.УчетПоКЭК,
	ПланСчетовЕПСБУ.ДатаНачалаДействия,
	ПланСчетовЕПСБУ.ДатаОкончанияДействия,
	ВЫБОР
		КОГДА ИспользоватьВалютныйУчет.Значение 
			ИЛИ ПланСчетовЕПСБУ.ЭлементГруппа 
			ИЛИ ПланСчетовЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
			ИЛИ ПланСчетовЕПСБУ.Предопределенный
			ТОГДА ИСТИНА
		ИНАЧЕ ВЫБОР
				КОГДА ПланСчетовЕПСБУ.Валютный
					ТОГДА ЛОЖЬ
				ИНАЧЕ ИСТИНА
			КОНЕЦ
	КОНЕЦ КАК СчетСоответствуетНастройкеВалютногоУчета
ИЗ
	ПланСчетов.ЕПСБУ КАК ПланСчетовЕПСБУ,
	Константа.ИспользоватьВалютныйУчет КАК ИспользоватьВалютныйУчет	
ГДЕ

    // использование корректных корреспонденций счетов - отбор по счету Дт
	(&amp;НеУстановленаКорреспонденкцияСчетовДт
	
			// кор. счет, если в корректных проводках указан переданный счет
			ИЛИ ИСТИНА В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ИСТИНА КАК Поле1
				ИЗ
					РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
				ГДЕ
					КорректныеКорреспонденцииСчетов.СчетКт = ПланСчетовЕПСБУ.Ссылка
					И КорректныеКорреспонденцииСчетов.СчетДт = &amp;КорреспонденцияДт)
					
			// кор. счет, если в корректных проводках указан родитель счета Дт
			ИЛИ ИСТИНА В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ИСТИНА КАК Поле1
				ИЗ
					РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
						ПО
							КорректныеКорреспонденцииСчетов.СчетДт = ЕПСБУ.Родитель
				ГДЕ
					КорректныеКорреспонденцииСчетов.СчетКт = ПланСчетовЕПСБУ.Ссылка
					И ЕПСБУ.Ссылка = &amp;КорреспонденцияДт)
					
			// потомок кор. счета, если в корректных проводках указан переданный счет
			ИЛИ ИСТИНА В
				(ВЫБРАТЬ ПЕРВЫЕ 1
					ИСТИНА КАК Поле1
				ИЗ
					РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов
				ГДЕ
					КорректныеКорреспонденцииСчетов.СчетКт = ПланСчетовЕПСБУ.Родитель
					И КорректныеКорреспонденцииСчетов.СчетДт = &amp;КорреспонденцияДт)
					
			// потомок кор. счета, если в корректных проводках указан родитель счета Дт
			ИЛИ ИСТИНА В
					(ВЫБРАТЬ ПЕРВЫЕ 1
						ИСТИНА КАК Поле1
					ИЗ
						РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
							ПО
								КорректныеКорреспонденцииСчетов.СчетДт = ЕПСБУ.Родитель
					ГДЕ
						КорректныеКорреспонденцииСчетов.СчетКт = ПланСчетовЕПСБУ.Родитель
						И ЕПСБУ.Ссылка = &amp;КорреспонденцияДт)
		
			ИЛИ (&amp;ВыбиратьГруппы И ИСТИНА В
					(ВЫБРАТЬ ПЕРВЫЕ 1
						ИСТИНА КАК Поле1
					ИЗ
						КорректныеСчетаКт КАК КорректныеКорреспонденцииСчетов
					ГДЕ
						КорректныеКорреспонденцииСчетов.СчетКтРодитель1 = ПланСчетовЕПСБУ.Ссылка
						ИЛИ КорректныеКорреспонденцииСчетов.СчетКтРодитель2 = ПланСчетовЕПСБУ.Ссылка
						ИЛИ КорректныеКорреспонденцииСчетов.СчетКтРодитель3 = ПланСчетовЕПСБУ.Ссылка))
		)
				
    // использование корректных корреспонденций счетов - отбор по счету Кт
