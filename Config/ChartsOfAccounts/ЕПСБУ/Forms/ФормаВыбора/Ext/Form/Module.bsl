
#Область ОбработчикиСобытийФормы

// Нестандартные параметры, используемые процедурой, указаны в начале модуля менеджера Плана счетов.ЕПСБУ
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем ОграниченияСписокСчетов;
	
	Если ЗначениеЗаполнено(Параметры.ОтборПоПараметруБланка) Тогда
		
		УстановленОтборПоПараметру = Истина;
		
		КодыСписок = Новый Массив;
		КодыПодобно = Новый Массив;
		
		Для Каждого КодОтбор Из Параметры.ОтборПоПараметруБланка Цикл
			ЗначениеОтбора = КодОтбор.Значение;
			ЗначениеОтбора = СтрЗаменить(КодОтбор.Значение,"*","_");//Символ * может использоваться как _ в конструкции ПОДОБНО.
			
			КодыСписок.Добавить(ЗначениеОтбора);
			
			Если Найти(ЗначениеОтбора, "_") > 0 ИЛИ
				Найти(ЗначениеОтбора, "%") > 0 ИЛИ
				Найти(ЗначениеОтбора, "[") > 0 Тогда
				КодыПодобно.Добавить(ЗначениеОтбора);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Код В(&СписокКодов)
		|	%ОтборПодобно%";
		
		ТекстОтборПодобно = "";
		СчОтборов = 1;
		Для Каждого ОтборПодобно Из КодыПодобно Цикл
			
			ТекстОтборПодобно = ТекстОтборПодобно + " ИЛИ ЕПСБУ.Код ПОДОБНО &ОтборПодобно"+СчОтборов;
			Запрос.УстановитьПараметр("ОтборПодобно"+СчОтборов, ОтборПодобно);
			
			СчОтборов = СчОтборов + 1;
		КонецЦикла;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборПодобно%", ТекстОтборПодобно);
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("СписокКодов", КодыСписок);
		
		СчетаПоИерархии = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		СписокСчетаПоИерархии = Новый СписокЗначений;
		СписокСчетаПоИерархии.ЗагрузитьЗначения(СчетаПоИерархии);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", СписокСчетаПоИерархии,
			ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии, "Отбор по параметру бланка", Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ, "ОтборПоПараметруБланка");
		
	Иначе
		УстановленОтборПоПараметру = Ложь;
	КонецЕсли;
	
	ЗаданоОграниченияСписокСчетов = Параметры.Свойство("ОграниченияСписокСчетов", ОграниченияСписокСчетов);
	
	Параметры.Свойство("ВыборГруппИЭлементов", ВыборГруппИЭлементов);
	
	// В реквизитах типовых операций мог быть установлен отбор на реквизиты счета.
	// Чтобы его не затереть необходимо проверить, что отбор не был установлен
	УстановленныеЭлементы = Новый Массив;
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры, , УстановленныеЭлементы);
	
	Если УстановленныеЭлементы.Найти(Новый ПолеКомпоновкиДанных("ЗапретитьИспользоватьВПроводках")) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ЗапретитьИспользоватьВПроводках", Ложь, , , НЕ Параметры.ВыбиратьЗапрещенныеВПроводках);
	КонецЕсли;
	
	Если УстановленныеЭлементы.Найти(Новый ПолеКомпоновкиДанных("Забалансовый")) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Забалансовый", Ложь, , , Параметры.НеВыбиратьЗабалансовые);
	КонецЕсли;
	
	Если УстановленныеЭлементы.Найти(Новый ПолеКомпоновкиДанных("ТипСчета")) = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ТипСчета", Параметры.ТипСчета, , , ЗначениеЗаполнено(Параметры.ТипСчета));
	КонецЕсли;
	
	Если Не Параметры.Свойство("НаДату", НаДату) И НЕ Параметры.Свойство("Дата", НаДату) Тогда
		НаДатуУстарел = Неопределено;
		Если Параметры.Свойство("НаДатуУстарел", НаДатуУстарел) Тогда
			Элементы.ГруппаОтбор.Видимость = Ложь;
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаОкончанияДействия", НаДатуУстарел, ВидСравненияКомпоновкиДанных.Меньше, "Устаревшие на дату", Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДатаОкончанияДействия",, ВидСравненияКомпоновкиДанных.Заполнено, "", Истина, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		Иначе
			НаДату = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	НаДатуИспользование = ЗначениеЗаполнено(НаДату);
	НаДатуОтбор = ?(ЗначениеЗаполнено(НаДату), НаДату, Неопределено);
	
	Если Параметры.Свойство("ОграниченияСчетаПоКЭК") Тогда
		
		ОрганизацияОтбор = ?(Параметры.Свойство("Организация"), Параметры.Организация, Неопределено);
		ИФООтбор = ?(Параметры.Свойство("ИФО"), Параметры.ИФО, Неопределено);
		
		// Счета по КЭК, доступные для выбора, поместим в структуру ОграниченияСписокСчетов.
		// Если счет выбирается по КЭК, то использование ОграниченияСписокСчетов не имеет смысла.
		ОграниченияСписокСчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			Параметры.ОграниченияСчетаПоКЭК.КЭК,
			Параметры.ОграниченияСчетаПоКЭК.ДопустимыеСчета,
			Истина,
			НаДатуОтбор,
			ОрганизацияОтбор,
			ИФООтбор);
		
		Если НЕ ЗначениеЗаполнено(ОграниченияСписокСчетов)
			ИЛИ ОграниченияСписокСчетов.Количество() = 0 Тогда // Показываем все счета, допустимые в документе.
			ОграниченияСписокСчетов = БухгалтерскийУчет.СписокСчетов(
				Параметры.ОграниченияСчетаПоКЭК.ДопустимыеСчета, НаДатуОтбор, , ОрганизацияОтбор);
		КонецЕсли;
		
		ЗаданоОграниченияСписокСчетов = Истина;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ОграниченияСчета) Тогда
		
		Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Параметры.ОграниченияСчета) И ОбщегоНазначения.ВидОбъектаПоСсылке(Параметры.ОграниченияСчета) = "ПланСчетов" Тогда
			ОтборСчет = Параметры.ОграниченияСчета;
			пВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
			пИспользование = ЗначениеЗаполнено(ОтборСчет);
		ИначеЕсли ТипЗнч(Параметры.ОграниченияСчета) = Тип("Строка") Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов(Параметры.ОграниченияСчета);
			ОтборСчет = Новый СписокЗначений;
			ОтборСчет.ЗагрузитьЗначения(СписокСчетов);
			пВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
			пИспользование = Истина;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", ОтборСчет, пВидСравнения, , пИспользование);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.КодТекущейСтроки) Тогда
		
		Если ОбщегоНазначения.ЗначениеСсылочногоТипа(Параметры.КодТекущейСтроки) И ОбщегоНазначения.ВидОбъектаПоСсылке(Параметры.КодТекущейСтроки) = "ПланСчетов" Тогда
			ОтборСчет = Параметры.КодТекущейСтроки;
		ИначеЕсли ТипЗнч(Параметры.КодТекущейСтроки) = Тип("Строка") Тогда
			ОтборСчет = БухгалтерскийУчет.СчетПоКоду(Параметры.КодТекущейСтроки, НаДатуОтбор);
		КонецЕсли;
		
		Элементы.Список.ТекущаяСтрока = ОтборСчет;
		
	КонецЕсли;
	
	Если ЗаданоОграниченияСписокСчетов Тогда
		ТипОграниченияСписка = ТипЗнч(ОграниченияСписокСчетов);
		ТипОграничения = Неопределено;
		Если ТипОграниченияСписка = Тип("СписокЗначений") Тогда
			СчетаДляОтбораМассив = ОграниченияСписокСчетов.ВыгрузитьЗначения();
		ИначеЕсли ТипОграниченияСписка = Тип("Массив") Тогда
			СчетаДляОтбораМассив = ОграниченияСписокСчетов;
		ИначеЕсли ТипОграниченияСписка = Тип("ФиксированныйМассив") Тогда
			СчетаДляОтбораМассив = Новый Массив(ОграниченияСписокСчетов);
		Иначе
			СчетаДляОтбораМассив = Новый Массив;
		КонецЕсли;
		Если СчетаДляОтбораМассив.Количество()>0 Тогда
			ТипОграничения = ТипЗнч(СчетаДляОтбораМассив[0]);
		КонецЕсли;
		Если ТипОграничения <> Неопределено Тогда
			ВСписке = (Параметры.Свойство("ВидСравненияВСписке") И Параметры.ВидСравненияВСписке = Истина);
			Если ВСписке Тогда
				Если ТипОграничения = Тип("Строка") Тогда
					СчетаДляОтбора = БухгалтерскийУчет.СписокСчетов(СчетаДляОтбораМассив,, Истина);
				Иначе
					СчетаДляОтбора = СчетаДляОтбораМассив;
				КонецЕсли;
			Иначе
				СчетаДляОтбора = БухгалтерскийУчет.СписокСчетов(СчетаДляОтбораМассив);
			КонецЕсли;
			
			СписокСчетаДляОтбора = Новый СписокЗначений;
			СписокСчетаДляОтбора.ЗагрузитьЗначения(СчетаДляОтбора);
			
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", СписокСчетаДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФормаРежимПросмотра", "Видимость", Ложь);
			
		КонецЕсли;
	КонецЕсли;
	
	Если Не Параметры.Свойство("КорреспонденцияДт", КорреспонденцияДт) Тогда
		Если Параметры.Свойство("КорреспонденцияДтКод") Тогда
			КорреспонденцияДт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияДтКод"], НаДатуОтбор);
		КонецЕсли;
	КонецЕсли;
	Если Не Параметры.Свойство("КорреспонденцияКт", КорреспонденцияКт) Тогда
		Если Параметры.Свойство("КорреспонденцияКтКод") Тогда
			КорреспонденцияКт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияКтКод"], НаДатуОтбор);
		КонецЕсли;
	КонецЕсли;
	
	ТекущаяПометка = ЗначениеЗаполнено(КорреспонденцияДт) ИЛИ ЗначениеЗаполнено(КорреспонденцияКт);
	Элементы.ФормаКорректныеСчета.Пометка = ТекущаяПометка;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КорреспонденцияДт", КорреспонденцияДт, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КорреспонденцияКт", КорреспонденцияКт, Истина);
	УстановитьПараметрыКорреспонденцииСчетов(ЭтаФорма, ТекущаяПометка);
	Элементы.ФормаКорректныеСчета.Видимость = ТекущаяПометка;
	
	Если Параметры.Свойство("ОграничениеПоСубконто") Тогда
		Если ТипЗнч(Параметры.ОграничениеПоСубконто) = Тип("Массив") Тогда
			ОграничениеПоСубконто.ЗагрузитьЗначения(Параметры.ОграничениеПоСубконто);
		ИначеЕсли ТипЗнч(Параметры.ОграничениеПоСубконто) = Тип("СписокЗначений") Тогда
			ОграничениеПоСубконто.ЗагрузитьЗначения(Параметры.ОграничениеПоСубконто.ВыгрузитьЗначения());
		Иначе
			ОграничениеПоСубконто.Добавить(Параметры.ОграничениеПоСубконто);
		КонецЕсли;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОграничениеПоСубконто", ОграничениеПоСубконто.ВыгрузитьЗначения(), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЗаданоОграничениеПоСубконто", ОграничениеПоСубконто.Количество() > 0, Истина);
	
	Если Параметры.Свойство("Организация") Тогда
		
		Организация = Параметры.Организация;
		ИФО			= Неопределено;
		
		Параметры.Свойство("ИФО", ИФО);
		
		СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация, ИФО, НаДату);
		
		Если ЗначениеЗаполнено(СтруктураРПС) Тогда
			ТипПланаСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС, "ТипПланаСчетов");
		Иначе
			ТипПланаСчетов = Неопределено;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипПланаСчетов) Тогда
			Если ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДляАвтономных", Истина, , , Истина);
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДляБюджетных", Истина, , , Истина);
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ДляКазенных", Истина, , , Истина);
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"), , , Истина);
			Элементы.ПредупреждениеУчетнаяПолитика.Видимость = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) И Параметры.ТекущаяСтрока.ЭлементГруппа  Тогда
		//это может быть вызов из формы бухгалтерской операции
		ВыбранаГруппа = Истина;
	КонецЕсли;
	
	Элементы.ДатаНачалаДействия.Видимость = НЕ НаДатуИспользование;
	Элементы.ДатаОкончанияДействия.Видимость = НЕ НаДатуИспользование;
	
	// Настройка видимости колонок свойств счетов (при необходимотси)
	Если Параметры.СкрытьКодИСвойства Тогда  
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДляКазенных", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДляБюджетных", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДляАвтономных", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТипСчета", "Видимость", Ложь);
		Элементы.Переместить(Элементы.Код, Элементы.Список); 
		Элементы.Список.ПутьКДаннымКартинкиСтроки = "";
	КонецЕсли;

	// Установка заголовка формы (при необходимотси)	
	Если ЗначениеЗаполнено(Параметры.ЗаголовокФормы) Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = Параметры.ЗаголовокФормы;
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(ВладелецФормы) = Тип("ПолеФормы") И НЕ Элементы.Список.ТекущаяСтрока = Неопределено И ВыбранаГруппа Тогда
		ВыбранаГруппа = Истина;
	Иначе
		ВыбранаГруппа = Ложь;
	КонецЕсли;
	
	Если УстановленОтборПоПараметру Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;
	
	БухгалтерскийУчетКлиент.УстановитьОтборСчетовНаДату(Список, НаДату, НаДатуИспользование);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	Если ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы Тогда
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Для Каждого ЗначениеМассива Из Значение Цикл
				СтандартнаяОбработка = БухгалтерскийУчетКлиент.СчетМожноИспользоватьВПроводках(ЗначениеМассива) И СтандартнаяОбработка;
			КонецЦикла;
		Иначе
			СтандартнаяОбработка = БухгалтерскийУчетКлиент.СчетМожноИспользоватьВПроводках(Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаДатуИспользованиеПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.УстановитьОтборСчетовНаДату(Список, НаДату, НаДатуИспользование);
	
	Элементы.ДатаНачалаДействия.Видимость = НЕ НаДатуИспользование;
	Элементы.ДатаОкончанияДействия.Видимость = НЕ НаДатуИспользование;
	
КонецПроцедуры

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	НаДатуИспользование = Истина;
	БухгалтерскийУчетКлиент.УстановитьОтборСчетовНаДату(Список, НаДату, НаДатуИспользование);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КорректныеСчета(Команда)
	
	ТекущаяПометка = Не Элементы.ФормаКорректныеСчета.Пометка;
	Элементы.ФормаКорректныеСчета.Пометка = ТекущаяПометка;
	УстановитьПараметрыКорреспонденцииСчетов(ЭтаФорма, ТекущаяПометка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыКорреспонденцииСчетов(Форма, Пометка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "ВыбиратьГруппы", Форма.ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.ГруппыИЭлементы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "НеУстановленаКорреспонденкцияСчетовДт",
		Не (Пометка И ЗначениеЗаполнено(Форма["КорреспонденцияДт"])), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "НеУстановленаКорреспонденкцияСчетовКт",
		Не (Пометка И ЗначениеЗаполнено(Форма["КорреспонденцияКт"])), Истина);
	
КонецПроцедуры

#КонецОбласти
