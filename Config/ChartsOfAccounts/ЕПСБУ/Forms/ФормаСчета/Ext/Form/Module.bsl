
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Объект.Родитель) Тогда
			
			Объект.Валютный 						= Объект.Родитель.Валютный;
			Объект.ТипСчета							= Объект.Родитель.ТипСчета;
			Объект.Вид 								= Объект.Родитель.Вид;
			Объект.Забалансовый						= Объект.Родитель.Забалансовый;
			Объект.ЗапретитьИспользоватьВПроводках	= Объект.Родитель.ЗапретитьИспользоватьВПроводках;
			Объект.УчетПоКПС						= Объект.Родитель.УчетПоКПС ИЛИ Объект.УчетПоКПС;
			Объект.УчетПоКЭК						= Объект.Родитель.УчетПоКЭК ИЛИ Объект.УчетПоКЭК;
			Объект.ДляКазенных						= Объект.Родитель.ДляКазенных;
			Объект.ДляБюджетных						= Объект.Родитель.ДляБюджетных;
			Объект.ДляАвтономных					= Объект.Родитель.ДляАвтономных;
			Объект.Количественный					= Объект.Родитель.Количественный;
			Объект.Валютный							= Объект.Родитель.Валютный;
			
		КонецЕсли;
		
		Элементы.ДатаНачалаДействия.Вид = ВидПоляФормы.ПолеВвода;
		Элементы.ДатаОкончанияДействия.Вид = ВидПоляФормы.ПолеВвода;
		
	КонецЕсли;
	
	Если Не Объект.Предопределенный Тогда
		Если Объект.Ссылка.Пустая() И Не Объект.Родитель.Пустая() Тогда
			ПроверитьГруппуУчетаПоПодразделениям();
		Иначе
			Группа = ?(Объект.Ссылка.Пустая(), "", ПланыСчетов.ЕПСБУ.ГруппаУчетаПоПодразделениям(Объект.Ссылка));
			Элементы.УчетПоПодразделениям.Доступность = Не ЗначениеЗаполнено(Группа);
		КонецЕсли;
	КонецЕсли;
	
	УправлениеФормой();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
	РамкаПоля = Новый Рамка(ТипРамкиЭлементаУправления.Одинарная, 1);
	Элементы.ДатаНачалаДействия.Вид			= ВидПоляФормы.ПолеНадписи;
	Элементы.ДатаНачалаДействия.Рамка		= РамкаПоля;
	Элементы.ДатаОкончанияДействия.Вид		= ВидПоляФормы.ПолеНадписи;
	Элементы.ДатаОкончанияДействия.Рамка	= РамкаПоля;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для Каждого ИзменяемыйСчет Из ИзменитьСчетаПриЗаписи Цикл
		УстановитьУчетПоПодразделениям(ИзменяемыйСчет.Значение, Объект.УчетПоПодразделениям);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипСчетаПриИзменении(Элемент)
	
	Если Объект.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
		Объект.УчетПоКЭК = Ложь; // На счетах налогового учета учет по КЭК не ведется.
	ИначеЕсли НЕ Объект.Забалансовый Тогда 
		Объект.УчетПоКЭК = Объект.УчетПоКПС;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗабалансовыйПриИзменении(Элемент)
	
	Если Объект.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
		Объект.УчетПоКЭК = Ложь; // На счетах налогового учета учет по КЭК не ведется.
	ИначеЕсли Не Объект.Забалансовый Тогда
		Объект.УчетПоКЭК = Объект.УчетПоКПС;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетПоКПСПриИзменении(Элемент)
	
	Если Объект.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
		Объект.УчетПоКЭК = Ложь; // На счетах налогового учета учет по КЭК не ведется.
	ИначеЕсли Не Объект.Забалансовый Тогда
		Объект.УчетПоКЭК = Объект.УчетПоКПС;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетПоКЭКПриИзменении(Элемент)
	
	Если Объект.ТипСчета = ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
		Объект.УчетПоКЭК = Ложь; // На счетах налогового учета учет по КЭК не ведется.
	ИначеЕсли Не Объект.Забалансовый Тогда
		Объект.УчетПоКПС = Объект.УчетПоКЭК;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура ВалютныйПриИзменении(Элемент)
	
	Если НЕ Объект.Валютный И ЗначениеЗаполнено(Объект.Ссылка) И ВалютныйУчетСчетаИзБазы(Объект.Ссылка) Тогда
		
		ТекстВопроса = НСтр("ru='При отключении признака ""Валютный"", при записи счета, во всех проводках с данным счетом
			|будут очищены валюта и валютная сумма. Отключить?'");
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отключить и очистить валюты и валютные суммы'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Вернуть признак ""Валютный""'"));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросВалютныйПриИзменении", ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, 60, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);
		
	Иначе
		
		УправлениеФормой();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВалютныйПриИзменении(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.Валютный = Истина;
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура КоличественныйПриИзменении(Элемент)
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетПоПодразделениямПриИзменении(Элемент)
	
	ОписаниеОтвета = Новый ОписаниеОповещения("ПослеВопросаИзмененияПодразделения", ЭтотОбъект);
	Если НЕ Объект.Ссылка.Пустая()
		И НЕ Объект.УчетПоПодразделениям
		И УчетПоПодразделениямСчетаИзБазы(Объект.Ссылка) Тогда
		
		ТекстВопроса = НСтр("ru = 'При отключении учета по подразделениям будет очищено подразделение в существующих проводках.
			|Отключить учет по подразделениям?'");
		ПоказатьВопрос(ОписаниеОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ОписаниеОтвета, КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаИзмененияПодразделения(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.УчетПоПодразделениям = Истина;
		Возврат;
	КонецЕсли;
	
	// Для счетов ОС проверим учет по подразделениям на соответствующих счетах учета амортизации и забалансового учета.
	ДополнительныеСчета = ПолучитьСоответствующиеСчетаОС(Объект.Ссылка, Объект.УчетПоПодразделениям);
	
	Если ДополнительныеСчета.Количество() > 0 Тогда
		
		Кнопки = Новый СписокЗначений();
		
		ТекстВопроса = НСтр("ru = 'Рекомендуется изменить учет по подразделениям на связанных счетах:
			|%1.
			|
			|Изменить признак учета по подразделениям на связанных счетах при записи элемента?'");
		ДополнительныеСчетаДляВопроса = Новый Массив;
		
		Если ДополнительныеСчета.Количество() > 1 Тогда
			Кнопки.Добавить("ДаДляВсех", НСтр("ru = 'Да, для всех'"));
		КонецЕсли;
		
		Если ДополнительныеСчета.Получить("СчетАмортизации") <> Неопределено тогда
			ДополнительныеСчетаДляВопроса.Добавить(НСтр("ru = 'счет амортизации'"));
			Кнопки.Добавить("ДаСчетАмортизации", НСтр("ru = 'Только счет амортизации'"));
		КонецЕсли;
		
		Если ДополнительныеСчета.Получить("ЗабалансовыйСчет") <> Неопределено тогда
			ДополнительныеСчетаДляВопроса.Добавить(НСтр("ru = 'забалансовый счет'"));
			Кнопки.Добавить("ДаЗабалансовыйСчет", "Только забалансовый счет");
		КонецЕсли;
		
		Кнопки.Добавить("Нет", НСтр("ru = 'Нет'"));
		ТекстВопроса = СтрШаблон(ТекстВопроса, СтрСоединить(ДополнительныеСчетаДляВопроса, Символы.ПС));
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросУчетПоПодразделениямПриИзменении", ЭтотОбъект, ДополнительныеСчета);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , Кнопки[0].Значение);
		
	Иначе
		УправлениеФормой();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросУчетПоПодразделениямПриИзменении(Ответ, ДополнительныеПараметры) Экспорт
	
	ДобавитьЗабалансовыйСчет = Истина;
	ДобавитьСчетАмортизации  = Истина;
	
	Если Ответ = "ДаДляВсех" Тогда
		ДобавитьЗабалансовыйСчет = Истина;
		ДобавитьСчетАмортизации  = Истина;
	ИначеЕсли Ответ = "ДаСчетАмортизации" Тогда
		ДобавитьЗабалансовыйСчет = Ложь;
		ДобавитьСчетАмортизации  = Истина;
	ИначеЕсли Ответ = "ДаЗабалансовыйСчет" Тогда
		ДобавитьЗабалансовыйСчет = Истина;
		ДобавитьСчетАмортизации  = Ложь;
	КонецЕсли;
	
	ИзменитьСчетаПриЗаписи.Очистить();
	Если ДобавитьЗабалансовыйСчет Тогда
		ИзменитьСчетаПриЗаписи.Добавить(ДополнительныеПараметры.Получить("ЗабалансовыйСчет"));
	КонецЕсли;
	Если ДобавитьСчетАмортизации Тогда
		ИзменитьСчетаПриЗаписи.Добавить(ДополнительныеПараметры.Получить("СчетАмортизации"));
	КонецЕсли;
	
	УправлениеФормой();
	
КонецПроцедуры

&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	
	Если Не Объект.Предопределенный Тогда
		ПроверитьГруппуУчетаПоПодразделениям();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда
		Объект.ДатаНачалаДействия = НачалоГода(Объект.ДатаНачалаДействия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияДействияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончанияДействия) Тогда
		Объект.ДатаОкончанияДействия = КонецГода(Объект.ДатаОкончанияДействия);
	КонецЕсли;
	
КонецПроцедуры


