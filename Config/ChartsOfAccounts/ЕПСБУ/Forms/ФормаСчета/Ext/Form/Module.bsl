КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды   

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	Если Объект.Предопределенный Тогда
		Модифицированность = Ложь;
		Возврат;
	КонецЕсли;
	
	ОбработкаПродолжения = Новый ОписаниеОповещения("Подключаемый_РазрешитьРедактированиеРеквизитовОбъектаПродолжение", ЭтотОбъект);
	ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект, ОбработкаПродолжения, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъектаПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Массив") И Не Объект.ЭлементГруппа Тогда 
		Если НЕ Результат.Найти("ДатаНачалаДействия") = Неопределено Тогда
			Элементы.ДатаНачалаДействия.Вид = ВидПоляФормы.ПолеВвода; 
		КонецЕсли;
		Если НЕ Результат.Найти("ДатаОкончанияДействия") = Неопределено Тогда
			Элементы.ДатаОкончанияДействия.Вид = ВидПоляФормы.ПолеВвода; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ВалютныйУчетСчетаИзБазы(Счет)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Валютный");
	
КонецФункции

&НаСервереБезКонтекста
Функция УчетПоПодразделениямСчетаИзБазы(Счет)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "УчетПоПодразделениям");
	
КонецФункции

&НаСервере
Процедура УправлениеФормой()
	
	Элементы.КОСГУДт.Видимость = Объект.УчетПоКЭК;
	Элементы.КОСГУКт.Видимость = Объект.УчетПоКЭК;
	
	Элементы.ВидыСубконтоВалютный.Видимость       = Объект.Валютный;
	Элементы.ВидыСубконтоКоличественный.Видимость = Объект.Количественный;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И Объект.УчетПоПодразделениям
		И Не Объект.ЭлементГруппа Тогда
		Элементы.РазрешитьНеУказыватьПодразделение.Видимость = Истина;
		Элементы.РазрешитьНеУказыватьПодразделение.Доступность = Истина;
	Иначе
		Элементы.РазрешитьНеУказыватьПодразделение.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ГруппаПериодДействия.Видимость = Не Объект.Предопределенный;
	
	Элементы.БезДетализацииКОСГУ.Видимость = Объект.БезДетализацииКОСГУ;
	
	Элементы.НомерЖурнала.Видимость = Не Объект.Забалансовый;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствующиеСчетаОС(Знач Счет, УчетПоПодразделениям)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет,
	|	ЕСТЬNULL(СчетаАмортизации.УчетПоПодразделениям, &УчетПоПодразделениям) КАК СчетАмортизацииУчетПоПодразделениям,
	|	ЕСТЬNULL(СчетаЗабалансовые.УчетПоПодразделениям, &УчетПоПодразделениям) КАК СчетЗабалансовыйУчетПоПодразделениям
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК СчетаЗабалансовые
	|		ПО СоответствиеСчетовОС.ЗабалансовыйСчет.Ссылка = СчетаЗабалансовые.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК СчетаАмортизации
	|		ПО СоответствиеСчетовОС.СчетАмортизации.Ссылка = СчетаАмортизации.Ссылка
	|ГДЕ
	|	СоответствиеСчетовОС.СчетОС.Ссылка = &СчетОС
	|	И (СчетаАмортизации.УчетПоПодразделениям <> &УчетПоПодразделениям
	|			ИЛИ СчетаЗабалансовые.УчетПоПодразделениям <> &УчетПоПодразделениям)";
	Запрос.УстановитьПараметр("СчетОС",Счет);
	Запрос.УстановитьПараметр("УчетПоПодразделениям",УчетПоПодразделениям);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СоответствиеСчетов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Выборка.СчетАмортизацииУчетПоПодразделениям <> УчетПоПодразделениям Тогда
			СоответствиеСчетов.Вставить("СчетАмортизации",Выборка.СчетАмортизации);
		КонецЕсли;
		Если Выборка.СчетЗабалансовыйУчетПоПодразделениям <> УчетПоПодразделениям Тогда
			СоответствиеСчетов.Вставить("ЗабалансовыйСчет",Выборка.ЗабалансовыйСчет);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СоответствиеСчетов;
	
КонецФункции

&НаСервере
Процедура УстановитьУчетПоПодразделениям(Счет, УчетПоПодразделениям)
	
	Если ТипЗнч(Счет) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		СчетОбъект = Счет.ПолучитьОбъект();
		СчетОбъект.УчетПоПодразделениям = УчетПоПодразделениям;
		Попытка
			СчетОбъект.Записать();
		Исключение
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru='Не удалось записать счет %1'"), Счет.Код));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьГруппуУчетаПоПодразделениям()
	
	Счет = ?(Не Объект.Родитель.Пустая(), Объект.Родитель, ?(Не Объект.Ссылка.Пустая(), Объект.Ссылка, Неопределено));  
	Группа = ?(ЗначениеЗаполнено(Счет), ПланыСчетов.ЕПСБУ.ГруппаУчетаПоПодразделениям(Счет), "");
	
	Элементы.УчетПоПодразделениям.Доступность = Не ЗначениеЗаполнено(Группа);
	
	Если ЗначениеЗаполнено(Группа) Тогда
		
		УчетПоПодразделениям = ПланыСчетов.ЕПСБУ.УчетПоПодразделениямГруппы(Группа);
		
		Если Объект.УчетПоПодразделениям <> УчетПоПодразделениям Тогда
			
			Объект.УчетПоПодразделениям = УчетПоПодразделениям;
			
			Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				Шаблон = Нстр("ru='Для данного счета и всех его подчиненных счетов будет %1 признак учета по подразделениям.'");
				Текст = СтрШаблон(Шаблон, ?(УчетПоПодразделениям,"установлен", "снят"));
				ОбщегоНазначения.СообщитьПользователю(Текст);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьНеУказыватьПодразделениеНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.РазрешитьНеУказыватьПодразделение Тогда
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Запретить проводки по счету %1 без указания подразделений?'"),
				Объект.Код);
	Иначе
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Разрешить проводки по счету %1 без указания подразделений?'"),
				Объект.Код);
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВопросРазрешитьНеУказыватьПодразделение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросРазрешитьНеУказыватьПодразделение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.РазрешитьНеУказыватьПодразделение = НЕ Объект.РазрешитьНеУказыватьПодразделение;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
