
#Область ОбработчикиСобытийФормы

// Нестандартные параметры, используемые процедурой, указаны в начале модуля менеджера Плана счетов. ЕПСБУ
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскийУчет.ПриСозданииНаСервереФормыВыбораРабочегоСчета(Отказ, ЭтотОбъект);
	
	ТипСчетаБухгалтерский = Перечисления.ТипыСчетов.Бухгалтерский;
	
	Если НЕ Параметры.Свойство("КорреспонденцияДт", КорреспонденцияДт) Тогда
		Если Параметры.Свойство("КорреспонденцияДтКод") Тогда
			КорреспонденцияДт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияДтКод"], НаДату);
		КонецЕсли;
	КонецЕсли;
	Если Не Параметры.Свойство("КорреспонденцияКт", КорреспонденцияКт) Тогда
		Если Параметры.Свойство("КорреспонденцияКтКод") Тогда
			КорреспонденцияКт = БухгалтерскийУчет.СчетПоКоду(Параметры["КорреспонденцияКтКод"], НаДату);
		КонецЕсли;
	КонецЕсли;
	ТекущаяПометка = ЗначениеЗаполнено(КорреспонденцияДт) ИЛИ ЗначениеЗаполнено(КорреспонденцияКт);
	Элементы.ЕПСБУКорректныеСчета.Пометка = ТекущаяПометка;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЕПСБУ, "КорреспонденцияДт", КорреспонденцияДт, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЕПСБУ, "КорреспонденцияКт", КорреспонденцияКт, Истина);
	УстановитьПараметрыКорреспонденцииСчетов(ЭтаФорма, ТекущаяПометка);
	Элементы.ЕПСБУКорректныеСчета.Видимость = ТекущаяПометка;
	
	Если Параметры.Свойство("ОграничениеПоСубконто") Тогда
		Если ТипЗнч(Параметры.ОграничениеПоСубконто) = Тип("Массив") Тогда
			ОграничениеПоСубконто.ЗагрузитьЗначения(Параметры.ОграничениеПоСубконто);
		ИначеЕсли ТипЗнч(Параметры.ОграничениеПоСубконто) = Тип("СписокЗначений") Тогда
			ОграничениеПоСубконто.ЗагрузитьЗначения(Параметры.ОграничениеПоСубконто.ВыгрузитьЗначения());
		Иначе
			ОграничениеПоСубконто.Добавить(Параметры.ОграничениеПоСубконто);
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЕПСБУ, "ОграничениеПоСубконто", ОграничениеПоСубконто, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ЕПСБУ, "ЗаданоОграничениеПоСубконто", ОграничениеПоСубконто.Количество() > 0, Истина);
	
	БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(Список, "КПС.ВидПоказателя", "КПС.УточнениеПоказателя");
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	БухгалтерскийУчетКлиент.УстановитьОтборСчетовНаДату(ЕПСБУ, НаДату, ЗначениеЗаполнено(НаДату));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	БухгалтерскийУчетКлиент.УстановитьОтборСчетовНаДату(ЕПСБУ, НаДату, ЗначениеЗаполнено(НаДату));
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", НаДату, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", Организация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Организация));
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ИФО", ИФО, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ИФО));
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(КФО) И Элемент.СписокВыбора.Количество() > 0 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КФО", Элемент.СписокВыбора.Скопировать(), ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "КФО", КФО, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(КФО));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЕПСБУ

&НаКлиенте
Процедура ЕПСБУПриАктивизацииСтроки(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Счет", Элемент.ТекущаяСтрока, ВидСравненияКомпоновкиДанных.Равно, "Счет", Истина, , "Счет");
КонецПроцедуры

&НаКлиенте
Процедура ЕПСБУВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные.ЭлементГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные.Забалансовый ИЛИ НЕ Элемент.ТекущиеДанные.ТипСчета = ТипСчетаБухгалтерский Тогда
		ОповеститьОВыборе(Новый Структура("Счет", Элемент.ТекущаяСтрока));
		Возврат;
	ИначеЕсли Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Элементы.Список.Обновить();
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ЭтаФорма.ТекущийЭлемент = Элементы.Список;
	
КонецПроцедуры

&НаКлиенте
Процедура ЕПСБУВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные.ЭлементГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные.Забалансовый ИЛИ НЕ Элемент.ТекущиеДанные.ТипСчета = ТипСчетаБухгалтерский Тогда
		ОповеститьОВыборе(Новый Структура("Счет", Элемент.ТекущаяСтрока));
		Возврат;
	ИначеЕсли Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыбореРабочегоСчета(Элементы.Список, Элементы.ЕПСБУ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОповеститьОВыбореРабочегоСчета(Элементы.Список, Элементы.ЕПСБУ);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;

	МассивЭлементов = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Список.Отбор, "Счет", "Счет");
	
	Если МассивЭлементов.Количество() = 1 Тогда
		
		СчетУстановленный = МассивЭлементов[0].ПравоеЗначение;
		
		Если БухгалтерскийУчетКлиент.СчетМожноИспользоватьВПроводках(СчетУстановленный) Тогда
			ПараметрыЗаполнения = Новый Структура("ЗначенияЗаполнения",
			Новый Структура("Организация, ИФО, КФО, Счет, Период", Организация, ИФО, КФО, СчетУстановленный, НаДату));
			ОткрытьФорму("РегистрСведений.РабочиеСчета.ФормаЗаписи", ПараметрыЗаполнения, Элемент);
		КонецЕсли;                                                      
		                                                                           
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КорректныеСчета(Команда)
	
	ТекущаяПометка = Не Элементы.ЕПСБУКорректныеСчета.Пометка;
	Элементы.ЕПСБУКорректныеСчета.Пометка = ТекущаяПометка;
	УстановитьПараметрыКорреспонденцииСчетов(ЭтаФорма, ТекущаяПометка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПараметрыКорреспонденцииСчетов(Форма, Пометка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(	Форма.ЕПСБУ,
																		"НеУстановленаКорреспонденкцияСчетовДт",
																		Не (Пометка
																			И ЗначениеЗаполнено(Форма["КорреспонденцияДт"])),
																		Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(	Форма.ЕПСБУ,
																		"НеУстановленаКорреспонденкцияСчетовКт",
																		Не (Пометка
																			И ЗначениеЗаполнено(Форма["КорреспонденцияКт"])),
																		Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьКОСГУПоУмолчанию(Знач ФормаОрганизация, Знач ФормаИФО, Знач ФормаКФО,Знач ФормаНадату, КЭКДт, КЭККт) 
	
	Если БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(ФормаОрганизация, ФормаИФО, ФормаКФО, ФормаНаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
		КЭКДт = БухгалтерскийУчетПовтИсп.КЭК0();
		КЭККт = БухгалтерскийУчетПовтИсп.КЭК0();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьОВыбореРабочегоСчета(ЭлементыСписок, ЭлементыЕПСБУ);
	
	ВыбранныеДанные = Новый Структура("КПС, КФО, Счет",
		ЭлементыСписок.ТекущиеДанные.КПС,
		ЭлементыСписок.ТекущиеДанные.КФО,
		ЭлементыСписок.ТекущиеДанные.Счет);
	
	Если Не ЭлементыЕПСБУ.ТекущиеДанные = Неопределено Тогда
		
		Если ЗначениеЗаполнено(ЭлементыЕПСБУ.ТекущиеДанные.КОСГУДт)
			И ЗначениеЗаполнено(ЭлементыЕПСБУ.ТекущиеДанные.КОСГУКт) Тогда
			
			КЭКДт = ЭлементыЕПСБУ.ТекущиеДанные.КОСГУДт;
			КЭККт = ЭлементыЕПСБУ.ТекущиеДанные.КОСГУКт;
			
			ПолучитьКОСГУПоУмолчанию(ЭлементыСписок.ТекущиеДанные.Организация,  ЭлементыСписок.ТекущиеДанные.ИФО, ЭлементыСписок.ТекущиеДанные.КФО, Надату, КЭКДт, КЭККт);
			
			ВыбранныеДанные.Вставить("КОСГУДт", КЭКДт);
			ВыбранныеДанные.Вставить("КОСГУКт", КЭККт);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОповеститьОВыборе(ВыбранныеДанные);
	
КонецПроцедуры

#КонецОбласти
