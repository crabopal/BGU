
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
	Если ТекущаяСтрока<>Неопределено Тогда
		ОтборВладелец = Элементы.Список.ТекущиеДанные.Ссылка;
		УстановитьОтбор(ОтборВладелец,ЗначениеЗаполнено(Элементы.Список.ТекущиеДанные.ВидДетализируемойБК),Истина);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ОтборВладелец = ТекущиеДанные.Ссылка;
		УстановитьОтбор(ОтборВладелец,ЗначениеЗаполнено(ТекущиеДанные.ВидДетализируемойБК));
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтбор(ОтборВладелец,ВидимостьКолонок,Использовать=Ложь)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СоставКлассификатора.Отбор, "Владелец", ОтборВладелец,,, ЗначениеЗаполнено(ОтборВладелец) ИЛИ Использовать);
    Элементы.СоставКлассификатораДетализируемыйКодБК.Видимость = ВидимостьКолонок;
	Элементы.СоставКлассификатораНаименованиеДетализируемогоБК.Видимость = ВидимостьКолонок;
КонецПроцедуры	
	
#КонецОбласти



