#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрочитатьДополнительныеКлассификаторы();
	
	СоздатьЭлементыФормы();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы,
	"ДобавитьКлассификатор",
	"Видимость",
	ПравоДоступа("Добавление", Метаданные.ПланыВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ПВХ_ВидыДополнительныхБюджетныхКлассификаторов_Запись" Тогда
		ОбновитьФормуИАктивизироватьЭлемент(Источник);
	КонецЕсли;	  
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ПерейтиКСодержимому(Элемент)
	
	ОткрытьСоставКлассификатора(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоставКлассификатора(Элемент)
	
	Идент = СтрЗаменить(Элемент.Имя, "Поле_", "");
	
	НайденныеКлассификаторы = Классификаторы.НайтиСтроки(Новый Структура("Идентификатор", Идент)); 
	
	Если НайденныеКлассификаторы.Количество() > 0 Тогда
		
		ПараметрыОткрытия = Новый Структура("Отбор", Новый Структура("Владелец", НайденныеКлассификаторы[0].Ссылка));
		
		ОткрытьФорму("Справочник.ЗначенияДополнительныхБюджетныхКлассификаторов.ФормаСписка", ПараметрыОткрытия, Элемент, Элемент.Имя);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьКлассификатор(Команда)
	
	ОткрытьФорму("ПланВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов.ФормаОбъекта",,,);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму(Команда)
	ОбновитьФормуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьСвойстваКлассификатора(Команда)
	
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Идент = СтрЗаменить(ТекущийЭлемент.Имя, "Поле_", "");
	
	НайденныеКлассификаторы = Классификаторы.НайтиСтроки(Новый Структура("Идентификатор", Идент)); 
	
	Если НайденныеКлассификаторы.Количество() > 0 Тогда
		
		ПараметрыОткрытия = Новый Структура("Ключ", НайденныеКлассификаторы[0].Ссылка);
		
		ОткрытьФорму("ПланВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов.ФормаОбъекта", ПараметрыОткрытия, ТекущийЭлемент, ТекущийЭлемент.Имя);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКлассификатор(Команда)
	
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьСоставКлассификатора(ТекущийЭлемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКлассификатор(Команда)
	
	Если ТекущийЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Идент = СтрЗаменить(ТекущийЭлемент.Имя, "Поле_", "");
	
	НайденныеКлассификаторы = Классификаторы.НайтиСтроки(Новый Структура("Идентификатор", Идент)); 
	
	Если НайденныеКлассификаторы.Количество() > 0 Тогда
		
		СсылкаКлассификатора = НайденныеКлассификаторы[0].Ссылка;
		ПредставлениеКлассификатора = НайденныеКлассификаторы[0].Представление;
		
		Если НайденныеКлассификаторы[0].ПометкаУдаления Тогда
			ТекстВопроса = НСтр("ru = 'Снять с ""%1"" пометку на удаление?'");
		Иначе
			ТекстВопроса = НСтр("ru = 'Пометить ""%1"" на удаление?'");
		КонецЕсли;
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ПредставлениеКлассификатора);
		
		Оповещение = Новый ОписаниеОповещения("ПометитьСнятьПометку", ЭтотОбъект, СсылкаКлассификатора);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьСнятьПометку(Ответ, СсылкаКлассификатора) Экспорт
	
	Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПометитьСнятьПометкуНаСервере(СсылкаКлассификатора);
	
	Оповестить("ПВХ_ВидыДополнительныхБюджетныхКлассификаторов_Запись",,СсылкаКлассификатора);
	
КонецПроцедуры	

&НаСервере
Процедура ПометитьСнятьПометкуНаСервере(СсылкаКлассификатора)
	
	КлассификаторОбъект = СсылкаКлассификатора.ПолучитьОбъект();
	
	КлассификаторОбъект.ПометкаУдаления = НЕ КлассификаторОбъект.ПометкаУдаления;
	
	РезультатЗапроса = Неопределено;
	
	Если КлассификаторОбъект.ПометкаУдаления Тогда
		// пометка удаления подчиненных элементов
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ЗначенияДополнительныхБюджетныхКлассификаторов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЗначенияДополнительныхБюджетныхКлассификаторов КАК ЗначенияДополнительныхБюджетныхКлассификаторов
		|ГДЕ
		|	НЕ ЗначенияДополнительныхБюджетныхКлассификаторов.ПометкаУдаления
		|	И ЗначенияДополнительныхБюджетныхКлассификаторов.Владелец = &Владелец");
		
		Запрос.УстановитьПараметр("Владелец", СсылкаКлассификатора);
		
		РезультатЗапроса = Запрос.Выполнить();
		
	КонецЕсли;
	
	НачатьТранзакцию();

	Попытка
		
		КлассификаторОбъект.Записать();
		
		Если ТипЗнч(РезультатЗапроса) = Тип("РезультатЗапроса") И НЕ РезультатЗапроса.Пустой() Тогда  
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.ЗначенияДополнительныхБюджетныхКлассификаторов");
			ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
			БлокировкаДанных.Заблокировать();
			
			Выборка = РезультатЗапроса.Выбрать();
			
			Пока Выборка.Следующий() Цикл 
				СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
				СпрОбъект.ПометкаУдаления = Истина;
				СпрОбъект.Записать();
			КонецЦикла;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ТекстОшибки = НСтр("ru = 'Не удалось записать ""%1"". Подробности см. в журнале регистрации.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СсылкаКлассификатора);
		
		//ПоказатьПредупреждение(Неопределено, ТекстОшибки); 
		
		ЗаписьЖурналаРегистрации("Запись", УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.ПланыВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов,
		СсылкаКлассификатора, 
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры	

&НаСервере
Процедура ПрочитатьДополнительныеКлассификаторы()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыДополнительныхБюджетныхКлассификаторов.Ссылка КАК Ссылка,
	|	ВидыДополнительныхБюджетныхКлассификаторов.Код КАК Код,
	|	ВидыДополнительныхБюджетныхКлассификаторов.Представление КАК Представление,
	|	ВидыДополнительныхБюджетныхКлассификаторов.ВидДетализируемойБК КАК ВидДетализируемойБК,
	|	ВидыДополнительныхБюджетныхКлассификаторов.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ
	|	ПланВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов КАК ВидыДополнительныхБюджетныхКлассификаторов
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	Классификаторы.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура СоздатьЭлементыФормы()
	
	Для Каждого Классификатор ИЗ Классификаторы Цикл
		
		Идент = СтрЗаменить(Классификатор.Ссылка.УникальныйИдентификатор(), "-", "x");
		
		Классификатор.Идентификатор = Идент;
		
		ЭлементГруппа = Элементы.Добавить("Группа_" + Идент, Тип("ГруппаФормы"), Элементы.Колонка1);
		ЭлементГруппа.Вид 						= ВидГруппыФормы.ОбычнаяГруппа;
		ЭлементГруппа.РастягиватьПоГоризонтали 	= Истина;
		ЭлементГруппа.Отображение 				= ОтображениеОбычнойГруппы.ОбычноеВыделение;
		ЭлементГруппа.ОтображатьЗаголовок 		= Ложь;
		ЭлементГруппа.Группировка 				= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		
		ПолеКартинки = Элементы.Добавить("Картинка_" + Идент, Тип("ДекорацияФормы"), ЭлементГруппа);
		ПолеКартинки.Вид 		= ВидДекорацииФормы.Картинка;
		
		ПолеКлассификатора = Элементы.Добавить("Поле_" + Идент, Тип("ДекорацияФормы"), ЭлементГруппа);
		ПолеКлассификатора.Заголовок 	= Классификатор.Представление + 
		?(ЗначениеЗаполнено(Классификатор.ВидДетализируемойБК), "; детализация " + Классификатор.ВидДетализируемойБК, ""); 
		ПолеКлассификатора.Вид 			= ВидДекорацииФормы.Надпись;
		ПолеКлассификатора.Гиперссылка 	= Истина;
		ПолеКлассификатора.УстановитьДействие("Нажатие", "Подключаемый_ПерейтиКСодержимому");
		
		Если Классификатор.ПометкаУдаления Тогда
			ПолеКартинки.Картинка 		= БиблиотекаКартинок.ПометитьНаУдаление;
			ПолеКлассификатора.Шрифт 	= Новый Шрифт(,,,, Ложь, Истина);
		Иначе
			ПолеКартинки.Картинка 		= БиблиотекаКартинок.КартинкаОткрыть;
		КонецЕсли;	
		
		КомандаИзменить = Элементы.Добавить("Изменить_" + Идент, Тип("КнопкаФормы"), ПолеКлассификатора.КонтекстноеМеню);
		КомандаИзменить.Заголовок = "Изменить свойства";
		КомандаИзменить.ИмяКоманды = "ИзменитьСвойстваКлассификатора";
		
		Если ПравоДоступа("ИнтерактивнаяПометкаУдаления", Метаданные.ПланыВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов) Тогда
			КомандаИзменить = Элементы.Добавить("Удалить_" + Идент, Тип("КнопкаФормы"), ПолеКлассификатора.КонтекстноеМеню);
			КомандаИзменить.Заголовок = "Пометить на удаление / снять пометку";
			КомандаИзменить.ИмяКоманды = "УдалитьКлассификатор";
		КонецЕсли;
		
		КомандаОткрыть = Элементы.Добавить("Открыть_" + Идент, Тип("КнопкаФормы"), ПолеКлассификатора.КонтекстноеМеню);
		КомандаОткрыть.Заголовок = "Открыть классификатор";
		КомандаОткрыть.ИмяКоманды = "ОткрытьКлассификатор";
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЭлементыФормы()
	
	Для Каждого Классификатор ИЗ Классификаторы Цикл
		
		Если НЕ ЗначениеЗаполнено(Классификатор.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;	
		
		ЭлементГруппа = Элементы.Найти("Группа_" + Классификатор.Идентификатор);
		Если НЕ ЭлементГруппа = Неопределено Тогда 
			Элементы.Удалить(ЭлементГруппа);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуИАктивизироватьЭлемент(Источник)
	
	УдалитьЭлементыФормы();
	ПрочитатьДополнительныеКлассификаторы();
	СоздатьЭлементыФормы();
	
	НайденныеКлассификаторы = Классификаторы.НайтиСтроки(Новый Структура("Ссылка", Источник)); 
	
	Если НайденныеКлассификаторы.Количество() > 0 Тогда
		Поле = Элементы.Найти("Поле_" + НайденныеКлассификаторы[0].Идентификатор);
		Если НЕ Поле = Неопределено Тогда
			ТекущийЭлемент = Поле;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьФормуНаСервере()
	УдалитьЭлементыФормы();
	ПрочитатьДополнительныеКлассификаторы();
	СоздатьЭлементыФормы();
КонецПроцедуры

#КонецОбласти

