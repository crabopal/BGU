#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ЗначенияДополнительныхБюджетныхКлассификаторовУстановитьНаименования(ВидКлассификатораСсылка,НовыйКод="") Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ВидКлассификатора",    ВидКлассификатораСсылка);
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ХарактеристикиДополнительнойБюджетнойКлассификации.ДополнительнаяБюджетнаяКлассификация.Ссылка КАК ДопКлассификация
	|ИЗ
	|	РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации КАК ХарактеристикиДополнительнойБюджетнойКлассификации
	|ГДЕ
	|	ХарактеристикиДополнительнойБюджетнойКлассификации.ВидДопКлассификатора.Ссылка = &ВидКлассификатора
	|
	|ДЛЯ ИЗМЕНЕНИЯ
	|";	
	
	Попытка
		НачатьТранзакцию();
		
		СтруктураПараметров = Новый Структура(
			"ТипТаблицы, ИмяТаблицы",
			"РегистрСведений", "ХарактеристикиДополнительнойБюджетнойКлассификации");
		ЗначенияБлокировки = Новый Соответствие;
		ЗначенияБлокировки.Вставить("ВидДопКлассификатора", ВидКлассификатораСсылка);
		ОбщегоНазначенияБГУ.УстановитьУправляемуюБлокировку(СтруктураПараметров, ЗначенияБлокировки);
		
		СписокЭлементов = Запрос.Выполнить().Выбрать();
		ОбработкаОбъектЗначенияХарактеристик = Обработки.ЗначенияХарактеристикДопБюджетнойКлассификации.Создать();
		Пока  СписокЭлементов.Следующий() Цикл
			
			ОбъектОтбора 		= СписокЭлементов.ДопКлассификация;
			ОбъектДляИзменения 	= ОбъектОтбора.ПолучитьОбъект();
			
			ОбработкаОбъектЗначенияХарактеристик.ОбъектОтбораЗначений = ОбъектОтбора;
            ОбработкаОбъектЗначенияХарактеристик.ПрочитатьЗаполнитьХарактеристикиИЗначения();
			Если  ПустаяСтрока(НовыйКод) Тогда
				ОбъектДляИзменения.Наименование = ОбработкаОбъектЗначенияХарактеристик.СформироватьНаименование();
			Иначе
				ОбъектДляИзменения.Наименование = ОбработкаОбъектЗначенияХарактеристик.СформироватьНаименование(ВидКлассификатораСсылка,НовыйКод);
			КонецЕсли;
            ОбъектДляИзменения.Записать();
			
		КонецЦикла;	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Возврат Истина;
	КонецПопытки;	

	Возврат Ложь;
 	
КонецФункции

#КонецОбласти

#КонецЕсли

