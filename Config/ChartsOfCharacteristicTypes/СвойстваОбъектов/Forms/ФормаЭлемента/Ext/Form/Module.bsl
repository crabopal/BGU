////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Функция НайтиЗначенияСвойств(Ссылка, УчитыватьНаборСвойств) Экспорт
	
	Если Ссылка.Пустая() Тогда
		Возврат Ложь; 
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияСвойствОбъектов.Свойство
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой(); 
	
КонецФункции // ПроверитьВозможностьИзменения()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СписокВыбораТипа = Элементы.ТипЗначенийСписок.СписокВыбора;
	
	НачалоСписка 	= Новый СписокЗначений(); 
	КонецСписка 	= Новый СписокЗначений(); 
	
	МетаданныеТип = Объект.Ссылка.Метаданные().Тип;
	
	КвЧисла  = Новый КвалификаторыЧисла(МетаданныеТип.КвалификаторыЧисла.Разрядность,
	МетаданныеТип.КвалификаторыЧисла.РазрядностьДробнойЧасти, 
	МетаданныеТип.КвалификаторыЧисла.ДопустимыйЗнак);
	
	КвСтроки = Новый КвалификаторыСтроки(МетаданныеТип.КвалификаторыСтроки.Длина, 
	МетаданныеТип.КвалификаторыСтроки.ДопустимаяДлина);
	
	КвДаты   = Новый КвалификаторыДаты(МетаданныеТип.КвалификаторыДаты.ЧастиДаты);
	
	Для Каждого Тип Из МетаданныеТип.Типы() Цикл
		
		Типы = Новый Массив;
		Типы.Добавить(Тип);
		
		Если    Тип = Тип("Число")
			или Тип = Тип("Строка")
			или Тип = Тип("Дата") 
			или Тип = Тип("Булево") 
			Тогда
			
			ОписаниеТекущегоТипа      = Новый ОписаниеТипов(Типы, КвЧисла, КвСтроки, КвДаты);
			ПредставлениеТекущегоТипа = ""+Тип; 
			НачалоСписка.Добавить(ОписаниеТекущегоТипа, ПредставлениеТекущегоТипа);
			
		ИначеЕсли Тип = Тип("СправочникСсылка.ЗначенияСвойств") Тогда	
			
			ОписаниеТекущегоТипа      = Новый ОписаниеТипов(Типы);
			
			ПредставлениеТекущегоТипа = "Набор значений свойств"; 
			НачалоСписка.Добавить(ОписаниеТекущегоТипа, ПредставлениеТекущегоТипа);
			
		Иначе
			
			ОписаниеТекущегоТипа      = Новый ОписаниеТипов(Типы);
			
			ПредставлениеТекущегоТипа = СтрЗаменить(""+Тип, " ссылка", ""); 
			КонецСписка.Добавить(ОписаниеТекущегоТипа, ПредставлениеТекущегоТипа);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для Каждого ОписаниеТекущегоТипа Из НачалоСписка Цикл
		СписокВыбораТипа.Добавить(ОписаниеТекущегоТипа.Значение, ОписаниеТекущегоТипа.Представление);
	КонецЦикла; 
	
	Для Каждого ОписаниеТекущегоТипа Из КонецСписка Цикл
		СписокВыбораТипа.Добавить(ОписаниеТекущегоТипа.Значение, ОписаниеТекущегоТипа.Представление);
	КонецЦикла; 
	
	
	Если Параметры.Ключ.Пустая() 
		//И Не ЭтоГруппа  
		И Параметры.ЗначениеКопирования = Неопределено Тогда
		
		Объект.Фиксированное = Истина; 
		Объект.ТипЗначения = СписокВыбораТипа.НайтиПоЗначению(Новый ОписаниеТипов("Строка", КвЧисла, КвСтроки, КвДаты)).Значение;
		
	КонецЕсли; 
	
	Для Каждого Элемент Из Элементы.ТипЗначенийСписок.СписокВыбора Цикл
		
		Если Строка(Объект.ТипЗначения) = Строка(Элемент.Значение) Тогда
			ТипЗначенийСписок = Элемент.Значение;
			Продолжить;
		КонецЕсли; 
		
	КонецЦикла;  
	
	//Автозаголовок = Ложь;
	//СформироватьЗаголовок();
	
	Если Не Параметры.Ключ.Пустая()
		И НайтиЗначенияСвойств(Объект.Ссылка, Истина) Тогда
		
		Элементы.ТипЗначенийСписок.ТолькоПросмотр = Истина;
		Элементы.УточнениеТипа.ТолькоПросмотр = Истина;
		
	КонецЕсли; 
	
	Элементы.УточнениеТипа.ТолькоПросмотр = Истина;
	
	// Заполнение списка назначений
	
	// 1. Считаем уже установленные назначения
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НазначенияСвойствОбъектов.НазначениеСвойства,
	|	НазначенияСвойствОбъектов.УточнениеНазначения
	|ИЗ
	|	РегистрСведений.НазначенияСвойствОбъектов КАК НазначенияСвойствОбъектов
	|ГДЕ
	|	НазначенияСвойствОбъектов.Свойство = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	
	УстановленныеНазначения = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ЭлементПеречисления Из Перечисления.НазначенияСвойств Цикл
		Если ЭлементПеречисления <> Перечисления.НазначенияСвойств.Субконто Тогда
			СтрокаТаблицы = ТаблицаНазначений.Добавить();
			СтрокаТаблицы.НазначениеСвойства = ЭлементПеречисления;
			Если УстановленныеНазначения.Найти(ЭлементПеречисления,"НазначениеСвойства") <> Неопределено Тогда
				СтрокаТаблицы.Пометка = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаОтчетов.Ссылка,
	|	АналитикаОтчетов.ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
	|ГДЕ
	|	АналитикаОтчетов.ЭтоГруппа = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.ТипЗначения.Типы()[0] = Тип("СправочникСсылка.Субконто") Тогда
			СтрокаТаблицы = ТаблицаНазначений.Добавить();
			СтрокаТаблицы.НазначениеСвойства = Выборка.Ссылка;
			Если УстановленныеНазначения.Найти(Выборка.Ссылка,"УточнениеНазначения") <> Неопределено Тогда
				СтрокаТаблицы.Пометка = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Объект.Ссылка <> ПланыВидовХарактеристик.СвойстваОбъектов.ПубличныйИдентификатор Тогда		
		ЭтаФорма.ТолькоПросмотр = Объект.Предопределенный;
		Элементы.ТипЗначенийСписок.ТолькоПросмотр = Объект.Предопределенный;
		Элементы.ТаблицаНазначений.ТолькоПросмотр = Объект.Предопределенный;
	КонецЕсли;
    Если Объект.ТипЗначения.Типы()[0] = Тип("СправочникСсылка.Субконто") Тогда
		Элементы.УточнениеТипа.ТолькоПросмотр            = Элементы.ТипЗначенийСписок.ТолькоПросмотр;    
		Элементы.УточнениеТипа.АвтоОтметкаНезаполненного = Истина;    
	Иначе
		Элементы.УточнениеТипа.АвтоОтметкаНезаполненного = Ложь;    
		Элементы.УточнениеТипа.ОтметкаНезаполненного     = Ложь;    
		Элементы.УточнениеТипа.ТолькоПросмотр            = Истина;    
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	НаборНазначений = РегистрыСведений.НазначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборНазначений.Отбор.Свойство.Установить(Объект.Ссылка);
	НаборНазначений.Прочитать();
	НаборНазначений.Очистить();
	
	Для Каждого СтрНазначений Из ТаблицаНазначений Цикл
		
		Если СтрНазначений.Пометка Тогда
			
			Запись = НаборНазначений.Добавить();
			Запись.Свойство = Объект.Ссылка;
			Если ТипЗнч(СтрНазначений.НазначениеСвойства) = Тип("ПеречислениеСсылка.НазначенияСвойств") Тогда
				Запись.НазначениеСвойства = СтрНазначений.НазначениеСвойства;
			Иначе
				
				Запись.НазначениеСвойства  = Перечисления.НазначенияСвойств.Субконто;
				Запись.УточнениеНазначения = СтрНазначений.НазначениеСвойства;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	НаборНазначений.Записать();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ


&НаСервереБезКонтекста
Функция СтрокаМожетИспользоватьсяВКачествеКода(Знач Текст)

	Возврат БюджетнаяОтчетность.СтрокаМожетИспользоватьсяВКачествеКода(Текст);

КонецФункции // СтрокаМожетИспользоватьсяВКачествеКода()


&НаКлиенте
Процедура ТипЗначенийСписокПриИзменении(Элемент)
	
	Объект.ТипЗначения = ТипЗначенийСписок;
	
	Если Не Объект.ТипЗначения.Типы()[0] = Тип("СправочникСсылка.Субконто") 
		и ЗначениеЗаполнено(Объект.УточнениеТипа) Тогда
		
		Объект.УточнениеТипа = "";
		
	КонецЕсли; 
	
	Если Объект.ТипЗначения.Типы()[0] = Тип("СправочникСсылка.Субконто") Тогда
		Элементы.УточнениеТипа.ТолькоПросмотр            = Элементы.ТипЗначенийСписок.ТолькоПросмотр;    
		Элементы.УточнениеТипа.АвтоОтметкаНезаполненного = Истина;    
	Иначе
		Элементы.УточнениеТипа.АвтоОтметкаНезаполненного = Ложь;    
		Элементы.УточнениеТипа.ОтметкаНезаполненного     = Ложь;    
		Элементы.УточнениеТипа.ТолькоПросмотр            = Истина;    
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура КодОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ СтрокаМожетИспользоватьсяВКачествеКода(Текст) Тогда
		ПоказатьПредупреждение(,Нстр("ru='Неверно задан код!'"));
		СтандартнаяОбработка = Ложь;
		Возврат;		
	КонецЕсли;
	
	Объект.Код = Текст;
	
	Если ПустаяСтрока(Объект.Наименование) Тогда
		Объект.Наименование = БюджетнаяОтчетностьКлиентСервер.Синоним(Текст);
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СоставНабораЗначенийНажатие(Команда)
	
	Если Не Объект.ТипЗначения.Типы()[0] = Тип("СправочникСсылка.ЗначенияСвойств") Тогда
		ТекстПредупреждения = НСтр("ru = 'Настройка значений возможна только для свойств с типом значения <Набор значений свойств>!'");
		ПоказатьПредупреждение(,ТекстПредупреждения); 
		Возврат; 
	КонецЕсли; 
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Владелец",Объект.Ссылка));
		ОткрытьФорму("Справочник.ЗначенияСвойств.ФормаВыбора",ПараметрыФормы,ЭтаФорма,ЭтаФорма);
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","СоставНабораЗначенийНажатие");	
	
	ДополнительныеПараметры.Вставить("Владелец",Объект.Ссылка);
	
	ТекстВопроса = НСтр("ru = 'Элемент справочника не записан. Записать?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );

	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "СоставНабораЗначенийНажатие" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			УспехЗаписи = Записать();
			
			Если УспехЗаписи = Ложь Тогда 
				Возврат;
			КонецЕсли;
			
			ПараметрыФормы = Новый Структура("Отбор",Новый Структура("Владелец",ДополнительныеПараметры.Владелец));
			ОткрытьФорму("Справочник.ЗначенияСвойств.ФормаВыбора",ПараметрыФормы,ЭтаФорма,ЭтаФорма);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры




