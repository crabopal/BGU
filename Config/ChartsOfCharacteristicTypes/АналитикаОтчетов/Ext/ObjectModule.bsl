Процедура ПередЗаписью(Отказ)
	
	Если ЭтоГруппа = ЛОЖЬ Тогда
		ЭтоСубконто = ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто"));
	КонецЕсли;
	
	Если ОбменДанными.Загрузка или БюджетнаяОтчетность.ЗагрузкаКомплектаОтчетности(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ БюджетнаяОтчетность.СтрокаМожетИспользоватьсяВКачествеКода(Код) Тогда
		ОбщегоНазначения.СообщитьПользователю(Нстр("ru='Код показателя задан неверно!'"),,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры


