
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если БюджетнаяОтчетностьКлиентСервер.КонфигурацияЯвляетсяПодчиненной() Тогда 
		ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	УправлениеЭлементами();
	
	Если Объект.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто"))
		И НЕ ЗначениеЗаполнено(Объект.СписокЗначений) Тогда
		
	    Элементы.ГруппаДетализацияЗначений.Видимость = Истина;
		
		Если ЗначениеЗаполнено(Объект.АналитикаВладелецКод)
			И ЗначениеЗаполнено(Объект.АналитикаВладелецПубличныйИдентификатор) Тогда
			
			ДетализируемыйВидАналитики = БюджетнаяОтчетностьСервер.ПолучитьДетализируемыйКлассификаторПоКоду(Объект.АналитикаВладелецКод,Объект.АналитикаВладелецПубличныйИдентификатор);
			
			Если ЗначениеЗаполнено(ДетализируемыйВидАналитики) Тогда
				Элементы.ДекорацияПредупреждение.Видимость = Ложь;
			Иначе
				ТекстПредупреждения = Нстр("ru='Детализируемый классификатор с кодом ""%1"" и идентификатором ""%2"" отсутствует в ИБ.'");
				ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПредупреждения,Объект.АналитикаВладелецКод,Объект.АналитикаВладелецПубличныйИдентификатор);
				Элементы.ДекорацияПредупреждение.Заголовок = ТекстПредупреждения;
				Элементы.ДекорацияПредупреждение.Видимость = Истина;
				
			КонецЕсли;
		Иначе
			Элементы.ДекорацияПредупреждение.Видимость = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ГруппаДетализацияЗначений.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)
	
	УправлениеЭлементами();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УправлениеЭлементами()
	
	ЭтоСубконто = ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Объект.ТипЗначения, Тип("СправочникСсылка.Субконто"));
	ИспользуетсяСписок = ЗначениеЗаполнено(Объект.СписокЗначений);
	
	Элементы.СписокЗначений.Видимость = ЭтоСубконто;
	
	Если Объект.ТипЗначения.Типы()[0] <> Тип("Строка") Тогда
		ЭтаФорма.Объект.ВидКлассификатораБК = "";
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПубличныйИдентификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить("urn:entities-1c-ru:budget/");
	ДанныеВыбора.Добавить("urn:entities-1c-ru:budget/"+СокрП(Объект.Код));
	
КонецПроцедуры
