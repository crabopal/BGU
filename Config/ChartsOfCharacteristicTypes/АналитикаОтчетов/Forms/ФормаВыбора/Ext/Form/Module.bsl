
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ДопРеквизиты = Истина Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ДополнительныеРеквизитыОтчетов.ВидАналитики КАК Ссылка
			|ИЗ
			|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		МассивАналитик = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", МассивАналитик,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
	
	КонецЕсли;
	
	Если БюджетнаяОтчетностьКлиентСервер.КонфигурацияЯвляетсяПодчиненной() Тогда 
		Элементы.Список.ИзменятьСоставСтрок = Ложь;
	Иначе 
		Элементы.Список.ИзменятьСоставСтрок = Истина;
	КонецЕсли;
	
КонецПроцедуры

