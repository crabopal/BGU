#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ИнициализироватьПредопределенныеЭлементыПВХ");
КонецПроцедуры

#КонецОбласти

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("ТипЗначения");
	
	Возврат Результат;
	
КонецФункции

Процедура ИнициализироватьПредопределенныеЭлементыПВХ() Экспорт

	МакетПредопределенных = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьМакет("ПредопределенныеДанные");
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(МакетПредопределенных.ПолучитьТекст());
	
	Пока Чтение.Прочитать() Цикл
		
		Если НЕ (Чтение.ЛокальноеИмя = "РеквизитОперации" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			Продолжить;
		КонецЕсли;

		Ссылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Чтение.ПолучитьАтрибут("УИД")));
			
		Если НЕ ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			Элемент = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.СоздатьЭлемент();
			Элемент.УстановитьСсылкуНового(Ссылка);
			Элемент.Наименование = Чтение.ПолучитьАтрибут("Наименование");
			Элемент.ИмяПредопределенныхДанных = Чтение.ПолучитьАтрибут("ИмяПредопределенного");
			
			Чтение.Прочитать();
			Элемент.ТипЗначения = ПрочитатьXML(Чтение, Тип("ОписаниеТипов"));
			
			Элемент.Записать();
			
		Иначе
			
			ОбъектПВХ = Ссылка.ПолучитьОбъект();
			Чтение.Прочитать();
			ОписаниеТиповИзФайла = ПрочитатьXML(Чтение, Тип("ОписаниеТипов"));
			Если Не ОписанияТиповИдентичны(ОбъектПВХ.ТипЗначения, ОписаниеТиповИзФайла) Тогда
				ОбъектПВХ.ТипЗначения = ОписаниеТиповИзФайла;
				ОбъектПВХ.Записать();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий
//Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписанияТиповИдентичны(ОписаниеТипов1, ОписаниеТипов2)

	МассивТипов1 = ОписаниеТипов1.Типы();
	МассивТипов2 = ОписаниеТипов2.Типы();
	
	Если МассивТипов1.Количество() <> МассивТипов2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для каждого ЗначениеМассива1 Из МассивТипов1 Цикл
	
		Если МассивТипов2.Найти(ЗначениеМассива1) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Истина;

КонецФункции // ОписанияТиповИдентичны()
 

#КонецОбласти

#КонецЕсли