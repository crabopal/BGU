////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ПроверитьНаОбъектыИмеютсяСсылкиВИБ(Параметры.Ссылка) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаНайденыСсылки;
		Элементы.РазрешитьРедактирование.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаСсылокНеНайдено;
		Элементы.ОК.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)
	
	Результат = Новый Массив;
	Результат.Добавить("ТипЗначения");
	Закрыть(Результат);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПроверитьНаОбъектыИмеютсяСсылкиВИБ(Ссылка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	               |ГДЕ
	               |	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК ЗначенияКолонокДополнительныхТабличныхЧастей
	               |ГДЕ
	               |	ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ОписаниеТипаКолонки = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат НЕ Запрос.Выполнить().Пустой();
КонецФункции
