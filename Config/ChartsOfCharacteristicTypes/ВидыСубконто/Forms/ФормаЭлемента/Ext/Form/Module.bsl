
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	УстановитьДоступностьВидСубконтоАналитики(Ложь); 
	
КонецПроцедуры  

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)
	УстановитьДоступностьВидСубконтоАналитики(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВидСубконтоАналитикиПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.ВидСубконтоАналитики) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ МожноИспользоватьВыбранныйВидАналитики(Объект.ВидСубконтоАналитики) Тогда
		ПоказатьПредупреждение(,НСтр("ru='Необходимо выбрать вид аналитики с типом значения ""Субконто""'"));
		Объект.ВидСубконтоАналитики = Неопределено;
		Возврат;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти  

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды     

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДоступностьВидСубконтоАналитики(Очищать)
	
	Если Объект.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ВидСубконтоАналитики","ТолькоПросмотр",Ложь);
	Иначе
		Если ЗначениеЗаполнено(Объект.ВидСубконтоАналитики)
			И Очищать = Истина Тогда
			Объект.ВидСубконтоАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ВидСубконтоАналитики","ТолькоПросмотр",Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция МожноИспользоватьВыбранныйВидАналитики(ВидАналитики)
	МожноИспользовать = Ложь;
	Если ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
		МожноИспользовать = Истина;
	КонецЕсли;
	Возврат МожноИспользовать;
КонецФункции

#КонецОбласти