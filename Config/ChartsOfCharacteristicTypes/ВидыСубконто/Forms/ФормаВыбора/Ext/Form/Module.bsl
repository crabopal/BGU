
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Счет") Тогда
		СписокСубконто = Новый СписокЗначений;
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.ТолькоОбороты = ЛОЖЬ
		|	И ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ(&Счет)");
		Запрос.УстановитьПараметр("Счет", Параметры.Отбор.Счет);
		СписокСубконто = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидСубконто");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", СписокСубконто, ВидСравненияКомпоновкиДанных.ВСписке);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти
