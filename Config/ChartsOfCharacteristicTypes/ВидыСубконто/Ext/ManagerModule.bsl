#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ПроверитьУстановитьКорректныеТипыВидовСубконто");
КонецПроцедуры

#КонецОбласти
	
// Процедура выполняет проверку и добавляет типы, необходимые для корректной работы конфигурации.
//
Процедура ПроверитьУстановитьКорректныеТипыВидовСубконто(ПараметрОбработчика = Неопределено) Экспорт
	
	// Макет "ВидыСубконто" содержит информацию о типах как они настроены в Конфигураторе.
	// Наличие этих типов необходимо для корректного функционирования конфигурации.
	// Например, в Конфигураторе для субконто "Партии" установлен составной тип данных,
	// в который входят несколько документов. Ошибкой считается отсутствие любого из этих документов
	// в описании типа значения "Партии" в данной ИБ (или области, при работе в режиме сервиса).
	// Другими словами, в макете "ВидыСубконто" необходимый минимум типов: расширение типов возможно, сужение - нет.
	//
	// При внесении изменений в типы видов субконто в Конфигураторе необходимо переформировать этот макет.
	// Для этого, в общем случае, достаточно открыть список предопределенных, нажать "Действия - Вывести список"
	// и полученный табличный документ сохранить в макете "ВидыСубконто".
	Макет = ПланыВидовХарактеристик.ВидыСубконто.ПолучитьМакет("ВидыСубконто");
	ВысотаМакета = Макет.ВысотаТаблицы;
	
	// Все возможные типы характеристик ПВХ "ВидыСубконто".
	ТипЗначенияХарактеристик = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	Для НомерСтроки = 3 По ВысотаМакета Цикл
		
		ИмяВидаСубконто = Макет.Область("R"+НомерСтроки+"C1").Текст;
		ТипВидаСубконто = Макет.Область("R"+НомерСтроки+"C4").Текст;
		
		Попытка
			ВидСубонкто = ПланыВидовХарактеристик.ВидыСубконто[ИмяВидаСубконто];
		Исключение
			Продолжить; // В ИБ нет такого предопределенного элемента.
		КонецПопытки;
		
		// Список типов из ИБ (AS-IS).
		ТипЗначенияИБ = ВидСубонкто.ТипЗначения;
		
		// Список типов из Конфигуратора (TO-BE).
		МассивТипов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			ТипВидаСубконто, ",", Истина, Истина);
		
		ДобавляемыеТипы = Новый Массив;
		ДобавляемыеТипыСтрокой = "";
		Для Каждого ТипСтрокой Из МассивТипов Цикл
			
			ДобавляемыйТип = Тип(ТипСтрокой);
			Если НЕ ТипЗначенияИБ.СодержитТип(ДобавляемыйТип) // Не установлен в ИБ.
				И ТипЗначенияХарактеристик.СодержитТип(ДобавляемыйТип) Тогда // Присутствует в возможных типах.
				
				ДобавляемыеТипы.Добавить(ДобавляемыйТип);
				ДобавляемыеТипыСтрокой = ?(ПустаяСтрока(ДобавляемыеТипыСтрокой), ТипСтрокой,
					ДобавляемыеТипыСтрокой + ", " + ТипСтрокой);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДобавляемыеТипы.Количество() > 0 Тогда // Добавим недостающие в ИБ типы.
			
			// в режиме запуска, как обработчика обновления (*) выполяем только в монопольном режиме
			Если ТипЗнч(ПараметрОбработчика) = Тип("Структура") И ПараметрОбработчика.Свойство("МонопольныйРежим") Тогда
				Если ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
					Возврат;
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				
				НовыйТипЗначения = Новый ОписаниеТипов(ВидСубонкто.ТипЗначения, ДобавляемыеТипы);
				
				ВидСубонктоОбъект = ВидСубонкто.ПолучитьОбъект();
				ВидСубонктоОбъект.ТипЗначения = НовыйТипЗначения;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ВидСубонктоОбъект);
				
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В тип значения вида субконто ""%1"" добавлены типы, необходимые для корректной работы конфигурации.'"),
						ВидСубонкто.Наименование);
				Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Добавлены типы: %1.'"), ДобавляемыеТипыСтрокой);
				ЗаписьЖурналаРегистрации(Сообщение, УровеньЖурналаРегистрации.Информация,
					Метаданные.ПланыВидовХарактеристик.ВидыСубконто, ВидСубонкто, Комментарий);
				
			Исключение
				
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Для вида субконто ""%1"" установлен некорректный тип.
					|Не удалось установить корректный тип и записать вид субконто ""%1"".'"),
						ВидСубонкто.Наименование);
				ЗаписьЖурналаРегистрации(Сообщение, УровеньЖурналаРегистрации.Ошибка,
					Метаданные.ПланыВидовХарактеристик.ВидыСубконто, ВидСубонкто,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти



#КонецЕсли
